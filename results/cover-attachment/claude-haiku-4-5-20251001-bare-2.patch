index 0000000..2a08998
--- /dev/null
+++ b/app/Http/Controllers/AttachmentController.ts
@@ -0,0 +1,39 @@
+import { Controller } from '@guren/core'
+import { Attachment } from '../../Models/Attachment.js'
+import { getAttachmentPath } from '../../Utils/StorageHelper.js'
+import { readFile } from 'fs/promises'
+
+export default class AttachmentController extends Controller {
+  async show(): Promise<Response> {
+    const id = this.request.param('id')
+
+    if (!id || typeof id !== 'string') {
+      return new Response('Not found', { status: 404 })
+    }
+
+    const attachmentId = parseInt(id, 10)
+    if (isNaN(attachmentId)) {
+      return new Response('Not found', { status: 404 })
+    }
+
+    const attachment = await Attachment.find(attachmentId)
+    if (!attachment) {
+      return new Response('Not found', { status: 404 })
+    }
+
+    try {
+      const filePath = await getAttachmentPath(attachment.filePath)
+      const fileBuffer = await readFile(filePath)
+
+      return new Response(fileBuffer, {
+        status: 200,
+        headers: {
+          'Content-Type': attachment.mimeType,
+          'Content-Length': fileBuffer.length.toString(),
+        },
+      })
+    } catch {
+      return new Response('Not found', { status: 404 })
+    }
+  }
+}
