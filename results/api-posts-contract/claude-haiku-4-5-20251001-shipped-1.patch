diff --git a/tests/api/PostsApi.test.ts b/tests/api/PostsApi.test.ts
new file mode 100644
index 0000000..c7be91b
--- /dev/null
+++ b/tests/api/PostsApi.test.ts
@@ -0,0 +1,70 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+
+describe('API Posts Endpoint', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  test('GET /api/posts returns paginated posts', async () => {
+    const res = await http.get('/api/posts')
+    expect(res.status).toBe(200)
+
+    const data = await res.json()
+    expect(data).toHaveProperty('data')
+    expect(data).toHaveProperty('meta')
+    expect(Array.isArray(data.data)).toBe(true)
+    expect(data.meta).toHaveProperty('currentPage')
+    expect(data.meta).toHaveProperty('lastPage')
+    expect(data.meta).toHaveProperty('perPage')
+    expect(data.meta).toHaveProperty('total')
+  })
+
+  test('GET /api/posts validates page parameter', async () => {
+    const res = await http.get('/api/posts?page=0')
+    expect(res.status).toBe(422)
+  })
+
+  test('GET /api/posts validates author parameter', async () => {
+    const res = await http.get('/api/posts?author=abc')
+    expect(res.status).toBe(422)
+  })
+
+  test('GET /api/posts accepts valid page parameter', async () => {
+    const res = await http.get('/api/posts?page=1')
+    expect(res.status).toBe(200)
+    const data = await res.json()
+    expect(data.meta.currentPage).toBe(1)
+  })
+
+  test('GET /api/posts filters by author', async () => {
+    const res = await http.get('/api/posts?author=1')
+    expect(res.status).toBe(200)
+    const data = await res.json()
+    expect(Array.isArray(data.data)).toBe(true)
+  })
+
+  test('posts are ordered newest first', async () => {
+    const res = await http.get('/api/posts')
+    const data = await res.json()
+
+    if (data.data.length >= 2) {
+      for (let i = 0; i < data.data.length - 1; i++) {
+        expect(data.data[i].id).toBeGreaterThanOrEqual(data.data[i + 1].id)
+      }
+    }
+  })
+
+  test('post includes author object with id and name', async () => {
+    const res = await http.get('/api/posts')
+    const data = await res.json()
+
+    if (data.data.length > 0 && data.data[0].author) {
+      expect(data.data[0].author).toHaveProperty('id')
+      expect(data.data[0].author).toHaveProperty('name')
+    }
+  })
+})
