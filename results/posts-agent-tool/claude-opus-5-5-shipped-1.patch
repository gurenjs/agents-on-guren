+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken, type ApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+interface ToolResult {
+  isError?: boolean
+  content: Array<{ type: string; text: string }>
+  structuredContent?: unknown
+}
+
+let rpcId = 0
+
+async function mcp(bearer: string | null, method: string, params: Record<string, unknown> = {}): Promise<Response> {
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    Accept: 'application/json, text/event-stream',
+  }
+  if (bearer) headers.Authorization = `Bearer ${bearer}`
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers,
+    body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method, params }),
+  }))
+}
+
+// The streamable HTTP transport may answer as JSON or as a single SSE event.
+async function rpcResult<T>(response: Response): Promise<T> {
+  const raw = await response.text()
+  const json = raw.trimStart().startsWith('{')
+    ? raw
+    : raw.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5)).join('')
+  const message = JSON.parse(json) as { result?: T; error?: unknown }
+  if (!message.result) throw new Error(`MCP error: ${JSON.stringify(message.error)}`)
+  return message.result
+}
+
+async function callTool(bearer: string, name: string, args: Record<string, unknown>): Promise<ToolResult> {
+  return rpcResult<ToolResult>(await mcp(bearer, 'tools/call', { name, arguments: args }))
+}
+
+describe('/mcp', () => {
+  let http: TestApp
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    userId = user.id
+    const store = app.auth.getApiTokenStore() as ApiTokenStore
+    bearer = (await createApiToken(store, { name: 'assistant', userId, abilities: ['tools:*'] })).plainTextToken
+  })
+
+  it('refuses a call without a bearer', async () => {
+    const response = await mcp(null, 'tools/list')
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two post tools with their read-only flags', async () => {
+    const { tools } = await rpcResult<{ tools: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }> }>(
+      await mcp(bearer, 'tools/list'),
+    )
+    const appTools = tools.filter((tool) => !tool.name.startsWith('guren_'))
+    expect(appTools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(appTools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(appTools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('posts_store creates the post as the token user, ignoring authorId', async () => {
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+    const result = await callTool(bearer, 'posts_store', {
+      title: 'Bun release',
+      excerpt: 'What shipped today',
+      body: 'Details.',
+      authorId: other.id,
+    })
+
+    expect(result.isError).not.toBe(true)
+    expect(JSON.parse(result.content[0]?.text ?? '{}')).toMatchObject({ title: 'Bun release', authorId: userId })
+    const posts = await Post.all()
+    expect(posts).toHaveLength(1)
+    expect(posts[0]?.authorId).toBe(userId)
+  })
+
+  it('the Inertia "New post" form is still redirected to the post', async () => {
+    const user = await User.findOrFail(userId)
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf
+      .withHeader('X-Inertia', 'true')
+      .post('/posts', { title: 'Form post', excerpt: 'e', body: 'b' })
+      .assertRedirect()
+  })
+
+  it('posts_store rejects an empty title with 422 and creates nothing', async () => {
+    const result = await callTool(bearer, 'posts_store', { title: '', excerpt: 'x', body: 'y' })
+
+    expect(result.isError).toBe(true)
+    expect(JSON.parse(result.content[0]?.text ?? '{}').errors.title).toEqual(['Title is required.'])
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('posts_search answers what QUERY /posts/search answers', async () => {
+    await Post.forceCreate({ title: 'Bun tips', excerpt: 'Fast', body: 'b', authorId: userId })
+    await Post.forceCreate({ title: 'Other', excerpt: 'Nothing', body: 'b', authorId: userId })
+
+    const result = await callTool(bearer, 'posts_search', { keywords: ['Bun'] })
+    const viaHttp = await (await http.query('/posts/search', { keywords: ['Bun'] })).json()
+
+    expect(result.isError).not.toBe(true)
+    expect(result.structuredContent ?? JSON.parse(result.content[0]?.text ?? 'null')).toEqual(viaHttp)
+  })
+})
