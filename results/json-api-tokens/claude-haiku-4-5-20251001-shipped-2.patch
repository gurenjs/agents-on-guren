@@ -0,0 +1,51 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostPayloadSchema } from '../../Validators/ApiPostValidator.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('createdAt', 'desc')
+      .get()
+
+    return this.json({
+      data: posts.map((post) => ({
+        id: post.id,
+        title: post.title,
+        excerpt: post.excerpt,
+        authorId: post.authorId,
+        createdAt: new Date(post.createdAt).toISOString(),
+      })),
+    })
+  }
+
+  async store(): Promise<Response> {
+    const user = this.ctx.get('apiTokenUser') as UserRecord | undefined
+    if (!user) {
+      return this.json({ message: 'Unauthorized' }, { status: 401 })
+    }
+
+    const { title, excerpt, body } = await this.validateBody(PostPayloadSchema)
+    const post = await Post.forceCreate({
+      title,
+      excerpt,
+      body,
+      authorId: user.id,
+    })
+
+    return this.json(
+      {
+        data: {
+          id: post.id,
+          title: post.title,
+          excerpt: post.excerpt,
+          authorId: post.authorId,
+          createdAt: new Date(post.createdAt).toISOString(),
+        },
+      },
+      { status: 201 },
+    )
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..31f14ea
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,58 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CreateApiTokenSchema } from '../Validators/ApiTokenValidator.js'
+
+function generateToken(): string {
+  const bytes = new Uint8Array(24)
+  crypto.getRandomValues(bytes)
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+async function hashToken(token: string): Promise<string> {
+  const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(token))
+  return Array.from(new Uint8Array(buffer), (b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+const TokenIdSchema = z.object({
+  id: z.coerce.number().int().positive(),
+})
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateApiTokenSchema)
+
+    const plainToken = generateToken()
+    const tokenHash = await hashToken(plainToken)
+
+    const apiToken = await ApiToken.create({
+      userId: user.id,
+      name,
+      tokenHash,
+    })
+
+    return this.json(
+      {
+        id: apiToken.id,
+        name: apiToken.name,
+        token: plainToken,
+      },
+      { status: 201 },
+    )
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(TokenIdSchema)
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      return this.json({ message: 'Not found' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id })
+    return new Response(null, { status: 204 })
+  }
+}
diff --git a/app/Http/Middleware/ApiRateLimit.ts b/app/Http/Middleware/ApiRateLimit.ts
new file mode 100644
index 0000000..a9a9a6f
--- /dev/null
+++ b/app/Http/Middleware/ApiRateLimit.ts
@@ -0,0 +1,41 @@
+import { defineMiddleware } from '@guren/core'
+
+interface TokenRateLimit {
+  requests: number[]
+}
+
+const rateLimitStore = new Map<string, TokenRateLimit>()
+const LIMIT = 60
+const WINDOW = 60000
+
+export const apiRateLimit = defineMiddleware(async (c, next) => {
+  const token = c.get('apiToken') as string | undefined
+  if (!token) {
+    return await next()
+  }
+
+  const now = Date.now()
+  const limitData = rateLimitStore.get(token) || { requests: [] }
+
+  limitData.requests = limitData.requests.filter((t) => now - t < WINDOW)
+
+  if (limitData.requests.length >= LIMIT) {
+    const oldestRequest = limitData.requests[0]
+    const retryAfter = Math.ceil((oldestRequest + WINDOW - now) / 1000)
+    return new Response(
+      JSON.stringify({ message: 'Too many requests' }),
+      {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(Math.min(retryAfter, 60)),
+        },
+      },
+    )
+  }
+
+  limitData.requests.push(now)
+  rateLimitStore.set(token, limitData)
+
+  return await next()
+})
