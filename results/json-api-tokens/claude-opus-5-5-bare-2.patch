diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..962c93b
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,146 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { apiTokens } from '../db/schema.js'
+import { Model } from '@guren/core'
+
+class ApiTokenRow extends Model {
+  static override table = apiTokens
+}
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const email = `${label}-${crypto.randomUUID()}@example.test`
+  await User.create({ name: label, email, password: 'password123' })
+  const [user] = await User.where({ email })
+  return user!
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    alice = await makeUser('alice')
+    bob = await makeUser('bob')
+  })
+
+  async function session(user: UserRecord): Promise<TestApp> {
+    return (await http.actingAs(user).withCsrf('/profile')).json()
+  }
+
+  async function issue(user: UserRecord, name = 'CI'): Promise<{ id: string; name: string; token: string }> {
+    const response = await (await session(user)).post('/profile/tokens', { name })
+    response.assertStatus(201)
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('issues a token once and stores only a hash of it', async () => {
+    const created = await issue(alice, 'old laptop')
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|')[1]!
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiTokenRow.where({ id: created.id }).get()
+    expect(rows).toHaveLength(1)
+    for (const value of Object.values(rows[0]!)) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('lists the user\'s tokens by name on the profile page', async () => {
+    await issue(alice, 'listed token')
+    const response = await http.actingAs(alice).get('/profile')
+    response.assertOk()
+    await response.assertBodyContains('listed token')
+  })
+
+  it('rejects a missing, empty or over-long name', async () => {
+    const client = await session(alice)
+    await client.post('/profile/tokens', {}).assertStatus(422)
+    await client.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await client.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+  })
+
+  it('gives a guest no token', async () => {
+    const response = await http.json().post('/profile/tokens', { name: 'CI' })
+    expect([401, 403, 302]).toContain(response.status)
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await issue(alice)
+
+    const created = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What changed',
+      body: 'Everything.',
+      authorId: bob.id,
+    })
+    created.assertStatus(201)
+    const { data } = (await created.json()) as { data: { id: number; authorId: number; createdAt: string } }
+    expect(data.authorId).toBe(alice.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const listed = await bearer(token).get('/api/posts')
+    listed.assertOk()
+    const list = (await listed.json()) as { data: { id: number }[] }
+    expect(list.data[0]!.id).toBe(data.id)
+  })
+
+  it('rejects invalid posts with 422 and creates nothing', async () => {
+    const { token } = await issue(alice)
+    const before = await Post.newQuery().count()
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const { token } = await issue(alice)
+    const [id] = token.split('|')
+    await http.json().get('/api/posts').assertStatus(401)
+    await bearer('nonsense').get('/api/posts').assertStatus(401)
+    await bearer(`${id}|${'0'.repeat(64)}`).get('/api/posts').assertStatus(401)
+    await bearer(`${token}x`).get('/api/posts').assertStatus(401)
+    await bearer('nonsense').post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertStatus(401)
+    // Authentication runs before the body is validated.
+    await bearer('nonsense').post('/api/posts', { title: '' }).assertStatus(401)
+  })
+
+  it('revokes only the owner\'s token', async () => {
+    const mine = await issue(alice)
+    const other = await issue(alice)
+    const bobs = await issue(bob)
+
+    await (await session(alice)).delete(`/profile/tokens/${bobs.id}`).assertStatus(404)
+    await bearer(bobs.token).get('/api/posts').assertOk()
+
+    await (await session(alice)).delete(`/profile/tokens/${mine.id}`).assertStatus(204)
+    await bearer(mine.token).get('/api/posts').assertStatus(401)
+    await bearer(other.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const first = await issue(bob)
+    const second = await issue(bob)
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
