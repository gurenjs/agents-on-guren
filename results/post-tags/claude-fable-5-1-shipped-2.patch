+/**
+ * Normalizes the comma-separated `tags` form field into distinct names:
+ * trimmed, blanks dropped, case-sensitive, first occurrence wins. Idempotent
+ * on an already-parsed list, which lets the controller re-run it (codegen
+ * types a transformed field by its input shape, not its output).
+ */
+export function parseTagNames(input: string | readonly string[] | null | undefined): string[] {
+  const entries = input == null ? [] : typeof input === 'string' ? [input] : input
+  const names: string[] = []
+  for (const entry of entries) {
+    for (const piece of entry.split(',')) {
+      const name = piece.trim()
+      if (name.length > 0 && !names.includes(name)) {
+        names.push(name)
+      }
+    }
+  }
+  return names
