diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..df4d652
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,50 @@
+import type { Context, MiddlewareHandler } from 'hono'
+import { ApiToken, hashApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Fixed window per token id (not per user), in memory: single-process only.
+const windows = new Map<number, { count: number; resetAt: number }>()
+
+function consume(tokenId: number, now: number): number | null {
+  if (windows.size > 10_000) {
+    for (const [key, entry] of windows) {
+      if (entry.resetAt <= now) windows.delete(key)
+    }
+  }
+
+  let entry = windows.get(tokenId)
+  if (!entry || entry.resetAt <= now) {
+    entry = { count: 0, resetAt: now + WINDOW_MS }
+    windows.set(tokenId, entry)
+  }
+  entry.count += 1
+
+  return entry.count > LIMIT ? Math.min(60, Math.max(1, Math.ceil((entry.resetAt - now) / 1000))) : null
+}
+
+function unauthorized(ctx: Context): Response {
+  ctx.header('WWW-Authenticate', 'Bearer')
+  return ctx.json({ message: 'Unauthenticated.' }, 401)
+}
+
+/** Authenticates `Authorization: Bearer <token>` and rate-limits per token. */
+export const apiTokenAuth: MiddlewareHandler = async (ctx, next) => {
+  const match = /^Bearer\s+(\S+)$/i.exec(ctx.req.header('Authorization')?.trim() ?? '')
+  if (!match) return unauthorized(ctx)
+
+  const [token] = await ApiToken.where({ tokenHash: hashApiToken(match[1]!) })
+  if (!token) return unauthorized(ctx)
+
+  const retryAfter = consume(token.id, Date.now())
+  if (retryAfter !== null) {
+    ctx.header('Retry-After', String(retryAfter))
+    return ctx.json({ message: 'Too many requests.', retryAfter }, 429)
+  }
+
+  ctx.set(API_USER_ID_KEY, token.userId)
+  return next()
+}
