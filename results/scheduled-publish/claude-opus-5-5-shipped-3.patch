diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..115e5b4
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,110 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import ListScheduledPostsCommand from '../app/Console/Commands/ListScheduledPostsCommand.js'
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2000-01-01T00:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  async function makePost(publishedAt: string | null, title = 'Launch'): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: 'Soon', body: 'Body', authorId: author.id, publishedAt })
+  }
+
+  async function inertiaProps(client: TestApp, path: string): Promise<Record<string, any>> {
+    const res = await client.withHeaders({ 'X-Inertia': 'true' }).get(path)
+    return (await res.json<{ props: Record<string, any> }>()).props
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    const post = await makePost(FUTURE)
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    const props = await inertiaProps(http.actingAs(author), `/posts/${post.id}`)
+    expect(props.post.publishedAt).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const scheduled = await makePost(FUTURE, 'Scheduled')
+    await makePost(null, 'Public')
+
+    const guest = await inertiaProps(http, '/posts')
+    expect(guest.data.map((p: PostRecord) => p.title)).toEqual(['Public'])
+
+    const otherView = await inertiaProps(http.actingAs(other), '/posts')
+    expect(otherView.data.map((p: PostRecord) => p.title)).toEqual(['Public'])
+
+    const own = await inertiaProps(http.actingAs(author), '/posts')
+    expect(own.data.find((p: PostRecord) => p.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    await makePost(FUTURE, 'Launch secret')
+    await http.query('/posts/search', { keywords: ['Launch'] }).assertOk().assertJsonCount(0, 'data')
+    await http.actingAs(other).query('/posts/search', { keywords: ['Launch'] }).assertJsonCount(0, 'data')
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    const post = await makePost(FUTURE)
+    await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    const props = await inertiaProps(http, '/posts')
+    expect(props.data).toHaveLength(1)
+    await http.query('/posts/search', { keywords: ['Launch'] }).assertJsonCount(1, 'data')
+  })
+
+  it('stores publishAt on create and clears it on update', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: FUTURE }).assertRedirect()
+    const [created] = await Post.all()
+    expect(created?.publishedAt).toBe(FUTURE)
+
+    await csrf.put(`/posts/${created!.id}`, { title: 'T', excerpt: 'E', body: 'B', publishAt: null }).assertRedirect()
+    expect((await Post.find(created!.id))?.publishedAt).toBeNull()
+  })
+
+  it('rejects a publishAt that is not a date and time', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('reports scheduled posts soonest first, tab-separated', async () => {
+    await makePost('2999-12-01T00:00:00.000Z', 'Later')
+    await makePost(FUTURE, 'Sooner')
+    await makePost(PAST, 'Live')
+    await makePost(null, 'Always live')
+
+    const lines: string[] = []
+    const command = new ListScheduledPostsCommand()
+    command.setOutput({ line: (message: string) => lines.push(message) } as never)
+    command.setInput([])
+    expect(await command.handle()).toBe(0)
+
+    expect(lines.map((line) => line.split('\t').slice(1))).toEqual([
+      ['Sooner', FUTURE],
+      ['Later', '2999-12-01T00:00:00.000Z'],
+    ])
+  })
+})
