diff --git a/app/Models/Post.ts b/app/Models/Post.ts
index 4c4a643..8133e80 100644
--- a/app/Models/Post.ts
+++ b/app/Models/Post.ts
@@ -7,12 +7,39 @@ export type NewPostRecord = typeof posts.$inferInsert
 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
 export class Post extends defineModel(posts) {
-  // `authorId` is set from the signed-in user, never from request input.
+  // `authorId` and `slug` are set from the server, never from request input.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  // Lowercase ASCII letters/digits, words joined by a single `-`, no
+  // leading/trailing `-`. Anything else (punctuation, whitespace, non-ASCII)
+  // collapses into a separator.
+  static slugify(title: string): string {
+    return title
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, '-')
+      .replace(/^-+|-+$/g, '')
+  }
+
+  // Slugs are assigned once, at creation — appends "-2", "-3", ... (the next
+  // free number) when the base slug is already taken, so later title edits
+  // never touch a post's address.
+  static async uniqueSlug(baseSlug: string): Promise<string> {
+    const existing = await Post.where('slug', 'like', `${baseSlug}%`).get()
+    const taken = new Set(existing.map((post) => post.slug))
+    if (!taken.has(baseSlug)) {
+      return baseSlug
+    }
+
+    let suffix = 2
+    while (taken.has(`${baseSlug}-${suffix}`)) {
+      suffix += 1
+    }
+    return `${baseSlug}-${suffix}`
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
