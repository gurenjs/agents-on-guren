diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..8677401
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,105 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const payload = { title: 'Tagged', excerpt: 'An excerpt', body: 'A body' }
+
+async function pageProps(http: TestApp, path: string): Promise<Record<string, any>> {
+  const res = await http.withHeader('X-Inertia', 'true').get(path)
+  res.assertOk()
+  return (await res.json<{ props: Record<string, any> }>()).props
+}
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const pivots = await PostTag.where({ postId }).get()
+  const tags = await Tag.where({ id: pivots.map((pivot) => pivot.tagId) }).get()
+  return tags.map((tag) => tag.name).sort()
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })) as UserRecord
+  })
+
+  async function createPost(tags: string): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { ...payload, tags }).assertRedirect()
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    return post!.id
+  }
+
+  it('creates, shows, edits and filters tags', async () => {
+    const id = await createPost('bun, webdev')
+    expect(await tagNamesOf(id)).toEqual(['bun', 'webdev'])
+    expect((await pageProps(http, `/posts/${id}`)).post.tags).toEqual(['bun', 'webdev'])
+
+    const other = await createPost('')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${id}`, { ...payload, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect((await pageProps(http, `/posts/${id}`)).post.tags).toEqual(['bun'])
+
+    const filtered = await pageProps(http, '/posts?tag=bun')
+    expect(filtered.data.map((post: { id: number }) => post.id)).toEqual([id])
+    expect(filtered.pagination.links.pages[0].url).toContain('tag=bun')
+
+    expect((await pageProps(http, '/posts?tag=webdev')).data).toEqual([])
+    expect((await pageProps(http, '/posts?tag=nobody')).data).toEqual([])
+
+    const all = await pageProps(http, '/posts')
+    expect(all.data.map((post: { id: number; tags: string[] }) => [post.id, post.tags])).toEqual([
+      [other, []],
+      [id, ['bun']],
+    ])
+  })
+
+  it('refuses invalid tags like an empty title and writes nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const emptyTitle = await csrf.post('/posts', { ...payload, title: '' })
+
+    const tooMany = await csrf.post('/posts', { ...payload, tags: 'a,b,c,d,e,f' })
+    expect(tooMany.status).toBe(emptyTitle.status)
+    const tooLong = await csrf.post('/posts', { ...payload, tags: 'x'.repeat(31) })
+    expect(tooLong.status).toBe(emptyTitle.status)
+
+    const json = await http.actingAs(author).json().withCsrf()
+    await json.post('/posts', { ...payload, tags: 'a,b,c,d,e,f' }).assertUnprocessable().assertJsonStructure(['errors'])
+    const res = await json.post('/posts', { ...payload, tags: 'x'.repeat(31) })
+    expect(Object.keys((await res.json<{ errors: Record<string, unknown> }>()).errors)).toEqual(['tags'])
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+
+  it('accepts a 30-character name and de-duplicates trimmed names', async () => {
+    const long = await createPost('y'.repeat(30))
+    expect(await tagNamesOf(long)).toEqual(['y'.repeat(30)])
+
+    const id = await createPost(' bun ,bun,, ')
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})
