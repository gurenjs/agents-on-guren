   async show(): Promise<Response> {
     const { id } = this.validateParams(PostIdParamSchema)
-    const post = await Post.findWithOrFail(id, 'author')
+    const post = await Post.findWithOrFail(id, ['author', 'comments.author'])
+
+    // Get all comments for this post with their report counts
+    const comments = post.comments ?? []
+    const commentIds = comments.map(c => c.id)
+
+    // Count reports for each comment (max 3+ get hidden)
+    const reportCounts = await CommentReport.newQuery()
+      .where('commentId', 'in', commentIds.length > 0 ? commentIds : [0])
+      .get()
+
+    const reportCountMap = new Map<number, number>()
+    for (const report of reportCounts) {
+      reportCountMap.set(report.commentId, (reportCountMap.get(report.commentId) ?? 0) + 1)
+    }
+
+    // Filter out comments with 3+ reports
+    const visibleComments = comments
+      .filter(c => (reportCountMap.get(c.id) ?? 0) < 3)
+      .sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime())
 
     return this.inertia(pages.posts.Show, {
       post: new PostResource(post).toJSON(),
+      comments: visibleComments.map(c => new CommentResource(c).toJSON()),
     })
   }
 
diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..08e53cc
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,28 @@
+import { Resource, type WithRelations } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+import type { CommentRecord, CommentAuthorSummary } from '../../Models/Comment.js'
+
+type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author?: CommentAuthorSummary
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentRecord | CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      createdAt: new Date(comment.createdAt).toISOString(),
+      author: this.whenLoaded('author', () => ({
+        id: (comment as CommentWithAuthor).author?.id,
+        name: (comment as CommentWithAuthor).author?.name,
+      })) as CommentAuthorSummary | undefined,
+    }
+  }
+}
