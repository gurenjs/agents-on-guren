+ * The contract types the field as it travels (a string), so callers run it
+ * through `parseTagNames`, which leaves an already-parsed list unchanged.
+ */
+async function syncPostTags(postId: number, names: string[], trx: TransactionHandle): Promise<void> {
+  const tagIds = new Map<string, number>()
+  if (names.length > 0) {
+    const existing = await Tag.newQuery({ trx }).whereIn('name', names).get()
+    for (const tag of existing) {
+      tagIds.set(tag.name, tag.id)
+    }
+    for (const name of names) {
+      if (!tagIds.has(name)) {
+        const created = await Tag.create({ name }, { trx })
+        tagIds.set(name, created.id)
+      }
+    }
