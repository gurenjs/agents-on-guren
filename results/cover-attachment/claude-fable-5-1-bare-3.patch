@@ -1,3 +1,4 @@
+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,46 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+// The edit form's "remove cover" checkbox: `'1'` in a multipart body, a boolean
+// when Inertia sends JSON (no file picked). The `cover` file itself is read
+// with `this.file('cover')`, so it is not part of the schema.
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  removeCover: z.union([z.boolean(), z.string()]).optional(),
+})
+
+export type PostUpdatePayload = z.infer<typeof PostUpdatePayloadSchema>
+
+export function isRemoveCoverChecked(value: PostUpdatePayload['removeCover']): boolean {
+  return value === true || value === '1' || value === 'true' || value === 'on'
+}
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_CONTENT_TYPES = ['image/png', 'image/jpeg'] as const
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+function startsWith(bytes: Uint8Array, signature: readonly number[]): boolean {
+  return signature.every((byte, index) => bytes[index] === byte)
+}
+
+/**
+ * The app's cover rules: PNG or JPEG, at most 2 MB. Throws the same
+ * ValidationException a route schema failure produces, keyed on `cover`,
+ * so callers get the usual 422 (or Inertia error bag) and nothing is stored.
+ */
+export async function validateCoverUpload(file: File): Promise<void> {
+  if (file.size > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'The cover must be 2 MB or smaller.' })
+  }
+
+  // Sniff the bytes rather than trusting the client's declared type.
+  const head = new Uint8Array(await file.slice(0, 8).arrayBuffer())
+  const isPng = startsWith(head, PNG_SIGNATURE)
+  const isJpeg = startsWith(head, JPEG_SIGNATURE)
+
+  if (!isPng && !isJpeg) {
+    throw ValidationException.withMessages({ cover: 'The cover must be a PNG or JPEG image.' })
+  }
+}
