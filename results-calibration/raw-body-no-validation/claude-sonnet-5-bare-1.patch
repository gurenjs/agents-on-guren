@@ -0,0 +1,88 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('ProfileController.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeUser() {
+    return User.create({
+      name: 'Original Name',
+      email: 'original@example.com',
+      password: 'original-password',
+    })
+  }
+
+  it('rejects a malformed email and leaves the account untouched', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.put('/profile', { name: 'Original Name', email: 'not-an-email' }).assertUnprocessable()
+
+    const stored = await User.find(user.id)
+    expect(stored?.email).toBe('original@example.com')
+  })
+
+  it('rejects an empty name and leaves the account untouched', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.put('/profile', { name: '', email: 'original@example.com' }).assertUnprocessable()
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Original Name')
+  })
+
+  it('rejects a short password and leaves the account untouched', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .put('/profile', { name: 'Original Name', email: 'original@example.com', password: 'short' })
+      .assertUnprocessable()
+  })
+
+  it('ignores fields outside the profile form, such as id and passwordHash', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'updated@example.com',
+        id: user.id + 1000,
+        passwordHash: 'hacked-hash',
+      })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.id).toBe(user.id)
+    expect(stored?.name).toBe('Updated Name')
+    expect(stored?.email).toBe('updated@example.com')
+    expect(stored?.passwordHash).not.toBe('hacked-hash')
+
+    const hijacked = await User.find(user.id + 1000)
+    expect(hijacked).toBeNull()
+  })
+
+  it('applies a valid update', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.put('/profile', { name: 'Updated Name', email: 'updated@example.com' }).assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Updated Name')
+    expect(stored?.email).toBe('updated@example.com')
+  })
+})
