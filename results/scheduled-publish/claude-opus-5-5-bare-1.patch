+    })
+  }
+
+  /** Posts whose `published_at` is still ahead, soonest first. */
+  static scheduled() {
+    return this.newQuery()
+      .where('publishedAt', '>', new Date().toISOString())
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+  }
 }
 
