@@ -0,0 +1,66 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+import { CreateTokenSchema } from '../Validators/TokenValidator.js'
+
+export default class ProfileTokensController extends Controller {
+  async create(): Promise<Response> {
+    const user = await this.auth.user<UserRecord | null>()
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'Unauthenticated' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+
+    const { name } = await this.validateBody(CreateTokenSchema)
+
+    const plainToken = TokenService.generate()
+    const hash = TokenService.hash(plainToken)
+
+    const token = await ApiToken.create({
+      userId: user.id,
+      name,
+      hash,
+    })
+
+    return new Response(JSON.stringify({
+      id: token.id,
+      name: token.name,
+      token: plainToken,
+    }), {
+      status: 201,
+      headers: { 'Content-Type': 'application/json' },
+    })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.user<UserRecord | null>()
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'Unauthenticated' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+
+    const { id } = this.validateParams(
+      z.object({
+        id: z.coerce.number().int().positive(),
+      }),
+    )
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      return new Response(JSON.stringify({ error: 'Not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+
+    await ApiToken.delete({ id })
+
+    return new Response(null, { status: 204 })
+  }
+}
