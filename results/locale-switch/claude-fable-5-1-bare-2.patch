diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..f3930f7
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,25 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+import { LOCALE_COOKIE } from '../../../config/locales.js'
+
+// A year: the pick should outlive the session, since guests have no account
+// to store it against.
+const LOCALE_COOKIE_MAX_AGE = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  // Remembers the reader's language in the cookie that locale detection reads
+  // on every later request, then sends them back where they were. The route
+  // contract validates the body, so an unsupported locale never reaches here.
+  async store(): Promise<Response> {
+    const { locale } = this.validated('locale.store').body
+
+    // The Referer is client-controlled, so only a same-origin URL is followed.
+    const referer = this.request.header('referer')
+    const backTo = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(backTo, {
+      headers: {
+        'Set-Cookie': `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${LOCALE_COOKIE_MAX_AGE}; SameSite=Lax`,
+      },
+    })
+  }
+}
