diff --git a/tests/PostDrafts.test.ts b/tests/PostDrafts.test.ts
new file mode 100644
index 0000000..8f07d5d
--- /dev/null
+++ b/tests/PostDrafts.test.ts
@@ -0,0 +1,114 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// A word that appears in no other row, so the keyword search below can only
+// match the fixtures this file creates.
+const MARKER = 'zarquonite'
+
+async function inertiaProps(response: { raw: Response }): Promise<Record<string, unknown>> {
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props
+}
+
+describe('post drafts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let draft: PostRecord
+  let published: PostRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = await User.forceCreate({ name: 'Draft Author', email: `author-${MARKER}@example.com`, password: 'secret' })
+    stranger = await User.forceCreate({ name: 'Nosy Reader', email: `reader-${MARKER}@example.com`, password: 'secret' })
+
+    draft = await Post.forceCreate({
+      title: `A ${MARKER} draft`,
+      excerpt: `Not ready for ${MARKER} readers yet.`,
+      body: 'Still being written.',
+      authorId: author.id,
+      published: false,
+    })
+    published = await Post.forceCreate({
+      title: `A ${MARKER} published post`,
+      excerpt: `Ready for ${MARKER} readers.`,
+      body: 'Out in the world.',
+      authorId: author.id,
+      published: true,
+    })
+  })
+
+  afterAll(async () => {
+    await Post.delete({ authorId: author.id })
+    await User.delete({ id: author.id })
+    await User.delete({ id: stranger.id })
+  })
+
+  it('hides a draft from the list but keeps the published post', async () => {
+    const props = await inertiaProps(await http.get('/posts').assertOk())
+    const ids = (props.data as PostResourceData[]).map((post) => post.id)
+
+    expect(ids).toContain(published.id)
+    expect(ids).not.toContain(draft.id)
+  })
+
+  it('leaves a draft out of the search results', async () => {
+    const response = await http.query('/posts/search', { keywords: [MARKER] }).assertOk()
+    const { data } = (await response.raw.json()) as { data: PostResourceData[] }
+
