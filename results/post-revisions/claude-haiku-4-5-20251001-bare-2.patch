new file mode 100644
index 0000000..61212f7
--- /dev/null
+++ b/resources/js/pages/posts/Revisions.tsx
@@ -0,0 +1,65 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: PostResourceData
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`Revisions for ${post.title}`} />
+      <div className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="text-3xl font-bold text-g-heading">Revisions for {post.title}</h1>
+          <Link href={route('posts.show', { id: post.id })} className="text-g-accent-text transition hover:underline">
+            ← Back to post
+          </Link>
+        </header>
+
+        <div className="space-y-3">
+          {revisions.length === 0 ? (
+            <p className="text-g-text-2">No revisions yet.</p>
+          ) : (
+            <table className="w-full">
+              <thead>
+                <tr className="border-b border-g-line">
+                  <th className="py-2 text-left">Title</th>
+                  <th className="py-2 text-left">Date</th>
+                  <th className="py-2 text-left">Action</th>
+                </tr>
+              </thead>
+              <tbody>
+                {revisions.map((revision) => (
+                  <tr key={revision.id} className="border-b border-g-line">
+                    <td className="py-2">{revision.title}</td>
+                    <td className="py-2">{new Date(revision.createdAt).toLocaleDateString()}</td>
+                    <td className="py-2">
+                      <Link
+                        href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                        method="post"
+                        as="button"
+                        className="text-g-accent-text transition hover:underline"
+                      >
+                        Restore
+                      </Link>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          )}
+        </div>
+      </div>
+    </Layout>
+  )
+}
