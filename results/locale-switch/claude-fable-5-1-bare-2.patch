diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..f54a2cd
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,127 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readdirSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { SUPPORTED_LOCALES } from '../config/locales.js'
+import app from '../src/app.js'
+
+type I18nProps = {
+  locale: string
+  fallbackLocale: string
+  messages: Record<string, Record<string, unknown>>
+}
+
+async function i18nOf(http: TestApp, path: string): Promise<I18nProps> {
+  const response = await http.get(path).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props._i18n as I18nProps
+}
+
+function readCookie(response: Response, name: string): string | undefined {
+  const cookie = response.headers
+    .getSetCookie()
+    .find((entry) => entry.startsWith(`${name}=`))
+  return cookie?.split(';')[0]?.slice(name.length + 1)
+}
+
+// Boots the real src/app.ts, which auto-migrates the SQLite test database, so
+// the pages that read posts render for real. `withCsrf()` primes the session
+// and XSRF cookies the way a browser would before its first POST.
+describe('locale switching', () => {
+  let http: TestApp
+  let browser: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    browser = (await http.withCsrf()).json()
+  })
+
+  it('remembers the pick and returns to the referring page', async () => {
+    const response = await browser
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts')
+
+    expect(readCookie(response.raw, 'locale')).toBe('ja')
+  })
+
+  it('falls back to the home page without a Referer', async () => {
+    await browser.post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('does not follow a Referer on another host', async () => {
+    await browser
+      .withHeader('Referer', 'https://evil.example/phish')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported locale like an invalid post payload', async () => {
+    const response = await browser.post('/locale', { locale: 'fr' }).assertStatus(422)
+    expect(readCookie(response.raw, 'locale')).toBeUndefined()
+
+    const missing = await browser.post('/locale', {}).assertStatus(422)
+    expect(readCookie(missing.raw, 'locale')).toBeUndefined()
+  })
+
+  it('renders English by default', async () => {
+    const i18n = await i18nOf(http, '/')
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en?.nav).toMatchObject({ posts: 'Posts' })
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    for (const header of ['ja', 'ja-JP,ja;q=0.9,en;q=0.8']) {
+      const i18n = await i18nOf(http.withHeader('Accept-Language', header), '/posts')
+      expect(i18n.locale).toBe('ja')
+      expect(i18n.messages.ja).toMatchObject({
+        nav: { home: 'ホーム', posts: '記事', dashboard: 'ダッシュボード' },
+        posts: { new: '新規投稿', edit: '編集', delete: '削除', search: '検索' },
+        auth: { login: 'ログイン', logout: 'ログアウト' },
+      })
+    }
+  })
+
+  it('lets a stored pick win over the browser', async () => {
+    const i18n = await i18nOf(
+      http.withHeaders({ 'Accept-Language': 'ja', Cookie: 'locale=en' }),
+      '/',
+    )
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('keeps the pick on later visits from the same browser', async () => {
+    const i18n = await i18nOf(http.withHeader('Cookie', 'locale=ja'), '/')
+    expect(i18n.locale).toBe('ja')
+  })
+})
+
+// The catalogs live in lang/<locale>/<namespace>.json; `guren check --i18n`
+// is the authoritative parity check, this keeps `bun test` honest about it.
+describe('translation catalogs', () => {
+  const langDir = join(import.meta.dir, '..', 'lang')
+
+  function keysOf(locale: string): string[] {
+    const keys: string[] = []
+    const walk = (value: unknown, prefix: string) => {
+      if (typeof value === 'string') {
+        keys.push(prefix)
+        return
+      }
+      for (const [key, child] of Object.entries(value as Record<string, unknown>)) {
+        walk(child, `${prefix}.${key}`)
+      }
+    }
+    for (const file of readdirSync(join(langDir, locale))) {
+      if (!file.endsWith('.json')) continue
+      walk(JSON.parse(readFileSync(join(langDir, locale, file), 'utf8')), file.slice(0, -'.json'.length))
+    }
+    return keys.sort()
+  }
+
+  it('ship the same keys in every supported locale', () => {
+    const [first, ...rest] = SUPPORTED_LOCALES.map((locale) => keysOf(locale))
+    expect(first).toContain('messages.welcome')
+    for (const keys of rest) expect(keys).toEqual(first)
+  })
+})
