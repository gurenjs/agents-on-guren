+      postId: post.id,
+      title: 'First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+
+    const csrf = await http.actingAs(otherUser).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+
+    const unchanged = await Post.findOrFail(post.id)
+    expect(unchanged.title).toBe('First')
+  })
+
+  it('requires auth for restore', async () => {
