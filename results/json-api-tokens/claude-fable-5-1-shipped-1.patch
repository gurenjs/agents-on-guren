+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { API_RATE_LIMIT } from '../routes/api.js'
+
+interface IssuedToken {
+  id: string
+  name: string
+  token: string
+}
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+describe('posts API', () => {
+  let http: TestApp
+  let user: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret' })
+    other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret' })
+  })
+
+  async function issue(record: UserRecord, name = 'CI'): Promise<IssuedToken> {
+    const primed = await http.actingAs(record).withCsrf()
+    const response = await primed.json().post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<IssuedToken>()
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  const payload = { title: 'Release 1.2', excerpt: 'What changed', body: 'Everything.' }
+
+  it('lists every post by every author, newest first', async () => {
+    const first = await Post.forceCreate({ ...payload, title: 'First', authorId: user.id, createdAt: '2026-01-01T00:00:00.000Z' })
+    const second = await Post.forceCreate({ ...payload, title: 'Second', authorId: other.id, createdAt: '2026-02-01T00:00:00.000Z' })
+    const { token } = await issue(user)
+
+    const response = await bearer(token).get('/api/posts')
+    response.assertOk()
+    const { data } = await response.json<{ data: ApiPost[] }>()
+
+    expect(data.map((post) => post.id)).toEqual([second.id, first.id])
+    expect(data[0]).toMatchObject({ title: 'Second', excerpt: 'What changed', authorId: other.id })
+    expect(new Date(data[0].createdAt).toISOString()).toBe(data[0].createdAt)
+  })
+
+  it('creates a post owned by the token owner, ignoring authorId in the body', async () => {
+    const { token } = await issue(user)
+
+    const response = await bearer(token).post('/api/posts', { ...payload, authorId: other.id })
+    response.assertCreated()
+    const { data } = await response.json<{ data: ApiPost }>()
+
+    expect(data).toMatchObject({ title: payload.title, excerpt: payload.excerpt, authorId: user.id })
+    expect(typeof data.id).toBe('number')
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const stored = await Post.findOrFail(data.id)
+    expect(stored.authorId).toBe(user.id)
+  })
+
+  it('rejects input the web form would reject with 422 and creates nothing', async () => {
+    const { token } = await issue(user)
+
+    await bearer(token).post('/api/posts', { ...payload, title: '' }).assertUnprocessable()
+    const response = await bearer(token).post('/api/posts', { title: 'No body', excerpt: 'x' })
+    response.assertUnprocessable()
+    expect(await response.json<{ errors: Record<string, string[]> }>()).toHaveProperty('errors.body')
+
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('answers 401 JSON to missing, malformed, unknown, tampered and revoked tokens', async () => {
+    const issued = await issue(user)
+    const [id, secret] = issued.token.split('|')
+    const tampered = `${id}|${secret.slice(0, -1)}${secret.endsWith('a') ? 'b' : 'a'}`
+
+    const cases: Array<TestApp> = [
+      http.json(),
+      http.json().withHeader('Authorization', 'Bearer'),
+      http.json().withHeader('Authorization', 'Bearer not-a-token'),
+      http.json().withHeader('Authorization', `Basic ${issued.token}`),
+      bearer(`${'0'.repeat(32)}|${'0'.repeat(64)}`),
+      bearer(tampered),
+    ]
+
+    for (const client of cases) {
+      const response = await client.get('/api/posts')
+      response.assertUnauthorized()
+      expect(response.headers.get('content-type')).toContain('application/json')
+    }
+
+    for (const client of cases) {
+      const response = await client.post('/api/posts', payload)
+      expect([401, 403]).toContain(response.status)
+      expect(response.headers.get('content-type')).toContain('application/json')
+    }
+
+    const primed = await http.actingAs(user).withCsrf()
+    await primed.json().delete(`/profile/tokens/${issued.id}`).assertNoContent()
+    await bearer(issued.token).get('/api/posts').assertUnauthorized()
+    await bearer(issued.token).post('/api/posts', payload).assertUnauthorized()
+
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('limits each token to its own window and says when to retry', async () => {
+    const first = await issue(user, 'CI')
+    const second = await issue(user, 'old laptop')
+
+    for (let i = 0; i < API_RATE_LIMIT.limit; i += 1) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    const retryAfter = Number(limited.headers.get('retry-after'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
