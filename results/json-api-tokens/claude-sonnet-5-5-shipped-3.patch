@@ -0,0 +1,29 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+const summary = (post: ConstructorParameters<typeof PostResource>[0]) => {
+  const { id, title, excerpt, authorId, createdAt } = new PostResource(post).toJSON()
+  return { id, title, excerpt, authorId, createdAt }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('createdAt', 'desc').orderBy('id', 'desc').get()
+    return this.json({ data: posts.map(summary) })
+  }
+
+  async store(): Promise<Response> {
+    const { userId } = this.apiToken()
+    const { body } = this.validated('api.posts.store')
+    // authorId is not fillable: it comes from the token, never the request.
+    const post = await Post.forceCreate({
+      title: body.title,
+      excerpt: body.excerpt,
+      body: body.body,
+      authorId: Number(userId),
+    })
+
+    return this.json({ data: summary(post) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..9782e88
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,29 @@
+import { Controller, HttpException, createApiToken } from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { apiTokenStore } from '../../Auth/ApiTokens.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name: body.name,
+      userId: user.id,
+    })
+
+    // The only time the plain text exists; only its hash is stored.
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    const owned = await apiTokenStore.findByUserId(user.id)
+    if (!owned.some((token) => token.id === id)) {
+      throw HttpException.notFound()
+    }
+
+    await apiTokenStore.delete(id)
+    return new Response(null, { status: 204 })
+  }
+}
