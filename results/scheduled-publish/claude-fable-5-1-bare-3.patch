+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,28 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * `bun run console posts:scheduled` — the launch calendar from a terminal.
+ * One line per post whose publish date is still ahead, soonest first, as
+ * `<id>\t<title>\t<published_at>` with the date exactly as stored. Nothing
+ * else goes to stdout, so the output pipes into cut, sort or a spreadsheet.
+ */
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later, soonest first (tab-separated).'
+
+  async handle(): Promise<number> {
+    const now = new Date().toISOString()
+    const scheduled = await Post.newQuery()
+      .where('publishedAt', '>', now)
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()
+
+    for (const post of scheduled) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
