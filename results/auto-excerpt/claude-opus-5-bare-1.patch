@@ -13,6 +16,26 @@ export class Post extends defineModel(posts) {
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  // Excerpt used when the author leaves the field blank: the opening of the
+  // body, cut on a word boundary so no word is sliced in half, plus a single
+  // ellipsis character. Bodies short enough to stand on their own are kept
+  // whole, without an ellipsis.
+  static excerptFrom(body: string): string {
+    const trimmed = body.trim()
+    if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+    const head = trimmed.slice(0, EXCERPT_LENGTH)
+    // Only pull back to a word boundary when the cut lands inside a word —
+    // that is, when the characters on both sides of it are non-whitespace.
+    const splitsWord = !/\s/.test(head[head.length - 1] ?? '') && !/\s/.test(trimmed[EXCERPT_LENGTH] ?? '')
+    // Matches the last whitespace run in `head`; -1 when it holds no
+    // whitespace at all, in which case the cut stays at EXCERPT_LENGTH.
+    const lastBoundary = splitsWord ? head.search(/\s\S*$/) : -1
+    const kept = lastBoundary === -1 ? head : head.slice(0, lastBoundary)
+
+    return `${kept.replace(/\s+$/, '')}…`
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
