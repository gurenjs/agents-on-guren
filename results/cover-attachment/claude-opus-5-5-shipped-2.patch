+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })) as UserRecord
+  })
+
+  async function coverUrlOf(postId: number): Promise<string | null> {
+    const [post] = await Post.withAttachments([await Post.findOrFail(postId)], ['cover'])
+    return post!.cover?.url ?? null
+  }
+
+  it('stores a PNG cover on create and serves it unchanged', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+
+    const post = (await Post.all())[0]!
+    const url = await coverUrlOf(post.id)
+    expect(url).not.toBeNull()
+
+    const res = await http.get(url!)
+    expect(res.status).toBe(200)
+    expect(res.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await res.raw.arrayBuffer())).toEqual(PNG)
+
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('refuses a GIF on the cover field and saves nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', form(fields, { bytes: GIF, type: 'image/gif', name: 'a.gif' }))
+      .assertUnprocessable()
+      .assertJsonPath('errors.cover.0', 'The cover must be a PNG or JPEG image.')
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+  })
+
+  it('refuses a cover over 2 MB', async () => {
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', form(fields, { bytes: big, type: 'image/png', name: 'big.png' }))
+      .assertUnprocessable()
+      .assertJsonPath('errors.cover.0', 'The cover must be 2 MB or smaller.')
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('replaces, keeps, removes and deletes covers', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const post = (await Post.all())[0]!
+    const first = await coverUrlOf(post.id)
+
+    await csrf.put(`/posts/${post.id}`, form(fields, { bytes: JPEG, type: 'image/jpeg', name: 'b.jpg' })).assertRedirect()
+    const second = await coverUrlOf(post.id)
+    expect(second).not.toBe(first)
+    expect((await http.get(first!)).status).toBe(404)
+    expect((await http.get(second!)).headers.get('content-type')).toBe('image/jpeg')
+    expect(await Attachment.all()).toHaveLength(1)
+
+    await csrf.json().put(`/posts/${post.id}`, form(fields, { bytes: GIF, type: 'image/gif', name: 'c.gif' })).assertUnprocessable()
+    await csrf.put(`/posts/${post.id}`, form(fields)).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBe(second)
+
+    await csrf.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBeNull()
+    expect(await Attachment.all()).toHaveLength(0)
+
+    await csrf.put(`/posts/${post.id}`, form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const third = await coverUrlOf(post.id)
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Attachment.all()).toHaveLength(0)
+    expect((await http.get(third!)).status).toBe(404)
+  })
+})
