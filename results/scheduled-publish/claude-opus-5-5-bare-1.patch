diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..a432c91
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,104 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+const FUTURE = '2999-01-01T09:00:00.000Z'
+const PAST = '2000-01-01T09:00:00.000Z'
+
+async function inertiaProps(http: TestApp, path: string) {
+  const response = await http.withHeaders({ 'X-Inertia': 'true' }).get(path)
+  expect(response.status).toBe(200)
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as Record<string, unknown>
+}
+
+async function listIds(http: TestApp): Promise<number[]> {
+  const props = await inertiaProps(http, '/posts')
+  return (props.data as PostResourceData[]).map((post) => post.id)
+}
+
+async function searchIds(http: TestApp, keyword: string): Promise<number[]> {
+  const response = await http.query('/posts/search', { keywords: [keyword], limit: 50 })
+  const { data } = await response.json<{ data: PostResourceData[] }>()
+  return data.map((post) => post.id)
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+  let marker: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    marker = `sched${Date.now()}`
+    author = (await User.create({ name: 'Author', email: `${marker}-a@example.com`, password: 'password123' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: `${marker}-o@example.com`, password: 'password123' })) as UserRecord
+    scheduled = (await Post.forceCreate({
+      title: `${marker} launch`,
+      excerpt: 'Soon',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as PostRecord
+  })
+
+  // The console report reads this same database, so leave nothing scheduled.
+  afterAll(async () => {
+    for (const user of [author, other]) {
+      await Post.delete({ authorId: user.id })
+      await User.delete({ id: user.id })
+    }
+  })
+
+  it('hides a scheduled post from guests and other users', async () => {
+    for (const viewer of [http, http.actingAs(other)]) {
+      await viewer.get(`/posts/${scheduled.id}`).assertNotFound()
+      expect(await listIds(viewer)).not.toContain(scheduled.id)
+      expect(await searchIds(viewer, marker)).not.toContain(scheduled.id)
+    }
+  })
+
+  it('shows a scheduled post to its author with publishedAt', async () => {
+    const asAuthor = http.actingAs(author)
+    const props = await inertiaProps(asAuthor, `/posts/${scheduled.id}`)
+    expect((props.post as PostResourceData).publishedAt).toBe(FUTURE)
+
+    const list = (await inertiaProps(asAuthor, '/posts')).data as PostResourceData[]
+    expect(list.find((post) => post.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+  })
+
+  it('publishes to everyone once the time has passed', async () => {
+    await Post.update({ id: scheduled.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    expect(await listIds(http)).toContain(scheduled.id)
+    expect(await searchIds(http, marker)).toContain(scheduled.id)
+
+    await Post.update({ id: scheduled.id }, { publishedAt: FUTURE })
+  })
+
+  it('rejects a publishAt that is not a date and time', async () => {
+    const client = await http.actingAs(author).json().withCsrf('/posts')
+    await client
+      .post('/posts', { title: 'x', excerpt: 'x', body: 'x', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+  })
+
+  it('stores publishAt on create', async () => {
+    const client = await http.actingAs(author).withCsrf('/posts')
+    await client
+      .post('/posts', { title: `${marker} created`, excerpt: 'x', body: 'x', publishAt: FUTURE })
+      .assertRedirect()
+
+    const created = await Post.newQuery().where('title', `${marker} created`).firstOrFail()
+    expect(created.publishedAt).toBe(FUTURE)
+  })
+})
