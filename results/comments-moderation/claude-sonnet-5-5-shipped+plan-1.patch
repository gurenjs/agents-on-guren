diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..78cb9fa
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,73 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let owner: { id: number }
+  let other: { id: number }
+  let postId: number
+
+  const makeUser = (name: string) =>
+    User.create({ name, email: `${name}@example.com`, password: 'password123' }) as Promise<{ id: number }>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await makeUser('owner')
+    other = await makeUser('other')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner.id })
+    postId = post!.id
+  })
+
+  const as = async (user: { id: number }) => http.actingAs(user as never).withCsrf()
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores a valid comment and rejects an invalid one', async () => {
+    const csrf = await as(other)
+    await csrf.post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect(`/posts/${postId}`)
+    await csrf.json().post(`/posts/${postId}/comments`, { body: '' }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(1)
+  })
+
+  it('lets the author and the post author delete, and no one else', async () => {
+    const third = await makeUser('third')
+    const mine = await Comment.forceCreate({ body: 'a', postId, userId: other.id })
+    await (await as(third)).delete(`/comments/${mine!.id}`).assertForbidden()
+    await (await as(owner)).delete(`/comments/${mine!.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('counts a report once and hides at three distinct reporters', async () => {
+    const comment = await Comment.forceCreate({ body: 'a', postId, userId: other.id })
+    const reporters = [owner, other, await makeUser('third')]
+    for (const user of reporters) {
+      await (await as(user)).post(`/comments/${comment!.id}/report`).assertNoContent()
+    }
+    await (await as(owner)).post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await CommentReport.all()).toHaveLength(3)
+    expect(await Comment.all()).toHaveLength(1)
+
+    const page = await http.get(`/posts/${postId}`).assertOk()
+    expect((await page.text()).includes('"comments":[]')).toBe(true)
+  })
+
+  it('removes comments with their post', async () => {
+    await Comment.forceCreate({ body: 'a', postId, userId: other.id })
+    await (await as(owner)).delete(`/posts/${postId}`).assertRedirect('/posts')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
