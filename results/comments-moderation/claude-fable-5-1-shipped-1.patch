diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..048cc08
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,65 @@
+import { defineModel, type BelongsToRecord, type HasManyRecord, type TransactionHandle } from '@guren/core'
+import { comments } from '../../db/schema.js'
+import { CommentReport, type CommentReportRecord } from './CommentReport.js'
+import type { PostRecord } from './Post.js'
+import { User, type UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+export type CommentWithAuthor = CommentRecord & { author: CommentAuthorSummary | null }
+
+/** Reports from this many different users hide a comment from the post page. */
+export const COMMENT_HIDE_THRESHOLD = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` comes from the route and `userId` from the signed-in user.
+  fillable: ['body'],
+}) {
+  static override relationTypes: {
+    author: BelongsToRecord<CommentAuthorSummary>
+    post: BelongsToRecord<PostRecord>
+    reports: HasManyRecord<CommentReportRecord>
+  } = {
+    author: null,
+    post: null,
+    reports: [],
+  }
+
+  /** A post's comments as its page lists them: oldest first, hidden ones left out. */
+  static async visibleForPost(postId: number): Promise<CommentWithAuthor[]> {
+    // The unique (comment_id, user_id) index makes a row count a count of reporters.
+    const counted = await Comment.withCount('reports', { postId })
+    const visible = counted
+      .filter((comment) => comment.reportsCount < COMMENT_HIDE_THRESHOLD)
+      // ISO 8601 strings sort chronologically; the id settles a shared millisecond.
+      .sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id - b.id)
+
+    const authors = await User.whereIn('id', [...new Set(visible.map((comment) => comment.userId))])
+      .select('id', 'name')
+      .get()
+    const authorsById = new Map(authors.map((author) => [author.id, author]))
+
+    return visible.map(({ reportsCount: _reportsCount, ...comment }) => ({
+      ...comment,
+      author: authorsById.get(comment.userId) ?? null,
+    }))
+  }
+
+  /**
+   * Deletes comments together with their reports. The schema's ON DELETE
+   * CASCADE is not enough: SQLite only honours it on a connection that has
+   * `foreign_keys` switched on, which is off by default.
+   */
+  static async deleteWithReports(where: { id: number } | { postId: number }, trx: TransactionHandle): Promise<void> {
+    const doomed = await Comment.inTransaction(trx).where(where).select('id').get()
+    await CommentReport.inTransaction(trx)
+      .newQuery()
+      .whereIn('commentId', doomed.map((comment) => comment.id))
+      .delete()
+    await Comment.inTransaction(trx).delete(where)
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+Comment.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
+Comment.hasMany('reports', () => import('./CommentReport.js').then((module) => module.CommentReport), 'commentId', 'id')
