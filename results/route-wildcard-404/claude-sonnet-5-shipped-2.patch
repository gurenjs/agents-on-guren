 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,70 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    const author = await User.forceCreate({
+      name: 'Author',
+      email: 'author@example.com',
+      passwordHash: 'not-a-real-hash',
+    })
+
+    await Post.forceCreate({
+      title: 'August post',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      createdAt: '2026-08-05T00:00:00.000Z',
+    })
+    await Post.forceCreate({
+      title: 'Late August post',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      createdAt: '2026-08-31T23:59:59.999Z',
+    })
+    await Post.forceCreate({
+      title: 'September post',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      createdAt: '2026-09-01T00:00:00.000Z',
+    })
+  })
+
+  it('lists posts for a zero-padded month', async () => {
+    await http
+      .get('/posts/archive/2026/08')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+  })
+
+  it('lists posts for a month without a leading zero', async () => {
+    await http
+      .get('/posts/archive/2026/8')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+  })
+
+  it('lists every post in a year', async () => {
+    await http.get('/posts/archive/2026').assertOk().assertJsonCount(3, 'data')
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/2025').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+  })
+})
