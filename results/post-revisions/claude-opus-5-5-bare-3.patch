+async function overwriteKeepingRevision(post: PostRecord, data: PostPayload): Promise<void> {
+  await Post.transaction(async (trx) => {
+    // forceCreate, because `postId` is deliberately absent from
+    // PostRevision.fillable: it comes from the post being edited.
+    await PostRevision.forceCreate(
+      { postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body },
+      { trx },
+    )
+    await Post.update({ id: post.id }, data, { trx })
+  })
