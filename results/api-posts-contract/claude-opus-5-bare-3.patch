new file mode 100644
index 0000000..9ef805a
--- /dev/null
+++ b/routes/api.ts
@@ -0,0 +1,22 @@
+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+
+// Public JSON endpoints for consumers that cannot speak Inertia — partner
+// integrations as well as our own front-end through the generated API client.
+// Deliberately outside every middleware alias: these routes carry no session
+// and no authentication.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    // The `query` contract is what the router validates (422 on bad input)
+    // and what codegen and `guren audit` read to report the accepted
+    // parameters; the `resource` hint types the client's json() the same way
+    // posts.search does — declared, never checked at runtime.
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+    }, [ApiPostController, 'index'])
+  })
+}
