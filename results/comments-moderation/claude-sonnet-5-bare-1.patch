+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// A guest is redirected before the database is touched.
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  it('redirects a guest who comments to login', async () => {
+    await http.post('/posts/1/comments', { body: 'hi' }).assertRedirect('/login')
+  })
+
+  it('redirects a guest who reports to login', async () => {
+    await http.post('/comments/1/report', {}).assertRedirect('/login')
+  })
+})
