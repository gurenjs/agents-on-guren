+++ b/app/Http/Controllers/ApiPostsController.ts
@@ -0,0 +1,128 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { PostPayloadSchema } from '../Validators/PostValidator.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { verifySecret } from '../../Utilities/TokenGenerator.js'
+
+const requestCounts = new Map<number, { count: number; resetTime: number }>()
+
+export default class ApiPostsController extends Controller {
+  private async validateBearerToken(): Promise<{ userId: number; tokenId: number } | null> {
+    const authHeader = this.request.header('Authorization')
+
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      return null
+    }
+
+    const token = authHeader.slice(7)
+    const parts = token.split('|')
+
+    if (parts.length !== 2) {
+      return null
+    }
+
+    const [publicPart, secretPart] = parts
+
+    const apiToken = await ApiToken.where({ tokenPublic: publicPart }).first()
+
+    if (!apiToken) {
+      return null
+    }
+
+    if (!verifySecret(secretPart, apiToken.tokenHashSecret)) {
+      return null
+    }
+
+    return { userId: apiToken.userId, tokenId: apiToken.id }
+  }
+
+  private checkRateLimit(tokenId: number): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const record = requestCounts.get(tokenId)
+    const minute = 60 * 1000
+
+    let resetTime = record?.resetTime ?? now + minute
+    let count = record?.count ?? 0
+
+    if (now >= resetTime) {
+      count = 1
+      resetTime = now + minute
+    } else {
+      count += 1
+    }
+
+    requestCounts.set(tokenId, { count, resetTime })
+
+    if (count > 60) {
+      const retryAfter = Math.ceil((resetTime - now) / 1000)
+      return { allowed: false, retryAfter: Math.min(retryAfter, 60) }
+    }
+
+    return { allowed: true }
+  }
+
+  async index(): Promise<Response> {
+    const auth = await this.validateBearerToken()
+    if (!auth) {
+      return this.json({ message: 'Unauthorized' }, { status: 401 })
+    }
+
+    const rateLimit = this.checkRateLimit(auth.tokenId)
+    if (!rateLimit.allowed) {
+      return new Response(JSON.stringify({ message: 'Too many requests' }), {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(rateLimit.retryAfter),
+        },
+      })
+    }
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('createdAt', 'desc')
+      .get()
+
+    return this.json({
+      data: PostResource.collection(posts),
+    })
+  }
+
+  async store(): Promise<Response> {
+    const auth = await this.validateBearerToken()
+    if (!auth) {
+      return this.json({ message: 'Unauthorized' }, { status: 401 })
+    }
+
+    const rateLimit = this.checkRateLimit(auth.tokenId)
+    if (!rateLimit.allowed) {
+      return new Response(JSON.stringify({ message: 'Too many requests' }), {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(rateLimit.retryAfter),
+        },
+      })
+    }
+
+    const { title, excerpt, body } = await this.validateBody(PostPayloadSchema)
+
+    const post = await Post.forceCreate({
+      title,
+      excerpt,
+      body,
+      authorId: auth.userId,
+    })
+
+    if (!post) {
+      return this.json({ message: 'Failed to create post' }, { status: 500 })
+    }
+
+    const postWithAuthor = await Post.findWithOrFail(post.id, 'author')
+
+    return this.json({
+      data: new PostResource(postWithAuthor).toJSON(),
+    }, { status: 201 })
+  }
+}
