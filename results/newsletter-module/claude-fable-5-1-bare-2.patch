+import { defineModel } from '@guren/core'
+import { newsletterSubscriptions } from '../../db/schema.js'
+
+export type NewsletterSubscriptionRecord = typeof newsletterSubscriptions.$inferSelect
+export type NewNewsletterSubscriptionRecord = typeof newsletterSubscriptions.$inferInsert
+
+export class NewsletterSubscription extends defineModel(newsletterSubscriptions, {
+  // `token` and `confirmedAt` are set server-side, never from request input:
+  // the controller writes them through forceCreate()/forceUpdate().
+  fillable: ['email'],
+}) {}
diff --git a/modules/newsletter/db/schema.ts b/modules/newsletter/db/schema.ts
new file mode 100644
index 0000000..805c90c
--- /dev/null
+++ b/modules/newsletter/db/schema.ts
@@ -0,0 +1,13 @@
+import { sqliteTable, integer, text } from '@guren/orm/drizzle/sqlite'
+
+// Re-exported into the project's db/schema.ts by `guren make:module`, which is
+// how drizzle-kit and the migrations see it. The module owns the definition.
+export const newsletterSubscriptions = sqliteTable('newsletter_subscriptions', {
+  id: integer('id').primaryKey({ autoIncrement: true }),
+  email: text('email').notNull().unique(),
+  // Random, unguessable confirmation token; the confirmation link carries it.
+  token: text('token').notNull().unique(),
+  // Null until the visitor follows the confirmation link.
+  confirmedAt: text('confirmed_at'),
+  createdAt: text('created_at').notNull().$defaultFn(() => new Date().toISOString()),
+})
