+import type { Router } from '@guren/core'
+import { bearerTokenMiddleware } from '../app/Http/Middleware/BearerTokenMiddleware.js'
+import { rateLimitMiddleware } from '../app/Http/Middleware/RateLimitMiddleware.js'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  baseRouter.group('/api', (router) => {
+    router.get('/posts', {
+      middlewares: [bearerTokenMiddleware, rateLimitMiddleware],
+    }, [ApiPostController, 'index']).name('api.posts.index')
+    router.post('/posts', {
+      middlewares: [bearerTokenMiddleware, rateLimitMiddleware],
+    }, [ApiPostController, 'store']).name('api.posts.store')
+  })
+}
