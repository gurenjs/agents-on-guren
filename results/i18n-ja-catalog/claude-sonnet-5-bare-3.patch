diff --git a/tests/AuthI18n.test.ts b/tests/AuthI18n.test.ts
new file mode 100644
index 0000000..efa01c6
--- /dev/null
+++ b/tests/AuthI18n.test.ts
@@ -0,0 +1,108 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// /login and /register are the first pages a Japanese-browsing visitor sees,
+// so they resolve their strings from lang/<locale>/auth.json via the
+// Accept-Language-driven locale (see src/app.ts's i18n.supported). This
+// exercises the request-locale resolution end to end rather than the
+// translator directly, since that's the behavior product asked for.
+describe('auth page locale detection', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  const jaCases = [
+    'ja',
+    'ja-JP',
+    'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7',
+  ]
+
+  const enCases = [
+    undefined,
+    'en',
+    'en-US,en;q=0.9',
+    'en-US,en;q=0.9,ja;q=0.5',
+    'fr-FR,fr;q=0.9',
+  ]
+
+  for (const acceptLanguage of jaCases) {
+    it(`resolves ja for Accept-Language: ${acceptLanguage}`, async () => {
+      const request = http.withHeaders({ 'X-Inertia': 'true', 'Accept-Language': acceptLanguage })
+      const response = await request.get('/login')
+      const { props } = await response.json<{ props: { _i18n: { locale: string } } }>()
+      expect(props._i18n.locale).toBe('ja')
+    })
+  }
+
+  for (const acceptLanguage of enCases) {
+    it(`resolves en for Accept-Language: ${acceptLanguage ?? '(none)'}`, async () => {
+      const headers: Record<string, string> = { 'X-Inertia': 'true' }
+      if (acceptLanguage) headers['Accept-Language'] = acceptLanguage
+      const response = await http.withHeaders(headers).get('/login')
+      const { props } = await response.json<{ props: { _i18n: { locale: string } } }>()
+      expect(props._i18n.locale).toBe('en')
+    })
+  }
+
+  it('exposes the exact Japanese login copy', async () => {
+    const response = await http
+      .withHeaders({ 'X-Inertia': 'true', 'Accept-Language': 'ja' })
+      .get('/login')
+    const { props } = await response.json<{
+      props: { _i18n: { messages: { ja: { auth: { login: Record<string, string> } } } } }
+    }>()
+    expect(props._i18n.messages.ja.auth.login).toEqual({
+      title: 'ログイン',
+      heading: 'ログイン',
+      subtitle: 'アカウントの認証情報を入力して続行してください。',
+      email: 'メールアドレス',
+      password: 'パスワード',
+      rememberMe: 'ログイン状態を保持する',
+      submit: 'ログイン',
+      noAccount: 'アカウントをお持ちでないですか？',
+      signUp: 'アカウント登録',
+    })
+  })
+
+  it('exposes the exact Japanese registration copy', async () => {
+    const response = await http
+      .withHeaders({ 'X-Inertia': 'true', 'Accept-Language': 'ja' })
+      .get('/register')
+    const { props } = await response.json<{
+      props: { _i18n: { messages: { ja: { auth: { register: Record<string, string> } } } } }
+    }>()
+    expect(props._i18n.messages.ja.auth.register).toEqual({
+      title: 'アカウント登録',
+      heading: 'アカウント登録',
+      subtitle: 'アカウントを作成して始めましょう。',
+      name: '名前',
+      email: 'メールアドレス',
+      password: 'パスワード',
+      confirmPassword: 'パスワード（確認）',
+      submit: '登録',
+      haveAccount: 'すでにアカウントをお持ちですか？',
+      signIn: 'ログイン',
+    })
+  })
+
+  it('keeps the English copy untouched', async () => {
+    const response = await http.withHeaders({ 'X-Inertia': 'true' }).get('/login')
+    const { props } = await response.json<{
+      props: { _i18n: { messages: { en: { auth: { login: Record<string, string> } } } } }
+    }>()
+    expect(props._i18n.messages.en.auth.login).toEqual({
+      title: 'Sign in',
+      heading: 'Sign in',
+      subtitle: 'Use your account credentials to continue.',
+      email: 'Email',
+      password: 'Password',
+      rememberMe: 'Remember me',
+      submit: 'Sign in',
+      noAccount: "Don't have an account?",
+      signUp: 'Sign up',
+    })
+  })
+})
