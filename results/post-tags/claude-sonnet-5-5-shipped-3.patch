@@ -0,0 +1,48 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+
+const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+describe('post tags', () => {
+  let author: Awaited<ReturnType<typeof User.create>>
+  let http: TestApp
+
+  beforeEach(async () => {
+    const base = await TestApp.fromApp(app)
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    http = await base.actingAs(author).withCsrf()
+  })
+
+  it('creates, edits and filters by tags', async () => {
+    await http.json().post('/posts', payload(' bun ,bun, webdev,')).assertRedirect()
+    const post = (await Post.all())[0]!
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(2)
+    expect((await Tag.namesByPost([post.id])).get(post.id)).toEqual(['bun', 'webdev'])
+
+    await http.json().put(`/posts/${post.id}`, payload('bun')).assertRedirect()
+    expect((await Tag.namesByPost([post.id])).get(post.id)).toEqual(['bun'])
+
+    const inertia = http.withHeaders({ 'X-Inertia': 'true', 'X-Requested-With': 'XMLHttpRequest' })
+    const listed = await (await inertia.get('/posts?tag=bun')).json<{ props: { data: { tags: string[] }[] } }>()
+    expect(listed.props.data.map((p) => p.tags)).toEqual([['bun']])
+    const none = await (await inertia.get('/posts?tag=nope')).json<{ props: { data: unknown[] } }>()
+    expect(none.props.data).toEqual([])
+
+    await http.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+
+  it('refuses invalid tags without writing', async () => {
+    await http.json().post('/posts', payload('a,b,c,d,e,f')).assertStatus(422)
+    await http.json().post('/posts', payload('x'.repeat(31))).assertStatus(422)
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    await http.json().post('/posts', payload('x'.repeat(30))).assertRedirect()
+  })
+})
