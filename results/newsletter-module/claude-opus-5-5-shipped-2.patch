+++ b/modules/newsletter/tests/NewsletterController.test.ts
@@ -0,0 +1,75 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const referer = 'http://localhost/posts'
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function client(): Promise<TestApp> {
+    const csrf = await http.withCsrf()
+    return csrf.json().withHeader('Referer', referer)
+  }
+
+  it('stores a pending subscription and redirects back', async () => {
+    const guest = await client()
+    await guest.post('/newsletter/subscribe', { email: 'Reader@Example.com' }).assertRedirect(referer)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.email).toBe('reader@example.com')
+    expect(rows[0]?.confirmedAt).toBeNull()
+    expect(rows[0]?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate emails without touching the table', async () => {
+    const guest = await client()
+    await guest.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    await guest.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    expect(await NewsletterSubscription.all()).toHaveLength(0)
+
+    await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    await guest
+      .post('/newsletter/subscribe', { email: 'reader@example.com' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s an unknown token', async () => {
+    const subscription = await NewsletterSubscription.create({ email: 'a@example.com', token: 'a'.repeat(64) })
+
+    await http.get('/newsletter/confirm/unknown-token').assertNotFound()
+    expect((await NewsletterSubscription.find(subscription.id))?.confirmedAt).toBeNull()
+
+    await http.get(`/newsletter/confirm/${subscription.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.find(subscription.id))?.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given email', async () => {
+    await NewsletterSubscription.create({ email: 'a@example.com', token: 'a'.repeat(64) })
+    await NewsletterSubscription.create({ email: 'b@example.com', token: 'b'.repeat(64) })
+
+    const guest = await client()
+    await guest.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect(referer)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((row) => row.email)).toEqual(['b@example.com'])
+  })
+
+  it('falls back to the home page for a foreign referer', async () => {
+    const guest = (await http.withCsrf()).json().withHeader('Referer', 'https://evil.example/')
+    await guest.post('/newsletter/subscribe', { email: 'c@example.com' }).assertRedirect('/')
+  })
+})
