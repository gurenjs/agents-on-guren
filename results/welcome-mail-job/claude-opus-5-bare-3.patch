diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..2178974
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,37 @@
+import { Job, getMailManager } from '@guren/core'
+import { sendWelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailPayload {
+  name: string
+  email: string
+}
+
+/**
+ * Delivers the welcome email out of band. Registration only dispatches this,
+ * so a slow or unreachable mail provider cannot make sign-up hang or fail with
+ * it — the message goes out when the queued work runs, in a worker.
+ *
+ * The payload carries the name and address the account registered with instead
+ * of a user id: everything the message needs travels with it, so the worker
+ * needs no database of its own.
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailPayload> {
+  // Pinned so a bundled build (which may mangle class names) still queues and
+  // resolves the job under the name in-flight messages carry.
+  static override jobName = 'SendWelcomeEmailJob'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: SendWelcomeEmailPayload): Promise<void> {
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured for queue jobs — app/Providers/MailProvider.ts publishes it on boot.')
+    }
+
+    await sendWelcomeMail(manager, payload)
+  }
+
+  async failed(payload: SendWelcomeEmailPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${payload.email}:`, error.message)
+  }
+}
diff --git a/app/Mail/WelcomeMail.ts b/app/Mail/WelcomeMail.ts
