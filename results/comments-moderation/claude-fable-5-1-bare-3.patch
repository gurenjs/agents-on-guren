diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..0d12c66
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,62 @@
+import { defineModel, type BelongsToRecord, type TransactionHandle, type WithRelations } from '@guren/core'
+import { count, eq, gte } from 'drizzle-orm'
+import { getDrizzle } from '../../config/database.js'
+import { commentReports, comments } from '../../db/schema.js'
+import { CommentReport } from './CommentReport.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type NewCommentRecord = typeof comments.$inferInsert
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+
+/** Reports by this many different users hide a comment from the post page. */
+export const REPORTS_TO_HIDE = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` comes from the route and `userId` from the signed-in user, never
+  // from request input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: { author: BelongsToRecord<CommentAuthorSummary> } = {
+    author: null,
+  }
+
+  /** A post's comments as its page lists them: oldest first, hidden ones left out. */
+  static async visibleOn(postId: number): Promise<Array<WithRelations<typeof Comment, 'author'>>> {
+    const db = await getDrizzle()
+    // Counted from comment_reports on every read rather than kept as a flag on
+    // the comment, so rows the review tooling adds or removes take effect.
+    const hidden = await db
+      .select({ id: commentReports.commentId })
+      .from(commentReports)
+      .innerJoin(comments, eq(comments.id, commentReports.commentId))
+      .where(eq(comments.postId, postId))
+      .groupBy(commentReports.commentId)
+      .having(gte(count(), REPORTS_TO_HIDE))
+
+    return Comment.newQuery()
+      .where('postId', postId)
+      .whereNotIn('id', hidden.map((row) => row.id))
+      .with('author')
+      .orderBy('createdAt', 'asc')
+      // Two comments can share a millisecond; ids break the tie in write order.
+      .orderBy('id', 'asc')
+      .get() as Promise<Array<WithRelations<typeof Comment, 'author'>>>
+  }
+
+  // Removes the reports as well as the comments. The schema declares the same
+  // cascade, but SQLite skips it unless the connection turned foreign keys on.
+  static async purge(where: { id: number } | { postId: number }, trx: TransactionHandle): Promise<void> {
+    const doomed = await Comment.inTransaction(trx).where(where).select('id').get()
+    if (doomed.length === 0) {
+      return
+    }
+
+    await CommentReport.inTransaction(trx)
+      .where({ commentId: doomed.map((comment) => comment.id) })
+      .delete()
+    await Comment.inTransaction(trx).where(where).delete()
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
diff --git a/app/Models/CommentReport.ts b/app/Models/CommentReport.ts
new file mode 100644
index 0000000..755a842
--- /dev/null
+++ b/app/Models/CommentReport.ts
@@ -0,0 +1,17 @@
+import { defineModel } from '@guren/core'
+import { getDrizzle } from '../../config/database.js'
+import { commentReports } from '../../db/schema.js'
+
+export type CommentReportRecord = typeof commentReports.$inferSelect
+
+export class CommentReport extends defineModel(commentReports, {
+  // Both columns come from the route and the signed-in user.
+  fillable: [],
+}) {
+  // A single INSERT that skips an existing (comment, user) pair, so a repeated
+  // or concurrent report by the same user can neither fail nor count twice.
+  static async record(commentId: number, userId: number): Promise<void> {
+    const db = await getDrizzle()
+    await db.insert(commentReports).values({ commentId, userId }).onConflictDoNothing()
+  }
+}
diff --git a/app/Policies/CommentPolicy.ts b/app/Policies/CommentPolicy.ts
new file mode 100644
index 0000000..86e5c2c
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,33 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+}
+
+interface PostLike {
+  authorId: number
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * Writing and reporting are open to every signed-in user; deleting is for the
+ * comment's author and the author of the post it sits on.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null, _comment: CommentLike): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike, post: PostLike): boolean {
+    if (user === null) {
+      return false
+    }
+
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === post.authorId
+  }
+}
