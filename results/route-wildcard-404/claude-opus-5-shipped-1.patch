diff --git a/tests/PostArchive.test.ts b/tests/PostArchive.test.ts
new file mode 100644
index 0000000..868d498
--- /dev/null
+++ b/tests/PostArchive.test.ts
@@ -0,0 +1,79 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The archive is served from two routes (/posts/archive/:year/:month and
+// /posts/archive/:year) because a path param never spans a '/'.
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    const author = await User.forceCreate({
+      name: 'Archivist',
+      email: 'archivist@example.com',
+      passwordHash: 'not-a-real-hash',
+    })
+
+    // createdAt is written explicitly: the archive filters on the stored
+    // (UTC) timestamp, not on insertion order.
+    const fixtures = [
+      { title: 'July 2026', createdAt: '2026-07-31T23:59:59.000Z' },
+      { title: 'August 2026, early', createdAt: '2026-08-01T00:00:00.000Z' },
+      { title: 'August 2026, late', createdAt: '2026-08-31T23:59:59.000Z' },
+      { title: 'January 2025', createdAt: '2025-01-15T12:00:00.000Z' },
+    ]
+
+    for (const fixture of fixtures) {
+      await Post.forceCreate({
+        title: fixture.title,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: author?.id as number,
+        createdAt: fixture.createdAt,
+      })
+    }
+  })
+
+  const titles = async (path: string): Promise<string[]> => {
+    const response = await http.get(path)
+    response.assertOk()
+    const payload = await response.json<{ data: Array<{ id: number; title: string }> }>()
+    return payload.data.map((post) => post.title)
+  }
+
+  it('lists the posts of a month, newest first', async () => {
+    expect(await titles('/posts/archive/2026/08')).toEqual(['August 2026, late', 'August 2026, early'])
+  })
+
+  it('accepts a month without a leading zero', async () => {
+    expect(await titles('/posts/archive/2026/8')).toEqual(['August 2026, late', 'August 2026, early'])
+  })
+
+  it('lists every post of a year', async () => {
+    expect(await titles('/posts/archive/2026')).toEqual([
+      'August 2026, late',
+      'August 2026, early',
+      'July 2026',
+    ])
+  })
+
+  it('answers an empty period with an empty list', async () => {
+    expect(await titles('/posts/archive/2024')).toEqual([])
+    expect(await titles('/posts/archive/2026/02')).toEqual([])
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+    await http.get('/posts/archive/2026/00').assertStatus(422)
+  })
+
+  it('rejects a malformed year', async () => {
+    await http.get('/posts/archive/20xx').assertStatus(422)
+  })
+})
