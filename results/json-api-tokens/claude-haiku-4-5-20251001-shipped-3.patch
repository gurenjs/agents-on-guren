new file mode 100644
index 0000000..097308d
--- /dev/null
+++ b/app/Http/Middleware/BearerTokenMiddleware.ts
@@ -0,0 +1,31 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+
+export const bearerTokenMiddleware = defineMiddleware(async (c, next) => {
+  const authHeader = c.req.header('Authorization')
+
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    return new Response(JSON.stringify({ message: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    })
+  }
+
+  const token = authHeader.slice(7)
+  const tokenHash = TokenService.hashToken(token)
+
+  const apiToken = await ApiToken.first({ tokenHash })
+  if (!apiToken) {
+    return new Response(JSON.stringify({ message: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    })
+  }
+
+  c.set('apiToken', apiToken)
+  c.set('userId', apiToken.userId)
+  c.set('tokenId', apiToken.id)
+
+  return next()
+})
diff --git a/app/Http/Middleware/RateLimitMiddleware.ts b/app/Http/Middleware/RateLimitMiddleware.ts
new file mode 100644
index 0000000..b9d262f
--- /dev/null
+++ b/app/Http/Middleware/RateLimitMiddleware.ts
@@ -0,0 +1,34 @@
+import { defineMiddleware } from '@guren/core'
+
+const rateLimitStore = new Map<string, { count: number; resetTime: number }>()
+
+const RATE_LIMIT = 60
+const RATE_LIMIT_WINDOW = 60000
+
+export function createRateLimitMiddleware(keyFn: (c: any) => string) {
+  return defineMiddleware(async (c, next) => {
+    const key = keyFn(c)
+    const now = Date.now()
+    const entry = rateLimitStore.get(key)
+
+    if (!entry || entry.resetTime <= now) {
+      rateLimitStore.set(key, { count: 1, resetTime: now + RATE_LIMIT_WINDOW })
+      return next()
+    }
+
+    entry.count += 1
+
+    if (entry.count > RATE_LIMIT) {
+      const secondsUntilReset = Math.ceil((entry.resetTime - now) / 1000)
+      return new Response(JSON.stringify({ message: 'Too many requests' }), {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(Math.min(secondsUntilReset, 60)),
+        },
+      })
+    }
+
+    return next()
+  })
+}
