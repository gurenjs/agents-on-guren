+import { describe, expect, it } from 'bun:test'
+import { slugify } from '../app/Support/slug.js'
+
+describe('slugify', () => {
+  it('lowercases a title and joins its words with a single dash', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world')
+  })
+
+  it('collapses runs of punctuation and whitespace, and trims the edges', () => {
+    expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+  })
+
+  it('folds accented letters to ASCII', () => {
+    expect(slugify('Café Déjà Vu')).toBe('cafe-deja-vu')
+  })
