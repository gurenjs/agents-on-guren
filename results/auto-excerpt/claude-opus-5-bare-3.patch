diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..ec01ddb
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+// The fallback the post forms lean on when a writer leaves Excerpt blank.
+describe('deriveExcerpt', () => {
+  it('keeps a short body whole, without an ellipsis', () => {
+    expect(deriveExcerpt('  A short post body.  ')).toBe('A short post body.')
+  })
+
+  it('keeps a body of exactly 140 characters whole', () => {
+    const body = 'a'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('backs up to the last whitespace when the cut splits a word', () => {
+    const sentence = 'The quick brown fox jumps over the lazy dog. '
+    const body = `${sentence.repeat(3)}The quick brown`
+    const excerpt = deriveExcerpt(body)
+
+    expect(excerpt).toBe(`${sentence.repeat(3)}The…`)
+    expect(excerpt).toHaveLength(139)
+  })
+
+  it('keeps all 140 characters when the cut lands on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const excerpt = deriveExcerpt(body)
+
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt).toHaveLength(141)
+  })
+
+  it('cuts at 140 when the opening is one unbroken run', () => {
+    const body = 'a'.repeat(200)
+    expect(deriveExcerpt(body)).toBe(`${'a'.repeat(140)}…`)
+  })
+
+  it('trims whitespace left at the cut', () => {
+    const body = `${'a'.repeat(130)}      ${'b'.repeat(30)}`
+    expect(deriveExcerpt(body)).toBe(`${'a'.repeat(130)}…`)
+  })
+})
