@@ -0,0 +1,111 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../config/attachments.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 5, 6, 7, 8])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 9, 9])
+
+function postForm(fields: Record<string, string | File>): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries({ title: 'Hello', excerpt: 'Short', body: 'Long body', ...fields })) {
+    form.append(key, value)
+  }
+  return form
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  async function signedIn() {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function showProps(id: number) {
+    const res = await http.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${id}`)
+    const page = await res.json<{ props: { post: { coverUrl: string | null } } }>()
+    return page.props.post
+  }
+
+  it('stores a PNG cover, serves it byte for byte, and deletes it with the post', async () => {
+    const client = await signedIn()
+    await client.post('/posts', postForm({ cover: new File([PNG], 'c.png', { type: 'image/png' }) })).assertRedirect()
+
+    const post = (await Post.first())!
+    const { coverUrl } = await showProps(post.id)
+    expect(coverUrl).toBeString()
+
+    const served = await http.get(coverUrl!)
+    served.assertOk().assertHeader('content-type', 'image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+    expect((await Attachment.all()).length).toBe(1)
+
+    await client.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect((await Attachment.all()).length).toBe(0)
+    await http.get(coverUrl!).assertNotFound()
+  })
+
+  it('creates a post without a cover when no file is picked', async () => {
