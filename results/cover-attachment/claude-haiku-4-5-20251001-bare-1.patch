diff --git a/app/Http/Controllers/AttachmentController.ts b/app/Http/Controllers/AttachmentController.ts
new file mode 100644
index 0000000..36e8b48
--- /dev/null
+++ b/app/Http/Controllers/AttachmentController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+import { Attachment } from '../../Models/Attachment.js'
+
+const AttachmentIdParamSchema = z.object({
+  id: z.coerce.number().int().positive(),
+})
+
+export default class AttachmentController extends Controller {
+  async show(): Promise<Response> {
+    const { id } = this.validateParams(AttachmentIdParamSchema)
+
+    const attachment = await Attachment.findOrFail(id)
+    const file = Bun.file(attachment.path)
+    const exists = await file.exists()
+
+    if (!exists) {
+      return new Response('Not Found', { status: 404 })
+    }
+
+    const buffer = await file.arrayBuffer()
+    return new Response(buffer, {
+      status: 200,
+      headers: {
+        'Content-Type': attachment.contentType,
+        'Content-Length': buffer.byteLength.toString(),
+      },
+    })
+  }
+}
