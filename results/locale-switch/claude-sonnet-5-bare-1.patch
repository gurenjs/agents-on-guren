@@ -0,0 +1,29 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects to the referer after a valid pick', async () => {
+    const csrf = await http.withCsrf('/health')
+    await csrf
+      .withHeaders({ Referer: 'http://localhost/posts?page=2' })
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/posts?page=2')
+  })
+
+  it('redirects home without a referer', async () => {
+    await (await http.withCsrf('/health')).post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('rejects unsupported or missing locales', async () => {
+    const csrf = await http.withCsrf('/health')
+    await csrf.post('/locale', { locale: 'fr' }).assertStatus(422)
+    await csrf.post('/locale', {}).assertStatus(422)
+  })
+})
