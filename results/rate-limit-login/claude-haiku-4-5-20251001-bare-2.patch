+++ b/app/Http/Services/LoginRateLimiter.ts
@@ -0,0 +1,48 @@
+import type { Context } from 'hono'
+
+interface AttemptRecord {
+  count: number
+  resetAt: number
+}
+
+const ATTEMPTS_LIMIT = 5
+const WINDOW_MS = 60 * 1000 // 1 minute
+
+const attempts = new Map<string, AttemptRecord>()
+
+function getClientIp(ctx: Context): string {
+  try {
+    // Try to use the Bun runtime's connection info
+    const req = ctx.req.raw as any
+    if (req?.socket?.remoteAddress) {
+      return req.socket.remoteAddress
+    }
+  } catch {
+    // Ignore errors, fall through to unknown
+  }
+
+  return 'unknown'
+}
+
+export function checkLoginRateLimit(ctx: Context): { allowed: boolean; retryAfterSeconds: number } {
+  const ip = getClientIp(ctx)
+  const now = Date.now()
+
+  const record = attempts.get(ip)
+
+  if (!record || now >= record.resetAt) {
+    // Create a new window
+    attempts.set(ip, { count: 1, resetAt: now + WINDOW_MS })
+    return { allowed: true, retryAfterSeconds: 0 }
+  }
+
+  // Within the current window
+  if (record.count < ATTEMPTS_LIMIT) {
+    record.count++
+    return { allowed: true, retryAfterSeconds: 0 }
+  }
+
+  // Limit exceeded
+  const retryAfterSeconds = Math.ceil((record.resetAt - now) / 1000)
+  return { allowed: false, retryAfterSeconds }
+}
