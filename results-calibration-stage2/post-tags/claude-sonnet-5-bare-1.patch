diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..0a5ebf0
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,64 @@
+import { and, eq, inArray, notInArray } from 'drizzle-orm'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+// Tag data lives in `tags` and `post_tags`; posts reach it through these
+// helpers rather than a model relation, so a whole page of posts costs one query.
+
+/** Tag names per post id, sorted alphabetically. Posts without tags are absent. */
+export async function tagNamesForPosts(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) return byPost
+
+  const db = (await getDatabase()) as any
+  const rows: Array<{ postId: number; name: string }> = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const { postId, name } of rows) {
+    const names = byPost.get(postId) ?? []
+    names.push(name)
+    byPost.set(postId, names)
+  }
+  for (const names of byPost.values()) names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+
+  return byPost
+}
+
+/** Ids of the posts carrying the tag `name`; empty when nobody uses it. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const db = (await getDatabase()) as any
+  const rows: Array<{ postId: number }> = await db
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+
+  return rows.map((row) => row.postId)
+}
+
+/** Makes `names` exactly the set of tags attached to the post. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const db = (await getDatabase()) as any
+
+  if (names.length > 0) {
+    await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing()
+  }
+  const tagRows: Array<{ id: number }> =
+    names.length > 0 ? await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names)) : []
+  const tagIds = tagRows.map((row) => row.id)
+
+  await db
+    .delete(postTags)
+    .where(tagIds.length > 0 ? and(eq(postTags.postId, postId), notInArray(postTags.tagId, tagIds)) : eq(postTags.postId, postId))
+  if (tagIds.length > 0) {
+    await db.insert(postTags).values(tagIds.map((tagId) => ({ postId, tagId }))).onConflictDoNothing()
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  const db = (await getDatabase()) as any
+  await db.delete(postTags).where(eq(postTags.postId, postId))
+}
