@@ -0,0 +1,56 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+// /login renders without touching the database, so these tests stay green
+// without migrations, like the posts.search starter test.
+async function i18nOf(http: TestApp): Promise<{ locale: string; messages: Record<string, any> }> {
+  const response = await http.get('/login')
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { _i18n: { locale: string; messages: Record<string, any> } })._i18n
+}
+
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('stays English without a pick or a Japanese browser', async () => {
+    expect((await i18nOf(http)).locale).toBe('en')
+    expect((await i18nOf(http.withHeader('Accept-Language', 'en-US,en;q=0.9'))).locale).toBe('en')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja'))).locale).toBe('ja')
+    const i18n = await i18nOf(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'))
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja.nav.posts).toBe('記事')
+  })
+
+  it('lets the cookie a pick sets win over the browser', async () => {
+    const i18n = await i18nOf(http.withHeaders({ Cookie: 'locale=en', 'Accept-Language': 'ja' }))
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('remembers a pick and redirects back to the Referer', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts')
+      .assertCookie('locale', 'ja')
+  })
+
+  it('redirects to / without a Referer', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf.post('/locale', { locale: 'en' }).assertRedirect('/').assertCookie('locale', 'en')
+  })
+
+  it('rejects an unsupported locale without changing the pick', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf.json().post('/locale', { locale: 'fr' }).assertStatus(422).assertCookieMissing('locale')
+    await csrf.json().post('/locale', {}).assertStatus(422).assertCookieMissing('locale')
+  })
+})
