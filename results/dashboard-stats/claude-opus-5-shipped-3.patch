diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..07acf95
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,78 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createUser(email: string): Promise<UserRecord> {
+    const user = await User.create({ name: email.split('@')[0]!, email, password: 'secret123' })
+    return user as UserRecord
+  }
+
+  async function createPost(author: UserRecord, title: string, createdAt: string) {
+    return Post.forceCreate({
+      title,
+      excerpt: `${title} excerpt`,
+      body: `${title} body`,
+      authorId: author.id,
+      createdAt,
+    })
+  }
+
+  it('redirects guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows the signed-in user their post count and 5 most recent posts', async () => {
+    const author = await createUser('author@example.com')
+    const other = await createUser('other@example.com')
+
+    for (let index = 1; index <= 7; index += 1) {
+      await createPost(author, `Post ${index}`, `2026-01-0${index}T00:00:00.000Z`)
+    }
+    await createPost(other, 'Someone else', '2026-02-01T00:00:00.000Z')
+
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get('/dashboard')
+    response.assertOk()
+    const props = (await response.json<{ props: DashboardProps }>()).props
+
+    expect(props.postCount).toBe(7)
+    expect(props.recentPosts).toEqual([
+      { id: expect.any(Number), title: 'Post 7' },
+      { id: expect.any(Number), title: 'Post 6' },
+      { id: expect.any(Number), title: 'Post 5' },
+      { id: expect.any(Number), title: 'Post 4' },
+      { id: expect.any(Number), title: 'Post 3' },
+    ])
+  })
+
+  it('reports an empty state for a user without posts', async () => {
+    const author = await createUser('empty@example.com')
+    const other = await createUser('busy@example.com')
+    await createPost(other, 'Not mine', '2026-03-01T00:00:00.000Z')
+
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get('/dashboard')
+    response.assertOk()
+    const props = (await response.json<{ props: DashboardProps }>()).props
+
+    expect(props.postCount).toBe(0)
+    expect(props.recentPosts).toEqual([])
+  })
+})
+
+interface DashboardProps {
+  postCount: number
+  recentPosts: Array<{ id: number; title: string }>
+}
