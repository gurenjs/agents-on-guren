diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..29acea5
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,167 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+// Feature tests against the test database (./data/guren.test.db, migrated when
+// the app boots). Every row is created here under a unique email and removed
+// again in afterAll, so the suite neither needs nor disturbs seeded data.
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  const run = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+  beforeAll(async () => {
+    // Mutating requests pass the CSRF check the way a browser's would.
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    author = await User.create({ name: 'Author', email: `author-${run}@example.test`, password: 'secret-password' })
+    stranger = await User.create({ name: 'Stranger', email: `stranger-${run}@example.test`, password: 'secret-password' })
+  })
+
+  afterAll(async () => {
+    for (const user of [author, stranger]) {
+      const posts = await Post.where({ authorId: user.id }).get()
+      for (const post of posts) {
+        await Post.destroyWithRevisions(post.id)
+      }
+      await User.delete({ id: user.id })
+    }
+  })
+
+  function content(title: string) {
+    return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+  }
+
+  async function createPost(title: string, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ ...content(title), authorId: owner.id })
+  }
+
+  async function edit(post: PostRecord, title: string): Promise<void> {
+    await http.actingAs(author).put(`/posts/${post.id}`, content(title)).assertRedirect(`/posts/${post.id}`)
+  }
+
+  async function revisionsOf(post: PostRecord) {
+    return PostRevision.where({ postId: post.id }).orderBy('id', 'asc').get()
+  }
+
+  async function listedRevisions(post: PostRecord) {
+    const response = await http.actingAs(author).get(`/posts/${post.id}/revisions`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    expect(payload.component).toBe('posts/Revisions')
+    return payload.props.revisions as Array<{ id: number; title: string; createdAt: string }>
+  }
+
+  it('keeps nothing when a post is created', async () => {
+    const response = await http.actingAs(author).post('/posts', content('Fresh')).assertRedirect()
+    const id = Number(response.headers.get('location')?.split('/').pop())
+
+    expect(await PostRevision.where({ postId: id }).get()).toEqual([])
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+
+    const revisions = await revisionsOf(post)
+    expect(revisions.map(({ title, excerpt, body }) => ({ title, excerpt, body }))).toEqual([
+      content('First'),
+      content('Second'),
+    ])
+    expect(revisions.every((revision) => !Number.isNaN(Date.parse(revision.createdAt)))).toBe(true)
+    expect((await Post.findOrFail(post.id)).title).toBe('Third')
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await createPost('Untouched')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { ...content('Invalid'), title: '' }).assertUnprocessable()
+    await http.actingAs(stranger).put(`/posts/${post.id}`, content('Hijacked')).assertForbidden()
+    await http.put(`/posts/${post.id}`, content('Anonymous')).assertRedirect('/login')
+
+    expect(await revisionsOf(post)).toEqual([])
+    expect((await Post.findOrFail(post.id)).title).toBe('Untouched')
+  })
+
+  it('lists revisions newest first', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+
+    const listed = await listedRevisions(post)
+    const stored = await revisionsOf(post)
+
+    expect(listed.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(listed.map((revision) => revision.id)).toEqual(stored.map((revision) => revision.id).reverse())
+    expect(listed.every((revision) => typeof revision.createdAt === 'string')).toBe(true)
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+    const [first] = await revisionsOf(post)
+
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first!.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect({ title: restored.title, excerpt: restored.excerpt, body: restored.body }).toEqual(content('First'))
+    expect((await listedRevisions(post)).map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses everyone but the author', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    const [first] = await revisionsOf(post)
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(stranger).post(`/posts/${post.id}/revisions/${first!.id}/restore`).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${first!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect((await revisionsOf(post)).map((revision) => revision.title)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post, even one by the same author', async () => {
+    const post = await createPost('Mine')
+    const other = await createPost('Other first')
+    await edit(other, 'Other second')
+    const [foreign] = await revisionsOf(other)
+
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/999999999/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect(await revisionsOf(post)).toEqual([])
+    expect((await revisionsOf(other)).map((revision) => revision.title)).toEqual(['Other first'])
+  })
+
+  it('deletes the history with the post, and only that post’s', async () => {
+    const post = await createPost('Doomed')
+    const kept = await createPost('Kept')
+    await edit(post, 'Doomed again')
+    await edit(kept, 'Kept again')
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await revisionsOf(post)).toEqual([])
+    expect((await revisionsOf(kept)).map((revision) => revision.title)).toEqual(['Kept'])
+  })
+
+  it('deletes a post that has no revisions', async () => {
+    const post = await createPost('Never edited')
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+  })
+})
