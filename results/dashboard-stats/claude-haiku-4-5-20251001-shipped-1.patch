diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..42a0132
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,140 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects unauthenticated users to login', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows dashboard for authenticated user', async () => {
+    const user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password',
+    })
+
+    const res = await http.actingAs(user).get('/dashboard')
+    res.assertOk()
+  })
+
+  it('shows post count and recent posts', async () => {
+    const user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password',
+    })
+
+    const post1 = await Post.forceCreate({
+      title: 'First Post',
+      excerpt: 'Excerpt 1',
+      body: 'Body 1',
+      authorId: user.id,
+      createdAt: new Date('2024-01-01T10:00:00Z').toISOString(),
+    })
+
+    const post2 = await Post.forceCreate({
+      title: 'Second Post',
+      excerpt: 'Excerpt 2',
+      body: 'Body 2',
+      authorId: user.id,
+      createdAt: new Date('2024-01-02T10:00:00Z').toISOString(),
+    })
+
+    const res = await http.actingAs(user).get('/dashboard')
+    res.assertOk()
+
+    const postCount = await Post.where({ authorId: user.id }).count()
+    expect(postCount).toBe(2)
+
+    const recentPosts = await Post.where({ authorId: user.id })
+      .orderBy('createdAt', 'desc')
+      .limit(5)
+      .get()
+
+    expect(recentPosts.length).toBe(2)
+    expect(recentPosts[0].id).toBe(post2.id)
+    expect(recentPosts[0].title).toBe('Second Post')
+    expect(recentPosts[1].id).toBe(post1.id)
+    expect(recentPosts[1].title).toBe('First Post')
+  })
+
+  it('limits recent posts to 5', async () => {
+    const user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password',
+    })
+
+    for (let i = 1; i <= 7; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: user.id,
+      })
+    }
+
+    const postCount = await Post.where({ authorId: user.id }).count()
+    expect(postCount).toBe(7)
+
+    const recentPosts = await Post.where({ authorId: user.id })
+      .orderBy('createdAt', 'desc')
+      .limit(5)
+      .get()
+
+    expect(recentPosts.length).toBe(5)
+  })
+
+  it('only shows posts by the signed-in user', async () => {
+    const user1 = await User.create({
+      name: 'User 1',
+      email: 'user1@example.com',
+      password: 'password',
+    })
+
+    const user2 = await User.create({
+      name: 'User 2',
+      email: 'user2@example.com',
+      password: 'password',
+    })
+
+    const post1 = await Post.forceCreate({
+      title: 'User 1 Post',
+      excerpt: 'Excerpt 1',
+      body: 'Body 1',
+      authorId: user1.id,
+    })
+
+    await Post.forceCreate({
+      title: 'User 2 Post',
+      excerpt: 'Excerpt 2',
+      body: 'Body 2',
+      authorId: user2.id,
+    })
+
+    const user1PostCount = await Post.where({ authorId: user1.id }).count()
+    const user2PostCount = await Post.where({ authorId: user2.id }).count()
+
+    expect(user1PostCount).toBe(1)
+    expect(user2PostCount).toBe(1)
+
+    const user1RecentPosts = await Post.where({ authorId: user1.id })
+      .orderBy('createdAt', 'desc')
+      .limit(5)
+      .get()
+
+    expect(user1RecentPosts.length).toBe(1)
+    expect(user1RecentPosts[0].id).toBe(post1.id)
+  })
+})
