+        >
+          {creating ? 'Creating…' : 'Create token'}
+        </button>
+      </form>
+
+      {tokens.length === 0 ? (
+        <p className="text-sm text-g-muted">No tokens yet.</p>
+      ) : (
+        <ul className="divide-y divide-g-line">
+          {tokens.map((token) => (
