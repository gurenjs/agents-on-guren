diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..ac420fe
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,84 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('RegisterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('renders the sign-up page', async () => {
+    await http.get('/register').assertOk()
+  })
+
+  it('creates the account and redirects to the dashboard on a valid submission', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'correct-horse',
+        passwordConfirmation: 'correct-horse',
+      })
+      .assertRedirect('/dashboard')
+
+    const user = await User.first({ email: 'ada@example.com' })
+    if (!user) {
+      throw new Error('expected the user to have been created')
+    }
+  })
+
+  it('rejects a mismatched password confirmation with a 422 keyed by field', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'correct-horse',
+        passwordConfirmation: 'not-the-same',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.passwordConfirmation.0', 'Passwords do not match.')
+  })
+
+  it('rejects a blank name with a 422 keyed by field', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: '',
+        email: 'ada@example.com',
+        password: 'correct-horse',
+        passwordConfirmation: 'correct-horse',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.name.0', 'Name is required.')
+  })
+
+  it('rejects a badly formatted email with a 422 keyed by field', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'not-an-email',
+        password: 'correct-horse',
+        passwordConfirmation: 'correct-horse',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'The email address is badly formatted.')
+  })
+})
