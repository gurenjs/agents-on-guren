diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..e7c2359
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,94 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const payload = { title: 'Hello', excerpt: 'Short', body: 'Long body' }
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const links = await PostTag.where({ postId }).get()
+  const tags = await Tag.where({ id: links.map((link) => link.tagId) }).get()
+  return tags.map((tag) => tag.name).sort()
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  async function authed(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function createPost(tags?: string): Promise<number> {
+    const client = await authed()
+    await client.post('/posts', { ...payload, tags }).assertRedirect()
+    const [post] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+    return post!.id
+  }
+
+  it('creates tags and shows them sorted on the post page', async () => {
+    const id = await createPost('webdev, bun')
+    expect(await tagNamesOf(id)).toEqual(['bun', 'webdev'])
+    const page = await (await http.json().get(`/posts/${id}`)).json<{ props: { post: { tags: string[] } } }>()
+    expect(page.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('detaches tags removed on edit', async () => {
+    const id = await createPost('bun, webdev')
+    const client = await authed()
+    await client.put(`/posts/${id}`, { ...payload, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+  })
+
+  it('trims and de-duplicates names', async () => {
+    const id = await createPost(' bun ,bun,,')
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('refuses too many or too long tags without writing anything', async () => {
+    const client = await authed()
+    await client.json().post('/posts', { ...payload, tags: 'a,b,c,d,e,f' }).assertUnprocessable().assertJsonPath('errors.tags.0', 'A post may have at most 5 tags.')
+    await client.json().post('/posts', { ...payload, tags: 'x'.repeat(31) }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+
+    const id = await createPost('x'.repeat(30))
+    expect(await tagNamesOf(id)).toEqual(['x'.repeat(30)])
+  })
+
+  it('filters the list by tag', async () => {
+    const tagged = await createPost('bun')
+    await createPost()
+    const res = await http.json().get('/posts?tag=bun')
+    const page = await res.json<{ props: { data: Array<{ id: number; tags: string[] }> } }>()
+    expect(page.props.data.map((post) => post.id)).toEqual([tagged])
+
+    const none = await (await http.json().get('/posts?tag=nope')).json<{ props: { data: unknown[] } }>()
+    expect(none.props.data).toEqual([])
+
+    const all = await (await http.json().get('/posts')).json<{ props: { data: Array<{ tags: string[] }> } }>()
+    expect(all.props.data.map((post) => post.tags)).toEqual([[], ['bun']])
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun')
+    const client = await authed()
+    await client.delete(`/posts/${id}`).assertRedirect('/posts')
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.where({ postId: id }).count()).toBe(0)
+  })
+})
