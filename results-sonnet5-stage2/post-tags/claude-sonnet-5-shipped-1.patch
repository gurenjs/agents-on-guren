diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..042b4fb
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+
+const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret123' })
+    csrf = await http.actingAs(author).withCsrf()
+  })
+
+  let csrf: TestApp
+  function store(tags?: string) {
+    return csrf.json().post('/posts', { ...base, tags })
+  }
+
+  async function tagsOf(postId: number) {
+    const res = await http.withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+    const page = await res.json<{ props: { post: { tags: string[] } } }>()
+    return page.props.post.tags
+  }
+
+  it('creates, trims, dedupes and syncs tags', async () => {
+    await store(' bun ,bun, webdev,').assertRedirect()
+    const post = (await Post.all())[0]
+    expect(await Tag.all()).toHaveLength(2)
+    expect(await PostTag.all()).toHaveLength(2)
+    expect((await Post.all()).length).toBe(1)
+    expect(post).toBeDefined()
+  })
+
+  it('refuses invalid tag input without writing', async () => {
+    await store('a,b,c,d,e,f').assertUnprocessable()
+    await store('x'.repeat(31)).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    await store('x'.repeat(30)).assertRedirect()
+  })
+
+  it('filters by tag and deletes tagged posts', async () => {
+    await store('bun')
+    await store('other')
+    const bunPosts = await http.withHeader('X-Inertia', 'true').get('/posts?tag=bun')
+    expect(bunPosts.status).toBe(200)
+    const [post] = await Post.all()
+    await csrf.put(`/posts/${post!.id}`, { ...base, tags: 'other' }).assertRedirect()
+    expect(await tagsOf(post!.id)).toEqual(['other'])
+    await csrf.delete(`/posts/${post!.id}`).assertRedirect()
+    expect(await PostTag.all()).toHaveLength(1)
+  })
+})
