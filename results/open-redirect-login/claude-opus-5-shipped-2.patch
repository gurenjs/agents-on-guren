index 0000000..6eec58b
--- /dev/null
+++ b/app/Support/SafeRedirect.ts
@@ -0,0 +1,60 @@
+/**
+ * Guards "send me back where I came from" parameters against open redirects.
+ *
+ * A redirect target that arrives with the request is attacker-controlled: a
+ * link to our own /login carrying `?redirect=https://evil.example` looks
+ * trustworthy right up until the browser lands on someone else's site. Only a
+ * path inside this app is ever honoured; anything else falls back to the
+ * default destination, exactly as if no redirect had been supplied.
+ */
+
+/** Any origin works — it only exists so a relative path can be resolved. */
+const PROBE_ORIGIN = 'http://redirect.invalid'
+
+/**
+ * Drop tabs, newlines and the rest of the control characters. Browsers remove
+ * them from a URL before resolving it, so a value like "/<tab>/evil.example"
+ * would otherwise slip past the checks below and hit the network as
+ * "//evil.example".
+ */
+function stripControlCharacters(value: string): string {
+  let stripped = ''
+  for (const character of value) {
+    const code = character.codePointAt(0) ?? 0
+    if (code > 0x1f && code !== 0x7f) stripped += character
+  }
+  return stripped
+}
+
+/**
+ * Normalize a requested redirect target to a same-app path.
+ *
+ * Returns `fallback` for absolute URLs, protocol-relative values (`//host`),
+ * backslash variants browsers rewrite into those (`/\host`), and anything that
+ * does not parse as a plain in-app path.
+ */
+export function sanitizeRedirectTarget(value: unknown, fallback: string): string {
+  if (typeof value !== 'string') return fallback
+
+  const candidate = stripControlCharacters(value).trim()
+  if (candidate === '') return fallback
+
+  // Browsers treat a backslash as a forward slash in URLs, which turns
+  // "/\evil.example" into "//evil.example" — another origin.
+  const normalized = candidate.replace(/\\/g, '/')
+
+  // A same-app path starts with exactly one slash: no scheme ("https://…"),
+  // no protocol-relative prefix ("//host"), no bare relative value.
+  if (!normalized.startsWith('/') || normalized.startsWith('//')) return fallback
+
+  // Belt and braces: resolve it and confirm it never left the probe origin.
+  let resolved: URL
+  try {
+    resolved = new URL(normalized, PROBE_ORIGIN)
+  } catch {
+    return fallback
+  }
+  if (resolved.origin !== PROBE_ORIGIN) return fallback
+
+  return `${resolved.pathname}${resolved.search}${resolved.hash}`
+}
