diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..290ab3d
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,112 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let sequence = 0
+
+async function makeUser(): Promise<UserRecord> {
+  sequence += 1
+  const email = `commenter-${Date.now()}-${sequence}@example.test`
+  return User.create({ name: `Commenter ${sequence}`, email, password: 'password-123' })
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({ title: 'A post', excerpt: 'Excerpt', body: 'Body', authorId: author.id })
+}
+
+async function showProps(http: TestApp, postId: number) {
+  const res = await http.get(`/posts/${postId}`)
+  const { payload } = await readInertiaResponse(res.raw)
+  return payload.props as { comments: Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }> }
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf('/')
+  })
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+
+    await http.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+    expect(await Comment.where('postId', post.id).get()).toHaveLength(0)
+  })
+
+  it('stores a comment and lists it oldest first with its author', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const post = await makePost(author)
+
+    await http.actingAs(reader).post(`/posts/${post.id}/comments`, { body: 'First' }).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).post(`/posts/${post.id}/comments`, { body: 'Second' }).assertRedirect(`/posts/${post.id}`)
+
+    const { comments } = await showProps(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['First', 'Second'])
+    expect(comments[0]?.author).toEqual({ id: reader.id, name: reader.name })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects an empty or oversized body', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+
+    const blank = await http.actingAs(author).post(`/posts/${post.id}/comments`, { body: '' })
+    expect(blank.status).not.toBe(200)
+    await http.actingAs(author).post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) })
+    expect(await Comment.where('postId', post.id).get()).toHaveLength(0)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const stranger = await makeUser()
+    const post = await makePost(author)
+    const first = await Comment.forceCreate({ body: 'a', postId: post.id, userId: reader.id })
+    const second = await Comment.forceCreate({ body: 'b', postId: post.id, userId: reader.id })
+
+    await http.actingAs(stranger).delete(`/comments/${first.id}`).assertForbidden()
+    expect(await Comment.find(first.id)).not.toBeNull()
+
+    await http.actingAs(reader).delete(`/comments/${first.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(first.id)).toBeNull()
+
+    await http.actingAs(author).delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second.id)).toBeNull()
+  })
+
+  it('counts a repeated report once and hides a comment at three reporters', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ body: 'spam', postId: post.id, userId: author.id })
+    const reporters = [await makeUser(), await makeUser(), await makeUser()]
+
+    await http.actingAs(reporters[0]).post(`/comments/${comment.id}/report`).assertNoContent()
+    await http.actingAs(reporters[0]).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where('commentId', comment.id).get()).toHaveLength(1)
+
+    await http.actingAs(reporters[1]).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(http, post.id)).comments).toHaveLength(1)
+
+    await http.actingAs(reporters[2]).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(http, post.id)).comments).toHaveLength(0)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    await Comment.forceCreate({ body: 'bye', postId: post.id, userId: author.id })
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where('postId', post.id).get()).toHaveLength(0)
+  })
+})
