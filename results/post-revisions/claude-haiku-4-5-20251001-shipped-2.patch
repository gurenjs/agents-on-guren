@@ -0,0 +1,63 @@
+import { Head, Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ revisions }: Props) {
+  const postId = new URL(window.location.href).pathname.split('/')[2]
+
+  return (
+    <Layout>
+      <Head title="Post Revisions" />
+      <div className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Post Revisions
+          </h1>
+          <p className="text-sm text-g-text-2">Restore any previous version of this post</p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No revisions yet. Edit the post to create revisions.</p>
+        ) : (
+          <div className="space-y-3">
+            {revisions.map((revision) => (
+              <div key={revision.id} className="flex items-center justify-between border border-g-line rounded-g-ctl p-4">
+                <div className="space-y-1">
+                  <p className="font-semibold text-g-heading">{revision.title}</p>
+                  <p className="text-sm text-g-text-2">
+                    {new Date(revision.createdAt).toLocaleString()}
+                  </p>
+                </div>
+                <Link
+                  href={route('posts.revisions.restore', { id: postId, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  className="rounded-g-ctl bg-g-accent px-4 py-2 font-semibold text-g-accent-text transition hover:opacity-90"
+                >
+                  Restore
+                </Link>
+              </div>
+            ))}
+          </div>
+        )}
+
+        <footer className="border-t border-g-line pt-6">
+          <Link href={route('posts.show', { id: postId })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </div>
+    </Layout>
+  )
+}
