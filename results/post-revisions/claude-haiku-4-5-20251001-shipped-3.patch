+describe('post revisions', () => {
+  let http: TestApp
+  let author: any
+  let otherUser: any
+  let post: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({
+      name: 'Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+    otherUser = await User.create({
+      name: 'Other User',
+      email: 'other@example.com',
+      password: 'password123',
+    })
+    post = await Post.forceCreate({
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+      authorId: author.id,
+    })
+  })
+
+  it('creates no revision when post is created', async () => {
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions.length).toBe(0)
+  })
+
+  it('creates a revision when post is edited', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, {
+      title: 'Second',
+      excerpt: 'Second excerpt',
+      body: 'Second body',
+    }).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions.length).toBe(1)
+    expect(revisions[0].title).toBe('First')
+    expect(revisions[0].excerpt).toBe('First excerpt')
+    expect(revisions[0].body).toBe('First body')
+  })
+
+  it('lists revisions for the post author', async () => {
+    await Post.update({ id: post.id }, { title: 'Second', excerpt: 'Second excerpt', body: 'Second body' })
+    await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+    })
+
+    await http.actingAs(author).get(`/posts/${post.id}/revisions`).assertOk()
+  })
+
+  it('returns revisions in correct order', async () => {
+    const rev1 = await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+    await new Promise((r) => setTimeout(r, 10))
+    const rev2 = await PostRevision.create({
+      postId: post.id,
+      title: 'Second',
+      excerpt: 'excerpt2',
+      body: 'body2',
+    })
+
+    const revisions = await PostRevision.where({ postId: post.id })
+      .orderBy('createdAt', 'desc')
+      .get()
+    expect(revisions.length).toBe(2)
+    expect(revisions[0].id).toBe(rev2.id)
+    expect(revisions[1].id).toBe(rev1.id)
+  })
+
+  it('forbids revision listing for non-author', async () => {
+    await http.actingAs(otherUser).get(`/posts/${post.id}/revisions`).assertForbidden()
+  })
+
+  it('requires auth for revision listing', async () => {
+    // Guests and non-auth users are redirected by middleware or return 401/403
+    const res = await http.get(`/posts/${post.id}/revisions`)
+    expect([301, 302, 303, 307, 308, 401, 403]).toContain(res.status)
+  })
+
+  it('restores a revision', async () => {
+    await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+    })
+    await Post.update({ id: post.id }, {
+      title: 'Second',
+      excerpt: 'Second excerpt',
+      body: 'Second body',
+    })
+
+    const revision = await PostRevision.first({ postId: post.id })
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.title).toBe('First')
+    expect(updated.excerpt).toBe('First excerpt')
+    expect(updated.body).toBe('First body')
+  })
+
+  it('creates a new revision when restoring', async () => {
+    const rev1 = await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+    await Post.update({ id: post.id }, {
+      title: 'Second',
+      excerpt: 'excerpt2',
+      body: 'body2',
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${rev1.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions.length).toBe(2)
+    // The new revision should have "Second" content (what was there before restore)
+    const secondRevision = revisions.find((r) => r.id !== rev1.id)
+    expect(secondRevision?.title).toBe('Second')
+  })
+
+  it('forbids restore for non-author', async () => {
