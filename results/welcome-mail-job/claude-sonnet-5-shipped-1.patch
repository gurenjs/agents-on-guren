--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,17 @@
+import { ServiceProvider, setQueueDriver, registerJob } from '@guren/core'
+import { queueManager } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => queueManager)
+  }
+
+  boot(): void {
+    // Job.dispatch() reads this global rather than the container, so it has
+    // to be set explicitly — the framework's own QueueServiceProvider binds
+    // the container service but never calls setQueueDriver().
+    setQueueDriver(queueManager.driver())
+    registerJob(SendWelcomeEmailJob)
+  }
+}
