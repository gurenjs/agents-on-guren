@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,56 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.destroy', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createPost() {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Author-owned post',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: author.id,
+    })
+    return { author, post }
+  }
+
+  it('lets the author delete their own post', async () => {
+    const { author, post } = await createPost()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+  })
+
+  it('refuses a signed-in user who is not the author', async () => {
+    const { post } = await createPost()
+    const other = await User.create({ name: 'Other', email: 'other@example.com', password: 'password123' })
+
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertStatus(403)
+
+    expect(await Post.find(post.id)).not.toBeNull()
+  })
+
+  it('refuses a guest', async () => {
+    const { post } = await createPost()
+
+    // Prime CSRF without acting as anyone, so this exercises the `auth`
+    // middleware's guest handling rather than the CSRF layer in front of it.
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/login')
+
+    expect(await Post.find(post.id)).not.toBeNull()
+  })
+})
