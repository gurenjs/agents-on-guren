+      if (!response.ok) {
+        setError(response.status === 422 ? 'Name must be 1 to 50 characters.' : 'Could not create the token.')
+        return
+      }
+      const payload = (await response.json()) as { name: string; token: string }
+      setCreated({ name: payload.name, token: payload.token })
+      setName('')
+      reloadTokens()
+    } catch {
+      setError('Could not create the token — check your connection and try again.')
+    } finally {
+      setBusy(false)
+    }
+  }
+
