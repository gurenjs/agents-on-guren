diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..f95758b
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,48 @@
+import { randomUUID } from 'node:crypto'
+import { mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+const COVER_DIR = join(process.cwd(), 'storage', 'covers')
+
+/** Identifies PNG/JPEG by magic bytes; the client-declared type is not trusted. */
+export function sniffCoverType(bytes: Uint8Array): 'image/png' | 'image/jpeg' | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (png.every((byte, i) => bytes[i] === byte)) return 'image/png'
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+export function coverPath(storedName: string): string {
+  return join(COVER_DIR, storedName)
+}
+
+export function coverUrl(attachment: AttachmentRecord | null | undefined): string | null {
+  return attachment ? `/attachments/${attachment.id}` : null
+}
+
+export async function removeCover(postId: number): Promise<void> {
+  const rows = await Attachment.where({ postId }).get()
+  for (const row of rows) {
+    await Attachment.delete({ id: row.id })
+    await rm(coverPath(row.storedName), { force: true })
+  }
+}
+
+/** Stores the new file first, then drops the previous cover, so a failed write keeps the old one. */
+export async function replaceCover(postId: number, file: File): Promise<void> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const mimeType = sniffCoverType(bytes) ?? 'application/octet-stream'
+  const storedName = randomUUID()
+  await mkdir(COVER_DIR, { recursive: true })
+  await Bun.write(coverPath(storedName), bytes)
+
+  const previous = await Attachment.where({ postId }).get()
+  await Attachment.create({ postId, storedName, mimeType, size: bytes.byteLength })
+  for (const row of previous) {
+    await Attachment.delete({ id: row.id })
+    await rm(coverPath(row.storedName), { force: true })
+  }
+}
