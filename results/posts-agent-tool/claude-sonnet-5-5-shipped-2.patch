diff --git a/tests/Mcp.test.ts b/tests/Mcp.test.ts
new file mode 100644
index 0000000..40bbb84
--- /dev/null
+++ b/tests/Mcp.test.ts
@@ -0,0 +1,91 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../db/schema.js'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+const headers = (token?: string) => ({
+  'content-type': 'application/json',
+  accept: 'application/json, text/event-stream',
+  ...(token ? { authorization: `Bearer ${token}` } : {}),
+})
+
+async function rpc(method: string, params: unknown, token?: string): Promise<Response> {
+  return app.fetch(
+    new Request('http://localhost/mcp', {
+      method: 'POST',
+      headers: headers(token),
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+    }),
+  )
+}
+
+async function result(res: Response): Promise<any> {
+  const text = await res.text()
+  const json = text.startsWith('{') ? text : (text.split('\n').find((l) => l.startsWith('data:')) ?? '').slice(5)
+  return JSON.parse(json).result
+}
+
+describe('POST /mcp', () => {
+  let token: string
+  let userId: number
+
+  beforeAll(async () => {
+    await app.boot()
+    await resetDatabase()
+    const user = await User.create({
+      name: 'Mcp',
