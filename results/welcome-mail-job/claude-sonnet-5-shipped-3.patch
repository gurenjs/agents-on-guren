@@ -0,0 +1,19 @@
+import { createQueueManager, createRedisClient, MemoryDriver, RedisDriver, SyncDriver, type QueueConfig } from '@guren/core'
+
+// QUEUE_CONNECTION=sync runs queued work immediately, in-process — the
+// default for development. Production points this at redis, where a
+// separate `worker` process pops and runs jobs pushed here.
+function resolveQueueConnection(): string {
+  return process.env.QUEUE_CONNECTION ?? 'sync'
+}
+
+const config: QueueConfig = {
+  default: resolveQueueConnection(),
+  drivers: {
+    sync: () => new SyncDriver(),
+    memory: () => new MemoryDriver(),
+    redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+  },
+}
+
+export const queueManager = createQueueManager(config)
