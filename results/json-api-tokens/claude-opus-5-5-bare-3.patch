diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..7202c82
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,41 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+// The one store every token surface reads: the profile page that issues and
+// revokes tokens, the bearer middleware on /api, and the auth manager's token
+// guard. It keeps only the SHA-256 of each secret, never the secret itself.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const API_RATE_LIMIT_PER_MINUTE = 60
+
+// Answers 401 with a JSON body for a missing, malformed, unknown or revoked
+// token, and otherwise signs the request in as the token's owner.
+export const requireApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+})
+
+// Keyed on the verified token rather than the user or IP, so each of a
+// user's tokens gets its own budget. Must run after requireApiToken.
+// The memory store is per-process: swap in a shared RateLimitStore
+// (Redis, database) before running more than one server process.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT_PER_MINUTE,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  onRateLimited: (ctx, retryAfter) => {
+    // Never "retry after 0 seconds" at the very end of a window.
+    const seconds = Math.max(1, retryAfter)
+    ctx.header('Retry-After', String(seconds))
+    return ctx.json({ message: 'Too many requests, please try again later.', retryAfter: seconds }, 429)
+  },
+})
