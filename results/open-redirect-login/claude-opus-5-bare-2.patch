+++ b/tests/LoginController.test.ts
@@ -0,0 +1,83 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+
+// The sign-in form carries a `redirect` so the user lands back on the page
+// that asked them to log in. It comes from the URL, so the controller has to
+// treat it as untrusted: a same-app path is honoured, anything pointing at
+// another origin is dropped for the default destination.
+describe('login redirect', () => {
+  let http: TestApp
+
+  async function signIn(body: Record<string, unknown>) {
+    const csrf = await (await TestApp.fromApp(app)).withCsrf('/login')
+    return csrf.post('/login', body)
+  }
+
+  beforeAll(async () => {
+    // Ask for the Inertia payload rather than the rendered document, so the
+    // props the page receives can be asserted directly.
+    http = (await TestApp.fromApp(app)).withHeaders({ 'X-Inertia': 'true' })
+  })
+
+  it('keeps a same-app path on the login page', async () => {
+    await http
+      .get('/login?redirect=%2Fposts%2F3%2Fedit')
+      .assertOk()
+      .assertInertia('auth/Login', { redirect: '/posts/3/edit' })
+  })
+
+  it('drops an off-site destination from the login page', async () => {
+    await http
+      .get('/login?redirect=https%3A%2F%2Fevil.example')
+      .assertOk()
+      .assertInertia('auth/Login', { redirect: '' })
+  })
+
+  it('returns the user to the page they came from', async () => {
+    const response = await signIn({
+      email: DEMO_EMAIL,
+      password: 'secret',
+      redirect: '/posts/3/edit',
+    })
+
+    response.assertRedirect('/posts/3/edit')
+  })
+
+  it('ignores an absolute URL and signs the user in anyway', async () => {
+    const response = await signIn({
+      email: DEMO_EMAIL,
+      password: 'secret',
+      redirect: 'https://evil.example',
+    })
+
+    response.assertRedirect('/dashboard')
+    expect(response.headers.get('location')).not.toContain('evil.example')
+  })
+
+  it('ignores protocol-relative and backslash destinations', async () => {
+    for (const redirect of ['//evil.example', '/\\evil.example', '/\t/evil.example']) {
+      const response = await signIn({ email: DEMO_EMAIL, password: 'secret', redirect })
+      response.assertRedirect('/dashboard')
+    }
+  })
+
+  it('ignores an off-site destination given in the query string', async () => {
+    const csrf = await (await TestApp.fromApp(app)).withCsrf('/login')
+    await csrf
+      .post('/login?redirect=https://evil.example', { email: DEMO_EMAIL, password: 'secret' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('still rejects a wrong password', async () => {
+    const response = await signIn({
+      email: DEMO_EMAIL,
+      password: 'not-the-password',
+      redirect: '/posts/3/edit',
+    })
+
+    response.assertStatus(422)
+    expect(response.headers.get('location')).toBeNull()
+  })
+})
diff --git a/tests/SafeRedirect.test.ts b/tests/SafeRedirect.test.ts
new file mode 100644
