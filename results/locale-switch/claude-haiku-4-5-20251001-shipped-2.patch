@@ -0,0 +1,22 @@
+import { Controller } from '@guren/core'
+import { serialize } from 'hono/utils/cookie'
+import { z } from 'zod'
+
+const LocalePayloadSchema = z.object({
+  locale: z.enum(['en', 'ja']),
+})
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = await this.validateBody(LocalePayloadSchema)
+    const referer = this.request.header('referer') || '/'
+
+    const response = this.redirect(referer)
+    const cookieHeader = serialize('locale', locale, {
+      maxAge: 60 * 60 * 24 * 365,
+      path: '/',
+    })
+    response.headers.append('Set-Cookie', cookieHeader)
+    return response
+  }
+}
