+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,12 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled for later as id, title and published_at, soonest first'
+
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled().orderBy('publishedAt', 'asc').orderBy('id', 'asc').get()
+    for (const post of posts) this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+  }
+}
