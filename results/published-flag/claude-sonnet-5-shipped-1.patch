diff --git a/tests/PostPublished.test.ts b/tests/PostPublished.test.ts
new file mode 100644
index 0000000..43ffdac
--- /dev/null
+++ b/tests/PostPublished.test.ts
@@ -0,0 +1,161 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('post drafts', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = await User.create({ name: 'Author', email: `author-${Date.now()}@example.com`, password: 'secret123' })
+    other = await User.create({ name: 'Other', email: `other-${Date.now()}@example.com`, password: 'secret123' })
+  })
+
+  it('creates a draft when published is omitted', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Draft post', excerpt: 'Excerpt', body: 'Body' }).assertRedirect()
+
+    const post = await Post.first({ title: 'Draft post' })
+    expect(post?.published).toBe(false)
+  })
+
+  it('creates a published post when published: true is sent', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Published post', excerpt: 'Excerpt', body: 'Body', published: true })
+      .assertRedirect()
+
+    const post = await Post.first({ title: 'Published post' })
+    expect(post?.published).toBe(true)
+  })
+
+  it('hides a draft from guests and other users on the index', async () => {
+    await Post.forceCreate({
+      title: 'Secret draft',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+    await Post.forceCreate({
+      title: 'Public post',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: true,
+    })
+
+    const guestResponse = await http.json().get('/posts')
+    guestResponse.assertOk()
+    const guestBody = await guestResponse.json<{ props: { data: Array<{ title: string }> } }>()
+    const guestTitles = guestBody.props.data.map((p) => p.title)
+    expect(guestTitles).toContain('Public post')
+    expect(guestTitles).not.toContain('Secret draft')
+
+    const otherResponse = await http.actingAs(other).json().get('/posts')
+    otherResponse.assertOk()
+    const otherBody = await otherResponse.json<{ props: { data: Array<{ title: string }> } }>()
+    const otherTitles = otherBody.props.data.map((p) => p.title)
+    expect(otherTitles).toContain('Public post')
+    expect(otherTitles).not.toContain('Secret draft')
+  })
+
+  it('excludes drafts from search results even on a keyword match', async () => {
+    await Post.forceCreate({
+      title: 'Unique Zephyr Draft',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+
+    const response = await http.query('/posts/search', { keywords: ['Zephyr'] })
+    response.assertOk()
+    const body = await response.json<{ data: Array<{ title: string }> }>()
+    expect(body.data.map((p) => p.title)).not.toContain('Unique Zephyr Draft')
+  })
+
+  it('404s a draft for a guest, exactly as if it did not exist', async () => {
+    const draft = await Post.forceCreate({
+      title: 'Hidden',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+
+    await http.get(`/posts/${draft!.id}`).assertNotFound()
+  })
+
+  it('404s a draft for a different signed-in user', async () => {
+    const draft = await Post.forceCreate({
+      title: 'Hidden',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+
+    await http.actingAs(other).get(`/posts/${draft!.id}`).assertNotFound()
+  })
+
+  it('lets the author open and edit their own draft', async () => {
+    const draft = await Post.forceCreate({
+      title: 'Hidden',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+
+    const showResponse = await http.actingAs(author).json().get(`/posts/${draft!.id}`)
+    showResponse.assertOk()
+    const showBody = await showResponse.json<{ props: { post: { published: boolean } } }>()
+    expect(showBody.props.post.published).toBe(false)
+
+    await http.actingAs(author).get(`/posts/${draft!.id}/edit`).assertOk()
+  })
+
+  it('publishes a draft via the edit form', async () => {
+    const draft = await Post.forceCreate({
+      title: 'Hidden',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: false,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${draft!.id}`, { title: 'Hidden', excerpt: 'Excerpt', body: 'Body', published: true })
+      .assertRedirect()
+
+    const updated = await Post.find(draft!.id)
+    expect(updated?.published).toBe(true)
+  })
+
+  it('unpublishes a post back to draft via the edit form', async () => {
+    const published = await Post.forceCreate({
+      title: 'Visible',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author!.id,
+      published: true,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${published!.id}`, { title: 'Visible', excerpt: 'Excerpt', body: 'Body', published: false })
+      .assertRedirect()
+
+    const updated = await Post.find(published!.id)
+    expect(updated?.published).toBe(false)
+  })
+})
