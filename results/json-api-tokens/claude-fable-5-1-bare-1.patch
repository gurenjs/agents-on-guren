diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..1aaa164
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,153 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { API_RATE_LIMIT } from '../routes/api.js'
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+async function createUser(label: string): Promise<UserRecord> {
+  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+  return User.create({
+    name: `${label} ${suffix}`,
+    email: `${label}-${suffix}@example.com`,
+    password: 'secret-password',
+  })
+}
+
+describe('posts API', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let token: string
+
+  async function issueToken(user: UserRecord, name: string): Promise<string> {
+    const client = (await http.actingAs(user).withCsrf('/profile')).json()
+    const response = await client.post('/profile/tokens', { name })
+    response.assertCreated()
+    return (await response.json<{ token: string }>()).token
+  }
+
+  // A script's view of the API: JSON only, a bearer header and no cookies.
+  function api(authorization?: string): TestApp {
+    const client = http.json()
+    return authorization === undefined ? client : client.withHeader('Authorization', authorization)
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await createUser('api-owner')
+    token = await issueToken(owner, 'CI')
+  })
+
+  it('lists every post newest first for a valid bearer token', async () => {
+    const other = await createUser('api-other-author')
+    const older = await Post.forceCreate({ title: 'Older', excerpt: 'older', body: 'older body', authorId: other.id })
+    const newer = await Post.forceCreate({ title: 'Newer', excerpt: 'newer', body: 'newer body', authorId: owner.id })
+
+    const response = await api(`Bearer ${token}`).get('/api/posts')
+    response.assertOk()
+    const { data } = await response.json<{ data: ApiPost[] }>()
+
+    const ids = data.map((post) => post.id)
+    expect(ids).toContain(older.id)
+    expect(ids).toContain(newer.id)
+    expect(ids.indexOf(newer.id)).toBeLessThan(ids.indexOf(older.id))
+
+    const newest = data.find((post) => post.id === newer.id)
+    if (!newest) throw new Error('The newest post is missing from the listing.')
+    expect(newest).toMatchObject({ title: 'Newer', excerpt: 'newer', authorId: owner.id })
+    expect(new Date(newest.createdAt).toISOString()).toBe(newest.createdAt)
+  })
+
+  it('creates a post owned by the token owner whatever the body says', async () => {
+    const impostor = await createUser('api-impostor')
+    const response = await api(`Bearer ${token}`).post('/api/posts', {
+      title: 'From a script',
+      excerpt: 'Posted over the API',
+      body: 'Release notes.',
+      authorId: impostor.id,
+    })
+    response.assertCreated()
+
+    const { data } = await response.json<{ data: ApiPost }>()
+    expect(data).toMatchObject({ title: 'From a script', excerpt: 'Posted over the API', authorId: owner.id })
+    expect(typeof data.id).toBe('number')
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const stored = await Post.findOrFail(data.id)
+    expect(stored.authorId).toBe(owner.id)
+  })
+
+  it('answers 422 with JSON for input the web form would reject and creates nothing', async () => {
+    const before = (await Post.newQuery().get()).length
+
+    const emptyTitle = await api(`Bearer ${token}`).post('/api/posts', { title: '', excerpt: 'x', body: 'y' })
+    emptyTitle.assertStatus(422)
+    expect(await emptyTitle.json()).toHaveProperty('errors')
+
+    await api(`Bearer ${token}`).post('/api/posts', { title: 'No body', excerpt: 'x' }).assertStatus(422)
+
+    expect((await Post.newQuery().get()).length).toBe(before)
+  })
+
+  it('answers 401 with JSON for a missing, malformed, unknown, tampered or revoked token', async () => {
+    const before = (await Post.newQuery().get()).length
+    const [id, secret = ''] = token.split('|')
+    const tampered = `${id}|${secret.slice(0, -1)}${secret.endsWith('0') ? '1' : '0'}`
+
+    const revoker = await createUser('api-revoker')
+    const revoked = await issueToken(revoker, 'short-lived')
+    const revokerClient = (await http.actingAs(revoker).withCsrf('/profile')).json()
+    await revokerClient.delete(`/profile/tokens/${revoked.split('|')[0]}`).assertNoContent()
+
+    const bad: Array<string | undefined> = [
+      undefined,
+      'Bearer',
+      'Bearer not-a-token',
+      'Basic abc',
+      `Bearer ${id}|${'f'.repeat(64)}`,
+      `Bearer ${tampered}`,
+      `Bearer ${revoked}`,
+    ]
+
+    for (const authorization of bad) {
+      const listed = await api(authorization).get('/api/posts')
+      listed.assertStatus(401)
+      expect(listed.headers.get('content-type')).toContain('application/json')
+
+      const created = await api(authorization).post('/api/posts', { title: 'Nope', excerpt: 'nope', body: 'nope' })
+      // Without any bearer, CSRF may stop the write first.
+      expect([401, 403]).toContain(created.status)
+      expect(created.headers.get('content-type')).toContain('application/json')
+    }
+
+    expect((await Post.newQuery().get()).length).toBe(before)
+  })
+
+  it('limits each token to 60 requests per minute and tells the script when to retry', async () => {
+    const limited = await createUser('api-limited')
+    const first = await issueToken(limited, 'first')
+    const second = await issueToken(limited, 'second')
+
+    for (let i = 0; i < API_RATE_LIMIT; i += 1) {
+      await api(`Bearer ${first}`).get('/api/posts').assertOk()
+    }
+
+    const over = await api(`Bearer ${first}`).get('/api/posts')
+    over.assertStatus(429)
+    const retryAfter = Number(over.headers.get('Retry-After'))
+    expect(Number.isInteger(retryAfter)).toBe(true)
+    expect(retryAfter).toBeGreaterThanOrEqual(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    // Per token, not per account: the same user's other token is unaffected.
+    await api(`Bearer ${second}`).get('/api/posts').assertOk()
+  })
+})
