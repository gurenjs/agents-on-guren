diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..0096213
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,190 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Post } from '../app/Models/Post.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The test database persists between runs, so names carry a stamp: a tag row
+// this run creates is one no earlier run could have left behind.
+const stamp = `${Date.now().toString(36)}${Math.floor(Math.random() * 1e6).toString(36)}`
+const tagged = (name: string) => `${name}-${stamp}`
+
+const POST = { title: 'Tagged post', excerpt: 'Carries tags.', body: 'Body of a tagged post.' }
+
+async function inertiaProps<TProps>(http: TestApp, path: string): Promise<TProps> {
+  const response = await http.get(path).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as TProps
+}
+
+function idFromLocation(location: string | null): number {
+  const match = /\/posts\/(\d+)$/.exec(location ?? '')
+  if (!match) {
+    throw new Error(`Expected a redirect to the post, got ${String(location)}`)
+  }
+  return Number(match[1])
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+  let asAuthor: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Tag Author', email: `tag-author-${stamp}@example.com`, password: 'secret' })
+    // Primed with the CSRF cookie a browser would carry, or every write is a 403.
+    asAuthor = (await http.withCsrf('/posts')).actingAs(author).json()
+  })
+
+  async function createPost(tags: string | string[] | undefined, overrides: Partial<typeof POST> = {}): Promise<number> {
+    const response = await asAuthor.post('/posts', { ...POST, ...overrides, ...(tags === undefined ? {} : { tags }) })
+    expect([302, 303]).toContain(response.status)
+    return idFromLocation(response.headers.get('location'))
+  }
+
+  it('parses the tags field into trimmed, distinct names', () => {
+    expect(parseTagNames(undefined)).toEqual([])
+    expect(parseTagNames('')).toEqual([])
+    expect(parseTagNames('bun, webdev')).toEqual(['bun', 'webdev'])
+    expect(parseTagNames(' bun ,bun')).toEqual(['bun'])
+    expect(parseTagNames('a,,b,')).toEqual(['a', 'b'])
+    expect(parseTagNames('Bun,bun')).toEqual(['Bun', 'bun'])
+    expect(parseTagNames(['bun', ' bun ', 'webdev'])).toEqual(['bun', 'webdev'])
+  })
+
+  it('creates tags, attaches them, and shows them sorted on the post page', async () => {
+    const webdev = tagged('webdev')
+    const bun = tagged('bun')
+    const id = await createPost(`${webdev}, ${bun}`)
+
+    const rows = await Tag.whereIn('name', [bun, webdev]).get()
+    expect(rows.map((row) => row.name).sort()).toEqual([bun, webdev])
+    const attached = await PostTag.where('postId', id).get()
+    expect(attached.map((row) => row.tagId).sort()).toEqual(rows.map((row) => row.id).sort())
+
+    const { post } = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual([bun, webdev])
+  })
+
+  it('detaches the names removed on edit and keeps the tag row', async () => {
+    const keep = tagged('keep')
+    const drop = tagged('drop')
+    const id = await createPost(`${keep}, ${drop}`)
+
+    await asAuthor.put(`/posts/${id}`, { ...POST, tags: keep }).assertRedirect(`/posts/${id}`)
+
+    const kept = await Tag.where('name', keep).firstOrFail()
+    const attached = await PostTag.where('postId', id).get()
+    expect(attached.map((row) => row.tagId)).toEqual([kept.id])
+    expect(await Tag.where('name', drop).first()).not.toBeNull()
+
+    const { post } = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual([keep])
+
+    const edit = await inertiaProps<{ post: PostResourceData }>(asAuthor, `/posts/${id}/edit`)
+    expect(edit.post.tags).toEqual([keep])
+  })
+
+  it('leaving the field out or empty clears the tags', async () => {
+    const id = await createPost(tagged('gone'))
+    await asAuthor.put(`/posts/${id}`, POST).assertRedirect(`/posts/${id}`)
+    expect(await PostTag.where('postId', id).get()).toEqual([])
+
+    await asAuthor.put(`/posts/${id}`, { ...POST, tags: tagged('back') }).assertRedirect(`/posts/${id}`)
+    await asAuthor.put(`/posts/${id}`, { ...POST, tags: '' }).assertRedirect(`/posts/${id}`)
+    expect(await PostTag.where('postId', id).get()).toEqual([])
+  })
+
+  it('counts a name listed twice once', async () => {
+    const bun = tagged('twice')
+    const id = await createPost(` ${bun} ,${bun}`)
+
+    const rows = await Tag.where('name', bun).get()
+    expect(rows).toHaveLength(1)
+    expect(await PostTag.where('postId', id).get()).toHaveLength(1)
+    const { post } = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual([bun])
+  })
+
+  it('refuses more than five tags and writes nothing', async () => {
+    const names = [1, 2, 3, 4, 5, 6].map((n) => tagged(`six${n}`))
+    const postsBefore = await Post.newQuery().count()
+
+    const emptyTitle = await asAuthor.post('/posts', { ...POST, title: '' })
+    const response = await asAuthor.post('/posts', { ...POST, title: `Six ${stamp}`, tags: names.join(', ') })
+    expect(response.status).toBe(emptyTitle.status)
+    expect(response.status).toBe(422)
+    const { errors } = await response.json<{ errors: Record<string, string> }>()
+    expect(errors.tags).toBeDefined()
+
+    expect(await Post.newQuery().count()).toBe(postsBefore)
+    expect(await Tag.whereIn('name', names).get()).toEqual([])
+  })
+
+  it('refuses a 31-character name and accepts a 30-character one', async () => {
+    const suffix = `-${stamp}`
+    const thirty = `${'x'.repeat(30 - suffix.length)}${suffix}`
+    const thirtyOne = `${'y'.repeat(31 - suffix.length)}${suffix}`
+    expect(thirty).toHaveLength(30)
+    expect(thirtyOne).toHaveLength(31)
+
+    const refused = await asAuthor.post('/posts', { ...POST, tags: thirtyOne })
+    expect(refused.status).toBe(422)
+    expect(await Tag.where('name', thirtyOne).first()).toBeNull()
+
+    const id = await createPost(thirty)
+    const { post } = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual([thirty])
+  })
+
+  it('also refuses six tags on edit, leaving the post untouched', async () => {
+    const before = tagged('before')
+    const id = await createPost(before)
+    const names = [1, 2, 3, 4, 5, 6].map((n) => tagged(`edit${n}`))
+
+    await asAuthor.put(`/posts/${id}`, { ...POST, title: 'Changed', tags: names.join(',') }).assertStatus(422)
+
+    const post = await Post.findOrFail(id)
+    expect(post.title).toBe(POST.title)
+    const kept = await Tag.where('name', before).firstOrFail()
+    expect((await PostTag.where('postId', id).get()).map((row) => row.tagId)).toEqual([kept.id])
+  })
+
+  it('filters the list by tag, newest first, with the filter kept on page links', async () => {
+    const topic = tagged('topic')
+    const other = tagged('other')
+    const first = await createPost(topic)
+    const untagged = await createPost(undefined)
+    const second = await createPost(`${topic}, ${other}`)
+
+    type IndexProps = { data: PostResourceData[]; pagination: { links: { pages: { url: string | null }[] } }; tag?: string }
+    const filtered = await inertiaProps<IndexProps>(http, `/posts?tag=${encodeURIComponent(topic)}`)
+    expect(filtered.tag).toBe(topic)
+    expect(filtered.data.map((post) => post.id)).toEqual([second, first])
+    expect(filtered.data.every((post) => post.tags.includes(topic))).toBe(true)
+    expect(filtered.pagination.links.pages[0]?.url).toContain(`tag=${encodeURIComponent(topic)}`)
+
+    const none = await inertiaProps<IndexProps>(http, `/posts?tag=${encodeURIComponent(tagged('unused'))}`)
+    expect(none.data).toEqual([])
+
+    const all = await inertiaProps<IndexProps>(http, '/posts')
+    expect(all.tag).toBeUndefined()
+    const byId = new Map(all.data.map((post) => [post.id, post]))
+    expect(byId.get(untagged)?.tags).toEqual([])
+    expect(byId.get(second)?.tags).toEqual([other, topic].sort())
+    expect(all.data.every((post) => Array.isArray(post.tags))).toBe(true)
+  })
+
+  it('deletes a tagged post together with its attachments', async () => {
+    const id = await createPost(tagged('deleted'))
+    await asAuthor.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.where('postId', id).get()).toEqual([])
+  })
+})
