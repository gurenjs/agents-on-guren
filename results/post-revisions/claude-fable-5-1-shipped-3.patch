diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..f5688e3
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,23 @@
+import { defineModel, type BelongsToRequiredRecord, type TransactionHandle } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+export class PostRevision extends defineModel(postRevisions, {
+  // `postId` is set from the post being edited, never from request input.
+  fillable: ['title', 'excerpt', 'body'],
+}) {
+  declare static relationTypes: { post: BelongsToRequiredRecord<PostRecord> }
+
+  // Call it inside the same transaction as the write that replaces `post`, so
+  // a refused edit keeps nothing and a kept version always has a successor.
+  static keep(post: PostRecord, options: { trx?: TransactionHandle } = {}): Promise<PostRevisionRecord | null> {
+    return PostRevision.forceCreate(
+      { postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body },
+      options,
+    )
+  }
+}
+
+PostRevision.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
