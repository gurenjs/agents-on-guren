diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..935ae9e
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,30 @@
+import { Resource } from '@guren/core'
+import type { CommentAuthorSummary, CommentRecord } from '../../Models/Comment.js'
+
+// The relation is optional because `newQuery().with('author')` returns plain
+// records; the controller always loads it, and the fallback covers a miss.
+type CommentWithAuthor = CommentRecord & { author?: CommentAuthorSummary | null }
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author: CommentAuthorSummary
+  // ISO 8601 regardless of how the dialect stores `created_at`.
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      author: {
+        id: comment.author?.id ?? comment.userId,
+        name: comment.author?.name ?? '',
+      },
+      createdAt: new Date(comment.createdAt).toISOString(),
+    }
+  }
+}
