diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..e82f658
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,259 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { readdir, readFile, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { TestApp } from '@guren/testing'
+import { Attachment } from '../config/attachments.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { COVER_MAX_BYTES } from '../app/Http/Validators/PostValidator.js'
+import app from '../src/app.js'
+
+// Must match the `local` disk root config/storage.ts uses under NODE_ENV=test.
+const STORAGE_ROOT = './storage/app/testing'
+
+const PNG = Uint8Array.from(
+  atob('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=='),
+  (char) => char.charCodeAt(0),
+)
+const GIF = Uint8Array.from(atob('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'), (char) =>
+  char.charCodeAt(0),
+)
+// A JPEG signature over filler: enough for the format check, not decodable.
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, ...Array.from({ length: 32 }, () => 7), 0xff, 0xd9])
+
+interface PostPayload {
+  id: number
+  title: string
+  coverUrl: string | null
+}
+
+function form(
+  fields: Record<string, string>,
+  cover?: { bytes: Uint8Array<ArrayBuffer>; name: string; type: string },
+): FormData {
+  const data = new FormData()
+  for (const [name, value] of Object.entries(fields)) {
+    data.set(name, value)
+  }
+  if (cover) {
+    data.set('cover', new File([cover.bytes], cover.name, { type: cover.type }))
+  }
+  return data
+}
+
+const fields = { title: 'Covered', excerpt: 'With a cover', body: 'Body text' }
+const png = { bytes: PNG, name: 'cover.png', type: 'image/png' }
+const jpeg = { bytes: JPEG, name: 'cover.jpg', type: 'image/jpeg' }
+const gif = { bytes: GIF, name: 'cover.gif', type: 'image/gif' }
+
+async function storedFiles(root: string): Promise<string[]> {
+  if (!existsSync(root)) {
+    return []
+  }
+  const entries = await readdir(root, { recursive: true, withFileTypes: true })
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+  })
+
+  afterAll(async () => {
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+  })
+
+  async function authed(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function createPost(cover?: typeof png): Promise<number> {
+    const client = await authed()
+    const response = await client.post('/posts', form(fields, cover))
+    expect(response.status).toBe(303)
+    const [post] = await Post.where({ title: fields.title }).orderBy('id', 'desc').limit(1).get()
+    return post.id
+  }
+
+  async function showPost(id: number): Promise<PostPayload> {
+    const response = await http.withHeader('X-Inertia', 'true').get(`/posts/${id}`)
+    const page = await response.json<{ component: string; props: { post: PostPayload } }>()
+    expect(page.component).toBe('posts/Show')
+    return page.props.post
+  }
+
+  it('stores a PNG cover under storage/ and serves it back unchanged', async () => {
+    const id = await createPost(png)
+
+    const { coverUrl } = await showPost(id)
+    expect(coverUrl).toBeString()
+
+    const served = await http.get(coverUrl as string)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    const files = await storedFiles(STORAGE_ROOT)
+    expect(files).toHaveLength(1)
+    expect(new Uint8Array(await readFile(files[0]))).toEqual(PNG)
+    expect(await storedFiles('./public/storage')).toHaveLength(0)
+    expect(await Attachment.newQuery().count()).toBe(1)
+  })
+
+  it('serves a JPEG cover as image/jpeg whatever type the client declared', async () => {
+    const id = await createPost({ ...jpeg, type: 'text/html' })
+
+    const { coverUrl } = await showPost(id)
+    const served = await http.get(coverUrl as string)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/jpeg')
+  })
+
+  it('lists posts with their coverUrl, null without a cover', async () => {
+    const covered = await createPost(png)
+    const plain = await createPost()
+
+    const response = await http.withHeader('X-Inertia', 'true').get('/posts')
+    const page = await response.json<{ props: { data: PostPayload[] } }>()
+    const byId = new Map(page.props.data.map((post) => [post.id, post]))
+
+    expect(byId.get(covered)?.coverUrl).toBeString()
+    expect(byId.get(plain)?.coverUrl).toBeNull()
+  })
+
+  it('still creates a post from a JSON body without a cover', async () => {
+    const client = await authed()
+    await client.json().post('/posts', fields).assertStatus(303)
+
+    expect(await Post.newQuery().count()).toBe(1)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+
+  it('refuses a GIF on create and saves nothing', async () => {
+    const client = await authed()
+    const response = await client.json().post('/posts', form(fields, gif))
+
+    expect(response.status).toBe(422)
+    const body = await response.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.cover).toBeDefined()
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Attachment.newQuery().count()).toBe(0)
+    expect(await storedFiles(STORAGE_ROOT)).toHaveLength(0)
+  })
+
+  it('refuses a GIF that claims to be a PNG', async () => {
+    const client = await authed()
+    await client.json().post('/posts', form(fields, { ...gif, name: 'cover.png', type: 'image/png' })).assertUnprocessable()
+
+    expect(await Post.newQuery().count()).toBe(0)
+  })
+
+  it('refuses a cover over 2 MB and saves nothing', async () => {
+    const oversized = new Uint8Array(COVER_MAX_BYTES + 1)
+    oversized.set(PNG)
+    const client = await authed()
+    const response = await client.json().post('/posts', form(fields, { ...png, bytes: oversized }))
+
+    expect(response.status).toBe(422)
+    const body = await response.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.cover).toBeDefined()
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await storedFiles(STORAGE_ROOT)).toHaveLength(0)
+  })
+
+  it('replaces the cover on edit and deletes the old file', async () => {
+    const id = await createPost(png)
+    const { coverUrl: oldUrl } = await showPost(id)
+
+    const client = await authed()
+    await client.put(`/posts/${id}`, form({ ...fields, title: 'Retitled' }, jpeg)).assertStatus(303)
+
+    const post = await showPost(id)
+    expect(post.title).toBe('Retitled')
+    expect(post.coverUrl).not.toBe(oldUrl)
+    const served = await http.get(post.coverUrl as string)
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(JPEG)
+
+    await http.get(oldUrl as string).assertNotFound()
+    expect(await Attachment.newQuery().count()).toBe(1)
+    const files = await storedFiles(STORAGE_ROOT)
+    expect(files).toHaveLength(1)
+    expect(new Uint8Array(await readFile(files[0]))).toEqual(JPEG)
+  })
+
+  it('keeps the cover and the text when the new cover is refused', async () => {
+    const id = await createPost(png)
+    const { coverUrl } = await showPost(id)
+
+    const client = await authed()
+    await client.json().put(`/posts/${id}`, form({ ...fields, title: 'Retitled' }, gif)).assertUnprocessable()
+
+    const post = await showPost(id)
+    expect(post.title).toBe(fields.title)
+    await http.get(post.coverUrl as string).assertOk()
+    await http.get(coverUrl as string).assertOk()
+    expect(await Attachment.newQuery().count()).toBe(1)
+    expect(await storedFiles(STORAGE_ROOT)).toHaveLength(1)
+  })
+
+  it('leaves the cover alone when editing without a file or the checkbox', async () => {
+    const id = await createPost(png)
+
+    const client = await authed()
+    await client.put(`/posts/${id}`, form({ ...fields, title: 'Retitled', removeCover: '0' })).assertStatus(303)
+
+    const post = await showPost(id)
+    expect(post.title).toBe('Retitled')
+    await http.get(post.coverUrl as string).assertOk()
+    expect(await Attachment.newQuery().count()).toBe(1)
+  })
+
+  it('removes the cover when removeCover is ticked', async () => {
+    const id = await createPost(png)
+    const { coverUrl } = await showPost(id)
+
+    const client = await authed()
+    await client.put(`/posts/${id}`, form({ ...fields, removeCover: '1' })).assertStatus(303)
+
+    expect((await showPost(id)).coverUrl).toBeNull()
+    await http.get(coverUrl as string).assertNotFound()
+    expect(await Attachment.newQuery().count()).toBe(0)
+    expect(await storedFiles(STORAGE_ROOT)).toHaveLength(0)
+  })
+
+  it('deletes the cover with its post', async () => {
+    const id = await createPost(png)
+    const { coverUrl } = await showPost(id)
+
+    const client = await authed()
+    await client.delete(`/posts/${id}`).assertStatus(303)
+
+    await http.get(coverUrl as string).assertNotFound()
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Attachment.newQuery().count()).toBe(0)
+    expect(await storedFiles(STORAGE_ROOT)).toHaveLength(0)
+  })
+
+  it("does not let another user replace a post's cover", async () => {
+    const id = await createPost(png)
+    const stranger = await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret-password' })
+
+    const client = await http.actingAs(stranger).withCsrf()
+    await client.put(`/posts/${id}`, form(fields, jpeg)).assertForbidden()
+
+    const files = await storedFiles(STORAGE_ROOT)
+    expect(files).toHaveLength(1)
+    expect(new Uint8Array(await readFile(files[0]))).toEqual(PNG)
+  })
+})
