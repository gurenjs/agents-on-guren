+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { createApiToken, type AuthManager } from '@guren/core'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The /mcp endpoint served by @guren/plugin-mcp: tools derived from the
+// posts.search and posts.store routes, called with a bearer token issued
+// through the token store AuthProvider configures.
+
+interface JsonRpcResult {
+  result?: {
+    tools?: { name: string, annotations?: { readOnlyHint?: boolean } }[]
+    isError?: boolean
+    content?: { type: string, text: string }[]
+    structuredContent?: unknown
+  }
+  error?: { message: string }
+}
+
+let requestId = 0
+
+async function mcp(method: string, params: Record<string, unknown>, bearer?: string): Promise<Response> {
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      Accept: 'application/json, text/event-stream',
+      'MCP-Protocol-Version': '2025-06-18',
+      ...(bearer ? { Authorization: `Bearer ${bearer}` } : {}),
+    },
+    body: JSON.stringify({ jsonrpc: '2.0', id: ++requestId, method, params }),
+  }))
+}
+
+// Stateless streamable HTTP may answer with plain JSON or a one-event SSE stream.
+async function rpc(method: string, params: Record<string, unknown>, bearer: string): Promise<JsonRpcResult> {
+  const response = await mcp(method, params, bearer)
+  expect(response.status).toBe(200)
+  const text = await response.text()
+  if (!(response.headers.get('Content-Type') ?? '').includes('text/event-stream')) return JSON.parse(text)
+  const data = text.split('\n').find((line) => line.startsWith('data:'))
+  return JSON.parse(data!.slice('data:'.length))
+}
+
+async function createUser(name: string): Promise<{ id: number, name: string, email: string }> {
+  const email = `${crypto.randomUUID()}@example.com`
+  await User.create({ name, email, password: 'secret-password' })
+  const record = await User.where({ email }).first()
+  return { id: Number(record!.id), name, email }
+}
+
+describe('/mcp', () => {
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    userId = (await createUser('MCP Author')).id
+
+    const auth = app.container.make<AuthManager>('auth')
+    const { plainTextToken } = await createApiToken(auth.getApiTokenStore()!, {
+      name: 'mcp test',
+      userId,
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  it('refuses a call without a bearer token', async () => {
+    const response = await mcp('tools/list', {})
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two post tools with their read-only flags', async () => {
+    const { result } = await rpc('tools/list', {}, bearer)
+    const tools = (result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(tools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('stores a post as the token user, ignoring an authorId in the input', async () => {
+    const title = `MCP ${crypto.randomUUID()}`
+    const { result } = await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title, excerpt: 'From an assistant.', body: 'Drafted over MCP.', authorId: 999_999 },
+    }, bearer)
+
+    expect(result?.isError).not.toBe(true)
+    const post = await Post.where({ title }).first()
+    expect(post?.authorId).toBe(userId)
+
+    const search = await rpc('tools/call', { name: 'posts_search', arguments: { keywords: [title] } }, bearer)
+    expect(search.result?.isError).not.toBe(true)
+    expect(JSON.stringify(search.result)).toContain(title)
+  })
+
+  it('rejects input the form would reject with 422 and creates nothing', async () => {
+    const before = await Post.where({ excerpt: 'Rejected over MCP.' }).get()
+    const { result } = await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'Rejected over MCP.', body: 'No title.' },
+    }, bearer)
+
+    expect(result?.isError).toBe(true)
+    expect(JSON.stringify(result)).toContain('Title is required.')
+    expect(await Post.where({ excerpt: 'Rejected over MCP.' }).get()).toHaveLength(before.length)
+  })
+})
+
+// The same tools through the framework's in-process dispatch, which exposes
+// the HTTP status of the request each call synthesizes.
+describe('post agent tools', () => {
+  let http: TestApp
+  let user: { id: number, name: string, email: string }
+
+  beforeAll(async () => {
+    // Session-style calls, so they need the CSRF token a browser would carry.
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    await migrateDatabase()
+    user = await createUser('Agent Author')
+  })
+
+  it('answers posts_search like QUERY /posts/search, without a user', async () => {
+    const result = await http.agent().call('posts_search', { keywords: ['zzz-no-such-post'] })
+    expect(result.status).toBe(200)
+    expect(JSON.parse(result.text)).toEqual({ data: [] })
+  })
+
+  it('answers invalid posts_store input with 422', async () => {
+    const result = await http.agent().call('posts_store', { title: '', excerpt: 'x', body: 'y' }, { as: user })
+    expect(result.status).toBe(422)
+    expect(result.isError).toBe(true)
+  })
+
+  it('refuses posts_store for a guest and creates nothing', async () => {
+    const title = `Guest ${crypto.randomUUID()}`
+    const result = await http.agent().call('posts_store', { title, excerpt: 'x', body: 'y' })
+    expect([302, 401, 403]).toContain(result.status)
+    expect(await Post.where({ title }).first()).toBeFalsy()
+  })
+})
