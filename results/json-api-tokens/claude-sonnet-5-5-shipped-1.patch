diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..f28254d
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,80 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createToken(userId: number, name = 'CI') {
+    const user = await User.find(userId)
+    const session = await http.actingAs(user as never).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json<{ id: number; name: string; token: string }>()
+  }
+
+  async function makeUser(email: string) {
+    return User.create({ name: 'A', email, password: 'secret-password' })
+  }
+
+  it('stores only a hash and authenticates the owner', async () => {
+    const user = await makeUser('a@example.com')
+    const created = await createToken(user.id)
+    const rows = await ApiToken.all()
+    expect(JSON.stringify(rows)).not.toContain(created.token)
+
+    const bearer = http.json().withHeader('Authorization', `Bearer ${created.token}`)
+    const res = await bearer.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(res.status).toBe(201)
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(user.id)
+    await bearer.get('/api/posts').assertOk().assertJsonCount(1, 'data')
+    await bearer.post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+    expect((await Post.all()).length).toBe(1)
+  })
+
+  it('rejects bad tokens and revoked tokens', async () => {
+    const user = await makeUser('b@example.com')
+    const other = await makeUser('c@example.com')
+    const created = await createToken(user.id)
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', 'Bearer nope').get('/api/posts').assertUnauthorized()
+
+    const otherSession = await http.actingAs((await User.find(other.id)) as never).withCsrf()
+    await otherSession.json().delete(`/profile/tokens/${created.id}`).assertNotFound()
+
+    const session = await http.actingAs((await User.find(user.id)) as never).withCsrf()
+    await session.json().delete(`/profile/tokens/${created.id}`).assertNoContent()
+    await http.json().withHeader('Authorization', `Bearer ${created.token}`).get('/api/posts').assertUnauthorized()
+  })
+
+  it('rate limits per token', async () => {
+    const user = await makeUser('d@example.com')
+    const first = await createToken(user.id, 'one')
+    const second = await createToken(user.id, 'two')
+    const client = http.json().withHeader('Authorization', `Bearer ${first.token}`)
+    for (let i = 0; i < 60; i++) await client.get('/api/posts').assertOk()
+    const limited = await client.get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.json().withHeader('Authorization', `Bearer ${second.token}`).get('/api/posts').assertOk()
+  })
+
+  it('validates the token name', async () => {
+    const user = await makeUser('e@example.com')
+    const session = await http.actingAs((await User.find(user.id)) as never).withCsrf()
+    await session.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+  })
+})
