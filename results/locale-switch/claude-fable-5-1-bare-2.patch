@@ -0,0 +1,8 @@
+import { z } from 'zod'
+import { SUPPORTED_LOCALES } from '../../../config/locales.js'
+
+export const LocalePayloadSchema = z.object({
+  locale: z.enum(SUPPORTED_LOCALES, { message: 'Choose one of the supported languages.' }),
+})
+
+export type LocalePayload = z.infer<typeof LocalePayloadSchema>
diff --git a/config/locales.ts b/config/locales.ts
new file mode 100644
index 0000000..b8b36c0
--- /dev/null
+++ b/config/locales.ts
@@ -0,0 +1,10 @@
+// The one list of languages the site speaks. src/app.ts hands it to i18n
+// detection, the locale validator accepts only these values, and the header's
+// language switcher renders one control per entry. The first entry is the
+// default: what a reader gets before any pick or browser preference matches.
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number]
+
+/** The cookie `POST /locale` writes and locale detection reads back. */
+export const LOCALE_COOKIE = 'locale'
