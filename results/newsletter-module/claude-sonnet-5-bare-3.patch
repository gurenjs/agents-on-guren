+import type { Router } from '@guren/core'
+import NewsletterController from './NewsletterController.js'
+import { EmailPayloadSchema } from './validators.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: EmailPayloadSchema }, [NewsletterController, 'subscribe'])
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: EmailPayloadSchema }, [NewsletterController, 'unsubscribe'])
+}
