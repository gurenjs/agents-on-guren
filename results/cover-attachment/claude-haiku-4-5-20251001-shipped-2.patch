diff --git a/app/Http/Validators/PostValidator.ts b/app/Http/Validators/PostValidator.ts
index 804642a..8b103f2 100644
--- a/app/Http/Validators/PostValidator.ts
+++ b/app/Http/Validators/PostValidator.ts
@@ -23,3 +23,22 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+const ALLOWED_COVER_TYPES = ['image/png', 'image/jpeg']
+const MAX_COVER_SIZE = 2 * 1024 * 1024 // 2 MB
+
+export function validateCoverFile(file: File | null | undefined): { valid: boolean; errors?: string[] } {
+  if (!file) return { valid: true }
+
+  const errors: string[] = []
+
+  if (!ALLOWED_COVER_TYPES.includes(file.type)) {
+    errors.push('Cover must be a PNG or JPEG image.')
+  }
+
+  if (file.size > MAX_COVER_SIZE) {
+    errors.push('Cover must be 2 MB or less.')
+  }
+
+  return errors.length > 0 ? { valid: false, errors } : { valid: true }
+}
