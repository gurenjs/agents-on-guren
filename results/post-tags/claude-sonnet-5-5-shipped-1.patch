diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..5c2b19f
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,49 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  it('creates, edits, filters and dedupes tags', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.post('/posts', payload(' bun ,bun, webdev,')).assertRedirect()
+    const post = (await Post.all())[0]!
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(2)
+
+    await authed.put(`/posts/${post.id}`, payload('bun')).assertRedirect()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+
+    const hit = await http.get('/posts?tag=bun')
+    expect(await hit.text()).toContain('"tags":["bun"]')
+    const miss = await http.get('/posts?tag=nope')
+    expect(await miss.text()).not.toContain('"title":"T"')
+
+    await authed.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+
+  it('refuses too many or too long tags', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.json().post('/posts', payload('a,b,c,d,e,f')).assertUnprocessable()
+    await authed.json().post('/posts', payload('x'.repeat(31))).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+    await authed.post('/posts', payload('x'.repeat(30))).assertRedirect()
+  })
+})
