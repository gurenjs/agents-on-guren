+++ b/tests/LoginRateLimit.test.ts
@@ -0,0 +1,103 @@
+import { beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { resetLoginRateLimiter } from '../app/Http/Middleware/LoginRateLimiter.js'
+import DatabaseProvider from '../app/Providers/DatabaseProvider.js'
+import { registerWebRoutes } from '../routes/web.js'
+
+const testEmail = 'test@example.com'
+const testPassword = 'wrongpassword123'
+
+describe('LoginController rate limiting', () => {
+  beforeEach(() => {
+    // Reset rate limiter before each test so they don't interfere
+    resetLoginRateLimiter()
+  })
+
+  it('allows up to 5 login attempts per minute', async () => {
+    const http = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await http.withCsrf()
+
+    for (let i = 1; i <= 5; i++) {
+      await csrf
+        .post('/login', { email: testEmail, password: testPassword })
+        .assertStatus(422) // Invalid credentials, but allowed
+    }
+  })
+
+  it('returns 429 on the 6th attempt within the same minute', async () => {
+    const http = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await http.withCsrf()
+
+    // Make 5 attempts
+    for (let i = 1; i <= 5; i++) {
+      await csrf
+        .post('/login', { email: testEmail, password: testPassword })
+        .assertStatus(422)
+    }
+
+    // 6th attempt should be throttled
+    await csrf
+      .post('/login', { email: testEmail, password: testPassword })
+      .assertStatus(429)
+  })
+
+  it('includes Retry-After header on 429 response', async () => {
+    const http = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await http.withCsrf()
+
+    // Make 5 attempts to hit the limit
+    for (let i = 1; i <= 5; i++) {
+      await csrf
+        .post('/login', { email: testEmail, password: testPassword })
+        .assertStatus(422)
+    }
+
+    // Check the 6th attempt includes Retry-After
+    const response = await csrf
+      .post('/login', { email: testEmail, password: testPassword })
+
+    response.assertStatus(429).assertHeader('Retry-After')
+  })
+
+  it('allows login attempts after rate limit window expires', async () => {
+    const http = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await http.withCsrf()
+
+    // Fill up the 5 allowed attempts
+    for (let i = 1; i <= 5; i++) {
+      await csrf
+        .post('/login', { email: testEmail, password: testPassword })
+        .assertStatus(422)
+    }
+
+    // 6th should fail
+    await csrf
+      .post('/login', { email: testEmail, password: testPassword })
+      .assertStatus(429)
+
+    // Simulate window expiration by resetting
+    resetLoginRateLimiter()
+
+    // Now we should be able to make attempts again
+    const csrf2 = await http.withCsrf()
+    await csrf2
+      .post('/login', { email: testEmail, password: testPassword })
+      .assertStatus(422) // Back to normal validation error, not rate limit
+  })
+})
