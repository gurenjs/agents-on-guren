+type: adr
+status: draft
+entities: [ApiToken, Post]
+related:
+  - app/Auth/apiTokens.ts
+  - app/Http/Controllers/ApiTokenController.ts
+  - app/Http/Controllers/Api/PostApiController.ts
+  - app/Http/Middleware/AuthenticateApiTokenMiddleware.ts
