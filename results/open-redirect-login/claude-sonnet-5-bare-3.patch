@@ -0,0 +1,59 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+
+const PASSWORD = 'correct horse battery staple'
+
+describe('login', () => {
+  let http: TestApp
+  let email: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    email = `login-test-${crypto.randomUUID()}@example.com`
+    await User.create({ name: 'Login Test User', email, password: PASSWORD })
+  })
+
+  it('redirects to the default destination when no redirect value is given', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: PASSWORD })
+      .assertRedirect('/dashboard')
+  })
+
+  it('redirects back to a same-app path passed via redirect', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: PASSWORD, redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('ignores an absolute URL and falls back to the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: PASSWORD, redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a protocol-relative redirect and falls back to the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: PASSWORD, redirect: '//evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a backslash redirect and falls back to the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: PASSWORD, redirect: '/\\evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('still rejects a wrong password without creating a session', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: 'not the password' })
+      .assertUnprocessable()
+  })
+})
