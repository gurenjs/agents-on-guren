diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..ac19d4c
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,118 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let counter = 0
+
+async function makeUser(): Promise<UserRecord> {
+  counter += 1
+  return User.create({ name: `User ${counter}`, email: `user${counter}@example.com`, password: 'password123' })
+}
+
+async function makePost(author: UserRecord, title = 'First') {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+}
+
+function revisionTitles(postId: number) {
+  return PostRevision.where({ postId })
+    .orderBy('id', 'desc')
+    .get()
+    .then((rows) => rows.map((row) => row.title))
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('keeps the previous version on each edit and restores one', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.actingAs(author).withCsrf()
+
+    for (const title of ['Second', 'Third']) {
+      await csrf.put(`/posts/${post.id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+        .assertRedirect(`/posts/${post.id}`)
+    }
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+
+    const res = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+    res.assertOk()
+    const page = await res.json<{ component: string; props: { revisions: { id: number; title: string; createdAt: string }[] } }>()
+    expect(page.props.revisions.map((r) => r.title)).toEqual(['Second', 'First'])
+    expect(typeof page.props.revisions[0]?.createdAt).toBe('string')
+
+    const first = page.props.revisions[1]!
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.json().put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('refuses other users and redirects guests', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+    await Post.update({ id: post.id }, { title: 'Second' })
+    const revision = await PostRevision.forceCreate({ postId: post.id, title: 'First', excerpt: 'e', body: 'b' })
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const guest = await http.withCsrf()
+    await guest.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionTitles(post.id)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'A')
+    const otherPost = await makePost(author, 'B')
+    const revision = await PostRevision.forceCreate({ postId: otherPost.id, title: 'Old B', excerpt: 'e', body: 'b' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('A')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post history with the post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'A')
+    const otherPost = await makePost(author, 'B')
+    await PostRevision.forceCreate({ postId: post.id, title: 'Old A', excerpt: 'e', body: 'b' })
+    await PostRevision.forceCreate({ postId: otherPost.id, title: 'Old B', excerpt: 'e', body: 'b' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(otherPost.id)).toEqual(['Old B'])
+  })
+})
