diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..538a63e
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,35 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The sign-up route binds RegisterSchema so codegen can type the page's form
+// (`ApiRoutes['register.store']['body']`); the controller still parses the body
+// itself with validateBody(), so an invalid payload is rejected before the
+// database is touched. That keeps this test green without migrations or
+// fixtures — the happy path needs a test database, so it stays with the
+// golden-path flow.
+describe('register.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('renders the sign-up page', async () => {
+    await http.get('/register').assertOk()
+  })
+
+  it('rejects a mismatched password confirmation, keyed by field', async () => {
+    const csrf = await http.withCsrf('/register')
+    const response = await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'correct-horse',
+        passwordConfirmation: 'battery-staple',
+      })
+      .assertStatus(422)
+
+    await response.assertJsonPath('errors.passwordConfirmation', ['Passwords do not match.'])
+  })
+})
