diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..3b8e1d1 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -1,6 +1,8 @@
 import { beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +22,64 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.destroy', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function createUser(email: string) {
+    return User.create({ name: 'Test User', email, password: 'password123' })
+  }
+
+  async function createPost(authorId: number) {
+    return Post.forceCreate({
+      title: 'A post',
+      excerpt: 'An excerpt',
+      body: 'Some body text',
+      authorId,
+    })
+  }
+
+  it('refuses a signed-in user who does not own the post, and keeps the post', async () => {
+    const author = await createUser(`author-${Date.now()}@example.com`)
+    const intruder = await createUser(`intruder-${Date.now()}@example.com`)
+    const post = await createPost(author.id)
+
+    const csrf = await http.actingAs(intruder).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertForbidden()
+
+    const stillThere = await Post.find(post.id)
+    if (!stillThere) {
+      throw new Error('expected post to still exist after a non-author delete attempt')
+    }
+  })
+
+  it('refuses a guest', async () => {
+    const author = await createUser(`author-guest-${Date.now()}@example.com`)
+    const post = await createPost(author.id)
+
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/login')
+
+    const stillThere = await Post.find(post.id)
+    if (!stillThere) {
+      throw new Error('expected post to still exist after a guest delete attempt')
+    }
+  })
+
+  it('allows the author to delete their own post', async () => {
+    const author = await createUser(`author-owner-${Date.now()}@example.com`)
+    const post = await createPost(author.id)
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    const stillThere = await Post.find(post.id)
+    if (stillThere) {
+      throw new Error('expected post to be deleted by its author')
+    }
+  })
+})
