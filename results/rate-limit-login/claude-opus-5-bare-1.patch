@@ -0,0 +1,45 @@
+import { createRateLimitMiddleware, MemoryRateLimitStore } from '@guren/core'
+
+/** Login submissions a single client may make per {@link LOGIN_WINDOW_MS}. */
+export const LOGIN_MAX_ATTEMPTS = 5
+
+/** Length of the window the attempts are counted in. */
+export const LOGIN_WINDOW_MS = 60_000
+
+export interface ThrottleLoginOptions {
+  /**
+   * Clock returning epoch milliseconds, injectable so tests can step past the
+   * window instead of sleeping through it. Drives both the counters and the
+   * `Retry-After` the middleware reports.
+   */
+  now?: () => number
+}
+
+/**
+ * Rate limits login submissions to {@link LOGIN_MAX_ATTEMPTS} per client per
+ * minute — credential stuffing otherwise gets as many guesses per account as
+ * it cares to make. Every submission counts, right password included, so a
+ * successful sign-in does not hand an attacker a fresh budget.
+ *
+ * The client is the connection's own IP (`server.requestIP()`), never a
+ * forwarded-for header: nothing proxies this app, so those headers are pure
+ * client input and trusting them would let one attacker spread its guesses
+ * over as many fake identities as it likes. When the address cannot be read at
+ * all the limiter falls back to a single shared bucket for the route, which
+ * throttles unidentified clients together rather than exempting them.
+ *
+ * Counters live in this process's memory: one process, and nothing here is
+ * worth surviving a restart.
+ */
+export function throttleLogin({ now }: ThrottleLoginOptions = {}) {
+  return createRateLimitMiddleware({
+    limit: LOGIN_MAX_ATTEMPTS,
+    windowMs: LOGIN_WINDOW_MS,
+    // A bucket of its own, so the login budget is never spent by — or spent
+    // on — any other limiter that later shares the framework default store.
+    store: new MemoryRateLimitStore(LOGIN_WINDOW_MS, now),
+    trustProxy: false,
+    message: 'Too many login attempts. Please try again later.',
+    now,
+  })
+}
