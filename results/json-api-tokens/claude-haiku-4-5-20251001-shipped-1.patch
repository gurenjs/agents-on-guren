@@ -0,0 +1,36 @@
+import { z } from 'zod'
+import { Controller, HttpException } from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+import { CreateTokenSchema } from '../Validators/TokenValidator.js'
+
+export default class ProfileTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateTokenSchema)
+
+    const { token, hash } = TokenService.generateToken()
+    const apiToken = await ApiToken.create({
+      userId: user.id,
+      name,
+      hashedToken: hash,
+    })
+
+    return this.json({ id: apiToken.id, name, token }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(z.object({ id: z.coerce.number().int().positive() }))
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      throw HttpException.notFound()
+    }
+
+    await ApiToken.delete({ id })
+
+    return this.text('', { status: 204 })
+  }
+}
diff --git a/app/Http/Middleware/ApiAuthMiddleware.ts b/app/Http/Middleware/ApiAuthMiddleware.ts
new file mode 100644
index 0000000..c168536
--- /dev/null
+++ b/app/Http/Middleware/ApiAuthMiddleware.ts
@@ -0,0 +1,31 @@
+import { defineMiddleware } from '@guren/core'
+import type { Context } from 'hono'
+import { ApiAuthService } from '../../Services/ApiAuthService.js'
+import { RateLimitService } from '../../Services/RateLimitService.js'
+
+export const apiAuthMiddleware = defineMiddleware(async (c: Context, next) => {
+  const authHeader = c.req.header('Authorization')
+  const token = ApiAuthService.extractBearerToken(authHeader)
+
+  if (!token) {
+    return c.json({ message: 'Unauthorized' }, 401)
+  }
+
+  const apiToken = await ApiAuthService.authenticateToken(token)
+  if (!apiToken) {
+    return c.json({ message: 'Unauthorized' }, 401)
+  }
+
+  const rateLimitCheck = RateLimitService.checkAndIncrement(apiToken.id)
+  if (!rateLimitCheck.allowed) {
+    const retryAfter = rateLimitCheck.retryAfter || 60
+    return c.json({ message: 'Too Many Requests' }, { status: 429, headers: { 'Retry-After': String(retryAfter) } })
+  }
+
+  c.set('apiAuth', {
+    tokenId: apiToken.id,
+    userId: apiToken.userId,
+  })
+
+  return next()
+})
