+        excerpt: 'an unpublished post',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+      await Post.forceCreate({
+        title: 'Unrelated published post',
+        excerpt: 'no match here',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill'] })
+      res.assertOk()
+      const body = await res.json<{ data: Array<{ title: string }> }>()
+      expect(body.data).toHaveLength(1)
+      expect(body.data[0]?.title).toBe('Zephyrquill lands in the garden')
+    })
+
+    it('returns nothing when a keyword only matches unpublished posts', async () => {
+      const author = await User.create({ name: 'Author', email: 'author2@example.com', password: 'password123' })
+      await Post.forceCreate({
+        title: 'Marmalade only here',
+        excerpt: 'unpublished',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['marmalade'] })
+      res.assertOk()
+      const body = await res.json<{ data: unknown[] }>()
+      expect(body.data).toHaveLength(0)
+    })
+
+    it('excludes unpublished posts across multiple search words', async () => {
+      const author = await User.create({ name: 'Author', email: 'author3@example.com', password: 'password123' })
+      await Post.forceCreate({
+        title: 'Zephyrquill tale',
+        excerpt: 'published',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'Marmalade dreams',
+        excerpt: 'unpublished',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill', 'marmalade'] })
+      res.assertOk()
+      const body = await res.json<{ data: Array<{ title: string }> }>()
