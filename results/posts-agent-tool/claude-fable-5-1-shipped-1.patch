diff --git a/tests/McpEndpoint.test.ts b/tests/McpEndpoint.test.ts
new file mode 100644
index 0000000..8dc26f0
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,178 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ToolDescription {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolCallResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+interface RpcResponse<T> {
+  result?: T
+  error?: { code: number; message: string }
+}
+
+// The endpoint is stateless streamable HTTP: it may answer a POST with plain
+// JSON or with a one-message SSE stream, depending on the transport's choice.
+async function readRpc<T>(response: Pick<Response, 'headers' | 'text'>): Promise<RpcResponse<T>> {
+  const text = await response.text()
+  if (!(response.headers.get('content-type') ?? '').includes('text/event-stream')) {
+    return JSON.parse(text) as RpcResponse<T>
+  }
+  const data = text.split('\n').filter((line) => line.startsWith('data:')).at(-1)
+  return JSON.parse((data ?? 'data:{}').slice('data:'.length)) as RpcResponse<T>
+}
+
+describe('POST /mcp', () => {
+  let http: TestApp
+  let author: UserRecord
+  let bearer: string
+
+  async function rpc<T>(method: string, params: Record<string, unknown> = {}): Promise<T> {
+    const response = await http
+      .withHeaders({
+        Authorization: `Bearer ${bearer}`,
+        Accept: 'application/json, text/event-stream',
+      })
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method, params })
+    expect(response.status).toBe(200)
+
+    const message = await readRpc<T>(response)
+    expect(message.error).toBeUndefined()
+    return message.result as T
+  }
+
+  function callTool(name: string, args: Record<string, unknown>): Promise<ToolCallResult> {
+    return rpc<ToolCallResult>('tools/call', { name, arguments: args })
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-horse' }) as UserRecord
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('src/app.ts configures no API token store.')
+    const issued = await createApiToken(store, { name: 'test', userId: author.id, abilities: ['tools:*'] })
+    bearer = issued.plainTextToken
+  })
+
+  it('refuses a call without a credential', async () => {
+    await http
+      .withHeader('Accept', 'application/json, text/event-stream')
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+      .assertUnauthorized()
+  })
+
+  it('refuses a bearer no token matches', async () => {
+    bearer = 'unknown|credential'
+    const response = await http
+      .withHeaders({ Authorization: `Bearer ${bearer}`, Accept: 'application/json, text/event-stream' })
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
+    const { tools } = await rpc<{ tools: ToolDescription[] }>('tools/list')
+    const own = tools.filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(own.map((tool) => [tool.name, tool.annotations?.readOnlyHint === true]).sort()).toEqual([
+      ['posts_search', true],
+      ['posts_store', false],
+    ])
+  })
+
+  it('posts_search answers with what QUERY /posts/search answers with', async () => {
+    await Post.forceCreate({ title: 'Bun 2 released', excerpt: 'Faster', body: '...', authorId: author.id })
+    await Post.forceCreate({ title: 'Gardening', excerpt: 'Tomatoes', body: '...', authorId: author.id })
+    const input = { keywords: ['Bun'], limit: 5 }
+
+    const result = await callTool('posts_search', input)
+    const expected = await (await http.query('/posts/search', input)).json<{ data: Array<{ title: string }> }>()
+
+    expect(result.isError).not.toBe(true)
+    expect(expected.data.map((post) => post.title)).toEqual(['Bun 2 released'])
+    expect(result.structuredContent ?? JSON.parse(result.content[0]?.text ?? 'null')).toEqual(expected)
+  })
+
+  it('posts_store creates the post as the token\'s user, whatever authorId is sent', async () => {
+    const other = await User.create({ name: 'Eve', email: 'eve@example.com', password: 'correct-horse' }) as UserRecord
+
+    const result = await callTool('posts_store', {
+      title: 'Drafted by an assistant',
+      excerpt: 'Short',
+      body: 'Long',
+      authorId: other.id,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const posts = await Post.all()
+    expect(posts.map((post) => [post.title, post.authorId])).toEqual([['Drafted by an assistant', author.id]])
+    expect(JSON.parse(result.content[0]?.text ?? 'null')).toMatchObject({
+      data: { id: posts[0]?.id, title: 'Drafted by an assistant', authorId: author.id },
+    })
+  })
+
+  it('posts_store answers 422 for input the form rejects and creates nothing', async () => {
+    const result = await callTool('posts_store', { title: '', excerpt: 'Short', body: 'Long' })
+
+    expect(result.isError).toBe(true)
+    expect(result.content.map((part) => part.text).join('\n')).toContain('Title is required.')
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
+
+describe('agent tools', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('refuses posts_store for a caller who is not signed in', async () => {
+    const csrf = await http.withCsrf()
+    const result = await csrf.agent().call('posts_store', { title: 'Hi', excerpt: 'Short', body: 'Long' })
+
+    // The web form sends a guest to /login; an agent sees that same redirect.
+    expect(result.response.headers.get('location')).toBe('/login')
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('leaves the web form its redirect to the new post', async () => {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-horse' })
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const response = await csrf
+      .withHeaders({ 'X-Inertia': 'true', Accept: 'text/html, application/xhtml+xml' })
+      .post('/posts', { title: 'From the form', excerpt: 'Short', body: 'Long' })
+
+    const [post] = await Post.all()
+    expect(response.status).toBe(303)
+    expect(response.headers.get('location')).toBe(`/posts/${post?.id}`)
+  })
+
+  it('answers 422 for an empty title from a signed-in caller', async () => {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-horse' })
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.agent().call('posts_store', { title: '', excerpt: 'Short', body: 'Long' }).assertStatus(422)
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
