@@ -0,0 +1,56 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import en from '../lang/en/auth.json'
+import ja from '../lang/ja/auth.json'
+import { inertiaPage } from './helpers/inertia.js'
+
+// The sign-in page reads its copy from lang/<locale>/auth.json and the locale
+// is detected from Accept-Language, so these tests pin both halves: the
+// catalog shipped to the page and the locale the request resolves to.
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  const visit = (acceptLanguage?: string) =>
+    (acceptLanguage === undefined ? http : http.withHeader('Accept-Language', acceptLanguage)).get('/login')
+
+  it('renders the login page', async () => {
+    const page = await inertiaPage(await visit().assertOk())
+    expect(page.component).toBe('auth/Login')
+  })
+
+  it('serves Japanese copy to a Japanese browser', async () => {
+    const response = await visit('ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+    const page = await inertiaPage(response)
+
+    expect(page.props._i18n.locale).toBe('ja')
+    expect(page.props._i18n.messages.ja.auth.login).toEqual(ja.login)
+    expect(await response.text()).toContain('<title>ログイン</title>')
+  })
+
+  it.each(['ja', 'ja-JP'])('serves Japanese copy for Accept-Language: %s', async (header) => {
+    const page = await inertiaPage(await visit(header))
+
+    expect(page.props._i18n.locale).toBe('ja')
+    expect(page.props._i18n.messages.ja.auth.login.submit).toBe('ログイン')
+  })
+
+  it.each([
+    ['no Accept-Language header', undefined],
+    ['English', 'en'],
+    ['English with quality values', 'en-US,en;q=0.9'],
+    ['English outranking Japanese', 'en-US,en;q=0.9,ja;q=0.5'],
+    ['an unsupported language', 'fr-FR,fr;q=0.9'],
+  ])('keeps the English copy for %s', async (_label, header) => {
+    const response = await visit(header)
+    const page = await inertiaPage(response)
+
+    expect(page.props._i18n.locale).toBe('en')
+    expect(page.props._i18n.messages.en.auth.login).toEqual(en.login)
+    expect(await response.text()).toContain('<title>Sign in</title>')
+  })
+})
