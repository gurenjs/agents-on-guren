diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..0947902
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,90 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Boots the app once (bootModels() seeds demo data on first boot only,
+    // outside production) before the per-test resetDatabase() wipes it —
+    // calling fromApp() again per test would not reseed, but doing the boot
+    // here keeps the intent explicit.
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('lists posts newest first with author info and no auth required', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret123' })
+    const bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret123' })
+    const first = await Post.forceCreate({ title: 'First', excerpt: 'e1', body: 'b1', authorId: alice.id })
+    const second = await Post.forceCreate({ title: 'Second', excerpt: 'e2', body: 'b2', authorId: bob.id })
+
+    const res = await http.get('/api/posts').assertOk()
+    const body = await res.json<{
+      data: Array<{ id: number; title: string; author: { id: number; name: string } }>
+      meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+    }>()
+
+    if (body.data.length !== 2) throw new Error(`expected 2 posts, got ${body.data.length}`)
+    if (body.data[0]?.id !== second.id) throw new Error('expected newest post first')
+    if (body.data[1]?.id !== first.id) throw new Error('expected oldest post second')
+    if (body.data[0]?.author.name !== 'Bob') throw new Error('expected author name on post')
+    if (body.meta.total !== 2) throw new Error(`expected total 2, got ${body.meta.total}`)
+    if (body.meta.perPage !== 10) throw new Error(`expected perPage 10, got ${body.meta.perPage}`)
+    if (body.meta.currentPage !== 1) throw new Error(`expected currentPage 1, got ${body.meta.currentPage}`)
+    if (body.meta.lastPage !== 1) throw new Error(`expected lastPage 1, got ${body.meta.lastPage}`)
+  })
+
+  it('paginates at 10 per page', async () => {
+    const author = await User.create({ name: 'Carol', email: 'carol@example.com', password: 'secret123' })
+    for (let i = 0; i < 12; i++) {
+      await Post.forceCreate({ title: `Post ${i}`, excerpt: 'e', body: 'b', authorId: author.id })
+    }
+
+    const page1 = await (await http.get('/api/posts').assertOk()).json<{ data: unknown[]; meta: { lastPage: number; total: number } }>()
+    if (page1.data.length !== 10) throw new Error(`expected 10 posts on page 1, got ${page1.data.length}`)
+    if (page1.meta.total !== 12) throw new Error(`expected total 12, got ${page1.meta.total}`)
+    if (page1.meta.lastPage !== 2) throw new Error(`expected lastPage 2, got ${page1.meta.lastPage}`)
+
+    const page2 = await (await http.get('/api/posts?page=2').assertOk()).json<{ data: unknown[] }>()
+    if (page2.data.length !== 2) throw new Error(`expected 2 posts on page 2, got ${page2.data.length}`)
+  })
+
+  it('filters by author', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice2@example.com', password: 'secret123' })
+    const bob = await User.create({ name: 'Bob', email: 'bob2@example.com', password: 'secret123' })
+    await Post.forceCreate({ title: 'A1', excerpt: 'e', body: 'b', authorId: alice.id })
+    await Post.forceCreate({ title: 'B1', excerpt: 'e', body: 'b', authorId: bob.id })
+
+    const filtered = await (await http.get(`/api/posts?author=${alice.id}`).assertOk()).json<{
+      data: Array<{ title: string }>
+      meta: { total: number }
+    }>()
+    if (filtered.data.length !== 1) throw new Error(`expected 1 post, got ${filtered.data.length}`)
+    if (filtered.data[0]?.title !== 'A1') throw new Error('expected only alice post')
+    if (filtered.meta.total !== 1) throw new Error(`expected total 1, got ${filtered.meta.total}`)
+  })
+
+  it('returns an empty list for an author with no posts', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice3@example.com', password: 'secret123' })
+
+    const res = await http.get(`/api/posts?author=${alice.id}`).assertOk()
+    const body = await res.json<{ data: unknown[]; meta: { total: number } }>()
+    if (body.data.length !== 0) throw new Error('expected empty data')
+    if (body.meta.total !== 0) throw new Error('expected total 0')
+  })
+
+  it('rejects invalid page and author values', async () => {
+    await http.get('/api/posts?page=0').assertUnprocessable()
+    await http.get('/api/posts?page=abc').assertUnprocessable()
+    await http.get('/api/posts?author=abc').assertUnprocessable()
+    await http.get('/api/posts?author=0').assertUnprocessable()
+  })
+})
