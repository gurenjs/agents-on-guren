diff --git a/app/Support/CoverStorage.ts b/app/Support/CoverStorage.ts
new file mode 100644
index 0000000..1eb9f85
--- /dev/null
+++ b/app/Support/CoverStorage.ts
@@ -0,0 +1,52 @@
+import { mkdir, rm } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const MAX_COVER_BYTES = 2 * 1024 * 1024
+
+const EXTENSIONS: Record<string, string> = { 'image/png': 'png', 'image/jpeg': 'jpg' }
+
+const storageRoot = fileURLToPath(new URL('../../storage/attachments/', import.meta.url))
+
+/** Decides the type from the bytes: a client-declared content type proves nothing. */
+export function sniffCoverType(bytes: Uint8Array): 'image/png' | 'image/jpeg' | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (bytes.length >= 8 && png.every((byte, i) => bytes[i] === byte)) return 'image/png'
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+export function coverUrl(attachment: Pick<AttachmentRecord, 'id'> | undefined): string | null {
+  return attachment ? `/attachments/${attachment.id}` : null
+}
+
+export function coverPath(attachment: Pick<AttachmentRecord, 'path'>): string {
+  return storageRoot + attachment.path
+}
+
+export async function storeCover(postId: number, bytes: Uint8Array, mimeType: string): Promise<AttachmentRecord> {
+  await mkdir(storageRoot, { recursive: true })
+  const path = `${crypto.randomUUID()}.${EXTENSIONS[mimeType]}`
+  await Bun.write(storageRoot + path, bytes)
+  try {
+    return (await Attachment.forceCreate({ postId, path, mimeType, size: bytes.byteLength })) as AttachmentRecord
+  } catch (error) {
+    await rm(storageRoot + path, { force: true })
+    throw error
+  }
+}
+
+export async function removeCovers(postId: number, keepId?: number): Promise<void> {
+  const rows = (await Attachment.where({ postId }).get()).filter((row) => row.id !== keepId)
+  await Promise.all(rows.map((row) => Attachment.delete({ id: row.id })))
+  await Promise.all(rows.map((row) => rm(coverPath(row), { force: true })))
+}
+
+/** Cover per post id; posts without one are absent from the map. */
+export async function coversFor(postIds: number[]): Promise<Map<number, AttachmentRecord>> {
+  const map = new Map<number, AttachmentRecord>()
+  if (postIds.length === 0) return map
+  const rows = await Attachment.where({ postId: postIds }).orderBy('id', 'asc').get()
+  for (const row of rows) map.set(row.postId, row)
+  return map
+}
