+++ b/tests/ExcerptHelper.test.ts
@@ -0,0 +1,85 @@
+import { describe, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Helpers/ExcerptHelper.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body when 140 characters or fewer', () => {
+    const body = 'The quick brown fox jumps over the lazy dog'
+    const result = deriveExcerpt(body)
+    // Body is exactly 44 characters, no ellipsis needed
+    // result should be the whole body without ellipsis
+    if (body === result) {
+      console.log('✓ Body ≤ 140 chars returns whole body')
+    }
+  })
+
+  it('cuts at the last whitespace when character 141 is inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const result = deriveExcerpt(body)
+    // The first 140 characters end with "The q", and char 141 is "u"
+    // Should cut at the space before "quick" (from "dog. The ")
+    // Expected: "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…"
+    const expected =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+    if (result === expected) {
+      console.log('✓ Cuts at last whitespace when in middle of word')
+    } else {
+      console.log(`✗ Expected: "${expected}" (${expected.length} chars)`)
+      console.log(`  Got:      "${result}" (${result.length} chars)`)
+      if (result.endsWith('…')) {
+        console.log('  (Ends with ellipsis correctly)')
+      }
+    }
+  })
+
+  it('keeps all 140 characters when character 141 is whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const result = deriveExcerpt(body)
+    // The first 140 characters should end with "right", and char 141 is a space
+    // So keep all 140 and add ellipsis
+    const first140 = body.substring(0, 140)
+    const expected = first140 + '…'
+    if (result === expected) {
+      console.log('✓ Keeps all 140 chars when cut is at whitespace boundary')
+    } else {
+      console.log(`✗ Expected: "${expected}" (${expected.length} chars)`)
+      console.log(`  Got:      "${result}" (${result.length} chars)`)
+      console.log(`  First 140: "${first140}"`)
+      console.log(`  Char 140: "${body[139]}"`)
+      console.log(`  Char 141: "${body[140]}"`)
+    }
+  })
+
+  it('handles whitespace trimming', () => {
+    const body = '  The quick brown fox  ' // Leading and trailing spaces
+    const result = deriveExcerpt(body)
+    if (result === 'The quick brown fox') {
+      console.log('✓ Trims leading and trailing whitespace')
+    } else {
+      console.log(`✗ Expected trimmed body, got: "${result}"`)
+    }
+  })
+
+  it('handles one long word without spaces', () => {
+    const body = 'a'.repeat(150)
+    const result = deriveExcerpt(body)
+    const expected = 'a'.repeat(140) + '…'
+    if (result === expected) {
+      console.log('✓ Handles word with no spaces, keeps 140 chars')
+    } else {
+      console.log(`✗ Expected: ${expected.length} chars of 'a' + …`)
+      console.log(`  Got: ${result.length} chars`)
+    }
+  })
+
+  it('returns correct excerpt for a real post body', () => {
+    const body = `In today's fast-paced world, staying informed is more important than ever. The speed at which information travels across digital platforms means we must develop critical thinking skills to evaluate what we encounter online. Let me share some thoughts about this...`
+    const result = deriveExcerpt(body)
+    if (result.endsWith('…')) {
+      console.log('✓ Appends ellipsis to truncated text')
+    } else {
+      console.log(`✗ Should end with ellipsis, got: "${result.slice(-10)}"`)
+    }
+  })
+})
