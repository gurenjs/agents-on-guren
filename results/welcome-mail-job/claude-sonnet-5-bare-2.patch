--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,20 @@
+import { ServiceProvider, registerJob, createQueueManager, type QueueManager } from '@guren/core'
+import { queueConfig } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => createQueueManager(queueConfig))
+  }
+
+  boot(): void {
+    // Job classes must be registered before anything dispatches — the sync
+    // driver runs a job inline on push and needs to resolve it by name, and
+    // a worker process resolves it the same way when popping from Redis.
+    registerJob(SendWelcomeEmailJob)
+
+    // Resolving the default driver also makes it the global driver that
+    // Job.dispatch() reads — see QueueManager.driver().
+    this.container.make<QueueManager>('queue').driver()
+  }
+}
