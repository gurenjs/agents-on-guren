+import { Mail, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+
+export interface WelcomeMailData {
+  /** The name the user typed into the registration form. */
+  name: string
+}
+
+/**
+ * The first message a newly registered account receives. The sender comes
+ * from the manager's configured `from` (MAIL_FROM_ADDRESS / MAIL_FROM_NAME),
+ * so only the recipient has to be set by the caller.
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  override build(): this {
+    const app = appName()
+
+    return this.subject(`Welcome to ${app}, ${this.data.name}!`).text(
+      [
+        `Hi ${this.data.name},`,
+        '',
+        `Welcome to ${app} — your account is ready.`,
+        '',
+        'Sign in whenever you like and write your first post.',
+        '',
+        `— The ${app} team`,
+      ].join('\n'),
+    )
+  }
+}
