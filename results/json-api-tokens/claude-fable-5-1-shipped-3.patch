@@ -0,0 +1,126 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+async function makeUser(): Promise<UserRecord> {
+  const user = await User.create({
+    name: 'Script Author',
+    email: `api-${crypto.randomUUID()}@example.com`,
+    password: 'secret-password',
+  })
+  return user as UserRecord
+}
+
+describe('api.posts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function issue(user: UserRecord, name = 'CI'): Promise<string> {
+    const client = (await http.actingAs(user).withCsrf()).json()
+    const response = await client.post('/profile/tokens', { name })
+    response.assertCreated()
+    return (await response.json<{ token: string }>()).token
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('lists every post newest first for a valid token', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const first = await Post.forceCreate({ title: 'First', excerpt: 'one', body: 'b', authorId: author.id })
+    const second = await Post.forceCreate({ title: 'Second', excerpt: 'two', body: 'b', authorId: other.id })
+
+    const response = await bearer(await issue(author)).get('/api/posts')
+    response.assertOk()
+    const { data } = await response.json<{ data: ApiPost[] }>()
+
+    const ids = data.map((post) => post.id)
+    expect(ids.indexOf(second!.id)).toBeLessThan(ids.indexOf(first!.id))
+    const mine = data.find((post) => post.id === first!.id)!
+    expect(mine).toMatchObject({ title: 'First', excerpt: 'one', authorId: author.id })
+    expect(new Date(mine.createdAt).toISOString()).toBe(mine.createdAt)
+  })
+
+  it('creates a post owned by the token owner whatever the body says', async () => {
+    const owner = await makeUser()
+    const impostor = await makeUser()
+
+    const response = await bearer(await issue(owner)).post('/api/posts', {
+      title: 'From a script',
+      excerpt: 'release notes',
+      body: 'Shipped.',
+      authorId: impostor.id,
+    })
+    response.assertCreated()
+    const { data } = await response.json<{ data: ApiPost }>()
+
+    expect(data).toMatchObject({ title: 'From a script', excerpt: 'release notes', authorId: owner.id })
+    expect(typeof data.id).toBe('number')
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+    expect((await Post.findOrFail(data.id)).authorId).toBe(owner.id)
+  })
+
+  it('rejects input the web form would reject with 422 and creates nothing', async () => {
+    const client = bearer(await issue(await makeUser()))
+    const before = await Post.newQuery().count()
+
+    await client.post('/api/posts', { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+    await client.post('/api/posts', { title: 'No body', excerpt: 'x' }).assertUnprocessable()
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('answers 401 JSON to missing, malformed, unknown and tampered tokens', async () => {
+    const good = await issue(await makeUser())
+    const [id, secret] = good.split('|')
+    const before = await Post.newQuery().count()
+    const payload = { title: 'Nope', excerpt: 'x', body: 'y' }
+
+    const missing = await http.json().get('/api/posts')
+    missing.assertUnauthorized()
+    expect(await missing.json()).toHaveProperty('message')
+
+    await http.json().withHeader('Authorization', 'Basic abc').get('/api/posts').assertUnauthorized()
+    await bearer('not-a-token').get('/api/posts').assertUnauthorized()
+    await bearer(`${id}|${'0'.repeat(secret!.length)}`).get('/api/posts').assertUnauthorized()
+    await bearer(`${'0'.repeat(id!.length)}|${secret}`).get('/api/posts').assertUnauthorized()
+
+    await bearer('not-a-token').post('/api/posts', payload).assertUnauthorized()
+    await bearer(`${id}|${'0'.repeat(secret!.length)}`).post('/api/posts', payload).assertUnauthorized()
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('limits each token to 60 requests a minute, independently of sibling tokens', async () => {
+    const user = await makeUser()
+    const limited = bearer(await issue(user, 'limited'))
+    const sibling = bearer(await issue(user, 'sibling'))
+
+    for (let i = 0; i < 60; i++) {
+      await limited.get('/api/posts').assertOk()
+    }
+
+    const blocked = await limited.get('/api/posts')
+    blocked.assertStatus(429)
+    const retryAfter = Number(blocked.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await sibling.get('/api/posts').assertOk()
+  })
+})
