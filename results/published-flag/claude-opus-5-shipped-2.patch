diff --git a/tests/PostDrafts.test.ts b/tests/PostDrafts.test.ts
new file mode 100644
index 0000000..ed3cfec
--- /dev/null
+++ b/tests/PostDrafts.test.ts
@@ -0,0 +1,131 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Drafts: a post is private to its author until `published` is ticked. These
+// tests drive the real database (a separate SQLite file under NODE_ENV=test)
+// because every rule here lives in a query or a policy, not in validation.
+describe('post drafts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let draft: PostRecord
+  let published: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    author = (await User.create({
+      name: 'Ada',
+      email: 'ada@example.com',
+      password: 'secret',
+    })) as UserRecord
+    other = (await User.create({
+      name: 'Bob',
+      email: 'bob@example.com',
+      password: 'secret',
+    })) as UserRecord
+
+    draft = (await Post.forceCreate({
+      title: 'Unfinished thoughts on zeppelins',
+      excerpt: 'A zeppelinesque draft.',
+      body: 'Still writing.',
+      published: false,
+      authorId: author.id,
+    })) as PostRecord
+    published = (await Post.forceCreate({
+      title: 'Shipped and public',
+      excerpt: 'Readable by anyone.',
+      body: 'Done.',
+      published: true,
+      authorId: author.id,
+    })) as PostRecord
+  })
+
+  it('hides drafts from guests on the list', async () => {
+    const response = await http.json().get('/posts')
+    const page = await response.json<{ props: { data: Array<{ id: number; published: boolean }> } }>()
+    const ids = page.props.data.map((post) => post.id)
+
+    expect(ids).toContain(published.id)
+    expect(ids).not.toContain(draft.id)
+    expect(page.props.data.find((post) => post.id === published.id)?.published).toBe(true)
+  })
+
+  it('keeps drafts out of search results for other users', async () => {
+    const asOther = http.actingAs(other)
+    const response = await asOther.query('/posts/search', { keywords: ['zeppelin'] })
+    await response.assertOk()
+    const payload = await response.json<{ data: Array<{ id: number }> }>()
+
+    expect(payload.data).toHaveLength(0)
+  })
+
+  it('lets the author find their own draft', async () => {
+    const response = await http.actingAs(author).query('/posts/search', { keywords: ['zeppelin'] })
+    const payload = await response.json<{ data: Array<{ id: number }> }>()
+
+    expect(payload.data.map((post) => post.id)).toContain(draft.id)
+  })
+
+  it('answers 404 for a draft opened by anyone but its author', async () => {
+    await http.get(`/posts/${draft.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${draft.id}`).assertNotFound()
+  })
+
+  it('shows the draft and its edit form to the author', async () => {
+    await http.actingAs(author).get(`/posts/${draft.id}`).assertOk()
+    await http.actingAs(author).get(`/posts/${draft.id}/edit`).assertOk()
+  })
+
+  it('creates a draft when the checkbox is absent', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Quiet start', excerpt: 'Not yet.', body: 'Draft body.' }).assertRedirect()
+
+    const created = await Post.first({ title: 'Quiet start' })
+    expect(Boolean(created?.published)).toBe(false)
+    await http.get(`/posts/${created?.id}`).assertNotFound()
+  })
+
+  it('publishes immediately when the checkbox is ticked', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Live now', excerpt: 'Public.', body: 'Body.', published: true })
+      .assertRedirect()
+
+    const created = await Post.first({ title: 'Live now' })
+    expect(Boolean(created?.published)).toBe(true)
+    await http.get(`/posts/${created?.id}`).assertOk()
+  })
+
+  it('publishes a draft and unpublishes a post from the edit form', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${draft.id}`, {
+        title: draft.title,
+        excerpt: draft.excerpt,
+        body: draft.body,
+        published: true,
+      })
+      .assertRedirect()
+    await http.get(`/posts/${draft.id}`).assertOk()
+
+    await csrf
+      .put(`/posts/${published.id}`, {
+        title: published.title,
+        excerpt: published.excerpt,
+        body: published.body,
+        published: false,
+      })
+      .assertRedirect()
+    await http.get(`/posts/${published.id}`).assertNotFound()
+  })
+})
