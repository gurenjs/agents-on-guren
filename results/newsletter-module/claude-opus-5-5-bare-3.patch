+import type { Router } from '@guren/core'
+import SubscriptionController from './app/Http/Controllers/SubscriptionController.js'
+import { SubscriptionEmailSchema } from './app/Http/Validators/SubscriptionValidator.js'
+
+// Mounted under the module's '/newsletter' prefix (see ./index.ts).
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscriptionEmailSchema }, [SubscriptionController, 'store'])
+  router.get('/confirm/:token', [SubscriptionController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: SubscriptionEmailSchema }, [SubscriptionController, 'destroy'])
+}
