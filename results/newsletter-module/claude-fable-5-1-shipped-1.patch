index 0000000..05c3ee0
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,55 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, NotFoundHttpException, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This address is already subscribed.' })
+    }
+
+    // 24 random bytes → 32 URL-safe characters; the confirmation link carries it verbatim.
+    const token = randomBytes(24).toString('base64url')
+    await NewsletterSubscription.forceCreate({ email, token })
+
+    return this.redirectBack()
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validated('newsletter.confirm').params
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException('Unknown confirmation token.')
+    }
+
+    if (subscription.confirmedAt === null) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirectBack()
+  }
+
+  // Only a same-origin Referer is followed: the header is client-controlled,
+  // so an off-site value would turn this into an open redirect.
+  private redirectBack(): Response {
+    const referer = this.request.header('referer')
+    const target = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(target)
+  }
+}
