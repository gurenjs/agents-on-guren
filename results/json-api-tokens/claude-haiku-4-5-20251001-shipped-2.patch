+import { defineMiddleware, HttpException } from '@guren/core'
+
+export const requireBearerToken = defineMiddleware(async (c, next) => {
+  const user = c.get('apiTokenUser')
+  if (!user) {
+    throw HttpException.unauthorized('Bearer token required')
+  }
+
+  return await next()
+})
