@@ -0,0 +1,48 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  revisions: { id: number; title: string; createdAt: string }[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`Revisions of ${post.title}`} />
+      <section className="space-y-6">
+        <h1 className="text-3xl font-bold text-g-heading">Revisions of {post.title}</h1>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-muted">No earlier versions yet.</p>
+        ) : (
+          <ul className="divide-y divide-g-line">
+            {revisions.map((revision) => (
+              <li key={revision.id} className="flex items-center justify-between gap-4 py-3">
+                <div>
+                  <p className="text-g-heading">{revision.title}</p>
+                  <p className="text-sm text-g-muted">{new Date(revision.createdAt).toLocaleString()}</p>
+                </div>
+                <Link
+                  href={route('posts.restore', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm('Restore this version?')}
+                  className="rounded-g-ctl border border-g-line px-3 py-1 text-sm text-g-accent-text transition hover:underline"
+                >
+                  Restore
+                </Link>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        <Link href={route('posts.show', { id: post.id })} className="text-sm text-g-text-2 transition hover:text-g-heading">
+          ← Back to post
+        </Link>
+      </section>
+    </Layout>
+  )
+}
