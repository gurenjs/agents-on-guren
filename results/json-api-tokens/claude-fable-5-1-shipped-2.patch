+    bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+  })
+
+  async function createToken(user: UserRecord, name = 'CI'): Promise<{ id: string; token: string }> {
+    const csrf = await http.actingAs(user).json().withCsrf()
+    const response = await csrf.post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<{ id: string; token: string }>()
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  const draft = { title: 'Release notes', excerpt: 'What changed', body: 'Everything.' }
+
+  it('lists every author\'s posts, newest first', async () => {
+    await Post.forceCreate({ ...draft, title: 'Oldest', authorId: ada.id, createdAt: '2026-01-01T00:00:00.000Z' })
+    await Post.forceCreate({ ...draft, title: 'Newest', authorId: bob.id, createdAt: '2026-03-01T00:00:00.000Z' })
+    await Post.forceCreate({ ...draft, title: 'Middle', authorId: ada.id, createdAt: '2026-02-01T00:00:00.000Z' })
+    const { token } = await createToken(ada)
+
+    const response = await bearer(token).get('/api/posts')
+    response.assertOk()
+    const { data } = await response.json<{ data: PostPayload[] }>()
+
+    expect(data.map((post) => post.title)).toEqual(['Newest', 'Middle', 'Oldest'])
+    expect(data[0]).toMatchObject({ excerpt: 'What changed', authorId: bob.id, createdAt: '2026-03-01T00:00:00.000Z' })
+    expect(typeof data[0]?.id).toBe('number')
+  })
+
+  it('creates a post owned by the token\'s owner, whatever the body says', async () => {
+    const { token } = await createToken(ada)
+
+    const response = await bearer(token).post('/api/posts', { ...draft, authorId: bob.id })
+    response.assertCreated()
+    const { data } = await response.json<{ data: PostPayload }>()
+
+    expect(data).toMatchObject({ title: 'Release notes', excerpt: 'What changed', authorId: ada.id })
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+    const stored = await Post.findOrFail(data.id)
+    expect(stored.authorId).toBe(ada.id)
+  })
+
+  it('answers 422 with a JSON body for input the web form would reject', async () => {
+    const { token } = await createToken(ada)
+
+    await bearer(token).post('/api/posts', { ...draft, title: '' }).assertUnprocessable()
+    const response = await bearer(token).post('/api/posts', { title: 'No body', excerpt: 'None' })
+    response.assertUnprocessable()
+    const payload = await response.json<{ errors: Record<string, string[]> }>()
+
+    expect(payload.errors.body).toBeDefined()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('answers 401 with a JSON body for a missing, malformed, unknown or tampered token', async () => {
+    const { id, token } = await createToken(ada)
+    const secret = token.split('|')[1] ?? ''
+    const flipped = secret.endsWith('0') ? `${secret.slice(0, -1)}1` : `${secret.slice(0, -1)}0`
+    const other = await createToken(bob)
+
+    const credentials = [
+      undefined,
+      'Bearer',
+      'Bearer not-a-token',
+      `Basic ${token}`,
+      `Bearer ${secret}`,
+      `Bearer ${id}|${flipped}`,
+      `Bearer ${id}|${'0'.repeat(64)}`,
+      // A valid secret presented under another token's id.
+      `Bearer ${other.id}|${secret}`,
+    ]
+
+    for (const credential of credentials) {
+      const client = credential === undefined ? http.json() : http.json().withHeader('Authorization', credential)
+
+      const list = await client.get('/api/posts')
+      list.assertUnauthorized()
+      expect(await list.json<{ message: string }>()).toEqual({ message: 'Unauthenticated.' })
+
+      const create = await client.post('/api/posts', draft)
+      // No bearer credential at all: CSRF protection may answer first.
+      expect(credential?.startsWith('Bearer ') ? [401] : [401, 403]).toContain(create.status)
+    }
+
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('answers 401 before validating the body', async () => {
+    await bearer(`unknown|${'0'.repeat(64)}`).post('/api/posts', {}).assertUnauthorized()
+  })
+
+  it('allows 60 requests a minute per token, not per account', async () => {
+    const first = await createToken(ada, 'CI')
+    const second = await createToken(ada, 'old laptop')
+
+    for (let request = 1; request <= 60; request++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(first.token).post('/api/posts', draft).assertStatus(429)
+    expect(await Post.all()).toHaveLength(0)
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
