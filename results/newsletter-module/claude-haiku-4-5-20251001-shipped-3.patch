+import { Controller, ValidationException } from '@guren/core'
+import { generateSecureToken } from '../../../utils/token.js'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { SubscribeSchema, ConfirmTokenSchema, UnsubscribeSchema } from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const body = await this.validateBody(SubscribeSchema)
+    const referer = this.ctx.req.header('Referer') || '/'
+
+    const existing = await NewsletterSubscription.first({ email: body.email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'Email is already subscribed.' })
+    }
+
+    const token = generateSecureToken()
+    await NewsletterSubscription.create({
+      email: body.email,
+      token,
+    })
+
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const params = await this.validateParams(ConfirmTokenSchema)
+    const subscription = await NewsletterSubscription.first({ token: params.token })
+
+    if (!subscription) {
+      return this.json({ message: 'Not Found' }, { status: 404 })
+    }
+
+    await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const body = await this.validateBody(UnsubscribeSchema)
+    const referer = this.ctx.req.header('Referer') || '/'
+
+    await NewsletterSubscription.delete({ email: body.email })
+
+    return this.redirect(referer)
+  }
+}
