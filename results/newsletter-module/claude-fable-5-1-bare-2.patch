+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+// Every request is a guest's, with CSRF satisfied the way a browser would and
+// a Referer naming a page of this site — the contract the module ships under.
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function browser(referer = 'http://localhost/posts'): Promise<TestApp> {
+    const csrf = await http.withCsrf()
+    return csrf.withHeader('Referer', referer)
+  }
+
+  describe('POST /newsletter/subscribe', () => {
+    it('stores a pending subscription with a token and goes back to the referer', async () => {
+      const response = await (await browser()).post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      response.assertRedirect()
+      expect(response.headers.get('location')).toBe('/posts')
+
+      const subscription = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(subscription).not.toBeNull()
+      expect(subscription?.confirmedAt).toBeNull()
+      expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to the home page without a referer', async () => {
+      const csrf = await http.withCsrf()
+      const response = await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      response.assertRedirect()
+      expect(response.headers.get('location')).toBe('/')
+    })
+
+    it('rejects an invalid email address and stores nothing', async () => {
+      const client = await browser()
+
+      await client.post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+      await client.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+
+      expect(await NewsletterSubscription.newQuery().count()).toBe(0)
+    })
+
+    it('rejects an address that is already subscribed under `email`', async () => {
+      const client = await browser()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+
+      const response = await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertStatus(422)
+      const body = await response.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email).toBeDefined()
+
+      expect(await NewsletterSubscription.newQuery().count()).toBe(1)
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('confirms the subscription and goes to the home page', async () => {
+      await (await browser()).post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+      const pending = await NewsletterSubscription.first({ email: 'reader@example.com' })
+
+      const response = await http.get(`/newsletter/confirm/${pending?.token}`)
+      response.assertRedirect()
+      expect(response.headers.get('location')).toBe('/')
+
+      const confirmed = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(confirmed?.confirmedAt).not.toBeNull()
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      await (await browser()).post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+
+      await http.get('/newsletter/confirm/not-a-token-we-issued').assertNotFound()
+
+      const subscription = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(subscription?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('deletes that subscription only and goes back to the referer', async () => {
+      const client = await browser('http://localhost/posts/1')
+      await client.post('/newsletter/subscribe', { email: 'leaving@example.com' }).assertRedirect()
