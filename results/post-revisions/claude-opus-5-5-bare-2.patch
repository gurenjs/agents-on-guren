+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+type RevisionsProps = { revisions: { id: number; title: string; createdAt: string }[] }
+
+const unique = () => `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+async function makeUser(): Promise<UserRecord> {
+  return User.create({ name: 'Author', email: `author-${unique()}@example.com`, password: 'secret-password' })
+}
+
+async function makePost(author: UserRecord, title = 'First'): Promise<PostRecord> {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+}
+
+const payload = (title: string) => ({ title, excerpt: `${title} excerpt`, body: `${title} body` })
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    // Mutating requests must pass CSRF like a real browser's would.
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  async function revisionTitles(as: UserRecord, postId: number): Promise<string[]> {
+    const response = await http.actingAs(as).get(`/posts/${postId}/revisions`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const { revisions } = payload.props as unknown as RevisionsProps
+    return revisions.map((revision) => revision.title)
+  }
+
+  it('keeps earlier versions and restores them without losing any', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const client = http.actingAs(author)
+
+    await client.put(`/posts/${post.id}`, payload('Second')).assertRedirect(`/posts/${post.id}`)
+    await client.put(`/posts/${post.id}`, payload('Third')).assertRedirect(`/posts/${post.id}`)
+    await client.put(`/posts/${post.id}`, { title: '' }).assertStatus(422)
+
+    expect(await revisionTitles(author, post.id)).toEqual(['Second', 'First'])
+
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+    await client.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored).toMatchObject(payload('First'))
+    expect(await revisionTitles(author, post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and guests, and 404s a revision of another post', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+    const otherPost = await makePost(author, 'Other')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second'))
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+    const restorePath = `/posts/${post.id}/revisions/${revision.id}/restore`
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(other).post(restorePath).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(restorePath).assertRedirect('/login')
+    await http
+      .actingAs(author)
+      .post(`/posts/${otherPost.id}/revisions/${revision.id}/restore`)
+      .assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect((await Post.findOrFail(otherPost.id)).title).toBe('Other')
+    expect(await PostRevision.where({ postId: post.id }).get()).toHaveLength(1)
+  })
+
+  it('deletes a post’s revisions with the post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const keep = await makePost(author, 'Keep')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second'))
+    await http.actingAs(author).put(`/posts/${keep.id}`, payload('Kept'))
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await PostRevision.where({ postId: post.id }).get()).toHaveLength(0)
+    expect(await PostRevision.where({ postId: keep.id }).get()).toHaveLength(1)
+  })
+})
