diff --git a/tests/PostController.drafts.test.ts b/tests/PostController.drafts.test.ts
new file mode 100644
index 0000000..d50d249
--- /dev/null
+++ b/tests/PostController.drafts.test.ts
@@ -0,0 +1,130 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+describe('post drafts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let otherUser: UserRecord
+  let draftId: number
+  let publishedId: number
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret1234' })) as UserRecord
+    otherUser = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret1234' })) as UserRecord
+
+    const draft = await Post.forceCreate({
+      title: 'A secret draft',
+      excerpt: 'Only the author should ever see this.',
+      body: 'Draft body.',
+      published: false,
+      authorId: author.id,
+    })
+    const published = await Post.forceCreate({
+      title: 'A public post',
+      excerpt: 'Everyone can see this.',
+      body: 'Published body.',
+      published: true,
+      authorId: author.id,
+    })
+    draftId = draft!.id
+    publishedId = published!.id
+  })
+
+  describe('as a guest', () => {
+    it('excludes the draft from the post list', async () => {
+      const res = await http.withHeader('X-Inertia', 'true').get('/posts').assertOk()
+      const body = await res.json<{ props: { data: Array<{ id: number }> } }>()
+      const ids = body.props.data.map((p) => p.id)
+      expect(ids).toContain(publishedId)
+      expect(ids).not.toContain(draftId)
+    })
+
+    it('excludes the draft from search results even on a matching keyword', async () => {
+      const res = await http.query('/posts/search', { keywords: ['secret'] }).assertOk()
+      const body = await res.json<{ data: Array<{ id: number }> }>()
+      expect(body.data.map((p) => p.id)).not.toContain(draftId)
+    })
+
+    it('finds the published post via search', async () => {
+      const res = await http.query('/posts/search', { keywords: ['public'] }).assertOk()
+      const body = await res.json<{ data: Array<{ id: number }> }>()
+      expect(body.data.map((p) => p.id)).toContain(publishedId)
+    })
+
+    it('404s opening the draft directly', async () => {
+      await http.get(`/posts/${draftId}`).assertNotFound()
+    })
+
+    it('opens the published post with published: true', async () => {
+      const res = await http.withHeader('X-Inertia', 'true').get(`/posts/${publishedId}`).assertOk()
+      const body = await res.json<{ props: { post: { published: boolean } } }>()
+      expect(body.props.post.published).toBe(true)
+    })
+  })
+
+  describe('as a signed-in user who is not the author', () => {
+    it('404s opening the draft directly', async () => {
+      await http.actingAs(otherUser).get(`/posts/${draftId}`).assertNotFound()
+    })
+  })
+
+  describe('as the author', () => {
+    it('opens their own draft with published: false', async () => {
+      const res = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${draftId}`).assertOk()
+      const body = await res.json<{ props: { post: { published: boolean } } }>()
+      expect(body.props.post.published).toBe(false)
+    })
+
+    it('opens the edit form for their own draft', async () => {
+      await http.actingAs(author).get(`/posts/${draftId}/edit`).assertOk()
+    })
+  })
+
+  describe('creating a post', () => {
+    it('defaults to a draft when published is omitted', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .post('/posts', { title: 'New post', excerpt: 'excerpt', body: 'body' })
+        .assertRedirect()
+      const created = await Post.first({ title: 'New post' })
+      expect(created?.published).toBe(false)
+    })
+
+    it('publishes immediately when published: true is sent', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .post('/posts', { title: 'Announced post', excerpt: 'excerpt', body: 'body', published: true })
+        .assertRedirect()
+      const created = await Post.first({ title: 'Announced post' })
+      expect(created?.published).toBe(true)
+    })
+  })
+
+  describe('editing a post', () => {
+    it('publishes a draft when the edit form sends published: true', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${draftId}`, { title: 'A secret draft', excerpt: 'Only the author should ever see this.', body: 'Draft body.', published: true })
+        .assertRedirect()
+      const updated = await Post.find(draftId)
+      expect(updated?.published).toBe(true)
+    })
+
+    it('hides a published post when the edit form sends published: false', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${publishedId}`, { title: 'A public post', excerpt: 'Everyone can see this.', body: 'Published body.', published: false })
+        .assertRedirect()
+      const updated = await Post.find(publishedId)
+      expect(updated?.published).toBe(false)
+    })
+  })
+})
