--- /dev/null
+++ b/modules/newsletter/routes.ts
@@ -0,0 +1,18 @@
+import type { Router } from '@guren/core'
+import SubscribeController from './app/Http/Controllers/SubscribeController.js'
+import ConfirmController from './app/Http/Controllers/ConfirmController.js'
+import { SubscribeSchema, UnsubscribeSchema } from './app/Http/Validators/SubscribeValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (newsletter) => {
+    newsletter.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [
+      SubscribeController,
+      'subscribe',
+    ])
+    newsletter.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [
+      SubscribeController,
+      'unsubscribe',
+    ])
+    newsletter.get('/confirm/:token', { name: 'newsletter.confirm' }, [ConfirmController, 'confirm'])
+  })
+}
