--- /dev/null
+++ b/routes/api.ts
@@ -0,0 +1,41 @@
+import {
+  AUTH_CONTEXT_KEY,
+  Router,
+  createRateLimitMiddleware,
+  getApiToken,
+  requireAuthenticated,
+  type AuthContext,
+} from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+// Per token, not per account: two tokens of one user each get their own window.
+export const API_RATE_LIMIT = { limit: 60, windowMs: 60_000 }
+
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    // No redirectTo: a failed check answers 401 JSON, which is what a script
+    // sending a missing, malformed, unknown or revoked bearer must see.
+    .aliasMiddleware('api.auth', requireAuthenticated())
+    .aliasMiddleware('api.throttle', createRateLimitMiddleware({
+      ...API_RATE_LIMIT,
+      keyPrefix: 'api:',
+      // Runs after api.auth, which verified the bearer and cached it on the
+      // context. A session caller (no bearer) is keyed by user instead.
+      keyGenerator: async (ctx) => {
+        const verified = getApiToken(ctx)
+        if (verified) {
+          return `token:${verified.token.id}`
+        }
+        const auth = ctx.get(AUTH_CONTEXT_KEY) as AuthContext | undefined
+        return `user:${String(await auth?.id())}`
+      },
+    }))
+
+  router.group('/api', (api) => {
+    api.middleware('api.auth', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}
