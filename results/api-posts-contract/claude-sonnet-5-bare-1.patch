+  // Serves the public JSON feed `api.posts.index` — unauthenticated, so
+  // partner integrations can embed posts without a session or CSRF token.
+  //
+  // Built on count() + get() rather than QueryBuilder.paginate(): the latter
+  // skips loadEagerRelations(), so a `.with('author')` before `.paginate()`
+  // silently comes back without the author. get() does not have that gap.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+    const perPage = 10
+
+    const query = Post.newQuery()
+    if (author !== undefined) {
+      query.where('authorId', author)
+    }
+
+    const total = await query.count()
+    const lastPage = Math.max(1, Math.ceil(total / perPage))
+    const currentPage = Math.min(page, lastPage)
+    const posts = await query
+      .with('author')
+      .orderBy('id', 'desc')
+      .limit(perPage)
+      .offset((currentPage - 1) * perPage)
+      .get()
+
+    const paginator = paginate({ data: posts, meta: { total, perPage, currentPage } })
+
+    return this.json({
+      data: PostResource.collection(posts),
+      meta: paginator.meta(),
+    })
+  }
+
