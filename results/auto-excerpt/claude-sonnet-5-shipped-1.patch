+
+describe('excerpt derivation', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({
+      name: 'Author',
+      email: 'author@example.com',
+      password: 'secret1234',
+    })
+  })
+
+  async function signedIn(): Promise<TestApp> {
+    return http.actingAs(author).json().withCsrf()
+  }
+
+  it('creates a post with a blank excerpt, deriving one from the body', async () => {
+    const body = 'x'.repeat(200)
+    const client = await signedIn()
+
+    await client.post('/posts', { title: 'Hi', excerpt: '   ', body }).assertRedirect()
+
+    const post = await Post.first({ title: 'Hi' })
+    expect(post?.excerpt).toBe(Post.deriveExcerpt(body))
+    expect(post?.excerpt.length).toBeGreaterThan(0)
+  })
+
+  it('creates a post with no excerpt key at all, deriving one from the body', async () => {
+    const body = 'short body'
+    const client = await signedIn()
+
+    await client.post('/posts', { title: 'No excerpt key', body }).assertRedirect()
+
+    const post = await Post.first({ title: 'No excerpt key' })
+    expect(post?.excerpt).toBe(body)
+  })
+
+  it('keeps a provided excerpt, trimmed', async () => {
+    const client = await signedIn()
+
+    await client.post('/posts', { title: 'Has excerpt', excerpt: '  My teaser  ', body: 'Body text' }).assertRedirect()
+
+    const post = await Post.first({ title: 'Has excerpt' })
+    expect(post?.excerpt).toBe('My teaser')
+  })
+
+  it('re-derives the excerpt on update when cleared, from the new body', async () => {
+    const client = await signedIn()
+    await client.post('/posts', { title: 'Editable', excerpt: 'Original excerpt', body: 'Original body' }).assertRedirect()
+    const created = await Post.first({ title: 'Editable' })
+    if (!created) throw new Error('post not created')
+
+    const newBody = 'y'.repeat(200)
+    await client.put(`/posts/${created.id}`, { title: 'Editable', excerpt: '', body: newBody }).assertRedirect()
+
+    const updated = await Post.findOrFail(created.id)
+    expect(updated.excerpt).toBe(Post.deriveExcerpt(newBody))
+  })
+
+  it('rejects a blank title even when excerpt is provided', async () => {
+    const client = await signedIn()
+    await client.post('/posts', { title: '  ', excerpt: 'teaser', body: 'body' }).assertUnprocessable()
+  })
+
+  it('rejects a blank body', async () => {
+    const client = await signedIn()
+    await client.post('/posts', { title: 'Title', excerpt: 'teaser', body: '   ' }).assertUnprocessable()
+  })
+})
+
+describe('Post.deriveExcerpt', () => {
+  it('returns the whole body untouched when 140 characters or fewer', () => {
+    const body = 'A short body.'
+    expect(Post.deriveExcerpt(body)).toBe(body)
+  })
+
+  it('cuts at the last whitespace before the boundary when it lands inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(body.length).toBe(150)
+    expect(Post.deriveExcerpt(body)).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+  })
+
+  it('keeps all 140 characters when the boundary lands on whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+    expect(Post.deriveExcerpt(body)).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+  })
+
+  it('cuts at 140 when the first 140 characters have no whitespace at all', () => {
+    const body = 'a'.repeat(200)
+    const excerpt = Post.deriveExcerpt(body)
+    expect(excerpt).toBe('a'.repeat(140) + '…')
+  })
+
+  it('trims leading and trailing whitespace on the body before measuring', () => {
+    expect(Post.deriveExcerpt('   padded body   ')).toBe('padded body')
+  })
+})
