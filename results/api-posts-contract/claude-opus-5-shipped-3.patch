new file mode 100644
index 0000000..239492e
--- /dev/null
+++ b/routes/api.ts
@@ -0,0 +1,24 @@
+import type { Router } from '@guren/core'
+import PostController from '../app/Http/Controllers/PostController.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+
+// Public JSON API — no session, no CSRF token, no sign-in. Consumed by
+// external integrators and by our own front-end through the generated client.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    // The `query` schema is the route's contract: it feeds codegen and
+    // `guren audit`, and the router validates the query string against it
+    // before the controller runs (422 on a bad `page`/`author`). The
+    // `resource` hint declares the response shape the controller builds with
+    // PostResource, so the client's json() comes back typed — declared, not
+    // validated, exactly like posts.search.
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+      summary: 'List published posts, newest first',
+      tags: ['posts'],
+    }, [PostController, 'apiIndex'])
+  })
+}
