+++ b/resources/js/components/TagList.tsx
@@ -0,0 +1,29 @@
+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+  className?: string
+}
+
+/** A post's tags, each linking to the posts list filtered by that tag. */
+export default function TagList({ tags, className }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul className={`flex flex-wrap gap-2 ${className ?? ''}`} aria-label="Tags">
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link
+            href={`${route('posts.index')}?${new URLSearchParams({ tag }).toString()}`}
+            className="rounded-g-ctl border border-g-line px-2 py-0.5 font-mono text-xs text-g-text-2 transition hover:border-g-line-strong hover:text-g-heading"
+          >
+            #{tag}
+          </Link>
+        </li>
+      ))}
+    </ul>
+  )
+}
