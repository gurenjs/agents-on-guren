+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { getDatabase, resetDatabase, type AppSeederContext } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import app from '../src/app.js'
+
+interface IssuedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('profile API tokens', () => {
+  let http: TestApp
+  let ada: UserRecord
+  let grace: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    ada = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    grace = await User.create({ name: 'Grace', email: 'grace@example.com', password: 'secret-password' })
+  })
+
+  async function issue(user: UserRecord, name: string): Promise<IssuedToken> {
+    const session = await http.actingAs(user).json().withCsrf()
+    const response = await session.post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<IssuedToken>()
+  }
+
+  describe('POST /profile/tokens', () => {
+    it('answers 201 with the id, the name and the plain-text token', async () => {
+      const issued = await issue(ada, 'CI')
+
+      expect(issued.name).toBe('CI')
+      expect(issued.id).toBeString()
+      const [publicPart, secret] = issued.token.split('|')
+      expect(publicPart).toBe(issued.id)
+      expect(secret.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token every time', async () => {
+      const first = await issue(ada, 'CI')
+      const second = await issue(ada, 'CI')
+
+      expect(second.token).not.toBe(first.token)
+      expect(second.id).not.toBe(first.id)
+    })
+
+    it('stores a hash, never the token or its secret part', async () => {
+      const issued = await issue(ada, 'CI')
+      const secret = issued.token.split('|')[1]
+
+      const db = (await getDatabase()) as AppSeederContext['db']
+      const rows = await db.select().from(apiTokens)
+
+      expect(rows).toHaveLength(1)
+      expect(rows[0].userId).toBe(ada.id)
+      for (const value of Object.values(rows[0])) {
+        const stored = typeof value === 'string' ? value : JSON.stringify(value)
+        expect(stored).not.toContain(secret)
+      }
+    })
+
+    it('accepts a name of exactly 50 characters', async () => {
+      const issued = await issue(ada, 'n'.repeat(50))
+
+      expect(issued.name).toHaveLength(50)
+    })
+
+    it.each([
+      ['a missing name', {}],
+      ['an empty name', { name: '' }],
+      ['a blank name', { name: '   ' }],
+      ['a name over 50 characters', { name: 'n'.repeat(51) }],
+      ['a name that is not a string', { name: 42 }],
+    ])('rejects %s with 422 and creates nothing', async (_label, body) => {
+      const session = await http.actingAs(ada).json().withCsrf()
+
+      await session
+        .post('/profile/tokens', body)
+        .assertUnprocessable()
+        .assertJsonStructure(['message', 'errors'])
+
+      expect(await ApiToken.all()).toHaveLength(0)
+    })
+
+    it('gives a guest no token', async () => {
+      const guest = await http.json().withCsrf()
+
+      const response = await guest.post('/profile/tokens', { name: 'CI' })
+
+      response.assertRedirect('/login')
+      expect(await ApiToken.all()).toHaveLength(0)
+    })
+
+    it('does not accept a bearer token in place of a session', async () => {
+      const issued = await issue(ada, 'CI')
+
+      const response = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${issued.token}`)
+        .post('/profile/tokens', { name: 'minted by a script' })
+
+      response.assertRedirect('/login')
+      expect(await ApiToken.all()).toHaveLength(1)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('answers 204 and the token stops working at once', async () => {
+      const issued = await issue(ada, 'old laptop')
+      const bearer = http.json().withHeader('Authorization', `Bearer ${issued.token}`)
+      await bearer.get('/api/posts').assertOk()
+
+      const session = await http.actingAs(ada).json().withCsrf()
+      await session.delete(`/profile/tokens/${issued.id}`).assertNoContent()
+
+      await bearer.get('/api/posts').assertUnauthorized()
+      expect(await ApiToken.all()).toHaveLength(0)
+    })
+
+    it("leaves the owner's other tokens working", async () => {
+      const revoked = await issue(ada, 'old laptop')
+      const kept = await issue(ada, 'CI')
+
+      const session = await http.actingAs(ada).json().withCsrf()
+      await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+
+      await http.json().withHeader('Authorization', `Bearer ${kept.token}`).get('/api/posts').assertOk()
+    })
+
+    it("answers 404 for another user's token, which keeps working", async () => {
+      const issued = await issue(grace, 'CI')
+
+      const session = await http.actingAs(ada).json().withCsrf()
+      await session.delete(`/profile/tokens/${issued.id}`).assertNotFound()
+
+      await http.json().withHeader('Authorization', `Bearer ${issued.token}`).get('/api/posts').assertOk()
+    })
+
+    it('answers 404 for an unknown id', async () => {
+      const session = await http.actingAs(ada).json().withCsrf()
+
+      await session.delete('/profile/tokens/does-not-exist').assertNotFound()
+    })
+
+    it('redirects a guest and revokes nothing', async () => {
+      const issued = await issue(ada, 'CI')
+
+      const guest = await http.json().withCsrf()
+      await guest.delete(`/profile/tokens/${issued.id}`).assertRedirect('/login')
+
+      expect(await ApiToken.all()).toHaveLength(1)
+    })
+  })
+
+  describe('GET /profile', () => {
+    it("lists the user's own tokens by name, without the hash", async () => {
+      await issue(ada, 'CI')
+      await issue(grace, 'someone else')
+
+      const response = await http.actingAs(ada).get('/profile')
+
+      response.assertOk()
+      const html = await response.text()
+      expect(html).toContain('CI')
+      expect(html).not.toContain('someone else')
+      const [stored] = await ApiToken.where({ userId: ada.id }).get()
+      expect(html).not.toContain(stored.hashedToken)
+    })
+  })
+})
