@@ -20,3 +22,81 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// Nonsense keywords, so these fixtures can never collide with seeded posts.
+const FIXTURE_EMAIL = 'search-fixture@example.com'
+const PUBLISHED_ZEPHYRQUILL = 'zephyrquill in the open'
+const DRAFT_ZEPHYRQUILL = 'zephyrquill behind the curtain'
+const PUBLISHED_MARMALADE = 'marmalade in the open'
+const DRAFT_MARMALADE = 'marmalade behind the curtain'
+const PUBLISHED_UNRELATED = 'nothing to search for here'
+const DRAFT_ONLY_WORD = 'quillhaven, drafted and never published'
+
+const FIXTURE_TITLES = [
+  PUBLISHED_ZEPHYRQUILL,
+  DRAFT_ZEPHYRQUILL,
+  PUBLISHED_MARMALADE,
+  DRAFT_MARMALADE,
+  PUBLISHED_UNRELATED,
+  DRAFT_ONLY_WORD,
+]
+
+describe('posts.search results', () => {
+  let http: TestApp
+
+  async function searchTitles(keywords: string[]): Promise<string[]> {
+    const response = await http.query('/posts/search', { keywords }).assertOk()
+    const body = await response.json<{ data: PostResourceData[] }>()
+
+    return body.data.map((post) => post.title).sort()
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    const author =
+      (await User.newQuery().where('email', FIXTURE_EMAIL).first()) ??
+      (await User.create({ name: 'Search Fixture Author', email: FIXTURE_EMAIL, password: 'secret' }))
+
+    for (const [title, published] of [
+      [PUBLISHED_ZEPHYRQUILL, true],
+      [DRAFT_ZEPHYRQUILL, false],
+      [PUBLISHED_MARMALADE, true],
+      [DRAFT_MARMALADE, false],
+      // Published, but matches no keyword: it must never pad the results.
+      [PUBLISHED_UNRELATED, true],
+      [DRAFT_ONLY_WORD, false],
+    ] as const) {
+      await Post.forceCreate({
+        title,
+        excerpt: published ? 'published fixture' : 'unpublished fixture',
+        body: 'Fixture body.',
+        authorId: author!.id,
+        published,
+      })
+    }
+  })
+
+  afterAll(async () => {
+    for (const title of FIXTURE_TITLES) {
+      await Post.delete({ title })
+    }
+    await User.delete({ email: FIXTURE_EMAIL })
+  })
+
+  it('returns only the published posts matching the keyword', async () => {
+    expect(await searchTitles(['zephyrquill'])).toEqual([PUBLISHED_ZEPHYRQUILL])
+  })
+
+  it('returns only the published posts matching any of several keywords', async () => {
+    expect(await searchTitles(['zephyrquill', 'marmalade'])).toEqual(
+      [PUBLISHED_ZEPHYRQUILL, PUBLISHED_MARMALADE].sort(),
+    )
+  })
+
+  it('returns nothing for a keyword only unpublished posts contain', async () => {
+    expect(await searchTitles(['quillhaven'])).toEqual([])
+    expect(await searchTitles(['quillhaven', 'behind the curtain'])).toEqual([])
+  })
+})
