+import { expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../../app/Models/User.js'
+import { resetDatabase } from '../../config/database.js'
+import app from '../../src/app.js'
+
+export interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+export interface ApiTokenFixture {
+  /** Sends `Accept: application/json`, no session and no token. */
+  http: TestApp
+  alice: UserRecord
+  bob: UserRecord
+}
+
+// The real app on an emptied test database, with two users to tell apart.
+export async function setUpApiTokenFixture(): Promise<ApiTokenFixture> {
+  const http = (await TestApp.fromApp(app)).json()
+  await resetDatabase()
+
+  return {
+    http,
+    alice: await User.create({ name: 'Alice', email: 'alice@example.com', password: 'password-alice' }),
+    bob: await User.create({ name: 'Bob', email: 'bob@example.com', password: 'password-bob' }),
+  }
+}
+
+export async function signedIn(http: TestApp, user: UserRecord): Promise<TestApp> {
+  return http.actingAs(user).withCsrf()
+}
+
+export async function createToken(http: TestApp, user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+  const session = await signedIn(http, user)
+  const response = await session.post('/profile/tokens', { name })
+  expect(response.status).toBe(201)
+  return response.json<CreatedToken>()
+}
+
+// The way a script calls the API: the bearer header and no cookies.
+export function withToken(http: TestApp, token: string): TestApp {
+  return http.withHeader('Authorization', `Bearer ${token}`)
+}
