@@ -0,0 +1,17 @@
+import { z } from 'zod'
+
+export const COMMENT_BODY_MAX_LENGTH = 2000
+
+export const CommentIdParamSchema = z.object({
+  id: z.coerce.number().int().positive(),
+})
+
+export const CommentPayloadSchema = z.object({
+  body: z
+    .string()
+    .trim()
+    .min(1, 'Comment is required.')
+    .max(COMMENT_BODY_MAX_LENGTH, `Comment must be ${COMMENT_BODY_MAX_LENGTH} characters or fewer.`),
+})
+
+export type CommentPayload = z.infer<typeof CommentPayloadSchema>
diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..ce9b2b3
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,69 @@
+import {
+  defineModel,
+  type BelongsToRecord,
+  type HasManyRecord,
+  type TransactionHandle,
+  type WithRelations,
+} from '@guren/core'
+import { comments } from '../../db/schema.js'
+import { CommentReport, type CommentReportRecord } from './CommentReport.js'
+import type { PostRecord } from './Post.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+
+/** Distinct reporters at which a comment stops being listed on its post. */
+export const REPORTS_TO_HIDE = 3
+
+// The adapter's own floor for one IN list (SQLite's bound-variable limit).
+const IN_LIST_SIZE = 500
+
+export class Comment extends defineModel(comments, {
+  // `postId` and `userId` come from the route and the session, never from request input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: {
+    author: BelongsToRecord<CommentAuthorSummary>
+    post: BelongsToRecord<PostRecord>
+    reports: HasManyRecord<CommentReportRecord>
+  } = {
+    author: null,
+    post: null,
+    reports: [],
+  }
+
+  /** A post's comments, oldest first, without the ones reported into hiding. */
+  static async visibleOn(postId: number): Promise<CommentWithAuthor[]> {
+    const listed = (await Comment.where({ postId })
+      .with('author', 'reports')
+      .orderBy('createdAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()) as WithRelations<typeof Comment, 'author' | 'reports'>[]
+
+    // comment_reports is unique on (comment_id, user_id), so rows are distinct reporters.
+    return listed.filter((comment) => comment.reports.length < REPORTS_TO_HIDE)
+  }
+
+  /**
+   * Deletes the matching comments and their reports. Done by hand because a
+   * SQLite connection opens with foreign keys off, so the schema's
+   * ON DELETE CASCADE cannot be relied on.
+   */
+  static async purge(where: { id: number } | { postId: number }, trx: TransactionHandle): Promise<void> {
+    const matched = await Comment.newQuery({ trx }).where(where).select('id').get()
+    const ids = matched.map((comment) => comment.id)
+
+    for (let start = 0; start < ids.length; start += IN_LIST_SIZE) {
+      const chunk = ids.slice(start, start + IN_LIST_SIZE)
+      await CommentReport.newQuery({ trx }).whereIn('commentId', chunk).delete()
+      await Comment.newQuery({ trx }).whereIn('id', chunk).delete()
+    }
+  }
+}
+
+export type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+Comment.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
+Comment.hasMany('reports', CommentReport, 'commentId', 'id')
diff --git a/app/Models/CommentReport.ts b/app/Models/CommentReport.ts
new file mode 100644
index 0000000..aecc9c6
--- /dev/null
+++ b/app/Models/CommentReport.ts
@@ -0,0 +1,27 @@
+import { defineModel } from '@guren/core'
+import { commentReports } from '../../db/schema.js'
+
+export type CommentReportRecord = typeof commentReports.$inferSelect
+
+export class CommentReport extends defineModel(commentReports, {
+  // Both columns come from the route and the session, never from request input.
+  fillable: [],
+}) {
+  /** Records that `userId` reported `commentId`; reporting again changes nothing. */
+  static async record(commentId: number, userId: number): Promise<void> {
+    const report = { commentId, userId }
+    if (await CommentReport.where(report).exists()) {
+      return
+    }
+
+    try {
+      await CommentReport.forceCreate(report)
+    } catch (error) {
+      // Losing a race to the unique index on (comment_id, user_id) means the
+      // same report landed concurrently, which is the outcome wanted.
+      if (!(await CommentReport.where(report).exists())) {
+        throw error
+      }
+    }
+  }
+}
diff --git a/app/Policies/CommentPolicy.ts b/app/Policies/CommentPolicy.ts
new file mode 100644
index 0000000..b8369f9
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,30 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  post: { authorId: number } | null
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * `delete` needs the comment loaded with its `post`: the post's author may
+ * remove any comment under their post.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null, _comment: CommentLike): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    if (user === null) {
+      return false
+    }
+
+    const viewerId = Number(user.id)
+    return viewerId === comment.userId || viewerId === comment.post?.authorId
+  }
+}
