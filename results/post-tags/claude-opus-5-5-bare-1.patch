diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..cebe4e4
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,156 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Feature tests for post tags. They write to the test database (NODE_ENV=test
+// under `bun test`), so each test starts from empty posts/tags tables.
+describe('post tags', () => {
+  let http: TestApp
+  let author: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    user =
+      (await User.first({ email: 'tags-author@example.com' })) ??
+      (await User.create({ name: 'Tag Author', email: 'tags-author@example.com', password: 'secret-password' }))
+    author = await http.actingAs(user).withCsrf()
+  })
+
+  beforeEach(async () => {
+    await PostTag.newQuery().delete()
+    await Post.newQuery().delete()
+    await Tag.newQuery().delete()
+  })
+
+  const payload = (tags?: string) => ({
+    title: 'Tagged post',
+    excerpt: 'An excerpt.',
+    body: 'A body.',
+    ...(tags === undefined ? {} : { tags }),
+  })
+
+  async function createPost(tags?: string): Promise<number> {
+    const response = await author.post('/posts', payload(tags))
+    const location = response.headers.get('location') ?? ''
+    expect(location).toMatch(/\/posts\/\d+$/)
+    return Number(location.split('/').pop())
+  }
+
+  async function props(path: string): Promise<Record<string, unknown>> {
+    const response = await http.get(path).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    return payload.props as Record<string, unknown>
+  }
+
+  async function tagsOf(postId: number): Promise<string[]> {
+    const { post } = (await props(`/posts/${postId}`)) as { post: PostResourceData }
+    return post.tags
+  }
+
+  async function titleStatus(): Promise<number> {
+    return (await author.post('/posts', { ...payload(), title: '' })).status
+  }
+
+  it('creates tags and attaches them to a new post', async () => {
+    const id = await createPost('webdev, bun')
+
+    expect((await Tag.all()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(2)
+    expect(await tagsOf(id)).toEqual(['bun', 'webdev'])
+  })
+
+  it('detaches tags removed on edit', async () => {
+    const id = await createPost('bun, webdev')
+
+    const response = await author.put(`/posts/${id}`, payload('bun'))
+    expect(response.status).toBe(303)
+
+    expect(await tagsOf(id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('treats a missing or empty field as no tags', async () => {
+    const id = await createPost()
+    expect(await tagsOf(id)).toEqual([])
+
+    await author.put(`/posts/${id}`, payload('bun'))
+    await author.put(`/posts/${id}`, payload(''))
+    expect(await tagsOf(id)).toEqual([])
+  })
+
+  it('filters the list by tag and keeps tags on every post', async () => {
+    const bun = await createPost('bun')
+    const plain = await createPost()
+    await Tag.create({ name: 'unused' })
+
+    const filtered = (await props('/posts?tag=bun')) as { data: PostResourceData[] }
+    expect(filtered.data.map((post) => post.id)).toEqual([bun])
+
+    const empty = (await props('/posts?tag=unused')) as { data: PostResourceData[] }
+    expect(empty.data).toEqual([])
+
+    const unknown = (await props('/posts?tag=nobody')) as { data: PostResourceData[] }
+    expect(unknown.data).toEqual([])
+
+    const all = (await props('/posts')) as { data: PostResourceData[] }
+    expect(all.data.map((post) => [post.id, post.tags])).toEqual([
+      [plain, []],
+      [bun, ['bun']],
+    ])
+  })
+
+  it('keeps the filter in page links', async () => {
+    for (let i = 0; i < 11; i++) {
+      await createPost('bun')
+    }
+    const { pagination } = (await props('/posts?tag=bun')) as {
+      pagination: { links: { pages: { page: number; url: string | null }[] } }
+    }
+    const second = pagination.links.pages.find((page) => page.page === 2)
+    expect(second?.url).toContain('tag=bun')
+  })
+
+  it('refuses more than five tags like an empty title', async () => {
+    const response = await author.post('/posts', payload('a, b, c, d, e, f'))
+
+    expect(response.status).toBe(await titleStatus())
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+
+  it('refuses a name over 30 characters and accepts 30', async () => {
+    const response = await author.post('/posts', payload('x'.repeat(31)))
+    expect(response.status).toBe(await titleStatus())
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+
+    const id = await createPost('y'.repeat(30))
+    expect(await tagsOf(id)).toEqual(['y'.repeat(30)])
+  })
+
+  it('trims, ignores empty entries and dedupes', async () => {
+    const id = await createPost(' bun ,bun,, ')
+
+    expect((await Tag.all()).map((tag) => tag.name)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+    expect(await tagsOf(id)).toEqual(['bun'])
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun')
+
+    const response = await author.delete(`/posts/${id}`)
+    expect(response.status).toBe(303)
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.where({ postId: id }).count()).toBe(0)
+  })
+})
