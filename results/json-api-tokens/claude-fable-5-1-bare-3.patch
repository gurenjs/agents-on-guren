+import { beforeAll, describe, expect, it } from 'bun:test'
+import { defineModel } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Raw rows, to assert what the table stores without going through the store.
+const ApiTokenRow = defineModel(apiTokens, {})
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+async function createUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: `Token ${label}`,
+    email: `token-${label}-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+    password: 'secret123',
+  })
+  if (!user) throw new Error('user not created')
+  return user as UserRecord
+}
+
+describe('profile API tokens', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await createUser('owner')
+  })
+
+  async function sessionFor(who: UserRecord) {
+    return http.actingAs(who).withCsrf('/profile')
+  }
+
+  it('creates a named token, shows it once, and stores only a hash', async () => {
+    const session = await sessionFor(user)
+    const response = await session.json().post('/profile/tokens', { name: 'CI' })
+    expect(response.status).toBe(201)
+
+    const created = (await response.json()) as CreatedToken
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    const secret = created.token.split('|').pop() ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiTokenRow.where({ id: created.id })
+    expect(rows).toHaveLength(1)
+    const row = rows[0] as Record<string, unknown>
+    expect(row.userId).toBe(user.id)
+    expect(row.name).toBe('CI')
+    for (const value of Object.values(row)) {
+      const text = typeof value === 'string' ? value : JSON.stringify(value ?? '')
+      expect(text).not.toContain(secret)
+      expect(text).not.toBe(created.token)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name with 422', async () => {
+    const session = await sessionFor(user)
+    const before = (await ApiTokenRow.all()).length
+
+    await session.json().post('/profile/tokens', {}).assertStatus(422)
+    await session.json().post('/profile/tokens', { name: '' }).assertStatus(422)
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+
+    expect((await ApiTokenRow.all()).length).toBe(before)
+  })
+
+  it('gives a guest no token', async () => {
+    const response = await http.json().post('/profile/tokens', { name: 'guest' })
+    expect([302, 303, 401, 403]).toContain(response.status)
+  })
+
+  it('lists the tokens by name on the profile page', async () => {
+    const session = await sessionFor(user)
+    await session.json().post('/profile/tokens', { name: 'old laptop' }).assertStatus(201)
+
+    const page = await session.withHeader('X-Inertia', 'true').get('/profile')
+    expect(page.status).toBe(200)
+    const payload = (await page.json()) as { props: { tokens: Array<{ id: string; name: string }> } }
+    expect(payload.props.tokens.map((token) => token.name)).toContain('old laptop')
+  })
+
+  it('revokes own tokens with 204 and the token stops working', async () => {
+    const session = await sessionFor(user)
+    const created = (await (await session.json().post('/profile/tokens', { name: 'to revoke' })).json()) as CreatedToken
+    const kept = (await (await session.json().post('/profile/tokens', { name: 'kept' })).json()) as CreatedToken
+
+    await http.json().withHeader('Authorization', `Bearer ${created.token}`).get('/api/posts').assertStatus(200)
+
+    await session.json().delete(`/profile/tokens/${created.id}`).assertStatus(204)
+    expect(await ApiTokenRow.where({ id: created.id })).toHaveLength(0)
+
+    await http.json().withHeader('Authorization', `Bearer ${created.token}`).get('/api/posts').assertStatus(401)
+    await http.json().withHeader('Authorization', `Bearer ${kept.token}`).get('/api/posts').assertStatus(200)
+  })
+
+  it("answers 404 for another user's token and keeps it working", async () => {
+    const other = await createUser('other')
+    const otherSession = await sessionFor(other)
+    const theirs = (await (await otherSession.json().post('/profile/tokens', { name: 'theirs' })).json()) as CreatedToken
+
+    const session = await sessionFor(user)
+    await session.json().delete(`/profile/tokens/${theirs.id}`).assertStatus(404)
+    await session.json().delete('/profile/tokens/does-not-exist').assertStatus(404)
+
+    expect(await ApiTokenRow.where({ id: theirs.id })).toHaveLength(1)
+    await http.json().withHeader('Authorization', `Bearer ${theirs.token}`).get('/api/posts').assertStatus(200)
+  })
+})
