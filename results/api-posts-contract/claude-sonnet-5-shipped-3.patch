+  // Serves the public, unauthenticated `api.posts.index` route consumed by
+  // partner integrations — newest-first, paginated, optionally narrowed to
+  // one author. No session/CSRF, and never touches `body`/policy state.
+  //
+  // `withPaginate()` rather than `.with('author').paginate()`: the query
+  // builder's `paginate()` terminates with the raw query executor, not
+  // `get()`, so a `.with(...)` chained onto it is silently dropped and the
+  // resource's `author` field would come back empty.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+
+    const result = await Post.withPaginate('author', {
+      page,
+      perPage: 10,
+      where: author !== undefined ? { authorId: author } : undefined,
+      orderBy: ['id', 'desc'],
+    })
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: paginate(result).meta(),
+    })
+  }
+
