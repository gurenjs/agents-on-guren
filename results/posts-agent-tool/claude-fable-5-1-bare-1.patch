+import { User } from '../app/Models/User.js'
+
+// The production MCP endpoint (@guren/plugin-mcp, mounted in src/app.ts) serves
+// the routes that declare .agent() in routes/web.ts. These tests speak to it the
+// way an assistant does: JSON-RPC over streamable HTTP with a bearer token that
+// belongs to a user, so every tool call acts as that user.
+
+interface JsonRpcResponse {
+  jsonrpc: '2.0'
+  id: number
+  result?: Record<string, unknown>
+  error?: { code: number; message: string }
+}
+
+interface ToolCallResult {
+  content: Array<{ type: string; text?: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+interface ListedTool {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+// Streamable HTTP answers either with JSON or with an SSE stream whose last
+// `data:` line carries the JSON-RPC response; both spellings are accepted here.
+async function readJsonRpc(response: Response): Promise<JsonRpcResponse> {
+  const text = await response.text()
+  const contentType = response.headers.get('content-type') ?? ''
+  if (contentType.includes('text/event-stream')) {
+    const data = text
+      .split('\n')
+      .filter((line) => line.startsWith('data:'))
+      .map((line) => line.slice('data:'.length).trim())
+    return JSON.parse(data[data.length - 1] ?? '{}') as JsonRpcResponse
+  }
+  return JSON.parse(text) as JsonRpcResponse
+}
+
+function toolResultJson(result: ToolCallResult): unknown {
+  if (result.structuredContent) return result.structuredContent
+  const text = result.content.find((entry) => entry.type === 'text')?.text ?? ''
+  return JSON.parse(text)
+}
+
+describe('MCP endpoint', () => {
+  let http: TestApp
+  let bearer: string
+  let author: { id: number }
+  let rpcId = 0
+  const stamp = Date.now()
+
+  // `token: null` sends no Authorization header at all.
+  async function rpc(method: string, params: Record<string, unknown> = {}, token: string | null = bearer) {
+    let client = http
+      .json()
+      .withHeader('Accept', 'application/json, text/event-stream')
+    if (token !== null) client = client.withHeader('Authorization', `Bearer ${token}`)
+    const response = await client.post('/mcp', { jsonrpc: '2.0', id: ++rpcId, method, params })
+    return { status: response.status, body: await readJsonRpc(response.raw) }
+  }
+
+  async function callTool(name: string, args: Record<string, unknown>): Promise<ToolCallResult> {
+    const { status, body } = await rpc('tools/call', { name, arguments: args })
+    expect(status).toBe(200)
+    expect(body.error).toBeUndefined()
+    return body.result as unknown as ToolCallResult
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({
+      name: 'MCP Author',
+      email: `mcp-author-${stamp}@example.com`,
+      password: 'correct-horse-battery-staple',
+    })) as { id: number }
+
+    // The same store AuthProvider configured, so the token is verified exactly
+    // as one `bunx guren token:issue` would be.
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('AuthProvider did not configure an API token store')
+    const issued = await createApiToken(store, {
+      name: 'test assistant',
+      userId: author.id,
+      abilities: ['tools:*'],
+    })
+    bearer = issued.plainTextToken
+  })
+
+  it('refuses a call without a bearer credential', async () => {
+    const { status } = await rpc('tools/list', {}, null)
+    expect(status).toBe(401)
+  })
+
+  it('lists posts_search as read-only and posts_store as not', async () => {
+    const { status, body } = await rpc('tools/list')
+    expect(status).toBe(200)
+    const tools = ((body.result?.tools ?? []) as ListedTool[]).filter((tool) => !tool.name.startsWith('guren_'))
+    const byName = Object.fromEntries(tools.map((tool) => [tool.name, tool.annotations?.readOnlyHint]))
+    expect(byName).toEqual({ posts_search: true, posts_store: false })
+  })
+
+  it('answers posts_search with what QUERY /posts/search answers', async () => {
+    const keyword = `needle-${stamp}`
+    await Post.forceCreate({
+      title: `Searchable ${keyword}`,
+      excerpt: 'Found through MCP.',
+      body: 'Body text.',
+      authorId: author.id,
+    })
+
+    const input = { keywords: [keyword], limit: 5 }
+    const expected = await (await http.query('/posts/search', input)).json()
+    const result = await callTool('posts_search', input)
+
+    expect(result.isError ?? false).toBe(false)
+    expect(toolResultJson(result)).toEqual(expected)
+    expect((expected as { data: unknown[] }).data).toHaveLength(1)
+  })
+
+  it('creates a post for the credential user, ignoring any authorId sent', async () => {
+    const title = `Drafted over MCP ${stamp}`
+    const result = await callTool('posts_store', {
+      title,
+      excerpt: 'Written by an assistant.',
+      body: 'The assistant drafted this.',
+      authorId: author.id + 1000,
+    })
+    expect(result.isError ?? false).toBe(false)
+
+    const post = await Post.newQuery().where('title', title).first()
+    expect(post?.authorId).toBe(author.id)
+  })
+
+  it('rejects input the web form rejects with 422 and creates nothing', async () => {
+    const excerpt = `Rejected over MCP ${stamp}`
+    const input = { title: '', excerpt, body: 'Body.' }
+
+    // Over MCP the result is flagged as an error and carries the same
+    // validation payload the web form's JSON callers get.
+    const result = await callTool('posts_store', input)
+    expect(result.isError).toBe(true)
+    expect(toolResultJson(result)).toMatchObject({ errors: { title: ['Title is required.'] } })
+
+    // The framework's own dispatch (what `guren tool:call` and the MCP
+    // preflight report) sees the route's 422. `as` signs in through the
+    // session, so the call needs the CSRF token a browser form would carry.
+    const session = await http.withCsrf('/posts')
+    await session.agent().call('posts_store', input, { as: author }).assertStatus(422)
+
+    expect(await Post.newQuery().where('excerpt', excerpt).first()).toBeNull()
+  })
+
+  it('refuses posts_store for a guest through the framework dispatch', async () => {
+    const excerpt = `Guest over MCP ${stamp}`
+    const result = await http.agent().call('posts_store', { title: 'Guest post', excerpt, body: 'Body.' })
+
+    expect([302, 303, 401, 403]).toContain(result.status)
+    expect(await Post.newQuery().where('excerpt', excerpt).first()).toBeNull()
+  })
+
+  it('exposes the same two tools to the framework tooling', async () => {
+    const tools = await http.agent().tools()
+    const byName = Object.fromEntries(tools.map((tool) => [tool.toolName, tool.annotations.readOnlyHint]))
+    expect(byName).toEqual({ posts_search: true, posts_store: false })
+  })
+})
