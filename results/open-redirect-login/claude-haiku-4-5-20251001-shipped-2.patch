diff --git a/app/Utils/SafeRedirect.ts b/app/Utils/SafeRedirect.ts
new file mode 100644
index 0000000..aec3760
--- /dev/null
+++ b/app/Utils/SafeRedirect.ts
@@ -0,0 +1,32 @@
+/**
+ * Validates that a redirect URL is safe — only same-origin, same-app paths.
+ * Rejects absolute URLs, protocol-relative URLs, and backslash variants.
+ */
+export function isSafeRedirect(url: string): boolean {
+  // Empty or whitespace — use default
+  if (!url || !url.trim()) {
+    return false
+  }
+
+  // Protocol-relative URL (//example.com)
+  if (url.startsWith('//')) {
+    return false
+  }
+
+  // Absolute URL with scheme (https://example.com)
+  if (url.includes('://')) {
+    return false
+  }
+
+  // Backslash characters (both leading and inside)
+  if (url.includes('\\')) {
+    return false
+  }
+
+  // Must start with / for a same-app path
+  if (!url.startsWith('/')) {
+    return false
+  }
+
+  return true
+}
diff --git a/tests/LoginController.test.ts b/tests/LoginController.test.ts
