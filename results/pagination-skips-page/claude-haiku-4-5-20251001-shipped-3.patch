+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,88 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('PostController.index pagination', () => {
+  let http: TestApp
+  let user: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  it('page 1 shows the newest posts, not the 11th', async () => {
+    // Create 25 posts
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: user.id,
+      })
+    }
+
+    const res = await http.get('/posts').assertOk()
+    const body = await res.text()
+
+    // Page 1 should show the newest posts (25-16), not posts 16-6
+    if (!body.includes('Post 25')) throw new Error('Post 25 (newest) should be on page 1')
+    if (!body.includes('Post 16')) throw new Error('Post 16 should be on page 1')
+    // But should not show posts 15-6 (those are on page 2)
+    if (body.includes('Post 15')) throw new Error('Post 15 should NOT be on page 1 (should be on page 2)')
+  })
+
+  it('page 2 shows posts 15-6', async () => {
+    // Create 25 posts
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: user.id,
+      })
+    }
+
+    const res = await http.get('/posts?page=2').assertOk()
+    const body = await res.text()
+
+    // Page 2 should show posts 15-6
+    if (!body.includes('Post 15')) throw new Error('Post 15 should be on page 2')
+    if (!body.includes('Post 6')) throw new Error('Post 6 should be on page 2')
+    // But should not show posts 25-16 (those are on page 1)
+    if (body.includes('Post 25')) throw new Error('Post 25 should NOT be on page 2 (should be on page 1)')
+    if (body.includes('Post 16')) throw new Error('Post 16 should NOT be on page 2 (should be on page 1)')
+    // And should not show posts 5-1 (those are on page 3)
+    if (body.includes('Post 5')) throw new Error('Post 5 should NOT be on page 2 (should be on page 3)')
+  })
+
+  it('page 3 shows posts 5-1', async () => {
+    // Create 25 posts
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: user.id,
+      })
+    }
+
+    const res = await http.get('/posts?page=3').assertOk()
+    const body = await res.text()
+
+    // Page 3 should show posts 5-1
+    if (!body.includes('Post 5')) throw new Error('Post 5 should be on page 3')
+    if (!body.includes('Post 1')) throw new Error('Post 1 should be on page 3')
+    // But should not show posts 15-6 (those are on page 2)
+    if (body.includes('Post 15')) throw new Error('Post 15 should NOT be on page 3 (should be on page 2)')
+    if (body.includes('Post 6')) throw new Error('Post 6 should NOT be on page 3 (should be on page 2)')
+  })
+})
