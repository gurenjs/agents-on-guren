diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..ff701f2
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,30 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+// Seconds. Browsers cap cookie lifetimes at about 400 days.
+const ONE_YEAR = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+    const secure = new URL(this.request.url).protocol === 'https:' ? '; Secure' : ''
+
+    // `locale` is the cookie the framework's locale detection reads, ahead of
+    // Accept-Language. The value is one of the schema's literals, so it needs
+    // no encoding.
+    return this.redirect(this.previousUrl(), {
+      headers: {
+        'Set-Cookie': `locale=${locale}; Path=/; Max-Age=${ONE_YEAR}; HttpOnly; SameSite=Lax${secure}`,
+      },
+    })
+  }
+
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) return '/'
+
+    // Allowing the request's own host keeps a Referer usable behind a
+    // TLS-terminating proxy, where it is https and the request URL is http.
+    const { host } = new URL(this.request.url)
+    return isSafeRedirectUrl(referer, this.request.url, [host]) ? referer : '/'
+  }
+}
