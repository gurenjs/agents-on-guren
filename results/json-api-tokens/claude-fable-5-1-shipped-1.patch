diff --git a/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts b/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts
new file mode 100644
index 0000000..4dd4b4f
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts
@@ -0,0 +1,12 @@
+import { createBearerTokenMiddleware } from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import { User } from '../../Models/User.js'
+
+// Mounted on the /api routes only, and deliberately not `auth.useTokens()`:
+// that would let a bearer token act on every session route too (edit the
+// profile, mint more tokens), far beyond what a script's token is for.
+export const AuthenticateApiTokenMiddleware = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(userId),
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
diff --git a/app/Http/Middleware/ThrottleApiTokenMiddleware.ts b/app/Http/Middleware/ThrottleApiTokenMiddleware.ts
new file mode 100644
index 0000000..fb55d7a
--- /dev/null
+++ b/app/Http/Middleware/ThrottleApiTokenMiddleware.ts
@@ -0,0 +1,19 @@
+import { MemoryRateLimitStore, createRateLimitMiddleware, getApiTokenOrFail } from '@guren/core'
+
+export const API_TOKEN_RATE_LIMIT = 60
+
+// Counters live in this process: several server processes would each allow
+// the limit. Swap in a shared RateLimitStore before running more than one.
+const store = new MemoryRateLimitStore()
+
+// Runs after AuthenticateApiTokenMiddleware, which puts the verified token on
+// the context. Keyed by token id, so each token of a user has its own budget.
+export const ThrottleApiTokenMiddleware = createRateLimitMiddleware({
+  limit: API_TOKEN_RATE_LIMIT,
+  windowMs: 60_000,
+  store,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests, please try again later.', retryAfter }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
new file mode 100644
index 0000000..b8f0193
--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,24 @@
+import { Resource } from '@guren/core'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// Never carries `hashedToken`: the page lists tokens by name, and the hash is
+// what a bearer token is verified against.
+export class ApiTokenResource extends Resource<ApiTokenRecord, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: token.createdAt.toISOString(),
+      lastUsedAt: token.lastUsedAt?.toISOString() ?? null,
+    }
+  }
+}
diff --git a/app/Http/Resources/IssuedApiTokenResource.ts b/app/Http/Resources/IssuedApiTokenResource.ts
new file mode 100644
index 0000000..3f5a66e
--- /dev/null
+++ b/app/Http/Resources/IssuedApiTokenResource.ts
@@ -0,0 +1,21 @@
+import { Resource, type CreateApiTokenResult } from '@guren/core'
+
+export interface IssuedApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  // The bearer credential in plain text. Only the response that creates a
+  // token can carry it; the table holds a hash.
+  token: string
+}
+
+export class IssuedApiTokenResource extends Resource<CreateApiTokenResult, IssuedApiTokenResourceData> {
+  toArray(): IssuedApiTokenResourceData {
+    const { token, plainTextToken } = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      token: plainTextToken,
+    }
+  }
+}
