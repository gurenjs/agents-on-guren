+import { getDatabase } from '../config/database.js'
+
+// `getDatabase()` is typed `Promise<unknown>` at the `createSqliteDatabase()`
+// boundary; `run()` is the one method every Drizzle SQL driver exposes for a
+// raw query, so that's all this adapter assumes about the concrete instance.
+interface RunnableDatabase {
+  run(query: string): unknown
+}
+
+const databaseConnection: DatabaseConnection = {
+  async query(sql) {
+    const db = (await getDatabase()) as RunnableDatabase
+    return db.run(sql)
+  },
+}
+
+// `critical: true` — without it a failing DB check only degrades the overall
+// report (still HTTP 200 from HealthManager's status mapping); ops needs a
+// 503 so the load balancer actually drains traffic from a bad deploy.
+const healthManager = new HealthManager().register(new DatabaseCheck(databaseConnection), { critical: true })
 
 export function registerWebRoutes(baseRouter: Router): void {
