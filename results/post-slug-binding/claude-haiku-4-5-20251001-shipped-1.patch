diff --git a/app/Models/Post.ts b/app/Models/Post.ts
index 4c4a643..ee9ca14 100644
--- a/app/Models/Post.ts
+++ b/app/Models/Post.ts
@@ -7,12 +7,34 @@ export type NewPostRecord = typeof posts.$inferInsert
 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
 export class Post extends defineModel(posts) {
-  // `authorId` is set from the signed-in user, never from request input.
+  // `authorId` and `slug` are set server-side, never from request input.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  static generateSlug(title: string): string {
+    return title
+      .trim()
+      .toLowerCase()
+      .replace(/[^\w\s-]/g, '')
+      .replace(/\s+/g, '-')
+      .replace(/-+/g, '-')
+      .replace(/^-+|-+$/g, '')
+  }
+
+  static async findUniqueSlug(baseSlug: string): Promise<string> {
+    let slug = baseSlug
+    let counter = 2
+
+    while (await Post.first({ slug })) {
+      slug = `${baseSlug}-${counter}`
+      counter++
+    }
+
+    return slug
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
