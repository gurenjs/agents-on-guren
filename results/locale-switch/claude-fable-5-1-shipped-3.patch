new file mode 100644
index 0000000..5399909
--- /dev/null
+++ b/resources/js/components/LocaleSwitcher.tsx
@@ -0,0 +1,39 @@
+import { Link } from '@inertiajs/react'
+import { useTranslation } from '@guren/inertia-client'
+import { route } from '@/.guren/routes.gen'
+
+// Mirrors SUPPORTED_LOCALES in app/Http/Validators/LocaleValidator.ts.
+const LOCALES = ['en', 'ja'] as const
+
+export default function LocaleSwitcher() {
+  const { t, locale: current } = useTranslation()
+
+  return (
+    <div className="flex items-center gap-1" role="group" aria-label={t('locale.label')}>
+      {LOCALES.map((locale) => {
+        const active = locale === current
+        return (
+          // Inertia posts through Axios with the XSRF-TOKEN header, so the pick
+          // passes CSRF; the server redirects back to the Referer.
+          <Link
+            key={locale}
+            href={route('locale.store')}
+            method="post"
+            as="button"
+            data={{ locale }}
+            aria-pressed={active}
+            aria-label={t(`locale.${locale}`)}
+            lang={locale}
+            className={
+              active
+                ? 'rounded-g-ctl bg-g-ink px-2 py-1 font-mono text-xs uppercase text-g-on-ink'
+                : 'rounded-g-ctl px-2 py-1 font-mono text-xs uppercase text-g-muted transition hover:text-g-heading'
+            }
+          >
+            {locale}
+          </Link>
+        )
+      })}
+    </div>
+  )
+}
