+import { Controller } from '@guren/core'
+import { buildToolRequest, mapToolResponse } from '@guren/server/agent'
+import { deriveAgentTools, type DerivedAgentTool } from '@guren/server'
+import type { UserRecord } from '../../Models/User.js'
+
+interface JsonRpcRequest {
+  jsonrpc: '2.0'
+  id: string | number | null
+  method: string
+  params?: Record<string, unknown>
+}
+
+interface JsonRpcResponse {
+  jsonrpc: '2.0'
+  id: string | number | null
+  result?: unknown
+  error?: {
+    code: number
+    message: string
+    data?: unknown
+  }
+}
+
+export default class McpController extends Controller {
+  async handle(): Promise<Response> {
+    const authHeader = this.request.header('authorization')
+
+    if (!authHeader) {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32600, message: 'Unauthorized' } }, { status: 401 })
+    }
+
+    let user: UserRecord | null = null
+    try {
+      const guard = this.auth.guard('token')
+      user = await guard.user<UserRecord>()
+    } catch {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32600, message: 'Invalid token' } }, { status: 401 })
+    }
+
+    if (!user) {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32600, message: 'Unauthorized' } }, { status: 401 })
+    }
+
+    let body: JsonRpcRequest
+    try {
+      body = (await this.request.json()) as JsonRpcRequest
+    } catch {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Parse error' } }, { status: 400 })
+    }
+
+    const { jsonrpc, id, method, params } = body
+
+    try {
+      if (method === 'tools/list') {
+        const result = await this.listTools()
+        return this.json({ jsonrpc, id, result } as JsonRpcResponse)
+      } else if (method === 'tools/call') {
+        const result = await this.callTool(params as any)
+        return this.json({ jsonrpc, id, result } as JsonRpcResponse)
+      } else {
+        return this.json({ jsonrpc, id, error: { code: -32601, message: 'Method not found' } } as JsonRpcResponse, { status: 400 })
+      }
+    } catch (error) {
+      console.error('MCP error:', error)
+      return this.json({
+        jsonrpc,
+        id,
+        error: { code: -32603, message: 'Internal error', data: (error as any)?.message },
+      } as JsonRpcResponse, { status: 500 })
+    }
+  }
+
+  private async listTools(): Promise<{ tools: Array<{ name: string; description: string; inputSchema: any; annotations: any }> }> {
+    const container = this.ctx.get('container') as any
+    const app = container.make('app') as any
+    const definitions = app.router.definitions()
+
+    const { tools } = deriveAgentTools(definitions)
+
+    return {
+      tools: tools.map((tool) => ({
+        name: tool.toolName,
+        description: tool.description || '',
+        inputSchema: tool.inputSchema,
+        annotations: {
+          readOnly: tool.annotations.readOnlyHint,
+          isDestructive: tool.annotations.destructiveHint,
+          isIdempotent: tool.annotations.idempotentHint,
+        },
+      })),
+    }
+  }
+
+  private async callTool(params: { name: string; arguments: Record<string, unknown> }): Promise<any> {
+    const container = this.ctx.get('container') as any
+    const app = container.make('app') as any
+    const definitions = app.router.definitions()
+
+    const { tools } = deriveAgentTools(definitions)
+    const tool = tools.find((t) => t.toolName === params.name)
+
+    if (!tool) {
+      return {
+        content: [{ type: 'text', text: `Tool not found: ${params.name}` }],
+        isError: true,
+      }
+    }
+
+    const authHeader = this.request.header('authorization') || ''
+    const builtRequest = buildToolRequest(tool, params.arguments || {}, {
+      authorization: authHeader,
+      surface: 'mcp',
+    })
+
+    if ('missing' in builtRequest || 'invalidPath' in builtRequest) {
+      return {
+        content: [{ type: 'text', text: `Invalid tool call: ${JSON.stringify(builtRequest)}` }],
+        isError: true,
+      }
+    }
+
+    const response = await app.fetch(builtRequest.request)
+    const outcome = await mapToolResponse(tool, response)
+
+    return {
+      content: outcome.content,
+      isError: outcome.isError || false,
+      structuredContent: outcome.structuredContent,
+    }
+  }
+}
