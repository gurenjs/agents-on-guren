-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +24,85 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.archive is the one route with a multi-segment parameter: `:date{.+}`
+// captures both "1999" and "1999/03". Years far outside anything the seeders
+// write keep these assertions exact even though the test database persists
+// between runs.
+describe('posts.archive', () => {
+  let http: TestApp
+  const AUTHOR_EMAIL = 'archivist@example.com'
+  // created_at is stored as an ISO 8601 string and compared as stored (UTC).
+  const FIXTURES = [
+    { title: 'Archive: March 1999', at: '1999-03-04T09:00:00.000Z' },
+    { title: 'Archive: March 1999, later', at: '1999-03-28T23:30:00.000Z' },
+    { title: 'Archive: November 1999', at: '1999-11-02T12:00:00.000Z' },
+    { title: 'Archive: January 2000', at: '2000-01-01T00:00:00.000Z' },
+  ]
+
+  async function titles(path: string): Promise<string[]> {
+    const response = await http.get(path).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+    return data.map((post) => post.title)
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    const author =
+      (await User.first({ email: AUTHOR_EMAIL })) ??
+      (await User.create({ name: 'Archivist', email: AUTHOR_EMAIL, password: 'secret' }))
+
+    // The file-backed test database survives `bun test`, so start from a known
+    // set rather than appending a duplicate one on every run.
+    await Post.delete({ authorId: author.id })
+    for (const fixture of FIXTURES) {
+      // forceCreate, because createdAt is not fillable — see PostController.store.
+      await Post.forceCreate({
+        title: fixture.title,
+        excerpt: 'An archived post.',
+        body: 'Written for the archive tests.',
+        authorId: author.id,
+        createdAt: fixture.at,
+      })
+    }
+  })
+
+  it('lists a month, newest first', async () => {
+    expect(await titles('/posts/archive/1999/03')).toEqual([
+      'Archive: March 1999, later',
+      'Archive: March 1999',
+    ])
+  })
+
+  it('accepts a month without its leading zero', async () => {
+    expect(await titles('/posts/archive/1999/3')).toEqual([
+      'Archive: March 1999, later',
+      'Archive: March 1999',
+    ])
+  })
+
+  it('lists a whole year, newest first', async () => {
+    expect(await titles('/posts/archive/1999')).toEqual([
+      'Archive: November 1999',
+      'Archive: March 1999, later',
+      'Archive: March 1999',
+    ])
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    expect(await titles('/posts/archive/1998')).toEqual([])
+    expect(await titles('/posts/archive/1999/07')).toEqual([])
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/1999/13').assertStatus(422)
+    await http.get('/posts/archive/1999/00').assertStatus(422)
+  })
+
+  it('rejects a date that is not a year or a year and month', async () => {
+    await http.get('/posts/archive/99').assertStatus(422)
+    await http.get('/posts/archive/1999/03/04').assertStatus(422)
+  })
+})
