diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..5bf2201
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,235 @@
+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+
+describe('CommentController', () => {
+  let http: TestApp
+  let user1: any
+  let user2: any
+  let user3: any
+  let user4: any
+  let post1: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user1 = await User.create({ name: 'User 1', email: `user1+${Date.now()}@test.com`, password: 'password' })
+    user2 = await User.create({ name: 'User 2', email: `user2+${Date.now()}@test.com`, password: 'password' })
+    user3 = await User.create({ name: 'User 3', email: `user3+${Date.now()}@test.com`, password: 'password' })
+    user4 = await User.create({ name: 'User 4', email: `user4+${Date.now()}@test.com`, password: 'password' })
+    post1 = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: user1.id,
+    })
+  })
+
+  describe('store', () => {
+    test('guest cannot create a comment', async () => {
+      const res = await http.post(`/posts/${post1.id}/comments`, { body: 'Comment' })
+      expect([401, 403]).toContain(res.status)
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('authenticated user can create a comment', async () => {
+      const csrf = await http.actingAs(user2).withCsrf()
+      await csrf.post(`/posts/${post1.id}/comments`, { body: 'My comment' }).assertRedirect(`/posts/${post1.id}`)
+
+      const comments = await Comment.where('postId', post1.id).get()
+      expect(comments).toHaveLength(1)
+      expect(comments[0]?.body).toBe('My comment')
+      expect(comments[0]?.userId).toBe(user2.id)
+    })
+
+    test('comment body is required', async () => {
+      const csrf = await http.actingAs(user2).withCsrf()
+      await csrf.post(`/posts/${post1.id}/comments`, { body: '' }).assertUnprocessable()
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('comment body must be at most 2000 characters', async () => {
+      const longBody = 'a'.repeat(2001)
+      const csrf = await http.actingAs(user2).withCsrf()
+      await csrf.post(`/posts/${post1.id}/comments`, { body: longBody }).assertUnprocessable()
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('comment body can be up to 2000 characters', async () => {
+      const body = 'a'.repeat(2000)
+      const csrf = await http.actingAs(user2).withCsrf()
+      await csrf.post(`/posts/${post1.id}/comments`, { body }).assertRedirect()
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(1)
+      expect(comments[0]?.body).toHaveLength(2000)
+    })
+  })
+
+  describe('destroy', () => {
+    let comment: any
+
+    beforeEach(async () => {
+      comment = await Comment.create({ postId: post1.id, userId: user2.id, body: 'Test comment' })
+    })
+
+    test('guest cannot delete a comment', async () => {
+      const res = await http.delete(`/comments/${comment.id}`)
+      expect([401, 403]).toContain(res.status)
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(1)
+    })
+
+    test('comment author can delete', async () => {
+      const csrf = await http.actingAs(user2).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post1.id}`)
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('post author can delete', async () => {
+      const csrf = await http.actingAs(user1).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post1.id}`)
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('other users cannot delete (403)', async () => {
+      const csrf = await http.actingAs(user3).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertForbidden()
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(1)
+    })
+  })
+
+  describe('report', () => {
+    let comment: any
+
+    beforeEach(async () => {
+      comment = await Comment.create({ postId: post1.id, userId: user2.id, body: 'Test comment' })
+    })
+
+    test('guest cannot report a comment', async () => {
+      const res = await http.post(`/comments/${comment.id}/report`)
+      expect([401, 403]).toContain(res.status)
+
+      const reports = await CommentReport.all()
+      expect(reports).toHaveLength(0)
+    })
+
+    test('authenticated user can report a comment', async () => {
+      const csrf = await http.actingAs(user3).withCsrf()
+      const res = await csrf.post(`/comments/${comment.id}/report`)
+      expect(res.status).toBe(204)
+
+      const reports = await CommentReport.where('commentId', comment.id).get()
+      expect(reports).toHaveLength(1)
+      expect(reports[0]?.userId).toBe(user3.id)
+    })
+
+    test('second report by same user still counts as one', async () => {
+      const csrf = await http.actingAs(user3).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`)
+      await csrf.post(`/comments/${comment.id}/report`)
+
+      const reports = await CommentReport.where('commentId', comment.id).get()
+      expect(reports).toHaveLength(1)
+    })
+
+    test('returns 204 on repeated report', async () => {
+      const csrf = await http.actingAs(user3).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`)
+      const res = await csrf.post(`/comments/${comment.id}/report`)
+      expect(res.status).toBe(204)
+    })
+  })
+
+  describe('post show page', () => {
+    test('shows comments on post', async () => {
+      await Comment.create({ postId: post1.id, userId: user2.id, body: 'First comment' })
+      await Comment.create({ postId: post1.id, userId: user3.id, body: 'Second comment' })
+
+      const res = await http.get(`/posts/${post1.id}`)
+      expect(res.status).toBe(200)
+      // Note: Full Inertia response assertions depend on the page component working correctly
+    })
+
+    test('hides comments with 3+ reports', async () => {
+      const comment = await Comment.create({ postId: post1.id, userId: user2.id, body: 'Bad comment' })
+
+      await CommentReport.create({ commentId: comment.id, userId: user3.id })
+      await CommentReport.create({ commentId: comment.id, userId: user4.id })
+      await CommentReport.create({ commentId: comment.id, userId: user1.id })
+
+      const res = await http.get(`/posts/${post1.id}`)
+      expect(res.status).toBe(200)
+    })
+
+    test('shows comments with less than 3 reports', async () => {
+      const comment = await Comment.create({ postId: post1.id, userId: user2.id, body: 'Good comment' })
+
+      await CommentReport.create({ commentId: comment.id, userId: user3.id })
+      await CommentReport.create({ commentId: comment.id, userId: user4.id })
+
+      const res = await http.get(`/posts/${post1.id}`)
+      expect(res.status).toBe(200)
+    })
+
+    test('shows oldest comments first', async () => {
+      await Comment.forceCreate({
+        postId: post1.id,
+        userId: user2.id,
+        body: 'First comment',
+        createdAt: new Date(2025, 0, 1).toISOString(),
+      })
+      await Comment.forceCreate({
+        postId: post1.id,
+        userId: user3.id,
+        body: 'Second comment',
+        createdAt: new Date(2025, 0, 2).toISOString(),
+      })
+
+      const res = await http.get(`/posts/${post1.id}`)
+      expect(res.status).toBe(200)
+    })
+  })
+
+  describe('cascade delete', () => {
+    test('deleting a post deletes its comments', async () => {
+      await Comment.create({ postId: post1.id, userId: user2.id, body: 'Comment' })
+
+      await Post.delete({ id: post1.id })
+
+      const comments = await Comment.all()
+      expect(comments).toHaveLength(0)
+    })
+
+    test('deleting a post deletes comment reports', async () => {
+      const comment = await Comment.create({ postId: post1.id, userId: user2.id, body: 'Comment' })
+      await CommentReport.create({ commentId: comment.id, userId: user3.id })
+
+      await Post.delete({ id: post1.id })
+
+      const reports = await CommentReport.all()
+      expect(reports).toHaveLength(0)
+    })
+  })
+})
