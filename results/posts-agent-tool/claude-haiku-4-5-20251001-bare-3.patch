+import { Controller, deriveAgentTools, readBearerToken, verifyApiToken } from '@guren/core'
+import { createAgentInvocationPipeline } from '@guren/server'
+import type { VerifiedApiToken } from '@guren/core'
+import type { AgentPrincipal, DerivedAgentTool } from '@guren/server'
+
+interface JsonRpcRequest {
+  jsonrpc: string
+  id: string | number | null
+  method: string
+  params?: unknown
+}
+
+interface JsonRpcResponse {
+  jsonrpc: string
+  id: string | number | null
+  result?: unknown
+  error?: { code: number; message: string; data?: unknown }
+}
+
+export default class McpController extends Controller {
+  private static agentTools: DerivedAgentTool[] = []
+  private static toolsInitialized = false
+
+  async handle(): Promise<Response> {
+    const authHeader = this.request.header('authorization')
+    const bearerToken = readBearerToken(authHeader)
+
+    if (!bearerToken) {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Parse error' } }, { status: 401 })
+    }
+
+    const apiTokenStore = this.make('api-token-store') as any
+    let verifiedToken: VerifiedApiToken | null = null
+
+    try {
+      verifiedToken = await verifyApiToken(bearerToken, apiTokenStore)
+    } catch {
+      // Token verification failed
+    }
+
+    if (!verifiedToken) {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Parse error' } }, { status: 401 })
+    }
+
+    let request: JsonRpcRequest
+    try {
+      const body = await this.request.json()
+      request = body as JsonRpcRequest
+    } catch {
+      return this.json({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Parse error' } }, { status: 400 })
+    }
+
+    if (request.jsonrpc !== '2.0' || !request.method) {
+      return this.json({ jsonrpc: '2.0', id: request.id ?? null, error: { code: -32600, message: 'Invalid Request' } }, { status: 400 })
+    }
+
+    const response = await this.dispatchMcpCall(request, verifiedToken, bearerToken)
+    const status = response.error?.code === -32600 || response.error?.code === -32700 ? 400 : 200
+    return this.json(response, { status })
+  }
+
+  private getTools(): DerivedAgentTool[] {
+    if (!McpController.toolsInitialized) {
+      const app = this.make('app') as any
+      const definitions = app.router.definitions()
+      const result = deriveAgentTools(definitions)
+      McpController.agentTools = result.tools
+      McpController.toolsInitialized = true
+    }
+    return McpController.agentTools
+  }
+
+  private async dispatchMcpCall(request: JsonRpcRequest, token: VerifiedApiToken, bearerToken: string): Promise<JsonRpcResponse> {
+    if (request.method === 'tools/list') {
+      return {
+        jsonrpc: '2.0',
+        id: request.id ?? null,
+        result: { tools: this.formatTools() },
+      }
+    }
+
+    if (request.method === 'tools/call') {
+      const params = request.params as { name?: string; arguments?: Record<string, unknown> } | undefined
+      if (!params?.name || typeof params.name !== 'string' || !params.arguments || typeof params.arguments !== 'object') {
+        return {
+          jsonrpc: '2.0',
+          id: request.id ?? null,
+          error: { code: -32602, message: 'Invalid params' },
+        }
+      }
+
+      return await this.callTool(params.name, params.arguments as Record<string, unknown>, token, bearerToken)
+    }
+
+    return {
+      jsonrpc: '2.0',
+      id: request.id ?? null,
+      error: { code: -32601, message: 'Method not found' },
+    }
+  }
+
+  private formatTools(): unknown[] {
+    return this.getTools().map((tool) => ({
+      name: tool.toolName,
+      description: tool.description || '',
+      inputSchema: tool.inputSchema,
+      ...(tool.annotations?.readOnlyHint && { annotations: { readOnly: true } }),
+    }))
+  }
+
+  private async callTool(toolName: string, args: Record<string, unknown>, token: VerifiedApiToken, bearerToken: string): Promise<JsonRpcResponse> {
+    const tool = this.getTools().find((t) => t.toolName === toolName)
+    if (!tool) {
+      return {
+        jsonrpc: '2.0',
+        id: null,
+        error: { code: -32601, message: 'Method not found' },
+      }
+    }
+
+    const principal: AgentPrincipal = {
+      kind: 'user',
+      id: token.userId,
+      abilities: token.abilities,
+    }
+
+    const abilities = token.abilities || []
+    const app = this.make('app')
+
+    const pipeline = createAgentInvocationPipeline({
+      app,
+      principal,
+      abilities,
+      surface: 'mcp',
+      authorization: `Bearer ${bearerToken}`,
+    })
+
+    try {
+      const result = await pipeline.invoke({
+        tool,
+        args,
+      })
+
+      if (result.status === 'executed') {
+        const outcome = result.outcome
+        return {
+          jsonrpc: '2.0',
+          id: null,
+          result: {
+            content: outcome.content,
+            isError: outcome.isError,
+          },
+        }
+      } else if (result.status === 'denied') {
+        return {
+          jsonrpc: '2.0',
+          id: null,
+          error: {
+            code: -32600,
+            message: result.denial.message,
+            data: result.denial.body,
+          },
+        }
+      } else {
+        return {
+          jsonrpc: '2.0',
+          id: null,
+          error: { code: -32603, message: 'Internal error' },
+        }
+      }
+    } catch (error) {
+      return {
+        jsonrpc: '2.0',
+        id: null,
+        error: { code: -32603, message: 'Internal error' },
+      }
+    }
+  }
+}
