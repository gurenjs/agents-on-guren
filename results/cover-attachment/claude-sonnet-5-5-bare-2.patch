diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..bcae714
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,92 @@
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 9, 8, 7, 6])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 0, 1, 0])
+
+function form(fields: Record<string, string>, cover?: { bytes: Uint8Array; type: string; name: string }): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', new File([cover.bytes as BlobPart], cover.name, { type: cover.type }))
+  return data
+}
+
+const fields = { title: 'Cover post', excerpt: 'An excerpt', body: 'A body' }
+
+describe('post covers', () => {
+  let http: TestApp
+  let count: () => Promise<number>
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    const user = await User.forceCreate({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-pass-123',
+    })
+    http = await booted.actingAs(user).withCsrf('/posts')
+    count = async () => (await Attachment.all()).length
+  })
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const before = await count()
+    await http.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' }))
+    const post = (await Post.newQuery().orderBy('id', 'desc').first())!
+    const first = (await Attachment.first({ postId: post.id }))!
+    expect(await count()).toBe(before + 1)
+
+    const served = await http.get(`/attachments/${first.id}`)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer() as ArrayBuffer)).toEqual(PNG)
+
+    // A bad replacement changes nothing.
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: GIF, type: 'image/gif', name: 'a.gif' }))
+    expect((await Attachment.first({ postId: post.id }))!.id).toBe(first.id)
+
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: JPEG, type: 'image/jpeg', name: 'b.jpg' }))
+    const second = (await Attachment.first({ postId: post.id }))!
+    expect(second.id).not.toBe(first.id)
+    expect(existsSync(join(import.meta.dir, '../storage', first.path))).toBe(false)
+    expect(existsSync(join(import.meta.dir, '../storage', second.path))).toBe(true)
+    expect((await http.get(`/attachments/${first.id}`)).status).toBe(404)
+
+    // Editing without a file keeps the cover; ticking the box removes it.
+    await http.put(`/posts/${post.id}`, form(fields))
+    expect((await Attachment.first({ postId: post.id }))!.id).toBe(second.id)
+    await http.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' }))
+    expect(await Attachment.first({ postId: post.id })).toBeNull()
+    expect(existsSync(join(import.meta.dir, '../storage', second.path))).toBe(false)
+
+    // Deleting the post deletes its cover.
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' }))
+    const third = (await Attachment.first({ postId: post.id }))!
+    await http.delete(`/posts/${post.id}`)
+    expect(await Post.first({ id: post.id })).toBeNull()
+    expect(await Attachment.first({ id: third.id })).toBeNull()
+    expect(existsSync(join(import.meta.dir, '../storage', third.path))).toBe(false)
+    expect(await count()).toBe(before)
+  })
+
+  it('refuses a GIF and creates nothing', async () => {
+    const posts = (await Post.all()).length
+    const response = await http.post('/posts', form(fields, { bytes: GIF, type: 'image/gif', name: 'a.gif' }))
+    expect(response.status).not.toBe(302)
+    expect((await Post.all()).length).toBe(posts)
+  })
+
+  it('refuses an oversized PNG', async () => {
+    const posts = (await Post.all()).length
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form(fields, { bytes: big, type: 'image/png', name: 'big.png' }))
+    expect((await Post.all()).length).toBe(posts)
+  })
+})
