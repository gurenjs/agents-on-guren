new file mode 100644
index 0000000..eb20857
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/SubscriptionController.ts
@@ -0,0 +1,59 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { ConfirmTokenParamSchema } from '../Validators/SubscriptionValidator.js'
+
+export default class SubscriptionController extends Controller {
+  async store(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable.
+    await NewsletterSubscription.forceCreate({ email, token: generateToken() })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenParamSchema)
+    const subscription = await NewsletterSubscription.findOrFail(token, 'token')
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async destroy(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  // The Referer's path, but only when it names a page of this site, so a
+  // forged header cannot turn these routes into an open redirect.
+  private previousUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+
+    try {
+      const current = new URL(this.request.url)
+      const previous = new URL(referer, current)
+      if (previous.origin !== current.origin) return '/'
+      return `${previous.pathname}${previous.search}` || '/'
+    } catch {
+      return '/'
+    }
+  }
+}
+
+/** 32 random bytes as 64 hex characters. */
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
