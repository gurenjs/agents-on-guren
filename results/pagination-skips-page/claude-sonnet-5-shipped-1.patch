+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,49 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: author.id,
+      })
+    }
+    http = await TestApp.fromApp(app)
+  })
+
+  it('shows the 10 newest posts first, with page 1 as the default and current page', async () => {
+    const res = await http.json().get('/posts').assertInertia('posts/Index')
+    const body = await res.json<{ props: { data: Array<{ title: string }>; pagination: { meta: { currentPage: number; total: number; from: number; to: number } } } }>()
+
+    const props = body.props
+    expect(props.data).toHaveLength(10)
+    expect(props.data[0]?.title).toBe('Post 25')
+    expect(props.data[9]?.title).toBe('Post 16')
+    expect(props.pagination.meta.currentPage).toBe(1)
+    expect(props.pagination.meta.total).toBe(25)
+    expect(props.pagination.meta.from).toBe(1)
+    expect(props.pagination.meta.to).toBe(10)
+  })
+
+  it('?page=1 matches the default (no skipped page)', async () => {
+    const res = await http.json().get('/posts?page=1')
+    const body = await res.json<{ props: { data: Array<{ title: string }> } }>()
+    expect(body.props.data[0]?.title).toBe('Post 25')
+  })
+
+  it('?page=3 shows the remaining 5 posts, not empty', async () => {
+    const res = await http.json().get('/posts?page=3')
+    const body = await res.json<{ props: { data: Array<{ title: string }>; pagination: { meta: { currentPage: number; total: number } } } }>()
+    expect(body.props.data).toHaveLength(5)
+    expect(body.props.data[0]?.title).toBe('Post 5')
+    expect(body.props.pagination.meta.currentPage).toBe(3)
+  })
+})
