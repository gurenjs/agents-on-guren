diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..b612265
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,70 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+// Exercises the slug behaviour end to end (create → address → stability →
+// legacy redirect) through the real app, since it spans the model, the
+// controller and the route.
+describe('post slugs', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })
+  })
+
+  it('slugifies the title on create and redirects there', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: '  Guren  &  Bun: 2026 Edition!  ', excerpt: 'e', body: 'b' })
+      .assertRedirect('/posts/guren-bun-2026-edition')
+
+    await http.json().get('/posts/guren-bun-2026-edition').assertOk().assertInertia('posts/Show')
+  })
+
+  it('gives repeated titles the next free numbered slug', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' }).assertRedirect('/posts/hello-world')
+    await csrf.post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' }).assertRedirect('/posts/hello-world-2')
+    await csrf.post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' }).assertRedirect('/posts/hello-world-3')
+  })
+
+  it('keeps the slug stable when the title is edited later', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Original Title', excerpt: 'e', body: 'b' }).assertRedirect('/posts/original-title')
+    const post = await Post.where({ slug: 'original-title' }).firstOrFail()
+
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'A Brand New Title', excerpt: 'e', body: 'b' })
+      .assertRedirect('/posts/original-title')
+
+    await http.get('/posts/original-title').assertOk()
+    await http.get('/posts/a-brand-new-title').assertNotFound()
+  })
+
+  it('redirects the legacy numeric address to the slug URL', async () => {
+    const post = await Post.forceCreate({ title: 'x', slug: 'legacy-post', excerpt: 'e', body: 'b', authorId: author.id })
+
+    const response = await http.get(`/posts/${post.id}`)
+    response.assertStatus(301)
+    response.assertHeader('Location', '/posts/legacy-post')
+  })
+
+  it('404s for an unknown slug and an unknown numeric id', async () => {
+    await http.get('/posts/does-not-exist').assertNotFound()
+    await http.get('/posts/999999').assertNotFound()
+  })
+
+  it('includes the slug on the post objects sent to pages', async () => {
+    const post = await Post.forceCreate({ title: 'x', slug: 'sluggy', excerpt: 'e', body: 'b', authorId: author.id })
+
+    const response = await http.json().get(`/posts/${post.slug}`)
+    const body = await response.json<{ props: { post: { slug: string } } }>()
+    expect(body.props.post.slug).toBe('sluggy')
+  })
+})
