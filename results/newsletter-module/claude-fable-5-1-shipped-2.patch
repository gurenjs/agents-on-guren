+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      expect(await NewsletterSubscription.all()).toEqual([other])
+    })
+
+    it('returns to the home page without a referer', async () => {
+      await subscribe('reader@example.com')
+      const csrf = await http.withCsrf()
+
+      await csrf.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('redirects for an address that is not subscribed', async () => {
+      const existing = await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'stranger@example.com' }).assertRedirect(REFERER)
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+
+    it('rejects an invalid address', async () => {
+      const existing = await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+
