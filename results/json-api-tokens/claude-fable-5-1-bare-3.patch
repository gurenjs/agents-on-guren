@@ -0,0 +1,18 @@
+import { DatabaseApiTokenStore, defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+export class ApiToken extends defineModel(apiTokens, {
+  // Rows are written by the token store only: the owner comes from the
+  // session and the id and hash from the generator, so nothing is fillable.
+  fillable: [],
+  // The hash is only ever compared, never shown.
+  hidden: ['hashedToken'],
+}) {}
+
+/**
+ * Where tokens are issued, verified and revoked. The framework hashes the
+ * secret before it reaches the store, so the plain text is never written.
+ */
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
