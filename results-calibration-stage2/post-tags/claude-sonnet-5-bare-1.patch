diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..c840fea
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,98 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { postTags, posts, tags, users } from '../db/schema.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let db: any
+  let csrf: TestApp
+  let author: { id: number; email: string }
+
+  const form = (tagsField: string | undefined, title = 'Tagged') => ({
+    title,
+    excerpt: 'Excerpt',
+    body: 'Body',
+    ...(tagsField === undefined ? {} : { tags: tagsField }),
+  })
+
+  const names = async (postId: number) =>
+    (
+      await db
+        .select({ name: tags.name })
+        .from(postTags)
+        .innerJoin(tags, eq(tags.id, postTags.tagId))
+        .where(eq(postTags.postId, postId))
+    )
+      .map((row: { name: string }) => row.name)
+      .sort()
+
+  const createPost = async (tagsField: string | undefined, title?: string) => {
+    await authed().post("/posts", form(tagsField, title))
+    const rows = await db.select().from(posts)
+    return rows[rows.length - 1] as { id: number }
+  }
+
+  const authed = () => csrf.actingAs(author)
+
+  const pageProps = async (path: string) => {
+    const response = await http.withHeaders({ 'X-Inertia': 'true' }).get(path)
+    return ((await response.json()) as any).props
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    csrf = await http.withCsrf()
+    db = await getDatabase()
+    await db.delete(postTags)
+    await db.delete(tags)
+    await db.delete(posts)
+    await db.delete(users)
+    const [row] = await db
+      .insert(users)
+      .values({ name: 'Tagger', email: 'tagger@example.com', passwordHash: 'x' })
+      .returning()
+    author = { id: row.id, email: row.email }
+  })
+
+  it('creates, edits, filters and deletes tagged posts', async () => {
+    const first = await createPost('bun, webdev')
+    expect(await names(first.id)).toEqual(['bun', 'webdev'])
+    expect((await pageProps(`/posts/${first.id}`)).post.tags).toEqual(['bun', 'webdev'])
+
+    await authed().put(`/posts/${first.id}`, form('bun'))
+    expect(await names(first.id)).toEqual(['bun'])
+    expect((await pageProps(`/posts/${first.id}`)).post.tags).toEqual(['bun'])
+
+    const second = await createPost(undefined, 'Untagged')
+    const filtered = await pageProps('/posts?tag=bun')
+    expect(filtered.data.map((p: { id: number }) => p.id)).toEqual([first.id])
+    expect((await pageProps('/posts?tag=nope')).data).toEqual([])
+    const all = await pageProps('/posts')
+    expect(all.data.find((p: { id: number }) => p.id === second.id).tags).toEqual([])
+
+    await authed().delete(`/posts/${first.id}`)
+    expect(await names(first.id)).toEqual([])
+  })
+
+  it('normalizes and validates the field', async () => {
+    const before = (await db.select().from(posts)).length
+    const dup = await createPost(' bun ,bun')
+    expect(await names(dup.id)).toEqual(['bun'])
+
+    const refuse = async (field: string) => {
+      const response = await authed().post('/posts', form(field, 'Refused'))
+      const empty = await authed().post('/posts', { ...form('a'), title: '' })
+      expect(response.status).toBe(empty.status)
+    }
+    await refuse('a,b,c,d,e,f')
+    await refuse('x'.repeat(31))
+    expect((await db.select().from(posts)).length).toBe(before + 1)
+
+    const ok = await createPost('x'.repeat(30))
+    expect(await names(ok.id)).toEqual(['x'.repeat(30)])
+  })
+})
