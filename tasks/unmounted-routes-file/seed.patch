+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { PostResource } from '../Resources/PostResource.js'
+
+// Admin view of the post table: every post, newest first, with its author
+// loaded so the list can show who wrote what. JSON rather than a page — it
+// feeds the moderation tooling, which polls it directly.
+export default class AdminPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+}
