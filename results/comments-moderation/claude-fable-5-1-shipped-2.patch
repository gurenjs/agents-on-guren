index 0000000..660dc37
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,31 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  // The comment's post, loaded by the caller — the post's author may moderate
+  // every comment under it.
+  post: { authorId: number } | null
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * Deleting is reserved for the comment's author and the author of the post it
+ * sits on; reporting only needs a signed-in user.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    if (user === null) {
+      return false
+    }
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === comment.post?.authorId
+  }
+
+  report(user: AuthUser | null, _comment: CommentLike): boolean {
+    return user !== null
+  }
+}
