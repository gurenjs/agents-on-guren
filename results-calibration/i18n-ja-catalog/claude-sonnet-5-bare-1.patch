diff --git a/tests/AuthI18n.test.ts b/tests/AuthI18n.test.ts
new file mode 100644
index 0000000..f3af374
--- /dev/null
+++ b/tests/AuthI18n.test.ts
@@ -0,0 +1,135 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The login and register pages read their copy from the lang/ catalog via
+// useTranslation(), and the server resolves the request locale from
+// Accept-Language (query/cookie override it, but no request here sets
+// either). This exercises that resolution end to end, mirroring how a
+// Japanese browser vs. an English (or unrecognized-locale) browser would
+// see the pages.
+describe('auth pages locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function i18nFor(path: string, acceptLanguage?: string) {
+    const client = http.json()
+    const scoped = acceptLanguage ? client.withHeaders({ 'Accept-Language': acceptLanguage }) : client
+    const response = await scoped.get(path)
+    response.assertOk()
+    const json = (await response.json()) as {
+      props: { _i18n: { locale: string; messages: Record<string, unknown> } }
+    }
+    return json.props._i18n
+  }
+
+  it('defaults to English with no Accept-Language header', async () => {
+    const i18n = await i18nFor('/login')
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('picks Japanese for a plain "ja" header', async () => {
+    const i18n = await i18nFor('/login', 'ja')
+    expect(i18n.locale).toBe('ja')
+  })
+
+  it('picks Japanese for a typical browser Accept-Language header', async () => {
+    const i18n = await i18nFor('/login', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+    expect(i18n.locale).toBe('ja')
+  })
+
+  it('stays English for "en"', async () => {
+    const i18n = await i18nFor('/login', 'en')
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('stays English for "en-US,en;q=0.9"', async () => {
+    const i18n = await i18nFor('/login', 'en-US,en;q=0.9')
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('stays English when English outranks Japanese', async () => {
+    const i18n = await i18nFor('/login', 'en-US,en;q=0.9,ja;q=0.5')
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('stays English for a language we do not support', async () => {
+    const i18n = await i18nFor('/login', 'fr-FR,fr;q=0.9')
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('carries the exact English and Japanese auth catalog strings for /login', async () => {
+    const i18n = await i18nFor('/login', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+    const messages = i18n.messages as {
+      en: { auth: { login: Record<string, string> } }
+      ja: { auth: { login: Record<string, string> } }
+    }
+
+    expect(messages.en.auth.login).toEqual({
+      title: 'Sign in',
+      heading: 'Sign in',
+      subtitle: 'Use your account credentials to continue.',
+      email: 'Email',
+      password: 'Password',
+      remember: 'Remember me',
+      submit: 'Sign in',
+      noAccount: "Don't have an account?",
+      signUp: 'Sign up',
+    })
+
+    expect(messages.ja.auth.login).toEqual({
+      title: 'ログイン',
+      heading: 'ログイン',
+      subtitle: 'アカウントの認証情報を入力して続行してください。',
+      email: 'メールアドレス',
+      password: 'パスワード',
+      remember: 'ログイン状態を保持する',
+      submit: 'ログイン',
+      noAccount: 'アカウントをお持ちでないですか？',
+      signUp: 'アカウント登録',
+    })
+  })
+
+  it('carries the exact English and Japanese auth catalog strings for /register', async () => {
+    const i18n = await i18nFor('/register', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+    const messages = i18n.messages as {
+      en: { auth: { register: Record<string, string> } }
+      ja: { auth: { register: Record<string, string> } }
+    }
+
+    expect(messages.en.auth.register).toEqual({
+      title: 'Sign up',
+      heading: 'Create an account',
+      subtitle: 'Sign up to get started.',
+      name: 'Name',
+      email: 'Email',
+      password: 'Password',
+      passwordConfirmation: 'Confirm password',
+      submit: 'Create account',
+      hasAccount: 'Already have an account?',
+      signIn: 'Sign in',
+    })
+
+    expect(messages.ja.auth.register).toEqual({
+      title: 'アカウント登録',
+      heading: 'アカウント登録',
+      subtitle: 'アカウントを作成して始めましょう。',
+      name: '名前',
+      email: 'メールアドレス',
+      password: 'パスワード',
+      passwordConfirmation: 'パスワード（確認）',
+      submit: '登録',
+      hasAccount: 'すでにアカウントをお持ちですか？',
+      signIn: 'ログイン',
+    })
+  })
+
+  it('translates the welcome message with its :name placeholder preserved', async () => {
+    const i18n = await i18nFor('/login', 'ja')
+    const messages = i18n.messages as { ja: { messages: { welcome: string } } }
+    expect(messages.ja.messages.welcome).toBe(':nameへようこそ！')
+  })
+})
