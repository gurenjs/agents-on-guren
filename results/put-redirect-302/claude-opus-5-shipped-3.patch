+
+// A 302 here made the browser replay the PUT against the Location, looping
+// until ERR_TOO_MANY_REDIRECTS; 303 is what turns the follow-up into a GET.
+describe('posts.update', () => {
+  let http: TestApp
+  let author: UserRecord
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({
+      name: 'Ada',
+      email: 'ada@example.com',
+      password: 'password',
+    })) as UserRecord
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+    postId = post!.id
+  })
+
+  it('redirects to the post with 303 after a successful save', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${postId}`, {
+        title: 'Updated title',
+        excerpt: 'Updated excerpt',
+        body: 'Updated body',
+      })
+      .assertStatus(303)
+      .assertHeader('location', `/posts/${postId}`)
+  })
+
+  it('still returns 422 for an invalid payload', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.put(`/posts/${postId}`, { title: '', excerpt: '', body: '' }).assertStatus(422)
+  })
+})
