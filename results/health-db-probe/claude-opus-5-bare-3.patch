@@ -0,0 +1,109 @@
+import { sql } from 'drizzle-orm'
+import { getDatabase } from '../../config/database.js'
+
+/**
+ * A probe that never answers is as broken as one that throws: the platform
+ * gives up on the request long before a stuck driver does, and an unanswered
+ * probe leaves the deploy in the load-balancer pool. Bound it here instead.
+ */
+const DB_PROBE_TIMEOUT_MS = 2_000
+
+export type CheckStatus = 'ok' | 'error'
+
+export interface CheckResult {
+  status: CheckStatus
+  durationMs: number
+  /** Only set when the check failed — the ops dashboard shows it verbatim. */
+  message?: string
+}
+
+export interface HealthReport {
+  status: CheckStatus
+  checks: { db: CheckResult }
+  timestamp: string
+}
+
+/**
+ * Drizzle handles differ per driver: the sqlite dialect runs a raw statement
+ * through `run()`, the async drivers (postgres, mysql) through `execute()`.
+ * Typed structurally so swapping the driver in config/database.ts needs no
+ * change here — `getDatabase()` itself is only typed as `unknown`.
+ */
+type RawStatementRunner = {
+  run?: (statement: unknown) => unknown
+  execute?: (statement: unknown) => unknown
+}
+
+/**
+ * Opens the connection (the first call also applies pending migrations) and
+ * runs the cheapest statement there is. Deliberately no caching: the probe is
+ * only worth anything if it touches the database on every request.
+ */
+export async function probeDatabase(): Promise<void> {
+  const db = (await getDatabase()) as RawStatementRunner
+  const statement = sql`select 1`
+
+  if (typeof db.run === 'function') {
+    await db.run(statement)
+    return
+  }
+
+  if (typeof db.execute === 'function') {
+    await db.execute(statement)
+    return
+  }
+
+  throw new Error('The database handle exposes neither run() nor execute().')
+}
+
+async function withTimeout(probe: Promise<void>, ms: number): Promise<void> {
+  let timer: ReturnType<typeof setTimeout> | undefined
+
+  try {
+    await Promise.race([
+      probe,
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => reject(new Error(`timed out after ${ms}ms`)), ms)
+      }),
+    ])
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+/**
+ * Runs `probe` and turns anything that goes wrong — a throw, a rejection, a
+ * connection that cannot be opened, a hang — into a failed check rather than
+ * an exception, so the endpoint answers 503 instead of 500.
+ */
+export async function checkDatabase(probe: () => Promise<void> = probeDatabase): Promise<CheckResult> {
+  const startedAt = Date.now()
+
+  try {
+    await withTimeout(Promise.resolve().then(probe), DB_PROBE_TIMEOUT_MS)
+    return { status: 'ok', durationMs: Date.now() - startedAt }
+  } catch (error) {
+    return {
+      status: 'error',
+      durationMs: Date.now() - startedAt,
+      message: error instanceof Error ? error.message : String(error),
+    }
+  }
+}
+
+/** The database is the only dependency worth draining traffic over, for now. */
+export async function runHealthChecks(probe?: () => Promise<void>): Promise<HealthReport> {
+  const checks = { db: await checkDatabase(probe) }
+  const failed = Object.values(checks).some((check) => check.status !== 'ok')
+
+  return {
+    status: failed ? 'error' : 'ok',
+    checks,
+    timestamp: new Date().toISOString(),
+  }
+}
+
+/** 503 is what drains a deploy from the pool; a failed check must never read as 200 or 500. */
+export function healthStatusCode(report: HealthReport): 200 | 503 {
+  return report.status === 'ok' ? 200 : 503
+}
