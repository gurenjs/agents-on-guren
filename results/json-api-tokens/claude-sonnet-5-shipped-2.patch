diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..cd8ddc8
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,27 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed by the verified token id, so it must run after authenticateApiToken.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiToken(c)?.token.id ?? 'anonymous',
+  message: 'Too many requests.',
+})
diff --git a/app/Http/Controllers/Api/PostController.ts b/app/Http/Controllers/Api/PostController.ts
new file mode 100644
index 0000000..f4d6797
--- /dev/null
+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,19 @@
+import { Controller, getApiTokenOrFail } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    const { userId } = getApiTokenOrFail(this.ctx)
+    const { body } = this.validated('api.posts.store')
+    // forceCreate: `authorId` is not fillable and must come from the token, never the body.
+    const post = await Post.forceCreate({ ...body, authorId: Number(userId) })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..7375042
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,29 @@
+import { Controller, createApiToken } from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { apiTokenStore } from '../../Auth/ApiTokens.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name: body.name,
+      userId: user.id,
+    })
+
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+    const owned = (await apiTokenStore.findByUserId(user.id)).find((token) => token.id === id)
+    if (!owned) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await apiTokenStore.delete(owned.id)
+    return new Response(null, { status: 204 })
+  }
+}
