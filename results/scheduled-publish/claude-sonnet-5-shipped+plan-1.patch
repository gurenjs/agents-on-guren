diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..58fd741
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,149 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const HOUR = 3_600_000
+const iso = (offsetMs: number) => new Date(Date.now() + offsetMs).toISOString()
+
+describe('scheduled publishing', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  const makePost = (title: string, authorId: number, publishedAt: string | null) =>
+    Post.forceCreate({ title, excerpt: 'An excerpt', body: 'A body', authorId, publishedAt })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-pass' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-pass' })
+  })
+
+  it('[AC-scheduled-publish-1] creating a post with a future publishAt stores it', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Later', excerpt: 'An excerpt', body: 'A body', publishAt: '2099-01-01T09:00:00.000Z' })
+      .assertStatus(303)
+    const post = await Post.first({ title: 'Later' })
+    expect(post?.publishedAt).toBe('2099-01-01T09:00:00.000Z')
+  })
+
+  it('[AC-scheduled-publish-2] an unparsable publishAt is rejected and nothing is saved', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'Later', excerpt: 'An excerpt', body: 'A body', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.publishAt.0', 'Publish at must be a valid date and time.')
+    expect(await Post.first({ title: 'Later' })).toBeNull()
+  })
+
+  it('[AC-scheduled-publish-3] a guest creating a post is sent to the login page', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/posts', { title: 'x', excerpt: 'y', body: 'z', publishAt: iso(HOUR) })
+      .assertRedirect('/login')
+    expect(await Post.where('publishedAt', 'is not null').count()).toBe(0)
+  })
+
+  it('[AC-scheduled-publish-4] a guest opening a scheduled post gets 404', async () => {
+    const post = await makePost('Soon', author.id, iso(24 * HOUR))
+    await http.get(`/posts/${post.id}`).assertNotFound()
+  })
+
+  it('[AC-scheduled-publish-5] another user opening a scheduled post gets 404', async () => {
+    const post = await makePost('Soon', author.id, iso(24 * HOUR))
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+  })
+
+  it('[AC-scheduled-publish-6] the author opens their scheduled post', async () => {
+    const at = iso(24 * HOUR)
+    const post = await makePost('Soon', author.id, at)
+    const res = await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+    await res.assertBodyContains(at)
+  })
+
+  it('[AC-scheduled-publish-7] the list hides a scheduled post from others and shows it to its author', async () => {
+    await makePost('Soon', author.id, iso(24 * HOUR))
+    await makePost('Now', author.id, null)
+    const guest = await http.get('/posts').assertOk()
+    const guestText = await guest.text()
+    expect(guestText).toContain('Now')
+    expect(guestText).not.toContain('Soon')
+    const otherText = await (await http.actingAs(other).get('/posts')).text()
+    expect(otherText).not.toContain('Soon')
+    const authorText = await (await http.actingAs(author).get('/posts')).text()
+    expect(authorText).toContain('Soon')
+    expect(authorText).toContain('publishedAt')
+  })
+
+  it('[AC-scheduled-publish-8] search leaves a scheduled post out for a guest', async () => {
+    await makePost('Keyword soon', author.id, iso(24 * HOUR))
+    await makePost('Keyword now', author.id, null)
+    const res = await http.json().query('/posts/search', { keywords: ['Keyword'] }).assertOk()
+    const titles = (await res.json<{ data: { title: string }[] }>()).data.map((p) => p.title)
+    expect(titles).toEqual(['Keyword now'])
+  })
+
+  it('[AC-scheduled-publish-9] a post whose time has passed is public', async () => {
+    const post = await makePost('Past', author.id, iso(-HOUR))
+    const page = await http.get(`/posts/${post.id}`).assertOk()
+    await page.assertBodyContains('publishedAt')
+    expect(await (await http.get('/posts')).text()).toContain('Past')
+    const res = await http.json().query('/posts/search', { keywords: ['Past'] }).assertOk()
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+
+  it('[AC-scheduled-publish-10] the author reschedules a post', async () => {
+    const post = await makePost('Now', author.id, null)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'Now', excerpt: 'e', body: 'b', publishAt: '2099-02-01T00:00:00.000Z' })
+      .assertRedirect(`/posts/${post.id}`)
+    expect((await Post.findOrFail(post.id)).publishedAt).toBe('2099-02-01T00:00:00.000Z')
+    await csrf.put(`/posts/${post.id}`, { title: 'Now', excerpt: 'e', body: 'b' }).assertStatus(303)
+    expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+  })
+
+  it('[AC-scheduled-publish-11] an unparsable publishAt on update changes nothing', async () => {
+    const post = await makePost('Now', author.id, null)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .put(`/posts/${post.id}`, { title: 'Changed', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    expect((await Post.findOrFail(post.id)).title).toBe('Now')
+  })
+
+  it('[AC-scheduled-publish-12] the create form opens', async () => {
+    await http.actingAs(author).get('/posts/create').assertOk()
+  })
+
+  it('[AC-scheduled-publish-13] the edit form is handed publishedAt', async () => {
+    const at = iso(24 * HOUR)
+    const post = await makePost('Soon', author.id, at)
+    const res = await http.actingAs(author).get(`/posts/${post.id}/edit`).assertOk()
+    await res.assertBodyContains(at)
+  })
+
+  it('posts:scheduled prints only scheduled posts, soonest first', async () => {
+    await makePost('Later', author.id, '2099-03-01T00:00:00.000Z')
+    await makePost('Sooner', author.id, '2099-02-01T00:00:00.000Z')
+    await makePost('Public', author.id, null)
+    await makePost('Past', author.id, iso(-HOUR))
+    const proc = Bun.spawnSync(['bun', 'run', 'console', 'posts:scheduled'], {
+      env: { ...process.env, NODE_ENV: 'test' },
+    })
+    expect(proc.exitCode).toBe(0)
+    expect(proc.stdout.toString()).toBe(
+      '2\tSooner\t2099-02-01T00:00:00.000Z\n1\tLater\t2099-03-01T00:00:00.000Z\n',
+    )
+  })
+})
