+import { beforeAll, describe, expect, it } from 'bun:test'
+import { API_RATE_LIMIT } from '../app/Http/Middleware/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { createToken, setUpApiTokenFixture, signedIn, withToken, type ApiTokenFixture } from './support/apiTokens.js'
+
+interface PostPayload {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+const draft = { title: 'Release 1.2', excerpt: 'What changed.', body: 'Plenty.' }
+
+// The posts API, called the way a script calls it: a bearer token, no cookies.
+describe('ApiPostController', () => {
+  let fixture: ApiTokenFixture
+
+  beforeAll(async () => {
+    fixture = await setUpApiTokenFixture()
+  })
+
+  describe('GET /api/posts', () => {
+    it('lists every author\'s posts, newest first', async () => {
+      const { http, alice, bob } = fixture
+      await Post.forceCreate({ ...draft, title: 'Oldest', authorId: alice.id, createdAt: '2026-01-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...draft, title: 'Newest', authorId: bob.id, createdAt: '2026-03-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...draft, title: 'Middle', authorId: alice.id, createdAt: '2026-02-01T00:00:00.000Z' })
+      const { token } = await createToken(http, alice)
+
+      const response = await withToken(http, token).get('/api/posts')
+      expect(response.status).toBe(200)
+      const { data } = await response.json<{ data: PostPayload[] }>()
+
+      expect(data.map((post) => post.title)).toEqual(['Newest', 'Middle', 'Oldest'])
+      expect(data.map((post) => post.authorId)).toEqual([bob.id, alice.id, alice.id])
+      expect(data[0]?.createdAt).toBe('2026-03-01T00:00:00.000Z')
+      expect(data[0]?.excerpt).toBe(draft.excerpt)
+      expect(typeof data[0]?.id).toBe('number')
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it('creates the post as the token\'s owner, whatever the body says', async () => {
+      const { http, alice, bob } = fixture
+      const { token } = await createToken(http, alice)
+
+      const response = await withToken(http, token).post('/api/posts', { ...draft, authorId: bob.id })
+      expect(response.status).toBe(201)
+      const { data } = await response.json<{ data: PostPayload }>()
+
+      expect(data.title).toBe(draft.title)
+      expect(data.excerpt).toBe(draft.excerpt)
+      expect(data.authorId).toBe(alice.id)
+      expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+      expect((await Post.findOrFail(data.id)).authorId).toBe(alice.id)
+    })
+
+    it('rejects input the web form would reject and creates nothing', async () => {
+      const { http, alice } = fixture
+      const { token } = await createToken(http, alice)
+      const before = (await Post.all()).length
+
+      const emptyTitle = await withToken(http, token).post('/api/posts', { ...draft, title: '' })
+      expect(emptyTitle.status).toBe(422)
+      expect(await emptyTitle.json<{ errors: Record<string, string[]> }>()).toHaveProperty('errors.title')
+
+      const { body: _body, ...withoutBody } = draft
+      await withToken(http, token).post('/api/posts', withoutBody).assertUnprocessable()
+
+      expect((await Post.all()).length).toBe(before)
+    })
+  })
+
+  describe('an unauthenticated request', () => {
+    it('is answered 401 with a JSON body on both routes', async () => {
+      const { http, alice, bob } = fixture
+      const { id, token } = await createToken(http, alice)
+      const secret = token.split('|')[1] ?? ''
+      const tampered = `${id}|${secret.slice(0, -1)}${secret.endsWith('0') ? '1' : '0'}`
+      const other = await createToken(http, bob)
+      const before = (await Post.all()).length
+
+      const bearers = [
+        'not-a-token',
+        `${id}|`,
+        secret,
+        tampered,
+        `${other.id}|${secret}`,
+        `${'0'.repeat(32)}|${'0'.repeat(64)}`,
+      ]
+
+      for (const bearer of bearers) {
+        const list = await withToken(http, bearer).get('/api/posts')
+        expect(list.status).toBe(401)
+        expect(await list.json<{ message: string }>()).toHaveProperty('message')
+
+        await withToken(http, bearer).post('/api/posts', draft).assertUnauthorized()
+      }
+
+      await http.get('/api/posts').assertUnauthorized()
+      await http.withHeader('Authorization', `Basic ${token}`).get('/api/posts').assertUnauthorized()
+      await http.withHeader('Authorization', token).get('/api/posts').assertUnauthorized()
+
+      expect((await Post.all()).length).toBe(before)
+    })
+
+    it('does not get in on a session alone', async () => {
+      const { http, alice } = fixture
+      const session = await signedIn(http, alice)
+      const before = (await Post.all()).length
+
+      await session.get('/api/posts').assertUnauthorized()
+      await session.post('/api/posts', draft).assertUnauthorized()
+
+      expect((await Post.all()).length).toBe(before)
+    })
+  })
+
+  describe('rate limit', () => {
+    it('answers the 61st request in a minute with 429 and Retry-After, per token', async () => {
+      const { http, alice } = fixture
+      const first = await createToken(http, alice, 'cron')
+      const second = await createToken(http, alice, 'CI')
+
+      for (let request = 1; request <= API_RATE_LIMIT; request++) {
+        const response = await withToken(http, first.token).get('/api/posts')
+        expect(response.status).toBe(200)
+      }
+
+      const limited = await withToken(http, first.token).get('/api/posts')
+      expect(limited.status).toBe(429)
+      const retryAfter = Number(limited.headers.get('Retry-After'))
+      expect(Number.isInteger(retryAfter)).toBe(true)
+      expect(retryAfter).toBeGreaterThanOrEqual(1)
+      expect(retryAfter).toBeLessThanOrEqual(60)
+      expect(await limited.json<{ message: string }>()).toHaveProperty('message')
+
+      await withToken(http, first.token).post('/api/posts', draft).assertStatus(429)
+      await withToken(http, second.token).get('/api/posts').assertOk()
+    })
+  })
+})
