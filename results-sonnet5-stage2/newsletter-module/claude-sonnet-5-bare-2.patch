+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+
+// Invalid input is rejected before the database is touched, so these run
+// without migrations or fixtures.
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = (await TestApp.fromApp(app)).withHeaders({ Referer: 'http://localhost/' })
+    http = await http.withCsrf()
+  })
+
+  it('rejects a subscription without a valid email', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    await http.post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+  })
+
+  it('subscribes, rejects a duplicate, and unsubscribes', async () => {
+    const email = `reader-${Date.now()}@example.com`
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/')
+    await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+    await http.post('/newsletter/unsubscribe', { email }).assertRedirect('/')
+  })
+
+  it('answers 404 for an unknown confirmation token', async () => {
+    await http.get('/newsletter/confirm/unknown-token').assertStatus(404)
+  })
+
+  it('rejects an unsubscribe without a valid email', async () => {
+    await http.post('/newsletter/unsubscribe', { email: '' }).assertStatus(422)
+  })
+})
