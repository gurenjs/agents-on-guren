diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..c00962f
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,89 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 9, 8, 7, 6])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 0])
+
+function form(fields: Record<string, string>, cover?: { bytes: Uint8Array; type: string; name: string }): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', new File([cover.bytes as BlobPart], cover.name, { type: cover.type }))
+  return data
+}
+
+const fields = { title: 'Cover post', excerpt: 'Excerpt', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const user = await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'password-123',
+    })
+    http = (await (await TestApp.fromApp(app)).withCsrf('/login')).actingAs(user)
+  })
+
+  async function latestPost() {
+    return (await Post.newQuery().orderBy('id', 'desc').first())!
+  }
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    await http.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const post = await latestPost()
+    const first = (await Attachment.newQuery().where('postId', post.id).first())!
+    expect(first.mimeType).toBe('image/png')
+    expect(existsSync(join(process.cwd(), 'storage', first.path))).toBe(true)
+
+    const served = await http.get(`/attachments/${first.id}`)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    // Editing without a file keeps the cover.
+    await http.put(`/posts/${post.id}`, form({ ...fields, title: 'Renamed' })).assertRedirect()
+    expect(await Attachment.newQuery().where('postId', post.id).count()).toBe(1)
+
+    // A new cover replaces the old one and deletes its file.
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: JPEG, type: 'image/jpeg', name: 'b.jpg' })).assertRedirect()
+    const second = (await Attachment.newQuery().where('postId', post.id).first())!
+    expect(second.mimeType).toBe('image/jpeg')
+    expect(existsSync(join(process.cwd(), 'storage', first.path))).toBe(false)
+    expect((await http.get(`/attachments/${first.id}`)).status).toBe(404)
+
+    // Refused upload keeps the current cover.
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: GIF, type: 'image/gif', name: 'c.gif' })).assertStatus(422)
+    expect((await Attachment.newQuery().where('postId', post.id).first())!.id).toBe(second.id)
+
+    // Remove checkbox.
+    await http.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect(await Attachment.newQuery().where('postId', post.id).count()).toBe(0)
+    expect(existsSync(join(process.cwd(), 'storage', second.path))).toBe(false)
+
+    // Deleted with the post.
+    await http.put(`/posts/${post.id}`, form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const third = (await Attachment.newQuery().where('postId', post.id).first())!
+    await http.delete(`/posts/${post.id}`).assertRedirect()
+    expect(existsSync(join(process.cwd(), 'storage', third.path))).toBe(false)
+    expect(await Attachment.newQuery().where('postId', post.id).count()).toBe(0)
+  })
+
+  it('refuses a GIF or an oversized PNG on create and saves nothing', async () => {
+    const before = await Post.newQuery().count()
+    await http.post('/posts', form(fields, { bytes: GIF, type: 'image/gif', name: 'c.gif' })).assertStatus(422)
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form(fields, { bytes: big, type: 'image/png', name: 'big.png' })).assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
