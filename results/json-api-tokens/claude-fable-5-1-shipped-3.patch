diff --git a/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts b/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts
new file mode 100644
index 0000000..01ef5d2
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiTokenMiddleware.ts
@@ -0,0 +1,14 @@
+import { createBearerTokenMiddleware } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokens.js'
+import { User } from '../../Models/User.js'
+
+// Answers from the bearer token alone: a session cookie without one is a 401
+// here, so the API never runs on a browser's ambient authority.
+export const AuthenticateApiTokenMiddleware = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (ctx) => {
+    ctx.header('WWW-Authenticate', 'Bearer')
+    return ctx.json({ message: 'Unauthenticated.' }, 401)
+  },
+})
diff --git a/app/Http/Middleware/ThrottleApiTokenMiddleware.ts b/app/Http/Middleware/ThrottleApiTokenMiddleware.ts
new file mode 100644
index 0000000..a30d301
--- /dev/null
+++ b/app/Http/Middleware/ThrottleApiTokenMiddleware.ts
@@ -0,0 +1,19 @@
+import { MemoryRateLimitStore, createRateLimitMiddleware, getApiTokenOrFail } from '@guren/core'
+
+export const API_TOKEN_RATE_LIMIT = 60
+
+// Counts live in this process, which matches the single-process SQLite
+// deployment; running several instances needs a shared RateLimitStore.
+const store = new MemoryRateLimitStore()
+
+// Mount after AuthenticateApiTokenMiddleware: the bucket is the token, not the
+// account or the IP, so two tokens of one user are limited independently.
+export const ThrottleApiTokenMiddleware = createRateLimitMiddleware({
+  limit: API_TOKEN_RATE_LIMIT,
+  windowMs: 60_000,
+  store,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: `Too many requests. Retry in ${retryAfter} seconds.` }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
new file mode 100644
index 0000000..76afbc7
--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,24 @@
+import { Resource } from '@guren/core'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// Never carries `hashedToken`: the id and name are all a page needs to list
+// and revoke a token.
+export class ApiTokenResource extends Resource<ApiTokenRecord, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: new Date(token.createdAt).toISOString(),
+      lastUsedAt: token.lastUsedAt ? new Date(token.lastUsedAt).toISOString() : null,
+    }
+  }
+}
