+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import type { UserRecord } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +24,39 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('post excerpts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('includes the excerpt on the posts index and show pages', async () => {
+    const author = await User.create<UserRecord>({
+      name: 'Ada Lovelace',
+      email: 'ada@example.com',
+      password: 'password123',
+    })
+    const post = await Post.forceCreate({
+      title: 'Bee Cognition',
+      excerpt: 'Bees remember faces',
+      body: 'Bees can recognize individual human faces using configural processing.',
+      authorId: author.id,
+    })
+
+    const indexResponse = await http.withHeader('X-Inertia', 'true').get('/posts')
+    indexResponse.assertOk()
+    const indexBody = await indexResponse.json()
+    expect(indexBody.props.data[0].excerpt).toBe('Bees remember faces')
+
+    const showResponse = await http.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`)
+    showResponse.assertOk()
+    const showBody = await showResponse.json()
+    expect(showBody.props.post.excerpt).toBe('Bees remember faces')
+  })
+})
