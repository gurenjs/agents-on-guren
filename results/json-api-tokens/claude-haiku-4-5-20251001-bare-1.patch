new file mode 100644
index 0000000..e65623f
--- /dev/null
+++ b/app/Services/RateLimiter.ts
@@ -0,0 +1,21 @@
+const rateLimitStore = new Map<string, { count: number; resetAt: number }>()
+
+export class RateLimiter {
+  static checkRateLimit(key: string, limit: number = 60, window: number = 60): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const entry = rateLimitStore.get(key)
+
+    if (!entry || now >= entry.resetAt) {
+      rateLimitStore.set(key, { count: 1, resetAt: now + window * 1000 })
+      return { allowed: true }
+    }
+
+    if (entry.count >= limit) {
+      const retryAfter = Math.ceil((entry.resetAt - now) / 1000)
+      return { allowed: false, retryAfter: Math.min(retryAfter, 60) }
+    }
+
+    entry.count++
+    return { allowed: true }
+  }
+}
