diff --git a/tests/SlugFunctionality.test.ts b/tests/SlugFunctionality.test.ts
new file mode 100644
index 0000000..c90465b
--- /dev/null
+++ b/tests/SlugFunctionality.test.ts
@@ -0,0 +1,85 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('Slug functionality', () => {
+  let http: TestApp
+  let user: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    // Create a test user with a unique email
+    const timestamp = Date.now()
+    user = await User.forceCreate({
+      name: 'Test User',
+      email: `slug-test-${timestamp}@example.com`,
+      password: 'secret',
+    })
+  })
+
+  it('creates a post with a generated slug', async () => {
+    const slug = require('../app/Utils/SlugGenerator.js')
+    const generatedSlug = slug.generateSlug('Hello, World!')
+    expect(generatedSlug).toBe('hello-world')
+  })
+
+  it('creates a post with a unique slug when duplicates exist', async () => {
+    const { generateUniqueSlug } = require('../app/Utils/SlugGenerator.js')
+    const timestamp = Date.now()
+
+    // Create first post
+    const post1 = await Post.forceCreate({
+      title: `Test Post ${timestamp}`,
+      slug: `test-post-${timestamp}`,
+      excerpt: 'First test post',
+      body: 'This is the first test post',
+      authorId: user.id,
+    })
+
+    expect(post1.slug).toBe(`test-post-${timestamp}`)
+
+    // Generate slug for second post with same title
+    const slug2 = await generateUniqueSlug(`Test Post ${timestamp}`, Post)
+    expect(slug2).toBe(`test-post-${timestamp}-2`)
+
+    // Clean up
+    await Post.delete({ id: post1.id })
+  })
+
+  it('shows a post by slug', async () => {
+    const timestamp = Date.now()
+    const post = await Post.forceCreate({
+      title: `Slug Test Post ${timestamp}`,
+      slug: `slug-test-post-${timestamp}`,
+      excerpt: 'A post to test slug display',
+      body: 'This is a test post for slug display',
+      authorId: user.id,
+    })
+
+    const response = await http.get(`/posts/${post.slug}`)
+    await response.assertOk()
+
+    // Clean up
+    await Post.delete({ id: post.id })
+  })
+
+  it('redirects from numeric ID to slug with 301', async () => {
+    const timestamp = Date.now()
+    const post = await Post.forceCreate({
+      title: `Redirect Test Post ${timestamp}`,
+      slug: `redirect-test-post-${timestamp}`,
+      excerpt: 'A post to test ID to slug redirect',
+      body: 'This is a test post for ID to slug redirect',
+      authorId: user.id,
+    })
+
+    const response = await http.get(`/posts/${post.id}`)
+    await response.assertRedirect(`/posts/${post.slug}`)
+    expect(response.status).toBe(301)
+
+    // Clean up
+    await Post.delete({ id: post.id })
+  })
+})
