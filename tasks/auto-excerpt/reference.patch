diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..9dc2561
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,23 @@
+/** Longest excerpt derived from a body when the author leaves the field empty. */
+export const EXCERPT_LIMIT = 140
+
+/**
+ * Derive an excerpt from a post body: the first `limit` characters, never
+ * cutting a word in half. When the cut would land inside a word, back up to
+ * the last whitespace before it. Anything shortened ends with an ellipsis; a
+ * body that fits within the limit is used whole.
+ */
+export function deriveExcerpt(body: string, limit = EXCERPT_LIMIT): string {
+  const text = body.trim()
+  if (text.length <= limit) return text
+
+  let head = text.slice(0, limit)
+  const nextIsWordChar = !/\s/.test(text.charAt(limit))
+  if (nextIsWordChar) {
+    const lastSpace = head.search(/\s\S*$/)
+    // A single unbroken run longer than the limit has no boundary to back up to.
+    if (lastSpace > 0) head = head.slice(0, lastSpace)
+  }
+
+  return `${head.trimEnd()}…`
+}
