diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..f847232 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,39 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// PUT is not converted to GET on a 3xx redirect the way POST is (Fetch spec,
+// HTTP-redirect fetch) — only 303 downgrades a non-GET/HEAD request. A plain
+// 302 here would have the client re-PUT the same URL forever, which is
+// exactly the bug this guards against.
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects to the post page with a 303 after a successful save', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, {
+        title: 'Updated title',
+        excerpt: 'Original excerpt',
+        body: 'Original body',
+      })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${post.id}`)
+  })
+})
