diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..bcbc522
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,22 @@
+/** Slug used when a title carries no ASCII letters or digits at all. */
+export const FALLBACK_SLUG = 'post'
+
+/**
+ * Turn a title into the URL-safe form used as a post's address: lowercase
+ * ASCII letters and digits, words joined by a single `-`, no leading or
+ * trailing `-`.
+ *
+ * Accented letters are decomposed first (NFKD), so "Café" becomes `cafe`
+ * rather than losing the letter entirely. A title with nothing left to keep
+ * (emoji only, or scripts with no ASCII form) falls back to
+ * {@link FALLBACK_SLUG}; `Post.uniqueSlug()` then numbers it.
+ */
+export function slugify(value: string): string {
+  const slug = value
+    .normalize('NFKD')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/gu, '-')
+    .replace(/^-+|-+$/gu, '')
+
+  return slug === '' ? FALLBACK_SLUG : slug
+}
