+++ b/modules/newsletter/tests/NewsletterController.test.ts
@@ -0,0 +1,48 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('subscribes, rejects duplicates and bad addresses', async () => {
+    const csrf = (await http.withCsrf()).withHeader('Referer', 'http://localhost/posts').json()
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect('/posts')
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.confirmedAt).toBeNull()
+    expect(rows[0]!.token.length).toBeGreaterThanOrEqual(16)
+
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s on unknown tokens', async () => {
+    const csrf = (await http.withCsrf()).json()
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' })
+    const [row] = await NewsletterSubscription.all()
+    await http.get('/newsletter/confirm/nope').assertNotFound()
+    await http.get(`/newsletter/confirm/${row!.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.all())[0]!.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes', async () => {
+    const csrf = (await http.withCsrf()).json()
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' })
+    await csrf.post('/newsletter/subscribe', { email: 'b@example.com' })
+    await csrf.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('/')
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((r) => r.email)).toEqual(['b@example.com'])
+  })
+})
