+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_NAME_LENGTH = 30
+
+/**
+ * Turns the form's comma-separated `tags` text (or an already-split list) into
+ * the distinct, trimmed names it carries. Empty entries — a trailing comma,
+ * `a,,b` — are dropped; names are case-sensitive, and a repeated name counts
+ * once, so ` bun ,bun` is the one tag `bun`.
+ */
+export function parseTagNames(input: string | readonly string[] | undefined): string[] {
+  const raw = input === undefined ? [] : typeof input === 'string' ? input.split(',') : input.flatMap((part) => part.split(','))
+  const names: string[] = []
+  for (const part of raw) {
+    const name = part.trim()
+    if (name.length > 0 && !names.includes(name)) {
+      names.push(name)
+    }
+  }
+  return names
+}
+
+// A `.transform()` so the issues land on `tags` itself, which is the field the
+// form shows the error under. Codegen types this field by its input shape, so
+// the controller runs parseTagNames() again on the validated body — it is
+// idempotent, so both the type and the runtime value stay honest.
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .transform((value, ctx) => {
+    const names = parseTagNames(value)
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+    if (names.some((name) => name.length > MAX_TAG_NAME_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_NAME_LENGTH} characters or fewer.` })
+    }
+    return names
+  })
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: TagsFieldSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
