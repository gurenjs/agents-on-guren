diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..aef0d7f
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,29 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { routeManifest } from '@/.guren/routes.gen'
+import app from '../src/app.js'
+
+// The public JSON feed partners consume. Its `page`/`author` contract lives on
+// the route itself, so the router answers an invalid request with a 422 before
+// the controller — and therefore the database — is ever reached: these cases
+// run without migrations or fixtures. Cover the listing itself with feature
+// tests once your test database is set up.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('is named api.posts.index in the route manifest', () => {
+    expect(routeManifest['api.posts.index']).toEqual({ method: 'GET', path: '/api/posts' })
+  })
+
+  it.each(['?page=0', '?page=abc', '?author=abc', '?author=0'])(
+    'rejects %s with a 422',
+    async (queryString) => {
+      const response = await http.get(`/api/posts${queryString}`).assertStatus(422)
+      expect(response.headers.get('content-type')).toContain('application/json')
+    },
+  )
+})
