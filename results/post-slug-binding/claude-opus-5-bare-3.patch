 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
+/** Used when a title has nothing sluggable in it (e.g. only punctuation or non-ASCII script). */
+const FALLBACK_SLUG = 'post'
+
+/**
+ * Turn a title into the URL form: lowercase, ASCII letters and digits only,
+ * words joined by a single `-`, no `-` at either end. Not guaranteed unique —
+ * `Post.uniqueSlug()` is what a new post gets its slug from.
+ */
+export function slugify(title: string): string {
+  const slug = title
+    // Decompose, then drop the accents: "Crème Brûlée" reads as "creme-brulee"
+    // rather than being cut into pieces at every accented letter.
+    .normalize('NFKD')
+    .replace(/\p{M}+/gu, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/gu, '-')
+    .replace(/^-+|-+$/gu, '')
+
+  return slug === '' ? FALLBACK_SLUG : slug
+}
+
 export class Post extends defineModel(posts) {
   // `authorId` is set from the signed-in user, never from request input.
+  // `slug` is derived from the title on create and never rewritten, so a
+  // published post keeps the address it was announced at.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /**
+   * The slug for a new post: `slugify(title)`, with the next free `-2`, `-3`, …
+   * appended when that one is already taken. One query fetches every slug that
+   * could collide, so the search for a free suffix happens in memory.
+   */
+  static async uniqueSlug(title: string): Promise<string> {
+    const base = slugify(title)
+    // Safe as a LIKE pattern: slugs only ever contain [a-z0-9-], never `%` or `_`.
+    const rows = await Post.newQuery().where('slug', 'like', `${base}%`).get()
+    const taken = new Set(rows.map((row) => row.slug))
+
+    if (!taken.has(base)) {
+      return base
+    }
+
+    let suffix = 2
+    while (taken.has(`${base}-${suffix}`)) {
+      suffix += 1
+    }
+
+    return `${base}-${suffix}`
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
