diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..96a0f24
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,114 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// Every request here goes to /login: a guest page that renders without the
+// database, so the suite stays green without migrations or fixtures.
+const PAGE = '/login'
+
+interface I18nProps {
+  locale: string
+  messages: Record<string, Record<string, Record<string, unknown>>>
+}
+
+async function i18nOf(http: TestApp): Promise<I18nProps> {
+  const response = await http.withHeader('X-Inertia', 'true').get(PAGE)
+  response.assertOk()
+  const page = await response.json<{ props: { _i18n: I18nProps } }>()
+  return page.props._i18n
+}
+
+function localeCookie(response: { headers: Headers }): string | undefined {
+  return response.headers
+    .getSetCookie()
+    .map((cookie) => cookie.split(';')[0])
+    .find((pair) => pair.startsWith('locale='))
+}
+
+describe('locale.update', () => {
+  let http: TestApp
+  let csrf: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    csrf = await http.withCsrf(PAGE)
+  })
+
+  it('defaults to English', async () => {
+    const i18n = await i18nOf(http)
+
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en.nav.posts).toBe('Posts')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja'))).locale).toBe('ja')
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'))).locale).toBe('ja')
+    expect((await i18nOf(http.withHeader('Accept-Language', 'fr-FR,fr;q=0.9'))).locale).toBe('en')
+  })
+
+  it('remembers the pick and hands the page the Japanese catalog', async () => {
+    const response = await csrf.post('/locale', { locale: 'ja' })
+    response.assertRedirect('/')
+    const cookie = localeCookie(response)
+    expect(cookie).toBe('locale=ja')
+
+    const i18n = await i18nOf(http.withHeader('Cookie', cookie!))
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja.nav).toMatchObject({ home: 'ホーム', posts: '記事', dashboard: 'ダッシュボード' })
+    expect(i18n.messages.ja.posts).toMatchObject({ new: '新規投稿', edit: '編集', delete: '削除', search: '検索' })
+    expect(i18n.messages.ja.auth).toMatchObject({ login: 'ログイン', logout: 'ログアウト' })
+  })
+
+  it('lets the pick win over the browser setting', async () => {
+    const japaneseBrowser = http.withHeaders({ 'Accept-Language': 'ja', Cookie: 'locale=en' })
+
+    expect((await i18nOf(japaneseBrowser)).locale).toBe('en')
+  })
+
+  it('redirects back to the page named in the Referer', async () => {
+    await csrf.withHeader('Referer', 'http://localhost/posts?page=2')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts?page=2')
+    await csrf.withHeader('Referer', '/posts/1')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/posts/1')
+  })
+
+  it('does not follow a Referer on another site', async () => {
+    await csrf.withHeader('Referer', 'https://evil.example/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+    await csrf.withHeader('Referer', '//evil.example/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported or missing locale and keeps the current pick', async () => {
+    for (const body of [{ locale: 'fr' }, {}]) {
+      const response = await csrf.json().post('/locale', body)
+      response.assertUnprocessable()
+      const { errors } = await response.json<{ errors: Record<string, string[]> }>()
+      expect(errors.locale).toHaveLength(1)
+      expect(localeCookie(response)).toBeUndefined()
+    }
+  })
+
+  it('is open to guests but still guarded by CSRF', async () => {
+    await http.post('/locale', { locale: 'ja' }).assertForbidden()
+  })
+})
+
+describe('translation catalogs', () => {
+  it('carry the same keys in both languages', async () => {
+    const http = await TestApp.fromApp(app)
+    const { messages } = await i18nOf(http.withHeader('Accept-Language', 'ja'))
+
+    const keys = (catalog: Record<string, unknown>, prefix = ''): string[] =>
+      Object.entries(catalog).flatMap(([key, value]) =>
+        typeof value === 'string' ? [`${prefix}${key}`] : keys(value as Record<string, unknown>, `${prefix}${key}.`))
+
+    expect(keys(messages.ja).sort()).toEqual(keys(messages.en).sort())
+    expect(keys(messages.ja)).toContain('messages.welcome')
+  })
+})
