+++ b/app/Providers/ApiTokenProvider.ts
@@ -0,0 +1,18 @@
+import { ServiceProvider, MemoryApiTokenStore } from '@guren/core'
+
+export const API_TOKEN_STORE_KEY = 'api-token-store'
+
+// Create the store at module level so it's shared globally.
+export const sharedApiTokenStore = new MemoryApiTokenStore()
+
+export default class ApiTokenProvider extends ServiceProvider {
+  register(): void {
+    // Register the API token store in the container.
+    // Using the shared instance so the same tokens are available everywhere.
+    this.container.singleton(API_TOKEN_STORE_KEY, () => sharedApiTokenStore)
+  }
+
+  boot(): void {
+    // Store is automatically injected from the container when needed.
+  }
+}
