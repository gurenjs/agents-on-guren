+// Bearer credentials for the MCP endpoint, read and written through
+// DatabaseApiTokenStore (src/app.ts). The property names are that store's
+// contract, the ApiToken fields, so rename columns rather than properties.
+// Only the SHA-256 of a token is kept: the plain text exists once, at issue.
+export const apiTokens = sqliteTable('api_tokens', {
+  id: text('id').primaryKey(),
+  name: text('name').notNull(),
+  hashedToken: text('hashed_token').notNull().unique(),
+  userId: integer('user_id')
