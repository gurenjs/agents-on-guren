+
+  // Revision history is part of editing a post, so it shares the `update`
+  // ability: only the author may list or restore revisions.
+  async revisions(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('update', [Post, post])
+
+    const revisions = await PostRevision.where({ postId: post.id })
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: { id: post.id, title: post.title },
+      revisions: revisions.map((revision) => ({
+        id: revision.id,
+        title: revision.title,
+        createdAt: new Date(revision.createdAt).toISOString(),
+      })),
+    })
+  }
+
+  async restoreRevision(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(PostRevisionParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('update', [Post, post])
+
+    // Scoped to the post, so a revision of another post is a 404 even when
+    // the same author owns both.
+    const revision = await PostRevision.where({ id: revisionId, postId: post.id }).firstOrFail()
+
+    await saveWithRevision(post, {
+      title: revision.title,
+      excerpt: revision.excerpt,
+      body: revision.body,
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
+
+/** Keeps the post's current content as a revision, then applies `data`. */
+async function saveWithRevision(post: PostRecord, data: PostPayload): Promise<void> {
+  await Post.transaction(async (trx) => {
+    await PostRevision.forceCreate(
+      { postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body },
+      { trx },
+    )
+    await Post.update({ id: post.id }, data, { trx })
+  })
 }
