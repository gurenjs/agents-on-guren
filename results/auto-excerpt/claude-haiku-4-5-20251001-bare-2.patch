+++ b/app/Services/ExcerptService.ts
@@ -0,0 +1,28 @@
+export class ExcerptService {
+  static derive(body: string): string {
+    const trimmed = body.trim()
+
+    if (trimmed.length <= 140) {
+      return trimmed
+    }
+
+    const first140 = trimmed.slice(0, 140)
+    const char141 = trimmed.charAt(140)
+
+    let keepCount = 140
+    if (char141 && !/\s/.test(char141)) {
+      let lastWhitespace = -1
+      for (let i = first140.length - 1; i >= 0; i--) {
+        if (/\s/.test(first140.charAt(i))) {
+          lastWhitespace = i
+          break
+        }
+      }
+      if (lastWhitespace !== -1) {
+        keepCount = lastWhitespace
+      }
+    }
+
+    return first140.slice(0, keepCount).trimEnd() + '…'
+  }
+}
