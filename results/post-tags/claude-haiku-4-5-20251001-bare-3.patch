+        path: ['tags'],
+        message: 'Tags must be 5 or fewer.',
+      })
+    }
+
+    for (const tag of data.tags) {
+      if (tag.length < 1 || tag.length > 30) {
+        ctx.addIssue({
+          code: z.ZodIssueCode.custom,
+          path: ['tags'],
+          message: 'Each tag must be 1–30 characters.',
+        })
+        break
+      }
+    }
+
+    const uniqueTags = new Set(data.tags)
