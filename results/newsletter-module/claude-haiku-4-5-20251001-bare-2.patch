@@ -0,0 +1,45 @@
+import { Controller } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { SubscribeSchema, UnsubscribeSchema, ConfirmTokenParamSchema } from '../Validators/NewsletterValidator.js'
+
+function generateToken(): string {
+  return crypto.getRandomValues(new Uint8Array(32)).reduce((a, b) => a + b.toString(16).padStart(2, '0'), '')
+}
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+
+    const existing = await NewsletterSubscription.where({ email })
+    if (existing.length > 0) {
+      return this.redirect(this.request.header('Referer') ?? '/')
+    }
+
+    const token = generateToken()
+    await NewsletterSubscription.create({ email, token })
+
+    return this.redirect(this.request.header('Referer') ?? '/')
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenParamSchema)
+
+    const subscriptions = await NewsletterSubscription.where({ token })
+    if (subscriptions.length === 0) {
+      return new Response(null, { status: 404 })
+    }
+
+    const subscription = subscriptions[0]
+    await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.request.header('Referer') ?? '/')
+  }
+}
