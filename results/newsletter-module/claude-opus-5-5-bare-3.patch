@@ -0,0 +1,61 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+// The test database persists between runs, so every address is unique.
+function uniqueEmail(): string {
+  return `reader-${crypto.randomUUID()}@example.com`
+}
+
+describe('newsletter subscriptions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const base = await TestApp.fromApp(app)
+    http = (await base.withCsrf('/')).withHeader('Referer', 'http://localhost/posts')
+  })
+
+  it('stores a pending subscription and redirects back', async () => {
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+
+    const subscription = await NewsletterSubscription.first({ email })
+    expect(subscription).not.toBeNull()
+    expect(subscription?.confirmedAt).toBeNull()
+    expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects an invalid or duplicate address', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+    await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+    expect(await NewsletterSubscription.where({ email }).get()).toHaveLength(1)
+  })
+
+  it('confirms a subscription by token', async () => {
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+    const subscription = await NewsletterSubscription.first({ email })
+
+    await http.get(`/newsletter/confirm/${subscription?.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ email }))?.confirmedAt).not.toBeNull()
+  })
+
+  it('answers 404 for an unknown token', async () => {
+    await http.get(`/newsletter/confirm/${crypto.randomUUID()}`).assertStatus(404)
+  })
+
+  it('unsubscribes only the given address', async () => {
+    const leaving = uniqueEmail()
+    const staying = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email: leaving }).assertRedirect('/posts')
+    await http.post('/newsletter/subscribe', { email: staying }).assertRedirect('/posts')
+
+    await http.post('/newsletter/unsubscribe', { email: leaving }).assertRedirect('/posts')
+    expect(await NewsletterSubscription.first({ email: leaving })).toBeNull()
+    expect(await NewsletterSubscription.first({ email: staying })).not.toBeNull()
+  })
+})
