@@ -0,0 +1,51 @@
+---
+type: adr
+status: stable
+entities: [Post]
+related:
+  - app/Http/Controllers/PostController.ts
+  - app/Http/Controllers/HomeController.ts
+  - app/Http/Resources/PostResource.ts
+  - app/Http/Validators/PostValidator.ts
+  - app/Console/Commands/PostsScheduledCommand.ts
+generated: { by: claude-fable-5-1/1.0, at: 2026-09-25T04:25:40.809Z }
+---
+
+# Schedule a post to publish later
+
+## Context
+
+Authors write ahead of time, but a post went live the moment it was saved, so
+the launch calendar lived in a spreadsheet and posts were pasted in by hand at
+the right minute. That went wrong twice. Editorial wants to write now and
+publish later; ops wants to read the calendar from a terminal.
+
+## Decision
+
+- `posts.published_at` is a nullable ISO 8601 UTC text column, stored the same
+  way as `created_at`. `NULL` or a past instant means public; a future instant
+  means scheduled. Nothing runs at the scheduled moment: visibility is decided
+  at read time by comparing the column to "now".
+- The create and edit requests accept an optional `publishAt` (ISO 8601 with a
+  zone offset). Absent or `null` publishes on save. The controller normalizes
+  the instant to the `toISOString()` form before storing it, so text
+  comparison against the current instant is a valid ordering.
+- One rule, in two places: `Post.isVisibleTo()` for a single record and
+  `Post.visibleTo()` as a query builder for lists and search. A scheduled post
+  is visible only to its author. Every reader of posts (index, search, show,
+  home) goes through it.
+- A scheduled post's page answers 404, not 403, to anyone but its author, so
+  its existence is not disclosed.
+- `bun run console posts:scheduled` prints `<id>\t<title>\t<published_at>`
+  per scheduled post, soonest first, and nothing else on stdout, so ops can
+  pipe it into other tools.
+
+## Consequences
+
+- No scheduler, queue or cron is needed; a post goes live by the clock alone.
+- Every future query that lists posts must go through `Post.visibleTo()` or it
+  leaks scheduled posts. `Post.newQuery()` for posts is now a review flag.
+- Writers must store `published_at` in the UTC `toISOString()` form. A value
+  in another format (local time, no zone) would compare incorrectly.
+- Time-zone handling in the browser is confined to the `PublishAtField`
+  component, which converts local wall time to a UTC instant at the edge.
diff --git a/resources/js/components/PublishAtField.tsx b/resources/js/components/PublishAtField.tsx
new file mode 100644
index 0000000..e35f9e0
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,38 @@
+interface Props {
+  /** ISO 8601 UTC instant, or null/undefined for "publish on save". */
+  value: string | null | undefined
+  error?: string
+  onChange: (value: string | null) => void
+  className: string
+}
+
+// `datetime-local` speaks the browser's zone with no offset, so the value is
+// converted at the edge: local wall time in, UTC ISO out to the server.
+function toLocalInputValue(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+export default function PublishAtField({ value, error, onChange, className }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">Publish at</label>
+      <input
+        type="datetime-local"
+        value={toLocalInputValue(value)}
+        onChange={(event) => {
+          const local = event.target.value
+          onChange(local ? new Date(local).toISOString() : null)
+        }}
+        className={className}
+      />
+      <p className="mt-1 text-xs text-g-muted">
+        Leave empty to publish as soon as you save. Until the chosen time only you can see the post.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
