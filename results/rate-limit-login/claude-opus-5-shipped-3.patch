+import { createRateLimitMiddleware, MemoryRateLimitStore, type RateLimitEntry } from '@guren/core'
+
+/** Submissions of the login form a single client may make per window. */
+export const LOGIN_MAX_ATTEMPTS = 5
+
+/** Length of the throttling window, in milliseconds. */
+export const LOGIN_THROTTLE_WINDOW_MS = 60_000
+
+/**
+ * Counters for the login throttle, kept in this process only — a single
+ * process serves the app and nothing about a one-minute window is worth
+ * surviving a restart.
+ *
+ * The base store sweeps expired entries on an interval that is not unref()ed,
+ * which would keep the process alive on its own; the `0` passed below turns
+ * that timer off and the sweep happens on the way in instead. Only login
+ * submissions get here, so the map holds one entry per client that recently
+ * tried to sign in and stays bounded to the current window.
+ */
+class LoginThrottleStore extends MemoryRateLimitStore {
+  constructor(now?: () => number) {
+    super(0, now)
+  }
+
+  override async increment(key: string, windowMs: number): Promise<RateLimitEntry> {
+    this.cleanup()
+    return super.increment(key, windowMs)
+  }
+}
+
+/**
+ * Throttles login submissions so a stolen password list cannot be walked
+ * through the form: a client gets {@link LOGIN_MAX_ATTEMPTS} submissions per
+ * {@link LOGIN_THROTTLE_WINDOW_MS}, and further submissions inside that window
+ * are refused with 429 and a `Retry-After` header saying when to come back.
+ *
+ * Every submission counts, right credentials included — a correct password is
+ * exactly what an attacker is hunting for, so letting a success clear the
+ * counter would hand back the attempts it just spent.
+ *
+ * Built per call rather than shared at module scope, so each application
+ * instance (the server, a test app) counts on a store of its own.
+ *
+ * `now` is the clock the window runs on; tests inject one to step over a
+ * window instead of sleeping through it. It drives the store as well as the
+ * `Retry-After` arithmetic, or the two would disagree.
+ */
+export function throttleLogin({ now }: { now?: () => number } = {}) {
+  return createRateLimitMiddleware({
+    limit: LOGIN_MAX_ATTEMPTS,
+    windowMs: LOGIN_THROTTLE_WINDOW_MS,
+    store: new LoginThrottleStore(now),
+    now,
+    // Identity is the connection's own peer address. `trustProxy` stays off
+    // deliberately: no proxy sits in front of this app, so forwarded-for style
+    // headers are client-controlled and a client could pick a fresh identity
+    // per request. Where the peer address cannot be resolved at all, the
+    // framework buckets those requests under one shared key — throttled
+    // together rather than waved through.
+    trustProxy: false,
+    message: 'Too many login attempts. Please try again later.',
+  })
+}
