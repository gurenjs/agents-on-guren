diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..01e365f
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,38 @@
+import {
+  DatabaseApiTokenStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+// Tokens are `<id>|<secret>`: the row keeps the id and a SHA-256 of the secret,
+// never the secret itself, so a leaked table hands out no working credentials.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const API_RATE_LIMIT = 60
+const API_RATE_WINDOW_MS = 60_000
+
+// Authenticates `Authorization: Bearer <token>` as the token's owner. A missing,
+// malformed, unknown or revoked token answers 401 JSON before the controller runs.
+export const requireApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed on the token rather than the user, so each of a user's tokens gets its
+// own budget. Mounted after requireApiToken, which puts the token on the context.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) => {
+    // The window can close within the same second; never tell a client to retry "now".
+    const seconds = Math.min(60, Math.max(1, retryAfter))
+    ctx.header('Retry-After', seconds.toString())
+    return ctx.json({ message: 'Too many requests.', retryAfter: seconds }, 429)
+  },
+})
diff --git a/app/Http/Controllers/Api/PostController.ts b/app/Http/Controllers/Api/PostController.ts
