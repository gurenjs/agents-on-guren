diff --git a/tests/PostRevisions.test.ts b/tests/PostRevisions.test.ts
new file mode 100644
index 0000000..f7b6d86
--- /dev/null
+++ b/tests/PostRevisions.test.ts
@@ -0,0 +1,176 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests for the revision history. `bun test` sets NODE_ENV=test, so
+// config/database.ts points these at the test database, migrated here.
+// Mutating requests go through CSRF like a browser's would, so the app is
+// primed with `withCsrf()` once; `actingAs()` then signs each request in.
+
+const PAGE = 'posts/Revisions'
+
+let sequence = 0
+
+async function createUser(): Promise<UserRecord> {
+  sequence += 1
+  return User.create({
+    name: `Author ${sequence}`,
+    email: `author-${Date.now()}-${sequence}@example.com`,
+    password: 'secret',
+  })
+}
+
+async function createPost(author: UserRecord, title = 'First'): Promise<PostRecord> {
+  return Post.forceCreate({
+    title,
+    excerpt: `${title} excerpt`,
+    body: `${title} body`,
+    authorId: author.id,
+  })
+}
+
+function payload(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function revisionsOf(post: PostRecord) {
+  return PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'First')
+    expect(await revisionsOf(post)).toHaveLength(0)
+
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second')).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await revisionsOf(post)
+    expect(revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(revisions[0]).toMatchObject({ postId: post.id, excerpt: 'Second excerpt', body: 'Second body' })
+    expect(new Date(revisions[0]!.createdAt).toISOString()).toBe(revisions[0]!.createdAt)
+
+    const current = await Post.findOrFail(post.id)
+    expect(current.title).toBe('Third')
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const author = await createUser()
+    const stranger = await createUser()
+    const post = await createPost(author)
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' }).assertStatus(422)
+    await http.actingAs(stranger).put(`/posts/${post.id}`, payload('Hijacked')).assertForbidden()
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'First')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Third')).assertRedirect()
+    const [second, first] = await revisionsOf(post)
+
+    // An Inertia visit gets the page as JSON, which is what the props check reads.
+    await http
+      .actingAs(author)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${post.id}/revisions`)
+      .assertOk()
+      .assertInertia(PAGE, {
+        revisions: [
+          { id: second!.id, title: 'Second', createdAt: second!.createdAt },
+          { id: first!.id, title: 'First', createdAt: first!.createdAt },
+        ],
+      })
+  })
+
+  it('restores a revision, keeping the version it replaces', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'First')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Third')).assertRedirect()
+    const [, first] = await revisionsOf(post)
+
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first!.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const current = await Post.findOrFail(post.id)
+    expect(current).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+    expect(current.authorId).toBe(author.id)
+
+    const revisions = await revisionsOf(post)
+    expect(revisions.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('answers 404 for a revision of a different post, even by the same author', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'Mine')
+    const other = await createPost(author, 'Other')
+    await http.actingAs(author).put(`/posts/${other.id}`, payload('Other edited')).assertRedirect()
+    const [otherRevision] = await revisionsOf(other)
+
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/${otherRevision!.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+
+  it('refuses other signed-in users with 403', async () => {
+    const author = await createUser()
+    const stranger = await createUser()
+    const post = await createPost(author, 'First')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second')).assertRedirect()
+    const [revision] = await revisionsOf(post)
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(stranger).post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionsOf(post)).toHaveLength(1)
+  })
+
+  it('sends guests to the login page', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'First')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Second')).assertRedirect()
+    const [revision] = await revisionsOf(post)
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionsOf(post)).toHaveLength(1)
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const author = await createUser()
+    const post = await createPost(author, 'Doomed')
+    const other = await createPost(author, 'Kept')
+    await http.actingAs(author).put(`/posts/${post.id}`, payload('Doomed edited')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${other.id}`, payload('Kept edited')).assertRedirect()
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+})
