new file mode 100644
index 0000000..687924d
--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,42 @@
+import { Controller } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../../config/database.js'
+
+const DB_CHECK_TIMEOUT_MS = 3000
+
+// bun:sqlite queries run synchronously, so this guards against a hang inside
+// `fn` itself rather than a pending Promise — a defensive backstop, not the
+// common case for a local SQLite file.
+function runWithTimeout<T>(fn: () => T, ms: number): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`timed out after ${ms}ms`)), ms)
+    try {
+      resolve(fn())
+    } catch (error) {
+      reject(error)
+    } finally {
+      clearTimeout(timer)
+    }
+  })
+}
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    try {
+      // Real round trip on every probe — a stale "ok" here is exactly the
+      // failure mode this endpoint exists to catch (see task background).
+      const db = (await getDatabase()) as SQLiteBunDatabase
+      await runWithTimeout(() => db.get(sql`select 1`), DB_CHECK_TIMEOUT_MS)
+
+      return this.json({ status: 'ok', checks: { db: { status: 'ok' } } })
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error)
+
+      return this.json(
+        { status: 'error', checks: { db: { status: 'error', message } } },
+        { status: 503 },
+      )
+    }
+  }
+}
