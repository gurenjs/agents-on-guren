--- /dev/null
+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,19 @@
+import { Command } from '@guren/core'
+import { Post, isScheduled } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later, soonest first (id, title, published_at; tab-separated)'
+
+  async handle(): Promise<void> {
+    const posts = await Post.newQuery().whereNotNull('publishedAt').get()
+    const now = new Date()
+    const lines = posts
+      .filter((post) => isScheduled(post, now))
+      .sort((a, b) => new Date(a.publishedAt!).getTime() - new Date(b.publishedAt!).getTime() || a.id - b.id)
+      .map((post) => `${post.id}\t${post.title}\t${post.publishedAt}\n`)
+
+    // Raw stdout: the report is piped into other tools, so no decoration.
+    process.stdout.write(lines.join(''))
+  }
+}
