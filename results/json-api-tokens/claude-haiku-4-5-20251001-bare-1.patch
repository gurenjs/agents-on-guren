@@ -0,0 +1,31 @@
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+
+export default async function BearerTokenAuth(c: any, next: any): Promise<Response> {
+  const authHeader = c.req.header('Authorization')
+
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    return c.json({ message: 'Unauthorized' }, { status: 401 })
+  }
+
+  const token = authHeader.slice(7)
+
+  if (!token) {
+    return c.json({ message: 'Unauthorized' }, { status: 401 })
+  }
+
+  const apiToken = await ApiToken.newQuery()
+    .where('tokenHash', TokenService.hashToken(token))
+    .first()
+
+  if (!apiToken) {
+    return c.json({ message: 'Unauthorized' }, { status: 401 })
+  }
+
+  c.set('apiTokenId', apiToken.id)
+  c.set('apiTokenUserId', apiToken.userId)
+  ;(c.req as any).apiTokenId = apiToken.id
+  ;(c.req as any).apiTokenUserId = apiToken.userId
+
+  return next()
+}
diff --git a/app/Http/Middleware/RateLimit.ts b/app/Http/Middleware/RateLimit.ts
new file mode 100644
index 0000000..77a926d
--- /dev/null
+++ b/app/Http/Middleware/RateLimit.ts
@@ -0,0 +1,43 @@
+interface RateLimitBucket {
+  count: number
+  resetTime: number
+}
+
+const rateLimitBuckets = new Map<number, RateLimitBucket>()
+const REQUESTS_PER_MINUTE = 60
+
+export default async function RateLimit(c: any, next: any): Promise<Response> {
+  const apiTokenId = c.get('apiTokenId')
+
+  if (!apiTokenId) {
+    return next()
+  }
+
+  const now = Date.now()
+  let bucket = rateLimitBuckets.get(apiTokenId)
+
+  if (!bucket || now >= bucket.resetTime) {
+    bucket = {
+      count: 0,
+      resetTime: now + 60000,
+    }
+    rateLimitBuckets.set(apiTokenId, bucket)
+  }
+
+  bucket.count++
+
+  if (bucket.count > REQUESTS_PER_MINUTE) {
+    const secondsUntilReset = Math.ceil((bucket.resetTime - now) / 1000)
+    return c.json(
+      { message: 'Too many requests' },
+      {
+        status: 429,
+        headers: {
+          'Retry-After': Math.min(secondsUntilReset, 60).toString(),
+        },
+      }
+    )
+  }
+
+  return next()
+}
