diff --git a/app/Http/Middleware/ApiAuth.ts b/app/Http/Middleware/ApiAuth.ts
new file mode 100644
index 0000000..61e5fee
--- /dev/null
+++ b/app/Http/Middleware/ApiAuth.ts
@@ -0,0 +1,19 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Support/ApiTokens.js'
+
+export const REQUESTS_PER_MINUTE = 60
+
+export const bearerAuth = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Runs after bearerAuth, so the bucket is the verified token and requests
+// with bad credentials never create one.
+export const tokenRateLimit = createRateLimitMiddleware({
+  limit: REQUESTS_PER_MINUTE,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => String(getApiToken(c)?.token.id),
+  message: 'Too many requests.',
+})
