diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..64d55ea
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,103 @@
+import { existsSync } from 'node:fs'
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { Attachment } from '../config/attachments.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 1, 2, 3, 4])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: { bytes: Uint8Array; type: string; name: string }) {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  if (cover) data.append('cover', new File([cover.bytes.slice().buffer as ArrayBuffer], cover.name, { type: cover.type }))
+  return data
+}
+
+const fields = { title: 'Hello', excerpt: 'Short', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  async function authed() {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function coverUrlOf(id: number): Promise<string | null> {
+    const [post] = await Post.withAttachments([await Post.findOrFail(id)], ['cover'])
+    return post.cover?.url ?? null
+  }
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const client = await authed()
+    await client.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+    const url = (await coverUrlOf(post.id))!
+    expect(url).toBeTruthy()
+
+    const served = await http.get(url)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toContain('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    await client.put(`/posts/${post.id}`, form(fields, { bytes: JPEG, type: 'image/jpeg', name: 'b.jpg' })).assertRedirect()
+    expect(await Attachment.newQuery().count()).toBe(1)
+    expect((await http.get(url)).status).toBe(404)
+    const newUrl = (await coverUrlOf(post.id))!
+    expect((await http.get(newUrl)).headers.get('content-type')).toContain('image/jpeg')
+
+    await client.put(`/posts/${post.id}`, form(fields)).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBe(newUrl)
+
+    await client.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBeNull()
+    expect(await Attachment.newQuery().count()).toBe(0)
+    expect((await http.get(newUrl)).status).toBe(404)
+
+    await client.put(`/posts/${post.id}`, form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const last = (await coverUrlOf(post.id))!
+    await client.delete(`/posts/${post.id}`).assertRedirect()
+    expect(await Attachment.newQuery().count()).toBe(0)
+    expect((await http.get(last)).status).toBe(404)
+    expect(existsSync('./public/storage')).toBe(false)
+  })
+
+  it('refuses a GIF and an oversized PNG without saving anything', async () => {
+    const client = await authed()
+    await client
+      .json()
+      .post('/posts', form(fields, { bytes: GIF, type: 'image/gif', name: 'a.gif' }))
+      .assertUnprocessable()
+      .assertJsonPath('errors.cover.0', 'Cover must be a PNG or JPEG image.')
+
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await client.json().post('/posts', form(fields, { bytes: big, type: 'image/png', name: 'big.png' })).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+
+  it('keeps the old cover when an edit upload is refused', async () => {
+    const client = await authed()
+    await client.post('/posts', form(fields, { bytes: PNG, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+    const url = await coverUrlOf(post.id)
+
+    await client.json().put(`/posts/${post.id}`, form(fields, { bytes: GIF, type: 'image/gif', name: 'a.gif' })).assertUnprocessable()
+    expect(await coverUrlOf(post.id)).toBe(url)
+  })
+})
