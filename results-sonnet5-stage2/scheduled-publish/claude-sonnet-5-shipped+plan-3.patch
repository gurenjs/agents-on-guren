diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..b00fcbf
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,48 @@
+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass' })
+    other = await User.create({ name: 'B', email: 'b@example.com', password: 'secret-pass' })
+  })
+
+  const make = (publishedAt: string | null) =>
+    Post.forceCreate({ title: 'Later match', excerpt: 'e', body: 'b', authorId: author.id, publishedAt })
+
+  it('hides a scheduled post from guests and others, shows it to the author', async () => {
+    const post = await make(new Date(Date.now() + 86_400_000).toISOString())
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other as never).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author as never).get(`/posts/${post.id}`).assertOk()
+    const res = await http.json().query('/posts/search', { keywords: ['match'] })
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(0)
+  })
+
+  it('shows a post once its time has passed', async () => {
+    const post = await make(new Date(Date.now() - 3_600_000).toISOString())
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('rejects an unparsable publishAt', async () => {
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
