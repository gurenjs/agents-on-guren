new file mode 100644
index 0000000..b4a6859
--- /dev/null
+++ b/app/Http/HealthCheck.ts
@@ -0,0 +1,27 @@
+import { createHealthManager, DatabaseCheck, type DatabaseConnection, type Middleware } from '@guren/core'
+import { getDatabase } from '../../config/database.js'
+
+// The raw Drizzle SQLite handle (drizzle-orm/bun-sqlite) exposes `run()`,
+// not the `query()` shape DatabaseCheck expects — adapt it.
+const appDatabaseConnection: DatabaseConnection = {
+  async query(sql) {
+    const db = (await getDatabase()) as { run(query: string): unknown }
+    return db.run(sql)
+  },
+}
+
+/**
+ * Builds a `/health` route handler backed by the given database connection.
+ * Exported so tests can wire a failing connection and assert the 503 path
+ * without touching the real database.
+ */
+export function createHealthCheckHandler(connection: DatabaseConnection): Middleware {
+  const health = createHealthManager()
+  // `critical: true` — a failed database check drags the overall report to
+  // "unhealthy" (and the response to 503); otherwise it would only degrade
+  // to a still-200 "degraded" report, and a bad deploy would stay in rotation.
+  health.register(new DatabaseCheck(connection), { critical: true })
+  return health.middleware()
+}
+
+export const healthCheckHandler = createHealthCheckHandler(appDatabaseConnection)
