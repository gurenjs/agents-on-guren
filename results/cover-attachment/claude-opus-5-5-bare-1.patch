+  form.set('excerpt', 'An excerpt')
+  form.set('body', 'A body')
+  for (const [key, value] of Object.entries(extra)) form.set(key, value)
+  return form
+}
+
+async function coverRows(postId: number) {
+  return Attachment.where({ attachableType: 'Post', attachableId: String(postId) })
+}
+
+async function coverUrl(http: TestApp, postId: number): Promise<string | null> {
+  const response = await http.withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+  const page = (await response.json()) as { props: { post: { coverUrl: string | null } } }
+  return page.props.post.coverUrl
+}
+
+async function latestPostId(title: string): Promise<number | undefined> {
+  const posts = (await Post.where({ title })) as Array<{ id: number }>
+  return posts.at(-1)?.id
+}
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const guest = await TestApp.fromApp(app)
+    await guest.get('/health')
+    const author = (await User.where({ email: 'demo@example.com' }))[0] as UserRecord
+    http = await guest.actingAs(author).withCsrf('/posts')
+  })
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    await http.post('/posts', postForm('Cover post', { cover: new File([PNG], 'a.png', { type: 'image/png' }) })).assertRedirect()
+    const id = (await latestPostId('Cover post'))!
+
+    const url = (await coverUrl(http, id))!
+    expect(url).toBeString()
+    const served = await http.get(url)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+    const [first] = (await coverRows(id)) as Array<{ disk: string; path: string }>
+    expect(existsSync(`./storage/app/testing/${first!.path}`)).toBe(true)
+
+    // Replacing
+    await http.put(`/posts/${id}`, postForm('Cover post', { cover: new File([JPEG], 'b.jpg', { type: 'image/jpeg' }) })).assertRedirect()
+    const replaced = (await coverUrl(http, id))!
+    expect((await http.get(replaced)).headers.get('content-type')).toBe('image/jpeg')
+    expect((await http.get(url)).status).not.toBe(200)
+    expect(existsSync(`./storage/app/testing/${first!.path}`)).toBe(false)
+    expect(await coverRows(id)).toHaveLength(1)
+
+    // Editing without a file keeps it
+    await http.put(`/posts/${id}`, postForm('Cover post')).assertRedirect()
+    expect(await coverRows(id)).toHaveLength(1)
+
+    // A rejected cover on edit keeps the old one
+    await http.json().put(`/posts/${id}`, postForm('Cover post', { cover: new File([GIF], 'c.gif', { type: 'image/gif' }) })).assertStatus(422)
+    expect(await coverRows(id)).toHaveLength(1)
+
+    // Removing
+    await http.put(`/posts/${id}`, postForm('Cover post', { removeCover: '1' })).assertRedirect()
+    expect(await coverUrl(http, id)).toBeNull()
+    expect(await coverRows(id)).toHaveLength(0)
+    expect((await http.get(replaced)).status).not.toBe(200)
+
+    // Deleted with the post
+    await http.put(`/posts/${id}`, postForm('Cover post', { cover: new File([PNG], 'a.png', { type: 'image/png' }) })).assertRedirect()
+    expect(await coverRows(id)).toHaveLength(1)
+    await http.delete(`/posts/${id}`).assertRedirect()
+    expect(await coverRows(id)).toHaveLength(0)
+  })
+
+  it('refuses a GIF or an oversized file and saves nothing', async () => {
+    await http
+      .json()
+      .post('/posts', postForm('Gif post', { cover: new File([GIF], 'c.gif', { type: 'image/gif' }) }))
+      .assertStatus(422)
+      .assertJsonPath('errors.cover', ['The cover must be a PNG or JPEG image.'])
+    expect(await latestPostId('Gif post')).toBeUndefined()
+
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http
+      .json()
+      .post('/posts', postForm('Big post', { cover: new File([big], 'big.png', { type: 'image/png' }) }))
+      .assertStatus(422)
+      .assertJsonPath('errors.cover', ['The cover must be 2 MB or smaller.'])
+    expect(await latestPostId('Big post')).toBeUndefined()
+  })
+
+  it('creates a post without a cover as before', async () => {
+    await http.post('/posts', postForm('Plain post')).assertRedirect()
+    const id = (await latestPostId('Plain post'))!
+    expect(await coverUrl(http, id)).toBeNull()
+  })
+})
