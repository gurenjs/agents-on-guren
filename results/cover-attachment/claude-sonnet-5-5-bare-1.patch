diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..baa0014
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,61 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2, 3])
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  return data
+}
+
+const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await app.boot?.()
+    const user = await User.forceCreate({
+      name: 'Cover Author',
+      email: `cover-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    http = (await (await TestApp.fromApp(app)).withCsrf()).actingAs(user)
+  })
+
+  it('stores, replaces, removes and deletes a cover', async () => {
+    const png = new File([PNG], 'a.png', { type: 'image/png' })
+    await http.post('/posts', form({ ...base, cover: png })).assertRedirect?.()
+    const post = (await Post.newQuery().orderBy('id', 'desc').first())!
+    const first = (await Attachment.newQuery().where('postId', post.id).first())!
+    expect(first.contentType).toBe('image/png')
+    expect(existsSync(new URL(`../storage/covers/${first.path}`, import.meta.url))).toBe(true)
+
+    const served = await app.fetch(new Request(`http://localhost/covers/${first.id}`))
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.arrayBuffer())).toEqual(PNG)
+
+    // A refused replacement keeps the old cover.
+    const gif = new File([GIF], 'a.gif', { type: 'image/gif' })
+    await http.put(`/posts/${post.id}`, form({ ...base, cover: gif })).assertStatus(422)
+    expect(await Attachment.newQuery().where('postId', post.id).count()).toBe(1)
+
+    await http.put(`/posts/${post.id}`, form({ ...base, cover: png })).assertRedirect?.()
+    const second = (await Attachment.newQuery().where('postId', post.id).first())!
+    expect(second.id).not.toBe(first.id)
+    expect(existsSync(new URL(`../storage/covers/${first.path}`, import.meta.url))).toBe(false)
+    expect((await app.fetch(new Request(`http://localhost/covers/${first.id}`))).status).toBe(404)
+
+    await http.put(`/posts/${post.id}`, form({ ...base, removeCover: '1' })).assertRedirect?.()
+    expect(await Attachment.newQuery().where('postId', post.id).count()).toBe(0)
+    expect(existsSync(new URL(`../storage/covers/${second.path}`, import.meta.url))).toBe(false)
+  })
+})
