+++ b/routes/auth.ts
@@ -1,14 +1,27 @@
 import type { Router } from '@guren/core'
+import { createRateLimitMiddleware } from '@guren/core'
 import LoginController from '../app/Http/Controllers/Auth/LoginController.js'
 import RegisterController from '../app/Http/Controllers/Auth/RegisterController.js'
 import DashboardController from '../app/Http/Controllers/DashboardController.js'
 import ProfileController from '../app/Http/Controllers/ProfileController.js'
 
+// Credential stuffing / brute force guard: 5 submissions per minute per
+// client IP, counting every attempt (successful or not). trustProxy stays
+// off — this app isn't behind a proxy in dev, and forwarded-for headers are
+// client-controlled — so the client's own connection address is the key.
+// When that address can't be determined, the middleware falls back to a
+// single shared bucket rather than skipping the limit, which fails closed
+// as intended.
+const loginRateLimit = createRateLimitMiddleware({
+  limit: 5,
+  windowMs: 60_000,
+})
+
 // Uses the 'auth' and 'guest' aliases routes/web.ts registers on this router.
 export function registerAuthRoutes(router: Router<'auth' | 'guest'>): void {
   router.middleware('guest').group((guest) => {
     guest.get('/login', [LoginController, 'show']).name('login')
-    guest.post('/login', [LoginController, 'store']).name('login.store')
+    guest.post('/login', [LoginController, 'store'], loginRateLimit).name('login.store')
     guest.get('/register', [RegisterController, 'show']).name('register')
     guest.post('/register', [RegisterController, 'store']).name('register.store')
   })
diff --git a/tests/LoginRateLimit.test.ts b/tests/LoginRateLimit.test.ts
