@@ -0,0 +1,48 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../Models/NewsletterSubscription.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.subscribe')
+
+    if (await NewsletterSubscription.first({ email: body.email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    await NewsletterSubscription.create({
+      email: body.email,
+      token: `${crypto.randomUUID()}${crypto.randomUUID()}`.replaceAll('-', ''),
+    })
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { params } = this.validated('newsletter.confirm')
+    const subscription = await NewsletterSubscription.first({ token: params.token })
+    if (!subscription) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date() })
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.unsubscribe')
+    await NewsletterSubscription.delete({ email: body.email })
+    return this.redirect(this.backUrl())
+  }
+
+  // Only a same-origin Referer is followed, so the redirect cannot be used to leave the site.
+  private backUrl(): string {
+    const referer = this.ctx.req.header('referer')
+    if (!referer) return '/'
+    try {
+      const target = new URL(referer)
+      if (target.origin !== new URL(this.ctx.req.url).origin) return '/'
+      return `${target.pathname}${target.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
