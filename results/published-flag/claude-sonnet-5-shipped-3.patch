diff --git a/tests/PostController.drafts.test.ts b/tests/PostController.drafts.test.ts
new file mode 100644
index 0000000..a3660e2
--- /dev/null
+++ b/tests/PostController.drafts.test.ts
@@ -0,0 +1,122 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+async function createUser(email: string) {
+  return User.create({ name: 'Test User', email, password: 'secret123' })
+}
+
+async function createPost(authorId: number, overrides: Partial<{ title: string; published: boolean }> = {}) {
+  return Post.forceCreate({
+    title: overrides.title ?? 'Untitled',
+    excerpt: 'An excerpt with a distinctive keyword: zorbnax',
+    body: 'Body text',
+    authorId,
+    published: overrides.published ?? true,
+  })
+}
+
+describe('post drafts', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('creating a post without `published` produces a draft', async () => {
+    const author = await createUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'My Draft', excerpt: 'excerpt', body: 'body' })
+      .assertRedirect()
+
+    const post = await Post.first({ title: 'My Draft' })
+    expect(post?.published).toBe(false)
+  })
+
+  it('creating a post with published: true makes it public immediately', async () => {
+    const author = await createUser('author2@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'My Live Post', excerpt: 'excerpt', body: 'body', published: true })
+      .assertRedirect()
+
+    const post = await Post.first({ title: 'My Live Post' })
+    expect(post?.published).toBe(true)
+
+    await http.json().get(`/posts/${post!.id}`).assertOk().assertJsonPath('props.post.published', true)
+  })
+
+  it('hides a draft from guests and other users on the index, but shows it to its author', async () => {
+    const author = await createUser('a@example.com')
+    const other = await createUser('b@example.com')
+    const draft = await createPost(author.id, { title: 'Secret Draft', published: false })
+    await createPost(author.id, { title: 'Public Post', published: true })
+
+    const guestRes = await http.json().get('/posts')
+    const guestBody = await guestRes.json<{ props: { data: Array<{ title: string }> } }>()
+    expect(guestBody.props.data.some((p) => p.title === draft.title)).toBe(false)
+
+    const otherRes = await http.actingAs(other).json().get('/posts')
+    const otherBody = await otherRes.json<{ props: { data: Array<{ title: string }> } }>()
+    expect(otherBody.props.data.some((p) => p.title === draft.title)).toBe(false)
+
+    const authorRes = await http.actingAs(author).json().get('/posts')
+    const authorBody = await authorRes.json<{ props: { data: Array<{ title: string }> } }>()
+    expect(authorBody.props.data.some((p) => p.title === draft.title)).toBe(true)
+  })
+
+  it('answers 404 for a draft post page to guests and other users, 200 to its author', async () => {
+    const author = await createUser('c@example.com')
+    const other = await createUser('d@example.com')
+    const draft = await createPost(author.id, { title: 'Hidden', published: false })
+
+    await http.get(`/posts/${draft.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${draft.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${draft.id}`).assertOk()
+  })
+
+  it('excludes drafts from search results for guests, but includes them for the author', async () => {
+    const author = await createUser('e@example.com')
+    const draft = await createPost(author.id, { title: 'Zorbnax Draft', published: false })
+
+    const guestResults = await http.query('/posts/search', { keywords: ['zorbnax'] })
+    const guestJson = await guestResults.json<{ data: Array<{ title: string }> }>()
+    expect(guestJson.data.some((p) => p.title === draft.title)).toBe(false)
+
+    const authorResults = await http.actingAs(author).query('/posts/search', { keywords: ['zorbnax'] })
+    const authorJson = await authorResults.json<{ data: Array<{ title: string }> }>()
+    expect(authorJson.data.some((p) => p.title === draft.title)).toBe(true)
+  })
+
+  it('publishing a draft via update makes it visible to guests', async () => {
+    const author = await createUser('f@example.com')
+    const draft = await createPost(author.id, { title: 'To Publish', published: false })
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${draft.id}`, { title: draft.title, excerpt: draft.excerpt, body: draft.body, published: true })
+      .assertRedirect()
+
+    await http.get(`/posts/${draft.id}`).assertOk()
+  })
+
+  it('unpublishing a post via update hides it from guests again', async () => {
+    const author = await createUser('g@example.com')
+    const live = await createPost(author.id, { title: 'To Unpublish', published: true })
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${live.id}`, { title: live.title, excerpt: live.excerpt, body: live.body, published: false })
+      .assertRedirect()
+
+    await http.get(`/posts/${live.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${live.id}`).assertOk()
+  })
+})
