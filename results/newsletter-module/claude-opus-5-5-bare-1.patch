+import type { Router } from '@guren/core'
+import NewsletterSubscriptionController from './app/Http/Controllers/NewsletterSubscriptionController.js'
+
+// Mounted under the module's '/newsletter' prefix (see ./index.ts).
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', [NewsletterSubscriptionController, 'subscribe']).name('newsletter.subscribe')
+  router.get('/confirm/:token', [NewsletterSubscriptionController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', [NewsletterSubscriptionController, 'unsubscribe']).name('newsletter.unsubscribe')
+}
diff --git a/modules/newsletter/tests/NewsletterSubscriptionController.test.ts b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
new file mode 100644
index 0000000..ff81cc5
--- /dev/null
+++ b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { migrateDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+// Each test uses its own address, so the suite needs no truncation between runs.
+const uniqueEmail = (label: string) => `${label}-${crypto.randomUUID()}@example.com`
+
+describe('newsletter subscriptions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const booted = await TestApp.fromApp(app)
+    http = (await booted.withCsrf('/')).withHeader('Referer', 'http://localhost/posts?page=2')
+  })
+
+  it('stores a pending subscription and redirects back', async () => {
+    const email = uniqueEmail('subscribe')
+
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts?page=2')
+
+    const [row] = await NewsletterSubscription.where({ email }).get()
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects an invalid address', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    expect(await NewsletterSubscription.where({ email: 'not-an-email' }).get()).toHaveLength(0)
+  })
+
+  it('rejects an address that is already subscribed', async () => {
+    const email = uniqueEmail('duplicate')
+    await http.post('/newsletter/subscribe', { email }).assertRedirect()
+
+    await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+    expect(await NewsletterSubscription.where({ email }).get()).toHaveLength(1)
+  })
+
+  it('confirms a subscription by token', async () => {
+    const email = uniqueEmail('confirm')
+    await http.post('/newsletter/subscribe', { email }).assertRedirect()
+    const [row] = await NewsletterSubscription.where({ email }).get()
+
+    await http.get(`/newsletter/confirm/${row!.token}`).assertRedirect('/')
+
+    const [confirmed] = await NewsletterSubscription.where({ email }).get()
+    expect(confirmed?.confirmedAt).not.toBeNull()
+  })
+
+  it('answers 404 for a token that was never issued', async () => {
+    await http.get('/newsletter/confirm/never-issued-token-0000').assertStatus(404)
+  })
+
+  it('deletes only the unsubscribed address', async () => {
+    const leaving = uniqueEmail('leaving')
+    const staying = uniqueEmail('staying')
+    await http.post('/newsletter/subscribe', { email: leaving }).assertRedirect()
+    await http.post('/newsletter/subscribe', { email: staying }).assertRedirect()
+
+    await http.post('/newsletter/unsubscribe', { email: leaving }).assertRedirect('/posts?page=2')
+
+    expect(await NewsletterSubscription.where({ email: leaving }).get()).toHaveLength(0)
+    expect(await NewsletterSubscription.where({ email: staying }).get()).toHaveLength(1)
+  })
+})
