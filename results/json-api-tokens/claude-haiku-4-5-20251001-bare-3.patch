diff --git a/app/Services/RateLimitService.ts b/app/Services/RateLimitService.ts
new file mode 100644
index 0000000..d56f22e
--- /dev/null
+++ b/app/Services/RateLimitService.ts
@@ -0,0 +1,45 @@
+const REQUESTS_PER_MINUTE = 60
+
+interface RateLimitEntry {
+  count: number
+  resetTime: number
+}
+
+const rateLimits = new Map<number, RateLimitEntry>()
+
+export class RateLimitService {
+  static checkLimit(tokenId: number): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const entry = rateLimits.get(tokenId)
+
+    if (!entry || now >= entry.resetTime) {
+      rateLimits.set(tokenId, {
+        count: 1,
+        resetTime: now + 60000,
+      })
+      return { allowed: true }
+    }
+
+    entry.count++
+    if (entry.count > REQUESTS_PER_MINUTE) {
+      const retryAfter = Math.ceil((entry.resetTime - now) / 1000)
+      return { allowed: false, retryAfter }
+    }
+
+    return { allowed: true }
+  }
+
+  static cleanup(): void {
+    const now = Date.now()
+    for (const [tokenId, entry] of rateLimits.entries()) {
+      if (now >= entry.resetTime) {
+        rateLimits.delete(tokenId)
+      }
+    }
+  }
+}
+
+// Cleanup every minute
+if (typeof setInterval !== 'undefined') {
+  setInterval(() => RateLimitService.cleanup(), 60000)
+}
