+function ApiTokens({ tokens }: { tokens: ApiTokenSummary[] }) {
+  const [name, setName] = useState('')
+  const [created, setCreated] = useState<{ name: string; token: string } | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [busy, setBusy] = useState(false)
+
+  async function create(event: FormEvent) {
+    event.preventDefault()
+    setBusy(true)
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.store', { body: { name } })
+      if (response.status === 422) {
+        const payload = (await response.json()) as { errors?: Record<string, string[]> }
+        setError(payload.errors?.name?.[0] ?? 'Enter a name of 1 to 50 characters.')
+        return
+      }
+      if (!response.ok) {
+        setError('Could not create the token.')
+        return
+      }
+      const payload = (await response.json()) as { name: string; token: string }
+      setCreated(payload)
+      setName('')
+      router.reload({ only: ['tokens'] })
+    } catch {
+      setError('Could not create the token — check your connection and try again.')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  async function revoke(id: string) {
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.destroy', { params: { id } })
+      if (!response.ok) {
+        setError('Could not revoke the token.')
+        return
+      }
+      router.reload({ only: ['tokens'] })
+    } catch {
+      setError('Could not revoke the token — check your connection and try again.')
+    }
+  }
+
+  return (
+    <section className="mt-6 space-y-6 rounded-g-card border border-g-line bg-g-panel p-8 shadow-g-card">
+      <header>
+        <h2 className="text-xl font-bold text-g-heading">API tokens</h2>
+        <p className="mt-2 text-sm text-g-text-2">
+          Scripts authenticate with <code>Authorization: Bearer &lt;token&gt;</code>. Each token is shown once, when
+          it is created.
+        </p>
+      </header>
+
+      {created ? (
+        <div className="space-y-1 border-y border-g-line py-2.5 text-sm">
+          <p className="text-g-text">
+            Token <strong>{created.name}</strong> created. Copy it now; it will not be shown again.
+          </p>
+          <code className="block break-all rounded-g-ctl bg-g-bg px-3 py-2 font-mono text-xs text-g-heading">
+            {created.token}
+          </code>
+        </div>
+      ) : null}
+
+      <form className="flex gap-2" onSubmit={create}>
+        <input
+          type="text"
+          value={name}
+          maxLength={50}
+          onChange={(event) => setName(event.target.value)}
+          placeholder="Token name, e.g. CI"
+          className={inputClass}
+        />
+        <button
+          type="submit"
+          disabled={busy}
+          className="mt-1 shrink-0 rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent transition hover:bg-g-accent-down disabled:cursor-not-allowed disabled:opacity-45"
+        >
+          Create token
+        </button>
+      </form>
+      {error ? <p className="text-sm text-g-danger">{error}</p> : null}
+
+      {tokens.length === 0 ? (
+        <p className="text-sm text-g-muted">No tokens yet.</p>
+      ) : (
+        <ul className="divide-y divide-g-line">
+          {tokens.map((token) => (
+            <li key={token.id} className="flex items-center justify-between gap-4 py-2.5 text-sm">
+              <div>
+                <p className="font-bold text-g-heading">{token.name}</p>
+                <p className="text-xs text-g-text-2">
+                  Created {new Date(token.createdAt).toLocaleDateString()}
+                  {token.lastUsedAt ? ` · last used ${new Date(token.lastUsedAt).toLocaleString()}` : ' · never used'}
+                </p>
+              </div>
+              <button
+                type="button"
+                onClick={() => revoke(token.id)}
+                className="rounded-g-ctl border border-g-line-strong px-3 py-1.5 text-xs font-bold text-g-danger transition hover:bg-g-bg"
+              >
+                Revoke
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
