diff --git a/app/Support/CoverStorage.ts b/app/Support/CoverStorage.ts
new file mode 100644
index 0000000..08a0f8a
--- /dev/null
+++ b/app/Support/CoverStorage.ts
@@ -0,0 +1,55 @@
+import { mkdir, unlink } from 'node:fs/promises'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+const ROOT = fileURLToPath(new URL('../../storage/attachments', import.meta.url))
+
+const TYPES = {
+  'image/png': { extension: 'png', magic: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a] },
+  'image/jpeg': { extension: 'jpg', magic: [0xff, 0xd8, 0xff] },
+} as const
+
+type CoverType = keyof typeof TYPES
+
+/** The type comes from the bytes, not the client-declared content type. */
+async function sniff(file: File): Promise<{ type: CoverType; bytes: Uint8Array } | null> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  for (const [type, { magic }] of Object.entries(TYPES) as [CoverType, (typeof TYPES)[CoverType]][]) {
+    if (magic.every((byte, index) => bytes[index] === byte)) return { type, bytes }
+  }
+  return null
+}
+
+/** Throws the 422 for the `cover` field unless the file is really a PNG or JPEG. */
+export async function checkCover(file: File): Promise<{ type: CoverType; bytes: Uint8Array }> {
+  const sniffed = await sniff(file)
+  if (!sniffed) throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image.' })
+  return sniffed
+}
+
+export async function storeCover(
+  postId: number,
+  cover: { type: CoverType; bytes: Uint8Array },
+): Promise<AttachmentRecord> {
+  await mkdir(ROOT, { recursive: true })
+  const path = `${crypto.randomUUID()}.${TYPES[cover.type].extension}`
+  await Bun.write(join(ROOT, path), cover.bytes)
+  try {
+    const record = await Attachment.create({ postId, path, mimeType: cover.type, size: cover.bytes.length })
+    return record as AttachmentRecord
+  } catch (error) {
+    await unlink(join(ROOT, path)).catch(() => {})
+    throw error
+  }
+}
+
+export async function removeCover(attachment: AttachmentRecord): Promise<void> {
+  await Attachment.delete({ id: attachment.id })
+  await unlink(join(ROOT, attachment.path)).catch(() => {})
+}
+
+export function coverFile(attachment: AttachmentRecord): Bun.BunFile {
+  return Bun.file(join(ROOT, attachment.path))
+}
