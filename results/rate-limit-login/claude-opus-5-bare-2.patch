@@ -0,0 +1,36 @@
+import { MemoryRateLimitStore, createRateLimitMiddleware } from '@guren/core'
+
+/** A client may submit the login form this many times per window. */
+export const LOGIN_ATTEMPT_LIMIT = 5
+
+/** Length of the throttling window, in milliseconds. */
+export const LOGIN_ATTEMPT_WINDOW_MS = 60_000
+
+/**
+ * Counters live in memory: this is a single process, and losing the counts on
+ * a restart only costs an attacker a window they already had to wait for.
+ * Exported so tests can clear the counts between cases.
+ */
+export const loginAttemptStore = new MemoryRateLimitStore()
+
+/**
+ * Throttles login submissions to {@link LOGIN_ATTEMPT_LIMIT} per client per
+ * minute, so a stolen password list cannot be walked through the form. Every
+ * submission counts, right credentials included — a successful login is
+ * exactly what a credential-stuffing run is looking for, so it must not buy
+ * more attempts.
+ *
+ * The client is the connection's own address. `trustProxy` stays off (the
+ * default): nothing terminates TLS in front of this app, so `X-Forwarded-For`
+ * and friends are attacker-controlled and would hand out a fresh bucket per
+ * request. When the address cannot be read at all, the built-in key generator
+ * falls back to a single shared bucket — the requests still count, rather than
+ * slipping through unthrottled.
+ */
+export const LoginThrottleMiddleware = createRateLimitMiddleware({
+  limit: LOGIN_ATTEMPT_LIMIT,
+  windowMs: LOGIN_ATTEMPT_WINDOW_MS,
+  store: loginAttemptStore,
+  keyPrefix: 'login:',
+  message: 'Too many login attempts. Please try again later.',
+})
