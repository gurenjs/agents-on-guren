diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..ef857dc
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,156 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { kernel } from '../src/console.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2036-10-01T09:00:00.000Z'
+const PAST = '2020-01-01T09:00:00.000Z'
+
+type PostProps = { data?: Array<{ id: number; publishedAt: string | null }>; post?: { id: number; publishedAt: string | null } }
+
+async function props(response: Response): Promise<PostProps> {
+  const { payload } = await readInertiaResponse(response)
+  return payload.props as PostProps
+}
+
+async function searchIds(client: TestApp, keyword: string): Promise<number[]> {
+  const res = await client.query('/posts/search', { keywords: [keyword] })
+  res.assertOk()
+  const body = await res.json<{ data: Array<{ id: number }> }>()
+  return body.data.map((post) => post.id)
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let asAuthor: TestApp
+  let asOther: TestApp
+  let scheduled: PostRecord
+  let live: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-pass' })) as UserRecord
+    other = (await User.create({ name: 'Reader', email: 'reader@example.com', password: 'secret-pass' })) as UserRecord
+    asAuthor = await http.actingAs(author).withCsrf('/posts')
+    asOther = await http.actingAs(other).withCsrf('/posts')
+
+    live = (await Post.forceCreate({ title: 'Launch recap', excerpt: 'public', body: 'x', authorId: author.id })) as PostRecord
+    scheduled = (await Post.forceCreate({
+      title: 'Launch announcement',
+      excerpt: 'embargoed',
+      body: 'x',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as PostRecord
+  })
+
+  it('rejects a publish date that is not a date and time, saving nothing', async () => {
+    const before = await Post.newQuery().count()
+    await asAuthor
+      .json()
+      .post('/posts', { title: 'Bad date', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+      .assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('stores a future publishAt as published_at and publishes now when omitted', async () => {
+    await asAuthor.json().post('/posts', { title: 'Scheduled via form', excerpt: 'e', body: 'b', publishAt: FUTURE }).assertRedirect()
+    const created = await Post.first({ title: 'Scheduled via form' })
+    expect(created?.publishedAt).toBe(FUTURE)
+
+    await asAuthor.json().post('/posts', { title: 'Immediate via form', excerpt: 'e', body: 'b' }).assertRedirect()
+    expect((await Post.first({ title: 'Immediate via form' }))?.publishedAt).toBeNull()
+  })
+
+  it('hides a scheduled post page from guests and other users, shows it to its author', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await asOther.get(`/posts/${scheduled.id}`).assertNotFound()
+
+    const res = await asAuthor.get(`/posts/${scheduled.id}`)
+    res.assertOk()
+    expect((await props(res.raw)).post?.publishedAt).toBe(FUTURE)
+
+    await http.get(`/posts/${live.id}`).assertOk()
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const forGuest = (await props((await http.get('/posts')).raw)).data ?? []
+    expect(forGuest.map((p) => p.id)).toContain(live.id)
+    expect(forGuest.map((p) => p.id)).not.toContain(scheduled.id)
+
+    const forOther = (await props((await asOther.get('/posts')).raw)).data ?? []
+    expect(forOther.map((p) => p.id)).not.toContain(scheduled.id)
+
+    const forAuthor = (await props((await asAuthor.get('/posts')).raw)).data ?? []
+    const mine = forAuthor.find((p) => p.id === scheduled.id)
+    expect(mine?.publishedAt).toBe(FUTURE)
+  })
+
+  it('keeps a scheduled post out of search for guests and other users', async () => {
+    expect(await searchIds(http, 'Launch')).toEqual([live.id])
+    expect(await searchIds(asOther, 'Launch')).toEqual([live.id])
+    expect(await searchIds(asAuthor, 'Launch')).toContain(scheduled.id)
+  })
+
+  it('lets the author change or clear the date on edit', async () => {
+    await asAuthor.json().put(`/posts/${live.id}`, { title: live.title, excerpt: live.excerpt, body: live.body, publishAt: FUTURE }).assertRedirect()
+    expect((await Post.find(live.id))?.publishedAt).toBe(FUTURE)
+    await http.get(`/posts/${live.id}`).assertNotFound()
+
+    await asAuthor.json().put(`/posts/${live.id}`, { title: live.title, excerpt: live.excerpt, body: live.body, publishAt: null }).assertRedirect()
+    expect((await Post.find(live.id))?.publishedAt).toBeNull()
+    await http.get(`/posts/${live.id}`).assertOk()
+  })
+
+  it('reports scheduled posts soonest first, tab-separated, and nothing else', async () => {
+    const sooner = (await Post.forceCreate({
+      title: 'Sooner',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: '2036-01-01T00:00:00.000Z',
+    })) as PostRecord
+    await Post.forceCreate({ title: 'Already out', excerpt: 'e', body: 'b', authorId: author.id, publishedAt: PAST })
+    const viaForm = await Post.first({ title: 'Scheduled via form' })
+
+    const output = new BufferedOutput()
+    kernel.setOutput(output)
+    expect(await kernel.handle(['posts:scheduled'])).toBe(0)
+    expect(output.getLines()).toEqual([
+      `${sooner.id}\tSooner\t2036-01-01T00:00:00.000Z`,
+      `${scheduled.id}\tLaunch announcement\t${FUTURE}`,
+      `${viaForm?.id}\tScheduled via form\t${FUTURE}`,
+    ])
+
+    const proc = Bun.spawn(['bun', 'bin/console.ts', 'posts:scheduled'], {
+      cwd: process.cwd(),
+      env: { ...process.env, NODE_ENV: 'test' },
+      stdout: 'pipe',
+      stderr: 'pipe',
+    })
+    const [stdout, exitCode] = await Promise.all([new Response(proc.stdout).text(), proc.exited])
+    expect(exitCode).toBe(0)
+    expect(stdout).toBe(
+      `${sooner.id}\tSooner\t2036-01-01T00:00:00.000Z\n` +
+        `${scheduled.id}\tLaunch announcement\t${FUTURE}\n` +
+        `${viaForm?.id}\tScheduled via form\t${FUTURE}\n`,
+    )
+  })
+
+  it('makes a post public to everyone once its time has passed', async () => {
+    await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    await asOther.get(`/posts/${scheduled.id}`).assertOk()
+    const forGuest = (await props((await http.get('/posts')).raw)).data ?? []
+    expect(forGuest.map((p) => p.id)).toContain(scheduled.id)
+    expect(await searchIds(http, 'announcement')).toEqual([scheduled.id])
+  })
+})
