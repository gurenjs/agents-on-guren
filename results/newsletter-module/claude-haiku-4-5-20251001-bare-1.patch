@@ -0,0 +1,24 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const testApp = await TestApp.fromApp(app)
+    http = await testApp.withCsrf('/')
+  })
+
+  it('rejects invalid email on subscribe', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+  })
+
+  it('rejects empty email on subscribe', async () => {
+    await http.post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+  })
+
+  it('rejects invalid email on unsubscribe', async () => {
+    await http.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertStatus(422)
+  })
+})
