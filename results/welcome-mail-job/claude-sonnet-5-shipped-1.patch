@@ -0,0 +1,14 @@
+import { ServiceProvider, setMailManager } from '@guren/core'
+import { mailManager } from '../../config/mail.js'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('mail', () => mailManager)
+  }
+
+  boot(): void {
+    // Queue jobs send mail through the global manager (getMailManager()),
+    // not the container, so it has to be set explicitly here too.
+    setMailManager(mailManager)
+  }
+}
