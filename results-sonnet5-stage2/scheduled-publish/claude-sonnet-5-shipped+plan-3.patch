+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,19 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'Print scheduled posts as <id>\\t<title>\\t<published_at>, soonest first'
+
+  async handle(): Promise<void> {
+    const posts = await Post.newQuery().where('publishedAt', '>', new Date().toISOString()).get()
+    // Compared as instants: stored strings may differ in format.
+    const ordered = posts.sort(
+      (a, b) => Date.parse(a.publishedAt as string) - Date.parse(b.publishedAt as string) || a.id - b.id,
+    )
+
+    for (const post of ordered) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+  }
+}
