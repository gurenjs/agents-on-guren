diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..4467c4c
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,72 @@
+import {
+  defineModel,
+  type BelongsToRecord,
+  type HasManyRecord,
+  type TransactionHandle,
+  type WithRelations,
+} from '@guren/core'
+import { comments } from '../../db/schema.js'
+import { CommentReport, type CommentReportRecord } from './CommentReport.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+export type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+/** Reports by this many different users hide a comment from the post page. */
+export const REPORTS_TO_HIDE = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` comes from the route and `userId` from the signed-in user, never
+  // from request input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: {
+    author: BelongsToRecord<CommentAuthorSummary>
+    reports: HasManyRecord<CommentReportRecord>
+  } = {
+    author: null,
+    reports: [],
+  }
+
+  /**
+   * The comments a post page shows, oldest first. Hidden ones are left out for
+   * every viewer, but stay in the table for review.
+   */
+  static async visibleOn(postId: number): Promise<CommentWithAuthor[]> {
+    // comment_reports holds one row per (comment, user), so the row count is
+    // the number of different reporters.
+    const counted = await Comment.withCount('reports', { postId })
+    const hidden = counted.filter((comment) => comment.reportsCount >= REPORTS_TO_HIDE).map((comment) => comment.id)
+
+    const visible = await Comment.newQuery()
+      .with('author')
+      .where('postId', postId)
+      .whereNotIn('id', hidden)
+      .orderBy('createdAt', 'asc')
+      // Comments written within the same millisecond share a timestamp.
+      .orderBy('id', 'asc')
+      .get()
+
+    return visible as CommentWithAuthor[]
+  }
+
+  /**
+   * Really deletes the matching comments, their reports first. The schema's
+   * cascade does the same, but only on a connection enforcing foreign keys.
+   */
+  static async purge(where: { id: number } | { postId: number }, trx: TransactionHandle): Promise<void> {
+    const doomed = await Comment.newQuery({ trx }).where(where).select('id').get()
+
+    await CommentReport.newQuery({ trx })
+      .whereIn(
+        'commentId',
+        doomed.map((comment) => comment.id),
+      )
+      .delete()
+    await Comment.delete(where, { trx })
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+Comment.hasMany('reports', CommentReport, 'commentId', 'id')
