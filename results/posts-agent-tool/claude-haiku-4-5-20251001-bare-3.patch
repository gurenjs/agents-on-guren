--- /dev/null
+++ b/routes/mcp.ts
@@ -0,0 +1,18 @@
+import { Router } from '@guren/core'
+import { mcpHandler } from '../app/Http/Controllers/McpController.js'
+
+export function registerMcpRoutes(baseRouter: Router): void {
+  baseRouter.post('/mcp', async (c) => {
+    const authHeader = c.req.header('authorization')
+    if (!authHeader) {
+      return c.json({ error: 'Unauthorized' }, 401)
+    }
+
+    const token = authHeader.replace(/^Bearer\s+/, '')
+    if (!token) {
+      return c.json({ error: 'Unauthorized' }, 401)
+    }
+
+    return mcpHandler(c)
+  })
+}
