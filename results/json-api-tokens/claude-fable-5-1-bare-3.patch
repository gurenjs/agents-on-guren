+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/ApiPostController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Http/Middleware/ApiToken.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// The JSON API for scripts, authenticated by a personal API token rather than
+// the session. A cookie-less bearer request is exempt from CSRF protection.
+export function registerApiRoutes(baseRouter: Router): void {
+  // Order matters: the limiter counts per token, so the token has to be
+  // verified first. An unauthenticated request is answered 401 uncounted.
+  const router = baseRouter
+    .aliasMiddleware('api.token', authenticateApiToken)
+    .aliasMiddleware('api.throttle', throttleApiToken)
+
+  router.group('/api', (api) => {
+    api.middleware('api.token', 'api.throttle').group((authed) => {
+      authed.get('/posts', {
+        name: 'api.posts.index',
+        resource: { data: [PostResource] },
+      }, [ApiPostController, 'index'])
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [ApiPostController, 'store'])
+    })
+  })
+}
