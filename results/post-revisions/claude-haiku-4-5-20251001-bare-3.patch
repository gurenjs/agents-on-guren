+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+
+const uniqueEmail = () => `test-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('creates a revision table', async () => {
+    // Verify the migration was applied by checking that we can query the table
+    const revisions = await PostRevision.newQuery().limit(1).get()
+    // If the table doesn't exist, this would throw an error
+  })
+
+  it('keeps a revision when editing a post', async () => {
+    const user = await User.forceCreate({
+      name: 'Test User',
+      email: uniqueEmail(),
+      password: 'test123',
+      passwordHash: 'hash',
+    } as any)
+
+    const post = await Post.forceCreate({
+      title: 'Original Title',
+      excerpt: 'Original Excerpt',
+      body: 'Original Body',
+      authorId: user.id,
+    })
+
+    // Simulate the controller logic: create a revision before updating
+    await PostRevision.create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+
+    // Update the post
+    await Post.update({ id: post.id }, {
+      title: 'Updated Title',
+      excerpt: 'Updated Excerpt',
+      body: 'Updated Body',
+    })
+
+    // Verify the revision was kept
+    const revisions = await PostRevision.where('postId', post.id).get()
+    const revision = revisions[0]
+
+    if (!revision) {
+      throw new Error('No revision found')
+    }
+
+    if (revision.title !== 'Original Title' || revision.body !== 'Original Body') {
+      throw new Error('Revision content mismatch')
+    }
+  })
+
+  it('lists revisions in descending order', async () => {
+    const user = await User.forceCreate({
+      name: 'Test User 2',
+      email: uniqueEmail(),
+      password: 'test123',
+      passwordHash: 'hash',
+    } as any)
+
+    const post = await Post.forceCreate({
+      title: 'First',
+      excerpt: 'First',
+      body: 'First',
+      authorId: user.id,
+    })
+
+    // Create first revision
+    await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'First',
+      body: 'First',
+    })
+
+    // Add a small delay to ensure different timestamps
+    await new Promise(resolve => setTimeout(resolve, 10))
+
+    // Update post and create second revision
+    await Post.update({ id: post.id }, {
+      title: 'Second',
+      excerpt: 'Second',
+      body: 'Second',
+    })
+
+    await PostRevision.create({
+      postId: post.id,
+      title: 'Second',
+      excerpt: 'Second',
+      body: 'Second',
+    })
+
+    // Get revisions ordered by id to be deterministic
+    const revisions = await PostRevision.where('postId', post.id).orderBy('id', 'desc').get()
+
+    if (revisions.length !== 2) {
+      throw new Error(`Expected 2 revisions, got ${revisions.length}`)
+    }
+
+    // Verify they're in descending order (newest first)
+    if (revisions[0].title !== 'Second') {
+      throw new Error('First revision should be Second')
+    }
+    if (revisions[1].title !== 'First') {
+      throw new Error('Second revision should be First')
+    }
+  })
+
+  it('manually deletes revisions when post is deleted', async () => {
+    const user = await User.forceCreate({
+      name: 'Test User 5',
+      email: uniqueEmail(),
+      password: 'test123',
+      passwordHash: 'hash',
+    } as any)
+
+    const post = await Post.forceCreate({
+      title: 'Test',
+      excerpt: 'Test',
+      body: 'Test',
+      authorId: user.id,
+    })
+
+    // Create a revision
+    await PostRevision.create({
+      postId: post.id,
+      title: 'Old Version',
+      excerpt: 'Old Version',
+      body: 'Old Version',
+    })
+
+    // Verify revision exists
+    let revisions = await PostRevision.where('postId', post.id).get()
+    if (revisions.length !== 1) {
+      throw new Error('Revision should exist before deletion')
+    }
+
+    // Simulate what the controller does: delete revisions before deleting post
+    await PostRevision.delete({ postId: post.id })
+    await Post.delete({ id: post.id })
+
+    // Verify revisions are deleted
+    revisions = await PostRevision.where('postId', post.id).get()
+    if (revisions.length !== 0) {
+      throw new Error('Revisions should be deleted when post is deleted')
+    }
+
+    // Verify post is deleted
+    const deletedPost = await Post.where('id', post.id).first()
+    if (deletedPost) {
+      throw new Error('Post should be deleted')
+    }
+  })
+})
