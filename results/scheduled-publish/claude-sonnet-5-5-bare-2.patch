@@ -0,0 +1,20 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish in the future (id, title, published_at; tab-separated)'
+
+  async handle(): Promise<void> {
+    const now = new Date().toISOString()
+    const posts = await Post.newQuery()
+      .where('publishedAt', '>', now)
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()
+
+    for (const post of posts) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+  }
+}
