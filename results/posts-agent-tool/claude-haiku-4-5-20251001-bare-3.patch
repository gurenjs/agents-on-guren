+import { buildToolRequest, mapToolResponse } from '@guren/server/agent'
+import type { DerivedAgentTool } from '@guren/server/agent'
+import type { Context } from 'hono'
+import type { AgentToolName } from '../../../.guren/agents.gen'
+import { agentTools } from '../../../.guren/agents.gen'
+import app from '../../../src/app.js'
+
+interface JsonRpcRequest {
+  jsonrpc: '2.0'
+  id: string | number | null
+  method: string
+  params?: Record<string, unknown>
+}
+
+interface JsonRpcResponse {
+  jsonrpc: '2.0'
+  id: string | number | null
+  result?: unknown
+  error?: {
+    code: number
+    message: string
+    data?: unknown
+  }
+}
+
+function getTools(): DerivedAgentTool[] {
+  // Convert the generated agent tools to DerivedAgentTool format
+  return Object.entries(agentTools).map(([, tool]) => {
+    const typedTool = tool as (typeof agentTools)[AgentToolName]
+    return {
+      ...typedTool,
+      annotations: {
+        readOnlyHint: typedTool.annotations.readOnlyHint,
+        destructiveHint: typedTool.annotations.destructiveHint,
+        idempotentHint: typedTool.annotations.idempotentHint,
+      },
+    } as any as DerivedAgentTool
+  })
+}
+
+async function handleRequest(c: Context, req: JsonRpcRequest): Promise<JsonRpcResponse | null> {
+  const id = req.id ?? null
+
+  if (!req.jsonrpc || req.jsonrpc !== '2.0') {
+    return { jsonrpc: '2.0', id, error: { code: -32600, message: 'Invalid Request' } }
+  }
+
+  if (!req.method) {
+    return { jsonrpc: '2.0', id, error: { code: -32600, message: 'Invalid Request' } }
+  }
+
+  try {
+    switch (req.method) {
+      case 'initialize':
+        return {
+          jsonrpc: '2.0',
+          id,
+          result: {
+            protocolVersion: '2024-11-05',
+            capabilities: {},
+            serverInfo: {
+              name: 'Guren MCP Server',
+              version: '1.0.0',
+            },
+          },
+        }
+
+      case 'tools/list':
+        return listTools(id)
+
+      case 'tools/call':
+        return await callTool(c, id, req.params as Record<string, unknown>)
+
+      default:
+        return { jsonrpc: '2.0', id, error: { code: -32601, message: 'Method not found' } }
+    }
+  } catch (error) {
+    return { jsonrpc: '2.0', id, error: { code: -32603, message: 'Internal error' } }
+  }
+}
+
+function listTools(id: string | number | null): JsonRpcResponse {
+  const tools = getTools()
+
+  const toolsData = tools.map((tool) => ({
+    name: tool.toolName,
+    description: tool.description || '',
+    inputSchema: tool.inputSchema,
+    annotations: {
+      readOnly: tool.annotations.readOnlyHint ?? false,
+    },
+  }))
+
+  return {
+    jsonrpc: '2.0',
+    id,
+    result: {
+      tools: toolsData,
+    },
+  }
+}
+
+async function callTool(
+  c: Context,
+  id: string | number | null,
+  params?: Record<string, unknown>,
+): Promise<JsonRpcResponse> {
+  if (!params || typeof params.name !== 'string' || typeof params.arguments !== 'object') {
+    return {
+      jsonrpc: '2.0',
+      id,
+      error: { code: -32602, message: 'Invalid params' },
+    }
+  }
+
+  const tools = getTools()
+  const tool = tools.find((t) => t.toolName === params.name)
+
+  if (!tool) {
+    return {
+      jsonrpc: '2.0',
+      id,
+      error: { code: -32602, message: 'Tool not found' },
+    }
+  }
+
+  try {
+    const authHeader = c.req.header('authorization')
+
+    const built = buildToolRequest(tool, params.arguments as Record<string, unknown>, {
+      authorization: authHeader,
+    })
+
+    if ('missing' in built || 'invalidPath' in built) {
+      return {
+        jsonrpc: '2.0',
+        id,
+        error: { code: -32602, message: 'Invalid tool arguments' },
+      }
+    }
+
+    const response = await app.fetch(built.request)
+    const outcome = await mapToolResponse(tool, response)
+
+    return {
+      jsonrpc: '2.0',
+      id,
+      result: {
+        content: outcome.content,
+        isError: outcome.isError || false,
+      },
+    }
+  } catch (error) {
+    return {
+      jsonrpc: '2.0',
+      id,
+      error: { code: -32603, message: 'Internal error' },
+    }
+  }
+}
+
+export async function mcpHandler(c: Context): Promise<Response> {
+  try {
+    const body = await c.req.json()
+
+    const requests = Array.isArray(body) ? body : [body]
+    const responses: JsonRpcResponse[] = []
+
+    for (const req of requests) {
+      const response = await handleRequest(c, req)
+      if (response) {
+        responses.push(response)
+      }
+    }
+
+    if (responses.length === 0) {
+      return new Response(null, { status: 204 })
+    }
+
+    if (responses.length === 1 && !Array.isArray(body)) {
+      return c.json(responses[0])
+    }
+
+    return c.json(responses)
+  } catch (error) {
+    return c.json({ jsonrpc: '2.0', id: null, error: { code: -32603, message: 'Internal error' } })
+  }
+}
