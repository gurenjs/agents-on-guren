diff --git a/app/Http/Middleware/ApiTokenRateLimit.ts b/app/Http/Middleware/ApiTokenRateLimit.ts
new file mode 100644
index 0000000..13441d7
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenRateLimit.ts
@@ -0,0 +1,44 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken, type ApiTokenRecord } from '../../Models/ApiToken.js'
+
+const RATE_LIMIT = 60
+const MINUTE_MS = 60 * 1000
+
+export const apiTokenRateLimit = defineMiddleware(async (c, next) => {
+  const apiToken = c.get('apiToken') as ApiTokenRecord | undefined
+
+  if (!apiToken) {
+    return next()
+  }
+
+  const now = new Date()
+  const lastRequestTime = apiToken.lastRequestTime ? new Date(apiToken.lastRequestTime) : null
+  const isNewWindow = !lastRequestTime || now.getTime() - lastRequestTime.getTime() >= MINUTE_MS
+
+  let requestsThisMinute = isNewWindow ? 0 : apiToken.requestsThisMinute
+
+  requestsThisMinute++
+
+  if (requestsThisMinute > RATE_LIMIT) {
+    const retryAfter = Math.ceil((apiToken.lastRequestTime
+      ? new Date(apiToken.lastRequestTime).getTime() + MINUTE_MS - now.getTime()
+      : MINUTE_MS) / 1000)
+
+    const response = new Response(JSON.stringify({ message: 'Too many requests.' }), {
+      status: 429,
+      headers: {
+        'Content-Type': 'application/json',
+        'Retry-After': Math.min(retryAfter, 60).toString(),
+      },
+    })
+
+    return response
+  }
+
+  await ApiToken.update({ id: apiToken.id }, {
+    requestsThisMinute,
+    lastRequestTime: now.toISOString(),
+  })
+
+  return next()
+})
diff --git a/app/Http/Middleware/BearerTokenAuth.ts b/app/Http/Middleware/BearerTokenAuth.ts
new file mode 100644
index 0000000..8c8d564
--- /dev/null
+++ b/app/Http/Middleware/BearerTokenAuth.ts
@@ -0,0 +1,43 @@
+import { defineMiddleware, HttpException } from '@guren/core'
+import { createHash } from 'crypto'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { User } from '../../Models/User.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export function hashToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+export async function generateToken(): Promise<string> {
+  const bytes = new Uint8Array(32)
+  crypto.getRandomValues(bytes)
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+export const requireBearerToken = defineMiddleware(async (c, next) => {
+  const authHeader = c.req.header('authorization')
+
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    throw HttpException.unauthorized('Unauthenticated.')
+  }
+
+  const token = authHeader.slice(7)
+  const tokenHash = hashToken(token)
+
+  const apiToken = await ApiToken.where({ tokenHash }).first()
+
+  if (!apiToken) {
+    throw HttpException.unauthorized('Unauthenticated.')
+  }
+
+  const user = await User.find(apiToken.userId)
+
+  if (!user) {
+    throw HttpException.unauthorized('Unauthenticated.')
+  }
+
+  c.set('apiToken', apiToken)
+  c.set('user', user as UserRecord)
+
+  return next()
+})
