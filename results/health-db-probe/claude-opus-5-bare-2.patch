+import { HealthCheck, type CheckResult } from '@guren/core'
+import { getDatabase, type AppDatabase } from '../../config/database.js'
+
+/** Opens (or reuses) the app connection. Injectable so tests can fail it. */
+export type DatabaseConnector = () => Promise<AppDatabase>
+
+const connectToDatabase: DatabaseConnector = async () => (await getDatabase()) as AppDatabase
+
+/**
+ * Verifies the database on every probe with the cheapest round trip SQLite
+ * offers. Deliberately not memoized: a cached verdict is exactly what kept a
+ * deploy with an unreachable database in the load-balancer pool.
+ */
+export class DatabaseHealthCheck extends HealthCheck {
+  readonly name: string
+  private readonly connect: DatabaseConnector
+
+  constructor(connect: DatabaseConnector = connectToDatabase, name = 'database') {
+    super()
+    this.connect = connect
+    this.name = name
+  }
+
+  async check(): Promise<CheckResult> {
+    try {
+      const db = await this.connect()
+      await db.get('select 1')
+
+      return this.healthy('Database answered a round trip')
+    } catch (error) {
+      // One catch for both failure modes: the connection cannot be opened, or
+      // the query itself throws. A timeout is handled by the HealthManager,
+      // which races every check against its configured budget.
+      return this.handleError(error, 'Database is unreachable')
+    }
+  }
+}
