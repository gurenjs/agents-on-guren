diff --git a/app/Http/Middleware/ApiTokenMiddleware.ts b/app/Http/Middleware/ApiTokenMiddleware.ts
new file mode 100644
index 0000000..b088421
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenMiddleware.ts
@@ -0,0 +1,22 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiTokenOrFail } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokens.js'
+import { User } from '../../Models/User.js'
+
+// One answer for a missing, malformed, unknown and revoked token alike, so a
+// caller probing for valid token ids learns nothing from the difference.
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(userId),
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Runs after authenticateApiToken: the counter is keyed on the verified token,
+// so each token of one user gets its own allowance. Counters live in this
+// process's memory — a multi-process deployment needs a shared `store`.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) => ctx.json({ message: 'Too many requests.', retryAfter }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
new file mode 100644
index 0000000..3f34587
--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,23 @@
+import { Resource } from '@guren/core'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// Carries no credential: neither the digest nor anything it derives from.
+export class ApiTokenResource extends Resource<ApiTokenRecord, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: token.createdAt.toISOString(),
+      lastUsedAt: token.lastUsedAt?.toISOString() ?? null,
+    }
+  }
+}
