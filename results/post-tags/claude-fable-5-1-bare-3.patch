+  static async syncTags(postId: number, names: readonly string[], options: { trx?: TransactionHandle } = {}): Promise<void> {
+    const existingTags = names.length > 0 ? await Tag.newQuery(options).whereIn('name', names).get() : []
+    const idsByName = new Map(existingTags.map((tag) => [tag.name, tag.id]))
