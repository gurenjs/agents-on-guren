diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..fbbe09a
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,220 @@
+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('creates a token with valid name', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().post('/profile/tokens', { name: 'CI Token' }).assertCreated()
+
+      const json = (await response.json()) as any
+      expect(json.id).toBeDefined()
+      expect(json.name).toBe('CI Token')
+      expect(json.token).toBeDefined()
+      expect(json.token.length).toBeGreaterThanOrEqual(48)
+    })
+
+    it('rejects empty name', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    })
+
+    it('rejects name over 50 characters', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.json().post('/profile/tokens', { name: 'a'.repeat(51) }).assertUnprocessable()
+    })
+
+    it('requires authentication', async () => {
+      const response = await http.json().post('/profile/tokens', { name: 'Token' })
+      expect(response.status).toBe(403)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('deletes user own token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'To Delete' })
+      const json = (await createRes.json()) as any
+
+      await csrf.delete(`/profile/tokens/${json.id}`).assertNoContent()
+
+      const token = await ApiToken.find(json.id)
+      expect(token).toBeNull()
+    })
+
+    it('rejects deletion of other users token', async () => {
+      const other = await User.create({
+        name: 'Other User',
+        email: 'other@example.com',
+        password: 'password123',
+      })
+
+      const otherHttp = await http.actingAs(other).withCsrf()
+      const tokenRes = await otherHttp.json().post('/profile/tokens', { name: 'Other Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.delete(`/profile/tokens/${tokenJson.id}`).assertNotFound()
+    })
+
+    it('requires authentication', async () => {
+      const response = await http.delete('/profile/tokens/1')
+      expect(response.status).toBe(403)
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    it('lists posts with valid token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Read Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      const response = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .get('/api/posts')
+        .assertOk()
+
+      const json = (await response.json()) as any
+      expect(Array.isArray(json.data)).toBe(true)
+    })
+
+    it('rejects invalid token', async () => {
+      const response = await http
+        .json()
+        .withHeader('Authorization', 'Bearer invalid-token')
+        .get('/api/posts')
+
+      expect(response.status).toBe(401)
+    })
+
+    it('rejects request without token', async () => {
+      const response = await http.json().get('/api/posts')
+      expect(response.status).toBe(401)
+    })
+
+    it('rejects revoked token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Revoke Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      await csrf.delete(`/profile/tokens/${tokenJson.id}`).assertNoContent()
+
+      const response = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .get('/api/posts')
+
+      expect(response.status).toBe(401)
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it('creates post with valid token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Write Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      const response = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .post('/api/posts', {
+          title: 'API Post',
+          excerpt: 'Test excerpt',
+          body: 'Test body content',
+        })
+        .assertCreated()
+
+      const json = (await response.json()) as any
+      expect(json.data.title).toBe('API Post')
+      expect(json.data.authorId).toBe(user.id)
+    })
+
+    it('ignores authorId in request body', async () => {
+      const other = await User.create({
+        name: 'Other User 2',
+        email: 'other2@example.com',
+        password: 'password123',
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Write Token 2' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      const response = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .post('/api/posts', {
+          title: 'Spoofed Author',
+          excerpt: 'Test',
+          body: 'Test body',
+          authorId: other.id,
+        })
+        .assertCreated()
+
+      const json = (await response.json()) as any
+      expect(json.data.authorId).toBe(user.id)
+    })
+
+    it('rejects invalid payload', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Invalid Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .post('/api/posts', {
+          title: '',
+          excerpt: '',
+          body: '',
+        })
+        .assertUnprocessable()
+    })
+
+    it('rejects request without token', async () => {
+      const response = await http.json().post('/api/posts', {
+        title: 'No Auth',
+        excerpt: 'Test',
+        body: 'Test',
+      })
+
+      expect([401, 403]).toContain(response.status)
+    })
+  })
+
+  describe('Rate limiting', () => {
+    it('includes rate limit status in response headers', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const tokenRes = await csrf.json().post('/profile/tokens', { name: 'Rate Token' })
+      const tokenJson = (await tokenRes.json()) as any
+
+      const res = await http
+        .json()
+        .withHeader('Authorization', `Bearer ${tokenJson.token}`)
+        .get('/api/posts')
+
+      expect(res.status).toBe(200)
+    })
+  })
+})
