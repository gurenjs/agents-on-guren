diff --git a/tests/PostExcerpt.test.ts b/tests/PostExcerpt.test.ts
new file mode 100644
index 0000000..c37c575
--- /dev/null
+++ b/tests/PostExcerpt.test.ts
@@ -0,0 +1,76 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+const LONG_BODY =
+  'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+
+const LONG_BODY_EXCERPT =
+  'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+
+describe('post excerpt fallback', () => {
+  let http: TestApp
+  // Signed in as the author with session + XSRF cookies primed: the mutating
+  // post routes sit behind both auth and CSRF.
+  let asAuthor: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({
+      name: 'Excerpt Writer',
+      email: 'writer@example.com',
+      password: 'secret',
+    })) as UserRecord
+    asAuthor = (await http.actingAs(author).withCsrf()).json()
+  })
+
+  it('derives the excerpt from the body when it is omitted on create', async () => {
+    await asAuthor.post('/posts', { title: 'Derived', body: LONG_BODY }).assertRedirect()
+
+    expect((await Post.first({ title: 'Derived' }))?.excerpt).toBe(LONG_BODY_EXCERPT)
+  })
+
+  it('derives the excerpt when it is only whitespace', async () => {
+    await asAuthor.post('/posts', { title: 'Blank', excerpt: '   ', body: 'A short body.' }).assertRedirect()
+
+    expect((await Post.first({ title: 'Blank' }))?.excerpt).toBe('A short body.')
+  })
+
+  it('keeps a provided excerpt, trimmed', async () => {
+    await asAuthor
+      .post('/posts', { title: 'Typed', excerpt: '  Hand written.  ', body: LONG_BODY })
+      .assertRedirect()
+
+    expect((await Post.first({ title: 'Typed' }))?.excerpt).toBe('Hand written.')
+  })
+
+  it('still refuses a blank title or body', async () => {
+    await asAuthor.post('/posts', { title: '  ', body: LONG_BODY }).assertUnprocessable()
+    await asAuthor.post('/posts', { title: 'Ok', body: '  ' }).assertUnprocessable()
+
+    expect(await Post.newQuery().count()).toBe(0)
+  })
+
+  it('re-derives from the new body when an update clears the excerpt', async () => {
+    const post = await Post.forceCreate({
+      title: 'Existing',
+      excerpt: 'Old teaser.',
+      body: 'Old body.',
+      authorId: author.id,
+    })
+
+    await asAuthor
+      .put(`/posts/${post?.id}`, { title: 'Existing', excerpt: '', body: 'A brand new body.' })
+      .assertRedirect()
+
+    expect((await Post.find(post?.id as number))?.excerpt).toBe('A brand new body.')
+  })
+})
diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..ccac036
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt, resolveExcerpt } from '../app/Support/excerpt.js'
+
+const SENTENCE = 'The quick brown fox jumps over the lazy dog. '
+
+describe('deriveExcerpt', () => {
+  it('returns a short body untouched, with no ellipsis', () => {
+    expect(deriveExcerpt('A tiny post.')).toBe('A tiny post.')
+  })
+
+  it('trims the body before measuring it', () => {
+    expect(deriveExcerpt('  \n A tiny post.\t ')).toBe('A tiny post.')
+  })
+
+  it('keeps a body of exactly 140 characters whole', () => {
+    const body = 'x'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('backs off to the last whitespace when the cut lands inside a word', () => {
+    // 150 characters; character 141 is the "u" of "quick".
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(body).toHaveLength(150)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+    expect(excerpt).toHaveLength(139)
+  })
+
+  it('keeps all 140 characters when the cut lands on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body).toHaveLength(170)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt).toHaveLength(141)
+  })
+
+  it('cuts at 140 when the opening is one unbroken run', () => {
+    const excerpt = deriveExcerpt('y'.repeat(200))
+    expect(excerpt).toBe(`${'y'.repeat(140)}…`)
+  })
+
+  it('appends a single U+2026 rather than three periods', () => {
+    const excerpt = deriveExcerpt(SENTENCE.repeat(10))
+    expect(excerpt.endsWith('…')).toBe(true)
+    expect(excerpt.endsWith('...')).toBe(false)
+  })
+})
+
+describe('resolveExcerpt', () => {
+  it('prefers a provided excerpt', () => {
+    expect(resolveExcerpt('Hand written.', SENTENCE.repeat(10))).toBe('Hand written.')
+  })
+
+  it('derives from the body when the excerpt is missing', () => {
+    expect(resolveExcerpt(undefined, 'A tiny post.')).toBe('A tiny post.')
+  })
+
+  it('derives from the body when the excerpt is blank or whitespace', () => {
+    expect(resolveExcerpt('', 'A tiny post.')).toBe('A tiny post.')
+    expect(resolveExcerpt('   \n\t ', 'A tiny post.')).toBe('A tiny post.')
+  })
+})
