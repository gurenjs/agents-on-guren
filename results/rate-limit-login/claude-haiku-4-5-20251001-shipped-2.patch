@@ -0,0 +1,70 @@
+const WINDOW_SIZE_MS = 60 * 1000 // 60 seconds
+const MAX_ATTEMPTS = 5
+
+interface AttemptRecord {
+  attempts: number
+  windowStart: number
+}
+
+const attempts = new Map<string, AttemptRecord>()
+
+export function getClientIP(request: Request): string {
+  const rawRequest = request as any
+
+  // Try to get from common socket/connection properties
+  if (rawRequest.socket?.remoteAddress) {
+    return rawRequest.socket.remoteAddress
+  }
+
+  if (rawRequest.connection?.remoteAddress) {
+    return rawRequest.connection.remoteAddress
+  }
+
+  // Try Bun's native request properties
+  if (rawRequest.ip) {
+    return rawRequest.ip
+  }
+
+  // Try Hono's env if available
+  if (rawRequest.env?.incoming?.socket?.remoteAddress) {
+    return rawRequest.env.incoming.socket.remoteAddress
+  }
+
+  // Fallback: treat as unknown shared client
+  // This ensures we still rate limit even if we can't determine the IP
+  return 'unknown'
+}
+
+export function resetLoginRateLimiter(): void {
+  attempts.clear()
+}
+
+export function checkLoginRateLimit(clientIP: string): { allowed: boolean; retryAfterSeconds?: number } {
+  const now = Date.now()
+  const record = attempts.get(clientIP)
+
+  if (!record) {
+    // No previous attempts, start new window
+    attempts.set(clientIP, { attempts: 1, windowStart: now })
+    return { allowed: true }
+  }
+
+  const windowElapsed = now - record.windowStart
+
+  if (windowElapsed >= WINDOW_SIZE_MS) {
+    // Window expired, start a new one
+    attempts.set(clientIP, { attempts: 1, windowStart: now })
+    return { allowed: true }
+  }
+
+  // Still in the same window
+  if (record.attempts >= MAX_ATTEMPTS) {
+    // Already at or over the limit
+    const retryAfterSeconds = Math.ceil((WINDOW_SIZE_MS - windowElapsed) / 1000)
+    return { allowed: false, retryAfterSeconds }
+  }
+
+  // Increment and allow
+  record.attempts++
+  return { allowed: true }
+}
