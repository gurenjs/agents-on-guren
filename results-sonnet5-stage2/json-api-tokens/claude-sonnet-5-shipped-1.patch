+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,73 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'password123' })
+  })
+
+  async function createToken(name = 'CI') {
+    const session = await http.actingAs(owner).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: number; name: string; token: string }>()
+  }
+
+  it('stores only a hash and authenticates bearer requests', async () => {
+    const created = await createToken()
+    const rows = await ApiToken.all()
+    expect(JSON.stringify(rows)).not.toContain(created.token)
+
+    const api = http.json().withHeader('Authorization', `Bearer ${created.token}`)
+    await api.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+      .assertCreated()
+      .assertJsonPath('data.authorId', owner.id)
+    await api.get('/api/posts').assertOk().assertJsonCount(1, 'data')
+    await api.post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+  })
+
+  it('rejects bad tokens, revocation applies, and limits per token', async () => {
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', 'Bearer nope').get('/api/posts').assertUnauthorized()
+
+    const a = await createToken('A')
+    const b = await createToken('B')
+    const apiA = http.json().withHeader('Authorization', `Bearer ${a.token}`)
+    const apiB = http.json().withHeader('Authorization', `Bearer ${b.token}`)
+
+    for (let i = 0; i < 60; i++) await apiA.get('/api/posts').assertOk()
+    const limited = await apiA.get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await apiB.get('/api/posts').assertOk()
+
+    const session = await http.actingAs(owner).withCsrf()
+    await session.json().delete(`/profile/tokens/${b.id}`).assertNoContent()
+    await apiB.get('/api/posts').assertUnauthorized()
+  })
+
+  it('validates names and hides other users tokens', async () => {
+    const session = await http.actingAs(owner).withCsrf()
+    await session.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+
+    const created = await createToken()
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'password123' })
+    const otherSession = await http.actingAs(other).withCsrf()
+    await otherSession.json().delete(`/profile/tokens/${created.id}`).assertNotFound()
+    await http.json().withHeader('Authorization', `Bearer ${created.token}`).get('/api/posts').assertOk()
+  })
+})
