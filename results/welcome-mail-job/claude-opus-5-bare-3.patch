@@ -0,0 +1,29 @@
+import type { MailAddress, MailConfig } from '@guren/core'
+import { appName } from './app.js'
+
+/**
+ * MAIL_MAILER decides how a message leaves the app: `log` writes it to the
+ * server output (the development default, so nothing is actually delivered),
+ * `resend` posts it to the Resend API in production, and `memory` keeps it
+ * in-process for tests to read back. Switching provider is an .env change —
+ * no code that sends mail knows which one is active.
+ */
+export function mailConfig(): MailConfig {
+  return {
+    default: process.env.MAIL_MAILER ?? 'log',
+    from: mailFrom(),
+    transports: {
+      log: { driver: 'log' },
+      memory: { driver: 'memory' },
+      resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+    },
+  }
+}
+
+/** The sender every message goes out as — MAIL_FROM_ADDRESS / MAIL_FROM_NAME. */
+export function mailFrom(): MailAddress {
+  return {
+    email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME ?? appName(),
+  }
+}
diff --git a/config/queue.ts b/config/queue.ts
new file mode 100644
index 0000000..581c30c
--- /dev/null
+++ b/config/queue.ts
@@ -0,0 +1,26 @@
+import { MemoryDriver, RedisDriver, SyncDriver, type QueueConfig } from '@guren/core'
+import { createRedisClient } from '@guren/core/redis'
+
+/**
+ * QUEUE_CONNECTION decides where a dispatched job goes:
+ *
+ * - `sync` runs it inline in the dispatching process — the development
+ *   default, so queued work happens with no worker to start.
+ * - `memory` holds it in this process until a Worker picks it up (tests).
+ * - `redis` hands it to the separate worker process `bunx guren queue:work`
+ *   runs, which is how production drains the queue.
+ *
+ * Nothing that dispatches a job knows which one is active.
+ */
+export function queueConfig(): QueueConfig {
+  return {
+    default: process.env.QUEUE_CONNECTION ?? 'sync',
+    drivers: {
+      sync: () => new SyncDriver(),
+      memory: () => new MemoryDriver(),
+      // Factories run only for the connection actually selected, so
+      // development and tests never open a Redis connection.
+      redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+    },
+  }
+}
diff --git a/docs/adr/0002-queue-the-welcome-email.md b/docs/adr/0002-queue-the-welcome-email.md
new file mode 100644
index 0000000..61f1d36
--- /dev/null
+++ b/docs/adr/0002-queue-the-welcome-email.md
@@ -0,0 +1,61 @@
+---
+type: adr
+status: stable
+entities: [User]
+related:
+  - app/Http/Controllers/Auth/RegisterController.ts
+  - app/Jobs/SendWelcomeEmailJob.ts
+  - app/Mail/WelcomeMail.ts
+  - app/Providers/QueueProvider.ts
+  - app/Providers/MailProvider.ts
+  - config/queue.ts
+  - config/mail.ts
+---
+
+# Queue the welcome email instead of sending it during sign-up
+
+## Context
+
+Every newly registered account gets a welcome email. The mail provider is
+slow and occasionally unavailable, so sending the message inside the
+registration request would make sign-up hang whenever the provider is slow
+and fail whenever it is down — a registration that succeeded in the
+database would still be reported to the visitor as an error.
+
+Registration was the first thing in this app to need either a queue or a
+mailer, so neither was wired up.
+
+## Decision
+
+`RegisterController.store()` dispatches `SendWelcomeEmailJob` and returns
+the same redirect to `/dashboard` as before. The message is composed and
+handed to the mail transport inside the job, so nothing in the request path
+waits on the provider. A refused registration throws before the dispatch and
+so queues nothing.
+
+Both subsystems are configured from `.env`, and neither the controller nor
+the job knows which backend is active:
+
+- `QUEUE_CONNECTION` — `sync` runs the job inline in development (no worker
+  to start), `redis` hands it to the `bunx guren queue:work` worker in
+  production. `config/queue.ts` maps the name to a driver;
+  `app/Providers/QueueProvider.ts` activates it and registers the job class,
+  which is how a worker resolves a queued message back to its class.
+- `MAIL_MAILER` — `log` writes the message to the server output in
+  development, `resend` delivers it in production. `config/mail.ts` maps the
+  name to a transport and carries the `MAIL_FROM_ADDRESS` /
+  `MAIL_FROM_NAME` sender; `app/Providers/MailProvider.ts` binds the manager
+  and publishes it for jobs, which run without a request and, in production,
+  in a process of their own.
+
+The job payload carries the name and address the account registered with
+rather than a user id, so the worker needs no database access to send.
+
+## Consequences
+
+Sign-up no longer depends on the mail provider being up, at the cost of a
+worker process in production: with `QUEUE_CONNECTION=redis` the welcome
+email is only delivered while `bunx guren queue:work` is running, and a
+delivery that keeps failing lands in the failed-jobs list
+(`bunx guren queue:failed`) rather than being visible at sign-up. Later
+mail — verification, password resets, notifications — inherits this wiring.
