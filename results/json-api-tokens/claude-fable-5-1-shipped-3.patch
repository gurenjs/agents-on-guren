+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { createUser, issueToken, withToken } from './support/apiTokens.js'
+
+describe('ApiTokenController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('answers 201 with the id, the name and the plain-text token', async () => {
+      const user = await createUser('ada@example.com')
+
+      const issued = await issueToken(http, user, 'old laptop')
+
+      expect(issued.name).toBe('old laptop')
+      expect(issued.id).toBeString()
+      const secret = issued.token.split('|')[1] ?? ''
+      expect(secret.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token every time', async () => {
+      const user = await createUser('ada@example.com')
+
+      const first = await issueToken(http, user)
+      const second = await issueToken(http, user)
+
+      expect(first.token).not.toBe(second.token)
+      expect(first.id).not.toBe(second.id)
+    })
+
+    it('stores neither the token nor its secret half', async () => {
+      const user = await createUser('ada@example.com')
+
+      const issued = await issueToken(http, user)
+
+      const rows = await ApiToken.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0]?.userId).toBe(user.id)
+      const secret = issued.token.split('|')[1] ?? ''
+      for (const value of Object.values(rows[0] ?? {})) {
+        expect(String(value)).not.toContain(secret)
+      }
+    })
+
+    it.each([
+      ['a missing name', {}],
+      ['an empty name', { name: '' }],
+      ['a blank name', { name: '   ' }],
+      ['a name over 50 characters', { name: 'x'.repeat(51) }],
+      ['a name that is not a string', { name: 42 }],
+    ])('rejects %s with 422 and creates nothing', async (_label, body) => {
+      const user = await createUser('ada@example.com')
+      const session = await http.actingAs(user).json().withCsrf()
+
+      const response = await session.post('/profile/tokens', body)
+
+      expect(response.status).toBe(422)
+      expect(await response.json<{ errors: Record<string, string[]> }>()).toHaveProperty('errors.name')
+      expect(await ApiToken.all()).toHaveLength(0)
+    })
+
+    it('accepts a name of exactly 50 characters', async () => {
+      const user = await createUser('ada@example.com')
+
+      const issued = await issueToken(http, user, 'x'.repeat(50))
+
+      expect(issued.name).toHaveLength(50)
+    })
+
+    it('gives a guest no token', async () => {
+      const guest = await http.json().withCsrf()
+
+      const response = await guest.post('/profile/tokens', { name: 'CI' })
+
+      expect([302, 303, 401]).toContain(response.status)
+      expect(await ApiToken.all()).toHaveLength(0)
+    })
+
+    it('does not accept a bearer token in place of a session', async () => {
+      const user = await createUser('ada@example.com')
+      const issued = await issueToken(http, user)
+
+      const response = await withToken(http, issued.token).post('/profile/tokens', { name: 'second' })
+
+      expect(response.status).not.toBe(201)
+      expect(await ApiToken.all()).toHaveLength(1)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('answers 204 and the token stops working, while the others keep working', async () => {
+      const user = await createUser('ada@example.com')
+      const revoked = await issueToken(http, user, 'old laptop')
+      const kept = await issueToken(http, user, 'CI')
+      await withToken(http, revoked.token).get('/api/posts').assertOk()
+
+      const session = await http.actingAs(user).json().withCsrf()
+      await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+
+      await withToken(http, revoked.token).get('/api/posts').assertUnauthorized()
+      await withToken(http, kept.token).get('/api/posts').assertOk()
+    })
+
+    it("answers 404 for another user's token and leaves it working", async () => {
+      const owner = await createUser('ada@example.com')
+      const other = await createUser('grace@example.com')
+      const issued = await issueToken(http, owner)
+
+      const session = await http.actingAs(other).json().withCsrf()
+      await session.delete(`/profile/tokens/${issued.id}`).assertNotFound()
+
+      await withToken(http, issued.token).get('/api/posts').assertOk()
+    })
+
+    it('answers 404 for an unknown id', async () => {
+      const user = await createUser('ada@example.com')
+
+      const session = await http.actingAs(user).json().withCsrf()
+      await session.delete('/profile/tokens/does-not-exist').assertNotFound()
+    })
+
+    it('does not let a guest revoke a token', async () => {
+      const user = await createUser('ada@example.com')
+      const issued = await issueToken(http, user)
+
+      const guest = await http.json().withCsrf()
+      const response = await guest.delete(`/profile/tokens/${issued.id}`)
+
+      expect([302, 303, 401]).toContain(response.status)
+      await withToken(http, issued.token).get('/api/posts').assertOk()
+    })
+  })
+
+  describe('GET /profile', () => {
+    it("lists the user's own tokens by name, without any credential", async () => {
+      const user = await createUser('ada@example.com')
+      const other = await createUser('grace@example.com')
+      const issued = await issueToken(http, user, 'CI')
+      await issueToken(http, other, 'not mine')
+
+      const response = await http.actingAs(user).withHeader('X-Inertia', 'true').get('/profile')
+
+      expect(response.status).toBe(200)
+      const page = await response.json<{ props: { tokens: Array<Record<string, unknown>> } }>()
+      expect(page.props.tokens).toHaveLength(1)
+      expect(page.props.tokens[0]).toMatchObject({ id: issued.id, name: 'CI' })
+      expect(JSON.stringify(page)).not.toContain(issued.token.split('|')[1] ?? issued.token)
+      expect(page.props.tokens[0]).not.toHaveProperty('hashedToken')
+    })
+  })
+})
