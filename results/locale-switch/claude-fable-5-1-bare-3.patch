diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..46cb8ef
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,40 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+import { LOCALE_COOKIE } from '../../../config/locales.js'
+
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+    const secure = new URL(this.request.url).protocol === 'https:'
+
+    // The framework's locale detection reads this cookie ahead of
+    // Accept-Language, so the pick outlives the browser's own preference.
+    return this.redirect(this.previousUrl(), {
+      headers: {
+        'Set-Cookie': `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${ONE_YEAR_IN_SECONDS}; SameSite=Lax; HttpOnly${secure ? '; Secure' : ''}`,
+      },
+    })
+  }
+
+  // Referer is a request header, so it only ever sends the reader somewhere on
+  // this site. Behind a proxy the public origin differs from the one this
+  // request arrived on; the path is still the page the reader was on.
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) {
+      return '/'
+    }
+    if (isSafeRedirectUrl(referer, this.request.url)) {
+      return referer
+    }
+
+    try {
+      const { pathname, search } = new URL(referer)
+      const path = `${pathname}${search}`
+      return path.startsWith('/') && !path.startsWith('//') ? path : '/'
+    } catch {
+      return '/'
+    }
+  }
+}
