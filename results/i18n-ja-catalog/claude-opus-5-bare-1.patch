diff --git a/tests/AuthLocalization.test.ts b/tests/AuthLocalization.test.ts
new file mode 100644
index 0000000..c01a85b
--- /dev/null
+++ b/tests/AuthLocalization.test.ts
@@ -0,0 +1,115 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readFileSync, readdirSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { resolve } from 'node:path'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The auth pages read their copy from lang/<locale>/auth.json through
+// useTranslation(), and the locale comes from Accept-Language. These tests
+// pin both halves: what the header resolves to, and that the two catalogs
+// stay in step so no page falls back to English for a stray label.
+const LANG_DIR = fileURLToPath(new URL('../lang', import.meta.url))
+
+const JAPANESE_BROWSER = 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7'
+
+type Catalog = { [key: string]: string | Catalog }
+
+function readCatalog(locale: string): Record<string, string> {
+  const dir = resolve(LANG_DIR, locale)
+  const flat: Record<string, string> = {}
+
+  for (const file of readdirSync(dir).filter((name) => name.endsWith('.json'))) {
+    const namespace = file.slice(0, -'.json'.length)
+    const messages = JSON.parse(readFileSync(resolve(dir, file), 'utf8')) as Catalog
+    flatten(messages, namespace, flat)
+  }
+
+  return flat
+}
+
+function flatten(messages: Catalog, prefix: string, into: Record<string, string>): void {
+  for (const [key, value] of Object.entries(messages)) {
+    const path = `${prefix}.${key}`
+    if (typeof value === 'string') {
+      into[path] = value
+    } else {
+      flatten(value, path, into)
+    }
+  }
+}
+
+/** `:name`-style placeholders, which every translation has to carry over. */
+function placeholders(message: string): string[] {
+  return (message.match(/:[a-zA-Z_][a-zA-Z0-9_]*/gu) ?? []).sort()
+}
+
+describe('translation catalogs', () => {
+  const en = readCatalog('en')
+  const ja = readCatalog('ja')
+
+  it('translates every English key into Japanese, and no others', () => {
+    expect(Object.keys(ja).sort()).toEqual(Object.keys(en).sort())
+  })
+
+  it('keeps every placeholder in the Japanese translation', () => {
+    for (const [key, message] of Object.entries(en)) {
+      expect([key, placeholders(ja[key] ?? '')]).toEqual([key, placeholders(message)])
+    }
+  })
+})
+
+describe('auth pages by Accept-Language', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function visit(path: string, acceptLanguage?: string) {
+    const client = acceptLanguage ? http.withHeader('Accept-Language', acceptLanguage) : http
+    const response = await client.get(path).assertOk()
+    const html = await response.text()
+
+    return {
+      html,
+      title: html.match(/<title[^>]*>([^<]*)<\/title>/u)?.[1],
+      locale: JSON.parse(
+        html.match(/window\.__INERTIA_PAGE__ = (.*);<\/script>/u)?.[1] ?? '{}',
+      ).props._i18n.locale as string,
+    }
+  }
+
+  const japanese = [JAPANESE_BROWSER, 'ja', 'ja-JP']
+  const english = [undefined, 'en', 'en-US,en;q=0.9', 'en-US,en;q=0.9,ja;q=0.5', 'fr-FR,fr;q=0.9']
+
+  for (const header of japanese) {
+    it(`renders /login in Japanese for '${header}'`, async () => {
+      const page = await visit('/login', header)
+      expect(page.locale).toBe('ja')
+      expect(page.title).toBe('ログイン')
+    })
+
+    it(`renders /register in Japanese for '${header}'`, async () => {
+      const page = await visit('/register', header)
+      expect(page.locale).toBe('ja')
+      expect(page.title).toBe('アカウント登録')
+    })
+  }
+
+  for (const header of english) {
+    it(`renders /login in English for '${header ?? 'no header'}'`, async () => {
+      const page = await visit('/login', header)
+      expect(page.locale).toBe('en')
+      expect(page.title).toBe('Sign in')
+      expect(page.html).not.toContain('ログイン')
+    })
+
+    it(`renders /register in English for '${header ?? 'no header'}'`, async () => {
+      const page = await visit('/register', header)
+      expect(page.locale).toBe('en')
+      expect(page.title).toBe('Sign up')
+      expect(page.html).not.toContain('アカウント登録')
+    })
+  }
+})
