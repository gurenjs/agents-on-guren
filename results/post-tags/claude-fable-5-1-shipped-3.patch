diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..c5e5ca3
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,245 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+interface InertiaPage<TProps> {
+  component: string
+  props: TProps
+}
+
+interface IndexProps {
+  data: PostResourceData[]
+  pagination: { meta: { total: number }; links: { pages: Array<{ page: number; url: string | null }> } }
+  tag: string | null
+}
+
+const draft = { title: 'Hello', excerpt: 'A first post.', body: 'Body text.' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function asAuthor(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function createPost(tags?: string, title = draft.title): Promise<number> {
+    const client = await asAuthor()
+    const response = await client.post('/posts', tags === undefined ? { ...draft, title } : { ...draft, title, tags })
+    expect(response.status).toBe(303)
+    const created = await Post.newQuery().orderBy('id', 'desc').first()
+    if (!created) {
+      throw new Error('The post was not saved.')
+    }
+    return created.id
+  }
+
+  async function page<TProps>(path: string): Promise<InertiaPage<TProps>> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path)
+    expect(response.status).toBe(200)
+    return response.json<InertiaPage<TProps>>()
+  }
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const rows = await PostTag.where({ postId }).get()
+    const tags = await Tag.where({ id: rows.map((row) => row.tagId) }).get()
+    return tags.map((tag) => tag.name).sort()
+  }
+
+  it('creates the tags a post names and shows them on the post page', async () => {
+    const id = await createPost('webdev, bun')
+
+    expect((await Tag.all()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await tagNamesOf(id)).toEqual(['bun', 'webdev'])
+
+    const show = await page<{ post: PostResourceData }>(`/posts/${id}`)
+    expect(show.component).toBe('posts/Show')
+    expect(show.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('reuses a tag another post already created', async () => {
+    await createPost('bun')
+    await createPost('bun, webdev')
+
+    expect((await Tag.all()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+  })
+
+  it('trims names, ignores empty entries and counts a repeated name once', async () => {
+    const id = await createPost(' bun ,bun,, ')
+
+    expect((await Tag.all()).map((tag) => tag.name)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('keeps names that differ only in case apart', async () => {
+    const id = await createPost('Bun, bun')
+
+    expect(await tagNamesOf(id)).toEqual(['Bun', 'bun'])
+  })
+
+  it('saves a post without tags when the field is missing or empty', async () => {
+    const missing = await createPost()
+    const empty = await createPost('')
+
+    expect(await PostTag.all()).toEqual([])
+    const show = await page<{ post: PostResourceData }>(`/posts/${missing}`)
+    expect(show.props.post.tags).toEqual([])
+    expect((await page<{ post: PostResourceData }>(`/posts/${empty}`)).props.post.tags).toEqual([])
+  })
+
+  it('detaches the tags an edit removes and keeps the tag itself', async () => {
+    const id = await createPost('bun, webdev')
+
+    const client = await asAuthor()
+    await client.put(`/posts/${id}`, { ...draft, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect((await Tag.all()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+    expect((await page<{ post: PostResourceData }>(`/posts/${id}`)).props.post.tags).toEqual(['bun'])
+  })
+
+  it('removes every tag when an edit leaves the field out', async () => {
+    const id = await createPost('bun, webdev')
+
+    const client = await asAuthor()
+    await client.put(`/posts/${id}`, draft).assertRedirect(`/posts/${id}`)
+
+    expect(await tagNamesOf(id)).toEqual([])
+  })
+
+  it('hands the edit form the current tags', async () => {
+    const id = await createPost('webdev, bun')
+
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${id}/edit`)
+    const edit = await response.json<InertiaPage<{ post: PostResourceData }>>()
+
+    expect(edit.component).toBe('posts/Edit')
+    expect(edit.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('refuses a broken tags field the way it refuses an empty title', async () => {
+    const client = await asAuthor()
+    const emptyTitle = await client.json().post('/posts', { ...draft, title: '' })
+    expect(emptyTitle.status).toBe(422)
+
+    const sixTags = await client.json().post('/posts', { ...draft, tags: 'a, b, c, d, e, f' })
+    expect(sixTags.status).toBe(emptyTitle.status)
+    expect((await sixTags.json<{ errors: Record<string, string[]> }>()).errors.tags).toEqual([
+      'A post may have at most 5 tags.',
+    ])
+
+    const longName = await client.json().post('/posts', { ...draft, tags: 'x'.repeat(31) })
+    expect(longName.status).toBe(emptyTitle.status)
+    expect((await longName.json<{ errors: Record<string, string[]> }>()).errors.tags).toEqual([
+      'Each tag must be 30 characters or fewer.',
+    ])
+
+    expect(await Post.all()).toEqual([])
+    expect(await Tag.all()).toEqual([])
+    expect(await PostTag.all()).toEqual([])
+  })
+
+  it('refuses an edit with a broken tags field and leaves the post as it was', async () => {
+    const id = await createPost('bun')
+
+    const client = await asAuthor()
+    await client
+      .json()
+      .put(`/posts/${id}`, { ...draft, title: 'Changed', tags: 'a, b, c, d, e, f' })
+      .assertUnprocessable()
+
+    expect((await Post.findOrFail(id)).title).toBe(draft.title)
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+  })
+
+  it('accepts the limits themselves: five tags, thirty characters', async () => {
+    const longest = 'x'.repeat(30)
+    const id = await createPost(`a, b, c, d, ${longest}`)
+
+    expect(await tagNamesOf(id)).toEqual(['a', 'b', 'c', 'd', longest])
+  })
+
+  it('lists every post with its tags on the unfiltered list', async () => {
+    await createPost('webdev, bun', 'Tagged')
+    await createPost(undefined, 'Untagged')
+
+    const index = await page<IndexProps>('/posts')
+
+    expect(index.component).toBe('posts/Index')
+    expect(index.props.tag).toBeNull()
+    expect(index.props.data.map((post) => [post.title, post.tags])).toEqual([
+      ['Untagged', []],
+      ['Tagged', ['bun', 'webdev']],
+    ])
+  })
+
+  it('filters the list by tag, newest first', async () => {
+    await createPost('bun', 'First')
+    await createPost('webdev', 'Second')
+    await createPost('webdev, bun', 'Third')
+
+    const index = await page<IndexProps>('/posts?tag=bun')
+
+    expect(index.props.tag).toBe('bun')
+    expect(index.props.data.map((post) => post.title)).toEqual(['Third', 'First'])
+    expect(index.props.pagination.meta.total).toBe(2)
+  })
+
+  it('lists nothing for a tag no post carries', async () => {
+    const id = await createPost('bun, webdev')
+    const client = await asAuthor()
+    await client.put(`/posts/${id}`, { ...draft, tags: 'bun' }).assertRedirect()
+
+    for (const tag of ['webdev', 'never-used', 'BUN', 'x'.repeat(40)]) {
+      const index = await page<IndexProps>(`/posts?tag=${tag}`)
+      expect(index.props.data).toEqual([])
+      expect(index.props.pagination.meta.total).toBe(0)
+    }
+  })
+
+  it('paginates a filtered list and keeps the filter in its page links', async () => {
+    for (let n = 1; n <= 11; n++) {
+      await createPost('c++ & co', `Post ${n}`)
+    }
+    await createPost('other', 'Elsewhere')
+
+    const first = await page<IndexProps>(`/posts?tag=${encodeURIComponent('c++ & co')}`)
+    expect(first.props.data).toHaveLength(10)
+    expect(first.props.pagination.meta.total).toBe(11)
+
+    const links = first.props.pagination.links.pages
+    expect(links.map((link) => link.page)).toEqual([1, 2])
+    const second = new URL(links[1]?.url ?? '', 'http://localhost')
