+++ b/tests/Mcp.test.ts
@@ -0,0 +1,187 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createAgentInvocationPipeline, createApiToken, deriveAgentTools } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ToolDescriptor {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+interface RpcResponse<T> {
+  result?: T
+  error?: { code: number; message: string }
+}
+
+// The endpoint is stateless streamable HTTP: it answers one JSON-RPC message
+// per POST, as plain JSON or as a single SSE `data:` frame.
+async function rpc<T>(http: TestApp, bearer: string, method: string, params: unknown = {}): Promise<T> {
+  const response = await http
+    .withHeaders({
+      Authorization: `Bearer ${bearer}`,
+      Accept: 'application/json, text/event-stream',
+    })
+    .post('/mcp', { jsonrpc: '2.0', id: 1, method, params })
+  expect(response.status).toBe(200)
+
+  const raw = await response.text()
+  const frame = raw.split('\n').find((line) => line.startsWith('data:'))
+  const message = JSON.parse(frame ? frame.slice('data:'.length) : raw) as RpcResponse<T>
+  if (!message.result) {
+    throw new Error(`MCP ${method} failed: ${JSON.stringify(message.error)}`)
+  }
+  return message.result
+}
+
+async function issueToken(user: UserRecord, abilities: string[]): Promise<string> {
+  const store = app.auth.getApiTokenStore()
+  if (!store) {
+    throw new Error('src/app.ts configures no API token store')
+  }
+  const { plainTextToken } = await createApiToken(store, { name: 'test', userId: user.id, abilities })
+  return plainTextToken
+}
+
+describe('MCP endpoint', () => {
+  let http: TestApp
+  let author: UserRecord
+  let bearer: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    bearer = await issueToken(author, ['tools:*'])
+  })
+
+  it('refuses a call without a credential', async () => {
+    await http.post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} }).assertUnauthorized()
+  })
+
+  it('refuses a bearer the token store does not know', async () => {
+    await http
+      .withHeader('Authorization', 'Bearer unknown|token')
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+      .assertUnauthorized()
+  })
+
+  it('lists the two post tools, only search marked read-only', async () => {
+    const { tools } = await rpc<{ tools: ToolDescriptor[] }>(http, bearer, 'tools/list')
+    const own = tools
+      .filter((tool) => !tool.name.startsWith('guren_'))
+      .map((tool) => [tool.name, tool.annotations?.readOnlyHint === true])
+
+    expect(own.sort()).toEqual([['posts_search', true], ['posts_store', false]])
+  })
+
+  it('lists only read-only tools for a tools:read token', async () => {
+    const readOnly = await issueToken(author, ['tools:read'])
+    const { tools } = await rpc<{ tools: ToolDescriptor[] }>(http, readOnly, 'tools/list')
+
+    expect(tools.map((tool) => tool.name).filter((name) => !name.startsWith('guren_'))).toEqual(['posts_search'])
+  })
+
+  it('posts_search answers with the JSON of QUERY /posts/search', async () => {
+    await Post.forceCreate({ title: 'Bun 2 released', excerpt: 'Faster', body: '...', authorId: author.id })
+    await Post.forceCreate({ title: 'Gardening', excerpt: 'Tomatoes', body: '...', authorId: author.id })
+    const input = { keywords: ['Bun'], limit: 5 }
+
+    const result = await rpc<ToolResult>(http, bearer, 'tools/call', { name: 'posts_search', arguments: input })
+    const expected = await (await http.query('/posts/search', input)).json<{ data: Array<{ title: string }> }>()
+
+    expect(result.isError).not.toBe(true)
+    expect(result.structuredContent ?? JSON.parse(result.content[0].text)).toEqual(expected)
+    expect(expected.data.map((post) => post.title)).toEqual(['Bun 2 released'])
+  })
+
+  it('posts_store creates the post as the token user, ignoring authorId', async () => {
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+
+    const result = await rpc<ToolResult>(http, bearer, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title: 'Hello', excerpt: 'First post', body: 'Body text', authorId: other.id },
+    })
+
+    expect(result.isError).not.toBe(true)
+    const posts = await Post.all()
+    expect(posts).toHaveLength(1)
+    expect(posts[0]).toMatchObject({ title: 'Hello', excerpt: 'First post', authorId: author.id })
+    expect(JSON.parse(result.content[0].text).data).toMatchObject({ id: posts[0].id, authorId: author.id })
+  })
+
+  it('the New post form still gets its redirect', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post('/posts', { title: 'Hello', excerpt: 'First post', body: 'Body text' }).assertRedirect('/posts/1')
+  })
+
+  it('posts_store answers 422 for input the form rejects and creates nothing', async () => {
+    const result = await rpc<ToolResult>(http, bearer, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'First post', body: 'Body text' },
+    })
+
+    expect(result.isError).toBe(true)
+    expect(JSON.parse(result.content[0].text)).toMatchObject({ errors: { title: ['Title is required.'] } })
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  // /mcp itself never admits a guest, so these drive the framework's
+  // invocation pipeline with no principal, the way `guren tool:call` does.
+  describe('without a signed-in user', () => {
+    function guestCall(name: string, args: Record<string, unknown>) {
+      const tool = deriveAgentTools(app.router.definitions()).tools.find((candidate) => candidate.toolName === name)
+      if (!tool) {
+        throw new Error(`No agent tool named ${name}`)
+      }
+      const pipeline = createAgentInvocationPipeline({ app, principal: null, abilities: ['tools:*'], surface: 'mcp' })
+      return pipeline.invoke({ tool, args })
+    }
+
+    it('posts_search still answers', async () => {
+      await Post.forceCreate({ title: 'Bun 2 released', excerpt: 'Faster', body: '...', authorId: author.id })
+
+      const result = await guestCall('posts_search', { keywords: ['Bun'] })
+
+      if (result.status !== 'executed') {
+        throw new Error(`posts_search was ${result.status}`)
+      }
+      expect(result.outcome.status).toBe(200)
+      expect(JSON.parse(result.outcome.content[0].text).data).toHaveLength(1)
+    })
+
+    it('posts_store is refused and creates nothing', async () => {
+      const result = await guestCall('posts_store', { title: 'Hello', excerpt: 'First post', body: 'Body text' })
+
+      if (result.status === 'executed') {
+        const { status, content } = result.outcome
+        expect([401, 403].includes(status) || content[0].text.includes('Location: /login')).toBe(true)
+      }
+      expect(await Post.all()).toHaveLength(0)
+    })
+  })
+
+  it('posts_store is refused for a token scoped to reads', async () => {
+    const readOnly = await issueToken(author, ['tools:read'])
+
+    const result = await rpc<ToolResult>(http, readOnly, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title: 'Hello', excerpt: 'First post', body: 'Body text' },
+    })
+
+    expect(result.isError).toBe(true)
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
