+import { bearerAuth, tokenRateLimit } from '../app/Http/Middleware/ApiAuth.js'
+
+export function registerApiRoutes(router: Router<'auth' | 'guest'>): void {
+  router.group('/api', (api) => {
+    api.middleware(bearerAuth, tokenRateLimit).group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', [ApiPostController, 'store']).name('api.posts.store')
+    })
+  })
+}
