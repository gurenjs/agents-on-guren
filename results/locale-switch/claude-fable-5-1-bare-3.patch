new file mode 100644
index 0000000..bc8c97f
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,29 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+import { setCookie } from 'hono/cookie'
+import { LOCALE_COOKIE_MAX_AGE_SECONDS, LOCALE_COOKIE_NAME } from '../../../config/i18n.js'
+
+export default class LocaleController extends Controller {
+  /**
+   * Remembers the reader's language in the cookie the locale middleware reads
+   * ahead of Accept-Language, then sends them back where they were. Open to
+   * guests and signed-in users alike; the route-bound schema already rejected
+   * any locale the app does not serve.
+   */
+  async store(): Promise<Response> {
+    const { locale } = this.validated('locale.store').body
+
+    setCookie(this.ctx, LOCALE_COOKIE_NAME, locale, {
+      path: '/',
+      httpOnly: true,
+      sameSite: 'Lax',
+      maxAge: LOCALE_COOKIE_MAX_AGE_SECONDS,
+    })
+
+    // The Referer is browser-set, but only follow it back onto this site: a
+    // stale or foreign one lands on the home page instead of off-site.
+    const referer = this.request.header('referer')
+    const back = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(back)
+  }
+}
