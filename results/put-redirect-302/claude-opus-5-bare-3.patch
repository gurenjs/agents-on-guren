-import { beforeAll, describe, it } from 'bun:test'
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +22,49 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.update answers with 303 See Other, not 302: a 302 keeps the method, so
+// the browser would replay the PUT against /posts/:id — which is the update
+// route again — until it gives up with ERR_TOO_MANY_REDIRECTS. 303 tells it to
+// follow up with a GET, which is how the edit form lands on the post page.
+describe('posts.update', () => {
+  let http: TestApp
+  let postId: number
+
+  beforeAll(async () => {
+    const author = await User.first()
+    const post = await Post.forceCreate({
+      title: 'Before the edit',
+      excerpt: 'Written by the test.',
+      body: 'The body before the edit.',
+      authorId: author!.id,
+    })
+    postId = post!.id
+
+    http = await (await TestApp.fromApp(app)).actingAs(author).withCsrf('/posts')
+  })
+
+  afterAll(async () => {
+    await Post.delete({ id: postId })
+  })
+
+  it('redirects a saved edit to the post page with a GET-forcing status', async () => {
+    await http
+      .put(`/posts/${postId}`, {
+        title: 'After the edit',
+        excerpt: 'Edited by the test.',
+        body: 'The body after the edit.',
+      })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${postId}`)
+
+    const post = await Post.find(postId)
+    expect(post?.title).toBe('After the edit')
+  })
+
+  it('rejects an invalid payload instead of redirecting', async () => {
+    await http
+      .put(`/posts/${postId}`, { title: '', excerpt: 'Edited by the test.', body: 'The body after the edit.' })
+      .assertStatus(422)
+  })
+})
