+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const NewsletterUnsubscribeSchema = z.object({
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const NewsletterConfirmParamSchema = z.object({
+  token: z.string().min(1, 'Token is required.'),
+})
+
+export type NewsletterSubscribeInput = z.infer<typeof NewsletterSubscribeSchema>
+export type NewsletterUnsubscribeInput = z.infer<typeof NewsletterUnsubscribeSchema>
+export type NewsletterConfirmParam = z.infer<typeof NewsletterConfirmParamSchema>
