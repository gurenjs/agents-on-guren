+  /** Public now: no schedule, or a schedule whose instant has passed. */
+  static isPublished(post: Pick<PostRecord, 'publishedAt'>, now: Date = new Date()): boolean {
+    return post.publishedAt === null || new Date(post.publishedAt).getTime() <= now.getTime()
+  }
+
+  /** Public now, or scheduled by the viewer themselves (guests pass `null`). */
+  static isVisibleTo(post: Pick<PostRecord, 'publishedAt' | 'authorId'>, viewerId: number | null): boolean {
+    return Post.isPublished(post) || post.authorId === viewerId
+  }
+
+  /**
+   * Query narrowed to what `viewerId` may see; the same rule as `isVisibleTo`
+   * expressed in SQL so lists and search never leak a scheduled post.
+   * Comparing ISO 8601 UTC text is a valid ordering, the same way `created_at`
+   * sorts, as long as every writer stores the `toISOString()` form.
+   */
+  static visibleTo(viewerId: number | null, now: Date = new Date()) {
+    const nowIso = now.toISOString()
+    return Post.newQuery().where((q) => {
+      q.whereNull('publishedAt').orWhere('publishedAt', '<=', nowIso)
+      if (viewerId !== null) {
