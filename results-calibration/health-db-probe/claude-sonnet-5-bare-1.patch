+import { Controller } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../../config/database.js'
+
+export type HealthCheckStatus = 'ok' | 'error'
+
+export interface HealthCheckReport {
+  status: HealthCheckStatus
+  checks: {
+    db: { status: HealthCheckStatus; message?: string }
+  }
+}
+
+/**
+ * Runs a trivial round trip against the database on every call — never a
+ * cached flag — so a deploy with an unreachable database fails the probe
+ * instead of staying in the load balancer's pool. `databaseProvider` is
+ * overridable so tests can simulate a broken connection without touching the
+ * real database.
+ */
+export async function runHealthChecks(databaseProvider: () => Promise<unknown> = getDatabase): Promise<HealthCheckReport> {
+  try {
+    const db = (await databaseProvider()) as SQLiteBunDatabase
+    await db.get(sql`select 1`)
+    return { status: 'ok', checks: { db: { status: 'ok' } } }
+  } catch (error) {
+    return {
+      status: 'error',
+      checks: {
+        db: { status: 'error', message: error instanceof Error ? error.message : String(error) },
+      },
+    }
+  }
+}
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const report = await runHealthChecks()
+    return this.json(report, { status: report.status === 'ok' ? 200 : 503 })
+  }
+}
