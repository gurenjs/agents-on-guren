+              </div>
+              <button
+                type="button"
+                disabled={revoking === token.id}
+                onClick={() => revokeToken(token.id)}
+                className="rounded-g-ctl border border-g-line-strong px-3 py-1.5 text-xs font-bold text-g-danger transition hover:bg-g-line disabled:cursor-not-allowed disabled:opacity-45"
