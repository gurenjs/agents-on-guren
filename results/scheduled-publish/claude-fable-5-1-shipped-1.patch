+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Ops calendar report: `bun run console posts:scheduled`. Stdout carries one
+ * `<id>\t<title>\t<published_at>` line per scheduled post, soonest first, and
+ * nothing else, so the output pipes straight into other tools.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later, soonest first (tab-separated)'
+
+  async handle(): Promise<void> {
+    const scheduled = await Post.scheduled().get()
+
+    for (const post of scheduled) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
