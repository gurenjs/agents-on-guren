+import { Router, readBearerToken, verifyApiToken } from '@guren/core'
+import type { MiddlewareHandler } from 'hono'
+import { agentTools } from '../.guren/agents.gen.js'
+import { sharedApiTokenStore } from '../app/Providers/ApiTokenProvider.js'
+
+// Custom middleware that checks for bearer token and returns 401 if missing.
+const mcpAuthMiddleware: MiddlewareHandler = async (c, next) => {
+  const authHeader = c.req.header('Authorization')
+  const token = readBearerToken(authHeader)
+
+  if (!token) {
+    return c.json({ jsonrpc: '2.0', error: { code: -32600, message: 'Unauthorized' } }, 401)
+  }
+
+  // Verify the token with the API token store.
+  const verified = await verifyApiToken(token, sharedApiTokenStore)
+  if (!verified) {
+    return c.json({ jsonrpc: '2.0', error: { code: -32600, message: 'Invalid token' } }, 401)
+  }
+
+  // Set the API token in the context for the route to use.
+  c.set('api-token', verified)
+  await next()
+}
+
+export function registerMcpRoutes(router: Router): void {
+  // Use custom middleware for API authentication.
+  const bearerMiddleware = mcpAuthMiddleware
+
+  // The MCP endpoint at /mcp handles tool listing and calling via JSON-RPC.
+  router.post('/mcp', bearerMiddleware, async (c) => {
+    const body = await c.req.json<{ jsonrpc: string; method: string; params?: unknown; id?: string | number }>()
+
+    if (body.jsonrpc !== '2.0') {
+      return c.json({ jsonrpc: '2.0', error: { code: -32600, message: 'Invalid Request' }, id: body.id }, 400)
+    }
+
+    // Handle tools/list method.
+    if (body.method === 'tools/list') {
+      const tools = Object.values(agentTools).map((tool) => ({
+        name: tool.toolName,
+        description: tool.description,
+        inputSchema: tool.inputSchema,
+        annotations: tool.annotations,
+      }))
+      return c.json({ jsonrpc: '2.0', result: { tools }, id: body.id })
+    }
+
+    // Handle tools/call method.
+    if (body.method === 'tools/call') {
+      const params = body.params as { name: string; arguments: Record<string, unknown> }
+      if (!params?.name) {
+        return c.json({ jsonrpc: '2.0', error: { code: -32602, message: 'Invalid params' }, id: body.id }, 400)
+      }
+
+      // Find the tool definition by toolName.
+      const toolDef = Object.values(agentTools).find((t) => t.toolName === params.name)
+      if (!toolDef) {
+        return c.json(
+          { jsonrpc: '2.0', error: { code: -32601, message: `Tool not found: ${params.name}` }, id: body.id },
+          404
+        )
+      }
+
+      try {
+        // Lazy-load the app to avoid circular dependencies.
+        // Import only the app instance, not the bootstrap function, to avoid re-booting.
+        const { default: app } = await import('../src/app.js')
+
+        // Construct the request based on inputSources.
+        const method = toolDef.method
+        const input = params.arguments
+        const baseUrl = new URL(c.req.url).origin
+        let url = new URL(toolDef.path, baseUrl)
+
+        let requestBody: Record<string, unknown> | undefined
+
+        // Build the request based on input sources.
+        for (const [key, source] of Object.entries(toolDef.inputSources)) {
+          if (source === 'body') {
+            if (!requestBody) requestBody = {}
+            requestBody[key] = input[key]
+          } else if (source === 'query') {
+            url.searchParams.set(key, String(input[key]))
+          }
+        }
+
+        // Make the request to the actual route.
+        const headers = new Headers()
+        headers.set('content-type', 'application/json')
+        headers.set('accept', 'application/json')
+        // Add a header to indicate this is an MCP call.
+        headers.set('x-mcp-tool-call', 'true')
+        // Preserve the authorization header for the internal call.
+        const authHeader = c.req.header('Authorization')
+        if (authHeader) {
+          const authHeaderStr = typeof authHeader === 'string' ? authHeader : String(authHeader)
+          headers.set('Authorization', authHeaderStr)
+        }
+
+        const callRequest = new Request(url.toString(), {
+          method,
+          headers,
+          body: requestBody ? JSON.stringify(requestBody) : undefined,
+        })
+
+        const response = await app.fetch(callRequest)
+
+        // Collect response body.
+        let responseData: unknown
+        const contentType = response.headers.get('content-type')
+        if (contentType?.includes('application/json')) {
+          responseData = await response.json()
+        } else {
+          responseData = await response.text()
+        }
+
+        // Return the response as MCP result or error.
+        if (response.ok) {
+          return c.json({ jsonrpc: '2.0', result: responseData, id: body.id })
+        }
+
+        // For non-OK responses, return as error with the response data.
+        return new Response(
+          JSON.stringify({
+            jsonrpc: '2.0',
+            error: {
+              code: -32603,
+              message: `Tool call returned ${response.status}`,
+              data: responseData,
+            },
+            id: body.id,
+          }),
+          { status: response.status, headers: { 'content-type': 'application/json' } }
+        )
+      } catch (error) {
+        const message = error instanceof Error ? error.message : 'Unknown error'
+        return c.json(
+          { jsonrpc: '2.0', error: { code: -32603, message: `Internal error: ${message}` }, id: body.id },
+          500
+        )
+      }
+    }
+
+    // Method not found.
+    return c.json({ jsonrpc: '2.0', error: { code: -32601, message: 'Method not found' }, id: body.id }, 404)
+  })
+}
+
+// Export the store so tests can create tokens.
+export { sharedApiTokenStore as apiTokenStore }
