diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..2aa0337
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,63 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+interface I18nProps {
+  locale: string
+  messages: Record<string, Record<string, Record<string, unknown>>>
+}
+
+async function readI18n(http: TestApp): Promise<I18nProps> {
+  const page = await http.get('/login').assertOk()
+  const { payload } = await readInertiaResponse(page.raw)
+  return payload.props._i18n as I18nProps
+}
+
+describe('locale.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('stores the pick in a cookie and redirects back to the referer', async () => {
+    const client = (await http.withCsrf()).json().withHeader('Referer', 'http://localhost/posts')
+    const response = await client.post('/locale', { locale: 'ja' }).assertRedirect('http://localhost/posts')
+    const cookies = response.raw.headers.getSetCookie()
+    expect(cookies.some((cookie) => cookie.startsWith('locale=ja;'))).toBe(true)
+  })
+
+  it('redirects to / without a referer, and refuses a foreign one', async () => {
+    const client = (await http.withCsrf()).json()
+    await client.post('/locale', { locale: 'en' }).assertRedirect('/')
+    await client
+      .withHeader('Referer', 'https://evil.example/phish')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported or missing locale without touching the cookie', async () => {
+    const client = (await http.withCsrf()).json()
+    const invalid = await client.post('/locale', { locale: 'fr' }).assertStatus(422)
+    expect(invalid.raw.headers.getSetCookie().some((c) => c.startsWith('locale='))).toBe(false)
+    await client.post('/locale', {}).assertStatus(422)
+  })
+
+  it('renders pages in the picked language over the browser preference', async () => {
+    const stored = await readI18n(http.withHeaders({ Cookie: 'locale=ja', 'Accept-Language': 'en' }))
+    expect(stored.locale).toBe('ja')
+    expect(stored.messages.ja?.nav?.posts).toBe('記事')
+    expect(stored.messages.ja?.posts?.new).toBe('新規投稿')
+    expect(stored.messages.ja?.auth?.logout).toBe('ログアウト')
+    expect(stored.messages.ja?.messages?.welcome).toBeDefined()
+  })
+
+  it('follows Accept-Language on a first visit and defaults to English', async () => {
+    const japanese = await readI18n(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'))
+    expect(japanese.locale).toBe('ja')
+
+    const plain = await readI18n(http)
+    expect(plain.locale).toBe('en')
+    expect(plain.messages.en?.nav?.posts).toBe('Posts')
+  })
+})
