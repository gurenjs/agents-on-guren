diff --git a/app/Http/Middleware/ThrottleLoginMiddleware.ts b/app/Http/Middleware/ThrottleLoginMiddleware.ts
new file mode 100644
index 0000000..e80eed6
--- /dev/null
+++ b/app/Http/Middleware/ThrottleLoginMiddleware.ts
@@ -0,0 +1,27 @@
+import { createRateLimitMiddleware } from '@guren/core'
+
+/** Login submissions one client may make per window before it is refused. */
+const MAX_ATTEMPTS = 5
+const WINDOW_MS = 60_000
+
+/**
+ * Throttles `POST /login` per client, so a credential stuffing script cannot
+ * spend thousands of guesses a minute on one account. Every submission counts,
+ * right password or wrong — a correct one does not hand the client a fresh
+ * budget — and the 6th within the window is answered with 429 and Retry-After.
+ *
+ * Counters live in the framework's in-memory store: this app runs as a single
+ * process, and nothing here needs to survive a restart.
+ *
+ * `trustProxy` stays off (the default), so the client is identified by the
+ * connection's own address. Nothing terminates the connection in front of this
+ * app in development, so an `X-Forwarded-For` would be whatever the attacker
+ * typed — a new bucket per request. When the runtime cannot report an address
+ * at all the requests share one bucket, which throttles rather than exempts
+ * them.
+ */
+export const ThrottleLoginMiddleware = createRateLimitMiddleware({
+  limit: MAX_ATTEMPTS,
+  windowMs: WINDOW_MS,
+  message: 'Too many login attempts. Please try again later.',
+})
