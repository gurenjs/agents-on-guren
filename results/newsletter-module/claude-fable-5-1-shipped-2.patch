+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription and goes to the home page', async () => {
+      const pending = await subscribe('reader@example.com')
+      const other = await subscribe('other@example.com')
+
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.findOrFail(pending.id)
+      expect(confirmed.confirmedAt).not.toBeNull()
+      expect(await NewsletterSubscription.findOrFail(other.id)).toEqual(other)
+    })
+
+    it('keeps the first confirmation time on a repeated visit', async () => {
+      const pending = await subscribe('reader@example.com')
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+      const confirmed = await NewsletterSubscription.findOrFail(pending.id)
+
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+
+      expect(await NewsletterSubscription.findOrFail(pending.id)).toEqual(confirmed)
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      const pending = await subscribe('reader@example.com')
+
+      await http.get('/newsletter/confirm/never-issued-token').assertNotFound()
+
+      expect(await NewsletterSubscription.all()).toEqual([pending])
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes the subscription and returns to the referring page', async () => {
+      await subscribe('reader@example.com')
