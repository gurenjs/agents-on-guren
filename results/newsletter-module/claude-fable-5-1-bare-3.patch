@@ -0,0 +1,45 @@
+---
+type: adr
+status: stable
+entities: [NewsletterSubscription]
+related: [guren.arch.ts, modules/newsletter/index.ts, modules/newsletter/db/schema.ts]
+generated: { by: "claude/fable-5.1", at: 2026-09-29T17:36:17.101Z }
+---
+
+# Keep the newsletter as a self-contained module
+
+## Context
+
+Readers can sign up for a newsletter, confirm the address through a
+tokenised link, and unsubscribe. The same sign-up ships with the next
+product, so it has to be lifted out of this application as is. Anything
+the blog imports from it would have to be untangled first.
+
+## Decision
+
+Everything newsletter-specific lives under `modules/newsletter/`: routes,
+controller, validators, model, table definition and tests. The
+application only *registers* it:
+
+- `src/app.ts` lists `newsletterModule` in `createApp({ modules })`, which
+  mounts its routes under `/newsletter`.
+- `db/schema.ts` re-exports `modules/newsletter/db/schema.ts`, so
+  `bun run db:make` and `bun run db:migrate` cover the module's table with
+  the project's one migrations folder.
+
+Nothing under `app/` or `routes/` may import from `modules/newsletter/`.
+The built-in module boundary of `guren check` still allows importing a
+module's `index.ts` and `db/schema.ts`, so `guren.arch.ts` adds a rule
+that disallows every import, type-only ones included. `bunx guren check`
+and `bunx guren check --arch` fail on a violation.
+
+## Consequences
+
+- Moving the newsletter to another Guren application is copying the
+  folder, registering the module, re-exporting its schema and generating
+  a migration there.
+- The blog cannot reuse newsletter code directly. Behaviour both need
+  belongs in shared code outside the module, or the blog reacts to events
+  the module dispatches.
+- The module's tests boot the host's `src/app.ts`, so they exercise the
+  host's real session and CSRF middleware rather than a copy of it.
diff --git a/guren.arch.ts b/guren.arch.ts
new file mode 100644
index 0000000..fde3e74
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,24 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Checked by `bunx guren check` (and `--arch` alone). The built-in module
+// boundary still lets outside code import a module's index.ts and
+// db/schema.ts; the rule below closes that for the blog, which must not
+// depend on the newsletter module at all. src/app.ts registers the module and
+// db/schema.ts re-exports its tables for migrations — neither is in `blog`.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      // A type-only import is still a dependency that breaks when the module
+      // is lifted out, so it counts as a crossing too.
+      includeTypeImports: true,
+      message:
+        'The newsletter module is self-contained: nothing under app/ or routes/ may import from modules/newsletter/. Register it in src/app.ts instead.',
+    },
+  ],
+})
