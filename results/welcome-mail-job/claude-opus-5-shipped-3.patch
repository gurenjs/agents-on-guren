+import { ServiceProvider, registerJob } from '@guren/core'
+import { createAppQueueManager } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+/**
+ * Binds the queue configured by `QUEUE_CONNECTION` (see config/queue.ts).
+ */
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => createAppQueueManager())
+  }
+
+  boot(): void {
+    // Resolving the default connection also installs it as the driver
+    // `Job.dispatch()` pushes onto.
+    this.container.make('queue').driver()
+
+    // A queued message records only the job's wire name, so the sync driver
+    // and a worker process both resolve the class back through this registry.
+    // Every job class the app dispatches belongs here.
+    registerJob(SendWelcomeEmailJob)
+  }
+}
