+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// 1×1 PNG, a JPEG header and a GIF header. Covers are stored opaquely, so the
+// JPEG and GIF only need their signatures to be recognised (or refused).
+const PNG = Uint8Array.from(atob('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=='), (c) => c.charCodeAt(0))
+const JPEG = Uint8Array.from([0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0xff, 0xd9])
+const GIF = new TextEncoder().encode('GIF89a\x01\x00\x01\x00\x00\x00\x00;')
+
+function postForm(fields: Record<string, string>, cover?: File): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries({ title: 'Cover post', excerpt: 'An excerpt', body: 'A body', ...fields })) {
+    form.append(key, value)
+  }
+  if (cover) form.append('cover', cover)
+  return form
+}
+
+function pngFile(bytes: Uint8Array<ArrayBuffer> = PNG): File {
+  return new File([bytes], 'cover.png', { type: 'image/png' })
+}
+
+async function filesUnder(dir: string): Promise<string[]> {
+  const entries = await readdir(dir, { recursive: true, withFileTypes: true }).catch(() => [])
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+async function containsBytes(dir: string, bytes: Uint8Array): Promise<boolean> {
+  for (const file of await filesUnder(dir)) {
+    if (Buffer.from(await readFile(file)).equals(Buffer.from(bytes))) return true
+  }
+  return false
+}
+
+async function countPosts(): Promise<number> {
+  return (await Post.all()).length
+}
+
+async function countCoverRows(postId: number): Promise<number> {
+  return (await Attachment.where({ attachableType: 'Post', attachableId: String(postId) }).get()).length
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let client: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const user = await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    client = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  async function createPost(cover?: File): Promise<number> {
+    const response = await client.post('/posts', postForm({ title: `Cover ${crypto.randomUUID()}` }, cover))
+    const location = response.raw.headers.get('location') ?? ''
+    const id = Number(location.match(/\/posts\/(\d+)$/)?.[1])
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  async function showPost(id: number): Promise<PostResourceData> {
+    const response = await client.get(`/posts/${id}`)
+    const { payload } = await readInertiaResponse(response.raw)
+    return (payload.props as { post: PostResourceData }).post
+  }
+
+  it('creates a post without a cover', async () => {
+    const id = await createPost()
+    expect((await showPost(id)).coverUrl).toBeNull()
+  })
+
+  it('stores, lists and serves an uploaded cover from storage/', async () => {
+    const id = await createPost(pngFile())
+    const post = await showPost(id)
+    expect(post.coverUrl).toBeString()
+
+    const served = await client.get(post.coverUrl!)
+    expect(served.raw.status).toBe(200)
+    expect(served.raw.headers.get('content-type')).toStartWith('image/png')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(Buffer.from(PNG))).toBe(true)
+
+    expect(await containsBytes('storage', PNG)).toBe(true)
+    expect(await containsBytes('public', PNG)).toBe(false)
+    expect(await countCoverRows(id)).toBe(1)
+
+    const index = await readInertiaResponse((await client.get('/posts')).raw)
+    const listed = (index.payload.props as { data: PostResourceData[] }).data.find((item) => item.id === id)
+    expect(listed?.coverUrl).toBeString()
+  })
+
+  it('refuses a GIF or an oversized file like an empty title, saving nothing', async () => {
+    const emptyTitle = await client.post('/posts', postForm({ title: '' }))
+    const postsBefore = await countPosts()
+
+    const gif = await client.post('/posts', postForm({}, new File([GIF], 'cover.gif', { type: 'image/gif' })))
+    const oversized = new Uint8Array(2 * 1024 * 1024 + 1)
+    oversized.set(PNG)
+    const big = await client.post('/posts', postForm({}, pngFile(oversized)))
+    const mislabelled = await client.post('/posts', postForm({}, new File([GIF], 'cover.png', { type: 'image/png' })))
+
+    for (const refused of [gif, big, mislabelled]) {
+      expect(refused.raw.status).toBe(emptyTitle.raw.status)
+      expect(refused.raw.headers.get('location')).toBe(emptyTitle.raw.headers.get('location'))
+    }
+    expect(await countPosts()).toBe(postsBefore)
+    expect(await containsBytes('storage', GIF)).toBe(false)
+  })
+
+  it('replaces, keeps and removes the cover on edit', async () => {
+    const id = await createPost(pngFile())
+    const original = (await showPost(id)).coverUrl!
+
+    // A refused replacement keeps the current cover.
+    await client.put(`/posts/${id}`, postForm({}, new File([GIF], 'cover.gif', { type: 'image/gif' })))
+    expect((await client.get(original)).raw.status).toBe(200)
+
+    await client.put(`/posts/${id}`, postForm({}, new File([JPEG], 'cover.jpg', { type: 'image/jpeg' })))
+    const replaced = (await showPost(id)).coverUrl!
+    expect((await client.get(original)).raw.status).not.toBe(200)
+    const served = await client.get(replaced)
+    expect(served.raw.headers.get('content-type')).toStartWith('image/jpeg')
+    expect(await countCoverRows(id)).toBe(1)
+
+    await client.put(`/posts/${id}`, postForm({ title: 'Renamed' }))
+    const kept = await showPost(id)
+    expect(kept.title).toBe('Renamed')
+    expect(kept.coverUrl).toBeString()
+
+    await client.put(`/posts/${id}`, postForm({ removeCover: '1' }))
+    expect((await showPost(id)).coverUrl).toBeNull()
+    expect((await client.get(replaced)).raw.status).not.toBe(200)
+    expect(await countCoverRows(id)).toBe(0)
+  })
+
+  it('deletes the cover with its post', async () => {
+    const bytes = PNG.slice()
+    const id = await createPost(pngFile(bytes))
+    const coverUrl = (await showPost(id)).coverUrl!
+
+    await client.delete(`/posts/${id}`)
+    expect((await client.get(coverUrl)).raw.status).not.toBe(200)
+    expect(await countCoverRows(id)).toBe(0)
+  })
+})
