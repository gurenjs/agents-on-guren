+++ b/tests/controllers/PostController.test.ts
@@ -0,0 +1,352 @@
+import { describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { User } from '../../app/Models/User.js'
+import { Post } from '../../app/Models/Post.js'
+
+async function setup() {
+  const http = await TestApp.fromApp(app)
+
+  const author = await User.create({
+    name: 'Test Author',
+    email: `author-${Date.now()}@test.com`,
+    password: 'password123',
+  })
+
+  const otherUser = await User.create({
+    name: 'Test Other',
+    email: `other-${Date.now()}@test.com`,
+    password: 'password123',
+  })
+
+  return { http, author, otherUser }
+}
+
+describe('PostController - Scheduled Posts', () => {
+  describe('create and store', () => {
+    it('creates a post with a future published_at date', async () => {
+      const { http, author } = await setup()
+      const csrf = await http.actingAs(author).withCsrf()
+      const futureDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+
+      await csrf.post('/posts', {
+        title: 'Scheduled Post',
+        excerpt: 'This is scheduled',
+        body: 'Content here',
+        publishAt: futureDate,
+      }).assertRedirect()
+
+      const post = await Post.first({ title: 'Scheduled Post' })
+      expect(post?.publishedAt).toBeTruthy()
+      expect(new Date(post?.publishedAt ?? '').getTime()).toBeGreaterThan(Date.now())
+    })
+
+    it('creates a post with null published_at (publish now)', async () => {
+      const { http, author } = await setup()
+      const csrf = await http.actingAs(author).withCsrf()
+
+      await csrf.post('/posts', {
+        title: 'Immediate Post',
+        excerpt: 'Published now',
+        body: 'Content here',
+        publishAt: null,
+      }).assertRedirect()
+
+      const post = await Post.first({ title: 'Immediate Post' })
+      expect(post?.publishedAt).toBeNull()
+    })
+
+    it('creates a post without publishAt field', async () => {
+      const { http, author } = await setup()
+      const csrf = await http.actingAs(author).withCsrf()
+
+      await csrf.post('/posts', {
+        title: 'No Publish Date',
+        excerpt: 'No date provided',
+        body: 'Content here',
+      }).assertRedirect()
+
+      const post = await Post.first({ title: 'No Publish Date' })
+      expect(post?.publishedAt).toBeNull()
+    })
+
+    it('rejects invalid datetime values', async () => {
+      const { http, author } = await setup()
+      const csrf = await http.actingAs(author).withCsrf()
+
+      await csrf.post('/posts', {
+        title: 'Invalid Date Post',
+        excerpt: 'Invalid date',
+        body: 'Content here',
+        publishAt: 'next tuesday',
+      }).assertUnprocessable()
+    })
+  })
+
+  describe('index - listing posts', () => {
+    it('shows published posts to all users', async () => {
+      const { author } = await setup()
+      const publishedPost = await Post.forceCreate({
+        title: 'Published Post Index',
+        excerpt: 'Public',
+        body: 'Content',
+        authorId: author.id,
+        publishedAt: null,
+      })
+
+      // Verify the post exists and is public
+      const listedPosts = await Post.where((q) => {
+        const now = new Date().toISOString()
+        q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+      }).get()
+      expect(listedPosts.some((p) => p.id === publishedPost.id)).toBe(true)
+    })
+
+    it('hides scheduled posts from guests', async () => {
+      const { author } = await setup()
+      const futureDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+      const scheduledPost = await Post.forceCreate({
+        title: 'Hidden Scheduled Post',
+        excerpt: 'Hidden',
+        body: 'Content',
+        authorId: author.id,
+        publishedAt: futureDate,
+      })
+
+      // Verify the post is not in the public list (only in private list for author)
+      const publicPosts = await Post.where((q) => {
+        const now = new Date().toISOString()
+        q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+      }).get()
+      expect(publicPosts.some((p) => p.id === scheduledPost.id)).toBe(false)
+    })
+
+    it('shows scheduled posts to their author', async () => {
+      const { author } = await setup()
+      const futureDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+      const scheduledPost = await Post.forceCreate({
+        title: 'My Scheduled Post',
+        excerpt: 'Visible to author',
+        body: 'Content',
+        authorId: author.id,
+        publishedAt: futureDate,
+      })
+
+      // Verify the post would be in the author's list (visible to them)
+      const authorPosts = await Post.where((q) => {
+        const now = new Date().toISOString()
+        q.whereNull('publishedAt').orWhere('publishedAt', '<=', now).orWhere('authorId', author.id)
+      }).get()
+      expect(authorPosts.some((p) => p.id === scheduledPost.id)).toBe(true)
+    })
+
+    it('hides scheduled posts from other logged-in users', async () => {
+      const { author, otherUser } = await setup()
+      const futureDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+      const scheduledPost = await Post.forceCreate({
+        title: 'Other User Scheduled Post',
+        excerpt: 'Hidden from others',
+        body: 'Content',
+        authorId: author.id,
+        publishedAt: futureDate,
+      })
+
+      // Verify the scheduled post is not visible to other users
+      const otherUserPosts = await Post.where((q) => {
+        const now = new Date().toISOString()
+        q.whereNull('publishedAt').orWhere('publishedAt', '<=', now).orWhere('authorId', otherUser.id)
+      }).get()
+      expect(otherUserPosts.some((p) => p.id === scheduledPost.id)).toBe(false)
+    })
+  })
+
+  describe('show - viewing individual posts', () => {
+    it('shows published posts to all users', async () => {
