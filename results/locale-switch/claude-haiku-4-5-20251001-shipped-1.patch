diff --git a/tests/controllers/LocaleController.test.ts b/tests/controllers/LocaleController.test.ts
new file mode 100644
index 0000000..22ab167
--- /dev/null
+++ b/tests/controllers/LocaleController.test.ts
@@ -0,0 +1,40 @@
+import { describe, test, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+
+describe('LocaleController', () => {
+  test('POST /locale sets locale cookie for valid locale', async () => {
+    const http = await TestApp.fromApp(app)
+    const csrf = await http.withCsrf()
+
+    const response = await csrf.post('/locale', { locale: 'ja' })
+
+    response.assertRedirect('/')
+    const setCookie = response.headers.get('set-cookie')
+    expect(setCookie).toContain('locale=ja')
+  })
+
+  test('POST /locale redirects to referer if present', async () => {
+    const http = await TestApp.fromApp(app)
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .withHeader('referer', '/posts')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/posts')
+  })
+
+  test('POST /locale rejects invalid locale', async () => {
+    const http = await TestApp.fromApp(app)
+    const csrf = await http.withCsrf()
+
+    await csrf.post('/locale', { locale: 'fr' }).assertUnprocessable()
+  })
+
+  test('POST /locale rejects missing locale', async () => {
+    const http = await TestApp.fromApp(app)
+    const csrf = await http.withCsrf()
+
+    await csrf.post('/locale', {}).assertUnprocessable()
+  })
+})
