diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..e4750ac
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+import { tagNamesByPost } from '../app/Services/PostTags.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass-1' })
+    csrf = await http.actingAs(author).withCsrf()
+  })
+
+  let csrf: TestApp
+
+  function save(tags: string | undefined, id?: number) {
+    const body = { title: 'Hello', excerpt: 'Ex', body: 'Body', tags }
+    return id ? csrf.put(`/posts/${id}`, body) : csrf.post('/posts', body)
+  }
+
+  it('creates, dedupes and syncs tags', async () => {
+    await save(' bun ,bun, webdev,').assertRedirect()
+    const [post] = await Post.all()
+    expect((await tagNamesByPost([post.id])).get(post.id)).toEqual(['bun', 'webdev'])
+
+    await save('bun', post.id).assertRedirect()
+    expect((await tagNamesByPost([post.id])).get(post.id)).toEqual(['bun'])
+    expect(await Tag.all()).toHaveLength(2)
+    expect(await PostTag.all()).toHaveLength(1)
+  })
+
+  it('refuses six tags and 31-character names, accepts 30', async () => {
+    await save('a,b,c,d,e,f').assertUnprocessable()
+    await save('x'.repeat(31)).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+
+    await save('x'.repeat(30)).assertRedirect()
+    expect(await Tag.all()).toHaveLength(1)
+  })
+
+  it('filters the list by tag and shows tags', async () => {
+    await save('bun').assertRedirect()
+    await save('other').assertRedirect()
+    const res = await http.get('/posts?tag=bun')
+    res.assertOk()
+    expect(await res.text()).toContain('bun')
+    await http.get('/posts?tag=nobody').assertOk()
+  })
+
+  it('deletes a tagged post', async () => {
+    await save('bun').assertRedirect()
+    const [post] = await Post.all()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})
