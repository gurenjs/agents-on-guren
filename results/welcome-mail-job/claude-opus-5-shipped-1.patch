diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..d2e993f
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,45 @@
+import { getMailManager, Job } from '@guren/core'
+import { appMailManager } from '../../config/mail.js'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailJobPayload {
+  userId: number
+  name: string
+  email: string
+}
+
+/**
+ * Sends the welcome email out of band, so registration never waits on — or
+ * fails with — the mail provider. Registration dispatches it; delivery happens
+ * wherever the queue runs it (inline under QUEUE_CONNECTION=sync, in a worker
+ * under redis).
+ *
+ * The payload carries the name and address the account was registered with
+ * rather than only the id, so the message does not depend on reading the row
+ * back at delivery time.
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  // Pinned so queued messages survive a class rename or a bundler mangling
+  // identifiers — the worker resolves the class back from this name.
+  static override jobName = 'SendWelcomeEmailJob'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: SendWelcomeEmailJobPayload): Promise<void> {
+    // Resolved when the job runs, not when it is dispatched: the worker may be
+    // a different process than the one that queued the message, and its
+    // mailer — a real provider, the log transport, a test's recording one — is
+    // whatever is configured there.
+    const manager = getMailManager() ?? appMailManager()
+    const result = await new WelcomeMail(manager, { name: payload.name, email: payload.email }).send()
+
+    if (!result.success) {
+      // Throwing hands the message back to the queue's retry/backoff policy.
+      throw new Error(result.error ?? `Failed to send the welcome email to ${payload.email}`)
+    }
+  }
+
+  async failed(payload: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for user ${payload.userId}:`, error.message)
+  }
+}
