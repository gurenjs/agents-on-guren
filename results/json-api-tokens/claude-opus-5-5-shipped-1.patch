diff --git a/app/Http/Middleware/ApiTokenMiddleware.ts b/app/Http/Middleware/ApiTokenMiddleware.ts
new file mode 100644
index 0000000..afcffa8
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenMiddleware.ts
@@ -0,0 +1,37 @@
+import {
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokenStore.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_WINDOW_MS = 60_000
+
+const unauthorized = { message: 'Unauthenticated.' }
+
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (ctx) => ctx.json(unauthorized, 401),
+})
+
+// Per-process memory store: swap for a Redis-backed RateLimitStore when running
+// more than one server process, or each process grants its own 60.
+export const apiRateLimitStore = new MemoryRateLimitStore()
+
+// Keyed by token id, not user id: each token of one user gets its own budget.
+// Must run after `authenticateApiToken`, which puts the token on the context.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  store: apiRateLimitStore,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) => {
+    // At the window edge the computed wait rounds to 0, which reads as "retry now".
+    const seconds = Math.max(1, retryAfter)
+    ctx.header('Retry-After', String(seconds))
+    return ctx.json({ message: 'Too many requests, please try again later.', retryAfter: seconds }, 429)
+  },
+})
