new file mode 100644
index 0000000..f460d63
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,40 @@
+import { defineModel, type BelongsToRecord, type HasManyRecord } from '@guren/core'
+import { comments } from '../../db/schema.js'
+import type { CommentReportRecord } from './CommentReport.js'
+import type { PostRecord } from './Post.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+
+/** A comment reported by this many different users is hidden from the post page. */
+export const REPORTS_TO_HIDE = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` comes from the route and `userId` from the signed-in user, never
+  // from request input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: {
+    author: BelongsToRecord<CommentAuthorSummary>
+    post: BelongsToRecord<PostRecord>
+    reports: HasManyRecord<CommentReportRecord>
+  } = {
+    author: null,
+    post: null,
+    reports: [],
+  }
+
+  /**
+   * Whether enough different users reported the comment to hide it. Counts
+   * users rather than rows, so the rule holds even for rows written past the
+   * unique index on (`comment_id`, `user_id`).
+   */
+  static isHidden(reports: ReadonlyArray<Pick<CommentReportRecord, 'userId'>>): boolean {
+    return new Set(reports.map((report) => report.userId)).size >= REPORTS_TO_HIDE
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+Comment.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
+Comment.hasMany('reports', () => import('./CommentReport.js').then((module) => module.CommentReport), 'commentId', 'id')
