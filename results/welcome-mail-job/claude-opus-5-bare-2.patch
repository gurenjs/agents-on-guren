diff --git a/tests/RegisterWelcomeEmail.test.ts b/tests/RegisterWelcomeEmail.test.ts
new file mode 100644
index 0000000..f09695a
--- /dev/null
+++ b/tests/RegisterWelcomeEmail.test.ts
@@ -0,0 +1,97 @@
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeMail, fakeQueue, type FakeMail, type FakeQueue } from '@guren/testing'
+import { processJob, setQueueDriver, type MailManager } from '@guren/core'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+const NAME = 'Ada Lovelace'
+const EMAIL = 'ada@example.com'
+const PASSWORD = 'correct horse battery'
+// The subject carries whatever APP_NAME the deployment is configured with.
+const APP_NAME = process.env.APP_NAME ?? 'Guren'
+
+function registration(overrides: Record<string, string> = {}) {
+  return {
+    name: NAME,
+    email: EMAIL,
+    password: PASSWORD,
+    passwordConfirmation: PASSWORD,
+    ...overrides,
+  }
+}
+
+describe('register', () => {
+  let http: TestApp
+  let queue: FakeQueue
+  let mail: FakeMail
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    // Hold dispatched work instead of running it, so the request is observed
+    // as the browser sees it — before any worker has touched the queue.
+    queue = fakeQueue()
+    setQueueDriver(queue.getDriver())
+
+    // Record messages in place of the configured transport, whichever
+    // MAIL_MAILER names.
+    mail = fakeMail()
+    const manager = app.container.make<MailManager>('mail')
+    manager.registerTransport(manager.getDefaultTransportName(), () => mail.getTransport())
+
+    await User.delete({ email: EMAIL })
+  })
+
+  afterEach(async () => {
+    await User.delete({ email: EMAIL })
+  })
+
+  it('queues the welcome email rather than sending it during sign-up', async () => {
+    const guest = await http.withCsrf('/register')
+
+    const response = await guest.post('/register', registration())
+    response.assertRedirect('/dashboard')
+
+    mail.assertNothingSent()
+    expect(queue.all()).toHaveLength(1)
+  })
+
+  it('sends one welcome email when the queued work runs', async () => {
+    const guest = await http.withCsrf('/register')
+    await guest.post('/register', registration())
+
+    // Exactly what a worker does with the waiting job.
+    expect(await processJob(queue.getDriver())).toBe(true)
+
+    mail.assertSentTimes(1)
+    const [message] = mail.sent().map((record) => record.message)
+    expect(message?.to).toEqual([{ email: EMAIL }])
+    expect(message?.subject).toBe(`Welcome to ${APP_NAME}, ${NAME}!`)
+    expect(message?.text).toContain(NAME)
+    expect(message?.from?.email).toBe(process.env.MAIL_FROM_ADDRESS)
+    expect(message?.from?.name).toBe(process.env.MAIL_FROM_NAME)
+  })
+
+  it('queues nothing when the registration is invalid', async () => {
+    const guest = await http.withCsrf('/register')
+
+    await guest.post('/register', registration({ email: 'not-an-email' })).assertUnprocessable()
+
+    queue.assertNothingPushed()
+    mail.assertNothingSent()
+  })
+
+  it('queues nothing when the email is already taken', async () => {
+    await User.create({ name: 'Ada', email: EMAIL, password: PASSWORD })
+    const guest = await http.withCsrf('/register')
+
+    await guest.post('/register', registration()).assertUnprocessable()
+
+    queue.assertNothingPushed()
+    mail.assertNothingSent()
+  })
+})
