@@ -0,0 +1,16 @@
+import { Controller } from '@guren/core'
+import { healthStatusCode, runHealthChecks } from '../../Health/HealthCheck.js'
+
+/**
+ * Probed by the deployment platform, which keeps the deploy in the
+ * load-balancer pool for as long as this answers 2xx. The checks therefore run
+ * on every request and a failure comes back as 503, never as a 500 (which
+ * would read as "the app is broken" rather than "drain me") and never as a 200.
+ */
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const report = await runHealthChecks()
+
+    return this.json(report, { status: healthStatusCode(report) })
+  }
+}
