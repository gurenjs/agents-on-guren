diff --git a/modules/newsletter/app/Http/Controllers/NewsletterSubscriptionController.ts b/modules/newsletter/app/Http/Controllers/NewsletterSubscriptionController.ts
new file mode 100644
index 0000000..85c57df
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterSubscriptionController.ts
@@ -0,0 +1,61 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { NewsletterEmailSchema, NewsletterTokenParamSchema } from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterSubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+
+    const existing = await NewsletterSubscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable.
+    await NewsletterSubscription.forceCreate({ email, token: generateToken() })
+
+    return this.redirect(this.previousPath())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(NewsletterTokenParamSchema)
+    // Throws ModelNotFoundException (404) for a token that was never issued.
+    const subscription = await NewsletterSubscription.where({ token }).firstOrFail()
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.previousPath())
+  }
+
+  /**
+   * The path of the page the visitor came from, taken from `Referer`. Only the
+   * path is kept, so a foreign Referer can never turn this into an open redirect.
+   */
+  private previousPath(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+
+    try {
+      const url = new URL(referer)
+      const path = `${url.pathname}${url.search}`
+      return path.startsWith('/') && !path.startsWith('//') ? path : '/'
+    } catch {
+      return '/'
+    }
+  }
+}
+
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
