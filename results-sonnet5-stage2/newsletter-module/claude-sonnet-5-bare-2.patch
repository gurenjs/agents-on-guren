+import { z } from 'zod'
+
+export const EmailSchema = z.object({
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const ConfirmParamSchema = z.object({
+  token: z.string().min(1),
+})
