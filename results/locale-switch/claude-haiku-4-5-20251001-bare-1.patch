+++ b/app/Http/Validators/LocaleValidator.ts
@@ -0,0 +1,9 @@
+import { z } from 'zod'
+
+export const LocaleSchema = z.object({
+  locale: z
+    .enum(['en', 'ja'])
+    .refine((val) => ['en', 'ja'].includes(val), 'Invalid locale'),
+})
+
+export type LocaleInput = z.infer<typeof LocaleSchema>
