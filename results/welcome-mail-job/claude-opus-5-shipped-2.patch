@@ -0,0 +1,26 @@
+import { ServiceProvider, createQueueManager, registerJob } from '@guren/core'
+import { queueConfig } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+/**
+ * Every job class the app can dispatch. A queued message records only the
+ * job's name, so a worker — which never imported the controller that
+ * dispatched it — resolves the class back from this registry.
+ */
+const jobs = [SendWelcomeEmailJob]
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => createQueueManager(queueConfig()))
+  }
+
+  boot(): void {
+    for (const job of jobs) {
+      registerJob(job)
+    }
+
+    // Resolving the default driver also installs it as the global one, which
+    // is what `Job.dispatch()` and `guren queue:work` push to and pop from.
+    this.container.make('queue').driver()
+  }
+}
