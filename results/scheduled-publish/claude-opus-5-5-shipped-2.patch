+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2999-01-01T09:00:00.000Z'
+const PAST = '2000-01-01T09:00:00.000Z'
+
+interface InertiaPost {
+  id: number
+  publishedAt: string | null
+}
+
+async function props(client: TestApp, path: string) {
+  const res = await client.withHeader('X-Inertia', 'true').get(path)
+  return { status: res.status, props: (await res.json<{ props: Record<string, unknown> }>()).props }
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })) as UserRecord
+  })
+
+  async function schedule(publishedAt: string | null = FUTURE) {
+    return (await Post.forceCreate({
+      title: 'Launch day',
+      excerpt: 'Big news',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt,
+    }))!
+  }
+
+  it('stores publishAt from the create form', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: FUTURE }).assertRedirect()
+    const post = await Post.first({ title: 'T' })
+    expect(post?.publishedAt).toBe(FUTURE)
+  })
+
+  it('rejects a publishAt that is not a date and time', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    expect(await Post.first({ title: 'T' })).toBeNull()
+  })
+
+  it('clears the date on edit when publishAt is null', async () => {
+    const post = await schedule()
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { title: 'T', excerpt: 'E', body: 'B', publishAt: null }).assertRedirect()
+    expect((await Post.find(post.id))?.publishedAt).toBeNull()
+  })
+
+  it('hides a scheduled post page from everyone but its author', async () => {
+    const post = await schedule()
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+
+    const { status, props: shown } = await props(http.actingAs(author), `/posts/${post.id}`)
+    expect(status).toBe(200)
+    expect((shown.post as InertiaPost).publishedAt).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const scheduled = await schedule()
+    const open = await schedule(null)
+
+    const guestIds = ((await props(http, '/posts')).props.data as InertiaPost[]).map((p) => p.id)
+    expect(guestIds).toEqual([open.id])
+    const otherIds = ((await props(http.actingAs(other), '/posts')).props.data as InertiaPost[]).map((p) => p.id)
+    expect(otherIds).toEqual([open.id])
+
+    const mine = (await props(http.actingAs(author), '/posts')).props.data as InertiaPost[]
+    expect(mine.find((p) => p.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    await schedule()
+    const res = await http.query('/posts/search', { keywords: ['Launch'] })
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(0)
+  })
+
+  it('shows the post to everyone once its time has passed', async () => {
+    const post = await schedule()
+    await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    const res = await http.query('/posts/search', { keywords: ['Launch'] })
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+})
