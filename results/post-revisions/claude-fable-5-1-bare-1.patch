diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..be49bcd
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,38 @@
+import { defineModel, type BelongsToRecord, type TransactionHandle } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+export type NewPostRevisionRecord = typeof postRevisions.$inferInsert
+
+/** The fields a revision snapshots — the ones the edit form can change. */
+export type PostRevisionFields = Pick<PostRecord, 'title' | 'excerpt' | 'body'>
+
+export class PostRevision extends defineModel(postRevisions, {
+  // `postId` is set from the post being edited, never from request input.
+  fillable: ['title', 'excerpt', 'body'],
+}) {
+  static override relationTypes: { post: BelongsToRecord<PostRecord> } = {
+    post: null,
+  }
+
+  /**
+   * Keeps the version `post` currently has, so a later restore can bring it
+   * back. Call it before the write that replaces that version, on the same
+   * transaction, so a refused or failed edit keeps nothing.
+   */
+  static async keep(post: PostRecord, writeOptions?: { trx?: TransactionHandle }): Promise<PostRevisionRecord> {
+    // forceCreate, because `postId` is deliberately absent from fillable.
+    return PostRevision.forceCreate(
+      {
+        postId: post.id,
+        title: post.title,
+        excerpt: post.excerpt,
+        body: post.body,
+      },
+      writeOptions,
+    )
+  }
+}
+
+PostRevision.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
