diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..c18abb7
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,106 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('post slugs', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createAuthor() {
+    return User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })
+  }
+
+  it('assigns a new post a slug generated from its title, and redirects to it', async () => {
+    const author = await createAuthor()
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'An excerpt.', body: 'Body text.' })
+      .assertRedirect('/posts/hello-world')
+
+    const post = await Post.first({ authorId: author.id })
+    expect(post?.slug).toBe('hello-world')
+  })
+
+  it('gives repeated titles the next free numbered slug', async () => {
+    const author = await createAuthor()
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'First.', body: 'Body.' })
+      .assertRedirect('/posts/hello-world')
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'Second.', body: 'Body.' })
+      .assertRedirect('/posts/hello-world-2')
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'Third.', body: 'Body.' })
+      .assertRedirect('/posts/hello-world-3')
+  })
+
+  it('keeps a post at its original slug after its title is edited', async () => {
+    const author = await createAuthor()
+    const csrf = await http.actingAs(author).withCsrf()
+    const post = await Post.forceCreate({
+      title: 'Original Title',
+      slug: 'original-title',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+    })
+
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'A Brand New Title', excerpt: 'e2', body: 'b2' })
+      .assertRedirect('/posts/original-title')
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.slug).toBe('original-title')
+    expect(await Post.first({ slug: 'a-brand-new-title' })).toBeNull()
+  })
+
+  it('serves the post page at its slug URL', async () => {
+    const author = await createAuthor()
+    const post = await Post.forceCreate({
+      title: 'Readable Post',
+      slug: 'readable-post',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+    })
+
+    await http.get(`/posts/${post.slug}`).assertOk()
+  })
+
+  it('404s for an unknown slug', async () => {
+    await http.get('/posts/no-such-post').assertNotFound()
+  })
+
+  it('permanently redirects the legacy numeric URL to the slug URL', async () => {
+    const author = await createAuthor()
+    const post = await Post.forceCreate({
+      title: 'Old Address',
+      slug: 'old-address',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+    })
+
+    await http
