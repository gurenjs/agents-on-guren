+
+  async revisions(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('viewRevisions', [Post, post])
+
+    const revisions = await PostRevision.where({ postId: post.id })
+      .orderBy('createdAt', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: new PostResource(post).toJSON(),
+      revisions: revisions.map((r) => ({
+        id: r.id,
+        title: r.title,
+        createdAt: r.createdAt,
+      })),
+    })
+  }
+
+  async restoreRevision(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(RevisionIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('restoreRevision', [Post, post])
+
+    const revision = await PostRevision.first({ id: revisionId })
+    if (!revision || revision.postId !== post.id) {
+      return this.json({ error: 'Not found' }, { status: 404 })
+    }
+
+    // Save current post as a revision before restoring
+    await PostRevision.create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+
+    // Restore the revision
+    await Post.update({ id: post.id }, {
+      title: revision.title,
+      excerpt: revision.excerpt,
+      body: revision.body,
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
 }
