+++ b/routes/api.ts
@@ -0,0 +1,51 @@
+import { AUTH_CONTEXT_KEY, createRateLimitMiddleware, getApiToken, requireAuthenticated, type AuthContext, type Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_WINDOW_MS = 60_000
+
+// Each token gets its own window: two tokens of one user are two scripts,
+// and ops wants no single script able to hammer the site. A session-cookie
+// caller (the browser) has no token, so it is keyed by user instead.
+const apiThrottle = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  keyGenerator: async (ctx) => {
+    const token = getApiToken(ctx)
+    if (token) {
+      return `token:${token.token.id}`
+    }
+    const auth = ctx.get(AUTH_CONTEXT_KEY) as AuthContext | undefined
+    return `user:${String(await auth?.id())}`
+  },
+})
+
+/**
+ * JSON routes for scripts holding a personal API token. `api.auth` is
+ * `requireAuthenticated()` without a redirect, which answers 401 JSON: a
+ * request carrying `Authorization: Bearer` resolves to the token guard, so a
+ * missing, malformed, unknown or revoked token all fail the same check.
+ * Aliases run in registration order, so the throttle sees the verified token.
+ */
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api.auth', requireAuthenticated())
+    .aliasMiddleware('api.throttle', apiThrottle)
+
+  router.group('/api', (api) => {
+    api.middleware('api.auth', 'api.throttle').group((authed) => {
+      authed.get('/posts', {
+        name: 'api.posts.index',
+        resource: { data: [PostResource] },
+      }, [ApiPostController, 'index'])
+
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [ApiPostController, 'store'])
+    })
+  })
+}
