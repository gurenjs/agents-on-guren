--- /dev/null
+++ b/config/health.ts
@@ -0,0 +1,29 @@
+import { createHealthManager, DatabaseCheck, type DatabaseConnection } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import { getDatabase } from './database.js'
+
+/**
+ * The deployment platform keeps a deploy in the load-balancer pool for as long
+ * as GET /health answers 2xx, so every probe has to reach the database for
+ * real — a cached flag would have kept a deploy with an unreachable database
+ * in rotation. Opening the connection is part of the probe: `getDatabase()`
+ * throws when the file (or server) cannot be opened, and `DatabaseCheck`
+ * reports that as `unhealthy` just like a failing query.
+ */
+const connection: DatabaseConnection = {
+  async query(statement: string): Promise<unknown> {
+    const db = (await getDatabase()) as { all(query: unknown): unknown }
+    return db.all(sql.raw(statement))
+  },
+}
+
+/**
+ * The app's dependency probes. The database is the only one so far; register
+ * further checks here as the app grows dependencies worth draining traffic for.
+ */
+export const health = createHealthManager().register(new DatabaseCheck(connection), {
+  // The database is the whole point of the probe: a failure has to drive the
+  // report to `unhealthy` (503), not merely to `degraded` (still 200).
+  critical: true,
+  timeout: 2_000,
+})
