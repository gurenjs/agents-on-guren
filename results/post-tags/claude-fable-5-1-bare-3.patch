+    }
+
+    const wanted = new Set(names.map((name) => idsByName.get(name)!))
+    const current = await PostTag.newQuery(options).where('postId', postId).get()
+    const attached = new Set(current.map((row) => row.tagId))
+
+    for (const row of current) {
+      if (!wanted.has(row.tagId)) {
+        await PostTag.delete({ postId, tagId: row.tagId }, options)
+      }
+    }
+
+    for (const tagId of wanted) {
