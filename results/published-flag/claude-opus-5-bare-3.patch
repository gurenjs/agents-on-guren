diff --git a/tests/PostDrafts.test.ts b/tests/PostDrafts.test.ts
new file mode 100644
index 0000000..227b4f8
--- /dev/null
+++ b/tests/PostDrafts.test.ts
@@ -0,0 +1,146 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse, refreshDatabase } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Drafts: a post is private to its author until `published` is switched on.
+// These run against the test database (config/database.ts points NODE_ENV=test
+// at data/guren.test.db), so the fixtures are recreated on every run.
+const AUTHOR_EMAIL = 'drafts-author@example.com'
+const READER_EMAIL = 'drafts-reader@example.com'
+const DRAFT_KEYWORD = 'unpublishable'
+
+async function makeUser(name: string, email: string): Promise<UserRecord> {
+  const existing = await User.first({ email })
+  if (existing) {
+    await Post.delete({ authorId: existing.id })
+    await User.delete({ id: existing.id })
+  }
+
+  return User.create({ name, email, password: 'secret' })
+}
+
+describe('post drafts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let draft: PostRecord
+  let published: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await refreshDatabase(migrateDatabase)
+
+    author = await makeUser('Draft Author', AUTHOR_EMAIL)
+    reader = await makeUser('Draft Reader', READER_EMAIL)
+
+    draft = await Post.forceCreate({
+      title: `A ${DRAFT_KEYWORD} draft`,
+      excerpt: 'Still being written.',
+      body: 'Nobody but the author may read this yet.',
+      authorId: author.id,
+      published: false,
+    })
+    published = await Post.forceCreate({
+      title: 'A published post',
+      excerpt: 'Readable by everyone.',
+      body: 'This one is live.',
+      authorId: author.id,
+      published: true,
+    })
+  })
+
+  async function listedIds(client: TestApp): Promise<number[]> {
+    const response = await client.get('/posts').assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    return (payload.props.data as PostResourceData[]).map((post) => post.id)
+  }
+
+  it('keeps a draft off the post list for guests', async () => {
+    const ids = await listedIds(http)
+
+    expect(ids).toContain(published.id)
+    expect(ids).not.toContain(draft.id)
+  })
+
+  it('keeps a draft off the post list for other users', async () => {
+    const ids = await listedIds(http.actingAs(reader))
+
+    expect(ids).not.toContain(draft.id)
+  })
+
+  it('shows the author their own draft in the list', async () => {
+    const ids = await listedIds(http.actingAs(author))
+
+    expect(ids).toContain(draft.id)
+  })
+
+  it('leaves a draft out of the search results', async () => {
+    const response = await http.query('/posts/search', { keywords: [DRAFT_KEYWORD] }).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+
+    expect(data).toHaveLength(0)
+  })
+
+  it('returns the draft to its author from the search', async () => {
+    const response = await http.actingAs(author).query('/posts/search', { keywords: [DRAFT_KEYWORD] }).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+
