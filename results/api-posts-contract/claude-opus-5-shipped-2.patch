diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..f03d71c
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,116 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The public JSON feed is the one route external consumers hit, so it is
+// covered against real rows: booting the app applies migrations, and
+// resetDatabase() drops the seeded demo data so the counts below are exact.
+describe('api.posts.index', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    alice = (await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret' })) as UserRecord
+    bob = (await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret' })) as UserRecord
+
+    // 12 posts by Alice, oldest first, then one by Bob as the newest of all.
+    // forceCreate, because `createdAt` is not fillable and the ordering under
+    // test depends on it.
+    for (let index = 1; index <= 12; index += 1) {
+      await Post.forceCreate({
+        title: `Alice post ${index}`,
+        excerpt: `Excerpt ${index}`,
+        body: `Body ${index}`,
+        authorId: alice.id,
+        createdAt: new Date(Date.UTC(2026, 0, index)).toISOString(),
+      })
+    }
+
+    await Post.forceCreate({
+      title: 'Bob post',
+      excerpt: 'Bob excerpt',
+      body: 'Bob body',
+      authorId: bob.id,
+      createdAt: new Date(Date.UTC(2026, 1, 1)).toISOString(),
+    })
+  })
+
+  it('lists the newest posts first, ten per page', async () => {
+    const response = await http.get('/api/posts')
+    response.assertOk()
+    expect(response.headers.get('content-type')).toContain('application/json')
+
+    const payload = await response.json<{
+      data: Array<{ id: number; title: string; excerpt: string; createdAt: string; author?: { id: number; name: string } }>
+      meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+    }>()
+
+    expect(payload.data).toHaveLength(10)
+    expect(payload.data[0]?.title).toBe('Bob post')
+    expect(payload.data[1]?.title).toBe('Alice post 12')
+    expect(payload.data[0]?.author).toEqual({ id: bob.id, name: 'Bob' })
+    expect(payload.data[0]?.createdAt).toBe('2026-02-01T00:00:00.000Z')
+    expect(payload.meta).toMatchObject({ currentPage: 1, lastPage: 2, perPage: 10, total: 13 })
+  })
+
+  it('serves the second page', async () => {
+    await http
+      .get('/api/posts?page=2')
+      .assertOk()
+      .assertJsonCount(3, 'data')
+      .assertJsonPath('data.0.title', 'Alice post 3')
+      .assertJsonPath('meta.currentPage', 2)
+      .assertJsonPath('meta.total', 13)
+  })
+
+  it('narrows the feed to a single author', async () => {
+    await http
+      .get(`/api/posts?author=${bob.id}`)
+      .assertOk()
+      .assertJsonCount(1, 'data')
+      .assertJsonPath('data.0.title', 'Bob post')
+      .assertJsonPath('meta.total', 1)
+      .assertJsonPath('meta.lastPage', 1)
+  })
+
+  it('combines the author filter with paging', async () => {
+    await http
+      .get(`/api/posts?author=${alice.id}&page=2`)
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Alice post 2')
+      .assertJsonPath('meta.total', 12)
+  })
+
+  it('returns an empty page for an author without posts', async () => {
+    const stranger = (await User.create({
+      name: 'Carol',
+      email: 'carol@example.com',
+      password: 'secret',
+    })) as UserRecord
+
+    await http
+      .get(`/api/posts?author=${stranger.id}`)
+      .assertOk()
+      .assertJsonCount(0, 'data')
+      .assertJsonPath('meta.total', 0)
+  })
+
+  it('rejects invalid query parameters', async () => {
+    await http.get('/api/posts?page=0').assertUnprocessable()
+    await http.get('/api/posts?page=abc').assertUnprocessable()
+    await http.get('/api/posts?author=abc').assertUnprocessable()
+    await http.get('/api/posts?author=0').assertUnprocessable()
+  })
+
+  it('needs no session or CSRF token', async () => {
+    await http.get('/api/posts').assertOk()
+  })
+})
