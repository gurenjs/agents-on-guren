diff --git a/app/Http/Middleware/ApiMiddleware.ts b/app/Http/Middleware/ApiMiddleware.ts
new file mode 100644
index 0000000..eae04d5
--- /dev/null
+++ b/app/Http/Middleware/ApiMiddleware.ts
@@ -0,0 +1,31 @@
+import {
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  defineMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+
+const authenticate = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed by token id, so two tokens of one user each get their own budget.
+const throttle = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiTokenOrFail(c).token.id,
+  message: 'Too many requests.',
+})
+
+// Authenticates first so only real tokens ever get a rate-limit bucket.
+export const apiTokenAuth = defineMiddleware(async (c, next) => {
+  let authenticated = false
+  const denied = await authenticate(c, async () => {
+    authenticated = true
+  })
+  if (!authenticated) return denied
+  return throttle(c, next)
+})
