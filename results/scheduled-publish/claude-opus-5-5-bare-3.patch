@@ -0,0 +1,17 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later, soonest first'
+
+  // Machine-readable on purpose: one `<id>\t<title>\t<published_at>` line per
+  // post and nothing else on stdout, so ops can pipe it into other tools.
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled()
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
