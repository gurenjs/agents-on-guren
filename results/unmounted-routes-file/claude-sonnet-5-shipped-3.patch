diff --git a/tests/AdminPostController.test.ts b/tests/AdminPostController.test.ts
new file mode 100644
index 0000000..0c5795b
--- /dev/null
+++ b/tests/AdminPostController.test.ts
@@ -0,0 +1,37 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('AdminPostController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects a guest to login instead of 404ing', async () => {
+    await http.get('/admin/posts').assertRedirect('/login')
+  })
+
+  it('lists every post, newest first, with its author', async () => {
+    const user = await User.create({ name: 'Admin', email: 'admin@example.com', password: 'password' })
+    const first = await Post.forceCreate({ title: 'First', excerpt: 'e1', body: 'b1', authorId: user.id })
+    const second = await Post.forceCreate({ title: 'Second', excerpt: 'e2', body: 'b2', authorId: user.id })
+
+    await http
+      .actingAs(user)
+      .get('/admin/posts')
+      .assertOk()
+      .assertJsonPath('data.0.id', second.id)
+      .assertJsonPath('data.0.title', second.title)
+      .assertJsonPath('data.0.author.id', user.id)
+      .assertJsonPath('data.1.id', first.id)
+  })
+})
