@@ -0,0 +1,246 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { kernel } from '../src/console.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2099-10-01T09:00:00.000Z'
+const LATER = '2099-12-24T18:30:00.000Z'
+const PAST = '2020-01-01T00:00:00.000Z'
+
+interface PostProps {
+  id: number
+  title: string
+  publishedAt: string | null
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    reader = await User.create({ name: 'Reader', email: 'reader@example.com', password: 'secret-password' })
+  })
+
+  function makePost(title: string, publishedAt: string | null, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, publishedAt, authorId: owner.id })
+  }
+
+  async function listedTitles(client: TestApp): Promise<string[]> {
+    const page = await (await client.withHeader('X-Inertia', 'true').get('/posts')).json<{
+      props: { data: PostProps[] }
+    }>()
+    return page.props.data.map((post) => post.title)
+  }
+
+  async function searchedTitles(client: TestApp, keyword: string): Promise<string[]> {
+    const result = await (await client.query('/posts/search', { keywords: [keyword] })).json<{ data: PostProps[] }>()
+    return result.data.map((post) => post.title)
+  }
+
+  async function shownPost(client: TestApp, id: number): Promise<PostProps> {
+    const response = await client.withHeader('X-Inertia', 'true').get(`/posts/${id}`).assertOk()
+    return (await response.json<{ props: { post: PostProps } }>()).props.post
+  }
+
+  describe('storing', () => {
+    const payload = { title: 'Launch', excerpt: 'Launch excerpt', body: 'Launch body' }
+
+    it('publishes at once when no date is given', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', payload).assertRedirect()
+
+      const [post] = await Post.all()
+      expect(post?.publishedAt).toBeNull()
+      expect(await listedTitles(http)).toEqual(['Launch'])
+    })
+
+    it('stores the date as a UTC ISO 8601 timestamp', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', { ...payload, publishAt: '2099-10-01T18:00:00+09:00' }).assertRedirect()
+
+      const [post] = await Post.all()
+      expect(post?.publishedAt).toBe(FUTURE)
+    })
+
+    it('treats null and an empty field as "publish now"', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', { ...payload, publishAt: null }).assertRedirect()
+      await csrf.post('/posts', { ...payload, publishAt: '' }).assertRedirect()
+
+      const stored = await Post.all()
+      expect(stored.map((post) => post.publishedAt)).toEqual([null, null])
+    })
+
+    it.each(['next tuesday', '2099-10-01', '2099-10-01T09:00:00', '2099-02-30T09:00:00.000Z', 1_790_000_000])(
+      'rejects %p and saves nothing',
+      async (publishAt) => {
+        const csrf = await http.actingAs(author).withCsrf()
+        await csrf
+          .json()
+          .post('/posts', { ...payload, publishAt })
+          .assertUnprocessable()
+          .assertJsonPath('errors.publishAt.0', 'Publish at must be a date and time.')
+
+        expect(await Post.newQuery().count()).toBe(0)
+      },
+    )
+
+    it('rejects a bad date the same way as an empty title', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      const badTitle = await csrf.post('/posts', { ...payload, title: '' })
+      const badDate = await csrf.post('/posts', { ...payload, publishAt: 'next tuesday' })
+
+      expect(badDate.status).toBe(badTitle.status)
+      expect(badDate.headers.get('location')).toBe(badTitle.headers.get('location'))
+    })
+  })
+
+  describe('updating', () => {
+    const payload = { title: 'Edited', excerpt: 'Edited excerpt', body: 'Edited body' }
+
+    async function publishedAtAfter(post: PostRecord, body: Record<string, unknown>): Promise<string | null> {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.put(`/posts/${post.id}`, body).assertRedirect(`/posts/${post.id}`)
+      return (await Post.findOrFail(post.id)).publishedAt
+    }
+
+    it('sets a date on a public post', async () => {
+      const post = await makePost('Public', null)
+      expect(await publishedAtAfter(post, { ...payload, publishAt: FUTURE })).toBe(FUTURE)
+    })
+
+    it('changes the date of a scheduled post', async () => {
+      const post = await makePost('Scheduled', FUTURE)
+      expect(await publishedAtAfter(post, { ...payload, publishAt: LATER })).toBe(LATER)
+    })
+
+    it('clears the date with null or by leaving it out', async () => {
+      const first = await makePost('First', FUTURE)
+      const second = await makePost('Second', FUTURE)
+
+      expect(await publishedAtAfter(first, { ...payload, publishAt: null })).toBeNull()
+      expect(await publishedAtAfter(second, payload)).toBeNull()
+    })
+
+    it('rejects a bad date and keeps the post as it was', async () => {
+      const post = await makePost('Scheduled', FUTURE)
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .json()
+        .put(`/posts/${post.id}`, { ...payload, publishAt: 'next tuesday' })
+        .assertUnprocessable()
+
+      const stored = await Post.findOrFail(post.id)
+      expect(stored.title).toBe('Scheduled')
+      expect(stored.publishedAt).toBe(FUTURE)
+    })
+  })
+
+  describe('a scheduled post', () => {
+    let scheduled: PostRecord
+
+    beforeEach(async () => {
+      await makePost('Evergreen', null)
+      scheduled = await makePost('Embargoed', FUTURE)
+    })
+
+    it('answers 404 on its page to guests and other users', async () => {
+      await http.get(`/posts/${scheduled.id}`).assertNotFound()
+      await http.actingAs(reader).get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('opens for its author with publishedAt', async () => {
+      const post = await shownPost(http.actingAs(author), scheduled.id)
+      expect(post.publishedAt).toBe(FUTURE)
+    })
+
+    it('is listed for its author only', async () => {
+      expect(await listedTitles(http)).toEqual(['Evergreen'])
+      expect(await listedTitles(http.actingAs(reader))).toEqual(['Evergreen'])
+      expect(await listedTitles(http.actingAs(author))).toEqual(['Embargoed', 'Evergreen'])
+    })
+
+    it('does not count towards the pages other people see', async () => {
+      const page = await (await http.withHeader('X-Inertia', 'true').get('/posts')).json<{
+        props: { pagination: { meta: { total: number } } }
+      }>()
+      expect(page.props.pagination.meta.total).toBe(1)
+    })
+
+    it('stays out of search for guests and other users', async () => {
+      expect(await searchedTitles(http, 'e')).toEqual(['Evergreen'])
+      expect(await searchedTitles(http.actingAs(reader), 'Embargoed')).toEqual([])
+      expect(await searchedTitles(http.actingAs(author), 'Embargoed')).toEqual(['Embargoed'])
+    })
+
+    it('stays off the home page', async () => {
+      const page = await (await http.actingAs(author).withHeader('X-Inertia', 'true').get('/')).json<{
+        props: { latest: PostProps[] }
+      }>()
+      expect(page.props.latest.map((post) => post.title)).toEqual(['Evergreen'])
+    })
+
+    it('answers 404, not 403, when someone else tries to change it', async () => {
+      const csrf = await http.actingAs(reader).withCsrf()
+      const payload = { title: 'Hijacked', excerpt: 'x', body: 'x' }
+
+      await csrf.get(`/posts/${scheduled.id}/edit`).assertNotFound()
+      await csrf.put(`/posts/${scheduled.id}`, payload).assertNotFound()
+      await csrf.delete(`/posts/${scheduled.id}`).assertNotFound()
+
+      expect((await Post.findOrFail(scheduled.id)).title).toBe('Embargoed')
+    })
+
+    it('is public to everyone once its time has passed', async () => {
+      await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+
+      expect((await shownPost(http, scheduled.id)).publishedAt).toBe(PAST)
+      expect((await shownPost(http.actingAs(reader), scheduled.id)).publishedAt).toBe(PAST)
+      expect(await listedTitles(http)).toEqual(['Embargoed', 'Evergreen'])
+      expect(await searchedTitles(http, 'Embargoed')).toEqual(['Embargoed'])
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    async function report(): Promise<{ code: number; lines: string[] }> {
+      const output = new BufferedOutput()
+      const previous = kernel.getOutput()
+      kernel.setOutput(output)
+      try {
+        const code = await kernel.handle(['posts:scheduled'])
+        return { code, lines: output.getLines() }
+      } finally {
+        kernel.setOutput(previous)
+      }
+    }
+
+    it('prints scheduled posts soonest first, tab-separated', async () => {
+      const later = await makePost('Later', LATER)
+      await makePost('Public', null)
+      await makePost('Already live', PAST)
+      const sooner = await makePost('Sooner', FUTURE, reader)
+
+      expect(await report()).toEqual({
+        code: 0,
+        lines: [`${sooner.id}\tSooner\t${FUTURE}`, `${later.id}\tLater\t${LATER}`],
+      })
+    })
+
+    it('prints nothing when nothing is scheduled', async () => {
+      await makePost('Public', null)
+
+      expect(await report()).toEqual({ code: 0, lines: [] })
+    })
+  })
+})
