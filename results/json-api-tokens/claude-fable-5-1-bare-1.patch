+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase, type AppSeederContext } from '../config/database.js'
+import { apiTokens, posts } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the real app and the test database (NODE_ENV=test
+// points config/database.ts at it). Rows are never cleaned up, so every user
+// gets an address of its own and assertions only look at rows they created.
+
+type Database = AppSeederContext['db']
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+let userCount = 0
+
+async function createUser(): Promise<UserRecord> {
+  userCount += 1
+  return User.create({
+    name: `Token Tester ${userCount}`,
+    email: `tokens-${run}-${userCount}@example.com`,
+    password: 'secret-password',
+  })
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let db: Database
+  let alice: UserRecord
+  let bob: UserRecord
+
+  // A signed-in browser: session user, CSRF cookie and header, JSON responses.
+  async function signedIn(user: UserRecord): Promise<TestApp> {
+    return http.actingAs(user).json().withCsrf('/login')
+  }
+
+  async function createToken(user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+    const browser = await signedIn(user)
+    const response = await browser.post('/profile/tokens', { name }).assertStatus(201)
+    return (await response.json()) as CreatedToken
+  }
+
+  // A script: the bearer header and nothing else, no cookies.
+  function script(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  async function postsBy(user: UserRecord) {
+    return db.select().from(posts).where(eq(posts.authorId, user.id))
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    db = (await getDatabase()) as Database
+    alice = await createUser()
+    bob = await createUser()
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('answers 201 with the id, the name and the plain-text token', async () => {
+      const created = await createToken(alice, 'old laptop')
+
+      expect(created.name).toBe('old laptop')
+      expect(typeof created.id).toBe('string')
+      const [publicPart, secret] = created.token.split('|')
+      expect(publicPart).toBe(created.id)
+      expect(secret?.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token every time', async () => {
+      const first = await createToken(alice)
+      const second = await createToken(alice)
+
+      expect(first.token).not.toBe(second.token)
+      expect(first.id).not.toBe(second.id)
+    })
+
+    it('stores nothing the token could be read back from', async () => {
+      const created = await createToken(alice)
+      const secret = created.token.split('|')[1] ?? ''
+
+      const [row] = await db.select().from(apiTokens).where(eq(apiTokens.id, created.id))
+      expect(row).toBeDefined()
+      for (const value of Object.values(row ?? {})) {
+        expect(String(value)).not.toContain(secret)
+        expect(String(value)).not.toContain(created.token)
+      }
+    })
+
+    it('accepts a 50-character name', async () => {
+      const created = await createToken(alice, 'n'.repeat(50))
+      expect(created.name).toHaveLength(50)
+    })
+
+    it.each([
+      ['a missing name', {}],
+      ['an empty name', { name: '' }],
+      ['a blank name', { name: '   ' }],
+      ['a 51-character name', { name: 'n'.repeat(51) }],
+      ['a name that is not text', { name: 42 }],
+    ])('answers 422 for %s and creates nothing', async (_label, body) => {
+      const user = await createUser()
+      const browser = await signedIn(user)
+
+      await browser.post('/profile/tokens', body).assertStatus(422)
+
+      expect(await db.select().from(apiTokens).where(eq(apiTokens.userId, user.id))).toHaveLength(0)
+    })
+
+    it('gives a guest no token', async () => {
+      const before = await db.select().from(apiTokens)
+      const guest = await http.json().withCsrf('/login')
+
+      await guest.post('/profile/tokens', { name: 'CI' }).assertRedirect('/login')
+
+      expect(await db.select().from(apiTokens)).toHaveLength(before.length)
+    })
+
+    it('does not accept a bearer token in place of the session', async () => {
+      const { token } = await createToken(alice)
+      const before = await db.select().from(apiTokens).where(eq(apiTokens.userId, alice.id))
+
+      await script(token).post('/profile/tokens', { name: 'minted by a token' }).assertRedirect('/login')
+
+      expect(await db.select().from(apiTokens).where(eq(apiTokens.userId, alice.id))).toHaveLength(before.length)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('answers 204 and the token stops working at once', async () => {
+      const revoked = await createToken(alice, 'revoked')
+      const kept = await createToken(alice, 'kept')
+      await script(revoked.token).get('/api/posts').assertOk()
+
+      const browser = await signedIn(alice)
+      await browser.delete(`/profile/tokens/${revoked.id}`).assertStatus(204)
+
+      await script(revoked.token).get('/api/posts').assertStatus(401)
+      await script(kept.token).get('/api/posts').assertOk()
+      expect(await db.select().from(apiTokens).where(eq(apiTokens.id, revoked.id))).toHaveLength(0)
+    })
+
+    it("answers 404 for another user's token, which keeps working", async () => {
+      const theirs = await createToken(bob)
+
+      const browser = await signedIn(alice)
+      await browser.delete(`/profile/tokens/${theirs.id}`).assertStatus(404)
+
+      await script(theirs.token).get('/api/posts').assertOk()
+    })
+
+    it('answers 404 for a token that does not exist', async () => {
+      const browser = await signedIn(alice)
+      await browser.delete('/profile/tokens/no-such-token').assertStatus(404)
+    })
+
+    it('refuses a guest', async () => {
+      const theirs = await createToken(bob)
+      const guest = await http.json().withCsrf('/login')
+
+      await guest.delete(`/profile/tokens/${theirs.id}`).assertRedirect('/login')
+
+      await script(theirs.token).get('/api/posts').assertOk()
+    })
+  })
+
+  describe('GET /profile', () => {
+    it("lists the user's own tokens by name, without any secret", async () => {
+      const user = await createUser()
+      const created = await createToken(user, 'release notes cron')
+      await createToken(bob, 'not mine')
+
+      const response = await http.actingAs(user).get('/profile').assertOk()
+      const html = await response.text()
+
+      expect(html).toContain('release notes cron')
+      expect(html).not.toContain('not mine')
+      expect(html).not.toContain(created.token.split('|')[1] ?? '')
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    it('lists every post by every author, newest first', async () => {
+      const { token: aliceToken } = await createToken(alice)
+      const { token: bobToken } = await createToken(bob)
+      await script(aliceToken).post('/api/posts', { title: 'By Alice', excerpt: 'One', body: 'Text' }).assertStatus(201)
+      await script(bobToken).post('/api/posts', { title: 'By Bob', excerpt: 'Two', body: 'Text' }).assertStatus(201)
+
+      const response = await script(aliceToken).get('/api/posts').assertOk()
+      const { data } = (await response.json()) as { data: ApiPost[] }
+
+      expect(data).toHaveLength((await db.select().from(posts)).length)
+      expect(data[0]).toMatchObject({ title: 'By Bob', excerpt: 'Two', authorId: bob.id })
+      expect(data[1]).toMatchObject({ title: 'By Alice', excerpt: 'One', authorId: alice.id })
+      const created = data.map((post) => post.createdAt)
+      expect(created).toEqual([...created].sort().reverse())
+      for (const post of data) {
+        expect(typeof post.id).toBe('number')
+        expect(new Date(post.createdAt).toISOString()).toBe(post.createdAt)
+      }
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it("creates the post as the token's owner, whatever the body says", async () => {
+      const user = await createUser()
+      const { token } = await createToken(user)
+
+      const response = await script(token)
+        .post('/api/posts', { title: 'Release 1.2', excerpt: 'Notes', body: 'Fixed things.', authorId: bob.id })
+        .assertStatus(201)
+      const { data } = (await response.json()) as { data: ApiPost }
+
+      expect(data).toMatchObject({ title: 'Release 1.2', excerpt: 'Notes', authorId: user.id })
+      expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+      const stored = await postsBy(user)
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ id: data.id, title: 'Release 1.2', body: 'Fixed things.' })
+    })
+
+    it('works for a client that kept the cookies of an earlier response', async () => {
+      const user = await createUser()
+      const { token } = await createToken(user)
+      const read = await script(token).get('/api/posts').assertOk()
+      const cookies = read.headers
+        .getSetCookie()
+        .map((cookie) => cookie.split(';')[0])
+        .join('; ')
+
+      const client = cookies ? script(token).withHeader('Cookie', cookies) : script(token)
+      await client.post('/api/posts', { title: 'Kept cookies', excerpt: 'Still fine', body: 'Text' }).assertStatus(201)
+    })
+
+    it.each([
+      ['an empty title', { title: '', excerpt: 'Notes', body: 'Text' }],
+      ['no body', { title: 'Release', excerpt: 'Notes' }],
+      ['no excerpt', { title: 'Release', body: 'Text' }],
+      ['a title that is too long', { title: 't'.repeat(256), excerpt: 'Notes', body: 'Text' }],
+    ])('answers 422 for %s and creates nothing', async (_label, body) => {
+      const user = await createUser()
+      const { token } = await createToken(user)
+
+      const response = await script(token).post('/api/posts', body).assertStatus(422)
+
+      expect(response.headers.get('content-type')).toContain('application/json')
+      expect(await response.json()).toHaveProperty('errors')
+      expect(await postsBy(user)).toHaveLength(0)
+    })
+  })
+
+  describe('unauthenticated requests', () => {
+    async function credentials(): Promise<Array<[string, Record<string, string>]>> {
+      const valid = await createToken(alice)
+      const revoked = await createToken(alice)
+      const browser = await signedIn(alice)
+      await browser.delete(`/profile/tokens/${revoked.id}`).assertStatus(204)
+      const [id, secret] = valid.token.split('|') as [string, string]
+      const flipped = secret.endsWith('0') ? `${secret.slice(0, -1)}1` : `${secret.slice(0, -1)}0`
+      const other = await createToken(bob)
+
+      return [
+        ['no header', {}],
+        ['an empty bearer', { Authorization: 'Bearer ' }],
+        ['another scheme', { Authorization: `Basic ${valid.token}` }],
+        ['a token without its id', { Authorization: `Bearer ${secret}` }],
+        ['an id without its secret', { Authorization: `Bearer ${id}|` }],
+        ['an unknown token', { Authorization: `Bearer ${'a'.repeat(32)}|${'b'.repeat(64)}` }],
+        ['a tampered secret', { Authorization: `Bearer ${id}|${flipped}` }],
+        ["another token's id", { Authorization: `Bearer ${other.id}|${secret}` }],
+        ['the stored hash as the secret', { Authorization: `Bearer ${id}|${await storedHash(id)}` }],
+        ['a revoked token', { Authorization: `Bearer ${revoked.token}` }],
+      ]
+    }
+
+    async function storedHash(id: string): Promise<string> {
+      const [row] = await db.select().from(apiTokens).where(eq(apiTokens.id, id))
+      return row?.hashedToken ?? ''
+    }
+
+    it('answers 401 with a JSON body on both routes and creates nothing', async () => {
+      const before = (await db.select().from(posts)).length
+
+      for (const [label, headers] of await credentials()) {
+        const client = http.json().withHeaders(headers)
+
+        const read = await client.get('/api/posts')
+        expect(read.status, `GET with ${label}`).toBe(401)
+        expect(read.headers.get('content-type'), `GET with ${label}`).toContain('application/json')
+        expect(await read.json(), `GET with ${label}`).toHaveProperty('message')
+
+        // Invalid on purpose: a request that cannot sign in must not learn
+        // whether its body would have been accepted.
+        const write = await client.post('/api/posts', { title: '' })
+        expect(write.status, `POST with ${label}`).toBe(401)
+        expect(write.headers.get('content-type'), `POST with ${label}`).toContain('application/json')
+
+        const valid = await client.post('/api/posts', { title: 'Nope', excerpt: 'Nope', body: 'Nope' })
+        expect(valid.status, `valid POST with ${label}`).toBe(401)
+      }
+
+      expect((await db.select().from(posts)).length).toBe(before)
+    })
+
+    it('does not accept a signed-in session in place of a token', async () => {
+      const browser = await signedIn(alice)
+
+      await browser.get('/api/posts').assertStatus(401)
+      await browser.post('/api/posts', { title: 'Nope', excerpt: 'Nope', body: 'Nope' }).assertStatus(401)
+    })
+  })
+
+  describe('bearer tokens outside /api', () => {
+    it('do not sign in on the web routes', async () => {
+      const user = await createUser()
+      const { token } = await createToken(user)
+
+      await script(token).get('/dashboard').assertRedirect('/login')
+      await script(token).post('/posts', { title: 'Nope', excerpt: 'Nope', body: 'Nope' }).assertRedirect('/login')
+      await script(token)
+        .put('/profile', { name: 'Taken over', email: user.email, password: 'new-password' })
+        .assertRedirect('/login')
+
+      expect(await postsBy(user)).toHaveLength(0)
+      expect((await User.find(user.id))?.name).toBe(user.name)
+    })
+  })
+
+  describe('rate limit', () => {
+    it('answers the 61st request in a minute with 429 and Retry-After, per token', async () => {
+      const limited = await createToken(alice, 'busy script')
+      const other = await createToken(alice, 'quiet script')
+
+      for (let request = 1; request <= 60; request += 1) {
+        const response = await script(limited.token).get('/api/posts')
+        expect(response.status, `request ${request}`).toBe(200)
+      }
+
+      const refused = await script(limited.token).get('/api/posts')
+      expect(refused.status).toBe(429)
+      expect(refused.headers.get('content-type')).toContain('application/json')
+      const retryAfter = Number(refused.headers.get('Retry-After'))
+      expect(Number.isInteger(retryAfter)).toBe(true)
+      expect(retryAfter).toBeGreaterThanOrEqual(1)
+      expect(retryAfter).toBeLessThanOrEqual(60)
+
+      const before = (await postsBy(alice)).length
+      await script(limited.token)
+        .post('/api/posts', { title: 'Over the limit', excerpt: 'Nope', body: 'Nope' })
+        .assertStatus(429)
+      expect(await postsBy(alice)).toHaveLength(before)
+
+      await script(other.token).get('/api/posts').assertOk()
+    })
+  })
+})
