diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..e98932c
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,180 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Booting the app migrates the test database (data/guren.test.db). It persists
+// between runs, so every fixture here carries a per-run suffix.
+const run = `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`
+const tagged = (name: string) => `${name}-${run}`
+
+const payload = (overrides: Record<string, unknown> = {}) => ({
+  title: `Tagged post ${run}`,
+  excerpt: 'A post with tags.',
+  body: 'Body text.',
+  ...overrides,
+})
+
+async function postProps(http: TestApp, path: string): Promise<{ post: PostResourceData }> {
+  const response = await http.get(path).assertOk()
+  const { payload: page } = await readInertiaResponse(response.raw)
+  return page.props as unknown as { post: PostResourceData }
+}
+
+async function indexProps(http: TestApp, path: string): Promise<{ data: PostResourceData[]; pagination: { links: { pages: { url: string | null }[] } }; tag?: string }> {
+  const response = await http.get(path).assertOk()
+  const { payload: page } = await readInertiaResponse(response.raw)
+  return page.props as unknown as { data: PostResourceData[]; pagination: { links: { pages: { url: string | null }[] } }; tag?: string }
+}
+
+function idFromRedirect(response: { raw: Response }): number {
+  const location = response.raw.headers.get('location') ?? ''
+  const match = /\/posts\/(\d+)$/.exec(location)
+  if (!match) throw new Error(`Expected a redirect to a post, got ${location}`)
+  return Number(match[1])
+}
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const rows = await PostTag.newQuery().where('postId', postId).get()
+  const tags = rows.length > 0 ? await Tag.newQuery().whereIn('id', rows.map((row) => row.tagId)).get() : []
+  return tags.map((tag) => tag.name).sort()
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: TestApp
+  let guest: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const user = await User.create({ name: 'Tagger', email: `tagger-${run}@example.com`, password: 'secret' })
+    author = await http.actingAs(user).withCsrf('/posts')
+    guest = http
+  })
+
+  it('creates the tags, attaches them, and shows them sorted on the post page', async () => {
+    const bun = tagged('bun')
+    const webdev = tagged('webdev')
+    const response = await author.post('/posts', payload({ tags: `${webdev}, ${bun}` }))
+    const postId = idFromRedirect(response)
+
+    expect(await Tag.first({ name: bun })).not.toBeNull()
+    expect(await Tag.first({ name: webdev })).not.toBeNull()
+    expect(await tagNamesOf(postId)).toEqual([bun, webdev].sort())
+
+    const { post } = await postProps(guest, `/posts/${postId}`)
+    expect(post.tags).toEqual([bun, webdev].sort())
+  })
+
+  it('detaches tags removed on edit and keeps the tag row', async () => {
+    const keep = tagged('keep')
+    const drop = tagged('drop')
+    const created = await author.post('/posts', payload({ tags: `${keep}, ${drop}` }))
+    const postId = idFromRedirect(created)
+
+    await author.put(`/posts/${postId}`, payload({ tags: keep })).assertRedirect(`/posts/${postId}`)
+
+    expect(await tagNamesOf(postId)).toEqual([keep])
+    expect(await Tag.first({ name: drop })).not.toBeNull()
+
+    const { post } = await postProps(guest, `/posts/${postId}`)
+    expect(post.tags).toEqual([keep])
+
+    const edit = await postProps(author, `/posts/${postId}/edit`)
+    expect(edit.post.tags).toEqual([keep])
+  })
+
+  it('treats a missing or empty field as no tags', async () => {
+    const withTags = idFromRedirect(await author.post('/posts', payload({ tags: tagged('temp') })))
+    await author.put(`/posts/${withTags}`, payload({ tags: '' })).assertRedirect(`/posts/${withTags}`)
+    expect(await tagNamesOf(withTags)).toEqual([])
+
+    const without = idFromRedirect(await author.post('/posts', payload()))
+    expect(await tagNamesOf(without)).toEqual([])
+    const { post } = await postProps(guest, `/posts/${without}`)
+    expect(post.tags).toEqual([])
+  })
+
+  it('filters the list by tag, keeps the filter in page links, and lists nothing for an unused tag', async () => {
+    const only = tagged('only')
+    const postId = idFromRedirect(await author.post('/posts', payload({ tags: only })))
+    const other = idFromRedirect(await author.post('/posts', payload({ tags: tagged('other') })))
+
+    const filtered = await indexProps(guest, `/posts?tag=${encodeURIComponent(only)}`)
+    expect(filtered.data.map((post) => post.id)).toEqual([postId])
+    expect(filtered.data[0]?.tags).toEqual([only])
+    expect(filtered.tag).toBe(only)
+    for (const page of filtered.pagination.links.pages) {
+      expect(page.url).toContain(`tag=${encodeURIComponent(only)}`)
+    }
+
+    const empty = await indexProps(guest, `/posts?tag=${encodeURIComponent(tagged('nobody'))}`)
+    expect(empty.data).toEqual([])
+
+    const all = await indexProps(guest, '/posts')
+    for (const post of all.data) {
+      expect(Array.isArray(post.tags)).toBe(true)
+    }
+    const otherPost = all.data.find((post) => post.id === other)
+    expect(otherPost?.tags).toEqual([tagged('other')])
+  })
+
+  it('refuses six tags the way an empty title is refused, writing nothing', async () => {
+    const before = {
+      posts: (await Post.newQuery().get()).length,
+      tags: (await Tag.newQuery().get()).length,
+      pivot: (await PostTag.newQuery().get()).length,
+    }
+
+    const emptyTitle = await author.post('/posts', payload({ title: '' }))
+    const six = ['a', 'b', 'c', 'd', 'e', 'f'].map(tagged).join(',')
+    const tooMany = await author.post('/posts', payload({ tags: six }))
+    expect(tooMany.raw.status).toBe(emptyTitle.raw.status)
+
+    const json = await author.json().post('/posts', payload({ tags: six }))
+    expect(json.raw.status).toBe(422)
+    const body = (await json.raw.json()) as { errors: Record<string, unknown> }
+    expect(body.errors).toHaveProperty('tags')
+
+    expect((await Post.newQuery().get()).length).toBe(before.posts)
+    expect((await Tag.newQuery().get()).length).toBe(before.tags)
+    expect((await PostTag.newQuery().get()).length).toBe(before.pivot)
+  })
+
+  it('refuses a 31-character name and saves a 30-character one', async () => {
+    const thirty = `${run}-`.padEnd(30, 'x')
+    const thirtyOne = `${run}-`.padEnd(31, 'y')
+    expect(thirty.length).toBe(30)
+    expect(thirtyOne.length).toBe(31)
+
+    const emptyTitle = await author.post('/posts', payload({ title: '' }))
+    const tooLong = await author.post('/posts', payload({ tags: thirtyOne }))
+    expect(tooLong.raw.status).toBe(emptyTitle.raw.status)
+    expect(await Tag.first({ name: thirtyOne })).toBeNull()
+
+    const postId = idFromRedirect(await author.post('/posts', payload({ tags: thirty })))
+    expect(await tagNamesOf(postId)).toEqual([thirty])
+  })
+
+  it('trims, drops empty entries, and counts a repeated name once', async () => {
+    const bun = tagged('dup')
+    const postId = idFromRedirect(await author.post('/posts', payload({ tags: ` ${bun} ,${bun},, ` })))
+
+    const rows = await PostTag.newQuery().where('postId', postId).get()
+    expect(rows.length).toBe(1)
+    expect(await tagNamesOf(postId)).toEqual([bun])
+    expect((await Tag.newQuery().where('name', bun).get()).length).toBe(1)
+  })
+
+  it('still deletes a tagged post', async () => {
+    const postId = idFromRedirect(await author.post('/posts', payload({ tags: tagged('gone') })))
+    await author.delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    expect(await Post.first({ id: postId })).toBeNull()
+    expect((await PostTag.newQuery().where('postId', postId).get()).length).toBe(0)
+  })
+})
