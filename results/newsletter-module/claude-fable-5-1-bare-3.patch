@@ -0,0 +1,99 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+// The test database persists between runs, so every address is unique per run.
+const run = Date.now()
+const address = (label: string): string => `${label}-${run}@example.com`
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  // Mutating routes need the CSRF cookie a browser would carry; withCsrf primes it.
+  async function guest(referer?: string) {
+    const client = (await http.withCsrf()).json()
+    return referer ? client.withHeader('Referer', referer) : client
+  }
+
+  describe('POST /newsletter/subscribe', () => {
+    it('stores a pending subscription with a token and redirects back', async () => {
+      const email = address('subscribe')
+      const client = await guest('http://localhost/posts')
+
+      await client.post('/newsletter/subscribe', { email }).assertRedirect('http://localhost/posts')
+
+      const subscription = await NewsletterSubscription.first({ email })
+      expect(subscription).not.toBeNull()
+      expect(subscription?.confirmedAt).toBeNull()
+      expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to the home page without a Referer', async () => {
+      const client = await guest()
+
+      await client.post('/newsletter/subscribe', { email: address('no-referer') }).assertRedirect('/')
+    })
+
+    it('rejects an invalid email with a 422 under email', async () => {
+      const client = await guest('http://localhost/')
+      const before = await NewsletterSubscription.newQuery().count()
+
+      const response = await client.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+      const payload = (await response.raw.json()) as { errors: Record<string, string[]> }
+      expect(payload.errors.email).toBeDefined()
+
+      await client.post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+      expect(await NewsletterSubscription.newQuery().count()).toBe(before)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const email = address('duplicate')
+      const client = await guest('http://localhost/')
+
+      await client.post('/newsletter/subscribe', { email }).assertRedirect('http://localhost/')
+      const response = await client.post('/newsletter/subscribe', { email }).assertStatus(422)
+      const payload = (await response.raw.json()) as { errors: Record<string, string[]> }
+      expect(payload.errors.email).toBeDefined()
+
+      expect(await NewsletterSubscription.where({ email }).count()).toBe(1)
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('marks the subscription confirmed and redirects home', async () => {
+      const email = address('confirm')
+      const client = await guest('http://localhost/')
+      await client.post('/newsletter/subscribe', { email })
+
+      const pending = await NewsletterSubscription.first({ email })
+      await http.get(`/newsletter/confirm/${pending!.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.first({ email })
+      expect(confirmed?.confirmedAt).not.toBeNull()
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      await http.get('/newsletter/confirm/this-token-was-never-issued').assertStatus(404)
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('deletes only that subscription and redirects back', async () => {
+      const leaving = address('leaving')
+      const staying = address('staying')
+      const client = await guest('http://localhost/posts')
+      await client.post('/newsletter/subscribe', { email: leaving })
+      await client.post('/newsletter/subscribe', { email: staying })
+
+      await client.post('/newsletter/unsubscribe', { email: leaving }).assertRedirect('http://localhost/posts')
+
+      expect(await NewsletterSubscription.first({ email: leaving })).toBeNull()
+      expect(await NewsletterSubscription.first({ email: staying })).not.toBeNull()
+    })
+  })
+})
