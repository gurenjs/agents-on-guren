diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..ba96107
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,77 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeToken(email: string, name = 'CI') {
+    const user = await User.create({ name: 'A', email, password: 'password123' })
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    return { user, res, body: await res.json<{ id: number; name: string; token: string }>() }
+  }
+
+  it('creates a token, stores only a hash, and authenticates the API', async () => {
+    const { user, res, body } = await makeToken('a@example.com')
+    expect(res.status).toBe(201)
+    expect(body.token.length).toBeGreaterThanOrEqual(16)
+    expect(JSON.stringify(await ApiToken.all())).not.toContain(body.token)
+
+    const bearer = http.json().withHeader('Authorization', `Bearer ${body.token}`)
+    const created = await bearer.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(created.status).toBe(201)
+    expect((await created.json<{ data: { authorId: number } }>()).data.authorId).toBe(user.id)
+    await bearer.post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+    await bearer.get('/api/posts').assertOk().assertJsonCount(1, 'data')
+    expect(await Post.all()).toHaveLength(1)
+  })
+
+  it('rejects bad tokens and revoked tokens, 404s foreign revocation', async () => {
+    const { body } = await makeToken('a@example.com')
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', `Bearer ${body.token}x`).get('/api/posts').assertUnauthorized()
+
+    const other = await User.create({ name: 'B', email: 'b@example.com', password: 'password123' })
+    const otherCsrf = await http.actingAs(other).withCsrf()
+    await otherCsrf.json().delete(`/profile/tokens/${body.id}`).assertNotFound()
+    await http.json().withHeader('Authorization', `Bearer ${body.token}`).get('/api/posts').assertOk()
+
+    const owner = (await User.first({ email: 'a@example.com' }))!
+    const csrf = await http.actingAs(owner).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${body.id}`).assertNoContent()
+    await http.json().withHeader('Authorization', `Bearer ${body.token}`).get('/api/posts').assertUnauthorized()
+  })
+
+  it('validates the token name', async () => {
+    const user = await User.create({ name: 'A', email: 'a@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('rate limits per token', async () => {
+    const { user, body } = await makeToken('a@example.com')
+    const csrf = await http.actingAs(user).withCsrf()
+    const second = await (await csrf.json().post('/profile/tokens', { name: 'two' })).json<{ token: string }>()
+    const bearer = http.json().withHeader('Authorization', `Bearer ${body.token}`)
+    for (let i = 0; i < 60; i++) await bearer.get('/api/posts').assertOk()
+    const limited = await bearer.get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.json().withHeader('Authorization', `Bearer ${second.token}`).get('/api/posts').assertOk()
+  })
+})
