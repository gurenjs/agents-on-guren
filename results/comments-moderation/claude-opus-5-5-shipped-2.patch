diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..eb504a4
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,114 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment, type CommentRecord } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let counter = 0
+
+async function makeUser(name: string): Promise<UserRecord> {
+  counter += 1
+  return (await User.create({ name, email: `${name.toLowerCase()}${counter}@example.com`, password: 'secret123' })) as UserRecord
+}
+
+async function makePost(author: UserRecord): Promise<PostRecord> {
+  return (await Post.forceCreate({ title: 'T', excerpt: 'E', body: 'B', authorId: author.id })) as PostRecord
+}
+
+async function makeComment(post: PostRecord, author: UserRecord, body = 'Nice'): Promise<CommentRecord> {
+  return (await Comment.forceCreate({ postId: post.id, userId: author.id, body })) as CommentRecord
+}
+
+async function showProps(http: TestApp, postId: number): Promise<{ comments: Array<Record<string, unknown>> }> {
+  const res = await http.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${postId}`)
+  res.assertOk()
+  const page = await res.json<{ props: { comments: Array<Record<string, unknown>> } }>()
+  return page.props
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+  let carol: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = await makeUser('Alice')
+    bob = await makeUser('Bob')
+    carol = await makeUser('Carol')
+    post = await makePost(alice)
+  })
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('stores a comment and lists it oldest first with its author', async () => {
+    const csrf = await http.actingAs(bob).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const { comments } = await showProps(http, post.id)
+    expect(comments.map((c) => c.body)).toEqual(['first', 'second'])
+    expect(comments[0]?.author).toEqual({ id: bob.id, name: 'Bob' })
+    expect(typeof comments[0]?.createdAt).toBe('string')
+  })
+
+  it('rejects an empty or too long body', async () => {
+    const csrf = await http.actingAs(bob).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('lets the comment author and the post author delete, nobody else', async () => {
+    const first = await makeComment(post, bob)
+    const second = await makeComment(post, bob)
+
+    await (await http.actingAs(carol).withCsrf()).delete(`/comments/${first.id}`).assertForbidden()
+    expect(await Comment.find(first.id)).not.toBeNull()
+
+    await (await http.actingAs(bob).withCsrf()).delete(`/comments/${first.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(first.id)).toBeNull()
+
+    await (await http.actingAs(alice).withCsrf()).delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second.id)).toBeNull()
+  })
+
+  it('counts a repeated report once and hides after three reporters', async () => {
+    const comment = await makeComment(post, bob)
+    const dave = await makeUser('Dave')
+
+    const aliceCsrf = await http.actingAs(alice).withCsrf()
+    await aliceCsrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    await aliceCsrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+
+    await (await http.actingAs(carol).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(http, post.id)).comments).toHaveLength(1)
+
+    await (await http.actingAs(dave).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(http.actingAs(bob), post.id)).comments).toHaveLength(0)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes comments when their post is deleted', async () => {
+    const comment = await makeComment(post, bob)
+    await (await http.actingAs(bob).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await (await http.actingAs(alice).withCsrf()).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(0)
+  })
+})
