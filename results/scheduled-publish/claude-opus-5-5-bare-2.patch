new file mode 100644
index 0000000..7513117
--- /dev/null
+++ b/app/Console/Commands/ListScheduledPostsCommand.ts
@@ -0,0 +1,22 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints the publishing calendar for ops: `<id>\t<title>\t<published_at>` per
+ * scheduled post, soonest first, and nothing else on stdout so it pipes
+ * cleanly into other tools.
+ */
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later (id, title, published_at; tab-separated)'
+
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled()
+
+    for (const post of posts) {
+      // Tabs and newlines in a title would break the one-row-per-line format.
+      const title = post.title.replace(/[\t\r\n]+/g, ' ')
+      process.stdout.write(`${post.id}\t${title}\t${post.publishedAt}\n`)
+    }
+  }
+}
