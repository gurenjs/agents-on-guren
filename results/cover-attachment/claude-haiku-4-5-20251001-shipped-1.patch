diff --git a/app/Services/StorageService.ts b/app/Services/StorageService.ts
new file mode 100644
index 0000000..ec76d16
--- /dev/null
+++ b/app/Services/StorageService.ts
@@ -0,0 +1,76 @@
+import { mkdir, writeFile, unlink } from 'fs/promises'
+import { join, dirname } from 'path'
+import { fileURLToPath } from 'url'
+import { randomUUID } from 'crypto'
+import { Attachment } from '../Models/Attachment.js'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const PROJECT_ROOT = join(__dirname, '../../')
+const STORAGE_DIR = join(PROJECT_ROOT, 'storage')
+
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024 // 2MB
+
+export class StorageService {
+  static async validateFile(file: File): Promise<{ valid: boolean; error?: string }> {
+    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
+      return { valid: false, error: 'Cover must be PNG or JPEG.' }
+    }
+
+    if (file.size > MAX_FILE_SIZE) {
+      return { valid: false, error: 'Cover must not exceed 2 MB.' }
+    }
+
+    return { valid: true }
+  }
+
+  static async save(file: File): Promise<{ id: number; filePath: string; mimeType: string }> {
+    const validation = await this.validateFile(file)
+    if (!validation.valid) {
+      throw new Error(validation.error)
+    }
+
+    const ext = file.type === 'image/png' ? 'png' : 'jpg'
+    const fileName = `${randomUUID()}.${ext}`
+    const filePath = join(STORAGE_DIR, fileName)
+
+    await mkdir(dirname(filePath), { recursive: true })
+
+    const buffer = await file.arrayBuffer()
+    await writeFile(filePath, Buffer.from(buffer))
+
+    const attachment = await Attachment.create({
+      filePath: fileName,
+      mimeType: file.type,
+    })
+
+    return {
+      id: attachment.id,
+      filePath: fileName,
+      mimeType: file.type,
+    }
+  }
+
+  static async delete(filePath: string): Promise<void> {
+    try {
+      const fullPath = join(STORAGE_DIR, filePath)
+      await unlink(fullPath)
+    } catch {
+      // File may already be deleted, ignore error
+    }
+  }
+
+  static async getFile(filePath: string): Promise<Uint8Array | null> {
+    try {
+      const fullPath = join(STORAGE_DIR, filePath)
+      return await Bun.file(fullPath).bytes()
+    } catch {
+      return null
+    }
+  }
+
+  static getUrl(filePath: string | null): string | null {
+    if (!filePath) return null
+    return `/attachments/${filePath}`
+  }
+}
