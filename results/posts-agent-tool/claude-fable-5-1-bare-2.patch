@@ -0,0 +1,55 @@
+import {
+  AuthorizationException,
+  defineMiddleware,
+  deriveAgentTools,
+  gateToolCall,
+  getRequestContainer,
+  readBearerToken,
+  verifyApiToken,
+  type Application,
+  type AuthManager,
+  type Context,
+  type DerivedAgentTool,
+} from '@guren/core'
+
+// A bearer sent straight to a route signs in as its user, past the scopes only
+// /mcp checks: a `tools:read` token would be the whole account. So a token
+// reaches a route only if the route is an agent tool its scopes grant.
+// Calls from /mcp re-enter the app through here and face the same gate.
+const toolsByApp = new WeakMap<Application, DerivedAgentTool[]>()
+
+function agentTools(app: Application): DerivedAgentTool[] {
+  let tools = toolsByApp.get(app)
+  if (!tools) {
+    // Derived on the first bearer request rather than at registration, when
+    // the routes after this middleware have yet to be declared.
+    tools = deriveAgentTools(app.router.definitions()).tools
+    toolsByApp.set(app, tools)
+  }
+  return tools
+}
+
+export const ConfineApiTokensMiddleware = defineMiddleware(async (ctx: Context, next: () => Promise<void>) => {
+  // The rule the token guard selects itself by: anything it would not read
+  // as a bearer stays an ordinary session request.
+  const bearer = readBearerToken(ctx.req.header('Authorization'))
+  if (!bearer) return next()
+
+  const container = getRequestContainer(ctx)
+  const store = container.make<AuthManager>('auth').getApiTokenStore()
+  const token = store ? await verifyApiToken(bearer, store, { updateLastUsed: false }) : null
+  // Unknown, expired or revoked: the guard finds no user, and the route
+  // answers as it answers any guest.
+  if (!token) return next()
+
+  const tool = agentTools(container.make<Application>('app'))
+    .find((candidate) => candidate.method === ctx.req.method && candidate.path === ctx.req.routePath)
+  if (!tool) {
+    throw new AuthorizationException('API tokens can only call the agent tools they are scoped for.')
+  }
+
+  const verdict = gateToolCall(tool, token.abilities, { scopeSubject: 'The token\'s scopes' })
+  if (!verdict.allowed) throw new AuthorizationException(verdict.message)
+
+  return next()
+})
