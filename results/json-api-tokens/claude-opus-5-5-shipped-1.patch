+import { DatabaseApiTokenStore, defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+// Rows are written only through `apiTokenStore` (createApiToken), never from
+// request input, so nothing is mass-assignable.
+export class ApiToken extends defineModel(apiTokens, {
+  fillable: [],
+  hidden: ['hashedToken'],
+}) {}
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens, { abilitiesMode: 'text' })
