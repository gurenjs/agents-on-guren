+import { Resource } from '@guren/core'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: number
+  name: string
+  token?: string
+}
+
+export class ApiTokenResource extends Resource<ApiTokenRecord, ApiTokenResourceData> {
+  private tokenValue?: string
+
+  constructor(resource: ApiTokenRecord, token?: string) {
+    super(resource)
+    this.tokenValue = token
+  }
+
+  toArray(): ApiTokenResourceData {
+    const result: ApiTokenResourceData = {
+      id: this.resource.id,
+      name: this.resource.name,
+    }
+
+    if (this.tokenValue) {
+      result.token = this.tokenValue
+    }
+
+    return result
+  }
+}
