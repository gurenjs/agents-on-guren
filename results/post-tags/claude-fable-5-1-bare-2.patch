-  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    tags: BelongsToManyRecord<TagRecord>
+  } = {
     author: null,
+    tags: [],
+  }
+
+  // Posts carrying the tag called `name`, matched case-sensitively. A name no
+  // post carries — or no tag has — matches nothing. The match is a subquery
+  // rather than a list of ids, so a popular tag cannot outgrow an IN list.
+  static taggedWith(name: string): QueryBuilder<PostRecord> {
+    const tagged = new SqlBuilder()
+      .select({ postId: postTags.postId })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(eq(tags.name, name))
