@@ -0,0 +1,12 @@
+import type { Router } from '@guren/core'
+import AdminPostController from '../app/Http/Controllers/AdminPostController.js'
+
+// Admin endpoints. Every route here requires a signed-in user, via the 'auth'
+// alias routes/web.ts registers on this router.
+export function registerAdminRoutes(router: Router<'auth'>): void {
+  router.middleware('auth').group((authed) => {
+    authed.group('/admin', (admin) => {
+      admin.get('/posts', [AdminPostController, 'index']).name('admin.posts.index')
+    })
+  })
+}
