new file mode 100644
index 0000000..1083cfd
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,58 @@
+import { Controller, ValidationException, abort, urlSafeToken } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+const CONFIRMATION_TOKEN_LENGTH = 32
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable: it is
+    // generated here, and a request must never be able to choose it.
+    await NewsletterSubscription.forceCreate({ email, token: urlSafeToken(CONFIRMATION_TOKEN_LENGTH) })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validated('newsletter.confirm').params
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      abort(404, 'Unknown confirmation token.')
+    }
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  // The page the visitor submitted from, or the home page. Only the path and
+  // query of the Referer are kept, so the redirect always stays on this site.
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+
+    try {
+      const url = new URL(referer, this.request.url)
+      return `${url.pathname}${url.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
