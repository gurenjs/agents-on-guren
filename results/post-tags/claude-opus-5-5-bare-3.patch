diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..e260a34
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,104 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, type TestResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+interface PostProps {
+  id: number
+  title: string
+  tags: string[]
+}
+
+async function inertiaProps<T>(response: PromiseLike<TestResponse>): Promise<T> {
+  const payload = await (await response).json<{ props: T }>()
+  return payload.props
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: TestApp
+  const suffix = `${Date.now()}`
+
+  const payload = (tags?: string) => ({
+    title: `Tagged ${suffix}`,
+    excerpt: 'An excerpt.',
+    body: 'A body.',
+    ...(tags === undefined ? {} : { tags }),
+  })
+
+  async function tagsOf(postId: number): Promise<string[]> {
+    return (await Tag.namesForPosts([postId])).get(postId) ?? []
+  }
+
+  async function createPost(tags?: string): Promise<number> {
+    const response = await author.post('/posts', payload(tags))
+    const location = response.headers.get('location') ?? ''
+    const id = Number(/\/posts\/(\d+)/.exec(location)?.[1])
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = (await TestApp.fromApp(app)).withHeaders({ 'X-Inertia': 'true' })
+    const user = await User.create({ name: 'Tagger', email: `tagger-${suffix}@example.com`, password: 'secret-password' })
+    author = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  it('creates, edits and filters posts by tag', async () => {
+    const bun = `bun-${suffix}`
+    const web = `webdev-${suffix}`
+    const id = await createPost(`${web}, ${bun}`)
+    expect(await tagsOf(id)).toEqual([bun, web])
+
+    const show = await inertiaProps<{ post: PostProps }>(http.get(`/posts/${id}`))
+    expect(show.post.tags).toEqual([bun, web])
+
+    await author.put(`/posts/${id}`, payload(bun))
+    expect(await tagsOf(id)).toEqual([bun])
+
+    const untagged = await createPost()
+    const filtered = await inertiaProps<{
+      data: PostProps[]
+      pagination: { links: { pages: { url: string | null }[] } }
+    }>(http.get(`/posts?tag=${encodeURIComponent(bun)}`))
+    expect(filtered.data.map((post) => post.id)).toEqual([id])
+    expect(filtered.pagination.links.pages[0]?.url).toContain(`tag=${encodeURIComponent(bun)}`)
+
+    const none = await inertiaProps<{ data: PostProps[] }>(http.get(`/posts?tag=${encodeURIComponent(web)}`))
+    expect(none.data).toEqual([])
+
+    const all = await inertiaProps<{ data: PostProps[] }>(http.get('/posts'))
+    expect(all.data.find((post) => post.id === untagged)?.tags).toEqual([])
+
+    await author.delete(`/posts/${id}`)
+    expect(await PostTag.where('postId', id).count()).toBe(0)
+  })
+
+  it('refuses tag input that breaks the rules, like an empty title', async () => {
+    const emptyTitle = await author.post('/posts', { ...payload(), title: '' })
+    const before = await Post.newQuery().count()
+
+    const sixTags = await author.post('/posts', payload('a,b,c,d,e,f'))
+    expect(sixTags.status).toBe(emptyTitle.status)
+
+    const tooLong = await author.post('/posts', payload('x'.repeat(31)))
+    expect(tooLong.status).toBe(emptyTitle.status)
+
+    expect(await Post.newQuery().count()).toBe(before)
+    expect(await Tag.where('name', 'x'.repeat(31)).count()).toBe(0)
+
+    const id = await createPost('y'.repeat(30))
+    expect(await tagsOf(id)).toEqual(['y'.repeat(30)])
+  })
+
+  it('trims and de-duplicates names', async () => {
+    const name = `dup-${suffix}`
+    const id = await createPost(` ${name} ,${name},,`)
+    expect(await tagsOf(id)).toEqual([name])
+    expect(await PostTag.where('postId', id).count()).toBe(1)
+  })
+})
