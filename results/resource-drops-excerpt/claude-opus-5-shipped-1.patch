+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// Regression: the resource is the single serialization path for every place a
+// post reaches the frontend (posts.index, posts.show, posts.edit, the home
+// page). A field missing here silently empties it on all of them at once,
+// while the column — and anything querying it, like posts.search — stays fine.
+describe('PostResource', () => {
+  // Inertia only serves its JSON page object when the request asks for it;
+  // without the header these routes return the HTML shell.
+  let inertia: TestApp
+  let post: Awaited<ReturnType<typeof Post.forceCreate>>
+
+  beforeAll(async () => {
+    const http = await TestApp.fromApp(app)
+    inertia = http.withHeader('X-Inertia', 'true')
+    await resetDatabase()
+
+    const author = await User.create({
+      name: 'Ada Lovelace',
+      email: 'ada@example.com',
+      password: 'password',
+    })
+
+    post = await Post.forceCreate({
+      title: 'Bees',
+      excerpt: 'Bees remember faces',
+      body: 'A longer body about bees.',
+      authorId: author!.id,
+    })
+  })
+
+  it('serializes the excerpt', async () => {
+    const data = new PostResource(await Post.findOrFail(post!.id)).toJSON()
+
+    expect(data.excerpt).toBe('Bees remember faces')
+  })
+
+  it('sends the excerpt to the post page', async () => {
+    await inertia.get(`/posts/${post!.id}`).assertOk().assertJsonPath('props.post.excerpt', 'Bees remember faces')
+  })
+
+  it('sends the excerpt to the post list', async () => {
+    await inertia.get('/posts').assertOk().assertJsonPath('props.data.0.excerpt', 'Bees remember faces')
+  })
+})
