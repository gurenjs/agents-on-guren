diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..570cd20
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,156 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The test database persists between runs, so every fixture gets a unique
+// email and the assertions only look at rows these tests created.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+async function makeUser(label: string): Promise<UserRecord> {
+  return User.create({ name: `${label} ${run}`, email: `${label}-${run}@example.com`, password: 'secret' })
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({
+    title: `Post ${run}`,
+    excerpt: 'An excerpt',
+    body: 'A body',
+    authorId: author.id,
+  })
+}
+
+async function as(user: UserRecord): Promise<TestApp> {
+  return http.actingAs(user).withCsrf('/posts')
+}
+
+async function pageComments(postId: number, viewer?: UserRecord) {
+  const client = viewer ? http.actingAs(viewer) : http
+  const response = await client.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props.comments as Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }>
+}
+
+let http: TestApp
+let postAuthor: UserRecord
+let commenter: UserRecord
+let bystander: UserRecord
+
+describe('comments', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    postAuthor = await makeUser('author')
+    commenter = await makeUser('commenter')
+    bystander = await makeUser('bystander')
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const post = await makePost(postAuthor)
+
+    await (await http.withCsrf('/posts')).post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect('/login')
+
+    expect(await Comment.newQuery().where('postId', post.id).count()).toBe(0)
+  })
+
+  it('stores a signed-in user’s comment and lists it with its author, oldest first', async () => {
+    const post = await makePost(postAuthor)
+    const client = await as(commenter)
+
+    await client.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await (await as(postAuthor)).post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await pageComments(post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['first', 'second'])
+    expect(comments[0]?.author).toEqual({ id: commenter.id, name: commenter.name })
+    expect(comments[1]?.author).toEqual({ id: postAuthor.id, name: postAuthor.name })
+    expect(new Date(comments[0]?.createdAt ?? '').toISOString()).toBe(comments[0]?.createdAt)
+
+    const stored = await Comment.newQuery().where('postId', post.id).orderBy('id', 'asc').get()
+    expect(stored.map((comment) => comment.userId)).toEqual([commenter.id, postAuthor.id])
+  })
+
+  it('rejects an empty or too long body the way an invalid post does', async () => {
+    const post = await makePost(postAuthor)
+    const client = (await as(commenter)).json()
+
+    await client.post(`/posts/${post.id}/comments`, { body: '   ' }).assertStatus(422)
+    await client.post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertStatus(422)
+
+    expect(await Comment.newQuery().where('postId', post.id).count()).toBe(0)
+  })
+
+  it('lets the comment’s author delete it', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'mine' })
+
+    await (await as(commenter)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    expect(await Comment.find(comment.id)).toBeNull()
+  })
+
+  it('lets the post’s author delete it', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'moderated' })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: bystander.id })
+
+    await (await as(postAuthor)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    expect(await Comment.find(comment.id)).toBeNull()
+    expect(await CommentReport.newQuery().where('commentId', comment.id).count()).toBe(0)
+  })
+
+  it('answers 403 to anyone else and keeps the comment', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'stays' })
+
+    await (await as(bystander)).delete(`/comments/${comment.id}`).assertStatus(403)
+
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('hides a comment after three different reporters but keeps the row', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'spam' })
+    const reporters = [await makeUser('r1'), await makeUser('r2'), await makeUser('r3')]
+
+    // The same user reporting twice counts once.
+    const first = await as(reporters[0]!)
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await (await as(reporters[1]!)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.newQuery().where('commentId', comment.id).count()).toBe(2)
+    expect((await pageComments(post.id)).map((item) => item.id)).toEqual([comment.id])
+
+    await (await as(reporters[2]!)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.newQuery().where('commentId', comment.id).count()).toBe(3)
+
+    expect(await pageComments(post.id)).toEqual([])
+    expect(await pageComments(post.id, commenter)).toEqual([])
+    expect(await pageComments(post.id, postAuthor)).toEqual([])
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('sends a guest report to the login page', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'x' })
+
+    await (await http.withCsrf('/posts')).post(`/comments/${comment.id}/report`).assertRedirect('/login')
+
+    expect(await CommentReport.newQuery().where('commentId', comment.id).count()).toBe(0)
+  })
+
+  it('removes a post’s comments and their reports with the post', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'gone' })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: bystander.id })
+
+    await (await as(postAuthor)).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await Comment.newQuery().where('postId', post.id).count()).toBe(0)
+    expect(await CommentReport.newQuery().where('commentId', comment.id).count()).toBe(0)
+  })
+})
