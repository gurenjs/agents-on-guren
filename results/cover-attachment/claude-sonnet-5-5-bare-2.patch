new file mode 100644
index 0000000..78d1b8d
--- /dev/null
+++ b/app/Http/Controllers/AttachmentController.ts
@@ -0,0 +1,23 @@
+import { Controller } from '@guren/core'
+import { Attachment } from '../../Models/Attachment.js'
+import { readCoverFile } from '../../Services/CoverStorage.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+
+export default class AttachmentController extends Controller {
+  // Serves a stored cover exactly as uploaded. The id changes whenever a cover
+  // is replaced, so an old URL stops working with its row.
+  async show(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const attachment = await Attachment.first({ id })
+    const file = attachment ? await readCoverFile(attachment) : null
+    if (!attachment || !file) return new Response('Not found', { status: 404 })
+
+    return new Response(file, {
+      headers: {
+        'Content-Type': attachment.mimeType,
+        'Content-Length': String(attachment.size),
+        'X-Content-Type-Options': 'nosniff',
+      },
+    })
+  }
+}
