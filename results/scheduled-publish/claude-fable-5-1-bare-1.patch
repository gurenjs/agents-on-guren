+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List the posts scheduled to publish later, soonest first'
+
+  // Output is a contract: `<id>\t<title>\t<published_at>` per post and nothing
+  // else on stdout, so it can be piped. Anything for a human belongs on stderr.
+  async handle(): Promise<void> {
+    const posts = await Post.scope('scheduled').orderBy('publishedAt', 'asc').orderBy('id', 'asc').get()
+
+    for (const post of posts) {
+      // A tab or line break inside a title would read as a field or row break.
+      const title = post.title.replace(/[\t\r\n]+/g, ' ')
+      this.line(`${post.id}\t${title}\t${post.publishedAt}`)
+    }
+  }
+}
