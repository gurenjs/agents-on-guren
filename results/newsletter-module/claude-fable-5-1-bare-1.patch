+++ b/modules/newsletter/app/Http/Validators/NewsletterValidator.ts
@@ -0,0 +1,21 @@
+import { z } from 'zod'
+
+// Lowercased so the same address cannot subscribe twice under two spellings,
+// and so unsubscribing finds the row whichever way it is typed.
+const email = z
+  .string()
+  .trim()
+  .min(1, 'Email is required.')
+  .toLowerCase()
+  .pipe(z.email('The email address is badly formatted.'))
+
+export const SubscribeSchema = z.object({ email })
+
+export const UnsubscribeSchema = z.object({ email })
+
+export const ConfirmTokenParamSchema = z.object({
+  token: z.string().min(1),
+})
+
+export type SubscribeInput = z.infer<typeof SubscribeSchema>
+export type UnsubscribeInput = z.infer<typeof UnsubscribeSchema>
