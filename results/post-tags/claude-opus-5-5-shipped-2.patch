diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..48ee4ad
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,116 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface PostProps {
+  id: number
+  tags: string[]
+}
+
+const payload = (tags?: string) => ({ title: 'Hello', excerpt: 'Short', body: 'Long body', tags })
+
+async function inertiaProps<T>(http: TestApp, path: string): Promise<T> {
+  const res = await http.withHeaders({ 'X-Inertia': 'true', Accept: 'text/html, application/xhtml+xml' }).get(path)
+  res.assertOk()
+  const page = await res.json<{ props: T }>()
+  return page.props
+}
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const pivots = await PostTag.where({ postId }).get()
+  const tags = await Tag.where({ id: pivots.map((pivot) => pivot.tagId) }).get()
+  return tags.map((tag) => tag.name).sort()
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function createPost(tags?: string): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', payload(tags)).assertRedirect()
+    const [post] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+    return post!.id
+  }
+
+  it('creates tags, attaches them, and shows them sorted', async () => {
+    const id = await createPost('webdev, bun')
+    expect(await tagNamesOf(id)).toEqual(['bun', 'webdev'])
+    const props = await inertiaProps<{ post: PostProps }>(http, `/posts/${id}`)
+    expect(props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('detaches removed tags on update', async () => {
+    const id = await createPost('bun, webdev')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${id}`, payload('bun')).assertRedirect(`/posts/${id}`)
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    const props = await inertiaProps<{ post: PostProps }>(http, `/posts/${id}`)
+    expect(props.post.tags).toEqual(['bun'])
+  })
+
+  it('filters the list by tag', async () => {
+    const tagged = await createPost('bun')
+    const untagged = await createPost()
+
+    const all = await inertiaProps<{ data: PostProps[] }>(http, '/posts')
+    expect(all.data.map((post) => [post.id, post.tags])).toEqual([[untagged, []], [tagged, ['bun']]])
+
+    const filtered = await inertiaProps<{
+      data: PostProps[]
+      pagination: { links: { pages: { url: string | null }[] } }
+    }>(http, '/posts?tag=bun')
+    expect(filtered.data.map((post) => post.id)).toEqual([tagged])
+    expect(filtered.pagination.links.pages[0]?.url).toContain('tag=bun')
+
+    const none = await inertiaProps<{ data: PostProps[] }>(http, '/posts?tag=nobody')
+    expect(none.data).toEqual([])
+  })
+
+  it('refuses more than five tags and writes nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const emptyTitle = await csrf.json().post('/posts', { ...payload(), title: '' })
+    const res = await csrf.json().post('/posts', payload('a, b, c, d, e, f'))
+    expect(res.status).toBe(emptyTitle.status)
+    res.assertJsonPath('errors.tags.0', 'A post may have at most 5 tags.')
+    expect(await Post.all()).toEqual([])
+    expect(await Tag.all()).toEqual([])
+    expect(await PostTag.all()).toEqual([])
+  })
+
+  it('enforces the 30-character limit', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', payload('x'.repeat(31))).assertUnprocessable()
+    expect(await Post.all()).toEqual([])
+    const id = await createPost('x'.repeat(30))
+    expect(await tagNamesOf(id)).toEqual(['x'.repeat(30)])
+  })
+
+  it('trims and de-duplicates names', async () => {
+    const id = await createPost(' bun ,bun,,')
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.all()).toEqual([])
+  })
+})
