+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { kernel } from '../src/console.js'
+
+interface PostProps {
+  id: number
+  publishedAt: string | null
+}
+
+function makeUser(name: string): Promise<UserRecord> {
+  const email = `${name}-${crypto.randomUUID()}@example.com`
+  return User.create({ name, email, password: 'secret-password' }) as Promise<UserRecord>
+}
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2000-01-01T00:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: { id: number }
+  const tag = `sched${Date.now()}`
+
+  async function props(client: TestApp, path: string) {
+    const response = await client.withHeaders({ 'X-Inertia': 'true' }).get(path)
+    return { status: response.status, props: (await response.json<{ props: Record<string, unknown> }>()).props }
+  }
+
+  async function listed(client: TestApp) {
+    const { props: page } = await props(client, '/posts')
+    return (page.data as PostProps[]).find((post) => post.id === scheduled.id)
+  }
+
+  async function searched(client: TestApp) {
+    const response = await client.query('/posts/search', { keywords: [tag], limit: 50 })
+    return (await response.json<{ data: PostProps[] }>()).data.find((post) => post.id === scheduled.id)
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('author')
+    other = await makeUser('other')
+    scheduled = (await Post.forceCreate({
+      title: `Launch ${tag}`,
+      excerpt: 'Soon',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as { id: number }
+  })
+
+  afterAll(async () => {
+    await Post.delete({ id: scheduled.id })
+  })
+
+  it('hides a scheduled post from guests and other users', async () => {
+    for (const client of [http, http.actingAs(other)]) {
+      await client.get(`/posts/${scheduled.id}`).assertNotFound()
+      expect(await listed(client)).toBeUndefined()
+      expect(await searched(client)).toBeUndefined()
+    }
+  })
+
+  it('shows a scheduled post to its author with its publish date', async () => {
+    const client = http.actingAs(author)
+    const show = await props(client, `/posts/${scheduled.id}`)
+    expect(show.status).toBe(200)
+    expect(new Date((show.props.post as PostProps).publishedAt!).toISOString()).toBe(FUTURE)
+    expect((await listed(client))?.publishedAt).toBe(FUTURE)
+  })
+
+  it('lists scheduled posts from the console, soonest first', async () => {
+    const writes: string[] = []
+    const original = process.stdout.write.bind(process.stdout)
+    process.stdout.write = ((chunk: string) => {
+      writes.push(String(chunk))
+      return true
+    }) as typeof process.stdout.write
+    try {
+      expect(await kernel.handle(['posts:scheduled'])).toBe(0)
+    } finally {
+      process.stdout.write = original
+    }
+    expect(writes.join('')).toContain(`${scheduled.id}\tLaunch ${tag}\t${FUTURE}\n`)
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    await Post.update({ id: scheduled.id }, { publishedAt: PAST })
+    for (const client of [http, http.actingAs(other)]) {
+      await client.get(`/posts/${scheduled.id}`).assertOk()
+      expect(await listed(client)).toBeDefined()
+      expect(await searched(client)).toBeDefined()
+    }
+  })
+})
+
+describe('publishAt validation', () => {
+  it('rejects a value that is not a date and time', async () => {
+    const http = await TestApp.fromApp(app)
+    const user = await makeUser('validator')
+    const before = await Post.where('authorId', user.id).count()
+    const client = await http.actingAs(user).json().withCsrf('/posts')
+    const response = await client.post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+    expect(response.status).toBe(422)
+    expect(await Post.where('authorId', user.id).count()).toBe(before)
+  })
+})
