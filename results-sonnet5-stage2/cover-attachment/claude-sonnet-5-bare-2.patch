@@ -0,0 +1,22 @@
+import { Controller } from '@guren/core'
+import { readCover } from '../../Services/CoverStorage.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+
+export default class AttachmentController extends Controller {
+  async show(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const cover = await readCover(id)
+    if (!cover) {
+      return new Response('Not found', { status: 404 })
+    }
+
+    return new Response(cover.file, {
+      headers: {
+        'Content-Type': cover.contentType,
+        'Content-Length': String(cover.file.size),
+        'X-Content-Type-Options': 'nosniff',
+        'Cache-Control': 'private, no-cache',
+      },
+    })
+  }
+}
