@@ -13,6 +16,30 @@ export class Post extends defineModel(posts) {
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /**
+   * Derives a teaser from the body when no excerpt was supplied: the first
+   * 140 characters, never cutting a word in half, with a trailing ellipsis
+   * when the body was truncated.
+   */
+  static deriveExcerpt(body: string): string {
+    const trimmedBody = body.trim()
+    if (trimmedBody.length <= EXCERPT_MAX_LENGTH) {
+      return trimmedBody
+    }
+
+    let cut = EXCERPT_MAX_LENGTH
+    const boundaryChar = trimmedBody[EXCERPT_MAX_LENGTH - 1]
+    const nextChar = trimmedBody[EXCERPT_MAX_LENGTH]
+    if (boundaryChar && nextChar && !/\s/.test(boundaryChar) && !/\s/.test(nextChar)) {
+      const lastWhitespace = trimmedBody.slice(0, EXCERPT_MAX_LENGTH).search(/\s\S*$/)
+      if (lastWhitespace !== -1) {
+        cut = lastWhitespace
+      }
+    }
+
+    return trimmedBody.slice(0, cut).trimEnd() + EXCERPT_ELLIPSIS
+  }
 }
 
