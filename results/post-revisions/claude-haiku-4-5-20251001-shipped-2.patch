diff --git a/app/Http/Controllers/RevisionsController.ts b/app/Http/Controllers/RevisionsController.ts
new file mode 100644
index 0000000..8dba10d
--- /dev/null
+++ b/app/Http/Controllers/RevisionsController.ts
@@ -0,0 +1,78 @@
+import { Controller, NotFoundHttpException, AuthorizationException } from '@guren/core'
+import { pages } from '@/.guren/pages.gen'
+import { Post } from '../../Models/Post.js'
+import { PostRevision, type PostRevisionRecord } from '../../Models/PostRevision.js'
+import type { UserRecord } from '../../Models/User.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+import { z } from 'zod'
+
+type PostRevisionSummary = Pick<PostRevisionRecord, 'id' | 'title' | 'createdAt'>
+
+interface RevisionsPageProps {
+  revisions: PostRevisionSummary[]
+}
+
+export default class RevisionsController extends Controller {
+  async index(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    const user = await this.auth.user<UserRecord>()
+
+    if (!user || Number(user.id) !== post.authorId) {
+      throw new AuthorizationException()
+    }
+
+    const revisions = await PostRevision.where({ postId: post.id })
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      revisions: revisions.map((r) => ({
+        id: r.id,
+        title: r.title,
+        createdAt: r.createdAt,
+      })),
+    } satisfies RevisionsPageProps)
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(
+      z.object({
+        id: z.coerce.number().int().positive(),
+        revisionId: z.coerce.number().int().positive(),
+      })
+    )
+
+    const post = await Post.findOrFail(id)
+    const user = await this.auth.user<UserRecord>()
+
+    if (!user || Number(user.id) !== post.authorId) {
+      throw new AuthorizationException()
+    }
+
+    const revision = await PostRevision.first({ id: revisionId })
+    if (!revision || revision.postId !== post.id) {
+      throw new NotFoundHttpException()
+    }
+
+    // Save the current version before restoring
+    await PostRevision.create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+
+    // Restore the revision content
+    await Post.update(
+      { id: post.id },
+      {
+        title: revision.title,
+        excerpt: revision.excerpt,
+        body: revision.body,
+      }
+    )
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
