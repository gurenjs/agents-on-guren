diff --git a/tests/ApiTokenController.test.ts b/tests/ApiTokenController.test.ts
new file mode 100644
index 0000000..b491569
--- /dev/null
+++ b/tests/ApiTokenController.test.ts
@@ -0,0 +1,157 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let http: TestApp
+let counter = 0
+
+async function makeUser(): Promise<UserRecord> {
+  counter += 1
+  return User.create({ name: `User ${counter}`, email: `user${counter}@example.com`, password: 'secret-password' })
+}
+
+async function issueToken(user: UserRecord, name = 'CI'): Promise<{ id: string; name: string; token: string }> {
+  const csrf = await http.actingAs(user).withCsrf()
+  const res = await csrf.json().post('/profile/tokens', { name })
+  res.assertCreated()
+  return res.json()
+}
+
+function bearer(token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
+
+describe('personal API tokens', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('creates a token and stores only a hash of it', async () => {
+    const user = await makeUser()
+    const created = await issueToken(user, 'old laptop')
+
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.all()
+    expect(rows).toHaveLength(1)
+    for (const value of Object.values(rows[0] as Record<string, unknown>)) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name', async () => {
+    const csrf = await http.actingAs(await makeUser()).withCsrf()
+
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('gives a guest no token', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name: 'CI' })
+
+    expect([302, 401]).toContain(res.status)
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('lists every post newest first', async () => {
+    const author = await makeUser()
+    await Post.forceCreate({ title: 'First', excerpt: 'e', body: 'b', authorId: author.id })
+    await Post.forceCreate({ title: 'Second', excerpt: 'e', body: 'b', authorId: author.id })
+    const { token } = await issueToken(await makeUser())
+
+    await bearer(token)
+      .get('/api/posts')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Second')
+      .assertJsonPath('data.0.authorId', author.id)
+  })
+
+  it('creates a post owned by the token owner', async () => {
+    const owner = await makeUser()
+    const other = await makeUser()
+    const { token } = await issueToken(owner)
+
+    const res = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What shipped',
+      body: 'Details',
+      authorId: other.id,
+    })
+
+    res.assertCreated()
+    const payload = await res.json<{ data: { authorId: number; createdAt: string } }>()
+    expect(payload.data.authorId).toBe(owner.id)
+    expect(new Date(payload.data.createdAt).toISOString()).toBe(payload.data.createdAt)
+  })
+
+  it('rejects input the web form would reject', async () => {
+    const { token } = await issueToken(await makeUser())
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'e', body: 'b' }).assertUnprocessable()
+    await bearer(token).post('/api/posts', { title: 'T', excerpt: 'e' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('answers 401 for missing, malformed, unknown or tampered tokens', async () => {
+    const { token } = await issueToken(await makeUser())
+    const [id, secret] = token.split('|')
+    const tampered = `${id}|${secret?.slice(0, -1)}${secret?.endsWith('0') ? '1' : '0'}`
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    for (const bad of ['garbage', `${id}|`, 'deadbeef|deadbeef', tampered]) {
+      await bearer(bad).get('/api/posts').assertUnauthorized()
+      await bearer(bad).post('/api/posts', { title: 'T', excerpt: 'e', body: 'b' }).assertUnauthorized()
+    }
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('revokes one token without touching the others', async () => {
+    const user = await makeUser()
+    const first = await issueToken(user, 'CI')
+    const second = await issueToken(user, 'laptop')
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it("answers 404 for another user's token and leaves it working", async () => {
+    const victim = await issueToken(await makeUser())
+    const csrf = await http.actingAs(await makeUser()).withCsrf()
+
+    await csrf.json().delete(`/profile/tokens/${victim.id}`).assertNotFound()
+    await bearer(victim.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const user = await makeUser()
+    const limited = await issueToken(user, 'cron')
+    const spare = await issueToken(user, 'ci')
+
+    for (let i = 0; i < 60; i += 1) {
+      await bearer(limited.token).get('/api/posts').assertOk()
+    }
+    const res = await bearer(limited.token).get('/api/posts')
+    res.assertStatus(429)
+    const retryAfter = Number(res.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(spare.token).get('/api/posts').assertOk()
+  })
+})
