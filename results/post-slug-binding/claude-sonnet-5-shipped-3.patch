diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..edf9962
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,80 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post, slugify } from '../app/Models/Post.js'
+
+describe('post slugs', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada Lovelace', email: 'ada@example.com', password: 'secret123' })
+  })
+
+  it('slugifies a title into lowercase, hyphenated ASCII', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world')
+    expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+  })
+
+  it('assigns increasing suffixes to titles that collide', async () => {
+    const first = await Post.uniqueSlug('Hello, World!')
+    await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: author.id, slug: first })
+
+    const second = await Post.uniqueSlug('Hello, World!')
+    expect(second).toBe('hello-world-2')
+    await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: author.id, slug: second })
+
+    const third = await Post.uniqueSlug('Hello, World!')
+    expect(third).toBe('hello-world-3')
+  })
+
+  it('creating a post redirects to its slug URL and keeps the slug on later title edits', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' })
+    response.assertRedirect('/posts/hello-world')
+
+    const post = await Post.first({ slug: 'hello-world' })
+    expect(post).not.toBeNull()
+
+    const updateCsrf = await http.actingAs(author).withCsrf()
+    await updateCsrf
+      .put(`/posts/${post!.id}`, { title: 'A Brand New Title', excerpt: 'e', body: 'b' })
+      .assertRedirect('/posts/hello-world')
+
+    const unchanged = await Post.findOrFail(post!.id)
+    expect(unchanged.slug).toBe('hello-world')
+    expect(unchanged.title).toBe('A Brand New Title')
+  })
+
+  it('serves the post page at its slug URL', async () => {
+    const slug = await Post.uniqueSlug('Serving posts by slug')
+    await Post.forceCreate({ title: 'Serving posts by slug', excerpt: 'e', body: 'b', authorId: author.id, slug })
+
+    const response = await http.withHeader('X-Inertia', 'true').get(`/posts/${slug}`)
+    response.assertOk()
+    const payload = await response.json<{ props: { post: { slug: string } } }>()
+    expect(payload.props.post.slug).toBe(slug)
+  })
+
+  it('404s for an unknown slug', async () => {
+    await http.get('/posts/does-not-exist').assertNotFound()
+  })
+
+  it('redirects the old numeric id URL to the slug URL', async () => {
+    const slug = await Post.uniqueSlug('Legacy numeric address')
+    const post = await Post.forceCreate({ title: 'Legacy numeric address', excerpt: 'e', body: 'b', authorId: author.id, slug })
+
+    await http.get(`/posts/${post.id}`).assertStatus(301).assertRedirect(`/posts/${slug}`)
+  })
+
+  it('404s for an unknown numeric id', async () => {
+    await http.get('/posts/999999').assertNotFound()
+  })
+})
