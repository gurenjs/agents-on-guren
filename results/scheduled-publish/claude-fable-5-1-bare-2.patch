+++ b/app/Console/Commands/PostsScheduledCommand.ts
@@ -0,0 +1,23 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * `bun run console posts:scheduled` — the launch calendar from a terminal.
+ * One `<id>\t<title>\t<published_at>` line per scheduled post, soonest first,
+ * and nothing else on stdout so it can be piped into other tools. Public
+ * posts (no date, or a past one) are left out; with nothing scheduled it
+ * prints nothing and still exits 0.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later, soonest first, as tab-separated id, title and published_at.'
+
+  async handle(): Promise<void> {
+    const scheduled = await Post.scheduled().get()
+
+    for (const post of scheduled) {
+      // `line()` is the undecorated writer; info()/success() prefix and color.
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
