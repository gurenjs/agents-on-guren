+
+// The archive route captures /posts/archive/<year> and /posts/archive/<year>/<month>
+// into one `date` param that may contain a slash — Hono's `:date{.+}` syntax,
+// not the `:date*` this repo shipped with (which registers a single-segment
+// param literally named "date*" and 404s on the two-segment form). Posts are
+// created in 2010, a year no seeder or other test touches, to keep counts
+// deterministic without needing to isolate the whole database.
+describe('posts.archive', () => {
+  let http: TestApp
+  const postIds: number[] = []
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const author = await User.first({ email: 'demo@example.com' })
+    if (!author) {
+      throw new Error('Expected the demo user seeder to have run before this test.')
+    }
+
+    for (const [title, createdAt] of [
+      ['Archive test: May 1', '2010-05-03T10:00:00.000Z'],
+      ['Archive test: May 2', '2010-05-20T10:00:00.000Z'],
+      ['Archive test: June 1', '2010-06-01T10:00:00.000Z'],
+    ] as const) {
+      const post = await Post.forceCreate({
+        title,
+        excerpt: 'Fixture post for posts.archive tests.',
+        body: 'Fixture post for posts.archive tests.',
+        authorId: author.id,
+        createdAt,
+      })
+      postIds.push(post.id)
+    }
+  })
+
+  afterAll(async () => {
+    for (const id of postIds) {
+      await Post.delete({ id })
+    }
+  })
+
+  it('lists posts created in a given month, zero-padded', async () => {
+    await http
+      .get('/posts/archive/2010/05')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Archive test: May 2')
+      .assertJsonPath('data.1.title', 'Archive test: May 1')
+  })
+
+  it('lists posts created in a given month, without the leading zero', async () => {
+    await http.get('/posts/archive/2010/5').assertOk().assertJsonCount(2, 'data')
+  })
+
+  it('lists every post created in a given year', async () => {
+    await http
+      .get('/posts/archive/2010')
+      .assertOk()
+      .assertJsonCount(3, 'data')
+      .assertJsonPath('data.0.title', 'Archive test: June 1')
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/2011').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2010/13').assertStatus(422)
+  })
+})
