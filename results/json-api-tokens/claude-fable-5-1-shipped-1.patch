+  name: z.string().trim().min(1, 'Name is required.').max(50, 'Name must be 50 characters or fewer.'),
+})
+
+// Token ids are the 32 hex characters createApiToken() generates.
+export const ApiTokenIdParamSchema = z.object({
+  id: z.string().regex(/^[0-9a-f]{32}$/, 'Invalid token id.'),
+})
diff --git a/app/Models/ApiToken.ts b/app/Models/ApiToken.ts
new file mode 100644
index 0000000..038b335
--- /dev/null
+++ b/app/Models/ApiToken.ts
@@ -0,0 +1,19 @@
+import { defineModel, type BelongsToRequiredRecord } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import type { UserRecord } from './User.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+/**
+ * Read side of the `api_tokens` table: the profile page lists a user's tokens
+ * and revocation looks one up by owner. Rows are written only through
+ * `createApiToken()` in app/Auth/apiTokenStore.ts, which hashes the secret.
+ */
+export class ApiToken extends defineModel(apiTokens, {
+  fillable: ['name'],
+  hidden: ['hashedToken'],
+}) {
+  declare static relationTypes: { user: BelongsToRequiredRecord<UserRecord> }
+}
+
+ApiToken.belongsTo('user', () => import('./User.js').then((module) => module.User), 'userId', 'id')
