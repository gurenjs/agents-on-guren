index 0000000..85a71c1
--- /dev/null
+++ b/app/Http/Controllers/ProfileTokenController.ts
@@ -0,0 +1,28 @@
+import { Controller, createApiToken, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { TokenPayloadSchema } from '../Validators/TokenValidator.js'
+
+export default class ProfileTokenController extends Controller {
+  // The plain token appears in this response only; the store keeps a hash.
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(TokenPayloadSchema)
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const id = this.ctx.req.param('id')
+    const owned = (await apiTokenStore.findByUserId(user.id)).find((token) => token.id === id)
+    if (!owned) {
+      return this.json({ message: 'Token not found.' }, { status: 404 })
+    }
+
+    await revokeApiToken(owned.id, apiTokenStore)
+
+    return this.noContent()
+  }
+}
diff --git a/app/Http/Middleware/ApiAuth.ts b/app/Http/Middleware/ApiAuth.ts
new file mode 100644
index 0000000..b231b0b
--- /dev/null
+++ b/app/Http/Middleware/ApiAuth.ts
@@ -0,0 +1,26 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken, MemoryRateLimitStore } from '@guren/core'
+import type { MiddlewareHandler } from 'hono'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+
+export const API_RATE_LIMIT = 60
+const WINDOW_MS = 60_000
+
+// 401 for a missing, malformed, unknown or revoked token, always as JSON.
+export const authenticateApiToken: MiddlewareHandler = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Counted per token (not per user or IP), so this must run after
+// authenticateApiToken. Each token gets its own window.
+export const rateLimitApiToken: MiddlewareHandler = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: WINDOW_MS,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  onRateLimited: (ctx, retryAfter) => {
+    const seconds = String(Math.min(Math.max(Math.ceil(retryAfter), 1), 60))
+    return ctx.json({ message: 'Too many requests.' }, 429, { 'Retry-After': seconds })
+  },
+})
