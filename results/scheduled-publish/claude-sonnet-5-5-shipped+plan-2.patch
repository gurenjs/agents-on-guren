diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..80bdcc0
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,48 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@x.test', password: 'password123' })
+    other = await User.create({ name: 'B', email: 'b@x.test', password: 'password123' })
+  })
+
+  const future = () => new Date(Date.now() + 86_400_000).toISOString()
+
+  it('hides a scheduled post from guests and other users, shows it to its author', async () => {
+    const post = await Post.forceCreate({ title: 'Later', excerpt: 'e', body: 'b', authorId: Number(author!.id), publishedAt: future() })
+    await http.get(`/posts/${post!.id}`).assertNotFound()
+    await http.actingAs(other!).get(`/posts/${post!.id}`).assertNotFound()
+    await http.actingAs(author!).get(`/posts/${post!.id}`).assertOk()
+  })
+
+  it('shows a post once its time has passed', async () => {
+    const post = await Post.forceCreate({
+      title: 'Now',
+      excerpt: 'e',
+      body: 'b',
+      authorId: Number(author!.id),
+      publishedAt: new Date(Date.now() - 3_600_000).toISOString(),
+    })
+    await http.get(`/posts/${post!.id}`).assertOk()
+  })
+
