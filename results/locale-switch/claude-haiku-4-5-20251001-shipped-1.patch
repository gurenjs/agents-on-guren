new file mode 100644
index 0000000..55bf15d
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,14 @@
+import { Controller } from '@guren/core'
+import { LocaleSchema } from '../Validators/LocaleValidator.js'
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = await this.validateBody(LocaleSchema)
+
+    return this.redirect(this.request.header('referer') ?? '/', {
+      headers: {
+        'Set-Cookie': `locale=${locale}; Path=/; Max-Age=31536000; SameSite=Lax`,
+      },
+    })
+  }
+}
