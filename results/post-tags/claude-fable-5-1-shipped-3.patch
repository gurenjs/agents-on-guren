+  .refine((value) => parseTagNames(value).every((name) => Array.from(name).length <= MAX_TAG_LENGTH), {
+    message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.`,
+  })
+  .refine((value) => parseTagNames(value).length <= MAX_TAGS_PER_POST, {
+    message: `A post may have at most ${MAX_TAGS_PER_POST} tags.`,
+  })
