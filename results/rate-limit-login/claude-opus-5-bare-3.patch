diff --git a/tests/LoginThrottle.test.ts b/tests/LoginThrottle.test.ts
new file mode 100644
index 0000000..95a11f5
--- /dev/null
+++ b/tests/LoginThrottle.test.ts
@@ -0,0 +1,37 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The login form is throttled to five submissions a minute per client
+// (app/Http/Middleware/ThrottleLoginMiddleware.ts). TestApp calls app.fetch()
+// without a socket behind it, so no client address can be resolved and every
+// request lands in the one shared bucket the limiter falls back to — which is
+// what a single throttled client looks like here. All the attempts a run makes
+// against POST /login therefore share one counter, so this file spends the
+// window in a single test.
+describe('login throttling', () => {
+  let http: TestApp
+
+  const submit = () =>
+    http.post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  it('refuses submissions past five a minute with 429 and Retry-After', async () => {
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      const response = await submit()
+      expect(response.status).not.toBe(429)
+    }
+
+    const throttled = await submit()
+    expect(throttled.status).toBe(429)
+    expect(throttled.headers.get('Retry-After')).toBeTruthy()
+
+    // Only the submission is throttled — the form itself still renders, and so
+    // does every other page.
+    await http.get('/login').assertOk()
+    await http.get('/health').assertOk()
+  })
+})
