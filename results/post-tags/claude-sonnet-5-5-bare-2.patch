diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..2d73169
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,79 @@
+import { and, eq, inArray, notInArray } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+const database = async () => (await getDatabase()) as SQLiteBunDatabase
+
+/** Tag names per post id, sorted alphabetically. Posts without tags are absent. */
+export async function tagNamesForPosts(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) {
+    return byPost
+  }
+
+  const db = await database()
+  const rows = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const row of rows) {
+    const names = byPost.get(row.postId) ?? []
+    names.push(row.name)
+    byPost.set(row.postId, names)
+  }
+  for (const names of byPost.values()) {
+    names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  }
+
+  return byPost
+}
+
+/** Copies of `posts` carrying their `tags: string[]`, for PostResource. */
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<T[]> {
+  const byPost = await tagNamesForPosts(posts.map((post) => post.id))
+  return posts.map((post) => Object.assign(Object.create(Object.getPrototypeOf(post)), post, {
+    tags: byPost.get(post.id) ?? [],
+  }))
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const db = await database()
+  const rows = await db
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+
+  return rows.map((row) => row.postId)
+}
+
+/** The `tags` field as the controller receives it: already a list, or still the raw text. */
+export function parseTagNames(value: unknown): string[] {
+  const parts = Array.isArray(value) ? value : String(value ?? '').split(',')
+  return [...new Set(parts.map((part) => String(part).trim()).filter((name) => name.length > 0))]
+}
+
+/** Makes `names` exactly the post's tag set, creating unseen tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const db = await database()
+
+  if (names.length === 0) {
+    await db.delete(postTags).where(eq(postTags.postId, postId))
+    return
+  }
+
+  await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing()
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names))
+  const tagIds = rows.map((row) => row.id)
+
+  await db.delete(postTags).where(and(eq(postTags.postId, postId), notInArray(postTags.tagId, tagIds)))
+  await db.insert(postTags).values(tagIds.map((tagId) => ({ postId, tagId }))).onConflictDoNothing()
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  const db = await database()
+  await db.delete(postTags).where(eq(postTags.postId, postId))
+}
