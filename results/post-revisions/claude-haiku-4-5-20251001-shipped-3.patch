@@ -0,0 +1,67 @@
+import { Head, Link, Form } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: { id: number }
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title="Revisions" />
+      <div className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Revisions
+          </h1>
+          <p className="text-sm text-g-muted">Earlier versions of this post</p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No revisions yet. Revisions are created when you edit a post.</p>
+        ) : (
+          <div className="space-y-3">
+            {revisions.map((revision) => (
+              <div key={revision.id} className="flex items-center justify-between rounded-lg border border-g-line p-4">
+                <div className="min-w-0 flex-1">
+                  <h3 className="font-semibold text-g-heading">{revision.title}</h3>
+                  <p className="text-sm text-g-muted">
+                    {new Date(revision.createdAt).toLocaleDateString()} at{' '}
+                    {new Date(revision.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
+                  </p>
+                </div>
+                <Form
+                  method="post"
+                  action={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                  className="ml-4 shrink-0"
+                >
+                  <button
+                    type="submit"
+                    className="rounded-g-ctl border border-g-accent-chip bg-g-accent px-3 py-2 font-semibold text-g-accent-text transition hover:opacity-90"
+                  >
+                    Restore
+                  </button>
+                </Form>
+              </div>
+            ))}
+          </div>
+        )}
+
+        <footer className="border-t border-g-line pt-6">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </div>
+    </Layout>
+  )
+}
