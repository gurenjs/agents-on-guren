@@ -20,3 +23,99 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  async function makeUser(email: string) {
+    return User.forceCreate({ name: email, email, passwordHash: 'not-a-real-hash' })
+  }
+
+  async function makePost(authorId: number) {
+    return Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId,
+    })
+  }
+
+  it('keeps the original author even when the request supplies a different authorId', async () => {
+    const author = await makeUser('author-a@example.com')
+    const other = await makeUser('author-b@example.com')
+    const post = await makePost(author!.id)
+
+    const asAuthor = await http.actingAs({ id: author!.id }).withCsrf()
+    await asAuthor
+      .put(`/posts/${post!.id}`, {
+        title: 'Renamed',
+        excerpt: 'Still mine?',
+        body: 'Updated body',
+        authorId: other!.id,
+      })
+      .assertRedirect(`/posts/${post!.id}`)
+
+    const reloaded = await Post.findOrFail(post!.id)
+    expect(reloaded.authorId).toBe(author!.id)
+    expect(reloaded.title).toBe('Renamed')
+  })
+
+  it('does not write fields outside the edit form, like createdAt', async () => {
+    const author = await makeUser('author-c@example.com')
+    const post = await makePost(author!.id)
+    const originalCreatedAt = post!.createdAt
+
+    const asAuthor = await http.actingAs({ id: author!.id }).withCsrf()
+    await asAuthor
+      .put(`/posts/${post!.id}`, {
+        title: 'Renamed again',
+        excerpt: 'Still mine?',
+        body: 'Updated body',
+        createdAt: '1999-01-01T00:00:00.000Z',
+      })
+      .assertRedirect(`/posts/${post!.id}`)
+
+    const reloaded = await Post.findOrFail(post!.id)
+    expect(reloaded.createdAt).toBe(originalCreatedAt)
+  })
+
+  it('rejects an empty title with a 422 and leaves the post unchanged', async () => {
+    const author = await makeUser('author-d@example.com')
+    const post = await makePost(author!.id)
+
+    const asAuthor = await http.actingAs({ id: author!.id }).withCsrf()
+    await asAuthor
+      .put(`/posts/${post!.id}`, {
+        title: '',
+        excerpt: 'Still mine?',
+        body: 'Updated body',
+      })
+      .assertStatus(422)
+
+    const reloaded = await Post.findOrFail(post!.id)
+    expect(reloaded.title).toBe('Original title')
+  })
+
+  it('refuses an edit from a non-author with a 403', async () => {
+    const author = await makeUser('author-e@example.com')
+    const intruder = await makeUser('author-f@example.com')
+    const post = await makePost(author!.id)
+
+    const asIntruder = await http.actingAs({ id: intruder!.id }).withCsrf()
+    await asIntruder
+      .put(`/posts/${post!.id}`, {
+        title: 'Hijacked',
+        excerpt: 'Not mine',
+        body: 'Body',
+      })
+      .assertStatus(403)
+
+    const reloaded = await Post.findOrFail(post!.id)
+    expect(reloaded.title).toBe('Original title')
+  })
+})
