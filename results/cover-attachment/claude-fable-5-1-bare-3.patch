+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync, readdirSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { deflateSync } from 'node:zlib'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Drives the real app against the test database (NODE_ENV=test), which the
+// app migrates when it boots. Every test works on posts of an author it
+// creates, and afterAll removes them, their covers included.
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const MAX_BYTES = 2 * 1024 * 1024
+
+function pngChunk(type: string, data: Uint8Array): Uint8Array<ArrayBuffer> {
+  const typed = new Uint8Array(4 + data.length)
+  typed.set(new TextEncoder().encode(type))
+  typed.set(data, 4)
+
+  const chunk = new Uint8Array(12 + data.length)
+  const view = new DataView(chunk.buffer)
+  view.setUint32(0, data.length)
+  chunk.set(typed, 4)
+  view.setUint32(8 + data.length, Bun.hash.crc32(typed))
+  return chunk
+}
+
+/** A valid 2x2 PNG of random pixels, so no two uploads share their bytes. */
+function png(): Uint8Array<ArrayBuffer> {
+  const header = new Uint8Array(13)
+  const view = new DataView(header.buffer)
+  view.setUint32(0, 2)
+  view.setUint32(4, 2)
+  // 8 bits per channel, truecolor.
+  header.set([8, 2, 0, 0, 0], 8)
+
+  const rows = crypto.getRandomValues(new Uint8Array(2 * 7))
+  // Each row opens with its filter type; 0 is "none".
+  rows[0] = 0
+  rows[7] = 0
+
+  return new Uint8Array(
+    Buffer.concat([
+      new Uint8Array(PNG_SIGNATURE),
+      pngChunk('IHDR', header),
+      pngChunk('IDAT', deflateSync(rows)),
+      pngChunk('IEND', new Uint8Array()),
+    ]),
+  )
+}
+
+/** A PNG one byte over the limit: decoders stop at IEND, the size check does not. */
+function oversizedPng(): Uint8Array<ArrayBuffer> {
+  const bytes = new Uint8Array(MAX_BYTES + 1)
+  bytes.set(png())
+  return bytes
+}
+
+const JPEG = new Uint8Array(
+  Buffer.from(
+    '',
+    'base64',
+  ),
+)
+
+const GIF = new Uint8Array(Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', 'base64'))
+
+interface FormFields {
+  title?: string
+  cover?: { bytes: Uint8Array<ArrayBuffer>; name: string; type: string }
+  removeCover?: string
+}
+
+function postForm({ title = 'A post with a cover', cover, removeCover }: FormFields = {}): FormData {
+  const form = new FormData()
+  form.set('title', title)
+  form.set('excerpt', 'Written by the cover tests.')
+  form.set('body', 'Body of a post written by the cover tests.')
+  if (cover) {
+    form.set('cover', new File([cover.bytes], cover.name, { type: cover.type }))
+  }
+  if (removeCover !== undefined) {
+    form.set('removeCover', removeCover)
+  }
+  return form
+}
+
+const pngCover = (bytes = png()) => ({ bytes, name: 'cover.png', type: 'image/png' })
+const jpegCover = () => ({ bytes: JPEG, name: 'cover.jpg', type: 'image/jpeg' })
+
+function filesUnder(directory: string): string[] {
+  if (!existsSync(directory)) {
+    return []
+  }
+  return readdirSync(directory, { recursive: true, withFileTypes: true })
+    .filter((entry) => entry.isFile())
+    .map((entry) => join(entry.parentPath, entry.name))
+}
+
+function isStoredUnder(directory: string, bytes: Uint8Array): boolean {
+  const wanted = Buffer.from(bytes)
+  return filesUnder(directory).some((file) => readFileSync(file).equals(wanted))
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    const guest = await TestApp.fromApp(app)
+    author = await User.create({
+      name: 'Cover Author',
+      email: `cover-author-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    http = await guest.actingAs(author).withCsrf('/posts')
+  })
+
+  afterAll(async () => {
+    for (const post of await Post.where('authorId', author.id).get()) {
+      await Post.purgeAttachments(post.id)
+      await Post.delete({ id: post.id })
+    }
+    await User.delete({ id: author.id })
+  })
+
+  async function authorPosts() {
+    return Post.where('authorId', author.id).orderBy('id', 'desc').get()
+  }
+
+  async function coverRows(postId: number) {
+    return Attachment.where({ attachableType: 'Post', attachableId: String(postId) }).get()
+  }
+
+  async function createPost(fields: FormFields = {}): Promise<number> {
+    const before = await authorPosts()
+    const response = await http.post('/posts', postForm(fields))
+    const [latest] = await authorPosts()
+
+    expect((await authorPosts()).length).toBe(before.length + 1)
+    response.assertRedirect(`/posts/${latest.id}`)
+    return latest.id
+  }
+
+  async function shownPost(postId: number): Promise<PostResourceData> {
+    const response = await http.get(`/posts/${postId}`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+
+    expect(payload.component).toBe('posts/Show')
+    return payload.props.post as PostResourceData
+  }
+
+  async function coverUrlOf(postId: number): Promise<string> {
+    const { coverUrl } = await shownPost(postId)
+    if (coverUrl === null) {
+      throw new Error(`Post ${postId} has no cover.`)
+    }
+    return coverUrl
+  }
+
+  it('stores a PNG cover and serves it back byte for byte', async () => {
+    const bytes = png()
+    const postId = await createPost({ cover: pngCover(bytes) })
+
+    const response = await http.get(await coverUrlOf(postId)).assertOk()
+    expect(response.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await response.raw.arrayBuffer())).toEqual(bytes)
+
+    expect(await coverRows(postId)).toHaveLength(1)
+    expect(isStoredUnder('storage', bytes)).toBe(true)
+    expect(isStoredUnder('public', bytes)).toBe(false)
+  })
+
+  it('stores a JPEG cover under its own content type', async () => {
+    const postId = await createPost({ cover: jpegCover() })
+
+    const response = await http.get(await coverUrlOf(postId)).assertOk()
+    expect(response.headers.get('content-type')).toBe('image/jpeg')
+    expect(new Uint8Array(await response.raw.arrayBuffer())).toEqual(JPEG)
+  })
+
+  it('trusts the bytes over the declared type', async () => {
+    const bytes = png()
+    const postId = await createPost({ cover: { bytes, name: 'cover.bin', type: 'application/octet-stream' } })
+
+    const response = await http.get(await coverUrlOf(postId)).assertOk()
+    expect(response.headers.get('content-type')).toBe('image/png')
+  })
+
+  it('serves a cover to a visitor who is not signed in', async () => {
+    const postId = await createPost({ cover: pngCover() })
+    const guest = await TestApp.fromApp(app)
+
+    await guest.get(await coverUrlOf(postId)).assertOk()
+  })
+
+  it('does not serve a cover URL whose signature was tampered with', async () => {
+    const postId = await createPost({ cover: pngCover() })
+    const url = new URL(await coverUrlOf(postId), 'http://localhost')
+    url.searchParams.set('expires', String(Number(url.searchParams.get('expires')) + 60))
+
+    await http.get(`${url.pathname}${url.search}`).assertNotFound()
+  })
+
+  it('creates a post without a cover', async () => {
+    const postId = await createPost()
+
+    expect((await shownPost(postId)).coverUrl).toBeNull()
+    expect(await coverRows(postId)).toHaveLength(0)
+  })
+
+  it('treats an empty file field as no cover', async () => {
+    const form = postForm()
+    form.set('cover', new File([], ''))
+    const before = (await authorPosts()).length
+
+    await http.post('/posts', form).assertRedirect()
+
+    const [latest, ...rest] = await authorPosts()
+    expect(rest).toHaveLength(before)
+    expect((await shownPost(latest.id)).coverUrl).toBeNull()
+  })
+
+  it('lists each post with its cover URL', async () => {
+    const withCover = await createPost({ cover: pngCover() })
+    const withoutCover = await createPost()
+
+    const response = await http.get('/posts').assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const listed = payload.props.data as PostResourceData[]
+
+    expect(payload.component).toBe('posts/Index')
+    expect(listed.find((post) => post.id === withCover)?.coverUrl).toBeString()
+    expect(listed.find((post) => post.id === withoutCover)?.coverUrl).toBeNull()
+  })
+
+  for (const [label, cover] of [
+    ['a GIF', { bytes: GIF, name: 'cover.gif', type: 'image/gif' }],
+    ['a GIF declared as a PNG', { bytes: GIF, name: 'cover.png', type: 'image/png' }],
+    ['a PNG over 2 MB', pngCover(oversizedPng())],
+  ] as const) {
+    it(`refuses ${label} on create and saves nothing`, async () => {
+      const postsBefore = (await Post.all()).length
+      const rowsBefore = (await Attachment.all()).length
