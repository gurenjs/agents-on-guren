@@ -0,0 +1,47 @@
+import { Controller, HttpException, ValidationException } from '@guren/core'
+import { Subscription } from '../../Models/Subscription.js'
+import { SubscribeSchema, UnsubscribeSchema, ConfirmTokenParamSchema } from '../Validators/SubscriptionValidator.js'
+import { randomBytes } from 'node:crypto'
+
+export default class SubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const data = await this.validateBody(SubscribeSchema)
+    const referer = this.ctx.req.header('referer') || '/'
+
+    const existing = await Subscription.first({ email: data.email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    const token = randomBytes(32).toString('hex')
+    await Subscription.create({
+      email: data.email,
+      token,
+      confirmedAt: null,
+    })
+
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenParamSchema)
+    const subscription = await Subscription.first({ token })
+
+    if (!subscription) {
+      throw HttpException.notFound('Confirmation link is invalid or has expired.')
+    }
+
+    await Subscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const data = await this.validateBody(UnsubscribeSchema)
+    const referer = this.ctx.req.header('referer') || '/'
+
+    await Subscription.delete({ email: data.email })
+
+    return this.redirect(referer)
+  }
+}
