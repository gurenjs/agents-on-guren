diff --git a/tests/PostController.excerpt.test.ts b/tests/PostController.excerpt.test.ts
new file mode 100644
index 0000000..39d6f83
--- /dev/null
+++ b/tests/PostController.excerpt.test.ts
@@ -0,0 +1,89 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+// Feature tests for the excerpt-derivation behaviour: creating or updating a
+// post with a blank excerpt must succeed and fall back to a derivation from
+// the body, while a provided excerpt is stored as typed.
+describe('posts excerpt fallback', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function actingAsNewUser(suffix: string): Promise<TestApp> {
+    const user = await User.create({
+      name: `Excerpt Tester ${suffix}`,
+      email: `excerpt-tester-${suffix}@example.com`,
+      password: 'password123',
+    })
+
+    const authed = http.actingAs(user)
+    return authed.withCsrf('/posts/create')
+  }
+
+  it('derives an excerpt when creating a post without one', async () => {
+    const client = await actingAsNewUser(`create-blank-${crypto.randomUUID()}`)
+    const body = 'x'.repeat(200)
+
+    const response = await client.post('/posts', { title: 'No excerpt given', excerpt: '   ', body })
+    response.assertStatus(303)
+
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+    const post = await Post.findOrFail(id)
+
+    expect(post.excerpt).toBe(deriveExcerpt(body))
+    expect(post.excerpt.length).toBeGreaterThan(0)
+  })
+
+  it('stores a provided excerpt as typed, trimmed of surrounding whitespace', async () => {
+    const client = await actingAsNewUser(`create-explicit-${crypto.randomUUID()}`)
+    const body = 'x'.repeat(200)
+
+    const response = await client.post('/posts', {
+      title: 'Explicit excerpt given',
+      excerpt: '  My own excerpt  ',
+      body,
+    })
+    response.assertStatus(303)
+
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+    const post = await Post.findOrFail(id)
+
+    expect(post.excerpt).toBe('My own excerpt')
+  })
+
+  it('re-derives the excerpt on update when the excerpt is cleared', async () => {
+    const client = await actingAsNewUser(`update-blank-${crypto.randomUUID()}`)
+
+    const createResponse = await client.post('/posts', {
+      title: 'Original post',
+      excerpt: 'An original excerpt',
+      body: 'Original body content.',
+    })
+    createResponse.assertStatus(303)
+    const location = createResponse.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+
+    const newBody = 'y'.repeat(200)
+    const updateResponse = await client.put(`/posts/${id}`, { title: 'Original post', excerpt: '', body: newBody })
+    updateResponse.assertStatus(303)
+
+    const post = await Post.findOrFail(id)
+    expect(post.excerpt).toBe(deriveExcerpt(newBody))
+  })
+
+  it('rejects a blank title even when the excerpt is blank', async () => {
+    const client = await actingAsNewUser(`create-invalid-${crypto.randomUUID()}`)
+
+    await client.post('/posts', { title: '  ', excerpt: '', body: 'Some body text.' }).then((response) => {
+      response.assertStatus(422)
+    })
+  })
+})
