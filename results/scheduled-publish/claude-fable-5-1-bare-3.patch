+  /** The one-record form of the rule, for PostPolicy and PostResource. */
+  static isScheduled(post: Pick<PostRecord, 'publishedAt'>, now: Date = new Date()): boolean {
+    if (post.publishedAt === null) {
+      return false
+    }
+    const publishedAt = Date.parse(post.publishedAt)
+    // Fails closed: a value nobody can read as a time never goes public.
+    return Number.isNaN(publishedAt) || publishedAt > now.getTime()
