diff --git a/app/Http/Controllers/ApiPostController.ts b/app/Http/Controllers/ApiPostController.ts
new file mode 100644
index 0000000..330f79f
--- /dev/null
+++ b/app/Http/Controllers/ApiPostController.ts
@@ -0,0 +1,24 @@
+import { Controller, getApiTokenOrFail } from '@guren/core'
+import { Post, type PostRecord } from '../../Models/Post.js'
+import { PostResource } from '../Resources/PostResource.js'
+
+function summary(post: PostRecord) {
+  const { id, title, excerpt, authorId, createdAt } = new PostResource(post).toArray()
+  return { id, title, excerpt, authorId, createdAt }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+    return this.json({ data: posts.map(summary) })
+  }
+
+  async store(): Promise<Response> {
+    const { userId } = getApiTokenOrFail(this.ctx)
+    const { body: data } = this.validated('api.posts.store')
+    // forceCreate: authorId comes from the token, never from the request body.
+    const post = await Post.forceCreate({ ...data, authorId: Number(userId) })
+
+    return this.json({ data: summary(post) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..9bc2ec2
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,30 @@
+import { Controller, createApiToken } from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { apiTokenStore } from '../../Support/ApiTokens.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    // The only time the plain token is ever available.
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Scoped to the signed-in user: another user's token id is a 404.
+    const owned = await apiTokenStore.findByUserId(user.id)
+    if (!owned.some((token) => token.id === id)) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await apiTokenStore.delete(id)
+    return this.noContent()
+  }
+}
