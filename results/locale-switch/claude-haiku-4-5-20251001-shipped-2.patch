@@ -0,0 +1,35 @@
+import { getRequestLocale } from '@guren/server'
+import { ServiceProvider, shareInertiaProps } from '@guren/core'
+
+export default class I18nProvider extends ServiceProvider {
+  register(): void {
+    // No-op
+  }
+
+  boot(): void {
+    const container = this.container
+    shareInertiaProps(async (ctx) => {
+      // getRequestLocale uses detectLocaleMiddleware to resolve locale from
+      // query (?locale=), cookie, or Accept-Language header
+      const locale = (getRequestLocale(ctx) || 'en') as 'en' | 'ja'
+
+      let messages: Record<string, unknown> = {}
+
+      try {
+        const i18n = container.make<any>('i18n.manager')
+        if (i18n && typeof i18n.load === 'function') {
+          messages = await i18n.load(locale)
+        }
+      } catch {
+        // i18n.manager might not be available in test contexts
+      }
+
+      return {
+        _i18n: {
+          locale,
+          messages,
+        },
+      }
+    }, container)
+  }
+}
