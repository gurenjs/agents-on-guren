+/** The tag names in a comma-separated `tags` field: trimmed, blanks dropped, duplicates collapsed. */
+export function parseTagNames(input: string | undefined): string[] {
+  const names = (input ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
