 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().trim().optional(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_NAME_LENGTH = 30
+
+/**
+ * The names in a comma-separated `tags` field, in the order typed: trimmed,
+ * blank entries dropped, a repeated name kept once. Names are case-sensitive.
+ */
+export function parseTagNames(input: string | undefined): string[] {
+  const names = (input ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
+}
+
+// Kept a plain string, not a `.transform()` to `string[]`: codegen types a
+// transformed field by its input, so `validated()` would claim a string while
+// holding an array. Actions read the names with `parseTagNames()`.
+const PostTagsSchema = z
+  .string()
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post can have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+    // Counted in code points, so one emoji is one character.
+    if (names.some((name) => [...name].length > MAX_TAG_NAME_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_NAME_LENGTH} characters or fewer.` })
+    }
+  })
