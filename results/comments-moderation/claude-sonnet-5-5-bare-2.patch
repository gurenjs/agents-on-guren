diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..e01e4ac
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,53 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  const stamp = Date.now()
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  async function makeUser(name: string) {
+    return User.create({ name, email: `${name}-${stamp}@example.test`, password: 'password123' })
+  }
+
+  it('sends a guest to login and stores nothing', async () => {
+    const owner = await makeUser('guest-owner')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner!.id })
+    await http.post(`/posts/${post!.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.where('postId', post!.id).count()).toBe(0)
+  })
+
+  it('creates, reports, hides and deletes comments', async () => {
+    const owner = await makeUser('owner')
+    const writer = await makeUser('writer')
+    const other = await makeUser('other')
+    const reporters = [await makeUser('r1'), await makeUser('r2'), await makeUser('r3')]
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner!.id })
+
+    await http.actingAs(writer).post(`/posts/${post!.id}/comments`, { body: '' }).assertStatus(422)
+    await http.actingAs(writer).post(`/posts/${post!.id}/comments`, { body: 'x'.repeat(2001) }).assertStatus(422)
+    await http.actingAs(writer).post(`/posts/${post!.id}/comments`, { body: 'hello' }).assertRedirect(`/posts/${post!.id}`)
+
+    const comment = (await Comment.where('postId', post!.id).first())!
+    expect(comment.userId).toBe(writer!.id)
+
+    await http.actingAs(other).delete(`/comments/${comment.id}`).assertStatus(403)
+    expect(await Comment.where('id', comment.id).count()).toBe(1)
+
+    for (const r of [reporters[0]!, reporters[0]!, reporters[1]!, reporters[2]!]) {
+      await http.actingAs(r).post(`/comments/${comment.id}/report`).assertStatus(204)
+    }
+    expect(await CommentReport.where('commentId', comment.id).count()).toBe(3)
+
+    await http.actingAs(owner).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post!.id}`)
+    expect(await Comment.where('id', comment.id).count()).toBe(0)
+  })
+})
