+import { createRateLimitMiddleware, MemoryRateLimitStore } from '@guren/core'
+
+// Its own store (rather than the shared default) so tests can reset counts
+// between cases via `loginThrottleStore.clear()`.
+export const loginThrottleStore = new MemoryRateLimitStore()
+
+// 5 attempts per minute per client IP. Every submission counts, successful or
+// not. Uses the connection's own address (no forwarded-for headers, since the
+// app isn't behind a proxy in dev); when the address can't be determined it
+// falls back to a single shared bucket rather than letting requests through
+// unthrottled.
+export const loginThrottleMiddleware = createRateLimitMiddleware({
+  limit: 5,
+  windowMs: 60_000,
+  keyPrefix: 'rl:login:',
+  store: loginThrottleStore,
+})
