diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..f173435
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,77 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment, CommentReport } from '../app/Models/Comment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+async function makeUser(name: string) {
+  return User.create({ name, email: `${name}@example.com`, password: 'password123' })
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function setup() {
+    const author = await makeUser('author')
+    const other = await makeUser('other')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    return { author, other, post }
+  }
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const { post } = await setup()
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores a valid comment and rejects an empty one', async () => {
+    const { other, post } = await setup()
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect(`/posts/${post.id}`)
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(1)
+  })
+
+  it('lets the comment author and post author delete, and forbids others', async () => {
+    const { author, other, post } = await setup()
+    const third = await makeUser('third')
+    const mine = await Comment.forceCreate({ body: 'a', postId: post.id, userId: other.id })
+    const forbidden = await (await http.actingAs(third).withCsrf()).delete(`/comments/${mine.id}`)
+    expect(forbidden.status).toBe(403)
+    await (await http.actingAs(other).withCsrf()).delete(`/comments/${mine.id}`).assertRedirect(`/posts/${post.id}`)
+    const second = await Comment.forceCreate({ body: 'b', postId: post.id, userId: other.id })
+    await (await http.actingAs(author).withCsrf()).delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('counts a repeated report once and hides at three reporters', async () => {
+    const { author, other, post } = await setup()
+    const third = await makeUser('third')
+    const comment = await Comment.forceCreate({ body: 'spam', postId: post.id, userId: other.id })
+    for (const user of [author, other, author, third]) {
+      await (await http.actingAs(user).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+    expect(await CommentReport.all()).toHaveLength(3)
+    const page = await http.get(`/posts/${post.id}`)
+    expect(await page.text()).not.toContain('spam')
+    expect(await Comment.all()).toHaveLength(1)
+  })
+
+  it('removes comments with their post', async () => {
+    const { author, post } = await setup()
+    await Comment.forceCreate({ body: 'x', postId: post.id, userId: author.id })
+    await (await http.actingAs(author).withCsrf()).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
