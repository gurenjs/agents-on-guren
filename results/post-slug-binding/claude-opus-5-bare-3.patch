@@ -0,0 +1,108 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, slugify } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// A title of its own, so these posts never share a slug family with the
+// seeded samples or with another test file.
+const TITLE = 'Slug Rules Sample Post'
+const BASE = 'slug-rules-sample-post'
+
+const PAYLOAD = {
+  title: TITLE,
+  excerpt: 'A post created by the slug test.',
+  body: 'The slug comes from the title, and it never moves afterwards.',
+}
+
+// A title of nothing but digits slugs to digits, which the numeric route
+// matches first — the post is still served at its own address.
+const DIGITS_TITLE = '31415926'
+
+async function removeTestPosts(): Promise<void> {
+  for (const base of [BASE, DIGITS_TITLE]) {
+    const created = await Post.newQuery().where('slug', 'like', `${base}%`).get()
+    for (const post of created) {
+      await Post.delete({ id: post.id })
+    }
+  }
+}
