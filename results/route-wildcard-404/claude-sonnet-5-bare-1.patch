-import { beforeAll, describe, it } from 'bun:test'
+import { afterAll, beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +22,89 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// The archive route captures `date` via Hono's `:date{.+}` catch-all pattern
+// (not `:date*`, which Hono treats as a literal single-segment param named
+// "date*" rather than a multi-segment wildcard). Real posts are created here
+// because the bug only reproduces once the router actually has to match a
+// multi-segment path and the controller queries the database.
+describe('posts.archive', () => {
+  let http: TestApp
+  let authorId: number
+  let augustPostIds: number[]
+  let januaryPostId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    const author = await User.create({
+      name: 'Archive Author',
+      email: `archive-author-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+    authorId = author.id as number
+
+    const make = (title: string, createdAt: string) =>
+      Post.forceCreate({
+        title,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId,
+        createdAt,
+      })
+
+    // 2019 rather than the current year, so these fixtures can never collide
+    // with posts created by other tests (or the demo seed data) at run time.
+    // Created in chronological order, so ids ascend with createdAt like they
+    // would in production — the controller orders by id desc, which only
+    // matches "newest createdAt first" when the two agree.
+    await make('Different year', '2018-08-10T10:00:00.000Z')
+    const january = await make('January', '2019-01-15T10:00:00.000Z')
+    const early = await make('August early', '2019-08-05T10:00:00.000Z')
+    const late = await make('August late', '2019-08-20T10:00:00.000Z')
+
+    augustPostIds = [late.id as number, early.id as number]
+    januaryPostId = january.id as number
+  })
+
+  afterAll(async () => {
+    await Post.newQuery().where('authorId', authorId).delete()
+    await User.delete({ id: authorId })
+  })
+
+  it('lists posts created in a given month, zero-padded', async () => {
+    const response = await http.get('/posts/archive/2019/08').assertOk()
+    const body = await response.json<{ data: Array<{ id: number }> }>()
+
+    if (body.data.map((post) => post.id).join(',') !== augustPostIds.join(',')) {
+      throw new Error(`Expected posts ${augustPostIds.join(',')}, got ${body.data.map((p) => p.id).join(',')}`)
+    }
+  })
+
+  it('lists posts created in a given month, without a leading zero', async () => {
+    const response = await http.get('/posts/archive/2019/8').assertOk()
+    const body = await response.json<{ data: Array<{ id: number }> }>()
+
+    if (body.data.map((post) => post.id).join(',') !== augustPostIds.join(',')) {
+      throw new Error(`Expected posts ${augustPostIds.join(',')}, got ${body.data.map((p) => p.id).join(',')}`)
+    }
+  })
+
+  it('lists every post created in a given year', async () => {
+    const response = await http.get('/posts/archive/2019').assertOk()
+    const body = await response.json<{ data: Array<{ id: number }> }>()
+    const expected = [...augustPostIds, januaryPostId]
+
+    if (body.data.map((post) => post.id).join(',') !== expected.join(',')) {
+      throw new Error(`Expected posts ${expected.join(',')}, got ${body.data.map((p) => p.id).join(',')}`)
+    }
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/2099/01').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2019/13').assertStatus(422)
+  })
+})
