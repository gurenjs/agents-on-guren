diff --git a/app/Models/ApiToken.ts b/app/Models/ApiToken.ts
new file mode 100644
index 0000000..a3b25c3
--- /dev/null
+++ b/app/Models/ApiToken.ts
@@ -0,0 +1,18 @@
+import { createHash, randomBytes } from 'node:crypto'
+import { defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+export class ApiToken extends defineModel(apiTokens, {
+  // `userId` and `tokenHash` are set by the server, never from request input.
+  fillable: ['name'],
+}) {}
+
+export function generateApiTokenSecret(): string {
+  return randomBytes(32).toString('base64url')
+}
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
