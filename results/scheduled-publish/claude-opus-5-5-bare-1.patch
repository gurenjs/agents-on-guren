new file mode 100644
index 0000000..dfee2e0
--- /dev/null
+++ b/app/Console/Commands/ListScheduledPostsCommand.ts
@@ -0,0 +1,21 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints one `<id>\t<title>\t<published_at>` line per scheduled post, soonest
+ * first, and nothing else on stdout, so ops can pipe it into other tools.
+ */
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later (id, title, published_at; tab-separated)'
+
+  async handle(): Promise<number> {
+    const posts = await Post.scheduled().get()
+
+    for (const post of posts) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+
+    return 0
+  }
+}
