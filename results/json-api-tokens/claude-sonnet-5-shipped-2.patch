diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..6cbdab3
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,79 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { apiTokenStore } from '../app/Auth/ApiTokens.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass-1' })
+  })
+
+  async function mint(name = 'CI') {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: string; name: string; token: string }>()
+  }
+
+  it('creates and uses a token, stores no plain text, and scopes authorship', async () => {
+    const created = await mint()
+    expect(created.token.split('|')[1]!.length).toBeGreaterThanOrEqual(16)
+
+    const bearer = http.json().withHeader('Authorization', `Bearer ${created.token}`)
+    const res = await bearer.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    res.assertCreated()
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(Number(user.id))
+    await bearer.get('/api/posts').assertOk().assertJsonCount(1, 'data')
+    await bearer.post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+    expect((await Post.all()).length).toBe(1)
+
+    const secret = created.token.split('|')[1]!
+    const rows = await apiTokenStore.findByUserId(Number(user.id))
+    expect(JSON.stringify(rows)).not.toContain(secret)
+  })
+
+  it('rejects bad tokens and validates names', async () => {
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', 'Bearer nope').get('/api/posts').assertUnauthorized()
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+  })
+
+  it('revokes only the owner’s token', async () => {
+    const a = await mint('a')
+    const b = await mint('b')
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-pass-2' })
+    const otherCsrf = await http.actingAs(other).withCsrf()
+    await otherCsrf.json().delete(`/profile/tokens/${a.id}`).assertNotFound()
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${a.id}`).assertNoContent()
+    await http.json().withHeader('Authorization', `Bearer ${a.token}`).get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', `Bearer ${b.token}`).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const a = await mint('a')
+    const b = await mint('b')
+    const client = http.json().withHeader('Authorization', `Bearer ${a.token}`)
+    for (let i = 0; i < 60; i++) await client.get('/api/posts').assertOk()
+    const limited = await client.get('/api/posts')
+    limited.assertStatus(429)
+    const retry = Number(limited.headers.get('Retry-After'))
+    expect(retry).toBeGreaterThan(0)
+    expect(retry).toBeLessThanOrEqual(60)
+    await http.json().withHeader('Authorization', `Bearer ${b.token}`).get('/api/posts').assertOk()
+  })
+})
