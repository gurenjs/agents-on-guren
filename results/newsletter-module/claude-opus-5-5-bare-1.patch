new file mode 100644
index 0000000..f891b7d
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/SubscriptionController.ts
@@ -0,0 +1,58 @@
+import { Controller, ValidationException } from '@guren/core'
+import { Subscription } from '../../Models/Subscription.js'
+import { SubscriptionEmailSchema, SubscriptionTokenParamSchema } from '../Validators/SubscriptionValidator.js'
+
+export default class SubscriptionController extends Controller {
+  async store(): Promise<Response> {
+    const { email } = await this.validateBody(SubscriptionEmailSchema)
+
+    const existing = await Subscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from Subscription.fillable.
+    await Subscription.forceCreate({ email, token: generateToken() })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(SubscriptionTokenParamSchema)
+    const subscription = await Subscription.findOrFail(token, 'token')
+
+    if (!subscription.confirmedAt) {
+      await Subscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async destroy(): Promise<Response> {
+    const { email } = await this.validateBody(SubscriptionEmailSchema)
+    await Subscription.delete({ email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  // Only a same-origin Referer is followed, so the redirect cannot be turned
+  // into an open redirect to another site.
+  private previousUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+
+    try {
+      const current = new URL(this.request.url)
+      const previous = new URL(referer, current)
+      if (previous.origin !== current.origin) return '/'
+      return `${previous.pathname}${previous.search}` || '/'
+    } catch {
+      return '/'
+    }
+  }
+}
+
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
