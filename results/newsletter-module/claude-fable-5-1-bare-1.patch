+import { defineModule } from '@guren/core'
+import { registerNewsletterRoutes } from './routes.js'
+
+// Newsletter sign-up, self-contained so it can be lifted into another app as
+// is: routes, controller, validation, model and table all live in this folder.
+export const newsletterModule = defineModule({
+  name: 'newsletter',
+  prefix: '/newsletter',
+  routes: registerNewsletterRoutes,
+})
