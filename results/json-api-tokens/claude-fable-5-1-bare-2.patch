new file mode 100644
index 0000000..2f08019
--- /dev/null
+++ b/app/Auth/ApiTokenStore.ts
@@ -0,0 +1,10 @@
+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+/**
+ * The one store personal API tokens live in. AuthProvider hands it to the
+ * token guard, and ApiTokenController issues and revokes through it, so a
+ * token the profile page creates is exactly what a bearer request verifies
+ * against. Rows hold the SHA-256 digest of the secret, never the secret.
+ */
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
diff --git a/app/Http/Controllers/Api/ApiPostController.ts b/app/Http/Controllers/Api/ApiPostController.ts
new file mode 100644
index 0000000..95a691b
--- /dev/null
+++ b/app/Http/Controllers/Api/ApiPostController.ts
@@ -0,0 +1,32 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+/**
+ * The JSON posts API scripts call with a personal bearer token. Routes in
+ * routes/api.ts authenticate the token and rate-limit per token before an
+ * action runs, so `this.auth` here always resolves to the token's owner.
+ * Not named PostController: `guren audit` needs controller class names unique.
+ */
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // The schema only admits title/excerpt/body, and forceCreate sets the
+    // author from the token: an `authorId` in the request never reaches here.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.created({ data: new PostResource(post).toJSON() })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..17d1e63
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,42 @@
+import { Controller, NotFoundHttpException, createApiToken, getUserApiTokens, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokenStore.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+/**
+ * Personal API tokens, managed from the profile page over JSON. Both actions
+ * sit behind the session `auth` middleware: a token is created for, and can
+ * only be revoked by, the signed-in user who owns it.
+ */
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+
+    // `plainTextToken` is `{id}|{secret}`; the store keeps only the secret's
+    // digest, so this response is the one and only place it can be read.
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name,
+      userId: user.id,
+    })
+
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Looked up through the owner's tokens rather than by id alone, so another
+    // user's id is indistinguishable from one that never existed.
+    const owned = await getUserApiTokens(user.id, apiTokenStore)
+    const token = owned.find((candidate) => candidate.id === id)
+    if (!token) {
+      throw new NotFoundHttpException('Token not found.')
+    }
+
+    await revokeApiToken(token.id, apiTokenStore)
+
+    return this.noContent()
+  }
+}
