+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+
+describe('Post Revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let otherUser: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    // Create users
+    author = await User.create({
+      name: 'Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+
+    otherUser = await User.create({
+      name: 'Other User',
+      email: 'other@example.com',
+      password: 'password123',
+    })
+
+    // Create a post
+    post = await Post.forceCreate({
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+      authorId: author.id,
+    })
+  })
+
+  test('author can view revisions', async () => {
+    const res = await http.actingAs(author).get(`/posts/${post.id}/revisions`)
+    await res.assertOk()
+  })
+
+  test('non-author cannot view revisions', async () => {
+    const res = await http.actingAs(otherUser).get(`/posts/${post.id}/revisions`)
+    await res.assertForbidden()
+  })
+
+  test('guest is redirected to login', async () => {
+    const res = await http.get(`/posts/${post.id}/revisions`)
+    await res.assertRedirect('/login')
+  })
+
+  test('revisions page shows empty list initially', async () => {
+    const res = await http.actingAs(author).get(`/posts/${post.id}/revisions`)
+    await res.assertOk()
+  })
+
+  test('editing a post creates a revision', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, {
+      title: 'Second',
+      excerpt: 'Second excerpt',
+      body: 'Second body',
+    }).assertRedirect(`/posts/${post.id}`)
+
+    // Check revision was created
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions).toHaveLength(1)
+    expect(revisions[0].title).toBe('First')
+    expect(revisions[0].excerpt).toBe('First excerpt')
+    expect(revisions[0].body).toBe('First body')
+  })
+
+  test('restoring a revision creates new revision', async () => {
+    const revision = await PostRevision.first({ postId: post.id })
+    if (!revision) throw new Error('No revision found')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    // Check post was restored
+    const updatedPost = await Post.findOrFail(post.id)
+    expect(updatedPost.title).toBe('First')
+
+    // Check new revision was created
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions).toHaveLength(2)
+  })
+
+  test('non-author cannot restore revision', async () => {
+    const revision = await PostRevision.first({ postId: post.id })
+    if (!revision) throw new Error('No revision found')
+
+    const csrf = await http.actingAs(otherUser).withCsrf()
+    const res = await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`)
+    await res.assertForbidden()
+  })
+
+  test('wrong revision returns 404', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const res = await csrf.post(`/posts/${post.id}/revisions/999/restore`)
+    await res.assertNotFound()
+  })
+
+  test('deleting post deletes revisions', async () => {
+    // Create another post
+    const post2 = await Post.forceCreate({
+      title: 'Post 2',
+      excerpt: 'Excerpt 2',
+      body: 'Body 2',
+      authorId: author.id,
+    })
+
+    // Create a revision for it
+    await PostRevision.create({
+      postId: post2.id,
+      title: 'Old',
+      excerpt: 'Old excerpt',
+      body: 'Old body',
+    })
+
+    // Delete the post
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post2.id}`)
+      .assertRedirect('/posts')
+
+    // Check revisions were deleted
+    const revisions = await PostRevision.where({ postId: post2.id }).get()
+    expect(revisions).toHaveLength(0)
+  })
+})
