diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..c6e2d40
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,205 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { kernel } from '../src/console.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Scheduled publishing: a post with a future `published_at` exists only for
+// its author until that instant passes, with no job or button involved. The
+// test database persists between runs, so fixtures carry a unique run tag.
+
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+const FUTURE = '2099-10-01T09:00:00.000Z'
+const PAST = '2000-01-01T00:00:00.000Z'
+
+async function createUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: `${label} ${run}`,
+    email: `${label}-${run}@example.com`,
+    password: 'secret-password',
+  })
+  if (!user) {
+    throw new Error('User fixture was not created.')
+  }
+  return user
+}
+
+function idFromLocation(location: string | null): number {
+  const match = /\/posts\/(\d+)$/.exec(location ?? '')
+  if (!match) {
+    throw new Error(`Expected a redirect to a post page, got ${location}`)
+  }
+  return Number(match[1])
+}
+
+async function listedIds(client: TestApp): Promise<number[]> {
+  const response = await client.get('/posts').assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props.data as PostResourceData[]).map((post) => post.id)
+}
+
+async function searchIds(client: TestApp, keyword: string): Promise<number[]> {
+  const response = await client.query('/posts/search', { keywords: [keyword], limit: 50 }).assertOk()
+  const body = (await response.raw.json()) as { data: PostResourceData[] }
+  return body.data.map((post) => post.id)
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let authorClient: TestApp
+  let scheduledId: number
+  let publicId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await createUser('author')
+    other = await createUser('other')
+    authorClient = await http.actingAs(author).withCsrf('/posts')
+
+    const scheduled = await authorClient.post('/posts', {
+      title: `Scheduled launch ${run}`,
+      excerpt: `scheduled-${run}`,
+      body: 'Not yet.',
+      publishAt: FUTURE,
+    })
+    scheduledId = idFromLocation(scheduled.raw.headers.get('location'))
+
+    const published = await authorClient.post('/posts', {
+      title: `Public note ${run}`,
+      excerpt: `scheduled-${run}`,
+      body: 'Live now.',
+    })
+    publicId = idFromLocation(published.raw.headers.get('location'))
+  })
+
+  it('stores the publish date as ISO 8601 UTC text and null when absent', async () => {
+    const scheduled = await Post.findOrFail(scheduledId)
+    expect(scheduled.publishedAt).toBe(FUTURE)
+
+    const published = await Post.findOrFail(publicId)
+    expect(published.publishedAt).toBeNull()
+  })
+
+  it('rejects a publish date that is not a date and time, saving nothing', async () => {
+    const before = await Post.newQuery().where('authorId', author.id).get()
+    await authorClient
+      .post('/posts', {
+        title: `Bad date ${run}`,
+        excerpt: 'x',
+        body: 'x',
+        publishAt: 'next tuesday',
+      })
+      .assertStatus(422)
+    const after = await Post.newQuery().where('authorId', author.id).get()
+    expect(after.length).toBe(before.length)
+  })
+
+  it('answers 404 on the page for guests and other users, 200 for the author', async () => {
+    await http.get(`/posts/${scheduledId}`).assertStatus(404)
+    await http.actingAs(other).get(`/posts/${scheduledId}`).assertStatus(404)
+
+    const response = await http.actingAs(author).get(`/posts/${scheduledId}`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    expect((payload.props.post as PostResourceData).publishedAt).toBe(FUTURE)
+  })
+
+  it('leaves a post with no date public for everyone', async () => {
+    await http.get(`/posts/${publicId}`).assertOk()
+    await http.actingAs(other).get(`/posts/${publicId}`).assertOk()
+  })
+
+  it('lists the scheduled post only for its author, with its publish date', async () => {
+    expect(await listedIds(http)).not.toContain(scheduledId)
+    expect(await listedIds(http.actingAs(other))).not.toContain(scheduledId)
+
+    const response = await http.actingAs(author).get('/posts').assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const listed = (payload.props.data as PostResourceData[]).find((post) => post.id === scheduledId)
+    expect(listed?.publishedAt).toBe(FUTURE)
+
+    expect(await listedIds(http)).toContain(publicId)
+  })
+
+  it('keeps the scheduled post out of search for guests and other users', async () => {
+    expect(await searchIds(http, `scheduled-${run}`)).toEqual([publicId])
+    expect(await searchIds(http.actingAs(other), `scheduled-${run}`)).toEqual([publicId])
+    expect(await searchIds(http.actingAs(author), `scheduled-${run}`)).toContain(scheduledId)
+  })
+
+  it('reports scheduled posts soonest first, tab-separated, and nothing else on stdout', async () => {
+    const later = await authorClient.post('/posts', {
+      title: `Later launch ${run}`,
+      excerpt: 'later',
+      body: 'x',
+      publishAt: '2099-12-01T09:00:00.000Z',
+    })
+    const laterId = idFromLocation(later.raw.headers.get('location'))
+
+    // In-process, through the kernel, so the assertion is on the exact lines.
+    const output = new BufferedOutput()
+    kernel.setOutput(output)
+    expect(await kernel.handle(['posts:scheduled'])).toBe(0)
+    const lines = output.getLines().filter((line) => line.length > 0)
+    expect(lines).toContain(`${scheduledId}\tScheduled launch ${run}\t${FUTURE}`)
+    expect(lines).toContain(`${laterId}\tLater launch ${run}\t2099-12-01T09:00:00.000Z`)
+    const scheduledIndex = lines.findIndex((line) => line.startsWith(`${scheduledId}\t`))
+    const laterIndex = lines.findIndex((line) => line.startsWith(`${laterId}\t`))
+    expect(scheduledIndex).toBeLessThan(laterIndex)
+    expect(lines.some((line) => line.startsWith(`${publicId}\t`))).toBe(false)
+    for (const line of lines) {
+      expect(line.split('\t')).toHaveLength(3)
+    }
+
+    // End to end, the way ops runs it: stdout carries only the report.
+    const proc = Bun.spawn(['bun', 'bin/console.ts', 'posts:scheduled'], {
+      env: { ...process.env, NODE_ENV: 'test' },
+      stdout: 'pipe',
+      stderr: 'pipe',
+    })
+    const stdout = await new Response(proc.stdout).text()
+    expect(await proc.exited).toBe(0)
+    const spawned = stdout.split('\n').filter((line) => line.length > 0)
+    expect(spawned).toContain(`${scheduledId}\tScheduled launch ${run}\t${FUTURE}`)
+    for (const line of spawned) {
+      expect(line).toMatch(/^\d+\t[^\t]*\t\d{4}-\d{2}-\d{2}T[^\t]+$/)
+    }
+
+    await Post.delete({ id: laterId })
+  })
+
+  it('goes public for everyone once the date has passed, and can be rescheduled or cleared', async () => {
+    await Post.update({ id: scheduledId }, { publishedAt: PAST })
+
+    await http.get(`/posts/${scheduledId}`).assertOk()
+    expect(await listedIds(http)).toContain(scheduledId)
+    expect(await searchIds(http.actingAs(other), `scheduled-${run}`)).toContain(scheduledId)
+
+    // Editing can push it back out of view…
+    await authorClient
+      .put(`/posts/${scheduledId}`, {
+        title: `Scheduled launch ${run}`,
+        excerpt: `scheduled-${run}`,
+        body: 'Not yet.',
+        publishAt: FUTURE,
+      })
+      .assertStatus(303)
+    await http.get(`/posts/${scheduledId}`).assertStatus(404)
+
+    // …and clearing the date publishes it now.
+    await authorClient
+      .put(`/posts/${scheduledId}`, {
+        title: `Scheduled launch ${run}`,
+        excerpt: `scheduled-${run}`,
+        body: 'Not yet.',
+        publishAt: null,
+      })
+      .assertStatus(303)
+    expect((await Post.findOrFail(scheduledId)).publishedAt).toBeNull()
+    await http.get(`/posts/${scheduledId}`).assertOk()
+  })
+})
