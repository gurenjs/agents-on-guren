@@ -0,0 +1,37 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { ApiCreatePostSchema } from '../../Validators/ApiValidator.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({
+      data: PostResource.collection(posts),
+    })
+  }
+
+  async store(): Promise<Response> {
+    const apiToken = this.ctx.get('apiToken')
+    if (!apiToken) {
+      return this.json({ message: 'Unauthorized' }, { status: 401 })
+    }
+
+    const { title, excerpt, body } = await this.validateBody(ApiCreatePostSchema)
+
+    const post = await Post.forceCreate({
+      title,
+      excerpt,
+      body,
+      authorId: apiToken.userId,
+    })
+
+    return this.json({
+      data: new PostResource(post).toJSON(),
+    }, { status: 201 })
+  }
+}
