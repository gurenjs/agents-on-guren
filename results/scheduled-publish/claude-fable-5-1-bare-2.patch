diff --git a/tests/PostsScheduledCommand.test.ts b/tests/PostsScheduledCommand.test.ts
new file mode 100644
index 0000000..ba98357
--- /dev/null
+++ b/tests/PostsScheduledCommand.test.ts
@@ -0,0 +1,84 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Runs the real entry point in a child process, because the contract is about
+// the process: exactly one line per scheduled post on stdout, nothing else
+// there, exit 0. Both processes open the same test database file.
+async function runReport(): Promise<{ stdout: string; stderr: string; exitCode: number }> {
+  const child = Bun.spawn(['bun', 'bin/console.ts', 'posts:scheduled'], {
+    cwd: process.cwd(),
+    env: { ...process.env, NODE_ENV: 'test' },
+    stdout: 'pipe',
+    stderr: 'pipe',
+  })
+  const [stdout, stderr, exitCode] = await Promise.all([
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+    child.exited,
+  ])
+  return { stdout, stderr, exitCode }
+}
+
+let sequence = 0
+
+async function createPost(author: UserRecord, publishedAt: string | null): Promise<PostRecord> {
+  sequence += 1
+  const post = await Post.forceCreate({
+    title: `Report ${Date.now()}-${sequence}`,
+    excerpt: 'Excerpt',
+    body: 'Body',
+    authorId: author.id,
+    publishedAt,
+  })
+  if (!post) {
+    throw new Error('Post.forceCreate returned nothing')
+  }
+  return post
+}
+
+describe('posts:scheduled', () => {
+  let author: UserRecord
+
+  beforeAll(async () => {
+    // Boots (and so migrates) the shared test database before the child does.
+    await TestApp.fromApp(app)
+    author = await User.create({
+      name: 'ops',
+      email: `ops-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    // Scheduled rows left by other test files would show up in the report too.
+    for (const stale of await Post.scheduled().get()) {
+      await Post.delete({ id: stale.id })
+    }
+  })
+
+  it('prints scheduled posts soonest first as id, title and published_at, and nothing else', async () => {
+    await createPost(author, null)
+    await createPost(author, '2020-01-01T09:00:00.000Z')
+    const later = await createPost(author, '2036-03-01T09:00:00.000Z')
+    const sooner = await createPost(author, '2036-01-01T09:00:00.000Z')
+
+    const { stdout, exitCode } = await runReport()
+
+    expect(exitCode).toBe(0)
+    expect(stdout).toBe(
+      `${sooner.id}\t${sooner.title}\t2036-01-01T09:00:00.000Z\n` +
+        `${later.id}\t${later.title}\t2036-03-01T09:00:00.000Z\n`,
+    )
+
+    for (const post of [sooner, later]) {
+      await Post.delete({ id: post.id })
+    }
+  })
+
+  it('prints nothing when nothing is scheduled', async () => {
+    const { stdout, exitCode } = await runReport()
+
+    expect(exitCode).toBe(0)
+    expect(stdout).toBe('')
+  })
+})
