diff --git a/tests/AuthLocale.test.ts b/tests/AuthLocale.test.ts
new file mode 100644
index 0000000..61bcafc
--- /dev/null
+++ b/tests/AuthLocale.test.ts
@@ -0,0 +1,86 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The login and sign-up pages are the first thing a new user sees, so they
+// render in Japanese when the browser prefers it, and stay English
+// otherwise. The translated strings live in lang/en and lang/ja and reach
+// the page via the `_i18n` Inertia shared prop.
+describe('login/register locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  const asInertia = (headers: Record<string, string> = {}) =>
+    http.withHeaders({ 'X-Inertia': 'true', ...headers })
+
+  it('renders Japanese on /login for a Japanese browser', async () => {
+    await asInertia({ 'Accept-Language': 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7' })
+      .get('/login')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.heading', 'ログイン')
+      .assertJsonPath(
+        'props._i18n.messages.ja.auth.login.subtitle',
+        'アカウントの認証情報を入力して続行してください。',
+      )
+      .assertJsonPath('props._i18n.messages.ja.auth.login.email', 'メールアドレス')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.password', 'パスワード')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.remember', 'ログイン状態を保持する')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.submit', 'ログイン')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.footer_question', 'アカウントをお持ちでないですか？')
+      .assertJsonPath('props._i18n.messages.ja.auth.login.footer_link', 'アカウント登録')
+  })
+
+  it('renders Japanese on /register for a Japanese browser', async () => {
+    await asInertia({ 'Accept-Language': 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7' })
+      .get('/register')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.heading', 'アカウント登録')
+      .assertJsonPath(
+        'props._i18n.messages.ja.auth.register.subtitle',
+        'アカウントを作成して始めましょう。',
+      )
+      .assertJsonPath('props._i18n.messages.ja.auth.register.name', '名前')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.email', 'メールアドレス')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.password', 'パスワード')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.password_confirmation', 'パスワード（確認）')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.submit', '登録')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.footer_question', 'すでにアカウントをお持ちですか？')
+      .assertJsonPath('props._i18n.messages.ja.auth.register.footer_link', 'ログイン')
+  })
+
+  it.each([
+    ['no header', undefined],
+    ['plain English', 'en'],
+    ['English with region', 'en-US,en;q=0.9'],
+    ['English outranking Japanese', 'en-US,en;q=0.9,ja;q=0.5'],
+    ['an unsupported language', 'fr-FR,fr;q=0.9'],
+  ])('renders English on /login for %s', async (_label, acceptLanguage) => {
+    await asInertia(acceptLanguage ? { 'Accept-Language': acceptLanguage } : {})
+      .get('/login')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'en')
+      .assertJsonPath('props._i18n.messages.en.auth.login.heading', 'Sign in')
+      .assertJsonPath('props._i18n.messages.en.auth.login.footer_link', 'Sign up')
+  })
+
+  it('renders English on /register when Accept-Language is absent', async () => {
+    await asInertia()
+      .get('/register')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'en')
+      .assertJsonPath('props._i18n.messages.en.auth.register.heading', 'Create an account')
+      .assertJsonPath('props._i18n.messages.en.auth.register.footer_link', 'Sign in')
+  })
+
+  it('keeps the welcome message key translated in both catalogs', () => {
+    const en = require('../lang/en/messages.json')
+    const ja = require('../lang/ja/messages.json')
+    expect(en.welcome).toBe('Welcome to :name!')
+    expect(ja.welcome).toContain(':name')
+  })
+})
