@@ -0,0 +1,34 @@
+/**
+ * Where a sign-in lands when no usable `redirect` was supplied — the same
+ * destination routes/web.ts sends an already-authenticated guest to.
+ */
+export const DEFAULT_LOGIN_REDIRECT = '/dashboard'
+
+// Browsers drop tabs and newlines while parsing a URL and read a backslash as
+// a path separator, so "/\evil.example" and "/<TAB>/evil.example" both reach
+// another origin. Normalise the same way before judging the value, or the
+// check looks at a string the browser never sees.
+const IGNORED_BY_URL_PARSER = /[\t\n\r]/g
+const BACKSLASH = /\\/g
+
+/**
+ * Narrows an attacker-controlled `redirect` value to a path inside this app.
+ *
+ * Returns the path when it is a plain same-app path, and `null` for anything
+ * that could leave the origin — absolute URLs with a scheme, protocol-relative
+ * values starting with `//`, and their backslash/control-character variants.
+ */
+export function sameAppPath(value: unknown): string | null {
+  if (typeof value !== 'string') return null
+
+  const path = value.replace(IGNORED_BY_URL_PARSER, '').replace(BACKSLASH, '/')
+
+  // A same-app path is rooted at '/'. Anything else — 'https://evil.example',
+  // 'evil.example', '' — is not ours to follow.
+  if (!path.startsWith('/')) return null
+
+  // '//evil.example' keeps the current scheme but swaps the host.
+  if (path.startsWith('//')) return null
+
+  return path
+}
