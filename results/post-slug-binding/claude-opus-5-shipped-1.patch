diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..37faba5
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,24 @@
+const FALLBACK_SLUG = 'post'
+
+// Combining marks left behind by the NFKD decomposition below.
+const COMBINING_MARKS = /[\u0300-\u036f]/g
+
+/**
+ * Turns a title into a URL-safe slug: lowercase ASCII letters and digits,
+ * words joined by a single `-`, no leading or trailing `-`.
+ *
+ * Accented letters fold to their ASCII base (`Café` → `cafe`); anything that
+ * survives neither (emoji, CJK) is dropped, so a title made only of such
+ * characters falls back to `post` and is numbered by the uniqueness pass in
+ * `Post.uniqueSlugFor()`.
+ */
+export function slugify(title: string): string {
+  const slug = title
+    .normalize('NFKD')
+    .replace(COMBINING_MARKS, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+
+  return slug.length > 0 ? slug : FALLBACK_SLUG
+}
