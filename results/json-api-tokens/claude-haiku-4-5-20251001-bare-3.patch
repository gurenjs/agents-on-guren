diff --git a/app/Http/Controllers/ApiPostsController.ts b/app/Http/Controllers/ApiPostsController.ts
new file mode 100644
index 0000000..f6eb662
--- /dev/null
+++ b/app/Http/Controllers/ApiPostsController.ts
@@ -0,0 +1,105 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+import { RateLimitService } from '../../Services/RateLimitService.js'
+import { ApiPostPayloadSchema } from '../Validators/TokenValidator.js'
+
+export default class ApiPostsController extends Controller {
+  private async authenticateToken(): Promise<{ tokenId: number; userId: number } | null> {
+    const authHeader = this.request.header('authorization')
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      return null
+    }
+
+    const token = authHeader.slice(7)
+    const hash = TokenService.hash(token)
+
+    const apiToken = await ApiToken.where({ hash }).first()
+    if (!apiToken) {
+      return null
+    }
+
+    return { tokenId: apiToken.id, userId: apiToken.userId }
+  }
+
+  async index(): Promise<Response> {
+    const auth = await this.authenticateToken()
+    if (!auth) {
+      return new Response(JSON.stringify({ error: 'Unauthenticated' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+
+    const { allowed, retryAfter } = RateLimitService.checkLimit(auth.tokenId)
+    if (!allowed) {
+      return new Response(JSON.stringify({ error: 'Too many requests' }), {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(retryAfter),
+        },
+      })
+    }
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return new Response(JSON.stringify({
+      data: posts.map((post) => ({
+        id: post.id,
+        title: post.title,
+        excerpt: post.excerpt,
+        authorId: post.authorId,
+        createdAt: new Date(post.createdAt).toISOString(),
+      })),
+    }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    })
+  }
+
+  async store(): Promise<Response> {
+    const auth = await this.authenticateToken()
+    if (!auth) {
+      return new Response(JSON.stringify({ error: 'Unauthenticated' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+
+    const { allowed, retryAfter } = RateLimitService.checkLimit(auth.tokenId)
+    if (!allowed) {
+      return new Response(JSON.stringify({ error: 'Too many requests' }), {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': String(retryAfter),
+        },
+      })
+    }
+
+    const data = await this.validateBody(ApiPostPayloadSchema)
+
+    const post = await Post.forceCreate({
+      ...data,
+      authorId: auth.userId,
+    })
+
+    return new Response(JSON.stringify({
+      data: {
+        id: post.id,
+        title: post.title,
+        excerpt: post.excerpt,
+        authorId: post.authorId,
+        createdAt: new Date(post.createdAt).toISOString(),
+      },
+    }), {
+      status: 201,
+      headers: { 'Content-Type': 'application/json' },
+    })
+  }
+}
