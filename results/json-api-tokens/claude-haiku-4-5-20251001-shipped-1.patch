diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..28ea8d0
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,208 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import app from '../src/app.js'
+import { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { ApiToken, type ApiTokenRecord } from '../app/Models/ApiToken.js'
+import { resetDatabase } from '../config/database.js'
+import { createToken, hashToken } from '../app/Services/TokenService.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    user = (await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password',
+    })) as UserRecord
+  })
+
+  describe('POST /profile/tokens', () => {
+    test('creates token for authenticated user', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().post('/profile/tokens', {
+        name: 'Test Token',
+      })
+
+      expect(response.status).toBe(201)
+      const json = await response.json<{ id: number; name: string; token: string }>()
+      expect(json.id).toBeDefined()
+      expect(json.name).toBe('Test Token')
+      expect(json.token).toBeDefined()
+      expect(json.token).toMatch(/^[a-f0-9]{8}\|/)
+    })
+
+    test('rejects empty name', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().post('/profile/tokens', {
+        name: '',
+      })
+
+      expect(response.status).toBe(422)
+    })
+
+    test('rejects name over 50 characters', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().post('/profile/tokens', {
+        name: 'a'.repeat(51),
+      })
+
+      expect(response.status).toBe(422)
+    })
+
+    test('rejects unauthenticated request', async () => {
+      const response = await http.json().post('/profile/tokens', {
+        name: 'Test Token',
+      })
+
+      expect([403]).toContain(response.status)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    test('deletes own token', async () => {
+      const plainToken = createToken()
+      const tokenHash = await hashToken(plainToken)
+
+      const token = (await ApiToken.create({
+        userId: user.id,
+        name: 'Token to Delete',
+        tokenHash,
+      })) as ApiTokenRecord
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().delete(`/profile/tokens/${token.id}`)
+
+      expect(response.status).toBe(204)
+
+      const deleted = await ApiToken.find(token.id)
+      expect(deleted).toBeNull()
+    })
+
+    test('rejects delete of another user token', async () => {
+      const otherUser = (await User.create({
+        name: 'Other User',
+        email: 'other@example.com',
+        password: 'password',
+      })) as UserRecord
+
+      const plainToken = createToken()
+      const tokenHash = await hashToken(plainToken)
+
+      const token = (await ApiToken.create({
+        userId: otherUser.id,
+        name: 'Other Token',
+        tokenHash,
+      })) as ApiTokenRecord
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.json().delete(`/profile/tokens/${token.id}`)
+
+      expect(response.status).toBe(404)
+
+      const stillExists = await ApiToken.find(token.id)
+      expect(stillExists).toBeDefined()
+    })
+
+    test('rejects unauthenticated delete', async () => {
+      const response = await http.json().delete('/profile/tokens/1')
+      expect([403]).toContain(response.status)
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    test('returns posts with valid bearer token', async () => {
+      const plainToken = createToken()
+      const tokenHash = await hashToken(plainToken)
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'API Token',
+        tokenHash,
+      })
+
+      const response = await http
+        .withHeader('Authorization', `Bearer ${plainToken}`)
+        .json()
+        .get('/api/posts')
+
+      expect(response.status).toBe(200)
+      const json = await response.json<{ data: unknown[] }>()
+      expect(json.data).toBeInstanceOf(Array)
+    })
+
+    test('returns 401 without bearer token', async () => {
+      const response = await http.json().get('/api/posts')
+      expect(response.status).toBe(401)
+    })
+
+    test('returns 401 with invalid bearer token', async () => {
+      const response = await http
+        .withHeader('Authorization', 'Bearer invalid_token')
+        .json()
+        .get('/api/posts')
+
+      expect(response.status).toBe(401)
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    test('creates post with valid bearer token', async () => {
+      const plainToken = createToken()
+      const tokenHash = await hashToken(plainToken)
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'API Token 2',
+        tokenHash,
+      })
+
+      const response = await http
+        .withHeader('Authorization', `Bearer ${plainToken}`)
+        .json()
+        .post('/api/posts', {
+          title: 'Test Post',
+          excerpt: 'Test excerpt',
+          body: 'Test body',
+        })
+
+      expect(response.status as number).toBe(201)
+    })
+
+    test('rejects invalid post data', async () => {
+      const plainToken = createToken()
+      const tokenHash = await hashToken(plainToken)
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'API Token 3',
+        tokenHash,
+      })
+
+      const response = await http
+        .withHeader('Authorization', `Bearer ${plainToken}`)
+        .json()
+        .post('/api/posts', {
+          title: '',
+          excerpt: 'Test excerpt',
+          body: 'Test body',
+        })
+
+      expect(response.status as number).toBe(422)
+    })
+
+    test('returns 403 without bearer token (CSRF protection)', async () => {
+      const response = await http.json().post('/api/posts', {
+        title: 'Test Post',
+        excerpt: 'Test excerpt',
+        body: 'Test body',
+      })
+
+      expect(response.status).toBe(403)
+    })
+  })
+})
