@@ -0,0 +1,37 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('validates publishAt', () => {
+    const base = { title: 't', excerpt: 'e', body: 'b' }
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: 'next tuesday' }).success).toBe(false)
+    expect(PostPayloadSchema.parse(base).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '2026-10-01T09:00:00.000Z' }).publishAt).toBe(
+      '2026-10-01T09:00:00.000Z',
+    )
+  })
+
+  it('hides a future post from guests until its time has passed', async () => {
+    const post = await Post.forceCreate({
+      title: 'zzfuture-marker',
+      excerpt: 'x',
+      body: 'x',
+      authorId: 1,
+      publishedAt: new Date(Date.now() + 86_400_000).toISOString(),
+    })
+    await http.get(`/posts/${post?.id}`).assertStatus(404)
