diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..b3d4296
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,39 @@
+/**
+ * Excerpt derivation for posts saved without one.
+ *
+ * Writers usually paste the opening of the body into the excerpt field, so the
+ * site does it for them: keep the first 140 characters of the trimmed body
+ * without cutting a word in half, then mark the truncation with a single `…`.
+ */
+
+const EXCERPT_LIMIT = 140
+const ELLIPSIS = '…'
+
+/** Builds an excerpt from a post body. Never returns an empty string for a non-blank body. */
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LIMIT) {
+    return trimmed
+  }
+
+  let kept = trimmed.slice(0, EXCERPT_LIMIT)
+  // The cut only moves back when it would split a word — i.e. the characters on
+  // both sides of the boundary are non-whitespace. A boundary that already sits
+  // on whitespace keeps all 140 characters.
+  const splitsWord = !/\s/.test(trimmed.charAt(EXCERPT_LIMIT - 1)) && !/\s/.test(trimmed.charAt(EXCERPT_LIMIT))
+  if (splitsWord) {
+    // Index of the last whitespace run before the trailing partial word, or -1
+    // when the first 140 characters are one unbroken run (then the cut stands).
+    const lastBreak = kept.search(/\s\S*$/)
+    if (lastBreak !== -1) {
+      kept = kept.slice(0, lastBreak)
+    }
+  }
+
+  return `${kept.replace(/\s+$/, '')}${ELLIPSIS}`
+}
+
+/** A submitted excerpt always wins; a missing or blank one falls back to the body. */
+export function resolveExcerpt(payload: { excerpt?: string; body: string }): string {
+  return payload.excerpt && payload.excerpt.length > 0 ? payload.excerpt : deriveExcerpt(payload.body)
+}
