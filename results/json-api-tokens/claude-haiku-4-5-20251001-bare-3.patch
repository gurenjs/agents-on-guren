@@ -0,0 +1,104 @@
+import { Controller, ValidationException } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { ApiPostResource } from '../Resources/ApiPostResource.js'
+import { CreatePostApiSchema } from '../Validators/ApiTokenValidator.js'
+import { BearerTokenService } from '../../Services/BearerTokenService.js'
+import { RateLimiter } from '../../Services/RateLimiter.js'
+import { ApiTokenService } from '../../Services/ApiTokenService.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class ApiPostController extends Controller {
+  private async authenticateBearer(): Promise<{ user: UserRecord; tokenId: number } | Response> {
+    const authHeader = this.request.header('authorization') || ''
+    const match = authHeader.match(/^Bearer\s+(.+)$/)
+
+    if (!match) {
+      return this.json({ error: 'Unauthorized' }, { status: 401 })
+    }
+
+    const token = match[1]
+    const user = await BearerTokenService.authenticateFromBearerToken(token)
+
+    if (!user) {
+      return this.json({ error: 'Unauthorized' }, { status: 401 })
+    }
+
+    const tokenHash = ApiTokenService.hashToken(token)
+    const apiToken = await ApiToken.newQuery()
+      .where('userId', user.id)
+      .where('tokenHash', tokenHash)
+      .first()
+
+    if (!apiToken) {
+      return this.json({ error: 'Unauthorized' }, { status: 401 })
+    }
+
+    return { user, tokenId: apiToken.id }
+  }
+
+  private checkRateLimit(tokenId: number): Response | null {
+    const result = RateLimiter.checkLimit(`token_${tokenId}`)
+
+    if (!result.allowed) {
+      const response = this.json({ error: 'Too many requests' }, { status: 429 })
+      response.headers.set('Retry-After', String(result.retryAfter))
+      return response
+    }
+
+    return null
+  }
+
+  async index(): Promise<Response> {
+    const auth = await this.authenticateBearer()
+    if (auth instanceof Response) {
+      return auth
+    }
+
+    const rateLimitError = this.checkRateLimit(auth.tokenId)
+    if (rateLimitError) {
+      return rateLimitError
+    }
+
+    const posts = await Post.newQuery()
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({
+      data: posts.map((post) => new ApiPostResource(post).toJSON()),
+    })
+  }
+
+  async store(): Promise<Response> {
+    const auth = await this.authenticateBearer()
+    if (auth instanceof Response) {
+      return auth
+    }
+
+    const rateLimitError = this.checkRateLimit(auth.tokenId)
+    if (rateLimitError) {
+      return rateLimitError
+    }
+
+    try {
+      const { title, excerpt, body } = await this.validateBody(CreatePostApiSchema)
+
+      const post = await Post.forceCreate({
+        title,
+        excerpt,
+        body,
+        authorId: auth.user.id,
+      })
+
+      return this.json(
+        { data: new ApiPostResource(post).toJSON() },
+        { status: 201 }
+      )
+    } catch (error) {
+      if (error instanceof ValidationException) {
+        return this.json({ error: error.message }, { status: 422 })
+      }
+      throw error
+    }
+  }
+}
