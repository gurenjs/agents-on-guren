--- /dev/null
+++ b/app/Http/Validators/LocaleValidator.ts
@@ -0,0 +1,12 @@
+import { z } from 'zod'
+
+/** The locales `createApp({ i18n })` in src/app.ts detects; keep the two in step. */
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number]
+
+export const LocaleSchema = z.object({
+  locale: z.enum(SUPPORTED_LOCALES, { error: 'Locale must be one of: en, ja.' }),
+})
+
+export type LocalePayload = z.infer<typeof LocaleSchema>
