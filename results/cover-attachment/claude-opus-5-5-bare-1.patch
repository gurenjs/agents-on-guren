+))
+const JPEG = Uint8Array.from(Buffer.from(
+  '/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAAgGBgcGBQgHBwcJCQgKDBQNDAsLDBkSEw8UHRofHh0aHBwgJC4nICIsIxwcKDcpLDAxNDQ0Hyc5PTgyPC4zNDL/wAALCAABAAEBAREA/8QAFAABAAAAAAAAAAAAAAAAAAAACf/EABQQAQAAAAAAAAAAAAAAAAAAAAD/2gAIAQEAAD8AKp//2Q==',
+  'base64',
+))
+const GIF = Uint8Array.from(Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', 'base64'))
+
+function postForm(fields: Record<string, string>, cover?: File): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries({ title: 'A post', excerpt: 'An excerpt', body: 'A body', ...fields })) {
+    form.append(key, value)
+  }
+  if (cover) form.append('cover', cover)
+  return form
+}
+
+async function listFiles(dir: string): Promise<string[]> {
+  const entries = await readdir(dir, { recursive: true, withFileTypes: true }).catch(() => [])
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+async function storedCopies(bytes: Uint8Array, dir: string): Promise<number> {
+  let count = 0
+  for (const file of await listFiles(dir)) {
+    if (Buffer.from(await readFile(file)).equals(Buffer.from(bytes))) count++
+  }
+  return count
+}
+
+async function countRows(model: typeof Post | typeof Attachment): Promise<number> {
+  return model.newQuery().count()
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: TestApp
+
+  async function pageProps(path: string): Promise<Record<string, any>> {
+    const response = await author.withHeaders({ 'X-Inertia': 'true' }).get(path).assertOk()
+    return (await readInertiaResponse(response.raw)).payload.props as Record<string, any>
+  }
+
+  async function createPost(cover?: File): Promise<number> {
+    const response = await author.post('/posts', postForm({}, cover))
+    expect(response.status).toBeGreaterThanOrEqual(300)
+    expect(response.status).toBeLessThan(400)
+    const id = Number(response.headers.get('location')?.match(/\/posts\/(\d+)/)?.[1])
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  async function coverUrl(id: number): Promise<string | null> {
+    return (await pageProps(`/posts/${id}`)).post.coverUrl
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf('/')
+    const user = (await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+    author = http.actingAs(user)
+  })
+
+  it('creates a post without a cover as before', async () => {
+    const id = await createPost()
+    expect(await coverUrl(id)).toBeNull()
+  })
+
+  it('stores, lists and serves an uploaded PNG cover byte for byte', async () => {
+    const id = await createPost(new File([PNG], 'cover.png', { type: 'image/png' }))
+    const url = await coverUrl(id)
+    expect(url).toBeString()
+
+    const listed = (await pageProps('/posts')).data.find((post: { id: number }) => post.id === id)
+    expect(listed.coverUrl).toBeString()
+
+    const served = await http.get(url!).assertOk()
+    expect(served.headers.get('content-type')).toStartWith('image/png')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(Buffer.from(PNG))).toBe(true)
+
+    expect(await storedCopies(PNG, 'storage')).toBeGreaterThan(0)
+    expect(await storedCopies(PNG, 'public')).toBe(0)
+  })
+
+  it('refuses a GIF or an oversized file the way it refuses an empty title', async () => {
+    const emptyTitle = await author.json().post('/posts', postForm({ title: '' }))
+    const postsBefore = await countRows(Post)
+    const attachmentsBefore = await countRows(Attachment)
+
+    const gif = await author.json().post('/posts', postForm({}, new File([GIF], 'cover.gif', { type: 'image/gif' })))
+    expect(gif.status).toBe(emptyTitle.status)
+    expect(await gif.json()).toMatchObject({ errors: { cover: [expect.any(String)] } })
+
+    // A GIF sent under a PNG name and type is still a GIF.
+    const disguised = await author.json().post('/posts', postForm({}, new File([GIF], 'cover.png', { type: 'image/png' })))
+    expect(disguised.status).toBe(emptyTitle.status)
+    expect(await disguised.json()).toMatchObject({ errors: { cover: [expect.any(String)] } })
+
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    const oversized = await author.json().post('/posts', postForm({}, new File([big], 'big.png', { type: 'image/png' })))
+    expect(oversized.status).toBe(emptyTitle.status)
+    expect(await oversized.json()).toMatchObject({ errors: { cover: [expect.any(String)] } })
+
+    expect(await countRows(Post)).toBe(postsBefore)
+    expect(await countRows(Attachment)).toBe(attachmentsBefore)
+  })
+
+  it('replaces, keeps and removes the cover on edit', async () => {
+    const id = await createPost(new File([PNG], 'cover.png', { type: 'image/png' }))
+    const first = (await coverUrl(id))!
+
+    const refused = await author.json().put(`/posts/${id}`, postForm({}, new File([GIF], 'c.gif', { type: 'image/gif' })))
+    expect(refused.status).toBe(422)
+    await http.get(first).assertOk()
+
+    await author.put(`/posts/${id}`, postForm({}, new File([JPEG], 'cover.jpg', { type: 'image/jpeg' })))
+    const second = (await coverUrl(id))!
+    await http.get(first).assertNotFound()
+    const served = await http.get(second).assertOk()
+    expect(served.headers.get('content-type')).toStartWith('image/jpeg')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(Buffer.from(JPEG))).toBe(true)
+
+    const rowsFor = () => Attachment.where({ attachableId: String(id) }).count()
+    expect(await rowsFor()).toBe(1)
+
+    await author.put(`/posts/${id}`, postForm({ title: 'Renamed' }))
+    expect(await coverUrl(id)).toBeString()
+    expect(await rowsFor()).toBe(1)
+
+    await author.put(`/posts/${id}`, postForm({ removeCover: '1' }))
+    expect(await coverUrl(id)).toBeNull()
+    await http.get(second).assertNotFound()
+    expect(await rowsFor()).toBe(0)
+  })
+
+  it('deletes the cover with its post', async () => {
+    const id = await createPost(new File([JPEG], 'cover.jpg', { type: 'image/jpeg' }))
+    const url = (await coverUrl(id))!
+
+    await author.delete(`/posts/${id}`)
+    await http.get(url).assertNotFound()
+    expect(await Attachment.where({ attachableId: String(id) }).count()).toBe(0)
+  })
+})
