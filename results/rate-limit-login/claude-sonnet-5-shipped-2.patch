+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import { loginThrottleStore } from '../app/Http/Middleware/LoginThrottleMiddleware.js'
+
+describe('login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    const base = await TestApp.fromApp(app)
+    http = await base.withCsrf()
+    await User.create({ name: 'Jane', email: 'jane@example.com', password: 'correct-password' })
+  })
+
+  beforeEach(() => {
+    loginThrottleStore.clear()
+  })
+
+  it('refuses wrong credentials the normal way within the limit', async () => {
+    await http
+      .json()
+      .post('/login', { email: 'jane@example.com', password: 'wrong' })
+      .assertUnprocessable()
+  })
+
+  it('rejects the 6th submission in a minute with 429 and Retry-After', async () => {
+    for (let i = 0; i < 5; i++) {
+      await http.json().post('/login', { email: 'jane@example.com', password: 'wrong' })
+    }
+
+    const res = await http.json().post('/login', { email: 'jane@example.com', password: 'wrong' })
+    res.assertStatus(429)
+    expect(res.headers.get('Retry-After')).toBeTruthy()
+  })
+
+  it('throttles a correct password too once the limit is spent', async () => {
+    for (let i = 0; i < 5; i++) {
+      await http.json().post('/login', { email: 'jane@example.com', password: 'wrong' })
+    }
+
+    await http
+      .json()
+      .post('/login', { email: 'jane@example.com', password: 'correct-password' })
+      .assertStatus(429)
+  })
+
+  it('still serves GET /login while throttled', async () => {
+    for (let i = 0; i < 6; i++) {
+      await http.json().post('/login', { email: 'jane@example.com', password: 'wrong' })
+    }
+
+    await http.get('/login').assertOk()
+  })
+
+  it('allows a correct login through within the limit', async () => {
+    await http
+      .json()
+      .post('/login', { email: 'jane@example.com', password: 'correct-password' })
+      .assertRedirect('/dashboard')
+  })
+})
