+      }
+    })
+  }
+
+  /** Not yet public, soonest first — the ops calendar. */
+  static scheduled(now: Date = new Date()) {
+    return Post.newQuery().where('publishedAt', '>', now.toISOString()).orderBy('publishedAt', 'asc')
