diff --git a/tests/PostDrafts.test.ts b/tests/PostDrafts.test.ts
new file mode 100644
index 0000000..84aa5db
--- /dev/null
+++ b/tests/PostDrafts.test.ts
@@ -0,0 +1,162 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// Exercises the draft/published visibility rules end to end against the real
+// database (SQLite auto-applies pending migrations on first query, so no
+// manual migration step is needed here). Fixtures are created directly
+// through the models and torn down in afterAll to keep the shared test
+// database clean between runs.
+describe('post drafts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+  let draft: { id: number }
+  let publishedPost: { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    const stamp = Date.now()
+    author = await User.forceCreate({
+      name: 'Draft Author',
+      email: `draft-author-${stamp}@example.com`,
+      password: 'secretpass',
+    })
+    other = await User.forceCreate({
+      name: 'Second Reader',
+      email: `second-reader-${stamp}@example.com`,
+      password: 'secretpass',
+    })
+
+    draft = await Post.forceCreate({
+      title: 'Zephyrine unfinished notes',
+      excerpt: 'Zephyrine excerpt not yet ready',
+      body: 'Draft body',
+      authorId: author.id,
+      published: false,
+    })
+    publishedPost = await Post.forceCreate({
+      title: 'Announcing the launch',
+      excerpt: 'Launch excerpt',
+      body: 'Published body',
+      authorId: author.id,
+      published: true,
+    })
+  })
+
+  afterAll(async () => {
+    await Post.delete({ id: draft.id })
+    await Post.delete({ id: publishedPost.id })
+    await User.delete({ id: author.id })
+    await User.delete({ id: other.id })
+  })
+
+  it('hides a draft from guests in the post list while keeping the published post', async () => {
+    const response = await http.json().get('/posts')
+    const body = await response.json<{ props: { data: Array<{ id: number }> } }>()
+    const ids = body.props.data.map((post) => post.id)
+    expect(ids).not.toContain(draft.id)
+    expect(ids).toContain(publishedPost.id)
+  })
+
+  it('hides a draft from a signed-in non-author in the post list', async () => {
+    const response = await http.actingAs(other).json().get('/posts')
+    const body = await response.json<{ props: { data: Array<{ id: number }> } }>()
+    expect(body.props.data.map((post) => post.id)).not.toContain(draft.id)
+  })
+
+  it('excludes a draft from keyword search even when the keyword matches', async () => {
+    const response = await http.query('/posts/search', { keywords: ['Zephyrine'] })
+    const body = await response.json<{ data: Array<{ id: number }> }>()
+    expect(body.data.map((post) => post.id)).not.toContain(draft.id)
+  })
+
+  it('finds a published post by keyword search', async () => {
+    const response = await http.query('/posts/search', { keywords: ['Announcing'] })
+    const body = await response.json<{ data: Array<{ id: number }> }>()
+    expect(body.data.map((post) => post.id)).toContain(publishedPost.id)
+  })
+
+  it('answers 404 for a guest opening a draft directly', async () => {
+    await http.get(`/posts/${draft.id}`).assertNotFound()
+  })
+
+  it('answers 404 for a signed-in non-author opening a draft directly', async () => {
+    await http.actingAs(other).get(`/posts/${draft.id}`).assertNotFound()
+  })
+
+  it('opens for the author, with published: false in the post data', async () => {
+    const response = await http.actingAs(author).json().get(`/posts/${draft.id}`)
+    expect(response.status).toBe(200)
+    const body = await response.json<{ props: { post: { published: boolean } } }>()
+    expect(body.props.post.published).toBe(false)
+  })
+
+  it('lets the author open the edit form for their own draft', async () => {
+    await http.actingAs(author).get(`/posts/${draft.id}/edit`).assertOk()
+  })
+
+  it('defaults a newly created post to draft when published is omitted', async () => {
+    const authed = await http.actingAs(author).withCsrf()
+    const response = await authed.post('/posts', {
+      title: 'No published field on create',
+      excerpt: 'Should default to a draft',
+      body: 'Body text',
+    })
+    response.assertRedirect()
+    const id = Number(response.headers.get('location')?.split('/').pop())
+
+    try {
+      const created = await Post.findOrFail(id)
+      expect(created.published).toBe(false)
+    } finally {
+      await Post.delete({ id })
+    }
+  })
+
+  it('publishes immediately when the create form sends published: true', async () => {
+    const authed = await http.actingAs(author).withCsrf()
+    const response = await authed.post('/posts', {
+      title: 'Published right away',
+      excerpt: 'Visible to guests immediately',
+      body: 'Body text',
+      published: true,
+    })
+    response.assertRedirect()
+    const id = Number(response.headers.get('location')?.split('/').pop())
+
+    try {
+      await http.get(`/posts/${id}`).assertOk()
+    } finally {
+      await Post.delete({ id })
+    }
+  })
+
+  it('lets the author publish a draft and take it back to draft via the edit form', async () => {
+    const toggle = await Post.forceCreate({
+      title: 'Toggle post',
+      excerpt: 'Starts as a draft',
+      body: 'Body text',
+      authorId: author.id,
+      published: false,
+    })
+    const authed = await http.actingAs(author).withCsrf()
+
+    try {
+      await authed
+        .put(`/posts/${toggle.id}`, { title: toggle.title, excerpt: toggle.excerpt, body: toggle.body, published: true })
+        .assertRedirect()
+      await http.get(`/posts/${toggle.id}`).assertOk()
+
+      await authed
+        .put(`/posts/${toggle.id}`, { title: toggle.title, excerpt: toggle.excerpt, body: toggle.body, published: false })
+        .assertRedirect()
+      await http.get(`/posts/${toggle.id}`).assertNotFound()
+    } finally {
+      await Post.delete({ id: toggle.id })
+    }
+  })
+})
