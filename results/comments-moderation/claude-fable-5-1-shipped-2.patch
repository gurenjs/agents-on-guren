@@ -0,0 +1,257 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ShownComment {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+  let postId: number
+
+  function makeUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name.toLowerCase()}@example.com`, password: 'secret-password' })
+  }
+
+  async function makeComment(userId: number, body: string, createdAt?: string): Promise<number> {
+    const comment = await Comment.forceCreate({ postId, userId, body, ...(createdAt ? { createdAt } : {}) })
+    return comment.id
+  }
+
+  // Mutating requests need the CSRF token of the session that sends them.
+  function as(user: UserRecord): Promise<TestApp> {
+    return http.actingAs(user).withCsrf()
+  }
+
+  async function shownComments(client: TestApp = http): Promise<ShownComment[]> {
+    const response = await client.withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+    response.assertOk()
+    const page = await response.json<{ component: string; props: { comments: ShownComment[] } }>()
+    expect(page.component).toBe('posts/Show')
+    return page.props.comments
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await makeUser('Owner')
+    reader = await makeUser('Reader')
+    stranger = await makeUser('Stranger')
+    const post = await Post.forceCreate({ title: 'A post', excerpt: 'Short', body: 'Long', authorId: owner.id })
+    postId = post.id
+  })
+
+  describe('POST /posts/:id/comments', () => {
+    it('sends a guest to the login page and stores nothing', async () => {
+      const guest = await http.withCsrf()
+
+      await guest.post(`/posts/${postId}/comments`, { body: 'Hello' }).assertRedirect('/login')
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('stores the comment under the signed-in user and returns to the post', async () => {
+      const client = await as(reader)
+
+      await client.post(`/posts/${postId}/comments`, { body: 'Nice post' }).assertRedirect(`/posts/${postId}`)
+
+      const stored = await Comment.all()
