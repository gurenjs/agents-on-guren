diff --git a/app/Models/PostTag.ts b/app/Models/PostTag.ts
new file mode 100644
index 0000000..645bce9
--- /dev/null
+++ b/app/Models/PostTag.ts
@@ -0,0 +1,18 @@
+import { defineModel } from '@guren/core'
+import { postTags } from '../../db/schema.js'
+
+export type PostTagRecord = typeof postTags.$inferSelect
+
+/** Pivot between posts and tags: one row per tag attached to a post. */
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {
+  /**
+   * Ids of the posts carrying a tag, as a subquery for `where('id', 'in', ...)`,
+   * so a popular tag cannot outgrow the driver's bound-parameter limit.
+   * Not async on purpose: the query is thenable, and awaiting it would run it.
+   */
+  static postIdsCarrying(tagId: number) {
+    return PostTag.newQuery().where({ tagId }).select('postId').toDrizzle()
+  }
+}
diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..aa4dba0
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,30 @@
+import { defineModel, type TransactionHandle } from '@guren/core'
+import { tags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {
+  /**
+   * The tags carrying `names`, creating the ones not seen before. Takes a
+   * transaction because `tags.name` is unique: the read and the inserts must
+   * not interleave with another request saving the same new name.
+   */
+  static async findOrCreateMany(names: readonly string[], trx: TransactionHandle): Promise<TagRecord[]> {
+    if (names.length === 0) {
+      return []
+    }
+
+    const existing = await Tag.newQuery({ trx }).whereIn('name', names).get()
+    const known = new Set(existing.map((tag) => tag.name))
+    const created: TagRecord[] = []
+    for (const name of names) {
+      if (!known.has(name)) {
+        created.push(await Tag.create({ name }, { trx }))
+      }
+    }
+
+    return [...existing, ...created]
+  }
+}
