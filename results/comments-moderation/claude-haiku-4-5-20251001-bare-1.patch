diff --git a/app/Http/Controllers/CommentController.ts b/app/Http/Controllers/CommentController.ts
new file mode 100644
index 0000000..def35ea
--- /dev/null
+++ b/app/Http/Controllers/CommentController.ts
@@ -0,0 +1,54 @@
+import { Controller } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+import { CommentReport } from '../../Models/CommentReport.js'
+import { Post } from '../../Models/Post.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CommentIdParamSchema, PostIdParamSchema } from '../Validators/CommentValidator.js'
+
+export default class CommentController extends Controller {
+  async store(): Promise<Response> {
+    const { id: postId } = this.validateParams(PostIdParamSchema)
+    const user = await this.auth.userOrFail<UserRecord>()
+
+    const post = await Post.findOrFail(postId)
+    const { body: data } = this.validated('comments.store')
+
+    await Comment.forceCreate({ ...data, postId, userId: user.id })
+
+    return this.redirect(`/posts/${postId}`)
+  }
+
+  async destroy(): Promise<Response> {
+    const { id: commentId } = this.validateParams(CommentIdParamSchema)
+    const user = await this.auth.userOrFail<UserRecord>()
+
+    const comment = await Comment.findOrFail(commentId)
+    const post = await Post.findOrFail(comment.postId)
+
+    await this.authorize('delete', [Comment, comment, post])
+
+    await Comment.delete({ id: commentId })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+
+  async report(): Promise<Response> {
+    const { id: commentId } = this.validateParams(CommentIdParamSchema)
+    const user = await this.auth.userOrFail<UserRecord>()
+
+    await this.authorize('report', Comment)
+
+    const comment = await Comment.findOrFail(commentId)
+
+    try {
+      await CommentReport.forceCreate({
+        commentId,
+        userId: user.id,
+      })
+    } catch {
+      // If the report already exists (unique constraint), ignore it
+    }
+
+    return new Response(null, { status: 204 })
+  }
+}
