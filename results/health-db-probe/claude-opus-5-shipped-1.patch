diff --git a/app/Http/Controllers/HealthController.ts b/app/Http/Controllers/HealthController.ts
new file mode 100644
index 0000000..74e9cc7
--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,28 @@
+import { Controller } from '@guren/core'
+import { healthManager } from '../../../config/health.js'
+
+export default class HealthController extends Controller {
+  /**
+   * Load balancers and uptime monitors route on the status code alone: 200
+   * while every check passes, 503 as soon as one fails. Each check catches its
+   * own errors, so a dead database is reported as unhealthy rather than
+   * escaping as a 500. The JSON body is what the ops dashboard reads.
+   */
+  async index(): Promise<Response> {
+    const report = await healthManager().check()
+
+    return this.json(
+      {
+        status: report.status,
+        timestamp: report.timestamp.toISOString(),
+        checks: report.checks.map((check) => ({
+          name: check.name,
+          status: check.status,
+          message: check.message,
+          durationMs: check.duration,
+        })),
+      },
+      { status: report.status === 'healthy' ? 200 : 503 },
+    )
+  }
+}
diff --git a/config/health.ts b/config/health.ts
