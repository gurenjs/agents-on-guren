+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+const future = () => new Date(Date.now() + 86_400_000).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+  const tag = `sched-${Date.now()}`
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const make = (name: string) =>
+      User.forceCreate({ name, email: `${tag}-${name}@example.com`, password: 'secret-pass-123' }) as Promise<{ id: number }>
+    author = await make('author')
+    other = await make('other')
+  })
+
+  async function searchIds(user?: { id: number }) {
+    const client = user ? http.actingAs(user as never) : http
