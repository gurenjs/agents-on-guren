--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,20 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module ships to other products as is, so the host app must
+// stay ignorant of it: only src/app.ts may register it. The zero-config
+// modules/ boundary exempts a module's index.ts and db/schema.ts, so this
+// rule closes that gap for app/ and routes/. Checked by `guren check --arch`.
+export default defineArchRules({
+  layers: {
+    host: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'host',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'app/ and routes/ must not depend on modules/newsletter; register it from src/app.ts only.',
+    },
+  ],
+})
