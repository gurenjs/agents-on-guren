diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..24ee28c
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,169 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+
+// The test database persists between runs, so every name this file writes
+// carries a per-run suffix and never collides with an earlier run's rows.
+const run = `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`
+const tagName = (name: string) => `${name}-${run}`
+
+interface PostProps {
+  id: number
+  title: string
+  tags: string[]
+}
+
+async function postIdFrom(response: { headers: Headers }): Promise<number> {
+  const location = response.headers.get('location') ?? ''
+  const match = /\/posts\/(\d+)$/.exec(location)
+  if (!match) {
+    throw new Error(`Expected a redirect to the post page, got ${location || '(no Location header)'}`)
+  }
+  return Number(match[1])
+}
+
+async function tagRows(postId: number): Promise<string[]> {
+  const pivot = await PostTag.where({ postId })
+  const tags = pivot.length > 0 ? await Tag.whereIn('id', pivot.map((row) => row.tagId)) : []
+  return tags.map((tag) => tag.name).sort()
+}
+
+describe('parseTagNames', () => {
+  it('trims, drops empties and collapses duplicates, case-sensitively', () => {
+    expect(parseTagNames(' bun ,bun')).toEqual(['bun'])
+    expect(parseTagNames('a,,b, ')).toEqual(['a', 'b'])
+    expect(parseTagNames('Bun, bun')).toEqual(['Bun', 'bun'])
+    expect(parseTagNames(undefined)).toEqual([])
+    expect(parseTagNames('')).toEqual([])
+    expect(parseTagNames(['bun', 'webdev, bun'])).toEqual(['bun', 'webdev'])
+  })
+})
+
+describe('post tags', () => {
+  let guest: TestApp
+  let author: TestApp
+  let user: UserRecord
+  let refusedStatus: number
+  const payload = { title: `Tagged ${run}`, excerpt: 'An excerpt.', body: 'A body.' }
+
+  beforeAll(async () => {
+    guest = await TestApp.fromApp(app)
+    user = await User.create({ name: 'Tag Author', email: `tags-${run}@example.com`, password: 'secret' })
+    author = await guest.actingAs(user).withCsrf('/posts')
+
+    // Whatever an empty title gets today is what a bad tags field must get.
+    const refused = await author.post('/posts', { ...payload, title: '' })
+    refusedStatus = refused.status
+  })
+
+  it('creates a post with tags and shows them sorted on the post page', async () => {
+    const response = await author.post('/posts', { ...payload, tags: `${tagName('webdev')}, ${tagName('bun')}` })
+    const id = await postIdFrom(response)
+
+    expect(await tagRows(id)).toEqual([tagName('bun'), tagName('webdev')])
+
+    const show = await author.get(`/posts/${id}`).assertOk()
+    const { payload: page } = await readInertiaResponse(show.raw)
+    expect((page.props.post as PostProps).tags).toEqual([tagName('bun'), tagName('webdev')])
+
+    const edit = await author.get(`/posts/${id}/edit`).assertOk()
+    const { payload: editPage } = await readInertiaResponse(edit.raw)
+    expect((editPage.props.post as PostProps).tags).toEqual([tagName('bun'), tagName('webdev')])
+  })
+
+  it('editing attaches new names and detaches removed ones', async () => {
+    const created = await author.post('/posts', { ...payload, tags: `${tagName('bun')}, ${tagName('webdev')}` })
+    const id = await postIdFrom(created)
+
+    await author.put(`/posts/${id}`, { ...payload, tags: `${tagName('bun')}, ${tagName('edited')}` }).assertRedirect(`/posts/${id}`)
+    expect(await tagRows(id)).toEqual([tagName('bun'), tagName('edited')])
+
+    // A detached tag may stay in `tags`; it is only gone from `post_tags`.
+    expect(await Tag.where({ name: tagName('webdev') })).toHaveLength(1)
+
+    await author.put(`/posts/${id}`, { ...payload }).assertRedirect(`/posts/${id}`)
+    expect(await tagRows(id)).toEqual([])
+  })
+
+  it('lists only the posts carrying the filtered tag, newest first, and every post carries tags', async () => {
+    const only = tagName('only')
+    const first = await postIdFrom(await author.post('/posts', { ...payload, tags: only }))
+    const untagged = await postIdFrom(await author.post('/posts', { ...payload }))
+    const second = await postIdFrom(await author.post('/posts', { ...payload, tags: `${only}, ${tagName('other')}` }))
+
+    const filtered = await guest.get(`/posts?tag=${encodeURIComponent(only)}`).assertOk()
+    const { payload: page } = await readInertiaResponse(filtered.raw)
+    const data = page.props.data as PostProps[]
+    expect(data.map((post) => post.id)).toEqual([second, first])
+    expect(data.every((post) => post.tags.includes(only))).toBe(true)
+
+    const links = (page.props.pagination as { links: { first?: string | null; pages?: Array<{ url: string | null }> } }).links
+    const firstLink = links.first ?? links.pages?.[0]?.url ?? ''
+    expect(firstLink).toContain(`tag=${encodeURIComponent(only)}`)
+
+    const unused = await guest.get(`/posts?tag=${encodeURIComponent(tagName('nobody'))}`).assertOk()
+    const { payload: emptyPage } = await readInertiaResponse(unused.raw)
+    expect(emptyPage.props.data).toEqual([])
+
+    const all = await guest.get('/posts').assertOk()
+    const { payload: allPage } = await readInertiaResponse(all.raw)
+    const listed = allPage.props.data as PostProps[]
+    expect(listed.find((post) => post.id === untagged)?.tags).toEqual([])
+    expect(listed.find((post) => post.id === second)?.tags).toEqual([only, tagName('other')])
+  })
+
+  it('refuses six tags the way an empty title is refused, writing nothing', async () => {
+    const title = `Six tags ${run}`
+    const tags = ['a', 'b', 'c', 'd', 'e', 'f'].map(tagName).join(', ')
+    const before = await PostTag.newQuery().count()
+
+    const response = await author.post('/posts', { ...payload, title, tags })
+    expect(response.status).toBe(refusedStatus)
+
+    expect(await Post.where({ title })).toHaveLength(0)
+    expect(await Tag.where({ name: tagName('a') })).toHaveLength(0)
+    expect(await PostTag.newQuery().count()).toBe(before)
+
+    const json = await author.json().post('/posts', { ...payload, title, tags })
+    const body = await json.json<{ errors?: Record<string, unknown> }>()
+    expect(body.errors?.tags).toBeDefined()
+  })
+
+  it('refuses a 31-character name and saves a 30-character one', async () => {
+    const thirty = `t${run}`.padEnd(30, 'x')
+    const thirtyOne = `${thirty}y`
+    expect(thirty).toHaveLength(30)
+
+    const refused = await author.post('/posts', { ...payload, title: `Long tag ${run}`, tags: thirtyOne })
+    expect(refused.status).toBe(refusedStatus)
+    expect(await Post.where({ title: `Long tag ${run}` })).toHaveLength(0)
+    expect(await Tag.where({ name: thirtyOne })).toHaveLength(0)
+
+    const id = await postIdFrom(await author.post('/posts', { ...payload, tags: thirtyOne.slice(0, 30) }))
+    expect(await tagRows(id)).toEqual([thirty])
+  })
+
+  it('collapses " bun ,bun" into one tag attached once', async () => {
+    const bun = tagName('dup')
+    const id = await postIdFrom(await author.post('/posts', { ...payload, tags: ` ${bun} ,${bun}` }))
+
+    expect(await Tag.where({ name: bun })).toHaveLength(1)
+    expect(await PostTag.where({ postId: id })).toHaveLength(1)
+    expect(await tagRows(id)).toEqual([bun])
+  })
+
+  it('deletes a tagged post together with its pivot rows', async () => {
+    const id = await postIdFrom(await author.post('/posts', { ...payload, tags: tagName('gone') }))
+    expect(await PostTag.where({ postId: id })).toHaveLength(1)
+
+    await author.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    expect(await Post.where({ id })).toHaveLength(0)
+    expect(await PostTag.where({ postId: id })).toHaveLength(0)
+  })
+})
