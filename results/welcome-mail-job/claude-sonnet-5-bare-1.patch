@@ -0,0 +1,22 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeMailData {
+  name: string
+}
+
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const appName = process.env.APP_NAME ?? 'Guren'
+
+    return this
+      .subject(`Welcome to ${appName}, ${this.data.name}!`)
+      .text(`Hi ${this.data.name},\n\nWelcome to ${appName}! We're glad to have you with us.\n`)
+  }
+}
