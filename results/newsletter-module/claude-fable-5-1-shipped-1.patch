+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../../src/app.js'
+import { resetDatabase } from '../../../../config/database.js'
+import { NewsletterSubscription } from '../../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+describe('SubscriptionController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function guest(): Promise<TestApp> {
+    return (await http.withCsrf()).json().withHeader('Referer', REFERER)
+  }
+
+  async function subscribe(email: string) {
+    const client = await guest()
+    await client.post('/newsletter/subscribe', { email }).assertRedirect()
+    return NewsletterSubscription.where({ email }).firstOrFail()
+  }
+
+  describe('subscribe', () => {
+    it('stores a pending subscription and returns to the referring page', async () => {
+      const client = await guest()
+
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0].email).toBe('reader@example.com')
+      expect(rows[0].confirmedAt).toBeNull()
+      expect(rows[0].createdAt).toBeString()
+      expect(rows[0].token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token for every subscription', async () => {
+      const first = await subscribe('first@example.com')
+      const second = await subscribe('second@example.com')
+
+      expect(first.token).not.toBe(second.token)
+    })
+
+    it('redirects home when there is no referer', async () => {
+      const client = (await http.withCsrf()).json()
+
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('does not follow a referer on another origin', async () => {
+      const client = (await http.withCsrf()).json().withHeader('Referer', 'https://evil.example/phish')
+
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it.each(['', 'not-an-email'])('rejects the invalid address %p', async (email) => {
+      const client = await guest()
+
+      const response = await client.post('/newsletter/subscribe', { email }).assertUnprocessable()
+
+      const body = await response.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email.length).toBeGreaterThan(0)
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects a missing address', async () => {
+      const client = await guest()
+
+      await client.post('/newsletter/subscribe', {}).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const existing = await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+        .assertUnprocessable()
+        .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+
+    it('treats a different capitalisation as the same address', async () => {
+      await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/subscribe', { email: 'Reader@Example.com' }).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+
+    it('ignores a token sent with the request', async () => {
+      const client = await guest()
+
+      await client
+        .post('/newsletter/subscribe', { email: 'reader@example.com', token: 'chosen-by-the-visitor' })
+        .assertRedirect()
+
+      const row = await NewsletterSubscription.where({ email: 'reader@example.com' }).firstOrFail()
+      expect(row.token).not.toBe('chosen-by-the-visitor')
+    })
+
+    it('is refused without a CSRF token', async () => {
+      await http.json().post('/newsletter/subscribe', { email: 'reader@example.com' }).assertForbidden()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription and redirects home', async () => {
+      const pending = await subscribe('reader@example.com')
+      const other = await subscribe('other@example.com')
+
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.findOrFail(pending.id)
+      expect(confirmed.confirmedAt).toBeString()
+      expect(Number.isNaN(Date.parse(confirmed.confirmedAt ?? ''))).toBe(false)
+      expect((await NewsletterSubscription.findOrFail(other.id)).confirmedAt).toBeNull()
+    })
+
+    it('keeps the first confirmation time when the link is followed again', async () => {
+      const pending = await subscribe('reader@example.com')
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+      const confirmed = await NewsletterSubscription.findOrFail(pending.id)
+
+      await http.get(`/newsletter/confirm/${pending.token}`).assertRedirect('/')
+
+      expect(await NewsletterSubscription.findOrFail(pending.id)).toEqual(confirmed)
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      const pending = await subscribe('reader@example.com')
+
+      await http.get('/newsletter/confirm/never-issued-token').assertNotFound()
+
+      expect(await NewsletterSubscription.all()).toEqual([pending])
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes only that subscription and returns to the referring page', async () => {
+      await subscribe('reader@example.com')
+      const other = await subscribe('other@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      expect(await NewsletterSubscription.all()).toEqual([other])
+    })
+
+    it('redirects without changes for an address that is not subscribed', async () => {
+      const existing = await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'stranger@example.com' }).assertRedirect(REFERER)
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+
+    it('rejects an invalid address', async () => {
+      const existing = await subscribe('reader@example.com')
+      const client = await guest()
+
+      await client.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+  })
+})
