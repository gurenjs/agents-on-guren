--- /dev/null
+++ b/app/Http/SafeRedirect.ts
@@ -0,0 +1,39 @@
+/**
+ * Where a sign-in goes when no usable destination was asked for.
+ */
+export const DEFAULT_REDIRECT = '/dashboard'
+
+// Browsers strip tabs and newlines from a URL before resolving it, so
+// "/<TAB>/evil.example" would leave as "//evil.example" — remove them first
+// and judge the value a browser would actually follow.
+const STRIPPED_BY_BROWSERS = /[\t\n\r]/g
+
+// Anything left after the strip that a URL has no business carrying.
+const CONTROL_CHARACTERS = /[\u0000-\u001f\u007f]/
+
+/**
+ * Reduce a client-supplied redirect value to a path inside this app.
+ *
+ * Only a plain absolute path ("/posts/3/edit") survives. Absolute URLs with a
+ * scheme, protocol-relative values ("//evil.example") and the backslash
+ * variants browsers normalise into them ("/\evil.example") all point at
+ * another origin, so they are dropped in favour of `fallback` — otherwise a
+ * link to our own /login could hand a freshly signed-in user to a look-alike
+ * site.
+ */
+export function safeRedirectPath(value: unknown, fallback: string = DEFAULT_REDIRECT): string {
+  if (typeof value !== 'string') return fallback
+
+  const candidate = value.replace(STRIPPED_BY_BROWSERS, '').trim()
+
+  // Absolute URLs ("https://evil.example"), other schemes ("javascript:…")
+  // and relative paths that could escape the app never start with a slash.
+  if (!candidate.startsWith('/')) return fallback
+
+  // Protocol-relative, and the backslash spellings of it.
+  if (candidate.startsWith('//') || candidate.includes('\\')) return fallback
+
+  if (CONTROL_CHARACTERS.test(candidate)) return fallback
+
+  return candidate
+}
