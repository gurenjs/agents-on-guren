@@ -0,0 +1,68 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The home page is left out of these checks: it loads posts, and this starter
+// test suite runs without migrations. The login page renders without the
+// database and shares the same `_i18n` prop as every other page.
+async function sharedLocale(http: TestApp, headers: Record<string, string> = {}): Promise<unknown> {
+  const response = await http.withHeaders({ 'X-Inertia': 'true', ...headers }).get('/login')
+  const page = (await response.raw.json()) as { props: { _i18n: { locale: string } } }
+  return page.props._i18n.locale
+}
+
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  it('remembers the pick in a cookie and goes back to the referring page', async () => {
+    const response = await http
+      .withHeader('Referer', '/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/posts')
+    expect(response.raw.headers.get('Set-Cookie')).toContain('locale=ja')
+  })
+
+  it('goes to / without a Referer', async () => {
+    await http.post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('does not follow a Referer to another host', async () => {
+    await http
+      .withHeader('Referer', 'https://evil.example//elsewhere')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported locale', async () => {
+    const response = await http.json().post('/locale', { locale: 'fr' }).assertStatus(422)
+    expect(response.raw.headers.get('Set-Cookie') ?? '').not.toContain('locale=')
+  })
+
+  it('rejects a missing locale', async () => {
+    await http.json().post('/locale', {}).assertStatus(422)
+  })
+})
+
+describe('_i18n shared prop', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('defaults to English', async () => {
+    expect(await sharedLocale(http)).toBe('en')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    expect(await sharedLocale(http, { 'Accept-Language': 'ja-JP,ja;q=0.9,en;q=0.8' })).toBe('ja')
+  })
+
+  it('lets the remembered pick win over the browser', async () => {
+    expect(await sharedLocale(http, { 'Accept-Language': 'ja', Cookie: 'locale=en' })).toBe('en')
+  })
+})
