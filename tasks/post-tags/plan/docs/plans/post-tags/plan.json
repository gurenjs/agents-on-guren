        {
          "name": "excerpt",
          "type": "string",
          "required": true,
          "rules": [
            "trimmed",
            "min 1",
            "max 500"
          ]
        },
        {
          "name": "body",
          "type": "text",
          "required": true,
          "rules": [
            "trimmed",
            "min 1"
          ]
        },
        {
          "name": "tags",
          "type": "json",
          "required": false,
          "rules": [
            "a comma-separated string, parsed into a list of names",
            "each name trimmed; empty entries dropped; duplicates collapsed",
            "each name 1 to 30 characters",
            "at most 5 names"
          ]
        }
      ]
