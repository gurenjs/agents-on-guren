+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,114 @@
+import { describe, it, beforeEach, afterEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { fakeQueue, fakeMail } from '@guren/testing'
+import { setQueueDriver, registerJob } from '@guren/server/queue'
+import { setMailManager, createMailManager } from '@guren/server/mail'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+import { SendWelcomeEmailJob } from '../app/Jobs/SendWelcomeEmailJob.js'
+import { User } from '../app/Models/User.js'
+
+describe('RegisterController', () => {
+  let http: TestApp
+  let queue: ReturnType<typeof fakeQueue>
+  let mail: ReturnType<typeof fakeMail>
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    http = await TestApp.fromApp(app)
+
+    queue = fakeQueue()
+    mail = fakeMail()
+
+    setQueueDriver(queue.getDriver())
+    registerJob(SendWelcomeEmailJob)
+
+    const mailManager = createMailManager({
+      default: 'fake',
+    })
+    mailManager.registerTransport('fake', () => mail.getTransport())
+    setMailManager(mailManager)
+  })
+
+  afterEach(async () => {
+    await resetDatabase()
+  })
+
+  it('registers a user successfully', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+  })
+
+  it('queues welcome email after registration', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    queue.assertPushed(SendWelcomeEmailJob)
+  })
+
+  it('sends welcome email when job is processed', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    const jobs = queue.getDriver().getJobsOf(SendWelcomeEmailJob)
+    if (jobs.length > 0) {
+      const job = jobs[0]
+      const jobInstance = new SendWelcomeEmailJob()
+      await jobInstance.handle(job.queuedJob.payload)
+    }
+
+    mail.assertSent((m) => {
+      return (
+        m.to?.some((addr) => addr.email === 'ada@example.com') &&
+        m.subject === 'Welcome to Guren, Ada Lovelace!'
+      )
+    })
+  })
+
+  it('rejects duplicate email during registration', async () => {
+    const csrf = await http.withCsrf()
+
+    await User.create({
+      name: 'Existing User',
+      email: 'existing@example.com',
+      password: 'password123',
+    })
+
+    await csrf
+      .post('/register', {
+        name: 'New User',
+        email: 'existing@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'An account with this email already exists.')
+
+    queue.assertNotPushed(SendWelcomeEmailJob)
+  })
+})
