diff --git a/app/Utils/SlugGenerator.ts b/app/Utils/SlugGenerator.ts
new file mode 100644
index 0000000..f8b3f42
--- /dev/null
+++ b/app/Utils/SlugGenerator.ts
@@ -0,0 +1,26 @@
+export function generateSlug(title: string): string {
+  return title
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '')
+}
+
+export async function generateUniqueSlug(title: string, Post: any): Promise<string> {
+  let slug = generateSlug(title)
+  if (!slug) slug = 'post'
+
+  const baseSlug = slug
+  let counter = 2
+  let candidate = slug
+
+  if (!(await Post.first({ slug: candidate }))) {
+    return candidate
+  }
+
+  while (await Post.first({ slug: `${baseSlug}-${counter}` })) {
+    counter++
+  }
+
+  return `${baseSlug}-${counter}`
+}
