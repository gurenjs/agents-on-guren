diff --git a/app/Http/Controllers/HealthController.ts b/app/Http/Controllers/HealthController.ts
new file mode 100644
index 0000000..20a3a00
--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,40 @@
+import { Controller, type CheckResult } from '@guren/core'
+import { health } from '../../../config/health.js'
+
+interface CheckPayload {
+  status: CheckResult['status']
+  message?: string
+  durationMs: number
+}
+
+/**
+ * Liveness/readiness probe for load balancers and uptime monitors.
+ *
+ * The HTTP status is what drains traffic — 200 while every check passes, 503
+ * as soon as one fails — so a failing dependency must never reach the global
+ * exception handler as a 500. The JSON body carries the per-check breakdown
+ * the ops dashboard renders.
+ */
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const report = await health.check()
+    const checks: Record<string, CheckPayload> = {}
+
+    for (const check of report.checks) {
+      checks[check.name] = {
+        status: check.status,
+        ...(check.message === undefined ? {} : { message: check.message }),
+        durationMs: check.duration,
+      }
+    }
+
+    return this.json(
+      {
+        status: report.status,
+        timestamp: report.timestamp.toISOString(),
+        checks,
+      },
+      { status: report.status === 'healthy' ? 200 : 503 },
+    )
+  }
+}
