+import type { Router } from '@guren/core'
+import NewsletterController from './Http/Controllers/NewsletterController.js'
+import {
+  NewsletterSubscribeSchema,
+  NewsletterUnsubscribeSchema,
+  NewsletterConfirmParamSchema,
+} from './Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (newsletter) => {
+    newsletter.post('/subscribe', { body: NewsletterSubscribeSchema }, [NewsletterController, 'subscribe'])
+    newsletter.get('/confirm/:token', { params: NewsletterConfirmParamSchema }, [NewsletterController, 'confirm'])
+    newsletter.post('/unsubscribe', { body: NewsletterUnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+  })
+}
