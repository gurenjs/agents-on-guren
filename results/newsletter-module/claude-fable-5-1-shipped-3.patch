+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../../src/app.js'
+import { resetDatabase } from '../../../../config/database.js'
+import { NewsletterSubscription } from '../../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    // Primed on /health: the home page would need posts to render.
+    const csrf = await booted.withCsrf('/health')
+    http = csrf.json().withHeader('Referer', REFERER)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  describe('subscribe', () => {
+    it('stores a pending subscription and returns to the referring page', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0].email).toBe('reader@example.com')
+      expect(rows[0].confirmedAt).toBeNull()
+      expect(rows[0].token).toMatch(/^[0-9a-f]{64}$/)
+    })
+
+    it('issues a different token for every subscription', async () => {
+      await http.post('/newsletter/subscribe', { email: 'first@example.com' }).assertRedirect()
+      await http.post('/newsletter/subscribe', { email: 'second@example.com' }).assertRedirect()
+
+      const [first, second] = await NewsletterSubscription.all()
+      expect(first.token).not.toBe(second.token)
+    })
+
+    it('returns home without a referer', async () => {
+      const booted = await TestApp.fromApp(app)
+      const csrf = await booted.withCsrf('/health')
+
+      await csrf.json().post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('does not follow a referer on another site', async () => {
+      await http
+        .withHeader('Referer', 'https://evil.example/phish')
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+        .assertRedirect('/')
+    })
+
+    it.each(['', 'not-an-email'])('rejects the invalid address %p', async (email) => {
+      const response = await http.post('/newsletter/subscribe', { email })
+
+      response.assertUnprocessable()
+      const body = await response.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email.length).toBeGreaterThan(0)
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+
+      await http
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+        .assertUnprocessable()
+        .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription the token belongs to', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+      await http.post('/newsletter/subscribe', { email: 'other@example.com' }).assertRedirect()
+      const pending = await NewsletterSubscription.first({ email: 'reader@example.com' })
+
+      await http.get(`/newsletter/confirm/${pending?.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      const other = await NewsletterSubscription.first({ email: 'other@example.com' })
+      expect(confirmed?.confirmedAt).not.toBeNull()
+      expect(other?.confirmedAt).toBeNull()
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+
+      await http.get('/newsletter/confirm/never-issued').assertNotFound()
+
+      const row = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(row?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes that subscription only', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+      await http.post('/newsletter/subscribe', { email: 'other@example.com' }).assertRedirect()
+
+      await http.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows.map((row) => row.email)).toEqual(['other@example.com'])
+    })
+
+    it('rejects an invalid address', async () => {
+      await http.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertUnprocessable()
+    })
+  })
+})
