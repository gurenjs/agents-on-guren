diff --git a/tests/PostController.published.test.ts b/tests/PostController.published.test.ts
new file mode 100644
index 0000000..bf3a761
--- /dev/null
+++ b/tests/PostController.published.test.ts
@@ -0,0 +1,150 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase, seedDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+async function createUser(email: string) {
+  return User.create({ name: email, email, password: 'super-secret' })
+}
+
+describe('post drafts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Boots the app (and its one-time demo seeding) exactly once; each
+    // test's resetDatabase() below wipes to an empty, migrated schema
+    // without re-triggering that seed.
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  // Leave the demo seed intact for any test file that runs after this one
+  // in the same bun test process — resetDatabase() wipes it and boot-time
+  // seeding is one-shot, so nothing else re-populates it.
+  afterAll(async () => {
+    await resetDatabase()
+    await seedDatabase()
+  })
+
+  it('defaults a new post to draft when published is omitted', async () => {
+    const author = await createUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post('/posts', { title: 'Untouched draft', excerpt: 'exc', body: 'body' }).assertRedirect()
+
+    const post = await Post.first({ title: 'Untouched draft' })
+    expect(post?.published).toBe(false)
+  })
+
+  it('hides a draft from guests and other users on the list, in search, and on its page', async () => {
+    const author = await createUser('author@example.com')
+    const other = await createUser('other@example.com')
+
+    const draft = await Post.forceCreate({
+      title: 'Secret draft zzyzx',
+      excerpt: 'unreleased zzyzx',
+      body: 'body',
+      authorId: author.id,
+      published: false,
+    })
+    const published = await Post.forceCreate({
+      title: 'Public post qwerty',
+      excerpt: 'released qwerty',
+      body: 'body',
+      authorId: author.id,
+      published: true,
+    })
+
+    for (const viewer of [http, http.actingAs(other)]) {
+      const index = await (await viewer.json().get('/posts')).json<{
+        props: { data: { title: string; published: boolean }[]; pagination: { meta: { total: number } } }
+      }>()
+      const titles = index.props.data.map((p) => p.title)
+      expect(titles).toContain(published.title)
+      expect(titles).not.toContain(draft.title)
+      // The count backing pagination.meta.total is a separate query — must
+      // honor the same visibility filter as the rows, not just `data`.
+      expect(index.props.pagination.meta.total).toBe(1)
+      expect(index.props.data.find((p) => p.title === published.title)?.published).toBe(true)
+
+      const search = await (await viewer.query('/posts/search', { keywords: ['qwerty'] })).json<{
+        data: { title: string; published: boolean }[]
+      }>()
+      expect(search.data).toHaveLength(1)
+      expect(search.data[0]?.published).toBe(true)
+
+      const draftSearch = await (await viewer.query('/posts/search', { keywords: ['zzyzx'] })).json<{ data: unknown[] }>()
+      expect(draftSearch.data).toHaveLength(0)
+
+      await viewer.json().get(`/posts/${draft.id}`).assertNotFound()
+    }
+
+    await http.json().get(`/posts/${published.id}`).assertOk()
+  })
+
+  it('lets the author view and edit their own draft', async () => {
+    const author = await createUser('author@example.com')
+    const draft = await Post.forceCreate({
+      title: 'My private draft',
+      excerpt: 'exc',
+      body: 'body',
+      authorId: author.id,
+      published: false,
+    })
+
+    const asAuthor = http.actingAs(author).json()
+    await asAuthor.get(`/posts/${draft.id}`).assertOk().assertJsonPath('props.post.published', false)
+    await asAuthor.get(`/posts/${draft.id}/edit`).assertOk()
+  })
+
+  it('publishes immediately when created with published: true', async () => {
+    const author = await createUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post('/posts', { title: 'Live now', excerpt: 'exc', body: 'body', published: true }).assertRedirect()
+
+    const post = await Post.first({ title: 'Live now' })
+    await http.json().get(`/posts/${post!.id}`).assertOk().assertJsonPath('props.post.published', true)
+  })
+
+  it('keeps a post hidden from guests when created with published: false', async () => {
+    const author = await createUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post('/posts', { title: 'Still hidden', excerpt: 'exc', body: 'body', published: false }).assertRedirect()
+
+    const post = await Post.first({ title: 'Still hidden' })
+    await http.json().get(`/posts/${post!.id}`).assertNotFound()
+    await http.actingAs(author).json().get(`/posts/${post!.id}`).assertOk()
+  })
+
+  it('publishes a draft and unpublishes a post via the edit form', async () => {
+    const author = await createUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    const draft = await Post.forceCreate({
+      title: 'To publish',
+      excerpt: 'exc',
+      body: 'body',
+      authorId: author.id,
+      published: false,
+    })
+    await csrf.put(`/posts/${draft.id}`, { title: 'To publish', excerpt: 'exc', body: 'body', published: true }).assertRedirect()
+    await http.json().get(`/posts/${draft.id}`).assertOk()
+
+    const published = await Post.forceCreate({
+      title: 'To hide',
+      excerpt: 'exc',
+      body: 'body',
+      authorId: author.id,
+      published: true,
+    })
+    await csrf.put(`/posts/${published.id}`, { title: 'To hide', excerpt: 'exc', body: 'body', published: false }).assertRedirect()
+    await http.json().get(`/posts/${published.id}`).assertNotFound()
+  })
+})
