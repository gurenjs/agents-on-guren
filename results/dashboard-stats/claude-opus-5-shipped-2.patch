diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..729357a
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,82 @@
+import { beforeEach, beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeUser(email: string): Promise<UserRecord> {
+    const user = await User.create({ name: email, email, password: 'secret' })
+    return user as UserRecord
+  }
+
+  // The dashboard renders the full Inertia HTML shell; the page props live in
+  // the `data-page` JSON island, which is what the React page receives.
+  async function dashboardProps(user: UserRecord): Promise<{
+    postCount: number
+    recentPosts: Array<{ id: number; title: string }>
+  }> {
+    const res = await http.actingAs(user).get('/dashboard')
+    res.assertOk()
+    const html = await res.text()
+    const match = html.match(/<script data-page="app" type="application\/json">(.*?)<\/script>/s)
+    expect(match).not.toBeNull()
+    return JSON.parse(match![1]!).props
+  }
+
+  it('redirects guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('reports an empty state for a user without posts', async () => {
+    const user = await makeUser('empty@example.com')
+
+    const props = await dashboardProps(user)
+    expect(props.postCount).toBe(0)
+    expect(props.recentPosts).toEqual([])
+  })
+
+  it('counts only the signed-in user posts and lists the 5 newest first', async () => {
+    const user = await makeUser('author@example.com')
+    const other = await makeUser('other@example.com')
+
+    for (let index = 1; index <= 7; index += 1) {
+      await Post.forceCreate({
+        title: `Mine ${index}`,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: user.id,
+        createdAt: new Date(Date.UTC(2026, 0, index)).toISOString(),
+      })
+    }
+    await Post.forceCreate({
+      title: 'Theirs',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: other.id,
+      createdAt: new Date(Date.UTC(2026, 1, 1)).toISOString(),
+    })
+
+    const props = await dashboardProps(user)
+
+    expect(props.postCount).toBe(7)
+    expect(props.recentPosts.map((post) => post.title)).toEqual([
+      'Mine 7',
+      'Mine 6',
+      'Mine 5',
+      'Mine 4',
+      'Mine 3',
+    ])
+  })
+})
