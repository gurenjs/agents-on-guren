+
+describe('deriveExcerptFromBody', () => {
+  it('returns the trimmed body unchanged when 140 characters or fewer', () => {
+    expect(deriveExcerptFromBody('  hello world  ')).toBe('hello world')
+  })
+
+  it('cuts back to the last whitespace when the 140-character boundary splits a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ' +
+      'The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(deriveExcerptFromBody(body)).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ' +
+        'The quick brown fox jumps over the lazy dog. The…',
+    )
+  })
+
+  it('keeps the full 140 characters when the boundary lands on whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping ' +
+      'the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(deriveExcerptFromBody(body)).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping ' +
+        'the opening of the body intact and stopping right…',
+    )
+  })
+
+  it('cuts at exactly 140 characters when the run has no whitespace at all', () => {
+    const body = 'a'.repeat(200)
+    expect(deriveExcerptFromBody(body)).toBe(`${'a'.repeat(140)}…`)
+  })
+})
+
+describe('PostController excerpt handling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function signedInClient() {
+    const user = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).withCsrf()
+    return { csrf, user }
+  }
+
+  it('derives an excerpt from the body on create when the excerpt is blank', async () => {
+    const { csrf } = await signedInClient()
+    const body = 'x'.repeat(200)
+
+    await csrf.post('/posts', { title: 'Hello', excerpt: '   ', body }).assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe(deriveExcerptFromBody(body))
+  })
+
+  it('derives an excerpt from the body on create when the excerpt is omitted entirely', async () => {
+    const { csrf } = await signedInClient()
+    const body = 'short body'
+
+    await csrf.post('/posts', { title: 'Hello', body }).assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe('short body')
+  })
+
+  it('stores a provided excerpt trimmed, overriding derivation', async () => {
+    const { csrf } = await signedInClient()
+
+    await csrf.post('/posts', { title: 'Hello', excerpt: '  My teaser  ', body: 'Some body text' }).assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe('My teaser')
+  })
+
+  it('re-derives the excerpt on update from the new body when the excerpt is cleared', async () => {
+    const { csrf, user } = await signedInClient()
+    const post = await Post.forceCreate({
+      title: 'Hi',
+      excerpt: 'Old excerpt',
+      body: 'Original body',
+      authorId: user.id,
+    })
+
+    const newBody = 'y'.repeat(200)
+    await csrf.put(`/posts/${post?.id}`, { title: 'Hi', excerpt: '', body: newBody }).assertRedirect()
+
+    const updated = await Post.find(post!.id)
+    expect(updated?.excerpt).toBe(deriveExcerptFromBody(newBody))
+  })
+
+  it('still rejects a blank title', async () => {
