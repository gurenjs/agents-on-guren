@@ -0,0 +1,90 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { sanitizeRedirectPath } from '../app/Http/Support/redirect.js'
+
+// The login page takes a `redirect` value so a user lands back where they
+// came from. It must never be usable to hand the browser to another site.
+describe('sanitizeRedirectPath', () => {
+  it('keeps same-app paths', () => {
+    expect(sanitizeRedirectPath('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(sanitizeRedirectPath('/posts?page=2#top')).toBe('/posts?page=2#top')
+  })
+
+  it('rejects anything pointing off-site', () => {
+    for (const value of [
+      'https://evil.example',
+      'http://evil.example',
+      '//evil.example',
+      '/\\evil.example',
+      '\\\\evil.example',
+      'javascript:alert(1)',
+      'evil.example',
+      '',
+      '   ',
+      undefined,
+      null,
+    ]) {
+      expect(sanitizeRedirectPath(value)).toBeNull()
+    }
+  })
+})
+
+describe('login redirect', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret123' })
+  })
+
+  const credentials = { email: 'ada@example.com', password: 'secret123' }
+
+  it('returns the user to a same-app path', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('ignores an absolute URL and uses the default destination', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a protocol-relative value', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { ...credentials, redirect: '//evil.example' }).assertRedirect('/dashboard')
+  })
+
+  it('ignores a backslash variant', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { ...credentials, redirect: '/\\evil.example' }).assertRedirect('/dashboard')
+  })
+
+  it('ignores an off-site redirect passed on the query string', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login?redirect=https://evil.example', credentials).assertRedirect('/dashboard')
+  })
+
+  it('does not sign in with a wrong password', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: credentials.email, password: 'wrong-password', redirect: '/posts' })
+      .assertStatus(422)
+  })
+
+  it('drops an off-site redirect from the login page props', async () => {
+    // Ask for the Inertia JSON payload rather than the HTML shell.
+    const inertia = http.withHeader('X-Inertia', 'true')
+    await inertia.get('/login?redirect=https://evil.example').assertInertia('auth/Login', { redirect: '' })
+    await inertia
+      .get('/login?redirect=/posts/3/edit')
+      .assertInertia('auth/Login', { redirect: '/posts/3/edit' })
+  })
+})
