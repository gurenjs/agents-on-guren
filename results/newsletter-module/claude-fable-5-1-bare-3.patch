+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../../src/app.js'
+import { NewsletterSubscription } from '../../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts?page=2'
+
+// Boots the host application, so the module is exercised the way it is
+// mounted in production: behind the site's session and CSRF middleware.
+// `bun test` runs against the separate test database (see config/database.ts),
+// which booting the application migrates.
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const guest = await TestApp.fromApp(app)
+    http = (await guest.withCsrf('/health')).withHeader('Referer', REFERER)
+  })
+
+  beforeEach(async () => {
+    for (const subscription of await NewsletterSubscription.all()) {
+      await NewsletterSubscription.delete({ id: subscription.id })
+    }
+  })
+
+  async function subscribe(email: string): Promise<{ id: number; token: string }> {
+    await http.post('/newsletter/subscribe', { email }).assertRedirect(REFERER)
+    const subscription = await NewsletterSubscription.first({ email })
+    if (!subscription) {
+      throw new Error(`Expected a subscription for ${email}.`)
+    }
+    return subscription
+  }
+
+  describe('subscribe', () => {
+    it('stores a pending subscription and returns to the referring page', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const subscriptions = await NewsletterSubscription.all()
+      expect(subscriptions).toHaveLength(1)
+      expect(subscriptions[0]?.email).toBe('reader@example.com')
+      expect(subscriptions[0]?.confirmedAt).toBeNull()
+      expect(subscriptions[0]?.createdAt).toBeTruthy()
+      expect(subscriptions[0]?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token for every subscription', async () => {
+      const first = await subscribe('first@example.com')
+      const second = await subscribe('second@example.com')
+
+      expect(first.token).not.toBe(second.token)
+    })
+
+    it('returns to the home page without a referring page', async () => {
+      const guest = await (await TestApp.fromApp(app)).withCsrf('/health')
+
+      await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('does not follow a referring page on another site', async () => {
+      await http
+        .withHeader('Referer', 'https://evil.example/phish')
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+        .assertRedirect('/')
+    })
+
+    it.each(['', 'not-an-email'])('rejects the invalid address %p', async (email) => {
+      const response = await http.post('/newsletter/subscribe', { email }).assertUnprocessable()
+
+      const body = await response.json<{ errors: Record<string, unknown> }>()
+      expect(body.errors).toHaveProperty('email')
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects a missing address', async () => {
+      await http.post('/newsletter/subscribe', {}).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const existing = await subscribe('reader@example.com')
+
+      const response = await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertUnprocessable()
+
+      const body = await response.json<{ errors: Record<string, unknown> }>()
+      expect(body.errors).toHaveProperty('email')
+      const subscriptions = await NewsletterSubscription.all()
+      expect(subscriptions).toHaveLength(1)
+      expect(subscriptions[0]?.token).toBe(existing.token)
+    })
+
+    it('treats a differently capitalised address as the same subscription', async () => {
+      await subscribe('reader@example.com')
+
+      await http.post('/newsletter/subscribe', { email: 'Reader@Example.com' }).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription and goes to the home page', async () => {
+      const { id, token } = await subscribe('reader@example.com')
+
+      await http.get(`/newsletter/confirm/${token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.find(id)
+      expect(confirmed?.confirmedAt).toBeTruthy()
+    })
+
+    it('leaves other subscriptions pending', async () => {
+      const { token } = await subscribe('reader@example.com')
+      const other = await subscribe('other@example.com')
+
+      await http.get(`/newsletter/confirm/${token}`).assertRedirect('/')
+
+      expect((await NewsletterSubscription.find(other.id))?.confirmedAt).toBeNull()
+    })
+
+    it('answers 404 to a token that was never issued', async () => {
+      const { id } = await subscribe('reader@example.com')
+
+      await http.get('/newsletter/confirm/never-issued-token').assertNotFound()
+
+      expect((await NewsletterSubscription.find(id))?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes the subscription and returns to the referring page', async () => {
+      await subscribe('reader@example.com')
+      await subscribe('other@example.com')
+
+      await http.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const remaining = await NewsletterSubscription.all()
+      expect(remaining.map((subscription) => subscription.email)).toEqual(['other@example.com'])
+    })
+
+    it('returns to the referring page for an address that is not subscribed', async () => {
+      await subscribe('other@example.com')
+
+      await http.post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+
+    it('rejects an invalid address', async () => {
+      await subscribe('other@example.com')
+
+      await http.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertUnprocessable()
+
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+  })
+
+  it('rejects a request without the CSRF token', async () => {
+    const guest = await TestApp.fromApp(app)
+
+    await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertForbidden()
+
+    expect(await NewsletterSubscription.all()).toHaveLength(0)
+  })
+})
