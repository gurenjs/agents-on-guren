diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..58f497a
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,111 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import type { CommentResourceData } from '../app/Http/Resources/CommentResource.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Unique per run, so repeated runs against the same test database never
+// collide on users.email.
+const suffix = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+async function makeUser(name: string): Promise<UserRecord> {
+  return User.create({ name, email: `${name}-${suffix}@example.com`, password: 'password-123' })
+}
+
+async function commentsOnPage(http: TestApp, postId: number): Promise<CommentResourceData[]> {
+  const response = await http.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { comments: CommentResourceData[] }).comments
+}
+
+async function commentCount(postId: number): Promise<number> {
+  return (await Comment.where({ postId }).get()).length
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let stranger: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    // State-changing requests need the session and XSRF token a browser carries.
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    postAuthor = await makeUser('author')
+    commenter = await makeUser('commenter')
+    stranger = await makeUser('stranger')
+    post = await Post.forceCreate({ title: 'Hello', excerpt: 'Hi', body: 'Body', authorId: postAuthor.id })
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    await http.post(`/posts/${post.id}/comments`, { body: 'guest' }).assertRedirect('/login')
+    await http.delete('/comments/1').assertRedirect('/login')
+    await http.post('/comments/1/report').assertRedirect('/login')
+    expect(await commentCount(post.id)).toBe(0)
+  })
+
+  it('stores a comment by the signed-in user and lists it oldest first', async () => {
+    const as = http.actingAs(commenter)
+    await as.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await as.post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await commentsOnPage(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['first', 'second'])
+    expect(comments[0]?.author).toEqual({ id: commenter.id, name: 'commenter' })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects an empty or overlong body and stores nothing', async () => {
+    const as = http.actingAs(commenter).json()
+    const before = await commentCount(post.id)
+    await as.post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await as.post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await commentCount(post.id)).toBe(before)
+  })
+
+  it('lets only the comment author or the post author delete', async () => {
+    const mine = await Comment.forceCreate({ body: 'mine', postId: post.id, userId: commenter.id })
+    const other = await Comment.forceCreate({ body: 'other', postId: post.id, userId: commenter.id })
+
+    await http.actingAs(stranger).delete(`/comments/${mine.id}`).assertForbidden()
+    expect(await Comment.find(mine.id)).toBeTruthy()
+
+    await http.actingAs(commenter).delete(`/comments/${mine.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(mine.id)).toBeFalsy()
+
+    await http.actingAs(postAuthor).delete(`/comments/${other.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(other.id)).toBeFalsy()
+  })
+
+  it('counts a repeated report once and hides a comment after three reporters', async () => {
+    const comment = await Comment.forceCreate({ body: 'spam', postId: post.id, userId: commenter.id })
+    const visibleIds = async (viewer: TestApp) => (await commentsOnPage(viewer, post.id)).map((c) => c.id)
+
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await CommentReport.where({ commentId: comment.id }).get()).length).toBe(1)
+
+    await http.actingAs(postAuthor).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await visibleIds(http)).toContain(comment.id)
+
+    await http.actingAs(commenter).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await visibleIds(http)).not.toContain(comment.id)
+    expect(await visibleIds(http.actingAs(commenter))).not.toContain(comment.id)
+    expect(await visibleIds(http.actingAs(postAuthor))).not.toContain(comment.id)
+    expect(await Comment.find(comment.id)).toBeTruthy()
+  })
+
+  it('removes the comments of a deleted post', async () => {
+    const doomed = await Post.forceCreate({ title: 'Doomed', excerpt: 'x', body: 'x', authorId: postAuthor.id })
+    const comment = await Comment.forceCreate({ body: 'bye', postId: doomed.id, userId: commenter.id })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: stranger.id })
+
+    await http.actingAs(postAuthor).delete(`/posts/${doomed.id}`).assertRedirect('/posts')
+    expect(await commentCount(doomed.id)).toBe(0)
+    expect((await CommentReport.where({ commentId: comment.id }).get()).length).toBe(0)
+  })
+})
