@@ -0,0 +1,117 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, type AuthManager } from '@guren/core'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The App MCP endpoint (mcpPlugin in src/app.ts) end to end: a bearer issued
+// through the app's token store, JSON-RPC over POST /mcp, and tool calls that
+// re-enter the posts routes as that bearer's user.
+
+interface ToolResult {
+  isError?: boolean
+  content: Array<{ type: string; text: string }>
+  structuredContent?: unknown
+}
+
+let token: string
+let user: UserRecord
+let rpcId = 0
+
+async function rpc(method: string, params: Record<string, unknown> = {}, bearer: string | null = token) {
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    Accept: 'application/json, text/event-stream',
+  }
+  if (bearer) headers.Authorization = `Bearer ${bearer}`
+
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers,
+    body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method, params }),
+  }))
+}
+
+// The endpoint may answer as JSON or as a single-event SSE stream.
+async function rpcResult<T>(method: string, params: Record<string, unknown> = {}): Promise<T> {
+  const response = await rpc(method, params)
+  expect(response.status).toBe(200)
+  const text = await response.text()
+  const json = text.trimStart().startsWith('{')
+    ? text
+    : text.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5)).join('')
+  const message = JSON.parse(json) as { result?: T; error?: unknown }
+  expect(message.error).toBeUndefined()
+  return message.result as T
+}
+
+function callTool(name: string, args: Record<string, unknown>) {
+  return rpcResult<ToolResult>('tools/call', { name, arguments: args })
+}
+
+beforeAll(async () => {
+  await app.boot()
+  await migrateDatabase()
+
+  const email = `mcp-${crypto.randomUUID()}@example.com`
+  user = (await User.create({ name: 'MCP Author', email, password: 'secret-password' } as never)) as UserRecord
+
+  const auth = app.container.make<AuthManager>('auth')
+  const store = auth.getApiTokenStore()
+  if (!store) throw new Error('No API token store configured')
+  const issued = await createApiToken(store, { name: 'test', userId: user.id, abilities: ['tools:*'] })
+  token = issued.plainTextToken
+})
+
+describe('POST /mcp', () => {
+  it('refuses a call without a bearer', async () => {
+    const response = await rpc('tools/list', {}, null)
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two post tools with their read-only flags', async () => {
+    const { tools } = await rpcResult<{ tools: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }> }>('tools/list')
+    const appTools = tools.filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(appTools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(appTools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(appTools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).toBe(false)
+  })
+
+  it('creates a post as the bearer user, ignoring authorId', async () => {
+    const title = `MCP post ${crypto.randomUUID()}`
+    const result = await callTool('posts_store', {
+      title,
+      excerpt: 'Written by an assistant.',
+      body: 'Hello from MCP.',
+      authorId: 999_999,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const post = await Post.where({ title }).first()
+    expect(post?.authorId).toBe(user.id)
+  })
+
+  it('answers invalid input with a 422 error result and creates nothing', async () => {
+    const before = (await Post.where({ authorId: user.id }).get()).length
+    const result = await callTool('posts_store', { title: '', excerpt: 'x', body: 'y' })
+
+    // The route's own 422 validation body, carried as an MCP error result.
+    expect(result.isError).toBe(true)
+    const body = JSON.parse(result.content[0]!.text) as { errors: Record<string, string[]> }
+    expect(body.errors.title).toEqual(['Title is required.'])
+    expect((await Post.where({ authorId: user.id }).get()).length).toBe(before)
+  })
+
+  it('searches posts with the same JSON the QUERY route answers', async () => {
+    const title = `Searchable ${crypto.randomUUID()}`
+    await callTool('posts_store', { title, excerpt: 'About Bun.', body: 'Body.' })
+
+    const result = await callTool('posts_search', { keywords: [title] })
+    expect(result.isError).not.toBe(true)
+
+    const payload = (result.structuredContent ?? JSON.parse(result.content[0]!.text)) as { data: Array<{ title: string }> }
+    expect(payload.data.map((post) => post.title)).toEqual([title])
+  })
+})
