@@ -0,0 +1,59 @@
+import { createRateLimitMiddleware, MemoryRateLimitStore } from '@guren/core'
+
+/** Submissions one client may send to POST /login before it is throttled. */
+export const LOGIN_MAX_ATTEMPTS = 5
+
+/** Length of the throttling window, in milliseconds. */
+export const LOGIN_WINDOW_MS = 60_000
+
+/**
+ * Per-IP throttle for the login form.
+ *
+ * Every submission counts — right or wrong credentials — so a successful login
+ * cannot be used to clear the counter, and the check runs before the request
+ * body is validated so malformed payloads are just as expensive to an attacker.
+ *
+ * Client identity is the connection's own peer address, read through
+ * `server.requestIP()` by the rate limiter's default key generator.
+ * `trustProxy` stays off deliberately: this app is not deployed behind a proxy
+ * that strips them, so `X-Forwarded-For` and friends are attacker-controlled and
+ * would hand out a fresh bucket per forged header. When the address cannot be
+ * resolved at all, that generator falls back to a single shared bucket for the
+ * route — throttled together rather than let through.
+ *
+ * Counters live in memory: this is a single-process app and nothing needs to
+ * survive a restart. The store is created per registration so each application
+ * instance (a test app included) starts from a clean slate.
+ */
+export interface LoginThrottleOptions {
+  /**
+   * Clock returning epoch milliseconds. Injectable so tests can step over the
+   * window instead of sleeping a minute; it drives the store and the
+   * `Retry-After` calculation together.
+   */
+  now?: () => number
+}
+
+export function createLoginThrottle({ now }: LoginThrottleOptions = {}) {
+  return createRateLimitMiddleware({
+    limit: LOGIN_MAX_ATTEMPTS,
+    windowMs: LOGIN_WINDOW_MS,
+    now,
+    // 0 disables the sweep interval — it would otherwise keep the process
+    // alive on its own. Expired entries are replaced on the next request for
+    // the same key, so the window still resets correctly.
+    store: new MemoryRateLimitStore(0, now),
+    keyPrefix: 'login:',
+    message: 'Too many login attempts. Please try again later.',
+    // Set Retry-After on the response itself rather than relying on the
+    // context's prepared headers, and never advertise a 0-second wait.
+    onRateLimited: (ctx, retryAfter) => {
+      const seconds = Math.max(1, retryAfter)
+      return ctx.json(
+        { message: 'Too many login attempts. Please try again later.', retryAfter: seconds },
+        429,
+        { 'Retry-After': seconds.toString() },
+      )
+    },
+  })
+}
