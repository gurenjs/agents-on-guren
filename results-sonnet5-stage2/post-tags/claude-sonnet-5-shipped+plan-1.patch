diff --git a/app/Services/PostTags.ts b/app/Services/PostTags.ts
new file mode 100644
index 0000000..b66a286
--- /dev/null
+++ b/app/Services/PostTags.ts
@@ -0,0 +1,48 @@
+import { Tag } from '../Models/Tag.js'
+import { PostTag } from '../Models/PostTag.js'
+
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) return byPost
+
+  const links = await PostTag.whereIn('postId', postIds).get()
+  const tags = await Tag.whereIn('id', [...new Set(links.map((link) => link.tagId))]).get()
+  const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name === undefined) continue
+    byPost.set(link.postId, [...(byPost.get(link.postId) ?? []), name])
+  }
+  for (const names of byPost.values()) names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+
+  return byPost
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+  const links = await PostTag.where({ tagId: tag.id }).get()
+  return links.map((link) => link.postId)
+}
+
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const wanted: number[] = []
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    wanted.push(tag.id)
+  }
+
+  const current = await PostTag.where({ postId }).get()
+  for (const link of current) {
+    if (!wanted.includes(link.tagId)) await PostTag.delete({ id: link.id })
+  }
+  const attached = new Set(current.map((link) => link.tagId))
+  for (const tagId of wanted) {
+    if (!attached.has(tagId)) await PostTag.create({ postId, tagId })
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  await PostTag.delete({ postId })
+}
