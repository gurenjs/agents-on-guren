+import { Head, Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: { id: number; title: string }
+  revisions: Array<{ id: number; title: string; createdAt: string }>
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History of ${post.title}`} />
+      <section className="space-y-6">
+        <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+          <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+          Revisions of {post.title}
+        </h1>
+
+        {revisions.length === 0 ? <p className="text-g-muted">No earlier versions yet.</p> : null}
+
+        <ul className="space-y-3">
+          {revisions.map((revision) => (
+            <li key={revision.id} className="flex items-center justify-between gap-4 border-b border-g-line pb-3">
+              <div>
+                <p className="font-bold text-g-heading">{revision.title}</p>
+                <p className="text-sm text-g-muted">{new Date(revision.createdAt).toLocaleString()}</p>
+              </div>
+              <Link
+                href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                method="post"
+                as="button"
+                className="rounded-g-ctl border border-g-line-strong px-3 py-1 text-sm text-g-accent-text transition hover:underline"
+              >
+                Restore
+              </Link>
+            </li>
+          ))}
+        </ul>
+
+        <Link href={route('posts.show', { id: post.id })} className="text-sm text-g-text-2 transition hover:text-g-heading">
+          ← Back to post
+        </Link>
+      </section>
+    </Layout>
+  )
+}
