new file mode 100644
index 0000000..dad3734
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,21 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// The zero-config module boundary only guards a module's internals; a module's
+// index.ts and db/schema.ts stay importable. The newsletter module must be
+// liftable into another app as is, so the blog (app/, routes/) may not import
+// any of it, public surface included. src/app.ts and db/schema.ts are the only
+// places that wire it in.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'The blog must not depend on the newsletter module; it is registered only through src/app.ts.',
+    },
+  ],
+})
