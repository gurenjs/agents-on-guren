+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+import { slugify } from '../app/Support/slug.js'
+
+async function makeAuthor(): Promise<UserRecord> {
+  const user = await User.create({
+    name: 'Slug Author',
+    email: 'slugs@example.com',
+    password: 'secret',
+  })
+
+  return user as UserRecord
+}
+
+async function makePost(author: UserRecord, title: string) {
+  return Post.forceCreate({
+    title,
+    slug: await Post.uniqueSlugFor(title),
+    excerpt: `${title} — excerpt`,
+    body: `${title} — body`,
+    authorId: author.id,
+  })
+}
+
+describe('slugify', () => {
+  it('lowercases, strips punctuation and joins words with a single dash', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world')
+    expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+  })
+
+  it('folds accents to ASCII and falls back when nothing survives', () => {
+    expect(slugify('Café Déjà Vu')).toBe('cafe-deja-vu')
+    expect(slugify('!!!')).toBe('post')
+  })
+})
+
+describe('post slugs', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('numbers duplicate titles from the next free suffix', async () => {
+    const author = await makeAuthor()
+
+    const first = await makePost(author, 'Hello, World!')
+    const second = await makePost(author, 'Hello, World!')
+    const third = await makePost(author, 'Hello, World!')
+
+    expect(first?.slug).toBe('hello-world')
+    expect(second?.slug).toBe('hello-world-2')
+    expect(third?.slug).toBe('hello-world-3')
+  })
+
+  it('serves the post page at its slug and 404s an unknown one', async () => {
+    const author = await makeAuthor()
+    const post = await makePost(author, 'Readable URLs')
+
+    await http.get(`/posts/${post?.slug}`).assertOk()
+    await http.get('/posts/no-such-post').assertNotFound()
+  })
+
+  it('permanently redirects the legacy id address, and 404s an unknown id', async () => {
+    const author = await makeAuthor()
+    const post = await makePost(author, 'Readable URLs')
+
+    await http.get(`/posts/${post?.id}`).assertStatus(301).assertHeader('location', '/posts/readable-urls')
+    await http.get('/posts/99999').assertNotFound()
+  })
+
+  it('keeps the slug when the title changes', async () => {
+    const author = await makeAuthor()
+    const post = await makePost(author, 'Original Title')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post?.id}`, { title: 'A Brand New Title', excerpt: 'Still here.', body: 'Still here.' })
+      .assertRedirect('/posts/original-title')
+
+    await http.get('/posts/a-brand-new-title').assertNotFound()
+    const reloaded = await Post.findOrFail(post?.id as number)
+    expect(reloaded.slug).toBe('original-title')
+    expect(reloaded.title).toBe('A Brand New Title')
+  })
+
+  it('sends the author to the slug URL after creating a post', async () => {
+    const author = await makeAuthor()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'First one.', body: 'Body text.' })
+      .assertRedirect('/posts/hello-world')
+  })
+})
