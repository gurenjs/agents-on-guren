new file mode 100644
index 0000000..e2cb2ce
--- /dev/null
+++ b/app/Support/redirect.ts
@@ -0,0 +1,39 @@
+// Where a sign-in goes when no usable `redirect` was supplied.
+export const DEFAULT_REDIRECT = '/dashboard'
+
+// Browsers drop tab, newline and carriage return anywhere inside a URL, so
+// "/\t/evil.example" navigates to //evil.example. Strip them before deciding
+// whether a destination stays inside the app.
+const STRIPPED_BY_BROWSERS = /[\t\n\r]/g
+
+// Any other control character has no business in a redirect target and only
+// serves to confuse the checks below (or the Location header we emit).
+function hasControlCharacter(value: string): boolean {
+  for (const character of value) {
+    const code = character.codePointAt(0) ?? 0
+    if (code <= 0x1f || (code >= 0x7f && code <= 0x9f)) return true
+  }
+  return false
+}
+
+/**
+ * Narrows a user-supplied redirect target to a path inside this app.
+ *
+ * Only plain same-app paths are accepted — a single leading slash followed by
+ * the rest of the path. Absolute URLs (they carry a scheme), protocol-relative
+ * values starting with `//`, and backslash variants such as `/\evil.example`
+ * (browsers read `\` as `/`) would all leave our origin, so they fall back to
+ * the default destination instead.
+ */
+export function safeRedirectPath(value: unknown, fallback: string = DEFAULT_REDIRECT): string {
+  if (typeof value !== 'string') return fallback
+
+  const candidate = value.replace(STRIPPED_BY_BROWSERS, '')
+
+  if (!candidate.startsWith('/')) return fallback
+  if (candidate.startsWith('//')) return fallback
+  if (candidate.includes('\\')) return fallback
+  if (hasControlCharacter(candidate)) return fallback
+
+  return candidate
+}
