@@ -0,0 +1,23 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken, type ApiTokenRecord } from '../../Models/ApiToken.js'
+import { hashToken } from '../../Services/TokenService.js'
+
+export const bearerTokenMiddleware = defineMiddleware(async (c, next) => {
+  const authHeader = c.req.header('Authorization')
+
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    return c.json({ message: 'Unauthorized' }, 401)
+  }
+
+  const plainToken = authHeader.slice(7)
+  const tokenHash = await hashToken(plainToken)
+
+  const apiToken = await ApiToken.first({ tokenHash })
+
+  if (!apiToken) {
+    return c.json({ message: 'Unauthorized' }, 401)
+  }
+
+  c.set('apiToken', apiToken as ApiTokenRecord)
+  return next()
+})
diff --git a/app/Http/Middleware/RateLimitMiddleware.ts b/app/Http/Middleware/RateLimitMiddleware.ts
