diff --git a/app/Http/Controllers/PostRevisionController.ts b/app/Http/Controllers/PostRevisionController.ts
new file mode 100644
index 0000000..84fa1f3
--- /dev/null
+++ b/app/Http/Controllers/PostRevisionController.ts
@@ -0,0 +1,67 @@
+import { Controller } from '@guren/core'
+import { pages } from '@/.guren/pages.gen'
+import { Post } from '../../Models/Post.js'
+import { PostRevision } from '../../Models/PostRevision.js'
+import { PostRevisionResource } from '../Resources/PostRevisionResource.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+import type { UserRecord } from '../../Models/User.js'
+import { z } from 'zod'
+
+const RevisionIdParamSchema = z.object({
+  id: z.coerce.number().int().positive(),
+  revisionId: z.coerce.number().int().positive(),
+})
+
+export default class PostRevisionController extends Controller {
+  async index(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+
+    const user = await this.auth.userOrFail<UserRecord>()
+    if (Number(user.id) !== post.authorId) {
+      return this.ctx.json({ error: 'Forbidden' }, { status: 403 })
+    }
+
+    const revisions = await PostRevision.newQuery()
+      .where('postId', post.id)
+      .orderBy('createdAt', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: { id: post.id },
+      revisions: revisions.map((revision) => new PostRevisionResource(revision).toJSON()),
+    })
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(RevisionIdParamSchema)
+    const post = await Post.findOrFail(id)
+
+    const user = await this.auth.userOrFail<UserRecord>()
+    if (Number(user.id) !== post.authorId) {
+      return this.ctx.json({ error: 'Forbidden' }, { status: 403 })
+    }
+
+    const revision = await PostRevision.where('id', revisionId).first()
+    if (!revision || revision.postId !== post.id) {
+      return this.ctx.json({ error: 'Not Found' }, { status: 404 })
+    }
+
+    // Keep current post as a revision before restoring
+    await PostRevision.create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+
+    // Restore the old version
+    await Post.update({ id: post.id }, {
+      title: revision.title,
+      excerpt: revision.excerpt,
+      body: revision.body,
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
