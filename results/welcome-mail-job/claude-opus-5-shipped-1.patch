diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..727f535
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,109 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import {
+  createMailManager,
+  getMailManager,
+  getQueueDriver,
+  setMailManager,
+  setQueueDriver,
+  Worker,
+  type MailManager,
+  type QueueDriver,
+} from '@guren/core'
+import { fakeMail, fakeQueue, TestApp, type FakeMail, type FakeQueue } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { SendWelcomeEmailJob } from '../app/Jobs/SendWelcomeEmailJob.js'
+
+// Registration hands the welcome email to the queue instead of sending it, so
+// the two halves are exercised the way production splits them: the request
+// only queues, and a worker run afterwards is what delivers.
+describe('register', () => {
+  let http: TestApp
+  let queue: FakeQueue
+  let mails: FakeMail
+  let previousDriver: QueueDriver | null
+  let previousMailManager: MailManager | null
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    previousDriver = getQueueDriver()
+    previousMailManager = getMailManager()
+  })
+
+  beforeEach(() => {
+    // Holds dispatched jobs instead of running them, so a request's own effects
+    // stay separable from the worker's.
+    queue = fakeQueue()
+    setQueueDriver(queue.getDriver())
+
+    // A manager with no default sender, so the message has to carry the
+    // configured one itself.
+    mails = fakeMail()
+    const manager = createMailManager({ default: 'fake' })
+    manager.registerTransport('fake', () => mails.getTransport())
+    setMailManager(manager)
+  })
+
+  afterAll(() => {
+    if (previousDriver) setQueueDriver(previousDriver)
+    if (previousMailManager) setMailManager(previousMailManager)
+  })
+
+  it('queues a welcome email that a worker delivers to the new account', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'analytical-engine',
+        passwordConfirmation: 'analytical-engine',
+      })
+      .assertRedirect('/dashboard')
+
+    // The request itself sent nothing — it only queued the work.
+    mails.assertNothingSent()
+    queue.assertPushedTimes(SendWelcomeEmailJob, 1)
+    expect(queue.all()).toHaveLength(1)
+
+    await new Worker(queue.getDriver(), { queues: ['default'], stopWhenEmpty: true }).start()
+
+    const sent = mails.sent()
+    expect(sent).toHaveLength(1)
+
+    const message = sent[0]!.message
+    expect(message.to.map((address) => address.email)).toEqual(['ada@example.com'])
+    expect(message.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(message.text).toContain('Hi Ada Lovelace,')
+    expect(message.from).toEqual({ email: 'hello@example.com', name: 'Guren' })
+  })
+
+  it('queues nothing when the registration is refused', async () => {
+    const csrf = await http.withCsrf()
+
+    // Invalid input: the passwords do not match.
+    await csrf
+      .post('/register', {
+        name: 'Grace Hopper',
+        email: 'grace@example.com',
+        password: 'nanosecond',
+        passwordConfirmation: 'nanoseconds',
+      })
+      .assertUnprocessable()
+
+    // And an email that is already registered.
+    await csrf
+      .post('/register', {
+        name: 'Ada Again',
+        email: 'ada@example.com',
+        password: 'analytical-engine',
+        passwordConfirmation: 'analytical-engine',
+      })
+      .assertUnprocessable()
+
+    queue.assertNothingPushed()
+    mails.assertNothingSent()
+  })
+})
