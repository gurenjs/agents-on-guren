diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..449eab4
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,70 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    user = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'password123' })
+  })
+
+  async function issue(name = 'CI') {
+    const session = await http.actingAs(user).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: number; name: string; token: string }>()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('creates a token, stores only a derived value, and rejects bad names', async () => {
+    const created = await issue()
+    expect(created.token.length).toBeGreaterThanOrEqual(16)
+    const rows = await ApiToken.all()
+    expect(JSON.stringify(rows)).not.toContain(created.token)
+
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect((await ApiToken.all()).length).toBe(1)
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await issue()
+    const res = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    res.assertCreated()
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(Number(user.id))
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+    await bearer(token).get('/api/posts').assertOk().assertJsonCount(1, 'data')
+  })
+
+  it('answers 401 for bad tokens and stops working after revocation', async () => {
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('nope-nope-nope-nope-nope').get('/api/posts').assertUnauthorized()
+
+    const { id, token } = await issue()
+    const other = await issue('other')
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await bearer(token).get('/api/posts').assertUnauthorized()
+    await bearer(other.token).get('/api/posts').assertOk()
+  })
+
+  it('rate limits per token', async () => {
+    const a = await issue('a')
+    const b = await issue('b')
+    for (let i = 0; i < 60; i++) await bearer(a.token).get('/api/posts').assertOk()
+    const limited = await bearer(a.token).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(b.token).get('/api/posts').assertOk()
+  })
+})
