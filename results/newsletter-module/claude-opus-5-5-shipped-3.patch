index 0000000..eeda265
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterSubscriptionController.ts
@@ -0,0 +1,48 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, NotFoundHttpException, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class NewsletterSubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // 32 random bytes → 64 hex characters, unguessable and URL-safe.
+    const token = randomBytes(32).toString('hex')
+    await NewsletterSubscription.create({ email, token })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validated('newsletter.confirm').params
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException('Unknown confirmation token.')
+    }
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  // Only a same-origin Referer is followed, so the redirect cannot be used as an open redirect.
+  private previousUrl(): string {
+    const referer = this.request.header('referer')
+    return referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+  }
+}
