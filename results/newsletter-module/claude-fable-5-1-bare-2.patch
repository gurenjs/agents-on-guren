+++ b/modules/newsletter/app/Models/Subscription.ts
@@ -0,0 +1,20 @@
+import { randomBytes } from 'node:crypto'
+import { defineModel } from '@guren/core'
+import { newsletterSubscriptions } from '../../db/schema.js'
+
+export type SubscriptionRecord = typeof newsletterSubscriptions.$inferSelect
+export type NewSubscriptionRecord = typeof newsletterSubscriptions.$inferInsert
+
+const TOKEN_BYTES = 32
+
+export class Subscription extends defineModel(newsletterSubscriptions, {
+  // `token` and `confirmedAt` are set by the server, never from request input.
+  fillable: ['email'],
+  // Never serialized by Model.serialize(): whoever holds it can confirm.
+  hidden: ['token'],
+}) {
+  /** 64 hex characters from the CSPRNG: the only secret in a confirmation link. */
+  static generateToken(): string {
+    return randomBytes(TOKEN_BYTES).toString('hex')
+  }
+}
