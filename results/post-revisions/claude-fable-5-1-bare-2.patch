diff --git a/app/Http/Controllers/PostRevisionController.ts b/app/Http/Controllers/PostRevisionController.ts
new file mode 100644
index 0000000..330cbef
--- /dev/null
+++ b/app/Http/Controllers/PostRevisionController.ts
@@ -0,0 +1,57 @@
+import { Controller, NotFoundHttpException } from '@guren/core'
+import { pages } from '@/.guren/pages.gen'
+import { Post } from '../../Models/Post.js'
+import { PostRevision } from '../../Models/PostRevision.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { PostRevisionResource } from '../Resources/PostRevisionResource.js'
+import { PostIdParamSchema, PostRevisionParamSchema } from '../Validators/PostValidator.js'
+
+/**
+ * The version history of a post. Rows are written by PostController whenever
+ * an edit or a restore goes through, so this controller only lists them and
+ * turns one back into the post's current content.
+ */
+export default class PostRevisionController extends Controller {
+  async index(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('viewRevisions', [Post, post])
+
+    const revisions = await PostRevision.newQuery()
+      .where('postId', post.id)
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: new PostResource(post).toJSON(),
+      revisions: revisions.map((revision) => new PostRevisionResource(revision).toJSON()),
+    })
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(PostRevisionParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('restore', [Post, post])
+
+    // Scoped to the post in the URL, so a revision id from another post is a
+    // 404 even when the same author owns both.
+    const revision = await PostRevision.first({ id: revisionId, postId: post.id })
+    if (!revision) {
+      throw new NotFoundHttpException('Revision not found.', 'PostRevision', revisionId)
+    }
+
+    // A restore is an edit: the content being replaced becomes a revision of
+    // its own, and the restored row stays where it is.
+    await Post.transaction(async (trx) => {
+      await PostRevision.create(Post.snapshotForRevision(post), { trx })
+      await Post.update(
+        { id: post.id },
+        { title: revision.title, excerpt: revision.excerpt, body: revision.body },
+        { trx },
+      )
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
diff --git a/app/Http/Resources/PostRevisionResource.ts b/app/Http/Resources/PostRevisionResource.ts
new file mode 100644
index 0000000..462b257
--- /dev/null
+++ b/app/Http/Resources/PostRevisionResource.ts
@@ -0,0 +1,28 @@
+import { Resource } from '@guren/core'
+import type { PostRevisionRecord } from '../../Models/PostRevision.js'
+
+export interface PostRevisionResourceData extends Record<string, unknown> {
+  id: number
+  postId: number
+  title: string
+  excerpt: string
+  body: string
+  // Serialized for the same reason as PostResource: `created_at` is a string
+  // on SQLite and a Date elsewhere.
+  createdAt: string
+}
+
+export class PostRevisionResource extends Resource<PostRevisionRecord, PostRevisionResourceData> {
+  toArray(): PostRevisionResourceData {
+    const revision = this.resource
+
+    return {
+      id: revision.id,
+      postId: revision.postId,
+      title: revision.title,
+      excerpt: revision.excerpt,
+      body: revision.body,
+      createdAt: new Date(revision.createdAt).toISOString(),
+    }
+  }
+}
