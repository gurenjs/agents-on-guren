+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Http/Middleware/ApiTokenMiddleware.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+// Bearer-token API for scripts. Cookie-less bearer requests skip CSRF, so the
+// token is the only credential these routes accept.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    api.middleware(authenticateApiToken, throttleApiToken).group((authed) => {
+      authed.get('/posts', { name: 'api.posts.index' }, [ApiPostController, 'index'])
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}
