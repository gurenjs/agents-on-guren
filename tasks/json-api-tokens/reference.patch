+          type="text"
+          value={name}
+          placeholder="Token name"
+          onChange={(event) => setName(event.target.value)}
+          className="w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text outline-none focus:outline-2 focus:outline-g-accent"
+        />
+        <button type="submit" className="rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent">
+          Create
+        </button>
+      </form>
+      {error ? <p className="text-sm text-g-danger">{error}</p> : null}
+
+      <ul className="divide-y divide-g-line text-sm">
