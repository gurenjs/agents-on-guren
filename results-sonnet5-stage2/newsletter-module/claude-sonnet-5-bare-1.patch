@@ -0,0 +1,36 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { NewsletterSubscription } from './NewsletterSubscription.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = (await TestApp.fromApp(app)).withHeaders({ Referer: 'http://localhost/posts' })
+    http = await http.withCsrf()
+  })
+
+  it('subscribes, confirms and unsubscribes', async () => {
+    const email = `reader-${crypto.randomUUID()}@example.com`
+
+    const res = await http.post('/newsletter/subscribe', { email })
+    expect([302, 303]).toContain(res.status)
+
+    const row = await NewsletterSubscription.first({ email })
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+
+    await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+
+    const confirm = await http.get(`/newsletter/confirm/${row?.token}`)
+    expect([302, 303]).toContain(confirm.status)
+    expect((await NewsletterSubscription.first({ email }))?.confirmedAt).not.toBeNull()
+
+    await http.get('/newsletter/confirm/unknown-token').assertStatus(404)
+
+    await http.post('/newsletter/unsubscribe', { email })
+    expect(await NewsletterSubscription.first({ email })).toBeNull()
+  })
+})
