+import { beforeAll, describe, expect, it } from 'bun:test'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { createToken, setUpApiTokenFixture, signedIn, withToken, type ApiTokenFixture } from './support/apiTokens.js'
+
+// Creating and revoking personal API tokens from a signed-in session.
+describe('ApiTokenController', () => {
+  let fixture: ApiTokenFixture
+
+  beforeAll(async () => {
+    fixture = await setUpApiTokenFixture()
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('answers 201 with the id, the name and the plain-text token', async () => {
+      const { http, alice } = fixture
+      const created = await createToken(http, alice, 'old laptop')
+
+      expect(created.name).toBe('old laptop')
+      expect(typeof created.id).toBe('string')
+      expect(created.token.startsWith(`${created.id}|`)).toBe(true)
+      expect(created.token.split('|')[1]?.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token every time', async () => {
+      const { http, alice } = fixture
+      const first = await createToken(http, alice)
+      const second = await createToken(http, alice)
+
+      expect(first.token).not.toBe(second.token)
+      expect(first.id).not.toBe(second.id)
+    })
+
+    it('stores neither the token nor its secret part', async () => {
+      const { http, alice } = fixture
+      const created = await createToken(http, alice)
+      const secret = created.token.split('|')[1] ?? ''
+
+      const rows = await ApiToken.all()
+      const row = rows.find((candidate) => candidate.id === created.id)
+
+      expect(row?.userId).toBe(alice.id)
+      expect(row?.hashedToken).toMatch(/^[0-9a-f]{64}$/)
+      for (const value of rows.flatMap((candidate) => Object.values(candidate))) {
+        expect(String(value)).not.toContain(secret)
+      }
+    })
+
+    it('rejects a missing, empty or over-long name and creates nothing', async () => {
+      const { http, bob } = fixture
+      const session = await signedIn(http, bob)
+      const before = await ApiToken.where({ userId: bob.id }).get()
+
+      await session.post('/profile/tokens', {}).assertUnprocessable()
+      await session.post('/profile/tokens', { name: '' }).assertUnprocessable()
+      await session.post('/profile/tokens', { name: '   ' }).assertUnprocessable()
+      await session.post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+      await session.post('/profile/tokens', { name: 'x'.repeat(50) }).assertCreated()
+
+      const after = await ApiToken.where({ userId: bob.id }).get()
+      expect(after.length).toBe(before.length + 1)
+    })
+
+    it('gives a guest no token', async () => {
+      const guest = await fixture.http.withCsrf()
+      const before = await ApiToken.all()
+
+      await guest.post('/profile/tokens', { name: 'CI' }).assertRedirect('/login')
+
+      expect((await ApiToken.all()).length).toBe(before.length)
+    })
+
+    it('cannot be reached with an API token instead of a session', async () => {
+      const { http, alice } = fixture
+      const { token } = await createToken(http, alice)
+      const before = await ApiToken.all()
+
+      const response = await withToken(http, token).post('/profile/tokens', { name: 'minted by a script' })
+
+      expect(response.status).not.toBe(201)
+      expect((await ApiToken.all()).length).toBe(before.length)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('revokes the token at once and leaves the owner\'s other tokens working', async () => {
+      const { http, alice } = fixture
+      const revoked = await createToken(http, alice, 'old laptop')
+      const kept = await createToken(http, alice, 'CI')
+      await withToken(http, revoked.token).get('/api/posts').assertOk()
+
+      const session = await signedIn(http, alice)
+      await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+
+      await withToken(http, revoked.token).get('/api/posts').assertUnauthorized()
+      await withToken(http, kept.token).get('/api/posts').assertOk()
+    })
+
+    it('answers 404 for another user\'s token, which keeps working', async () => {
+      const { http, alice, bob } = fixture
+      const created = await createToken(http, alice)
+
+      const session = await signedIn(http, bob)
+      await session.delete(`/profile/tokens/${created.id}`).assertNotFound()
+
+      await withToken(http, created.token).get('/api/posts').assertOk()
+    })
+
+    it('answers 404 for an unknown id', async () => {
+      const { http, alice } = fixture
+      const session = await signedIn(http, alice)
+
+      await session.delete('/profile/tokens/no-such-token').assertNotFound()
+    })
+
+    it('cannot be reached with an API token instead of a session', async () => {
+      const { http, alice } = fixture
+      const created = await createToken(http, alice)
+
+      const response = await withToken(http, created.token).delete(`/profile/tokens/${created.id}`)
+
+      expect(response.status).not.toBe(204)
+      await withToken(http, created.token).get('/api/posts').assertOk()
+    })
+  })
