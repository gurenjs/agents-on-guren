@@ -0,0 +1,112 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('profile.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function actingUser() {
+    const user = await User.create({
+      name: 'Original Name',
+      email: 'original@example.com',
+      password: 'correct-horse',
+    })
+    const authed = http.actingAs(user)
+    const csrf = await authed.withCsrf()
+    return { user, csrf }
+  }
+
+  it('rejects a badly formatted email and leaves the account unchanged', async () => {
+    const { user, csrf } = await actingUser()
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'Original Name', email: 'not-an-email' })
+      .assertUnprocessable()
+
+    const stored = await User.find(user.id)
+    expect(stored?.email).toBe('original@example.com')
+  })
+
+  it('rejects an empty name and leaves the account unchanged', async () => {
+    const { user, csrf } = await actingUser()
+
+    await csrf
+      .json()
+      .put('/profile', { name: '', email: 'original@example.com' })
+      .assertUnprocessable()
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Original Name')
+  })
+
+  it('ignores fields outside the profile form, such as id and passwordHash', async () => {
+    const { user, csrf } = await actingUser()
+    const originalHash = (await User.find(user.id))?.passwordHash
+
+    await csrf
+      .json()
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'updated@example.com',
+        id: user.id + 999,
+        passwordHash: 'hacked',
+      })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.id).toBe(user.id)
+    expect(stored?.name).toBe('Updated Name')
+    expect(stored?.email).toBe('updated@example.com')
+    expect(stored?.passwordHash).toBe(originalHash)
+  })
+
+  it('accepts a valid update, lowercasing the email', async () => {
+    const { csrf, user } = await actingUser()
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'New Name', email: 'NEW@Example.com' })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('New Name')
+    expect(stored?.email).toBe('new@example.com')
+  })
+
+  it('rejects a too-short password and leaves the account unchanged', async () => {
+    const { user, csrf } = await actingUser()
+    const originalHash = (await User.find(user.id))?.passwordHash
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'Original Name', email: 'original@example.com', password: 'short' })
+      .assertUnprocessable()
+
+    const stored = await User.find(user.id)
+    expect(stored?.passwordHash).toBe(originalHash)
+  })
+
+  it('keeps the current password when the field is left blank', async () => {
+    const { user, csrf } = await actingUser()
+    const originalHash = (await User.find(user.id))?.passwordHash
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'Original Name', email: 'original@example.com', password: '' })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.passwordHash).toBe(originalHash)
+  })
+})
