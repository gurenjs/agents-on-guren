+++ b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const referer = 'http://localhost/posts'
+
+describe('NewsletterSubscriptionController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function client(): Promise<TestApp> {
+    return (await http.withCsrf()).json().withHeader('Referer', referer)
+  }
+
+  it('stores a pending subscription with a random token', async () => {
+    await (await client()).post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(referer)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.email).toBe('reader@example.com')
+    expect(rows[0]?.confirmedAt).toBeNull()
+    expect(rows[0]?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses', async () => {
+    const csrf = await client()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const res = await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertUnprocessable()
+    expect((await res.json<{ errors: Record<string, string[]> }>()).errors.email).toBeDefined()
+
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s an unknown token', async () => {
+    await NewsletterSubscription.create({ email: 'reader@example.com', token: 'a'.repeat(64) })
+
+    await http.get(`/newsletter/confirm/${'b'.repeat(64)}`).assertNotFound()
+    expect((await NewsletterSubscription.first({ email: 'reader@example.com' }))?.confirmedAt).toBeNull()
+
+    await http.get(`/newsletter/confirm/${'a'.repeat(64)}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ email: 'reader@example.com' }))?.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given address', async () => {
+    await NewsletterSubscription.create({ email: 'reader@example.com', token: 'a'.repeat(64) })
+    await NewsletterSubscription.create({ email: 'other@example.com', token: 'b'.repeat(64) })
+
+    await (await client()).post('/newsletter/unsubscribe', { email: 'reader@example.com' }).assertRedirect(referer)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((row) => row.email)).toEqual(['other@example.com'])
+  })
+})
