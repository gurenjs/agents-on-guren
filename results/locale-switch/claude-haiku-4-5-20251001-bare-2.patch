new file mode 100644
index 0000000..1baad08
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,19 @@
+import { Controller, ValidationException } from '@guren/core'
+import { LocaleSchema } from '../Validators/LocaleValidator.js'
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = await this.validateBody(LocaleSchema)
+
+    const referer = this.request.header('referer') ?? '/'
+    const redirectUrl = new URL(referer)
+
+    // Create a redirect response
+    const response = this.redirect(redirectUrl.pathname + redirectUrl.search)
+
+    // Set the locale cookie
+    response.headers.set('Set-Cookie', `locale=${locale}; Path=/; Max-Age=31536000; SameSite=Lax`)
+
+    return response
+  }
+}
