+
+# Scheduled posts are hidden by a query-time visibility rule
+
+## Context
+
+Authors write ahead of a launch, but a post went live the moment it was
+saved. Editorial wants to save now and publish at a chosen time, without
+anyone pressing a button — and without anything having to run — at that
+moment.
+
+## Decision
+
+- `posts.published_at` is a nullable text column holding an ISO 8601 UTC
+  instant, always written as `Date#toISOString()` output. `NULL` or a past
+  instant means public; a future instant means scheduled.
+- There is no status column and no job. Whether a post is public is decided
+  by comparing `published_at` with the clock on every read, so a post goes
+  live by time passing alone.
+- `Post.visibleTo(viewerId)` is the one query every visitor-facing read
+  starts from: public posts, plus the viewer's own. The posts list, search
+  and a post's page use it with the signed-in user; the home page uses the
+  guest's view for everyone.
+- A scheduled post answers **404** to anyone but its author, on its page and
+  on edit, update and delete alike. The lookup runs before the policy, since
+  a 403 would confirm that the post exists.
+- The request field is `publishAt` and must carry an offset (`Z` or
+  `+02:00`); it is normalized to UTC before it is stored. Absent or `null`
+  means publish now, on update too: `PUT` replaces the date like any other
+  field.
+- `bun run console posts:scheduled` prints `<id>\t<title>\t<published_at>`
+  per scheduled post, soonest first, and nothing else on stdout.
+  `bin/console.ts` sends boot diagnostics to stderr to keep it that way.
+
+## Consequences
+
+- The column is compared as text. That orders like the instants only while
+  every value has the `toISOString()` shape, so anything writing
+  `published_at` outside the controller has to keep to it.
+- A new query that lists posts to visitors must start from
+  `Post.visibleTo()`; `Post.newQuery()` returns scheduled posts too.
+- Visibility follows the server's clock. A post cannot be unpublished other
+  than by giving it a future date.
diff --git a/resources/js/components/PublishAtField.tsx b/resources/js/components/PublishAtField.tsx
new file mode 100644
index 0000000..eba3a59
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,54 @@
+import { useEffect, useState } from 'react'
+
+interface Props {
+  /** ISO 8601 UTC instant, or null to publish as soon as the post is saved. */
+  value: string | null
+  onChange: (value: string | null) => void
+  error?: string
+  className?: string
+}
+
+// A datetime-local input speaks the browser's local time without an offset;
+// the server only accepts an instant with one.
+function toLocalInputValue(iso: string | null): string {
+  if (!iso) {
+    return ''
+  }
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) {
+    return ''
+  }
+  const pad = (part: number) => String(part).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+function toInstant(local: string): string | null {
+  const date = new Date(local)
+  return local === '' || Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  // The server renders in its own time zone, so the local time is filled in
+  // only after hydration, when the browser's zone is known.
+  const [hydrated, setHydrated] = useState(false)
+  useEffect(() => setHydrated(true), [])
+
+  return (
+    <div>
+      <label htmlFor="publish-at" className="block text-sm font-bold text-g-heading">
+        Publish at
+      </label>
+      <input
+        id="publish-at"
+        type="datetime-local"
+        value={hydrated ? toLocalInputValue(value) : ''}
+        onChange={(event) => onChange(toInstant(event.target.value))}
+        className={className}
+      />
+      <p className="mt-1 text-sm text-g-muted">
+        In your local time. Leave empty to publish as soon as the post is saved.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
diff --git a/resources/js/components/ScheduledNotice.tsx b/resources/js/components/ScheduledNotice.tsx
new file mode 100644
