diff --git a/tests/AuthLocalization.test.ts b/tests/AuthLocalization.test.ts
new file mode 100644
index 0000000..621ef1e
--- /dev/null
+++ b/tests/AuthLocalization.test.ts
@@ -0,0 +1,195 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readdirSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import renderSsr from '../resources/js/ssr.js'
+
+const LANG_DIR = fileURLToPath(new URL('../lang', import.meta.url))
+
+type Catalog = { [key: string]: string | Catalog }
+
+/** Flatten `{ login: { title: 'x' } }` into `{ 'login.title': 'x' }`. */
+function flatten(messages: Catalog, prefix = ''): Record<string, string> {
+  const flat: Record<string, string> = {}
+  for (const [key, value] of Object.entries(messages)) {
+    const path = prefix ? `${prefix}.${key}` : key
+    if (typeof value === 'string') {
+      flat[path] = value
+    } else {
+      Object.assign(flat, flatten(value, path))
+    }
+  }
+  return flat
+}
+
+/** Every `<file>.<dotted.key>` under `lang/<locale>/`, the way the Translator sees them. */
+async function loadCatalog(locale: string): Promise<Record<string, string>> {
+  const files = readdirSync(`${LANG_DIR}/${locale}`).filter((file) => file.endsWith('.json')).sort()
+  const flat: Record<string, string> = {}
+  for (const file of files) {
+    const messages = (await import(`${LANG_DIR}/${locale}/${file}`, { with: { type: 'json' } })).default
+    Object.assign(flat, flatten(messages, file.replace(/\.json$/, '')))
+  }
+  return flat
+}
+
+interface RenderedPage {
+  /** Locale of the `_i18n` prop the server shared with the page. */
+  locale: string
+  /** `<html lang>` of the document. */
+  lang: string
+  /** Document title. */
+  title: string
+  /** Copy a visitor reads, from rendering the page component with its props. */
+  text: string
+}
+
+/**
+ * Request a page, then run the props it came back with through the app's own
+ * SSR entry — the same render `bin/serve.ts` serves — so the assertions below
+ * are about the copy on the page, not just the catalog behind it.
+ */
+async function render(http: TestApp, path: string, acceptLanguage?: string): Promise<RenderedPage> {
+  const client = acceptLanguage ? http.withHeaders({ 'Accept-Language': acceptLanguage }) : http
+  const html = await ((await client.get(path)).response as Response).text()
+  const page = JSON.parse(
+    html.slice(html.indexOf('data-page="app"')).replace(/^[^>]+>/, '').split('</script>')[0]!,
+  )
+  const rendered = await renderSsr({ page })
+
+  return {
+    locale: page.props._i18n.locale as string,
+    lang: html.match(/<html lang="([^"]*)"/)?.[1] ?? '',
+    title: [...rendered.head, html].join('').match(/<title[^>]*>([^<]*)<\/title>/)?.[1] ?? '',
+    text: rendered.body
+      // The body carries the serialized page (catalogs included) alongside the
+      // markup; only the markup is copy a visitor reads.
+      .replace(/<script[^>]*>[\s\S]*?<\/script>/g, ' ')
+      .replace(/<[^>]+>/g, ' ')
+      .replace(/&#x27;|&apos;/g, "'")
+      .replace(/\s+/g, ' '),
+  }
+}
+
+describe('translation catalogs', () => {
+  it('translates every English key into Japanese, and nothing more', async () => {
+    const en = await loadCatalog('en')
+    const ja = await loadCatalog('ja')
+
+    expect(Object.keys(ja).sort()).toEqual(Object.keys(en).sort())
+  })
+
+  it('keeps every placeholder of an English string in its Japanese counterpart', async () => {
+    const en = await loadCatalog('en')
+    const ja = await loadCatalog('ja')
+    const placeholders = (value: string) => (value.match(/:[a-zA-Z_][a-zA-Z0-9_]*|\{[^}]+\}/g) ?? []).sort()
+
+    for (const [key, english] of Object.entries(en)) {
+      expect({ key, placeholders: placeholders(ja[key]!) }).toEqual({ key, placeholders: placeholders(english) })
+    }
+  })
+
+  it('translates the welcome message, placeholder included', async () => {
+    expect((await loadCatalog('ja'))['messages.welcome']).toBe(':nameへようこそ！')
+  })
+})
+
+describe('auth pages follow Accept-Language', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  // A bare locale, a region-tagged one, and what a Japanese browser sends.
+  const japanese = ['ja', 'ja-JP', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7']
+  // No header at all, plain English, English outranking Japanese, and a
+  // language this app has no catalog for.
+  const english = [undefined, 'en', 'en-US,en;q=0.9', 'en-US,en;q=0.9,ja;q=0.5', 'fr-FR,fr;q=0.9']
+
+  for (const header of japanese) {
+    it(`renders /login in Japanese for '${header}'`, async () => {
+      const page = await render(http, '/login', header)
+
+      expect(page.locale).toBe('ja')
+      expect(page.lang).toBe('ja')
+      expect(page.title).toBe('ログイン')
+      for (const copy of [
+        'ログイン',
+        'アカウントの認証情報を入力して続行してください。',
+        'メールアドレス',
+        'パスワード',
+        'ログイン状態を保持する',
+        'アカウントをお持ちでないですか？',
+        'アカウント登録',
+      ]) {
+        expect(page.text).toContain(copy)
+      }
+      expect(page.text).not.toContain('Use your account credentials to continue.')
+    })
+
+    it(`renders /register in Japanese for '${header}'`, async () => {
+      const page = await render(http, '/register', header)
+
+      expect(page.locale).toBe('ja')
+      expect(page.lang).toBe('ja')
+      expect(page.title).toBe('アカウント登録')
+      for (const copy of [
+        'アカウント登録',
+        'アカウントを作成して始めましょう。',
+        '名前',
+        'メールアドレス',
+        'パスワード（確認）',
+        '登録',
+        'すでにアカウントをお持ちですか？',
+        'ログイン',
+      ]) {
+        expect(page.text).toContain(copy)
+      }
+      expect(page.text).not.toContain('Sign up to get started.')
+    })
+  }
+
+  for (const header of english) {
+    it(`renders /login in English for '${header ?? 'no Accept-Language'}'`, async () => {
+      const page = await render(http, '/login', header)
+
+      expect(page.locale).toBe('en')
+      expect(page.lang).toBe('en')
+      expect(page.title).toBe('Sign in')
+      for (const copy of [
+        'Sign in',
+        'Use your account credentials to continue.',
+        'Email',
+        'Password',
+        'Remember me',
+        "Don't have an account?",
+        'Sign up',
+      ]) {
+        expect(page.text).toContain(copy)
+      }
+    })
+
+    it(`renders /register in English for '${header ?? 'no Accept-Language'}'`, async () => {
+      const page = await render(http, '/register', header)
+
+      expect(page.locale).toBe('en')
+      expect(page.lang).toBe('en')
+      expect(page.title).toBe('Sign up')
+      for (const copy of [
+        'Create an account',
+        'Sign up to get started.',
+        'Name',
+        'Email',
+        'Password',
+        'Confirm password',
+        'Create account',
+        'Already have an account?',
+        'Sign in',
+      ]) {
+        expect(page.text).toContain(copy)
+      }
+    })
+  }
+})
