+++ b/modules/newsletter/routes.ts
@@ -0,0 +1,26 @@
+import { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import {
+  SubscribeSchema,
+  UnsubscribeSchema,
+  ConfirmTokenParamSchema,
+} from './app/Http/Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(baseRouter: Router): void {
+  baseRouter.group('/newsletter', (group) => {
+    group.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [
+      NewsletterController,
+      'subscribe',
+    ])
+
+    group.get('/confirm/:token', { name: 'newsletter.confirm', params: ConfirmTokenParamSchema }, [
+      NewsletterController,
+      'confirm',
+    ])
+
+    group.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [
+      NewsletterController,
+      'unsubscribe',
+    ])
+  })
+}
