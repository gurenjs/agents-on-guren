+++ b/tests/LoginRateLimit.test.ts
@@ -0,0 +1,41 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// POST /login has no body schema at the route level (LoginController validates
+// it itself), so these requests reach the rate limiter and get rejected there
+// before ever touching the database — no fixtures needed to exercise the throttle.
+describe('login rate limiting', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const base = await TestApp.fromApp(app)
+    http = await base.withCsrf('/login')
+  })
+
+  it('allows 5 attempts per minute, then throttles the 6th with 429 and Retry-After', async () => {
+    for (let attempt = 0; attempt < 5; attempt += 1) {
+      const response = await http.post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+      if (response.status === 429) {
+        throw new Error(`attempt ${attempt + 1} was throttled but should not have been`)
+      }
+    }
+
+    await http
+      .post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+      .assertStatus(429)
+      .assertHeader('Retry-After')
+
+    // Once throttled, even a well-formed submission is refused the same way.
+    await http
+      .post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+      .assertStatus(429)
+      .assertHeader('Retry-After')
+  })
+
+  it('leaves unrelated routes unaffected while POST /login is throttled', async () => {
+    await http.get('/login').assertOk()
+    await http.get('/').assertOk()
+    await http.get('/posts').assertOk()
+  })
+})
