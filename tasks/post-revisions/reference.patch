index 0000000..781da0f
--- /dev/null
+++ b/app/Http/Controllers/PostRevisionController.ts
@@ -0,0 +1,46 @@
+import { Controller } from '@guren/core'
+import { pages } from '@/.guren/pages.gen'
+import { Post } from '../../Models/Post.js'
+import { PostRevision } from '../../Models/PostRevision.js'
+
+export default class PostRevisionController extends Controller {
+  async index(): Promise<Response> {
+    const { id } = this.validated('posts.revisions.index').params
+    const post = await Post.findOrFail(id)
+    await this.authorize('viewRevisions', [Post, post])
+
+    const revisions = await PostRevision.where('postId', post.id)
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: { id: post.id, title: post.title },
+      revisions: revisions.map((revision) => ({
+        id: revision.id,
+        title: revision.title,
+        createdAt: new Date(revision.createdAt).toISOString(),
+      })),
+    })
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validated('posts.revisions.restore').params
+    const post = await Post.findOrFail(id)
+    await this.authorize('restoreRevision', [Post, post])
+
+    // Scoped to the post in the URL: a revision of another post is a 404, never copied over.
+    const revision = await PostRevision.where({ id: revisionId, postId: post.id }).firstOrFail()
+
+    await Post.transaction(async (trx) => {
+      await PostRevision.capture(post, trx)
+      await Post.update(
+        { id: post.id },
+        { title: revision.title, excerpt: revision.excerpt, body: revision.body },
+        { trx },
+      )
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
