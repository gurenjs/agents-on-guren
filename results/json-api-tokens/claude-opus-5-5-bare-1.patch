+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { requireApiToken, throttleApiToken } from '../app/Auth/ApiTokens.js'
+
+// JSON API authenticated by personal API tokens (`Authorization: Bearer`),
+// never by the session. Aliased so `guren audit` can see the protection.
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api.token', requireApiToken)
+    .aliasMiddleware('api.throttle', throttleApiToken)
+
+  // Authentication first: the throttle is keyed on the token it resolved.
+  router.group('/api', (api) => {
+    api.middleware('api.token', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', [ApiPostController, 'store']).name('api.posts.store')
+    })
+  })
+}
