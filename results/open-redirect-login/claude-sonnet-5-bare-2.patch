--- /dev/null
+++ b/tests/LoginController.test.ts
@@ -0,0 +1,61 @@
+import { afterAll, beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+
+// Regression coverage for the open-redirect fix in LoginController: the
+// `redirect` param must only ever send a signed-in user to a same-app path.
+describe('login', () => {
+  let http: TestApp
+  const email = 'login-redirect-test@example.com'
+  const password = 'correct-horse-battery-staple'
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await User.create({ name: 'Redirect Test', email, password })
+  })
+
+  afterAll(async () => {
+    await User.delete({ email })
+  })
+
+  it('sends the user to the requested in-app path after signing in', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password, redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('falls back to the default destination when there is no redirect', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf.post('/login', { email, password }).assertRedirect('/dashboard')
+  })
+
+  it('ignores an absolute URL redirect and uses the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password, redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a protocol-relative redirect and uses the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password, redirect: '//evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a backslash redirect variant and uses the default destination', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password, redirect: '/\\evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('rejects an invalid password without signing the user in', async () => {
+    const csrf = await http.withCsrf('/login')
+    await csrf
+      .post('/login', { email, password: 'wrong-password', redirect: '/posts/3/edit' })
+      .assertUnprocessable()
+  })
+})
