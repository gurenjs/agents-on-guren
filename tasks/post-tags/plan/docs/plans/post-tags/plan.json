      "acceptance": [
        {
          "id": "AC-post-tags-1",
          "description": "Creating a post with tags \"bun, webdev\" stores both tags and the post page shows them.",
          "kind": "success",
          "actor": "user",
          "route": "route.posts.store",
          "given": [
            "no tags exist"
          ],
          "input": [
            {
              "name": "title",
              "json": "\"Tagged\""
            },
            {
              "name": "excerpt",
              "json": "\"An excerpt\""
            },
            {
              "name": "body",
              "json": "\"A body\""
            },
            {
              "name": "tags",
              "json": "\"bun, webdev\""
            }
          ],
          "expect": {
            "status": 303,
            "database": [
              {
                "table": "tags",
                "has": [
                  {
                    "name": "name",
                    "json": "\"bun\""
                  }
                ]
              },
              {
                "table": "tags",
                "has": [
                  {
                    "name": "name",
                    "json": "\"webdev\""
                  }
                ]
              },
              {
                "table": "post_tags"
              }
            ]
          }
        },
        {
          "id": "AC-post-tags-2",
          "description": "Editing a post tagged bun and webdev down to \"bun\" disassociates webdev.",
          "kind": "state",
          "actor": "author",
          "route": "route.posts.update",
          "given": [
            "the author's post is tagged bun and webdev"
          ],
          "input": [
            {
              "name": "title",
