+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,114 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, type ApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The App MCP endpoint (/mcp, mounted by mcpPlugin in src/app.ts) serves the
+// routes declaring `.agent()` in routes/web.ts. A bearer from the app's token
+// store authenticates each call as the token's user.
+
+interface ToolResult {
+  isError?: boolean
+  structuredContent?: Record<string, unknown>
+  content?: Array<{ type: string, text?: string }>
+}
+
+// Streamable HTTP answers either plain JSON or a single SSE `message` event.
+async function rpcBody(text: string): Promise<{ result?: any, error?: unknown }> {
+  const data = text.includes('data:')
+    ? text.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5)).join('')
+    : text
+  return JSON.parse(data)
+}
+
+function payload(result: ToolResult): Record<string, unknown> {
+  if (result.structuredContent) return result.structuredContent
+  const text = result.content?.find((item) => item.type === 'text')?.text ?? '{}'
+  return JSON.parse(text)
+}
+
+describe('App MCP endpoint', () => {
+  let http: TestApp
+  let bearer: string
+  let userId: number
+  let nextId = 1
+
+  async function mcp(method: string, params: Record<string, unknown>, token: string | null = bearer) {
+    const headers: Record<string, string> = {
+      Accept: 'application/json, text/event-stream',
+      'Content-Type': 'application/json',
+    }
+    if (token) headers.Authorization = `Bearer ${token}`
+    const response = await http.withHeaders(headers).post('/mcp', { jsonrpc: '2.0', id: nextId++, method, params })
+    return { status: response.status, body: response.status === 200 ? await rpcBody(await response.text()) : null }
+  }
+
+  async function callTool(name: string, args: Record<string, unknown>, token: string | null = bearer): Promise<ToolResult> {
+    const { body } = await mcp('tools/call', { name, arguments: args }, token)
+    return body!.result as ToolResult
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    const user = await User.create({
+      name: 'MCP Author',
+      email: `mcp-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+      password: 'secret-password',
+    })
+    userId = Number((user as { id: number }).id)
+    const store = app.auth.getApiTokenStore() as ApiTokenStore
+    const issued = await createApiToken(store, { name: 'mcp-test', userId, abilities: ['tools:*'] })
+    bearer = issued.plainTextToken
+  })
+
+  afterAll(async () => {
+    await Post.delete({ authorId: userId })
+  })
+
+  it('refuses a call without a credential', async () => {
+    const { status } = await mcp('tools/list', {}, null)
+    expect(status).toBe(401)
+  })
+
+  it('lists exactly the two post tools with their read-only flags', async () => {
+    const { body } = await mcp('tools/list', {})
+    const tools = (body!.result.tools as Array<{ name: string, annotations?: { readOnlyHint?: boolean } }>)
+      .filter((tool) => !tool.name.startsWith('guren_'))
+    const byName = Object.fromEntries(tools.map((tool) => [tool.name, tool.annotations?.readOnlyHint]))
+    expect(byName).toEqual({ posts_search: true, posts_store: false })
+  })
+
+  it('creates a post as the token user, ignoring a supplied authorId', async () => {
+    const title = `MCP post ${Date.now()}`
+    const result = await callTool('posts_store', { title, excerpt: 'From an assistant', body: 'Body text', authorId: 999999 })
+    expect(result.isError).not.toBe(true)
+
+    const created = await Post.where({ title }).first()
+    expect(created).not.toBeNull()
+    expect(Number(created!.authorId)).toBe(userId)
+  })
+
+  it('rejects input the form would reject with 422 and creates nothing', async () => {
+    const before = await Post.where({ authorId: userId }).get()
+    const result = await callTool('posts_store', { title: '', excerpt: 'x', body: 'y' })
+    expect(result.isError).toBe(true)
+    // The body of the route's 422: the same validation errors the form shows.
+    expect(payload(result).errors).toEqual({ title: ['Title is required.'] })
+    const after = await Post.where({ authorId: userId }).get()
+    expect(after.length).toBe(before.length)
+  })
+
+  it('searches posts with the same result as the QUERY route', async () => {
+    const title = `Searchable ${Date.now()}`
+    await callTool('posts_store', { title, excerpt: 'About Bun', body: 'Body' })
+
+    const result = await callTool('posts_search', { keywords: [title], limit: 5 })
+    const viaHttp = await (await http.query('/posts/search', { keywords: [title], limit: 5 })).json()
+    expect(payload(result)).toEqual(viaHttp as Record<string, unknown>)
+    expect((payload(result).data as unknown[]).length).toBe(1)
+  })
+})
