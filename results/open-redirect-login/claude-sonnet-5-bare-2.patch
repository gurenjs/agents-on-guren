+const DEFAULT_REDIRECT = '/dashboard'
+
+// Only same-app paths are safe post-login destinations. Reject anything a
+// browser would treat as pointing off-origin: absolute URLs with a scheme,
+// protocol-relative URLs ("//evil.example"), and the backslash variants
+// ("/\evil.example") browsers normalize the same way.
+function sanitizeRedirect(value: string | undefined | null): string {
+  const trimmed = value?.trim() ?? ''
+  return /^\/(?!\/|\\)/.test(trimmed) ? trimmed : DEFAULT_REDIRECT
+}
