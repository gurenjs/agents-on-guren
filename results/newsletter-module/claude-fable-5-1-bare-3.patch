+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import {
+  NewsletterSubscribeSchema,
+  NewsletterTokenParamSchema,
+  NewsletterUnsubscribeSchema,
+} from './app/Http/Validators/NewsletterValidator.js'
+
+// Mounted under the module's `/newsletter` prefix. Open to guests and
+// signed-in visitors alike, so no auth middleware is applied.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: NewsletterSubscribeSchema }, [NewsletterController, 'subscribe'])
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: NewsletterUnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+  // A GET that changes state, because it is followed from a link in an email.
+  router.get('/confirm/:token', { name: 'newsletter.confirm', params: NewsletterTokenParamSchema }, [NewsletterController, 'confirm'])
+}
