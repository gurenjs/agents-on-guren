diff --git a/app/Http/Controllers/CommentController.ts b/app/Http/Controllers/CommentController.ts
new file mode 100644
index 0000000..39096f7
--- /dev/null
+++ b/app/Http/Controllers/CommentController.ts
@@ -0,0 +1,49 @@
+import { Controller } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+import { Post } from '../../Models/Post.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CommentIdParamSchema } from '../Validators/CommentValidator.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+
+export default class CommentController extends Controller {
+  async store(): Promise<Response> {
+    const { id: postId } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(postId)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('posts.comments.store')
+
+    // forceCreate, because postId and userId are deliberately absent from Comment.fillable
+    await Comment.forceCreate({ ...data, postId: post.id, userId: author.id })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+
+  async destroy(): Promise<Response> {
+    const { id } = this.validateParams(CommentIdParamSchema)
+    const comment = await Comment.findOrFail(id)
+    const post = await Post.findOrFail(comment.postId)
+
+    await this.authorize('delete', [Comment, comment, post])
+
+    await Comment.delete({ id: comment.id })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+
+  async report(): Promise<Response> {
+    const { id } = this.validateParams(CommentIdParamSchema)
+    const comment = await Comment.findOrFail(id)
+    const user = await this.auth.userOrFail<UserRecord>()
+
+    const { CommentReport } = await import('../../Models/CommentReport.js')
+
+    // Try to create a new report, but ignore if it already exists (unique constraint violation)
+    try {
+      await CommentReport.forceCreate({ commentId: comment.id, userId: user.id })
+    } catch {
+      // Ignore unique constraint violation
+    }
+
+    return this.noContent()
+  }
+}
diff --git a/app/Http/Controllers/PostController.ts b/app/Http/Controllers/PostController.ts
index 8f702c5..f25f2e6 100644
--- a/app/Http/Controllers/PostController.ts
+++ b/app/Http/Controllers/PostController.ts
@@ -54,8 +54,37 @@ export default class PostController extends Controller {
     const { id } = this.validateParams(PostIdParamSchema)
     const post = await Post.findWithOrFail(id, 'author')
 
+    const { Comment } = await import('../../Models/Comment.js')
+    const { CommentReport } = await import('../../Models/CommentReport.js')
+
+    // Fetch all comments with author for this post
+    const comments = await Comment.newQuery()
+      .with('author')
+      .where('postId', '=', id)
+      .orderBy('createdAt', 'asc')
+      .get()
+
+    // Get all reports for comments on this post
+    const reports = await CommentReport.newQuery()
+      .whereIn('commentId', comments.map((c) => c.id))
+      .get()
+
+    // Count reports by comment
+    const reportCountMap = new Map<number, number>()
+    for (const report of reports) {
+      const count = reportCountMap.get(report.commentId) ?? 0
+      reportCountMap.set(report.commentId, count + 1)
+    }
+
+    // Filter out comments with 3+ reports
+    const { CommentResource } = await import('../Resources/CommentResource.js')
+    const visibleComments = comments
+      .filter((c) => (reportCountMap.get(c.id) ?? 0) < 3)
+      .map((c) => new CommentResource(c).toJSON())
+
     return this.inertia(pages.posts.Show, {
       post: new PostResource(post).toJSON(),
+      comments: visibleComments,
     })
   }
 
diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..08e53cc
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,28 @@
+import { Resource, type WithRelations } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+import type { CommentRecord, CommentAuthorSummary } from '../../Models/Comment.js'
+
+type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author?: CommentAuthorSummary
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentRecord | CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      createdAt: new Date(comment.createdAt).toISOString(),
+      author: this.whenLoaded('author', () => ({
+        id: (comment as CommentWithAuthor).author?.id,
+        name: (comment as CommentWithAuthor).author?.name,
+      })) as CommentAuthorSummary | undefined,
+    }
+  }
+}
