diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..8869e3d
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,69 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+  let reader: Awaited<ReturnType<typeof User.create>>
+  let stranger: Awaited<ReturnType<typeof User.create>>
+  let postId: number
+
+  const as = async (user: typeof owner) => (await http.actingAs(user as never).withCsrf()).json()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Owner', email: 'o@x.test', password: 'secret123' })
+    reader = await User.create({ name: 'Reader', email: 'r@x.test', password: 'secret123' })
+    stranger = await User.create({ name: 'Stranger', email: 's@x.test', password: 'secret123' })
+    const post = await Post.forceCreate({ title: 'T', excerpt: 'E', body: 'B', authorId: Number(owner.id) })
+    postId = post!.id
+  })
+
+  it('sends a guest to login and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('validates the body', async () => {
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: '' }).assertUnprocessable()
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('creates, deletes with permissions, and hides after three reports', async () => {
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect(`/posts/${postId}`)
+    const [comment] = await Comment.all()
+
+    await (await as(stranger)).delete(`/comments/${comment!.id}`).assertForbidden()
+    expect(await Comment.all()).toHaveLength(1)
+
+    for (const user of [owner, reader, stranger]) {
+      await (await as(user)).post(`/comments/${comment!.id}/report`).assertNoContent()
+    }
+    await (await as(stranger)).post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await CommentReport.all()).toHaveLength(3)
+
+    const page = await (await as(reader)).get(`/posts/${postId}`)
+    expect(JSON.stringify(await page.text())).not.toContain('"body":"hi"')
+
+    await (await as(owner)).delete(`/comments/${comment!.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('removes comments with the post', async () => {
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: 'hi' })
+    await (await as(owner)).delete(`/posts/${postId}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
