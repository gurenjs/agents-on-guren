@@ -0,0 +1,81 @@
+import { describe, it } from 'bun:test'
+import { expect } from 'bun:test'
+import { LoginSchema } from '../app/Http/Validators/LoginValidator.js'
+
+describe('LoginValidator', () => {
+  describe('redirect field validation', () => {
+    it('rejects absolute URLs with scheme', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+        redirect: 'https://evil.example',
+      })
+
+      if (result.success) {
+        expect(result.data.redirect).toBe('')
+      }
+    })
+
+    it('rejects protocol-relative URLs', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+        redirect: '//evil.example',
+      })
+
+      if (result.success) {
+        expect(result.data.redirect).toBe('')
+      }
+    })
+
+    it('rejects backslash variants', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+        redirect: '/\\evil.example',
+      })
+
+      if (result.success) {
+        expect(result.data.redirect).toBe('')
+      }
+    })
+
+    it('accepts safe same-origin paths', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+        redirect: '/posts/3/edit',
+      })
+
+      expect(result.success).toBe(true)
+      if (result.success) {
+        expect(result.data.redirect).toBe('/posts/3/edit')
+      }
+    })
+
+    it('handles empty redirect', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+        redirect: '',
+      })
+
+      expect(result.success).toBe(true)
+      if (result.success) {
+        expect(result.data.redirect).toBe('')
+      }
+    })
+
+    it('handles missing redirect', async () => {
+      const result = LoginSchema.safeParse({
+        email: 'user@example.com',
+        password: 'password123',
+      })
+
+      expect(result.success).toBe(true)
+      if (result.success) {
+        expect(result.data.redirect).toBe('')
+      }
+    })
+  })
+})
diff --git a/tests/UrlValidation.test.ts b/tests/UrlValidation.test.ts
new file mode 100644
index 0000000..3bd086e
--- /dev/null
+++ b/tests/UrlValidation.test.ts
@@ -0,0 +1,43 @@
+import { describe, it } from 'bun:test'
+import { expect } from 'bun:test'
+import { validateSafeRedirectUrl } from '../app/Utils/UrlValidation.js'
+
+describe('validateSafeRedirectUrl', () => {
+  it('accepts empty strings', () => {
+    expect(validateSafeRedirectUrl('')).toBe('')
+    expect(validateSafeRedirectUrl(null)).toBe('')
+    expect(validateSafeRedirectUrl(undefined)).toBe('')
+  })
+
+  it('accepts safe same-origin paths', () => {
+    expect(validateSafeRedirectUrl('/dashboard')).toBe('/dashboard')
+    expect(validateSafeRedirectUrl('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(validateSafeRedirectUrl('/profile')).toBe('/profile')
+    expect(validateSafeRedirectUrl('/')).toBe('/')
+    expect(validateSafeRedirectUrl('/path/with?query=string')).toBe('/path/with?query=string')
+    expect(validateSafeRedirectUrl('/path#hash')).toBe('/path#hash')
+  })
+
+  it('rejects absolute URLs with scheme', () => {
+    expect(validateSafeRedirectUrl('https://evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('http://evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('ftp://evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('javascript:alert(1)')).toBe('')
+    expect(validateSafeRedirectUrl('data:text/html,<script>alert(1)</script>')).toBe('')
+  })
+
+  it('rejects protocol-relative URLs', () => {
+    expect(validateSafeRedirectUrl('//evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('//evil.example/path')).toBe('')
+  })
+
+  it('rejects backslash variants', () => {
+    expect(validateSafeRedirectUrl('/\\evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('/\\\\evil.example')).toBe('')
+  })
+
+  it('rejects paths that do not start with /', () => {
+    expect(validateSafeRedirectUrl('evil.example')).toBe('')
+    expect(validateSafeRedirectUrl('path/to/page')).toBe('')
+  })
+})
