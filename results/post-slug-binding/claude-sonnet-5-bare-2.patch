+// Lowercase ASCII letters/digits, words joined by a single '-'. Falls back to
+// 'post' so a title with no ASCII letters or digits (e.g. all emoji) still
+// produces a usable slug.
+export function slugify(title: string): string {
+  const words = title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean)
+  return words.length > 0 ? words.join('-') : 'post'
+}
+
+// Slugs are assigned once at creation and never revisited, so a later title
+// edit can't steal the address an older post already has. Free numbers are
+// found by probing rather than counting, so a deleted `-2` gets reused.
+async function uniqueSlug(title: string): Promise<string> {
+  const base = slugify(title)
+  let candidate = base
+  for (let suffix = 2; await Post.find(candidate, 'slug'); suffix++) {
+    candidate = `${base}-${suffix}`
+  }
+  return candidate
+}
+
