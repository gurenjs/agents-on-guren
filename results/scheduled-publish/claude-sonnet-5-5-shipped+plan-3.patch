 export class Post extends defineModel(posts, {
   // `authorId` is set from the signed-in user, never from request input.
-  fillable: ['title', 'excerpt', 'body'],
+  fillable: ['title', 'excerpt', 'body', 'publishedAt'],
 }) {
+  // Visibility is decided at read time, so nothing has to run when a post goes live.
+  // ISO 8601 UTC strings compare in time order, which the SQL comparison relies on.
+  static visibleTo(viewerId: number | null) {
+    const now = new Date().toISOString()
+    return this.newQuery().where((q) => {
+      q.orWhere('publishedAt', 'is null', null).orWhere('publishedAt', '<=', now)
+      if (viewerId !== null) q.orWhere('authorId', viewerId)
+    })
+  }
+
+  static scheduled() {
+    return this.newQuery().where('publishedAt', '>', new Date().toISOString())
+  }
+
+
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
