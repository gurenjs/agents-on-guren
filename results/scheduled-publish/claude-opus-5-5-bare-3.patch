+
+  /**
+   * Posts the viewer may see: public ones (no `published_at`, or one that has
+   * passed) plus, for a signed-in viewer, their own scheduled posts. Timestamps
+   * are ISO 8601 UTC strings, so comparing them as text orders them in time.
+   */
+  static visibleTo(viewerId: number | null) {
+    const now = new Date().toISOString()
+
+    return Post.newQuery().where((q) => {
+      q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+      if (viewerId !== null) {
+        q.orWhere('authorId', viewerId)
+      }
+    })
+  }
+
+  /** Posts whose `published_at` is still ahead, soonest first. */
+  static scheduled() {
+    return Post.newQuery()
+      .where('publishedAt', '>', new Date().toISOString())
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+  }
 }
 
