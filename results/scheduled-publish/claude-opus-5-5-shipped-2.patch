diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..54931c4
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,120 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import ListScheduledPostsCommand from '../app/Console/Commands/ListScheduledPostsCommand.js'
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2000-01-01T00:00:00.000Z'
+
+interface InertiaPage {
+  props: Record<string, unknown>
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })
+    scheduled = await Post.forceCreate({
+      title: 'Launch day',
+      excerpt: 'Coming soon',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })
+    await Post.forceCreate({ title: 'Already live', excerpt: 'Live', body: 'Body', authorId: author.id })
+  })
+
+  async function inertia(client: TestApp, path: string): Promise<InertiaPage> {
+    const res = await client.withHeaders({ 'X-Inertia': 'true' }).get(path)
+    expect(res.status).toBe(200)
+    return res.json<InertiaPage>()
+  }
+
+  function titles(page: InertiaPage): string[] {
+    return (page.props.data as Array<{ title: string }>).map((post) => post.title)
+  }
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+  })
+
+  it('shows a scheduled post page to its author with publishedAt', async () => {
+    const page = await inertia(http.actingAs(author), `/posts/${scheduled.id}`)
+    expect((page.props.post as { publishedAt: string }).publishedAt).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    expect(titles(await inertia(http, '/posts'))).toEqual(['Already live'])
+    expect(titles(await inertia(http.actingAs(other), '/posts'))).toEqual(['Already live'])
+    expect(titles(await inertia(http.actingAs(author), '/posts'))).toEqual(['Already live', 'Launch day'])
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    const res = await http.json().query('/posts/search', { keywords: ['Launch'] })
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(0)
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    expect(titles(await inertia(http, '/posts'))).toContain('Launch day')
+    const res = await http.json().query('/posts/search', { keywords: ['Launch'] })
+    expect((await res.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+
+  it('stores publishAt from the create form and rejects non-dates', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'Later', excerpt: 'x', body: 'y', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    expect(await Post.first({ title: 'Later' })).toBeNull()
+
+    await csrf.post('/posts', { title: 'Later', excerpt: 'x', body: 'y', publishAt: FUTURE }).assertRedirect()
+    expect((await Post.first({ title: 'Later' }))?.publishedAt).toBe(FUTURE)
+  })
+
+  it('clears the date on edit when publishAt is null', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${scheduled.id}`, { title: 'Launch day', excerpt: 'x', body: 'y', publishAt: null })
+      .assertRedirect()
+    expect((await Post.find(scheduled.id))?.publishedAt).toBeNull()
+  })
+
+  it('reports scheduled posts soonest first as tab-separated lines', async () => {
+    await Post.forceCreate({
+      title: 'Sooner',
+      excerpt: 'x',
+      body: 'y',
+      authorId: other.id,
+      publishedAt: '2998-01-01T00:00:00.000Z',
+    })
+    const lines: string[] = []
+    const write = process.stdout.write
+    process.stdout.write = ((chunk: string) => {
+      lines.push(chunk)
+      return true
+    }) as typeof process.stdout.write
+    try {
+      expect(await new ListScheduledPostsCommand().handle()).toBe(0)
+    } finally {
+      process.stdout.write = write
+    }
+    expect(lines.join('')).toBe(`3\tSooner\t2998-01-01T00:00:00.000Z\n${scheduled.id}\tLaunch day\t${FUTURE}\n`)
+  })
+})
