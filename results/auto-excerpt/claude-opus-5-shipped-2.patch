diff --git a/tests/PostExcerpt.test.ts b/tests/PostExcerpt.test.ts
new file mode 100644
index 0000000..313342d
--- /dev/null
+++ b/tests/PostExcerpt.test.ts
@@ -0,0 +1,109 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+const SENTENCE = 'The quick brown fox jumps over the lazy dog. '
+
+describe('deriveExcerpt', () => {
+  it('returns a short body unchanged, with no ellipsis', () => {
+    expect(deriveExcerpt('  Short and sweet.  ')).toBe('Short and sweet.')
+  })
+
+  it('keeps a body of exactly 140 characters whole', () => {
+    const body = 'a'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('cuts back to the last whitespace when the boundary splits a word', () => {
+    const body = `${SENTENCE.repeat(3)}The quick brown fox`.slice(0, 150)
+    const excerpt = deriveExcerpt(body)
+
+    expect(body).toHaveLength(150)
+    expect(excerpt).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+    expect(excerpt).toHaveLength(139)
+  })
+
+  it('keeps all 140 characters when the boundary lands on whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const excerpt = deriveExcerpt(body)
+
+    expect(body).toHaveLength(170)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt).toHaveLength(141)
+  })
+
+  it('cuts at 140 when the first 140 characters are one unbroken run', () => {
+    const body = `${'a'.repeat(200)} tail`
+    expect(deriveExcerpt(body)).toBe(`${'a'.repeat(140)}…`)
+  })
+})
+
+describe('posts excerpt fallback', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({
+      name: 'Ada',
+      email: 'ada@example.com',
+      password: 'password123',
+    })) as UserRecord
+  })
+
+  it('derives the excerpt when the create form leaves it blank', async () => {
+    const body = SENTENCE.repeat(5).trim()
+    const client = await http.actingAs(author).withCsrf()
+
+    await client.post('/posts', { title: 'Derived', excerpt: '   ', body }).assertRedirect()
+
+    const post = await Post.first({ title: 'Derived' })
+    expect(post?.excerpt).toBe(deriveExcerpt(body))
+  })
+
+  it('stores a provided excerpt as typed', async () => {
+    const client = await http.actingAs(author).withCsrf()
+
+    await client.post('/posts', { title: 'Typed', excerpt: '  Mine.  ', body: SENTENCE.repeat(5) }).assertRedirect()
+
+    const post = await Post.first({ title: 'Typed' })
+    expect(post?.excerpt).toBe('Mine.')
+  })
+
+  it('re-derives from the new body when an update clears the excerpt', async () => {
+    const created = await Post.forceCreate({
+      title: 'Original',
+      excerpt: 'Hand written.',
+      body: 'Original body.',
+      authorId: author.id,
+    })
+    const body = `Rewritten. ${SENTENCE.repeat(5)}`.trim()
+    const client = await http.actingAs(author).withCsrf()
+
+    await client.put(`/posts/${created?.id}`, { title: 'Original', body }).assertRedirect()
+
+    const post = await Post.findOrFail(created?.id as number)
+    expect(post.excerpt).toBe(deriveExcerpt(body))
+  })
+
+  it('still refuses a blank title or body', async () => {
+    const client = await http.actingAs(author).withCsrf()
+
+    await client.json().post('/posts', { title: '   ', body: 'Something.' }).assertUnprocessable()
+    await client.json().post('/posts', { title: 'Fine', body: '   ' }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(0)
+  })
+})
