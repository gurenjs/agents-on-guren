--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,39 @@
+import { defineModel } from '@guren/core'
+import { tags, postTags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {
+  static async namesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+    const byPost = new Map<number, string[]>()
+    if (postIds.length === 0) return byPost
+
+    const links = await PostTag.where({ postId: postIds }).get()
+    const found = await Tag.where({ id: [...new Set(links.map((link) => link.tagId))] }).get()
+    const nameById = new Map(found.map((tag) => [tag.id, tag.name]))
+
+    for (const link of links) {
+      const name = nameById.get(link.tagId)
+      if (name === undefined) continue
+      byPost.set(link.postId, [...(byPost.get(link.postId) ?? []), name])
+    }
+    for (const names of byPost.values()) names.sort()
+    return byPost
+  }
+
+  static async syncForPost(postId: number, names: string[]): Promise<void> {
+    const ids: number[] = []
+    for (const name of names) {
+      const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+      ids.push(tag.id)
+    }
+    await PostTag.delete({ postId })
+    for (const tagId of ids) await PostTag.create({ postId, tagId })
+  }
+}
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
