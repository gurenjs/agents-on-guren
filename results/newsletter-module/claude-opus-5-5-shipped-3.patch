new file mode 100644
index 0000000..c6a392d
--- /dev/null
+++ b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
@@ -0,0 +1,108 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+describe('NewsletterSubscriptionController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function guest(): Promise<TestApp> {
+    const csrf = await http.withCsrf()
+    return csrf.json().withHeader('Referer', REFERER)
+  }
+
+  describe('subscribe', () => {
+    it('stores a pending subscription with a random token and redirects back', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'Reader@Example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0]!.email).toBe('reader@example.com')
+      expect(rows[0]!.confirmedAt).toBeNull()
+      expect(rows[0]!.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to the home page without a same-origin Referer', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .withHeader('Referer', 'https://evil.example/phish')
+        .post('/newsletter/subscribe', { email: 'a@example.com' })
+        .assertRedirect('/')
+    })
+
+    it('issues a different token per subscription', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+      await client.post('/newsletter/subscribe', { email: 'b@example.com' }).assertRedirect()
+
+      const [a, b] = await NewsletterSubscription.all()
+      expect(a!.token).not.toBe(b!.token)
+    })
+
+    it.each([[''], ['not-an-email']])('rejects the invalid email %p', async (email) => {
+      const client = await guest()
+      const res = await client.post('/newsletter/subscribe', { email }).assertUnprocessable()
+      expect((await res.json<{ errors: Record<string, string[]> }>()).errors.email).toBeDefined()
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+      await client
+        .post('/newsletter/subscribe', { email: 'a@example.com' })
+        .assertUnprocessable()
+        .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+      expect(await NewsletterSubscription.all()).toHaveLength(1)
+    })
+  })
+
+  describe('confirm', () => {
+    it('marks the subscription as confirmed and redirects home', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+      const pending = await NewsletterSubscription.first({ email: 'a@example.com' })
+
+      await http.get(`/newsletter/confirm/${pending!.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.find(pending!.id)
+      expect(confirmed!.confirmedAt).not.toBeNull()
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+
+      await http.get('/newsletter/confirm/never-issued-token').assertNotFound()
+
+      const row = await NewsletterSubscription.first({ email: 'a@example.com' })
+      expect(row!.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes only that subscription and redirects back', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+      await client.post('/newsletter/subscribe', { email: 'b@example.com' }).assertRedirect()
+
+      await client.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows.map((row) => row.email)).toEqual(['b@example.com'])
+    })
+  })
+})
