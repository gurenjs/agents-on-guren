+function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+
+  if (trimmed.length <= 140) {
+    return trimmed
+  }
+
+  const first140 = trimmed.slice(0, 140)
+
+  // Check if character 141 exists and is non-whitespace (cutting a word)
+  const char141 = trimmed[140]
+  if (char141 && !/\s/.test(char141)) {
+    // Find the last whitespace in the first 140 characters
+    let lastSpaceIndex = -1
+    for (let i = 139; i >= 0; i--) {
+      if (/\s/.test(trimmed[i])) {
+        lastSpaceIndex = i
+        break
+      }
+    }
+
+    // If we found a space, cut there; otherwise cut at 140
+    if (lastSpaceIndex >= 0) {
+      return trimmed.slice(0, lastSpaceIndex).trim() + '…'
+    }
+  }
+
+  return first140.trim() + '…'
+}
+
