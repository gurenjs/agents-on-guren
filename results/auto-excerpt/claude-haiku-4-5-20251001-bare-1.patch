+import { describe, it } from 'bun:test'
+import { expect } from 'bun:test'
+import { deriveExcerpt } from '../app/Utils/excerpts.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body if 140 characters or fewer', () => {
+    const body = 'The quick brown fox jumps over the lazy dog.'
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('returns exactly 140 characters if the body is exactly 140 characters', () => {
+    const body = 'a'.repeat(140)
+    const result = deriveExcerpt(body)
+    expect(result).toBe(body)
+  })
+
+  it('trims leading and trailing whitespace from the body', () => {
+    const body = '  The quick brown fox  '
+    expect(deriveExcerpt(body)).toBe('The quick brown fox')
+  })
+
+  it('cuts at the last whitespace before character 141 if char 141 is non-whitespace', () => {
+    const body = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const result = deriveExcerpt(body)
+    // Character 141 is 'u' in "quick", so we cut at the last space before it
+    expect(result).toBe('The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…')
+  })
+
+  it('keeps all 140 characters if character 141 is whitespace', () => {
+    // Create a body where character 141 is whitespace
+    const first140 = 'a'.repeat(140)
+    const body = first140 + ' more text'
+    const result = deriveExcerpt(body)
+    expect(result).toBe(first140 + '…')
+  })
+
+  it('cuts at 140 if no whitespace is found in the first 140 characters', () => {
+    const body = 'a'.repeat(140) + 'b'.repeat(100)
+    const result = deriveExcerpt(body)
+    expect(result).toBe('a'.repeat(140) + '…')
+  })
+
+  it('works with the first example from the spec', () => {
+    const body = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const result = deriveExcerpt(body)
+    expect(result).toBe('The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…')
+  })
+
+  it('works with the second example from the spec', () => {
+    const body = 'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const result = deriveExcerpt(body)
+    expect(result).toBe('When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…')
+  })
+
+  it('trims trailing whitespace before adding ellipsis', () => {
+    const body = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick  '
+    const result = deriveExcerpt(body)
+    // Should trim the trailing spaces before adding ellipsis
+    expect(result).toBe('The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…')
+  })
+})
