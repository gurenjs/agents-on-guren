+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { apiAuthMiddleware } from '../app/Http/Middleware/ApiAuthMiddleware.js'
+
+export function registerApiRoutes(router: Router): void {
+  router.middleware(apiAuthMiddleware).group((api) => {
+    api.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+    api.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+  })
+}
