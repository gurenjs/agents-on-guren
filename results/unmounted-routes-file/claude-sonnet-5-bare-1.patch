+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// admin.posts.index requires auth, same as posts.create/edit/store/etc. A
+// signed-in request would need a real user and post fixtures — covered by
+// end-to-end tests once the test database is set up. This just proves the
+// route is mounted and gated like every other authed page, not 404ing.
+describe('admin.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects a guest to login instead of 404ing', async () => {
+    await http.get('/admin/posts').assertRedirect('/login')
+  })
+})
