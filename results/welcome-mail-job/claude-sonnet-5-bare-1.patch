diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..a28124b
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,91 @@
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeMail, fakeQueue } from '@guren/testing'
+import { createMailManager, getMailManager, getQueueDriver, processJob, setMailManager, setQueueDriver } from '@guren/core'
+import app from '../src/app.js'
+import { SendWelcomeEmailJob } from '../app/Jobs/SendWelcomeEmailJob.js'
+
+describe('register.store', () => {
+  let http: TestApp
+  let queue: ReturnType<typeof fakeQueue>
+  let mail: ReturnType<typeof fakeMail>
+  let originalQueueDriver: ReturnType<typeof getQueueDriver>
+  let originalMailManager: ReturnType<typeof getMailManager>
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    originalQueueDriver = getQueueDriver()
+    originalMailManager = getMailManager()
+  })
+
+  // The app's real MailProvider already resolved MAIL_FROM_ADDRESS/NAME into
+  // its manager's default `from` — reuse that so the sender assertion below
+  // exercises the actual configured value instead of a value we made up.
+  beforeEach(() => {
+    queue = fakeQueue()
+    mail = fakeMail()
+    setQueueDriver(queue.getDriver())
+
+    const testManager = createMailManager({
+      default: 'fake',
+      from: originalMailManager?.getDefaultFrom(),
+    })
+    testManager.registerTransport('fake', () => mail.getTransport())
+    setMailManager(testManager)
+  })
+
+  afterEach(() => {
+    if (originalQueueDriver) setQueueDriver(originalQueueDriver)
+    if (originalMailManager) setMailManager(originalMailManager)
+  })
+
+  it('queues a welcome email instead of sending it inline, then delivers it once the queue runs it', async () => {
+    const email = `ada-${crypto.randomUUID()}@example.com`
+
+    await http
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email,
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    queue.assertPushedTimes(SendWelcomeEmailJob, 1)
+    mail.assertNothingSent()
+
+    const ranAJob = await processJob(queue.getDriver(), 'default')
+    expect(ranAJob).toBe(true)
+
+    mail.assertSentTimes(1)
+    mail.assertSentTo(email)
+    mail.assertSentWithSubject(`Welcome to ${process.env.APP_NAME}, Ada Lovelace!`)
+  })
+
+  it('queues and sends nothing when registration is refused', async () => {
+    const email = `dup-${crypto.randomUUID()}@example.com`
+
+    await http
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email,
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    queue.clear()
+    mail.clear()
+
+    await http
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email,
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertStatus(422)
+
+    queue.assertNothingPushed()
+    mail.assertNothingSent()
+  })
+})
