diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..f373d72
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,100 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import type { I18nPageProps } from '@guren/inertia-client'
+import app from '../src/app.js'
+
+async function i18nOf(client: TestApp, path: string): Promise<I18nPageProps> {
+  const response = await client.get(path)
+  response.assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props._i18n as I18nPageProps
+}
+
+function localeCookie(headers: Headers): string | undefined {
+  return headers.getSetCookie().find((cookie) => cookie.startsWith('locale='))
+}
+
+describe('POST /locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('remembers the pick and sends the reader back to the Referer', async () => {
+    const csrf = await http.withCsrf()
+    const response = await csrf
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+
+    response.assertRedirect('http://localhost/posts')
+    expect(localeCookie(response.headers)).toStartWith('locale=ja;')
+    expect(localeCookie(response.headers)).toContain('Path=/')
+  })
+
+  it('accepts a relative Referer', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.withHeader('Referer', '/posts?page=2').post('/locale', { locale: 'en' })
+      .assertRedirect('/posts?page=2')
+  })
+
+  it('falls back to / without a Referer, or with a foreign one', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', { locale: 'ja' }).assertRedirect('/')
+    await csrf.withHeader('Referer', 'https://evil.example/phish').post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported or missing locale without touching the cookie', async () => {
+    const csrf = await http.withCsrf()
+    const rejected = await csrf.json().post('/locale', { locale: 'fr' })
+    rejected.assertUnprocessable()
+    expect(localeCookie(rejected.headers)).toBeUndefined()
+
+    await csrf.json().post('/locale', {}).assertUnprocessable()
+  })
+
+  it('is open to signed-in users too', async () => {
+    const csrf = await http.actingAs({ id: 1, name: 'Ada', email: 'ada@example.com' }).withCsrf()
+    await csrf.post('/locale', { locale: 'ja' }).assertRedirect('/')
+  })
+})
+
+describe('_i18n shared prop', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('defaults to English', async () => {
+    const i18n = await i18nOf(http, '/posts')
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en?.nav).toMatchObject({ posts: 'Posts' })
+  })
+
+  it('follows the browser on a first visit', async () => {
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja'), '/posts')).locale).toBe('ja')
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'), '/posts')).locale).toBe('ja')
+    expect((await i18nOf(http.withHeader('Accept-Language', 'fr'), '/posts')).locale).toBe('en')
+  })
+
+  it('serves the Japanese catalog once the reader has picked it', async () => {
+    const csrf = await http.withCsrf()
+    const picked = await csrf.post('/locale', { locale: 'ja' })
+    const cookie = localeCookie(picked.headers)?.split(';')[0]
+    expect(cookie).toBe('locale=ja')
+
+    const i18n = await i18nOf(http.withHeader('Cookie', cookie!), '/posts')
+    expect(i18n.locale).toBe('ja')
+    const ja = i18n.messages.ja!
+    expect(ja.nav).toMatchObject({ home: 'ホーム', posts: '記事', dashboard: 'ダッシュボード' })
+    expect(ja.posts).toMatchObject({ new: '新規投稿', edit: '編集', delete: '削除', search: '検索' })
+    expect(ja.auth).toMatchObject({ login: 'ログイン', logout: 'ログアウト' })
+  })
+
+  it('lets the pick win over the browser', async () => {
+    const client = http.withHeaders({ Cookie: 'locale=en', 'Accept-Language': 'ja' })
+    expect((await i18nOf(client, '/posts')).locale).toBe('en')
+  })
+})
