+import { describe, expect, it } from 'bun:test'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import type { PostRecord } from '../app/Models/Post.js'
+
+// A plain record is enough here: the resource is a pure transform, so this
+// runs without migrations or fixtures. Every field the post pages read has
+// to survive the transform — dropping one silently blanks the UI rather
+// than failing anywhere the type checker can see.
+const record = {
+  id: 1,
+  title: 'Bees',
+  excerpt: 'Bees remember faces',
+  body: 'A longer body.',
+  authorId: 2,
+  createdAt: '2026-08-18T00:00:00.000Z',
+} as unknown as PostRecord
+
+describe('PostResource', () => {
+  it('serializes the fields the post pages render', () => {
+    const data = new PostResource(record).toJSON()
+
+    expect(data).toMatchObject({
+      id: 1,
+      title: 'Bees',
+      excerpt: 'Bees remember faces',
+      body: 'A longer body.',
+      authorId: 2,
+      createdAt: '2026-08-18T00:00:00.000Z',
+    })
+  })
+
+  it('serializes the excerpt for every post in a collection', () => {
+    const [first] = PostResource.collection([record])
+
+    expect(first?.excerpt).toBe('Bees remember faces')
+  })
+})
