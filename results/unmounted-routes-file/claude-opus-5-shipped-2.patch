diff --git a/tests/AdminPostController.test.ts b/tests/AdminPostController.test.ts
new file mode 100644
index 0000000..cc4033c
--- /dev/null
+++ b/tests/AdminPostController.test.ts
@@ -0,0 +1,48 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// admin.posts.index is the JSON feed the moderation tooling polls: every post
+// in the table, newest first, each with its author loaded.
+describe('admin.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects a guest to the login page', async () => {
+    await http.get('/admin/posts').assertRedirect('/login')
+  })
+
+  it('lists every post newest first for a signed-in user', async () => {
+    const author = await User.create({
+      name: 'Ada',
+      email: 'ada@example.com',
+      password: 'password',
+    })
+
+    // authorId is not mass-assignable — the controller sets it from the
+    // signed-in user, so a fixture has to force it in.
+    await Post.forceCreate({ title: 'Older', excerpt: 'a', body: 'a', authorId: author.id })
+    await Post.forceCreate({ title: 'Newer', excerpt: 'b', body: 'b', authorId: author.id })
+
+    await http
+      .actingAs(author)
+      .json()
+      .get('/admin/posts')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Newer')
+      .assertJsonPath('data.1.title', 'Older')
+      .assertJsonPath('data.0.author.id', author.id)
+      .assertJsonPath('data.0.author.name', 'Ada')
+  })
+})
