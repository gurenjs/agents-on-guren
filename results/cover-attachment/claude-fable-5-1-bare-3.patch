@@ -16,10 +16,52 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_CONTENT_TYPES = ['image/png', 'image/jpeg'] as const
+export const COVER_TYPE_MESSAGE = 'Cover must be a PNG or JPEG image.'
+
+// A form submitted without picking a file still sends the field: a browser
+// sends an empty unnamed file, Inertia a null or an empty string. All of them
+// mean "no cover". Only the size is checked here; PostController checks the
+// type, which takes reading the file.
+const CoverSchema = z
+  .union([z.literal(''), z.file().max(COVER_MAX_BYTES, 'Cover must be 2 MB or smaller.')], COVER_TYPE_MESSAGE)
+  .nullish()
+  .transform((value) => (value instanceof File && value.size > 0 ? value : undefined))
+
+// A ticked checkbox arrives as "1" (or "on" from a plain HTML form); an
+// unticked one is not sent at all.
+const CheckboxSchema = z.union([z.boolean(), z.stringbool()]).default(false)
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  cover: CoverSchema,
+})
+
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  removeCover: CheckboxSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+export type PostUpdatePayload = z.infer<typeof PostUpdatePayloadSchema>
+
+/**
+ * The cover's real type, read from its leading bytes. The type a client
+ * declares is only a claim, and these bytes are what the app later serves.
+ */
+export async function sniffCoverContentType(cover: Blob): Promise<(typeof COVER_CONTENT_TYPES)[number] | null> {
+  const head = new Uint8Array(await cover.slice(0, PNG_SIGNATURE.length).arrayBuffer())
+
+  if (PNG_SIGNATURE.every((byte, index) => head[index] === byte)) {
+    return 'image/png'
+  }
+  if (JPEG_SIGNATURE.every((byte, index) => head[index] === byte)) {
+    return 'image/jpeg'
+  }
+  return null
+}
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
