+
+describe('posts.search results', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    const author = await User.create({ name: 'Editor', email: 'editor@example.com', password: 'secret' })
+    const authorId = author?.id as number
+
+    await Post.forceCreate({
+      title: 'A zephyrquill draft',
+      excerpt: 'Not ready for readers yet.',
+      body: 'Unpublished body.',
+      authorId,
+      published: false,
+    })
+    await Post.forceCreate({
+      title: 'The zephyrquill chronicles',
+      excerpt: 'Published and searchable.',
+      body: 'Published body.',
+      authorId,
+      published: true,
+    })
+    await Post.forceCreate({
+      title: 'Marmalade mornings',
+      excerpt: 'Also published, different word.',
+      body: 'Another published body.',
+      authorId,
+      published: true,
+    })
+    await Post.forceCreate({
+      title: 'Something else entirely',
+      excerpt: 'No keyword in here at all.',
+      body: 'Filler.',
+      authorId,
+      published: true,
+    })
+  })
+
+  async function search(keywords: string[]): Promise<string[]> {
+    const response = await http.query('/posts/search', { keywords })
+    response.assertOk()
+    const payload = await response.json<{ data: PostResourceData[] }>()
+    return payload.data.map((post) => post.title)
+  }
+
+  it('returns only published posts matching the keyword', async () => {
+    expect(await search(['zephyrquill'])).toEqual(['The zephyrquill chronicles'])
+  })
+
+  it('keeps unpublished posts out when several keywords are given', async () => {
+    const titles = await search(['zephyrquill', 'marmalade'])
+
+    expect(titles.sort()).toEqual(['Marmalade mornings', 'The zephyrquill chronicles'])
+  })
+
+  it('returns nothing for a word that only appears in unpublished posts', async () => {
+    expect(await search(['ready for readers'])).toEqual([])
+  })
+
+  it('does not pad results with posts that do not match', async () => {
+    expect(await search(['marmalade'])).toEqual(['Marmalade mornings'])
+  })
+})
