+import type { Router } from '@guren/core'
+import SubscriptionController from './app/Http/Controllers/SubscriptionController.js'
+import { SubscriptionPayloadSchema } from './app/Http/Validators/SubscriptionValidator.js'
+
+// Mounted under the module's '/newsletter' prefix (see ./index.ts). Open to
+// guests and signed-in visitors alike.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscriptionPayloadSchema }, [SubscriptionController, 'store'])
+  router.get('/confirm/:token', [SubscriptionController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: SubscriptionPayloadSchema }, [SubscriptionController, 'destroy'])
+}
