+const DEFAULT_REDIRECT = '/dashboard'
+
+// Only a plain same-app path is a safe post-login destination. Resolving the
+// value against a fixed dummy origin and checking the origin survived catches
+// absolute URLs, protocol-relative ("//evil.example"), and backslash
+// variants ("/\evil.example") alike — browsers normalize a leading backslash
+// to a forward slash, so "/\evil.example" is the same attack as "//evil.example".
+function safeRedirectPath(value: string | null | undefined): string | null {
+  if (!value || !value.startsWith('/')) {
+    return null
+  }
+  const dummyOrigin = 'http://same-origin.invalid'
+  let parsed: URL
+  try {
+    parsed = new URL(value, dummyOrigin)
+  } catch {
+    return null
+  }
+  return parsed.origin === dummyOrigin ? value : null
+}
