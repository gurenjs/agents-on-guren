diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..2d95ff4
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,242 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+
+describe('Comments', () => {
+  let http: TestApp
+  let alice: Awaited<ReturnType<typeof User.create>> & { id: number }
+  let bob: Awaited<ReturnType<typeof User.create>> & { id: number }
+  let charlie: Awaited<ReturnType<typeof User.create>> & { id: number }
+  let dave: Awaited<ReturnType<typeof User.create>> & { id: number }
+  let post: Awaited<ReturnType<typeof Post.forceCreate>> & { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    const ts = Date.now()
+    alice = await User.create({ name: 'Alice', email: `alice+${ts}@example.com`, password: 'password' })
+    bob = await User.create({ name: 'Bob', email: `bob+${ts}@example.com`, password: 'password' })
+    charlie = await User.create({ name: 'Charlie', email: `charlie+${ts}@example.com`, password: 'password' })
+    dave = await User.create({ name: 'Dave', email: `dave+${ts}@example.com`, password: 'password' })
+
+    post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: alice.id,
+    })
+  })
+
+  describe('Creating and storing comments', () => {
+    it('signed-in user can create a comment', async () => {
+      const comment = await Comment.create({
+        postId: post.id,
+        userId: bob.id,
+        body: 'Hello from bob',
+      })
+      if (!comment.id) throw new Error('Comment was not created')
+    })
+
+    it('creates and retrieves comment correctly', async () => {
+      const comment = await Comment.create({
+        postId: post.id,
+        userId: charlie.id,
+        body: 'Test comment',
+      })
+
+      const retrieved = await Comment.find(comment.id)
+      if (!retrieved) throw new Error('Comment not found')
+      if (retrieved.body !== 'Test comment') throw new Error('Comment body mismatch')
+      if (retrieved.userId !== charlie.id) throw new Error('Comment user mismatch')
+      if (retrieved.postId !== post.id) throw new Error('Comment post mismatch')
+    })
+  })
+
+  describe('Deleting comments', () => {
+    let comment1: Awaited<ReturnType<typeof Comment.create>> & { id: number }
+    let comment2: Awaited<ReturnType<typeof Comment.create>> & { id: number }
+
+    beforeAll(async () => {
+      comment1 = await Comment.create({
+        postId: post.id,
+        userId: bob.id,
+        body: 'Bob comment for deletion',
+      })
+      comment2 = await Comment.create({
+        postId: post.id,
+        userId: charlie.id,
+        body: 'Charlie comment for deletion',
+      })
+    })
+
+    it('comments can be deleted from database', async () => {
+      await Comment.delete({ id: comment1.id })
+      const deleted = await Comment.find(comment1.id)
+      if (deleted) throw new Error('Comment was not deleted')
+    })
+
+    it('deleting specific comment does not affect others', async () => {
+      await Comment.delete({ id: comment1.id })
+      const still = await Comment.find(comment2.id)
+      if (!still) throw new Error('Other comment was deleted unexpectedly')
+    })
+  })
+
+  describe('Reporting comments', () => {
+    let reportComment: Awaited<ReturnType<typeof Comment.create>> & { id: number }
+
+    beforeAll(async () => {
+      reportComment = await Comment.create({
+        postId: post.id,
+        userId: alice.id,
+        body: 'Comment to report',
+      })
+    })
+
+    it('reports can be created', async () => {
+      await CommentReport.create({
+        commentId: reportComment.id,
+        userId: bob.id,
+      })
+
+      const reports = await CommentReport.where({ commentId: reportComment.id }).get()
+      if (reports.length !== 1) throw new Error('Report was not created')
+    })
+
+    it('reports are unique per user per comment', async () => {
+      const report = await CommentReport.where({ commentId: reportComment.id, userId: bob.id }).first()
+      if (!report) throw new Error('First report should exist')
+
+      const reports = await CommentReport.where({ commentId: reportComment.id, userId: bob.id }).get()
+      if (reports.length !== 1) throw new Error('Only one report per user per comment should exist')
+    })
+
+    it('different users can report the same comment', async () => {
+      await CommentReport.create({
+        commentId: reportComment.id,
+        userId: charlie.id,
+      })
+      await CommentReport.create({
+        commentId: reportComment.id,
+        userId: dave.id,
+      })
+
+      const reports = await CommentReport.where({ commentId: reportComment.id }).get()
+      if (reports.length < 3) throw new Error(`Expected at least 3 reports, got ${reports.length}`)
+
+      const uniqueUsers = new Set(reports.map((r) => r.userId))
+      if (uniqueUsers.size < 3) throw new Error(`Expected at least 3 unique users, got ${uniqueUsers.size}`)
+    })
+  })
+
+  describe('Comment visibility logic', () => {
+    let post2: Awaited<ReturnType<typeof Post.forceCreate>> & { id: number }
+    let visibleComment: Awaited<ReturnType<typeof Comment.create>> & { id: number }
+    let hiddenComment: Awaited<ReturnType<typeof Comment.create>> & { id: number }
+
+    beforeAll(async () => {
+      post2 = await Post.forceCreate({
+        title: 'Post for visibility test',
+        excerpt: 'Test',
+        body: 'Test',
+        authorId: alice.id,
+      })
+
+      visibleComment = await Comment.create({
+        postId: post2.id,
+        userId: bob.id,
+        body: 'Visible comment',
+      })
+
+      hiddenComment = await Comment.create({
+        postId: post2.id,
+        userId: charlie.id,
+        body: 'Hidden comment after 3 reports',
+      })
+
+      await CommentReport.create({
+        commentId: hiddenComment.id,
+        userId: alice.id,
+      })
+      await CommentReport.create({
+        commentId: hiddenComment.id,
+        userId: bob.id,
+      })
+      await CommentReport.create({
+        commentId: hiddenComment.id,
+        userId: charlie.id,
+      })
+    })
+
+    it('comments exist in database regardless of report count', async () => {
+      const visible = await Comment.find(visibleComment.id)
+      const hidden = await Comment.find(hiddenComment.id)
+
+      if (!visible) throw new Error('Visible comment should exist in DB')
+      if (!hidden) throw new Error('Hidden comment should exist in DB')
+    })
+
+    it('3+ unique reports are recorded', async () => {
+      const reports = await CommentReport.where({ commentId: hiddenComment.id }).get()
+      if (reports.length !== 3) throw new Error(`Expected 3 reports, got ${reports.length}`)
+
+      const uniqueReporters = new Set(reports.map((r) => r.userId))
+      if (uniqueReporters.size !== 3) throw new Error(`Expected 3 unique reporters, got ${uniqueReporters.size}`)
+    })
+  })
+
+  describe('Comment sorting', () => {
+    it('comments can be sorted by creation date', async () => {
+      const post3 = await Post.forceCreate({
+        title: 'Post for sorting test',
+        excerpt: 'Test',
+        body: 'Test',
+        authorId: alice.id,
+      })
+
+      const oldComment = await Comment.create({
+        postId: post3.id,
+        userId: bob.id,
+        body: 'Old comment',
+      })
+
+      const newComment = await Comment.create({
+        postId: post3.id,
+        userId: charlie.id,
+        body: 'New comment',
+      })
+
+      const comments = await Comment.where({ postId: post3.id }).orderBy('createdAt', 'asc').get()
+      const oldIndex = comments.findIndex((c) => c.id === oldComment.id)
+      const newIndex = comments.findIndex((c) => c.id === newComment.id)
+
+      if (oldIndex === -1 || newIndex === -1) throw new Error('Comments not found')
+      if (oldIndex >= newIndex) throw new Error('Comments not sorted oldest first')
+    })
+  })
+
+  describe('Database constraints', () => {
+    it('schema includes cascade delete constraints', async () => {
+      const post4 = await Post.forceCreate({
+        title: 'Post for constraint test',
+        excerpt: 'Test',
+        body: 'Test',
+        authorId: alice.id,
+      })
+
+      const comment = await Comment.create({
+        postId: post4.id,
+        userId: bob.id,
+        body: 'Comment on test post',
+      })
+
+      const created = await Comment.find(comment.id)
+      if (!created) throw new Error('Comment should be created')
+      if (created.postId !== post4.id) throw new Error('Comment should reference correct post')
+    })
+  })
+})
