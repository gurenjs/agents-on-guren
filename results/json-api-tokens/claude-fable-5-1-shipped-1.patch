+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+/**
+ * The one store the bearer guard verifies against and the profile issues
+ * from. `createApiToken()` stores a SHA-256 of the secret half; the plain
+ * `{id}|{secret}` string is returned once and never persisted.
+ */
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
diff --git a/app/Http/Controllers/Api/ApiPostController.ts b/app/Http/Controllers/Api/ApiPostController.ts
new file mode 100644
index 0000000..ff995c5
--- /dev/null
+++ b/app/Http/Controllers/Api/ApiPostController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+/**
+ * JSON counterpart of the web PostController for bearer-token scripts. The
+ * routes in routes/api.ts sit behind the token guard and a per-token rate limit.
+ */
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // The schema strips any `authorId` the body carries; the owner comes from
+    // the token. forceCreate because `authorId` is not in Post.fillable.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.created({ data: new PostResource(post).toJSON() })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..a0a493c
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,36 @@
+import { Controller, HttpException, createApiToken, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokenStore.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  // The only response that ever carries the plain token.
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body: { name } } = this.validated('profile.tokens.store')
+
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name,
+      userId: user.id,
+    })
+
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Scoped to the owner, so another user's id is indistinguishable from an
+    // unknown one and their token stays valid.
+    const token = await ApiToken.first({ id, userId: user.id })
+    if (!token) {
+      throw HttpException.notFound('Token not found.')
+    }
+
+    await revokeApiToken(token.id, apiTokenStore)
+
+    return this.noContent()
+  }
+}
