+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { NewsletterEmailSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+// Mounted under the module prefix `/newsletter`. Every route is open to guests:
+// subscribing and unsubscribing only need an email address, and the confirm
+// link is followed from an inbox, outside any session.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: NewsletterEmailSchema }, [
+    NewsletterController,
+    'subscribe',
+  ])
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: NewsletterEmailSchema }, [
+    NewsletterController,
+    'unsubscribe',
+  ])
+}
