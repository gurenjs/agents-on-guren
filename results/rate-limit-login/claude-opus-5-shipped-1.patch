diff --git a/tests/LoginThrottle.test.ts b/tests/LoginThrottle.test.ts
new file mode 100644
index 0000000..c05f636
--- /dev/null
+++ b/tests/LoginThrottle.test.ts
@@ -0,0 +1,99 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { ScryptHasher } from '@guren/core'
+import DatabaseProvider from '../app/Providers/DatabaseProvider.js'
+import AuthProvider from '../app/Providers/AuthProvider.js'
+import AuthorizationProvider from '../app/Providers/AuthorizationProvider.js'
+import { registerWebRoutes } from '../routes/web.js'
+import { migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import {
+  createLoginThrottle,
+  LOGIN_MAX_ATTEMPTS,
+  LOGIN_WINDOW_MS,
+} from '../app/Http/Middleware/LoginThrottle.js'
+
+const EMAIL = 'throttled@example.com'
+const PASSWORD = 'correct-horse'
+
+// A fresh application means a fresh throttle store: the counters are created
+// per route registration, so this suite never inherits another suite's attempts.
+async function bootApp(): Promise<TestApp> {
+  return TestApp.create({
+    auth: {},
+    providers: [DatabaseProvider, AuthProvider, AuthorizationProvider],
+    routes: registerWebRoutes,
+  })
+}
+
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Boot first: DatabaseProvider is what configures the ORM adapter.
+    http = await bootApp()
+    // Ensure the schema exists without wiping rows other suites may rely on.
+    await migrateDatabase()
+
+    const existing = await User.first({ email: EMAIL })
+    if (!existing) {
+      await User.forceCreate({
+        name: 'Throttled User',
+        email: EMAIL,
+        passwordHash: await new ScryptHasher().hash(PASSWORD),
+      })
+    }
+  })
+
+  it('refuses the sixth submission in a minute with 429 and Retry-After', async () => {
+    const csrf = await http.withCsrf('/login')
+
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt += 1) {
+      const response = await csrf.json().post('/login', { email: EMAIL, password: 'wrong' })
+      expect(response.status).not.toBe(429)
+    }
+
+    const throttled = await csrf.json().post('/login', { email: EMAIL, password: 'wrong' })
+    throttled.assertStatus(429)
+
+    const retryAfter = Number(throttled.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(LOGIN_WINDOW_MS / 1000)
+  })
+
+  it('throttles the correct password too, and leaves other pages alone', async () => {
+    // Same client as the test above — still over its limit.
+    const csrf = await http.withCsrf('/login')
+
+    await csrf.json().post('/login', { email: EMAIL, password: PASSWORD }).assertStatus(429)
+
+    await csrf.get('/login').assertOk()
+    await csrf.get('/').assertOk()
+    await csrf.get('/posts').assertOk()
+  })
+
+  it('lets a correct login through while under the limit', async () => {
+    const fresh = await bootApp()
+    const csrf = await fresh.withCsrf('/login')
+
+    await csrf.post('/login', { email: EMAIL, password: PASSWORD }).assertRedirect('/dashboard')
+  })
+
+  it('lets the client submit again once the window has passed', async () => {
+    let clock = 1_000_000
+    const throttle = createLoginThrottle({ now: () => clock })
+    const app = await TestApp.create({
+      routes: (router) => {
+        router.post('/login', (c) => c.json({ ok: true }), throttle)
+      },
+    })
+
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt += 1) {
+      await app.post('/login').assertOk()
+    }
+    await app.post('/login').assertStatus(429)
+
+    clock += LOGIN_WINDOW_MS
+    await app.post('/login').assertOk()
+  })
+})
