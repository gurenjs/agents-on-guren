new file mode 100644
index 0000000..33751b5
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,24 @@
+import { Job } from '@guren/server/queue'
+import { getMailManager } from '@guren/server/mail'
+import { User } from '../Models/User.js'
+import { sendWelcomeEmail } from '../Mail/WelcomeMail.js'
+
+interface SendWelcomeEmailPayload {
+  userId: string | number
+}
+
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailPayload> {
+  static queue = 'default'
+  static maxAttempts = 3
+
+  async handle({ userId }: SendWelcomeEmailPayload): Promise<void> {
+    const user = await User.findOrFail(userId)
+    const mailManager = getMailManager()
+
+    if (!mailManager) {
+      throw new Error('Mail manager not configured')
+    }
+
+    await sendWelcomeEmail(mailManager, user)
+  }
+}
diff --git a/app/Mail/WelcomeMail.ts b/app/Mail/WelcomeMail.ts
new file mode 100644
index 0000000..71355eb
--- /dev/null
+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,13 @@
+import { mail } from '@guren/server/mail'
+import type { MailManager } from '@guren/server/mail'
+import type { UserRecord } from '../Models/User.js'
+
+export async function sendWelcomeEmail(manager: MailManager, user: UserRecord): Promise<void> {
+  const appName = process.env.APP_NAME || 'App'
+
+  await mail(manager)
+    .to({ email: user.email, name: user.name })
+    .subject(`Welcome to ${appName}, ${user.name}!`)
+    .text(`Hello ${user.name},\n\nWelcome to ${appName}! We're excited to have you on board.\n\nBest regards,\nThe ${appName} Team`)
+    .send()
+}
