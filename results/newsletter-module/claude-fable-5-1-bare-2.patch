+
+      const response = await client.post('/newsletter/unsubscribe', { email: 'leaving@example.com' })
+      response.assertRedirect()
+      expect(response.headers.get('location')).toBe('/posts/1')
+
+      expect(await NewsletterSubscription.first({ email: 'leaving@example.com' })).toBeNull()
+      expect(await NewsletterSubscription.first({ email: 'staying@example.com' })).not.toBeNull()
+    })
+  })
+})
