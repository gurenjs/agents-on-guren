@@ -0,0 +1,67 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// profile.update validates its body with ProfileUpdateSchema before touching
+// the account, so a badly formatted email is a 422 and the stored row is
+// untouched — and fields outside the schema (id, passwordHash) never reach
+// the update at all.
+describe('profile.update', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    // Booting the app configures the ORM the model calls below go through.
+    const client = await TestApp.fromApp(app)
+
+    // The test database persists between runs, and these tests rename the
+    // account they own — clear both spellings so a rerun starts clean.
+    await User.delete({ email: 'profile-tester@example.com' })
+    await User.delete({ email: 'renamed-tester@example.com' })
+
+    user = (await User.create({
+      name: 'Profile Tester',
+      email: 'profile-tester@example.com',
+      password: 'secret-password',
+    })) as UserRecord
+
+    http = await client.actingAs(user).withCsrf('/profile')
+  })
+
+  it('rejects a badly formatted email and leaves the account alone', async () => {
+    await http.put('/profile', { name: 'Renamed', email: 'not-an-email' }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    expect(stored?.email).toBe('profile-tester@example.com')
+    expect(stored?.name).toBe('Profile Tester')
+  })
+
+  it('rejects an empty name', async () => {
+    await http.put('/profile', { name: '   ', email: 'profile-tester@example.com' }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Profile Tester')
+  })
+
+  it('ignores fields the profile form does not have', async () => {
+    const originalHash = (await User.find(user.id))?.passwordHash
+
+    await http
+      .put('/profile', {
+        name: 'Renamed Tester',
+        email: 'Renamed-Tester@Example.com',
+        id: user.id + 1000,
+        passwordHash: 'overwritten',
+      })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Renamed Tester')
+    // Stored lowercased, as the registration form does.
+    expect(stored?.email).toBe('renamed-tester@example.com')
+    expect(stored?.passwordHash).toBe(originalHash)
+  })
+})
