+// Slugs are assigned once, from the title, at creation time — editing the
+// title later must not change the address the post is already published at.
+// There is no `updating` hook here on purpose.
+Post.hooks = {
+  creating: async (data) => {
+    const title = data.title as string
+    const base = slugify(title) || 'post'
+
+    const conflicts = await Post.newQuery()
+      .where('slug', 'like', `${base}%`)
+      .get()
+    const taken = new Set(conflicts.map((post) => post.slug))
+
+    if (!taken.has(base)) {
+      data.slug = base
+      return
+    }
+
+    let suffix = 2
+    while (taken.has(`${base}-${suffix}`)) {
