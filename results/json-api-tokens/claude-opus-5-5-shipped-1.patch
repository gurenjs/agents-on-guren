diff --git a/app/Http/Middleware/ApiTokenMiddleware.ts b/app/Http/Middleware/ApiTokenMiddleware.ts
new file mode 100644
index 0000000..84205ae
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenMiddleware.ts
@@ -0,0 +1,30 @@
+import {
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+
+export const API_RATE_LIMIT_PER_MINUTE = 60
+
+/** Authenticates `Authorization: Bearer <id|secret>`; anything else is a JSON 401. */
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed on the token, not the user, so each of a user's tokens gets its own
+// budget. Must run after authenticateApiToken. The in-memory store is
+// per-process: behind several instances, swap in a shared RateLimitStore.
+export const rateLimitStore = new MemoryRateLimitStore()
+
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT_PER_MINUTE,
+  windowMs: 60_000,
+  store: rateLimitStore,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests.', retryAfter }, 429),
+})
