+export const MAX_TAGS = 5
+export const MAX_TAG_LENGTH = 30
+
+/** Splits the comma-separated `tags` field: trimmed, blanks dropped, duplicates counted once. */
+export function parseTagNames(input: string | undefined): string[] {
+  const names = (input ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+  return [...new Set(names)]
+}
+
+export const ListPostsQuerySchema = z.object({
+  page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().optional(),
+})
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: z
+    .string()
+    .optional()
+    .superRefine((value, ctx) => {
+      const names = parseTagNames(value)
+      if (names.length > MAX_TAGS) {
+        ctx.addIssue({ code: 'custom', message: `Use at most ${MAX_TAGS} tags.` })
+      } else if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+        ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+      }
+    }),
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..28949b3
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,57 @@
+import { and, eq, inArray, notInArray } from 'drizzle-orm'
+import { getDatabase, type AppSeederContext } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+async function connection(): Promise<AppSeederContext['db']> {
+  return (await getDatabase()) as AppSeederContext['db']
+}
+
+/** Attaches a `tags: string[]` (alphabetical) to each post. */
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const byPost = new Map<number, string[]>()
+  if (posts.length > 0) {
+    const rows = await (await connection())
+      .select({ postId: postTags.postId, name: tags.name })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(inArray(postTags.postId, posts.map((post) => post.id)))
+    for (const row of rows) {
+      const names = byPost.get(row.postId) ?? []
+      names.push(row.name)
+      byPost.set(row.postId, names)
+    }
+  }
+
+  return posts.map((post) => ({ ...post, tags: (byPost.get(post.id) ?? []).sort() }))
+}
+
+/** Ids of the posts carrying the tag; empty when nobody uses it. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const rows = await (await connection())
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+  return rows.map((row) => row.postId)
+}
+
+/** Makes the post's tags exactly `names`, creating unseen tags. */
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  const db = await connection()
+
+  if (names.length === 0) {
+    await db.delete(postTags).where(eq(postTags.postId, postId))
+    return
+  }
+
+  await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing()
+  const rows = await db.select().from(tags).where(inArray(tags.name, names))
+  const tagIds = rows.map((row) => row.id)
+
+  await db.delete(postTags).where(and(eq(postTags.postId, postId), notInArray(postTags.tagId, tagIds)))
+  await db.insert(postTags).values(tagIds.map((tagId) => ({ postId, tagId }))).onConflictDoNothing()
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  await (await connection()).delete(postTags).where(eq(postTags.postId, postId))
+}
