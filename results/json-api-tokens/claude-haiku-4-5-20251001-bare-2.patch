diff --git a/app/Utils/RateLimiter.ts b/app/Utils/RateLimiter.ts
new file mode 100644
index 0000000..a8a6ba1
--- /dev/null
+++ b/app/Utils/RateLimiter.ts
@@ -0,0 +1,30 @@
+interface RateLimitEntry {
+  count: number
+  resetAt: number
+}
+
+const rateLimitStore = new Map<string, RateLimitEntry>()
+
+export class RateLimiter {
+  static check(key: string, limit: number = 60, windowMs: number = 60000): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const entry = rateLimitStore.get(key)
+
+    if (!entry || entry.resetAt <= now) {
+      rateLimitStore.set(key, { count: 1, resetAt: now + windowMs })
+      return { allowed: true }
+    }
+
+    if (entry.count < limit) {
+      entry.count++
+      return { allowed: true }
+    }
+
+    const retryAfter = Math.ceil((entry.resetAt - now) / 1000)
+    return { allowed: false, retryAfter }
+  }
+
+  static reset(key: string): void {
+    rateLimitStore.delete(key)
+  }
+}
diff --git a/app/Utils/TokenUtils.ts b/app/Utils/TokenUtils.ts
