+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('posts.destroy authorization', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('refuses to delete another user\'s post and leaves it intact', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const intruder = await User.create({ name: 'Intruder', email: 'intruder@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(intruder).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertForbidden()
+
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('refuses to delete a post as a guest', async () => {
+    const author = await User.create({ name: 'Author', email: 'author2@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/login')
+
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('allows the author to delete their own post', async () => {
+    const author = await User.create({ name: 'Author', email: 'author3@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+})
