+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import crypto from 'crypto'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { NewsletterSubscription } from '../../modules/newsletter/index.js'
+import { resetDatabase } from '../../config/database.js'
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  test('subscribe creates a pending subscription', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/subscribe', { email: 'test@example.com' })
+      .assertRedirect()
+
+    const subscription = await NewsletterSubscription.first({ email: 'test@example.com' })
+    expect(subscription).toBeDefined()
+    expect(subscription?.confirmedAt).toBeNull()
+    expect(subscription?.token).toHaveLength(64)
+  })
+
+  test('subscribe with invalid email returns 422', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/subscribe', { email: 'not-an-email' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'Please enter a valid email address.')
+  })
+
+  test('subscribe with empty email returns 422', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/subscribe', { email: '' })
+      .assertUnprocessable()
+  })
+
+  test('subscribe to same email twice succeeds without creating duplicate', async () => {
+    const email = 'duplicate@example.com'
+
+    const csrf1 = await http.withCsrf()
+    await csrf1
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/subscribe', { email })
+      .assertRedirect()
+
+    const firstSub = await NewsletterSubscription.first({ email })
+    expect(firstSub).toBeDefined()
+
+    const csrf2 = await http.withCsrf()
+    await csrf2
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/subscribe', { email })
+      .assertRedirect()
+
+    const count = await NewsletterSubscription.where({ email }).count()
+    expect(count).toBe(1)
+  })
+
+  test('subscribe redirects to referer', async () => {
+    const referer = 'http://localhost/posts/1'
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .withHeader('referer', referer)
+      .post('/newsletter/subscribe', { email: 'referer@example.com' })
+
+    expect(res.status).toBe(303)
+    expect(res.headers.get('Location')).toBe(referer)
+  })
+
+  test('subscribe redirects to / when referer is missing', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .post('/newsletter/subscribe', { email: 'noreferer@example.com' })
+
+    expect(res.status).toBe(303)
+    expect(res.headers.get('Location')).toBe('/')
+  })
+
+  test('confirm marks subscription as confirmed', async () => {
+    const email = 'confirm@example.com'
+    const token = crypto.randomBytes(32).toString('hex')
+    const sub = await NewsletterSubscription.create({
+      email,
+      token,
+      confirmedAt: null,
+    })
+
+    await http
+      .json()
+      .get(`/newsletter/confirm/${token}`)
+      .assertRedirect('/')
+
+    const updated = await NewsletterSubscription.findOrFail(sub.id)
+    expect(updated.confirmedAt).toBeDefined()
+    expect(updated.confirmedAt).not.toBeNull()
+  })
+
+  test('confirm with invalid token returns 404', async () => {
+    const res = await http.json().get('/newsletter/confirm/invalid-token-that-does-not-exist')
+
+    expect(res.status).toBe(404)
+  })
+
+  test('unsubscribe deletes subscription', async () => {
+    const email = 'unsubscribe@example.com'
+    const token = crypto.randomBytes(32).toString('hex')
+    await NewsletterSubscription.create({
+      email,
+      token,
+      confirmedAt: null,
+    })
+
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/posts')
+      .post('/newsletter/unsubscribe', { email })
+      .assertRedirect('http://localhost/posts')
+
+    const subscription = await NewsletterSubscription.first({ email })
+    expect(subscription).toBeNull()
+  })
+
+  test('unsubscribe with invalid email returns 422', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/unsubscribe', { email: 'not-an-email' })
+      .assertUnprocessable()
+  })
+
+  test('unsubscribe with empty email returns 422', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/unsubscribe', { email: '' })
+      .assertUnprocessable()
+  })
+
+  test('unsubscribe for non-existent email succeeds silently', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .withHeader('referer', 'http://localhost/')
+      .post('/newsletter/unsubscribe', { email: 'never-subscribed@example.com' })
+
+    expect(res.status).toBe(303)
+  })
+
+  test('unsubscribe redirects to referer', async () => {
+    const referer = 'http://localhost/posts/5'
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .withHeader('referer', referer)
+      .post('/newsletter/unsubscribe', { email: 'unsub-referer@example.com' })
+
+    expect(res.status).toBe(303)
+    expect(res.headers.get('Location')).toBe(referer)
+  })
+
+  test('unsubscribe redirects to / when referer is missing', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .post('/newsletter/unsubscribe', { email: 'unsub-noreferer@example.com' })
+
+    expect(res.status).toBe(303)
+    expect(res.headers.get('Location')).toBe('/')
+  })
+})
