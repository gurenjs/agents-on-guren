+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { NewsletterSubscription } from './app/Models/NewsletterSubscription.js'
+import { NewsletterConfirmParamsSchema, NewsletterEmailSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+// Paths are relative to the module's '/newsletter' prefix (see index.ts).
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: NewsletterEmailSchema }, [NewsletterController, 'subscribe'])
+  router.get('/confirm/:token', {
+    name: 'newsletter.confirm',
+    params: NewsletterConfirmParamsSchema,
+    bind: { token: [NewsletterSubscription, 'token'] },
+  }, [NewsletterController, 'confirm'])
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: NewsletterEmailSchema }, [NewsletterController, 'unsubscribe'])
+}
diff --git a/modules/newsletter/tests/NewsletterController.test.ts b/modules/newsletter/tests/NewsletterController.test.ts
new file mode 100644
index 0000000..7defcaf
