@@ -0,0 +1,23 @@
+import { Controller } from '@guren/core'
+import { createAppHealthManager, healthStatusCode } from '../../Health/index.js'
+
+// Built once — the manager holds no per-request state, and every probe re-runs
+// each registered check against the live dependency.
+const health = createAppHealthManager()
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const report = await health.check()
+
+    // 200/503 is what the platform routes on; the body is for the dashboard,
+    // which reads the per-check breakdown to name the failing dependency.
+    return this.json(
+      {
+        status: report.status,
+        timestamp: report.timestamp.toISOString(),
+        checks: report.checks,
+      },
+      { status: healthStatusCode(report.status) },
+    )
+  }
+}
