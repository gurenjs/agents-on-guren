+    return Post.newQuery().where('id', 'in', tagged)
+  }
+
+  // Makes `names` the post's tags: a name never seen becomes a tag, tags
+  // missing from `names` are detached, and a tag left without posts stays.
+  // Call it in the transaction that writes the post, so the two land together.
+  static async syncTags(postId: number, names: readonly string[]): Promise<void> {
+    const wanted = names.length > 0 ? await Tag.whereIn('name', names) : []
+    const known = new Set(wanted.map((tag) => tag.name))
+    for (const name of names) {
+      if (!known.has(name)) {
+        wanted.push(await Tag.create({ name }))
+      }
+    }
+
+    const attached = (await PostTag.where({ postId })).map((row) => row.tagId)
+    const wantedIds = wanted.map((tag) => tag.id)
+
+    const stale = attached.filter((tagId) => !wantedIds.includes(tagId))
+    if (stale.length > 0) {
+      await PostTag.delete({ postId, tagId: stale })
+    }
+    for (const tagId of wantedIds) {
+      if (!attached.includes(tagId)) {
+        await PostTag.create({ postId, tagId })
+      }
+    }
   }
 }
 
