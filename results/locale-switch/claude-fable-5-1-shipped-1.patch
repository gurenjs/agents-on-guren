diff --git a/resources/js/components/LocaleSwitcher.tsx b/resources/js/components/LocaleSwitcher.tsx
new file mode 100644
index 0000000..31a6a55
--- /dev/null
+++ b/resources/js/components/LocaleSwitcher.tsx
@@ -0,0 +1,34 @@
+import { Link } from '@inertiajs/react'
+import { useTranslation } from '@guren/inertia-client'
+import { supportedLocales } from '@/config/locales'
+import { route } from '@/.guren/routes.gen'
+
+export default function LocaleSwitcher() {
+  const { locale: current, t } = useTranslation()
+
+  return (
+    <div role="group" aria-label={t('nav.language')} className="flex items-center gap-1 font-mono text-xs">
+      {supportedLocales.map((locale) => (
+        // The server redirects back to the Referer, which for this request is
+        // the page the reader is on, so the visit lands there re-rendered.
+        <Link
+          key={locale}
+          href={route('locale.update')}
+          method="post"
+          data={{ locale }}
+          as="button"
+          preserveScroll
+          lang={locale}
+          aria-pressed={locale === current}
+          className={
+            locale === current
+              ? 'rounded-g-ctl border border-g-line-strong px-2 py-1 text-g-heading'
+              : 'rounded-g-ctl border border-transparent px-2 py-1 transition hover:text-g-heading'
+          }
+        >
+          {t(`locale.${locale}`)}
+        </Link>
+      ))}
+    </div>
+  )
+}
