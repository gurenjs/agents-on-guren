+import { describe, it, expect } from 'bun:test'
+import { deriveExcerpt } from '../app/Utils/ExcerptDeriver.js'
+
+describe('deriveExcerpt', () => {
+  it('returns whole body if 140 characters or fewer', () => {
+    const body = 'The quick brown fox'
+    expect(deriveExcerpt(body)).toBe('The quick brown fox')
+  })
+
+  it('trims whitespace from body before checking length', () => {
+    const body = '  The quick brown fox  '
+    expect(deriveExcerpt(body)).toBe('The quick brown fox')
+  })
+
+  it('cuts at 140 chars and adds ellipsis when body is longer', () => {
+    const body = 'a'.repeat(141)
+    const result = deriveExcerpt(body)
+    expect(result).toBe('a'.repeat(140) + '…')
+  })
+
+  it('cuts before word boundary when char 141 is inside a word', () => {
+    // Construct body where first 140 chars end mid-word
+    // First 140: "The quick brown fox ... The q"
+    // Char 141: "u" (inside "quick")
+    const body = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(body.length).toBe(150)
+
+    const result = deriveExcerpt(body)
+    // Should cut at space before "The quick", giving us 138 chars + ellipsis
+    const expected = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+    expect(result).toBe(expected)
+    expect(result.length).toBe(139)
+  })
+
+  it('keeps all 140 chars when char 141 is whitespace', () => {
+    const body = 'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+
+    const result = deriveExcerpt(body)
+    const expected = 'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…'
+    expect(result).toBe(expected)
+    expect(result.length).toBe(141)
+  })
+
+  it('handles body with no whitespace in first 140 chars', () => {
+    const body = 'a'.repeat(150)
+    const result = deriveExcerpt(body)
+    expect(result).toBe('a'.repeat(140) + '…')
+  })
+
+  it('trims trailing whitespace before adding ellipsis', () => {
+    // Create a body that, after first 140 chars, has trailing spaces in the cut section
+    // but still longer than 140 chars overall
+    const body = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The q     uality matters'
+    expect(body.length).toBeGreaterThan(140)
+    const result = deriveExcerpt(body)
+    // Should trim trailing spaces and add ellipsis
+    expect(result.endsWith('…')).toBe(true)
+  })
+
+  it('handles body with 140+ chars and no ellipsis needed', () => {
+    // Body that's exactly 140 characters should be returned as-is with ellipsis only if > 140
+    const body = 'a'.repeat(140) + ' more text here'
+    expect(body.length).toBeGreaterThan(140)
+    const result = deriveExcerpt(body)
+    // Should end with ellipsis since it's longer than 140
+    expect(result.endsWith('…')).toBe(true)
+  })
+})
