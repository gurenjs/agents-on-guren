@@ -0,0 +1,15 @@
+import { z } from 'zod'
+
+export const NewsletterEmailSchema = z.object({
+  // Lowercased so the same address typed with different casing is one subscriber.
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const ConfirmParamsSchema = z.object({
+  token: z.string().min(1),
+})
