@@ -0,0 +1,102 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('profile.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function actingUser() {
+    const user = await User.create({
+      name: 'Original Name',
+      email: 'original@example.com',
+      password: 'correct-horse',
+    })
+    const csrf = await http.actingAs(user).withCsrf()
+    return { user, csrf }
+  }
+
+  it('rejects a badly formatted email and leaves the account unchanged', async () => {
+    const { user, csrf } = await actingUser()
+
+    await csrf
+      .put('/profile', { name: 'Still Me', email: 'not-an-email' })
+      .assertUnprocessable()
+
+    const stored = await User.findOrFail(user.id)
+    if (stored.email !== 'original@example.com') throw new Error('email should not have changed')
+  })
+
+  it('rejects an empty name and leaves the account unchanged', async () => {
+    const { user, csrf } = await actingUser()
+
+    await csrf
+      .put('/profile', { name: '', email: 'original@example.com' })
+      .assertUnprocessable()
+
+    const stored = await User.findOrFail(user.id)
+    if (stored.name !== 'Original Name') throw new Error('name should not have changed')
+  })
+
+  it('ignores unknown fields like id and passwordHash', async () => {
+    const { user, csrf } = await actingUser()
+    const originalHash = (await User.findOrFail(user.id)).passwordHash
+
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'updated@example.com',
+        id: user.id + 999,
+        passwordHash: 'attacker-controlled',
+      })
+      .assertOk()
+
+    const stored = await User.findOrFail(user.id)
+    if (stored.id !== user.id) throw new Error('id should not have changed')
+    if (stored.passwordHash !== originalHash) throw new Error('passwordHash should not have changed')
+    if (stored.name !== 'Updated Name') throw new Error('name should have been updated')
+    if (stored.email !== 'updated@example.com') throw new Error('email should have been updated')
+  })
+
+  it('applies a valid update, lowercasing the email', async () => {
+    const { user, csrf } = await actingUser()
+
+    await csrf
+      .put('/profile', { name: '  Jane Doe  ', email: 'Jane@Example.com' })
+      .assertOk()
+
+    const stored = await User.findOrFail(user.id)
+    if (stored.name !== 'Jane Doe') throw new Error(`unexpected name: ${stored.name}`)
+    if (stored.email !== 'jane@example.com') throw new Error(`unexpected email: ${stored.email}`)
+  })
+
+  it('keeps the current password when the password field is left blank', async () => {
+    const { user, csrf } = await actingUser()
+    const originalHash = (await User.findOrFail(user.id)).passwordHash
+
+    await csrf
+      .put('/profile', { name: 'Original Name', email: 'original@example.com', password: '' })
+      .assertOk()
+
+    const stored = await User.findOrFail(user.id)
+    if (stored.passwordHash !== originalHash) throw new Error('passwordHash should not have changed')
+  })
+
+  it('rejects a too-short password', async () => {
+    const { csrf } = await actingUser()
+
+    await csrf
+      .put('/profile', { name: 'Original Name', email: 'original@example.com', password: 'short' })
+      .assertUnprocessable()
+  })
+})
