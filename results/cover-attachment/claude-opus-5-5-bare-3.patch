diff --git a/app/Http/Validators/PostValidator.ts b/app/Http/Validators/PostValidator.ts
index 804642a..f0a6296 100644
--- a/app/Http/Validators/PostValidator.ts
+++ b/app/Http/Validators/PostValidator.ts
@@ -22,4 +22,50 @@ export const PostPayloadSchema = z.object({
   body: z.string().trim().min(1, 'Body is required.'),
 })
 
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_INVALID_TYPE = 'Cover must be a PNG or JPEG image.'
+
+// Declared types a PNG/JPEG upload may arrive with. Clients that cannot tell
+// send no type or a generic one; the bytes decide in `detectCoverType`.
+const COVER_DECLARED_TYPES = ['image/png', 'image/jpeg', 'image/jpg', 'image/pjpeg', 'application/octet-stream', '']
+
+// An empty file input still submits a nameless, zero-byte part (and Inertia
+// sends null as ''), which means "no new cover", not an invalid one.
+// Codegen cannot express a File, so `cover` reaches the controller typed
+// `unknown`; narrow it with `instanceof File` there.
+const CoverSchema = z.preprocess(
+  (value) => (value === '' || value === null || (value instanceof File && value.size === 0 && value.name === '') ? undefined : value),
+  z
+    .file('Cover must be a file.')
+    .refine((file) => COVER_DECLARED_TYPES.includes(file.type.toLowerCase()), COVER_INVALID_TYPE)
+    .max(COVER_MAX_BYTES, 'Cover must be 2 MB or smaller.')
+    .optional(),
+)
+
+export const PostStorePayloadSchema = PostPayloadSchema.extend({
+  cover: CoverSchema,
+})
+
+export const PostUpdatePayloadSchema = PostStorePayloadSchema.extend({
+  // A ticked checkbox submits "1"; anything else (or nothing) keeps the cover.
+  removeCover: z.preprocess((value) => value === '1' || value === 'on' || value === 'true' || value === true, z.boolean()).optional(),
+})
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+/**
+ * The declared content type is client-chosen, so the file's signature decides
+ * what it is: `image/png`, `image/jpeg`, or null for anything else. Async (it
+ * reads the file), which is why it runs in the controller rather than inside
+ * the synchronously parsed route schema.
+ */
+export async function detectCoverType(file: File): Promise<'image/png' | 'image/jpeg' | null> {
+  const head = new Uint8Array(await file.slice(0, PNG_SIGNATURE.length).arrayBuffer())
+  const startsWith = (signature: number[]) => signature.every((byte, index) => head[index] === byte)
+  if (startsWith(PNG_SIGNATURE)) return 'image/png'
+  if (startsWith(JPEG_SIGNATURE)) return 'image/jpeg'
+  return null
+}
+
 export type PostPayload = z.infer<typeof PostPayloadSchema>
