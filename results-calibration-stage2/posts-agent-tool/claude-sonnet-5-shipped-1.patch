+
+async function rpc(method: string, params: unknown, bearer?: string): Promise<Response> {
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/json',
+      accept: 'application/json, text/event-stream',
+      ...(bearer ? { authorization: `Bearer ${bearer}` } : {}),
+    },
+    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+  }))
+}
+
+async function result(res: Response): Promise<any> {
+  const text = await res.text()
+  const json = text.startsWith('event:') || text.includes('\ndata:') || text.startsWith('data:')
+    ? text.split('\n').find((line) => line.startsWith('data:'))!.slice(5)
+    : text
+  return JSON.parse(json).result
+}
+
+describe('POST /mcp', () => {
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    await app.boot?.()
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass-1' })
+    userId = Number(user.id)
+    const { plainTextToken } = await createApiToken(new DatabaseApiTokenStore(apiTokens), {
+      name: 'test',
+      userId,
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  it('refuses a call without a credential', async () => {
+    expect((await rpc('tools/list', {})).status).toBe(401)
+  })
+
+  it('lists exactly the two tools with read-only flags', async () => {
+    const { tools } = await result(await rpc('tools/list', {}, bearer))
+    const own = tools.filter((t: { name: string }) => !t.name.startsWith('guren_'))
+    expect(own.map((t: { name: string }) => t.name).sort()).toEqual(['posts_search', 'posts_store'])
+    const byName = Object.fromEntries(own.map((t: any) => [t.name, t.annotations?.readOnlyHint]))
+    expect(byName.posts_search).toBe(true)
+    expect(byName.posts_store).not.toBe(true)
+  })
+
+  it('stores a post as the token user and ignores authorId', async () => {
+    const out = await result(await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: 'Hello', excerpt: 'Ex', body: 'Body', authorId: 999 },
+    }, bearer))
+    expect(out.isError).not.toBe(true)
+    const posts = await Post.all()
+    expect(posts).toHaveLength(1)
+    expect(Number(posts[0].authorId)).toBe(userId)
+  })
+
+  it('rejects invalid input and searches what was stored', async () => {
+    const bad = await result(await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'Ex', body: 'Body' },
+    }, bearer))
+    expect(bad.isError).toBe(true)
+    expect(await Post.all()).toHaveLength(0)
+
+    await Post.forceCreate({ title: 'About Bun', excerpt: 'x', body: 'y', authorId: userId })
+    const found = await result(await rpc('tools/call', {
+      name: 'posts_search',
+      arguments: { keywords: ['Bun'] },
+    }, bearer))
+    expect(JSON.stringify(found)).toContain('About Bun')
+  })
+})
