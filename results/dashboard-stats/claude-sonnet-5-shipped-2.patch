diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..3e2a32a
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,58 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects guests to login', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows a zero post count and empty state for a user with no posts', async () => {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+
+    await http
+      .actingAs(user)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', { postCount: 0, recentPosts: [] })
+  })
+
+  it("counts and lists only the signed-in user's posts, newest first, capped at 5", async () => {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'password123' })
+
+    await Post.forceCreate({ title: 'Not mine', excerpt: 'e', body: 'b', authorId: other.id })
+
+    const mine = []
+    for (let i = 1; i <= 6; i++) {
+      mine.push(await Post.forceCreate({ title: `Post ${i}`, excerpt: 'e', body: 'b', authorId: user.id }))
+    }
+
+    await http
+      .actingAs(user)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', {
+        postCount: 6,
+        recentPosts: [mine[5], mine[4], mine[3], mine[2], mine[1]].map((post) => ({
+          id: post.id,
+          title: post.title,
+        })),
+      })
+  })
+})
