@@ -0,0 +1,65 @@
+import { Controller, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+const ALREADY_SUBSCRIBED = 'This email address is already subscribed.'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+    }
+
+    try {
+      // forceCreate, because `token` is deliberately absent from
+      // NewsletterSubscription.fillable: it is generated here, never sent.
+      await NewsletterSubscription.forceCreate({ email, token: generateToken() })
+    } catch (error) {
+      // Two concurrent sign-ups both pass the lookup above; the unique index
+      // rejects the second one.
+      if (await NewsletterSubscription.first({ email })) {
+        throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+      }
+      throw error
+    }
+
+    return this.back()
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    // Following the link again keeps the original confirmation time.
+    if (subscription.confirmedAt === null) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.back()
+  }
+
+  /** Referer is request input: only a same-origin one is followed. */
+  private back(): Response {
+    const referer = this.ctx.req.header('Referer')
+    const safe = referer !== undefined && isSafeRedirectUrl(referer, this.ctx.req.url)
+
+    return this.redirect(safe ? referer : '/')
+  }
+}
+
+/** 32 random bytes, hex-encoded: 64 characters, 256 bits of entropy. */
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
