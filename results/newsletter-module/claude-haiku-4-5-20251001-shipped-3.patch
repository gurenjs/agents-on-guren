+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import {
+  NewsletterSubscribeSchema,
+  NewsletterConfirmSchema,
+  NewsletterUnsubscribeSchema,
+} from './app/Http/Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (newsletter) => {
+    newsletter.post('/subscribe', { name: 'newsletter.subscribe', body: NewsletterSubscribeSchema }, [
+      NewsletterController,
+      'subscribe',
+    ])
+
+    newsletter.get('/confirm/:token', { name: 'newsletter.confirm', params: NewsletterConfirmSchema }, [
+      NewsletterController,
+      'confirm',
+    ])
+
+    newsletter.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: NewsletterUnsubscribeSchema }, [
+      NewsletterController,
+      'unsubscribe',
+    ])
+  })
+}
