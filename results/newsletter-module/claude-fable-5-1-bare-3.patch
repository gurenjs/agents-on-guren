new file mode 100644
index 0000000..6a7972e
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,65 @@
+import { Controller, ValidationException, abort, isSafeRedirectUrl, urlSafeToken } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { NewsletterTokenParamSchema } from '../Validators/NewsletterValidator.js'
+
+const CONFIRMATION_TOKEN_LENGTH = 40
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.subscribe')
+    const email = normalizeEmail(body.email)
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable: the
+    // server issues it and a request must never be able to choose it.
+    await NewsletterSubscription.forceCreate({
+      email,
+      token: urlSafeToken(CONFIRMATION_TOKEN_LENGTH),
+    })
+
+    return this.redirectBack()
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(NewsletterTokenParamSchema)
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      abort(404, 'Unknown confirmation token.')
+    }
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, {
+        confirmedAt: new Date().toISOString(),
+      })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.unsubscribe')
+    const email = normalizeEmail(body.email)
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirectBack()
+  }
+
+  // Sends the visitor back to the page the form was on, or home when the
+  // Referer is missing or points off-site.
+  private redirectBack(): Response {
+    const referer = this.request.header('referer')
+    const target = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(target)
+  }
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase()
+}
