+  id: z.string().trim().min(1, 'Token id is required.').max(64),
+})
+
+export const ApiTokenPayloadSchema = z.object({
+  name: z.string().trim().min(1, 'Name is required.').max(50, 'Name must be 50 characters or fewer.'),
+})
+
+export type ApiTokenPayload = z.infer<typeof ApiTokenPayloadSchema>
