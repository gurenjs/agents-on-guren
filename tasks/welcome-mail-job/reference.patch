+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,39 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeMailRecipient {
+  name: string
+  email: string
+}
+
+/**
+ * The welcome message a new account receives after registering.
+ *
+ * Subject: "Welcome to <APP_NAME>, <name>!" — the app name comes from
+ * APP_NAME in .env so a rename never touches this file.
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly recipient: WelcomeMailRecipient,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const appName = process.env.APP_NAME?.trim() || 'Guren'
+    const { name, email } = this.recipient
+
+    return this
+      .to({ email, name })
+      .subject(`Welcome to ${appName}, ${name}!`)
+      .text(
+        [
+          `Hi ${name},`,
+          '',
+          `Thanks for joining ${appName}. Your account is ready — sign in any time to write your first post.`,
+          '',
+          `— The ${appName} team`,
+        ].join('\n'),
+      )
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..411a4e4
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,26 @@
+import { ServiceProvider, createMailManager, setMailManager, type MailManager } from '@guren/core'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    const manager = createMailManager({
+      // MAIL_MAILER=log writes messages to the server output (default);
+      // 'memory' keeps them inspectable in tests.
+      default: process.env.MAIL_MAILER === 'memory' ? 'memory' : 'log',
+      from: {
+        email: process.env.MAIL_FROM_ADDRESS?.trim() || 'hello@example.com',
+        name: process.env.MAIL_FROM_NAME?.trim() || process.env.APP_NAME?.trim() || 'Guren',
+      },
+      transports: {
+        log: { driver: 'log' },
+        memory: { driver: 'memory' },
+      },
+    })
+
+    this.container.instance('mail', manager)
+  }
+
+  boot(): void {
+    const manager = this.container.make<MailManager>('mail')
+    setMailManager(manager)
+  }
+}
