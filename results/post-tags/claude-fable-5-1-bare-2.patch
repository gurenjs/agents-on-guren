diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..7a2d165
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,224 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test database (NODE_ENV=test points the app at
+// ./data/guren.test.db): every request runs the real routes, validation and
+// models, and the assertions read the `tags` and `post_tags` rows back.
+describe('post tags', () => {
+  let guest: TestApp
+  let http: TestApp
+  let author: UserRecord
+
+  const payload = (overrides: Record<string, unknown> = {}) => ({
+    title: 'Tagged post',
+    excerpt: 'A post with tags.',
+    body: 'Body of the post.',
+    ...overrides,
+  })
+
+  async function tagNames(): Promise<string[]> {
+    const rows = await Tag.all()
+    return rows.map((row) => row.name).sort()
+  }
+
+  async function attachedTo(postId: number): Promise<string[]> {
+    const rows = await PostTag.all()
+    const names = await Tag.all()
+    return rows
+      .filter((row) => row.postId === postId)
+      .map((row) => names.find((tag) => tag.id === row.tagId)?.name ?? '?')
+      .sort()
+  }
+
+  async function createPost(overrides: Record<string, unknown> = {}): Promise<number> {
+    const response = await http.post('/posts', payload(overrides))
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+    expect(Number.isInteger(id) && id > 0).toBe(true)
+    return id
+  }
+
+  async function pageProps(path: string): Promise<Record<string, any>> {
+    const response = await guest.withHeaders({ 'X-Inertia': 'true' }).get(path)
+    expect(response.status).toBe(200)
+    const page = (await response.json()) as { props: Record<string, any> }
+    return page.props
+  }
+
+  beforeAll(async () => {
+    guest = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    // Primed like a browser, so the writes below pass CSRF protection.
+    http = (await guest.withCsrf()).actingAs(author)
+  })
+
+  it('stores new tags and attaches them to the created post', async () => {
+    const id = await createPost({ tags: 'webdev, bun' })
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await attachedTo(id)).toEqual(['bun', 'webdev'])
+    expect((await pageProps(`/posts/${id}`)).post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('creates a post without tags when the field is left out or empty', async () => {
+    const without = await createPost()
+    const empty = await createPost({ tags: ' , ' })
+
+    expect(await tagNames()).toEqual([])
+    expect((await pageProps(`/posts/${without}`)).post.tags).toEqual([])
+    expect((await pageProps(`/posts/${empty}`)).post.tags).toEqual([])
+  })
+
+  it('detaches a tag removed on edit and keeps it in the tags table', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    await http.put(`/posts/${id}`, payload({ tags: 'bun' })).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedTo(id)).toEqual(['bun'])
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect((await pageProps(`/posts/${id}`)).post.tags).toEqual(['bun'])
+  })
+
+  it('reuses an existing tag and attaches new ones on edit', async () => {
+    const first = await createPost({ tags: 'bun' })
+    const second = await createPost({ tags: 'webdev' })
+
+    await http.put(`/posts/${second}`, payload({ tags: 'webdev, bun, guren' })).assertRedirect()
+
+    expect(await tagNames()).toEqual(['bun', 'guren', 'webdev'])
+    expect(await attachedTo(first)).toEqual(['bun'])
+    expect(await attachedTo(second)).toEqual(['bun', 'guren', 'webdev'])
+  })
+
+  it('clears the tags when the field is left out on edit', async () => {
+    const id = await createPost({ tags: 'bun' })
+
+    await http.put(`/posts/${id}`, payload()).assertRedirect()
+
+    expect(await attachedTo(id)).toEqual([])
+  })
+
+  it('trims names, ignores empty entries and counts a repeated name once', async () => {
+    const id = await createPost({ tags: ' bun ,bun,,' })
+
+    expect(await tagNames()).toEqual(['bun'])
+    expect(await attachedTo(id)).toEqual(['bun'])
+  })
+
+  it('treats names as case-sensitive', async () => {
+    const id = await createPost({ tags: 'bun, Bun' })
+
+    expect(await attachedTo(id)).toEqual(['Bun', 'bun'])
+    expect((await pageProps(`/posts/${id}`)).post.tags).toEqual(['Bun', 'bun'])
+  })
+
+  it('refuses more than five tags like an empty title, saving nothing', async () => {
+    const emptyTitle = await http.post('/posts', payload({ title: '' }))
+    const sixTags = await http.post('/posts', payload({ tags: 'a, b, c, d, e, f' }))
+
+    expect(sixTags.status).toBe(emptyTitle.status)
+    const { errors } = (await sixTags.json()) as { errors: Record<string, string[]> }
+    expect(Object.keys(errors)).toEqual(['tags'])
+
+    expect(await Post.all()).toEqual([])
+    expect(await Tag.all()).toEqual([])
+    expect(await PostTag.all()).toEqual([])
+  })
+
+  it('counts five distinct names even when more were typed', async () => {
+    const id = await createPost({ tags: 'a, b, c, d, e, a, b' })
+
+    expect(await attachedTo(id)).toEqual(['a', 'b', 'c', 'd', 'e'])
+  })
+
+  it('refuses a 31-character name and saves a 30-character one', async () => {
+    const emptyTitle = await http.post('/posts', payload({ title: '' }))
+    const tooLong = await http.post('/posts', payload({ tags: 'x'.repeat(31) }))
+
+    expect(tooLong.status).toBe(emptyTitle.status)
+    expect(await tagNames()).toEqual([])
+
+    const id = await createPost({ tags: 'x'.repeat(30) })
+    expect(await attachedTo(id)).toEqual(['x'.repeat(30)])
+  })
+
+  it('refuses invalid tags on edit and leaves the post as it was', async () => {
+    const id = await createPost({ tags: 'bun' })
+    const emptyTitle = await http.put(`/posts/${id}`, payload({ title: '' }))
+
+    const response = await http.put(`/posts/${id}`, payload({ title: 'Renamed', tags: 'a, b, c, d, e, f' }))
+
+    expect(response.status).toBe(emptyTitle.status)
+    expect(await attachedTo(id)).toEqual(['bun'])
+    expect((await pageProps(`/posts/${id}`)).post.title).toBe('Tagged post')
+  })
+
+  it('lists every post with its tags and filters the list by tag', async () => {
+    const plain = await createPost()
+    const bun = await createPost({ tags: 'bun' })
+    const both = await createPost({ tags: 'webdev, bun' })
+    await http.put(`/posts/${both}`, payload({ tags: 'webdev, bun, unused' })).assertRedirect()
+    await http.put(`/posts/${both}`, payload({ tags: 'webdev, bun' })).assertRedirect()
+
+    const all = await pageProps('/posts')
+    expect(all.data.map((post: { id: number }) => post.id)).toEqual([both, bun, plain])
+    expect(all.data.map((post: { tags: string[] }) => post.tags)).toEqual([['bun', 'webdev'], ['bun'], []])
+
+    const filtered = await pageProps('/posts?tag=bun')
+    expect(filtered.data.map((post: { id: number }) => post.id)).toEqual([both, bun])
+    expect(filtered.data.map((post: { tags: string[] }) => post.tags)).toEqual([['bun', 'webdev'], ['bun']])
+
+    expect((await pageProps('/posts?tag=webdev')).data.map((post: { id: number }) => post.id)).toEqual([both])
+    expect((await pageProps('/posts?tag=unused')).data).toEqual([])
+    expect((await pageProps('/posts?tag=never-seen')).data).toEqual([])
+    expect((await pageProps('/posts?tag=BUN')).data).toEqual([])
+  })
+
+  it('paginates a filtered list and keeps the filter in its page links', async () => {
+    const ids: number[] = []
