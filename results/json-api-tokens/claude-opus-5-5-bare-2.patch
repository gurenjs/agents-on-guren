+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test SQLite database (NODE_ENV=test), migrated
+// here. Each run registers fresh users, so rows left by earlier runs never
+// collide with these assertions.
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let other: UserRecord
+
+  const unique = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+  async function signedIn(user: UserRecord): Promise<TestApp> {
+    return (await http.actingAs(user).withCsrf('/profile')).json()
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  async function issueToken(user: UserRecord, name: string): Promise<{ id: string; name: string; token: string }> {
+    const response = await (await signedIn(user)).post('/profile/tokens', { name })
+    response.assertStatus(201)
+    return await response.json() as { id: string; name: string; token: string }
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    owner = (await User.create({ name: 'Owner', email: `owner-${unique}@example.com`, password: 'password123' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: `other-${unique}@example.com`, password: 'password123' })) as UserRecord
+  })
+
+  it('creates a token shown once and stores only a hash of it', async () => {
+    const created = await issueToken(owner, 'CI')
+    expect(created.name).toBe('CI')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const db = (await getDatabase()) as SQLiteBunDatabase
+    const rows = await db.select().from(apiTokens)
+    expect(rows.length).toBeGreaterThan(0)
+    const dump = JSON.stringify(rows)
+    expect(dump).not.toContain(created.token)
+    expect(dump).not.toContain(secret)
+  })
+
+  it('rejects invalid token names', async () => {
+    const client = await signedIn(owner)
+    await client.post('/profile/tokens', {}).assertStatus(422)
+    await client.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await client.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+  })
+
+  it('lists posts and creates posts owned by the token owner', async () => {
+    const { token } = await issueToken(owner, 'script')
+
+    const created = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What shipped',
+      body: 'Everything.',
+      authorId: other.id,
+    })
+    created.assertStatus(201)
+    const { data: post } = await created.json() as { data: { id: number; authorId: number; createdAt: string } }
+    expect(post.authorId).toBe(owner.id)
+    expect(new Date(post.createdAt).toISOString()).toBe(post.createdAt)
+
+    const listed = await bearer(token).get('/api/posts')
+    listed.assertStatus(200)
+    const { data } = await listed.json() as { data: Array<{ id: number }> }
+    expect(data[0]?.id).toBe(post.id)
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertStatus(422)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const { token } = await issueToken(owner, 'tamper')
+    await http.json().get('/api/posts').assertStatus(401)
+    await bearer('not-a-token').get('/api/posts').assertStatus(401)
+    await bearer('abc|def').get('/api/posts').assertStatus(401)
+    await bearer(`${token}x`).get('/api/posts').assertStatus(401)
+    await bearer(`${token}x`).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertStatus(401)
+  })
+
+  it('revokes only the owner’s own tokens', async () => {
+    const first = await issueToken(owner, 'old laptop')
+    const second = await issueToken(owner, 'new laptop')
+    const foreign = await issueToken(other, 'theirs')
+
+    await (await signedIn(owner)).delete(`/profile/tokens/${foreign.id}`).assertStatus(404)
+    await bearer(foreign.token).get('/api/posts').assertStatus(200)
+
+    await (await signedIn(owner)).delete(`/profile/tokens/${first.id}`).assertStatus(204)
+    await bearer(first.token).get('/api/posts').assertStatus(401)
+    await bearer(second.token).get('/api/posts').assertStatus(200)
+  })
+
+  it('limits each token to 60 requests a minute on its own', async () => {
+    const limited = await issueToken(owner, 'busy')
+    const sibling = await issueToken(owner, 'quiet')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(limited.token).get('/api/posts').assertStatus(200)
+    }
+    const response = await bearer(limited.token).get('/api/posts')
+    response.assertStatus(429)
+    const retryAfter = Number(response.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(sibling.token).get('/api/posts').assertStatus(200)
+  })
+})
