+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let user: UserRecord
+  let futureTime: string
+  let pastTime: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    user = await User.create({
+      name: 'Test Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+
+    const now = new Date()
+    futureTime = new Date(now.getTime() + 3600000).toISOString()
+    pastTime = new Date(now.getTime() - 3600000).toISOString()
+  })
+
+  it('allows creating scheduled posts', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const res = await csrf.post('/posts', {
+      title: 'Future Post',
+      excerpt: 'Will be published later',
+      body: 'Some content',
+      publishAt: futureTime,
+    })
+
+    await res.assertRedirect()
+    const posts = await Post.where('title', 'Future Post').get()
+    expect(posts.length).toBe(1)
+    expect(posts[0].publishedAt).toBe(futureTime)
+  })
+
+  it('allows updating publish time', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const post = await Post.forceCreate({
+      title: 'Editable Post',
+      excerpt: 'Will be updated',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: null,
+    })
+
+    const res = await csrf.put(`/posts/${post.id}`, {
+      title: 'Editable Post',
+      excerpt: 'Will be updated',
+      body: 'Content',
+      publishAt: futureTime,
+    })
+
+    await res.assertRedirect()
+    const updated = await Post.find(post.id)
+    expect(updated?.publishedAt).toBe(futureTime)
+  })
+
+  it('returns 404 for scheduled posts viewed by non-authors', async () => {
+    const other = await User.create({
+      name: 'Other Author',
+      email: 'other@example.com',
+      password: 'password123',
+    })
+
+    const post = await Post.forceCreate({
+      title: 'Other Scheduled Post',
+      excerpt: 'Not mine',
+      body: 'Content',
+      authorId: other.id,
+      publishedAt: futureTime,
+    })
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.get(`/posts/${post.id}`).assertNotFound()
+  })
+
+  it('allows authors to view their own scheduled posts', async () => {
+    const post = await Post.forceCreate({
+      title: 'My Scheduled Post',
+      excerpt: 'For author only',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: futureTime,
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('allows everyone to view published posts', async () => {
+    const post = await Post.forceCreate({
+      title: 'Published Post',
+      excerpt: 'For everyone',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: pastTime,
+    })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+})
