@@ -0,0 +1,19 @@
+import { z } from 'zod'
+
+// Lowercased so one address cannot subscribe twice under different casing.
+export const NewsletterEmailSchema = z.object({
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+// Deliberately no length rule: a token we never issued must answer 404 from
+// the lookup, not 422 from the contract.
+export const NewsletterTokenParamSchema = z.object({
+  token: z.string().trim().min(1),
+})
+
+export type NewsletterEmailInput = z.infer<typeof NewsletterEmailSchema>
