+++ b/config/queue.ts
@@ -0,0 +1,28 @@
+import { createQueueManager, SyncDriver, RedisDriver, type QueueManager } from '@guren/core'
+import { createRedisClient } from '@guren/core/redis'
+
+let queueManager: QueueManager | null = null
+
+/**
+ * QUEUE_CONNECTION selects the driver: `sync` runs jobs immediately in the
+ * dispatching process (the dev default, no worker needed), `redis` queues
+ * them for a separate worker process. Resolving the default driver below
+ * registers it as the global driver Job.dispatch()/Mail.queue() push onto.
+ */
+export function configureQueue(): QueueManager {
+  if (queueManager) {
+    return queueManager
+  }
+
+  queueManager = createQueueManager({
+    default: process.env.QUEUE_CONNECTION ?? 'sync',
+    drivers: {
+      sync: () => new SyncDriver(),
+      redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+    },
+  })
+
+  queueManager.driver()
+
+  return queueManager
+}
