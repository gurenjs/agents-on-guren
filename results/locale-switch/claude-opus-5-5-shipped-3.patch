@@ -0,0 +1,68 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+interface I18nProps {
+  locale: string
+  messages: Record<string, Record<string, Record<string, unknown>>>
+}
+
+// /login renders without touching the database, so it stands in for any page.
+async function i18nOf(client: TestApp): Promise<I18nProps> {
+  const res = await client.withHeaders({ 'X-Inertia': 'true' }).get('/login')
+  const page = await res.json<{ props: { _i18n: I18nProps } }>()
+  return page.props._i18n
+}
+
+function localeCookie(res: { headers: Headers }): string | undefined {
+  return res.headers.getSetCookie().find((cookie) => cookie.startsWith('locale='))?.split(';')[0]
+}
+
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('defaults to English', async () => {
+    expect((await i18nOf(http)).locale).toBe('en')
+  })
+
+  it('follows a Japanese browser when nothing was picked', async () => {
+    expect((await i18nOf(http.withHeader('Accept-Language', 'ja'))).locale).toBe('ja')
+    const i18n = await i18nOf(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'))
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja?.nav?.posts).toBe('記事')
+  })
+
+  it('remembers the pick and redirects back to the referer', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.withHeader('Referer', 'http://localhost/posts').post('/locale', { locale: 'ja' })
+    res.assertRedirect('http://localhost/posts')
+    const cookie = localeCookie(res)
+    expect(cookie).toBe('locale=ja')
+
+    const i18n = await i18nOf(http.withHeader('Cookie', cookie!))
+    expect(i18n.locale).toBe('ja')
+  })
+
+  it('lets the pick win over the browser', async () => {
+    const i18n = await i18nOf(http.withHeaders({ Cookie: 'locale=en', 'Accept-Language': 'ja' }))
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('redirects to / without a referer, and ignores foreign referers', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', { locale: 'en' }).assertRedirect('/')
+    await csrf.withHeader('Referer', 'https://evil.example/').post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('rejects unsupported locales without touching the choice', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.json().post('/locale', { locale: 'fr' })
+    res.assertUnprocessable()
+    expect(localeCookie(res)).toBeUndefined()
+    await csrf.json().post('/locale', {}).assertUnprocessable()
+  })
+})
