+import type { Context } from 'hono'
+import { rateLimiter } from '../../Services/RateLimiter.js'
+
+export async function throttleLogin(c: Context, next: () => Promise<void>): Promise<Response | void> {
+  const clientIp = getClientIp(c)
+  const { allowed, retryAfterSeconds } = rateLimiter.check(clientIp)
+
+  if (!allowed) {
+    return new Response(
+      JSON.stringify({ message: 'Too many login attempts. Please try again later.' }),
+      {
+        status: 429,
+        headers: {
+          'Content-Type': 'application/json',
+          'Retry-After': retryAfterSeconds.toString(),
+        },
+      }
+    )
+  }
+
+  await next()
+}
+
+function getClientIp(c: Context): string {
+  // Get the raw connection address from the socket, not from forwarded headers
+  // The task specifies: "do not trust forwarded-for style headers"
+  const raw = c.req.raw as unknown as { socket?: { remoteAddress?: string } }
+  const remoteAddr = raw.socket?.remoteAddress
+  if (remoteAddr) {
+    return remoteAddr
+  }
+
+  // Fallback: if address cannot be determined, count as one shared client
+  // "fail closed" per the task
+  return 'unknown'
+}
diff --git a/app/Services/RateLimiter.ts b/app/Services/RateLimiter.ts
new file mode 100644
index 0000000..e2b9d52
--- /dev/null
+++ b/app/Services/RateLimiter.ts
@@ -0,0 +1,41 @@
+interface AttemptRecord {
+  count: number
+  windowStart: number
+}
+
+const WINDOW_MS = 60 * 1000 // 1 minute
+const MAX_ATTEMPTS = 5
+
+class RateLimiter {
+  private attempts = new Map<string, AttemptRecord>()
+
+  check(clientIp: string): { allowed: boolean; retryAfterSeconds: number } {
+    const now = Date.now()
+    const record = this.attempts.get(clientIp)
+
+    // If no record or window has expired, allow and create new record
+    if (!record || now - record.windowStart >= WINDOW_MS) {
+      this.attempts.set(clientIp, { count: 1, windowStart: now })
+      return { allowed: true, retryAfterSeconds: 0 }
+    }
+
+    // Increment count in current window
+    record.count++
+
+    if (record.count > MAX_ATTEMPTS) {
+      // Calculate retry-after: how many seconds until window expires
+      const windowEndTime = record.windowStart + WINDOW_MS
+      const retryAfterSeconds = Math.ceil((windowEndTime - now) / 1000)
+      return { allowed: false, retryAfterSeconds }
+    }
+
+    return { allowed: true, retryAfterSeconds: 0 }
+  }
+
+  // For testing: clear all records
+  reset(): void {
+    this.attempts.clear()
+  }
+}
+
+export const rateLimiter = new RateLimiter()
