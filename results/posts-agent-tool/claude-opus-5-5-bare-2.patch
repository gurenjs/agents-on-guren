+          "type": "string",
+          "minLength": 1,
+          "maxLength": 500
+        },
+        "body": {
+          "type": "string",
+          "minLength": 1
+        }
+      },
+      "required": [
+        "title",
+        "excerpt",
+        "body"
+      ]
+    },
+    inputSources: {
+      "title": "body",
+      "excerpt": "body",
+      "body": "body"
+    },
+    inputBodyNested: false,
+    annotations: {
