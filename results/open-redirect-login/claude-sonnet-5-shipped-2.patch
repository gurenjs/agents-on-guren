+const DEFAULT_POST_LOGIN_REDIRECT = '/dashboard'
+
+// Only a same-app path is a safe post-login destination. Anything else —
+// an absolute URL (`https://evil.example`), a protocol-relative URL
+// (`//evil.example`), or a backslash variant (`/\evil.example`, which
+// browsers normalize the same as `//evil.example`) — is rejected in favor
+// of the default, closing the open-redirect reported against this page.
+function resolveSafeRedirect(value: string | null | undefined): string {
+  if (!value || !/^\/(?!\/|\\)/.test(value)) {
+    return DEFAULT_POST_LOGIN_REDIRECT
+  }
+  return value
+}
