diff --git a/app/Models/PostTags.ts b/app/Models/PostTags.ts
new file mode 100644
index 0000000..b66e93a
--- /dev/null
+++ b/app/Models/PostTags.ts
@@ -0,0 +1,73 @@
+import { and, eq, inArray } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+async function openDb(): Promise<SQLiteBunDatabase> {
+  return (await getDatabase()) as SQLiteBunDatabase
+}
+
+/** Tag names per post id, sorted alphabetically; posts without tags are absent. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) {
+    return byPost
+  }
+
+  const db = await openDb()
+  const rows = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const row of rows) {
+    const names = byPost.get(row.postId) ?? []
+    names.push(row.name)
+    byPost.set(row.postId, names)
+  }
+  for (const names of byPost.values()) {
+    names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  }
+  return byPost
+}
+
+/** Ids of the posts carrying the tag `name`. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const db = await openDb()
+  const rows = await db
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+  return rows.map((row) => row.postId)
+}
+
+/** Makes `names` exactly the set of tags attached to the post. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const db = await openDb()
+
+  if (names.length > 0) {
+    await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing()
+  }
+  const rows = names.length > 0 ? await db.select().from(tags).where(inArray(tags.name, names)) : []
+  const wanted = new Set(rows.map((row) => row.id))
+
+  const attached = await db.select().from(postTags).where(eq(postTags.postId, postId))
+  const attachedIds = new Set(attached.map((row) => row.tagId))
+
+  for (const tagId of attachedIds) {
+    if (!wanted.has(tagId)) {
+      await db.delete(postTags).where(and(eq(postTags.postId, postId), eq(postTags.tagId, tagId)))
+    }
+  }
+  const missing = [...wanted].filter((tagId) => !attachedIds.has(tagId))
+  if (missing.length > 0) {
+    await db.insert(postTags).values(missing.map((tagId) => ({ postId, tagId })))
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  const db = await openDb()
+  await db.delete(postTags).where(eq(postTags.postId, postId))
+}
