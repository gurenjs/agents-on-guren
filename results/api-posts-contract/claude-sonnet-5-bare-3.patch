+  // Serves the public JSON feed `api.posts.index` — no auth, newest first,
+  // 10 per page, optionally narrowed to one author. `query` on the route
+  // already rejects bad input with 422 before this runs; validating again
+  // here just gets a typed `{ page, author }` for the query below.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+
+    const query = Post.newQuery().with('author').orderBy('id', 'desc')
+    if (author !== undefined) {
+      query.where('authorId', author)
+    }
+
+    const result = await query.paginate({ page, perPage: 10 })
+    const paginator = paginate(result)
+
+    return this.json({
+      data: PostResource.collection(paginator.items()),
+      meta: paginator.meta(),
+    })
+  }
+
