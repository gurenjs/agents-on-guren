+import { beforeAll, afterEach, describe, it, expect } from 'bun:test'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { TokenService } from '../app/Services/TokenService.js'
+
+describe('API Tokens', () => {
+  afterEach(async () => {
+    await Post.delete({})
+    await ApiToken.delete({})
+    await User.delete({})
+  })
+
+  describe('Token management', () => {
+    it('stores tokens with hashed values', async () => {
+      const user = await User.create({
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123',
+      })
+
+      const plainToken = TokenService.generateToken()
+      const tokenHash = TokenService.hashToken(plainToken)
+
+      const token = await ApiToken.create({
+        userId: user.id,
+        name: 'CI Token',
+        tokenHash,
+      })
+
+      expect(token.id).toBeDefined()
+      expect(token.name).toBe('CI Token')
+      expect(token.tokenHash).toBe(tokenHash)
+      expect(token.tokenHash).not.toBe(plainToken)
+    })
+
+    it('allows deleting tokens', async () => {
+      const user = await User.create({
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123',
+      })
+
+      const token = await ApiToken.create({
+        userId: user.id,
+        name: 'Test Token',
+        tokenHash: 'hash123',
+      })
+
+      await ApiToken.delete({ id: token.id })
+
+      const deleted = await ApiToken.find(token.id)
+      expect(deleted).toBeNull()
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    it('returns 401 with invalid bearer token', async () => {
+      const req = new Request('http://localhost/api/posts', {
+        method: 'GET',
+        headers: {
+          'Authorization': 'Bearer invalid_token_that_does_not_exist',
+        },
+      })
+
+      const res = await app.fetch(req)
+      expect(res.status).toBe(401)
+    })
+
+    it('lists posts with valid bearer token', async () => {
+      const user = await User.create({
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123',
+      })
+
+      const post1 = await Post.forceCreate({
+        title: 'Post 1',
+        excerpt: 'Excerpt 1',
+        body: 'Body 1',
+        authorId: user.id,
+      })
+
+      const plainToken = TokenService.generateToken()
+      const tokenHash = TokenService.hashToken(plainToken)
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Test Token',
+        tokenHash,
+      })
+
+      const req = new Request('http://localhost/api/posts', {
+        method: 'GET',
+        headers: {
+          'Authorization': `Bearer ${plainToken}`,
+        },
+      })
+
+      const res = await app.fetch(req)
+      expect(res.status).toBe(200)
+      const data: any = await res.json()
+      expect(data.data).toBeDefined()
+      expect(Array.isArray(data.data)).toBe(true)
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it('creates post with valid bearer token', async () => {
+      const user = await User.create({
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123',
+      })
+
+      const plainToken = TokenService.generateToken()
+      const tokenHash = TokenService.hashToken(plainToken)
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Test Token',
+        tokenHash,
