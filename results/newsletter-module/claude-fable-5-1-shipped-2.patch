+import { defineArchRules } from '@guren/cli/arch'
+
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      // Stricter than the built-in module boundary, which lets any file import
+      // a module's index.ts and db/schema.ts.
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message:
+        'The newsletter module is lifted into other apps as is, so the blog must not depend on it. Keep newsletter code under modules/newsletter/; only src/app.ts and db/schema.ts wire it in.',
+    },
+  ],
+})
