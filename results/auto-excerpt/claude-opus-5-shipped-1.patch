index 0000000..f1ff961
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,54 @@
+/**
+ * Longest excerpt this module derives before it starts cutting, counted in
+ * `String.length` units.
+ */
+export const EXCERPT_LENGTH = 140
+
+/** Single U+2026 character — not three periods. */
+const ELLIPSIS = '…'
+
+function isWhitespace(character: string | undefined): boolean {
+  return character !== undefined && /\s/.test(character)
+}
+
+function lastWhitespaceIndex(text: string): number {
+  for (let index = text.length - 1; index >= 0; index -= 1) {
+    if (isWhitespace(text[index])) return index
+  }
+  return -1
+}
+
+/**
+ * Builds the teaser shown on post cards from the body of a post, for writers
+ * who leave the excerpt blank.
+ *
+ * A body of `EXCERPT_LENGTH` characters or fewer is returned as-is. A longer
+ * one is cut to `EXCERPT_LENGTH`, backing off to the last whitespace when the
+ * cut would land inside a word, and gains a trailing ellipsis.
+ */
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+  const head = trimmed.slice(0, EXCERPT_LENGTH)
+  let kept = head
+
+  // The cut splits a word only when the characters on both sides of it are
+  // non-whitespace; otherwise the full head is a clean stop already.
+  if (!isWhitespace(head[EXCERPT_LENGTH - 1]) && !isWhitespace(trimmed[EXCERPT_LENGTH])) {
+    const boundary = lastWhitespaceIndex(head)
+    // No whitespace at all in the head — an unbroken run gets cut at the limit.
+    if (boundary !== -1) kept = head.slice(0, boundary)
+  }
+
+  return `${kept.replace(/\s+$/, '')}${ELLIPSIS}`
+}
+
+/**
+ * Resolves the excerpt to store: what the writer typed when they typed
+ * something, otherwise one derived from the body.
+ */
+export function resolveExcerpt(excerpt: string | undefined, body: string): string {
+  const provided = excerpt?.trim() ?? ''
+  return provided.length > 0 ? provided : deriveExcerpt(body)
+}
