--- /dev/null
+++ b/tests/Post.test.ts
@@ -0,0 +1,51 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+
+describe('Post slugs', () => {
+  let authorId: number
+
+  beforeAll(async () => {
+    // Boots the real app, which runs migrations and the seeders (including
+    // the demo user every post in this file is authored by).
+    await TestApp.fromApp(app)
+    const author = await User.newQuery().where('email', DEMO_EMAIL).first()
+    authorId = (author as { id: number }).id
+  })
+
+  it('slugifies the title to lowercase ascii words joined by hyphens', async () => {
+    const post = await Post.forceCreate({
+      title: '  Guren  &  Bun: 2026 Edition!  ',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId,
+    })
+
+    expect(post?.slug).toBe('guren-bun-2026-edition')
+  })
+
+  it('gives repeated titles the next free numbered slug', async () => {
+    const first = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'excerpt', body: 'body', authorId })
+    const second = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'excerpt', body: 'body', authorId })
+    const third = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'excerpt', body: 'body', authorId })
+
+    expect(first?.slug).toBe('hello-world')
+    expect(second?.slug).toBe('hello-world-2')
+    expect(third?.slug).toBe('hello-world-3')
+  })
+
+  it('keeps its original slug when the title is edited later', async () => {
+    const post = await Post.forceCreate({ title: 'Stable Slug Post', excerpt: 'excerpt', body: 'body', authorId })
+    await Post.update({ id: post?.id }, { title: 'A Completely Different Title' })
+
+    const reloaded = await Post.findOrFail(post?.id)
+    expect(reloaded.slug).toBe('stable-slug-post')
+    expect(reloaded.title).toBe('A Completely Different Title')
+
+    // The slug the new title would have produced was never claimed.
+    expect(await Post.find('a-completely-different-title', 'slug')).toBeNull()
+  })
+})
