diff --git a/tests/ApiPosts.test.ts b/tests/ApiPosts.test.ts
new file mode 100644
index 0000000..b111ea6
--- /dev/null
+++ b/tests/ApiPosts.test.ts
@@ -0,0 +1,79 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('GET /api/posts', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('lists posts newest first with author info, no auth required', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret123' })
+    const bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret123' })
+    const first = await Post.forceCreate({ title: 'First', excerpt: 'e1', body: 'b1', authorId: alice.id })
+    const second = await Post.forceCreate({ title: 'Second', excerpt: 'e2', body: 'b2', authorId: bob.id })
+
+    const res = await http.get('/api/posts').assertOk()
+    const body = await res.json<{ data: Array<Record<string, unknown>>; meta: Record<string, number> }>()
+
+    expect(body.data.length).toBe(2)
+    expect(body.data[0]?.id).toBe(second.id)
+    expect(body.data[0]?.author).toEqual({ id: bob.id, name: 'Bob' })
+    expect(body.data[1]?.id).toBe(first.id)
+    expect(body.meta).toEqual({ currentPage: 1, lastPage: 1, perPage: 10, total: 2 })
+  })
+
+  it('paginates at 10 per page', async () => {
+    const author = await User.create({ name: 'Carol', email: 'carol@example.com', password: 'secret123' })
+    for (let i = 0; i < 12; i++) {
+      await Post.forceCreate({ title: `Post ${i}`, excerpt: 'e', body: 'b', authorId: author.id })
+    }
+
+    const page1 = await (await http.get('/api/posts').assertOk()).json<{ data: unknown[]; meta: Record<string, number> }>()
+    expect(page1.data.length).toBe(10)
+    expect(page1.meta).toEqual({ currentPage: 1, lastPage: 2, perPage: 10, total: 12 })
+
+    const page2 = await (await http.get('/api/posts?page=2').assertOk()).json<{ data: unknown[]; meta: Record<string, number> }>()
+    expect(page2.data.length).toBe(2)
+    expect(page2.meta.currentPage).toBe(2)
+  })
+
+  it('filters by author and reports the filtered total', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice2@example.com', password: 'secret123' })
+    const bob = await User.create({ name: 'Bob', email: 'bob2@example.com', password: 'secret123' })
+    await Post.forceCreate({ title: 'Alice post', excerpt: 'e', body: 'b', authorId: alice.id })
+    await Post.forceCreate({ title: 'Bob post 1', excerpt: 'e', body: 'b', authorId: bob.id })
+    await Post.forceCreate({ title: 'Bob post 2', excerpt: 'e', body: 'b', authorId: bob.id })
+
+    const res = await (await http.get(`/api/posts?author=${bob.id}`).assertOk()).json<{
+      data: Array<Record<string, unknown>>
+      meta: Record<string, number>
+    }>()
+
+    expect(res.data.length).toBe(2)
+    expect(res.data.every((post) => (post.author as { id: number }).id === bob.id)).toBe(true)
+    expect(res.meta.total).toBe(2)
+  })
+
+  it('returns an empty page for an author with no posts', async () => {
+    const author = await User.create({ name: 'Dana', email: 'dana@example.com', password: 'secret123' })
+
+    const res = await (await http.get(`/api/posts?author=${author.id}`).assertOk()).json<{
+      data: unknown[]
+      meta: Record<string, number>
+    }>()
+
+    expect(res.data).toEqual([])
+    expect(res.meta.total).toBe(0)
+  })
+
+  it.each(['?page=0', '?page=abc', '?author=abc', '?author=0'])('rejects invalid query %s', async (qs) => {
+    await http.get(`/api/posts${qs}`).assertUnprocessable()
+  })
+})
