+  // Monthly / yearly archive as JSON: `{ data: [...] }` of the posts created in
+  // that period, newest first. `created_at` is stored as an ISO 8601 string, so
+  // a `YYYY-MM-` (or `YYYY-`) prefix match selects the period without parsing.
+  async archive(): Promise<Response> {
+    const { date } = this.validateParams(ArchiveParamSchema)
+    const [year, month] = date.split('/')
+    const prefix = month ? `${year}-${month.padStart(2, '0')}-` : `${year}-`
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .where('createdAt', 'like', `${prefix}%`)
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
