+
+  /**
+   * Slugifies `title`, appending `-2`, `-3`, … (the next free number) until
+   * the result is unique. Call once, at creation — the slug a later title
+   * edit would produce is never assigned to an existing post.
+   */
+  static async uniqueSlug(title: string): Promise<string> {
+    const base = slugify(title)
+    let candidate = base
+    let suffix = 2
+    while (await Post.newQuery().where('slug', candidate).first()) {
+      candidate = `${base}-${suffix}`
+      suffix += 1
+    }
+    return candidate
+  }
 }
 
