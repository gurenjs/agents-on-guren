diff --git a/tests/controllers/LoginController.test.ts b/tests/controllers/LoginController.test.ts
new file mode 100644
index 0000000..ea480d7
--- /dev/null
+++ b/tests/controllers/LoginController.test.ts
@@ -0,0 +1,62 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('renders English by default (no Accept-Language)', async () => {
+    const res = await http.get('/login')
+    await res.assertOk()
+    await res.assertBodyContains('<title>Sign in</title>')
+  })
+
+  it('renders Japanese for a Japanese-preferring Accept-Language', async () => {
+    const res = await http
+      .withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+      .get('/login')
+    await res.assertOk()
+    await res.assertBodyContains('<title>ログイン</title>')
+  })
+
+  it('renders English when the header prefers English', async () => {
+    const res = await http.withHeader('Accept-Language', 'en-US,en;q=0.9').get('/login')
+    await res.assertOk()
+    await res.assertBodyContains('<title>Sign in</title>')
+  })
+
+  it('renders English when English outranks Japanese', async () => {
+    const res = await http
+      .withHeader('Accept-Language', 'en-US,en;q=0.9,ja;q=0.5')
+      .get('/login')
+    await res.assertOk()
+    await res.assertBodyContains('<title>Sign in</title>')
+  })
+
+  it('renders English when the header names only unsupported languages', async () => {
+    const res = await http.withHeader('Accept-Language', 'fr-FR,fr;q=0.9').get('/login')
+    await res.assertOk()
+    await res.assertBodyContains('<title>Sign in</title>')
+  })
+
+  it('shares the auth.login translation keys as Inertia props', async () => {
+    const res = await http
+      .json()
+      .withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+      .get('/login')
+    const body = await res.json<{
+      props: { _i18n: { locale: string; messages: Record<string, { auth?: { login?: Record<string, string> } }> } }
+    }>()
+    if (body.props._i18n.locale !== 'ja') {
+      throw new Error(`Expected locale "ja", got ${JSON.stringify(body.props._i18n.locale)}`)
+    }
+    const messages = body.props._i18n.messages.ja?.auth?.login
+    if (messages?.heading !== 'ログイン' || messages?.submit !== 'ログイン') {
+      throw new Error(`Expected Japanese auth.login messages, got ${JSON.stringify(messages)}`)
+    }
+  })
+})
