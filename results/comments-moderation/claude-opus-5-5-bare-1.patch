diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..218fe8c
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,130 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test SQLite database (NODE_ENV=test). Every user
+// gets a unique email so repeated runs do not collide with earlier rows.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+let counter = 0
+
+async function makeUser(name: string): Promise<UserRecord> {
+  counter += 1
+  return (await User.create({ name, email: `${name}-${run}-${counter}@example.test`, password: 'secret-password' })) as UserRecord
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({ title: 'Hello', excerpt: 'Short', body: 'Long body', authorId: author.id })
+}
+
+interface CommentProp {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+async function pageComments(http: TestApp, postId: number): Promise<CommentProp[]> {
+  const response = await http.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { comments: CommentProp[] }).comments
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Mutating requests must pass CSRF like a real browser.
+    http = await (await TestApp.fromApp(app)).withCsrf('/')
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const author = await makeUser('author')
+    const post = await makePost(author)
+
+    await http.post(`/posts/${post.id}/comments`, { body: 'Hi' }).assertRedirect('/login')
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+  })
+
+  it('stores a comment by the signed-in user and lists it oldest first', async () => {
+    const author = await makeUser('author')
+    const reader = await makeUser('reader')
+    const post = await makePost(author)
+
+    await http.actingAs(reader).post(`/posts/${post.id}/comments`, { body: 'First' }).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).post(`/posts/${post.id}/comments`, { body: 'Second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await pageComments(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['First', 'Second'])
+    expect(comments[0]!.author).toEqual({ id: reader.id, name: 'reader' })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects an empty or overlong body and stores nothing', async () => {
+    const author = await makeUser('author')
+    const post = await makePost(author)
+    const signedIn = http.actingAs(author)
+
+    // Fails the same way an invalid post title does.
+    const invalidPost = await signedIn.post('/posts', { title: '', excerpt: 'Short', body: 'Long body' })
+    expect([302, 303, 422]).toContain(invalidPost.status)
+    for (const body of ['', 'x'.repeat(2001)]) {
+      const response = await signedIn.post(`/posts/${post.id}/comments`, { body })
+      expect(response.status).toBe(invalidPost.status)
+      expect(response.headers.get('location')).toBe(invalidPost.headers.get('location'))
+    }
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+  })
+
+  it('lets the comment author and the post author delete, and forbids anyone else', async () => {
+    const author = await makeUser('author')
+    const commenter = await makeUser('commenter')
+    const stranger = await makeUser('stranger')
+    const post = await makePost(author)
+
+    const first = await Comment.forceCreate({ body: 'One', postId: post.id, userId: commenter.id })
+    const second = await Comment.forceCreate({ body: 'Two', postId: post.id, userId: commenter.id })
+
+    await http.actingAs(stranger).delete(`/comments/${first.id}`).assertForbidden()
+    expect(await Comment.find(first.id)).not.toBeNull()
+
+    await http.actingAs(commenter).delete(`/comments/${first.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(first.id)).toBeNull()
+
+    await http.actingAs(author).delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second.id)).toBeNull()
+  })
+
+  it('counts a repeated report once and hides a comment after three reporters', async () => {
+    const author = await makeUser('author')
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ body: 'Spam', postId: post.id, userId: author.id })
+    const [a, b, c] = [await makeUser('a'), await makeUser('b'), await makeUser('c')]
+
+    await http.actingAs(a).post(`/comments/${comment.id}/report`).assertNoContent()
+    await http.actingAs(a).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where('commentId', comment.id).count()).toBe(1)
+
+    await http.actingAs(b).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await pageComments(http.actingAs(author), post.id)).map((row) => row.id)).toEqual([comment.id])
+
+    await http.actingAs(c).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await pageComments(http.actingAs(author), post.id)).toEqual([])
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes the comments of a deleted post', async () => {
+    const author = await makeUser('author')
+    const reader = await makeUser('reader')
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ body: 'Bye', postId: post.id, userId: reader.id })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: reader.id })
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+    expect(await CommentReport.where('commentId', comment.id).count()).toBe(0)
+  })
+})
