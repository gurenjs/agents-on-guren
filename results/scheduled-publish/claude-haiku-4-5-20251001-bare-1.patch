@@ -0,0 +1,21 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List all scheduled posts'
+
+  async handle(): Promise<number> {
+    const now = new Date()
+    const posts = await Post.newQuery()
+      .where('publishedAt', '>', now.toISOString())
+      .orderBy('publishedAt', 'asc')
+      .get()
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
