diff --git a/app/Auth/apiTokens.ts b/app/Auth/apiTokens.ts
new file mode 100644
index 0000000..c7a9d03
--- /dev/null
+++ b/app/Auth/apiTokens.ts
@@ -0,0 +1,35 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+export const API_RATE_LIMIT_PER_MINUTE = 60
+
+// Tokens are `{id}|{secret}`; the store keeps only sha256(secret).
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+const unauthenticated = { message: 'Unauthenticated.' }
+
+// Installs the token's owner as this request's principal, so `this.auth` and
+// policies see that user.
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: async (userId) => User.find(Number(userId)),
+  onUnauthorized: (ctx) => ctx.json(unauthenticated, 401),
+})
+
+// Keyed by token id, so each of a user's tokens gets its own budget. Must run
+// after authenticateApiToken. Per process: a multi-instance deploy needs a
+// shared store (Redis) here.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT_PER_MINUTE,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  store: new MemoryRateLimitStore(),
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+})
diff --git a/app/Http/Controllers/Api/ApiPostController.ts b/app/Http/Controllers/Api/ApiPostController.ts
new file mode 100644
index 0000000..4604764
--- /dev/null
+++ b/app/Http/Controllers/Api/ApiPostController.ts
@@ -0,0 +1,26 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+// Bearer-token JSON API; routes/api.ts authenticates and throttles every action.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // forceCreate, because `authorId` comes from the token, never the body.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..d0c18bc
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,31 @@
+import { Controller, NotFoundHttpException, createApiToken, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokens.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class ApiTokenController extends Controller {
+  // The plain-text token exists only in this response; the store keeps its hash.
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name: body.name,
+      userId: user.id,
+    })
+
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    // Another user's token answers the same 404 as a missing one.
+    const token = await ApiToken.first({ id, userId: user.id })
+    if (!token) {
+      throw new NotFoundHttpException('Token not found.')
+    }
+
+    await revokeApiToken(token.id, apiTokenStore)
+    return this.noContent()
+  }
+}
