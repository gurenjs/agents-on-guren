@@ -0,0 +1,34 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('POST /locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('remembers the pick in a cookie and redirects to the Referer path', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.withHeader('Referer', 'http://localhost/posts?page=2').post('/locale', { locale: 'ja' })
+    res.assertRedirect('/posts?page=2')
+    expect(res.headers.get('set-cookie')).toContain('locale=ja')
+  })
+
+  it('redirects home without a Referer', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('rejects unsupported locales like an invalid post', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/locale', { locale: 'fr' }).assertUnprocessable()
+    await csrf.json().post('/locale', {}).assertUnprocessable()
+  })
+
+  it('follows Accept-Language on first visit', async () => {
+    const res = await http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8').get('/')
+    expect(await res.text()).toContain('"_i18n":{"locale":"ja"')
+  })
+})
