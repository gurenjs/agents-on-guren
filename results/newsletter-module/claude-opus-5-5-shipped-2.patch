+import type { Router } from '@guren/core'
+import NewsletterSubscriptionController from './app/Http/Controllers/NewsletterSubscriptionController.js'
+import { NewsletterSubscription } from './app/Models/NewsletterSubscription.js'
+import { NewsletterEmailSchema, NewsletterTokenParamSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', {
+    name: 'newsletter.subscribe',
+    body: NewsletterEmailSchema,
+  }, [NewsletterSubscriptionController, 'subscribe'])
+
+  // An unknown token 404s through the binding before the action runs.
+  router.get('/confirm/:token', {
+    name: 'newsletter.confirm',
+    params: NewsletterTokenParamSchema,
+    bind: { token: [NewsletterSubscription, 'token'] },
+  }, [NewsletterSubscriptionController, 'confirm'])
+
+  router.post('/unsubscribe', {
+    name: 'newsletter.unsubscribe',
+    body: NewsletterEmailSchema,
+  }, [NewsletterSubscriptionController, 'unsubscribe'])
+}
