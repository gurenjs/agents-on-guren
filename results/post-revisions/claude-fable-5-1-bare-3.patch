@@ -13,6 +16,37 @@ export class Post extends defineModel(posts, {
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /**
+   * Replaces a post's content, keeping the version it had as a revision. One
+   * transaction, so a post never changes without its previous version being
+   * kept, and a save that fails keeps nothing. The previous version is read
+   * inside it rather than taken from the caller, whose copy may be stale.
+   */
+  static async revise(id: PostRecord['id'], content: PostContent): Promise<void> {
+    await Post.transaction(async (trx) => {
+      const previous = await Post.findOrFail(id, 'id', { trx })
+      // forceCreate, because `postId` is deliberately absent from
+      // PostRevision.fillable.
+      await PostRevision.forceCreate(
+        { postId: previous.id, title: previous.title, excerpt: previous.excerpt, body: previous.body },
+        { trx },
+      )
+      await Post.update({ id: previous.id }, content, { trx })
+    })
+  }
+
+  /**
+   * Deletes a post together with its history. The foreign key cascades too,
+   * but only on a connection that enforces foreign keys, so this does not
+   * rely on it.
+   */
+  static async deleteWithRevisions(id: PostRecord['id']): Promise<void> {
+    await Post.transaction(async (trx) => {
+      await PostRevision.delete({ postId: id }, { trx })
+      await Post.delete({ id }, { trx })
+    })
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
