+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// Guards that the route is actually mounted (it previously 404'd because
+// routes/admin.ts was never registered) and that it's gated like every
+// other signed-in-only page rather than left unreachable. The happy path
+// needs a post in the database — cover that with real feature tests once
+// your test database is set up.
+describe('admin.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects a guest to login instead of 404ing', async () => {
+    await http.get('/admin/posts').assertRedirect('/login')
+  })
+})
