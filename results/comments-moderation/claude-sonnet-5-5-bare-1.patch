+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  it('redirects a guest who comments to the login page', async () => {
+    await http.post('/posts/1/comments', { body: 'hello' }).assertRedirect('/login')
+  })
+
+  it('redirects a guest who reports to the login page', async () => {
+    await http.post('/comments/1/report', {}).assertRedirect('/login')
+  })
+})
