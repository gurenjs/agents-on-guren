diff --git a/config/mail.ts b/config/mail.ts
new file mode 100644
index 0000000..24a0a05
--- /dev/null
+++ b/config/mail.ts
@@ -0,0 +1,59 @@
+import { createMailManager, type MailAddress, type MailConfig, type MailManager } from '@guren/core'
+import { appName } from './app.js'
+
+/**
+ * The sender every message goes out as (MAIL_FROM_ADDRESS / MAIL_FROM_NAME).
+ *
+ * Mailables set it on the message explicitly rather than leaning on the
+ * manager's default, so the sender is the configured one no matter which
+ * manager sends the message — a worker's, or a test's recording one.
+ */
+export function mailFrom(): MailAddress {
+  return {
+    email: process.env.MAIL_FROM_ADDRESS?.trim() || 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME?.trim() || appName(),
+  }
+}
+
+/**
+ * Transports are registered under their driver name and MAIL_MAILER picks the
+ * default, so switching development's `log` (messages printed to the server
+ * output) for a real provider is an .env edit — no code changes.
+ *
+ * Registration is lazy: a transport is only constructed when a message
+ * actually goes through it, so the unused ones never read their credentials.
+ */
+export function mailConfig(): MailConfig {
+  return {
+    default: process.env.MAIL_MAILER?.trim() || 'log',
+    from: mailFrom(),
+    transports: {
+      log: { driver: 'log' },
+      // Records messages instead of delivering them — for tests.
+      memory: { driver: 'memory' },
+      resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+      smtp: {
+        driver: 'smtp',
+        host: process.env.MAIL_HOST ?? 'localhost',
+        port: Number.parseInt(process.env.MAIL_PORT ?? '587', 10),
+        secure: process.env.MAIL_ENCRYPTION === 'tls',
+        auth:
+          process.env.MAIL_USERNAME || process.env.MAIL_PASSWORD
+            ? { user: process.env.MAIL_USERNAME ?? '', pass: process.env.MAIL_PASSWORD ?? '' }
+            : undefined,
+      },
+    },
+  }
+}
+
+let manager: MailManager | null = null
+
+/**
+ * The application's mail manager. MailProvider binds it into the container and
+ * publishes it as the global manager queued work sends through; a worker that
+ * only imports a job still gets the same configured manager from here.
+ */
+export function appMailManager(): MailManager {
+  manager ??= createMailManager(mailConfig())
+  return manager
+}
diff --git a/config/queue.ts b/config/queue.ts
new file mode 100644
index 0000000..0e9b44a
--- /dev/null
+++ b/config/queue.ts
@@ -0,0 +1,35 @@
+import { createQueueManager, MemoryDriver, RedisDriver, SyncDriver, type QueueConfig, type QueueManager } from '@guren/core'
+import { createRedisClient } from '@guren/core/redis'
+
+/**
+ * QUEUE_CONNECTION picks the driver, so what dispatching a job means is an
+ * .env setting and never a code change:
+ *
+ * - `sync`   — runs the job inline, in the same process (development).
+ * - `memory` — keeps jobs in process memory until a worker pops them (tests).
+ * - `redis`  — hands them to Redis for a separate `guren queue:work` process.
+ *
+ * Drivers are constructed lazily by the manager, so the Redis client is only
+ * created when Redis is actually the connection in use.
+ */
+export function queueConfig(): QueueConfig {
+  return {
+    default: process.env.QUEUE_CONNECTION?.trim() || 'sync',
+    drivers: {
+      sync: () => new SyncDriver(),
+      memory: () => new MemoryDriver(),
+      redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+    },
+  }
+}
+
+let manager: QueueManager | null = null
+
+/**
+ * The application's queue manager. QueueProvider binds it into the container
+ * and installs its default driver as the one `Job.dispatch()` pushes to.
+ */
+export function appQueueManager(): QueueManager {
+  manager ??= createQueueManager(queueConfig())
+  return manager
+}
