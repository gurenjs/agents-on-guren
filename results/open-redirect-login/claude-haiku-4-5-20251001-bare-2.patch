index 0000000..cbb615a
--- /dev/null
+++ b/app/Utils/validateRedirect.ts
@@ -0,0 +1,33 @@
+export function isSafeRedirect(redirect: string | undefined): boolean {
+  // Empty or falsy values are safe (will use default)
+  if (!redirect) {
+    return true
+  }
+
+  // Must be a string
+  if (typeof redirect !== 'string') {
+    return false
+  }
+
+  // Block absolute URLs with schemes (e.g., https://evil.example)
+  if (/^[a-z][a-z0-9+\-.]*:/i.test(redirect)) {
+    return false
+  }
+
+  // Block protocol-relative URLs (e.g., //evil.example)
+  if (redirect.startsWith('//')) {
+    return false
+  }
+
+  // Block backslash variants (e.g., /\evil.example, treated as //evil.example by browsers)
+  if (redirect.startsWith('/\\')) {
+    return false
+  }
+
+  // Must be an absolute path starting with /
+  if (!redirect.startsWith('/')) {
+    return false
+  }
+
+  return true
+}
diff --git a/tests/validateRedirect.test.ts b/tests/validateRedirect.test.ts
