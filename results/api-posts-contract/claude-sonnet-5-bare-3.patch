+
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects page 0', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+  })
+
+  it('rejects a non-numeric page', async () => {
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects a non-numeric author', async () => {
+    await http.get('/api/posts?author=abc').assertStatus(422)
+  })
+
+  it('rejects author 0', async () => {
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+
+  it('returns an empty page, not a 404, for an author with no posts', async () => {
+    await http
+      .get('/api/posts?author=999999')
+      .assertStatus(200)
+      .assertJsonPath('data', [])
+      .assertJsonPath('meta.currentPage', 1)
+      .assertJsonPath('meta.lastPage', 1)
+      .assertJsonPath('meta.perPage', 10)
+      .assertJsonPath('meta.total', 0)
+  })
+})
