diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..b07e2c0 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -1,22 +1,81 @@
 import { beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
 // to the route feeds codegen and `guren audit`, while body parsing stays in
 // the controller so the request stream is read once — so an invalid payload
-// gets a 422 without the database ever being touched. That keeps this starter
-// test green without migrations or fixtures; cover the happy path with real
-// feature tests once your test database is set up.
+// gets a 422 without the database ever being touched.
 describe('posts.search', () => {
   let http: TestApp
 
   beforeAll(async () => {
     http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    const author = await User.create({
+      name: 'Ada',
+      email: 'ada@example.com',
+      password: 'password',
+    })
+
+    // `published` is not fillable, so drafts are created the same way the
+    // database does it today: directly, bypassing mass assignment.
+    await Post.forceCreate({
+      title: 'A zephyrquill morning',
+      excerpt: 'Published and matching.',
+      body: '...',
+      authorId: author!.id,
+      published: true,
+    })
+    await Post.forceCreate({
+      title: 'Draft zephyrquill notes',
+      excerpt: 'Unpublished and matching.',
+      body: '...',
+      authorId: author!.id,
+      published: false,
+    })
+    await Post.forceCreate({
+      title: 'Draft marmalade notes',
+      excerpt: 'Unpublished, matching the second keyword.',
+      body: '...',
+      authorId: author!.id,
+      published: false,
+    })
+    await Post.forceCreate({
+      title: 'Something else entirely',
+      excerpt: 'Published, but matching no keyword.',
+      body: '...',
+      authorId: author!.id,
+      published: true,
+    })
   })
 
   it('rejects a search without keywords', async () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  it('returns only published posts matching the keyword', async () => {
+    await http
+      .query('/posts/search', { keywords: ['zephyrquill'] })
+      .assertOk()
+      .assertJsonCount(1, 'data')
+      .assertJsonPath('data.0.title', 'A zephyrquill morning')
+  })
+
+  it('does not pad the results with posts that match no keyword', async () => {
+    await http
+      .query('/posts/search', { keywords: ['zephyrquill', 'marmalade'] })
+      .assertOk()
+      .assertJsonCount(1, 'data')
+      .assertJsonPath('data.0.title', 'A zephyrquill morning')
+  })
+
+  it('returns nothing for a word that only unpublished posts contain', async () => {
+    await http.query('/posts/search', { keywords: ['marmalade'] }).assertOk().assertJsonCount(0, 'data')
+  })
 })
