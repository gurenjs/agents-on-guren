+import { createMailManager } from '@guren/server'
+
+const mailFrom = {
+  email: process.env.MAIL_FROM_ADDRESS ?? 'noreply@example.com',
+  name: process.env.MAIL_FROM_NAME ?? 'App',
+}
+
+export const mailManager = createMailManager({
+  default: process.env.MAIL_MAILER ?? 'log',
+  from: mailFrom,
+  transports: {
+    log: {
+      driver: 'log',
+    },
+    resend: {
+      driver: 'resend',
+      apiKey: process.env.RESEND_API_KEY,
+    },
+  },
+})
diff --git a/config/queue.ts b/config/queue.ts
new file mode 100644
index 0000000..6be8f54
--- /dev/null
+++ b/config/queue.ts
@@ -0,0 +1,17 @@
+import { SyncDriver, setQueueDriver } from '@guren/server'
+
+function createQueueDriver() {
+  const queueConnection = process.env.QUEUE_CONNECTION ?? 'sync'
+
+  if (queueConnection === 'redis') {
+    // Redis queue is configured via environment but requires ioredis instance setup
+    // For now, default to sync for development
+    return new SyncDriver()
+  }
+
+  return new SyncDriver()
+}
+
+export function bootQueue(): void {
+  setQueueDriver(createQueueDriver())
+}
