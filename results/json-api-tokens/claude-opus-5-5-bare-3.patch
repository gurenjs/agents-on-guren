+import type { Router } from '@guren/core'
+import PostController from '../app/Http/Controllers/Api/PostController.js'
+import { apiTokenRateLimit, requireApiToken } from '../app/Http/Middleware/ApiMiddleware.js'
+
+// JSON API for scripts, authenticated by `Authorization: Bearer <token>` with a
+// personal API token from the profile page. The token is checked first, so the
+// rate limit only ever counts requests of a verified token.
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api-token', requireApiToken)
+    .aliasMiddleware('api-throttle', apiTokenRateLimit)
+
+  router.group('/api', (api) => {
+    api.middleware('api-token', 'api-throttle').group((authed) => {
+      authed.get('/posts', [PostController, 'index']).name('api.posts.index')
+      authed.post('/posts', [PostController, 'store']).name('api.posts.store')
+    })
+  })
+}
