diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..eea0a2d
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,86 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+// The language switcher: POST /locale writes the `locale` cookie the i18n
+// detection reads on every later request, and the `_i18n` shared prop every
+// Inertia page carries reports the resolved locale and its catalog.
+
+async function i18nProps(response: Response) {
+  const { payload } = await readInertiaResponse(response)
+  return payload.props._i18n as {
+    locale: string
+    fallbackLocale: string
+    messages: Record<string, Record<string, unknown>>
+  }
+}
+
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('defaults to English', async () => {
+    const response = await http.get('/')
+    response.assertOk()
+
+    const i18n = await i18nProps(response.raw)
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en).toMatchObject({ nav: { posts: 'Posts' } })
+  })
+
+  it('follows Accept-Language on a first visit', async () => {
+    for (const header of ['ja', 'ja-JP,ja;q=0.9,en;q=0.8']) {
+      const response = await http.withHeader('Accept-Language', header).get('/posts')
+      response.assertOk()
+      expect((await i18nProps(response.raw)).locale).toBe('ja')
+    }
+  })
+
+  it('remembers the pick in a cookie and returns to the referring page', async () => {
+    const client = await http.withCsrf('/posts')
+
+    await client
+      .withHeader('Referer', 'http://localhost/posts?page=2')
+      .post('/locale', { locale: 'ja' })
+      .assertStatus(303)
+      .assertRedirect('/posts?page=2')
+      .assertCookie('locale', 'ja')
+
+    // The pick beats the browser's own preference from then on.
+    const page = await client
+      .withHeaders({ Cookie: 'locale=ja', 'Accept-Language': 'en' })
+      .get('/')
+    page.assertOk()
+
+    const i18n = await i18nProps(page.raw)
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja).toMatchObject({
+      nav: { home: 'ホーム', posts: '記事', dashboard: 'ダッシュボード' },
+      posts: { new: '新規投稿', edit: '編集', delete: '削除', search: '検索' },
+      auth: { login: 'ログイン', logout: 'ログアウト' },
+      messages: { welcome: expect.any(String) },
+    })
+  })
+
+  it('goes home when nothing referred the request, and never off-site', async () => {
+    const client = await http.withCsrf('/')
+
+    await client.post('/locale', { locale: 'en' }).assertRedirect('/').assertCookie('locale', 'en')
+    await client
+      .withHeader('Referer', 'https://evil.example/phish')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported locale and a missing one, leaving the cookie alone', async () => {
+    const client = await http.withCsrf('/')
+
+    // Same route-contract validation as an invalid post payload: a 422, and
+    // no Set-Cookie for the locale.
+    await client.post('/locale', { locale: 'fr' }).assertStatus(422).assertCookieMissing('locale')
+    await client.post('/locale', {}).assertStatus(422).assertCookieMissing('locale')
+  })
+})
