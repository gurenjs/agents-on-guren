@@ -0,0 +1,31 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { ApiPostsIndexQuerySchema } from '../../Validators/PostValidator.js'
+
+export default class PostController extends Controller {
+  // Public JSON feed for partner integrations — no auth, newest first, 10 per page.
+  async index(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+
+    // `.with(...).paginate()` on the query builder does not eager-load — only
+    // `Model.withPaginate()` does, since `paginate()` reads rows directly via
+    // `executeQuery()` and skips `loadEagerRelations()`.
+    const result = await Post.withPaginate('author', {
+      page,
+      perPage: 10,
+      where: author !== undefined ? { authorId: author } : undefined,
+      orderBy: ['id', 'desc'],
+    })
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: {
+        currentPage: result.meta.currentPage,
+        lastPage: result.meta.totalPages,
+        perPage: result.meta.perPage,
+        total: result.meta.total,
+      },
+    })
+  }
+}
