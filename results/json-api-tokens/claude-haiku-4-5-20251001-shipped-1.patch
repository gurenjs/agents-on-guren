@@ -0,0 +1,46 @@
+import { Controller, HttpException } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+export interface ApiAuthContext {
+  tokenId: number
+  userId: number
+}
+
+export default class ApiPostController extends Controller {
+  private getApiAuth(): ApiAuthContext {
+    const auth = this.ctx.get('apiAuth') as ApiAuthContext | undefined
+    if (!auth) {
+      throw HttpException.unauthorized('Unauthorized')
+    }
+    return auth
+  }
+
+  async index(): Promise<Response> {
+    this.getApiAuth()
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({
+      data: posts.map(post => new PostResource(post).toJSON()),
+    })
+  }
+
+  async store(): Promise<Response> {
+    const auth = this.getApiAuth()
+    const data = await this.validateBody(PostPayloadSchema)
+
+    const post = await Post.forceCreate({
+      ...data,
+      authorId: auth.userId,
+    })
+
+    return this.json({
+      data: new PostResource(post).toJSON(),
+    }, { status: 201 })
+  }
+}
