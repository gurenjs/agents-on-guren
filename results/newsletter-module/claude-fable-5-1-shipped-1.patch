+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { NewsletterEmailSchema, NewsletterTokenParamSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+// Mounted under the module's `/newsletter` prefix (see index.ts). Every route
+// is open to guests; the app's session + CSRF middleware covers the POSTs.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: NewsletterEmailSchema }, [
+    NewsletterController,
+    'subscribe',
+  ])
+  router.get('/confirm/:token', { name: 'newsletter.confirm', params: NewsletterTokenParamSchema }, [
+    NewsletterController,
+    'confirm',
+  ])
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: NewsletterEmailSchema }, [
+    NewsletterController,
+    'unsubscribe',
+  ])
+}
