+import type { Router } from '@guren/core'
+import PostApiController from '../app/Http/Controllers/Api/PostApiController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// Uses the 'api-token' and 'api-throttle' aliases routes/web.ts registers on
+// this router.
+export function registerApiRoutes(router: Router<'api-token' | 'api-throttle'>): void {
+  router.group('/api', (api) => {
+    // Order matters: the throttle counts per token, so the token is resolved first.
+    api.middleware('api-token', 'api-throttle').group((authed) => {
+      authed.get('/posts', { name: 'api.posts.index', resource: { data: [PostResource] } }, [PostApiController, 'index'])
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [PostApiController, 'store'])
+    })
+  })
+}
