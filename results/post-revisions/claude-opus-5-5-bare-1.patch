+ * in the same transaction, so a save never loses the earlier text.
+ */
+async function overwriteKeepingRevision(post: PostRecord, data: PostPayload): Promise<void> {
+  await Post.transaction(async (trx, posts) => {
+    await PostRevision.inTransaction(trx).create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+    await posts.update({ id: post.id }, data)
+  })
 }
