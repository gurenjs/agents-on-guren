+import { sqliteTable, integer, text } from '@guren/orm/drizzle/sqlite'
+
+export const newsletterSubscriptions = sqliteTable('newsletter_subscriptions', {
+  id: integer('id').primaryKey({ autoIncrement: true }),
+  email: text('email').notNull().unique(),
+  token: text('token').notNull().unique(),
+  confirmedAt: text('confirmed_at'),
+  createdAt: text('created_at').notNull().$defaultFn(() => new Date().toISOString()),
+})
diff --git a/modules/newsletter/handlers.ts b/modules/newsletter/handlers.ts
new file mode 100644
index 0000000..99032fd
--- /dev/null
+++ b/modules/newsletter/handlers.ts
@@ -0,0 +1,49 @@
+import { Controller, ValidationException } from '@guren/core'
+import { SubscribeSchema, UnsubscribeSchema, ConfirmParamSchema } from './validators.js'
+import { NewsletterSubscription } from './models.js'
+import crypto from 'crypto'
+
+export class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+    const lowerEmail = email.toLowerCase()
+
+    const existing = await NewsletterSubscription.where({ email: lowerEmail })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({
+        email: 'This email address is already subscribed.',
+      })
+    }
+
+    const token = crypto.randomBytes(20).toString('hex')
+    await NewsletterSubscription.create({
+      email: lowerEmail,
+      token,
+    })
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmParamSchema)
+
+    const subscription = await NewsletterSubscription.where({ token })
+    if (subscription.length === 0) {
+      return new Response('Not Found', { status: 404 })
+    }
+
+    await NewsletterSubscription.update({ token }, { confirmedAt: new Date().toISOString() })
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+    const lowerEmail = email.toLowerCase()
+
+    await NewsletterSubscription.delete({ email: lowerEmail })
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+}
diff --git a/modules/newsletter/index.ts b/modules/newsletter/index.ts
new file mode 100644
index 0000000..e19feed
--- /dev/null
+++ b/modules/newsletter/index.ts
@@ -0,0 +1,9 @@
+import type { Router } from '@guren/core'
+import { NewsletterController } from './handlers.js'
+import { SubscribeSchema, UnsubscribeSchema } from './validators.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/newsletter/subscribe', { body: SubscribeSchema }, [NewsletterController, 'subscribe'])
+  router.get('/newsletter/confirm/:token', [NewsletterController, 'confirm'])
+  router.post('/newsletter/unsubscribe', { body: UnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+}
