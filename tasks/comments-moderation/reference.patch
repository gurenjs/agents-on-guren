+import { z } from 'zod'
+
+export const CommentIdParamSchema = z.object({
+  id: z.coerce.number().int().positive(),
+})
+
+export const CommentPayloadSchema = z.object({
+  body: z.string().trim().min(1, 'Comment is required.').max(2000, 'Comment must be 2000 characters or fewer.'),
+})
+
+export type CommentPayload = z.infer<typeof CommentPayloadSchema>
diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
