diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..1226162
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,32 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// register.store binds RegisterSchema so `guren codegen` can emit the request
+// body type the sign-up page derives its fields from. Controller-action routes
+// carry that contract as metadata only, so validation still happens in
+// RegisterController.store() — this test pins that down: a mismatched
+// confirmation comes back as a 422 keyed by the rejected field, before the
+// database is touched. Cover the happy path with real feature tests once your
+// test database is set up.
+describe('register.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects a sign-up whose password confirmation does not match', async () => {
+    const csrf = await http.json().withCsrf('/health')
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'analytical-engine',
+        passwordConfirmation: 'difference-engine',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.passwordConfirmation.0', 'Passwords do not match.')
+  })
+})
