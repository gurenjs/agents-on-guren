@@ -0,0 +1,26 @@
+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import {
+  ConfirmParamsSchema,
+  SubscribeSchema,
+  UnsubscribeSchema,
+} from './app/Http/Validators/NewsletterValidator.js'
+import { NewsletterSubscription } from './app/Models/NewsletterSubscription.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [NewsletterController, 'subscribe'])
+
+  // A GET that writes: the link is followed from an email client, which
+  // cannot send anything else. The token is the credential.
+  router.get(
+    '/confirm/:token',
+    {
+      name: 'newsletter.confirm',
+      params: ConfirmParamsSchema,
+      bind: { token: [NewsletterSubscription, 'token'] },
+    },
+    [NewsletterController, 'confirm'],
+  )
+
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+}
