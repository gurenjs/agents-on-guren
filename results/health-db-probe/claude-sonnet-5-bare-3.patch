diff --git a/tests/HealthCheck.test.ts b/tests/HealthCheck.test.ts
new file mode 100644
index 0000000..77a411b
--- /dev/null
+++ b/tests/HealthCheck.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'bun:test'
+import { getHealth } from '../app/Http/HealthCheck.js'
+
+describe('getHealth', () => {
+  it('reports ok with a 200 when the database check succeeds', async () => {
+    const result = await getHealth(async () => {})
+
+    expect(result.httpStatus).toBe(200)
+    expect(result.body.status).toBe('ok')
+    expect(result.body.checks.db.status).toBe('ok')
+  })
+
+  it('reports error with a 503 when the database check throws', async () => {
+    const result = await getHealth(async () => {
+      throw new Error('connection refused')
+    })
+
+    expect(result.httpStatus).toBe(503)
+    expect(result.body.status).toBe('error')
+    expect(result.body.checks.db.status).toBe('error')
+    expect(result.body.checks.db.message).toBe('connection refused')
+  })
+})
