@@ -0,0 +1,40 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailPayload {
+  name: string
+  email: string
+}
+
+/**
+ * Sends the welcome email after sign-up.
+ *
+ * Registration dispatches this and returns without waiting for the mail
+ * provider — a slow or unreachable provider costs a retry here instead of a
+ * failed sign-up. The payload carries the name and address rather than a user
+ * id so the worker needs no database round trip (and still works if the row
+ * changed in the meantime — this greets the account as it was created).
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailPayload> {
+  // Pinned so queued messages survive a rename or a bundler mangling the class.
+  static override jobName = 'SendWelcomeEmailJob'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: SendWelcomeEmailPayload): Promise<void> {
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured — register MailProvider in createApp() providers.')
+    }
+
+    const result = await new WelcomeMail(manager, payload).send()
+    if (!result.success) {
+      // Throwing hands the job back to the queue, which retries it.
+      throw new Error(result.error ?? `Failed to send the welcome email to ${payload.email}.`)
+    }
+  }
+
+  async failed(payload: SendWelcomeEmailPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${payload.email}:`, error.message)
+  }
+}
