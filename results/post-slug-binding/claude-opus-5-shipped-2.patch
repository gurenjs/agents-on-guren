+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+import { slugify } from '../app/Support/slug.js'
+
+// Posts are addressed by slug (/posts/hello-world). These tests cover how a
+// slug is derived, that it stays put when the title changes, and that the
+// numeric addresses published before slugs existed still resolve.
+describe('post slugs', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({
+      name: 'Demo Author',
+      email: 'author@example.com',
+      password: 'secret',
+    })) as UserRecord
+  })
+
+  async function write(title: string): Promise<string> {
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.post('/posts', {
+      title,
+      excerpt: 'An excerpt.',
+      body: 'A body.',
+    })
+    response.assertStatus(303)
+    return response.headers.get('location') ?? ''
+  }
+
+  describe('slugify', () => {
+    it('keeps lowercase words joined by a single dash', () => {
+      expect(slugify('Hello, World!')).toBe('hello-world')
+      expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+    })
+  })
+
+  it('derives the slug from the title and redirects there', async () => {
+    expect(await write('Hello, World!')).toBe('/posts/hello-world')
+
+    const post = await Post.first({ slug: 'hello-world' })
+    expect(post?.title).toBe('Hello, World!')
+  })
+
+  it('numbers colliding slugs from 2 upwards', async () => {
+    expect(await write('Hello, World!')).toBe('/posts/hello-world')
+    expect(await write('Hello, World!')).toBe('/posts/hello-world-2')
+    expect(await write('Hello, world')).toBe('/posts/hello-world-3')
+  })
+
+  it('keeps the slug when the title is edited', async () => {
+    await write('Hello, World!')
+    const post = await Post.first({ slug: 'hello-world' })
+    const csrf = await http.actingAs(author).withCsrf()
+
+    const response = await csrf.put(`/posts/${post?.id}`, {
+      title: 'Something Else Entirely',
+      excerpt: 'An excerpt.',
+      body: 'A body.',
+    })
+    response.assertStatus(303)
+    expect(response.headers.get('location')).toBe('/posts/hello-world')
+
+    const updated = await Post.findOrFail(post?.id as number)
+    expect(updated.slug).toBe('hello-world')
+    expect(await Post.first({ slug: 'something-else-entirely' })).toBeNull()
+  })
+
+  it('serves the post page by slug and 404s an unknown one', async () => {
+    await write('Hello, World!')
+
+    await http.get('/posts/hello-world').assertOk()
+    await http.get('/posts/no-such-post').assertNotFound()
+  })
+
+  it('permanently redirects the legacy numeric address', async () => {
+    await write('Hello, World!')
+    const post = await Post.first({ slug: 'hello-world' })
+
+    const response = await http.get(`/posts/${post?.id}`)
+    response.assertStatus(301)
+    expect(response.headers.get('location')).toBe('/posts/hello-world')
+
+    await http.get('/posts/999999').assertNotFound()
+  })
+
+  // The pages build their hrefs from the `slug` prop, so what matters on the
+  // server side is that the prop is in the payload those pages receive.
+  it('sends the slug to the list and home pages', async () => {
+    await write('Hello, World!')
+
+    const posts = await http.get('/posts').assertOk()
+    expect(await posts.text()).toContain('"slug":"hello-world"')
+
+    const home = await http.get('/').assertOk()
+    expect(await home.text()).toContain('"slug":"hello-world"')
+  })
+})
