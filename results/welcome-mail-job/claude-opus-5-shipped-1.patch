@@ -0,0 +1,40 @@
+import { Mail, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+import { mailFrom } from '../../config/mail.js'
+
+export interface WelcomeMailData {
+  /** The name the account was registered under. */
+  name: string
+  /** The address the account was registered with. */
+  email: string
+}
+
+/**
+ * The first message a new account gets. `build()` runs when the message is
+ * sent — inside the queued job, not the registration request.
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  override build(): this {
+    const app = appName()
+
+    return this.from(mailFrom())
+      .to(this.data.email)
+      .subject(`Welcome to ${app}, ${this.data.name}!`)
+      .text(
+        [
+          `Hi ${this.data.name},`,
+          '',
+          `Welcome to ${app}! Your account is ready — sign in any time to write your first post.`,
+          '',
+          `— The ${app} team`,
+        ].join('\n'),
+      )
+  }
+}
