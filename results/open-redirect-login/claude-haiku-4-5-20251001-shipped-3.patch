--- /dev/null
+++ b/app/Http/Utils/isSafeRedirectUrl.ts
@@ -0,0 +1,29 @@
+export function isSafeRedirectUrl(url: string): boolean {
+  if (!url) {
+    return true
+  }
+
+  // Reject protocol-relative URLs (//example.com)
+  if (url.startsWith('//')) {
+    return false
+  }
+
+  // Reject backslash variants that browsers treat as protocol-relative
+  // Browsers treat /\ and similar patterns as //, allowing open redirects
+  if (url.startsWith('/\\')) {
+    return false
+  }
+
+  // Reject URLs with schemes (http://, https://, ftp://, etc.)
+  if (/^[a-z][a-z0-9+.-]*:/i.test(url)) {
+    return false
+  }
+
+  // Only allow relative paths starting with /
+  if (url.startsWith('/')) {
+    return true
+  }
+
+  // Allow relative paths like "posts/1" but not "//example.com" or things with backslashes
+  return !url.includes('//') && !url.includes('\\')
+}
