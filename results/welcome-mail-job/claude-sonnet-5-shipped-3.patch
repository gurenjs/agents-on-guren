@@ -0,0 +1,29 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeMailData {
+  name: string
+  email: string
+}
+
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const appName = process.env.APP_NAME ?? 'Guren'
+    const { name } = this.data
+
+    return this.to(this.data.email)
+      .subject(`Welcome to ${appName}, ${name}!`)
+      .text(
+        `Hi ${name},\n\n` +
+          `Welcome to ${appName}! We're glad to have you here.\n\n` +
+          `Head over to your dashboard to get started.\n\n` +
+          `— The ${appName} team`,
+      )
+  }
+}
