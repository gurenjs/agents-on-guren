diff --git a/tests/PostRevisions.test.ts b/tests/PostRevisions.test.ts
new file mode 100644
index 0000000..87af8e6
--- /dev/null
+++ b/tests/PostRevisions.test.ts
@@ -0,0 +1,121 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface RevisionsProps {
+  revisions: Array<{ id: number; title: string; createdAt: string }>
+}
+
+function content(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+  return User.create({ name: label, email: `${label}-${suffix}@example.test`, password: 'password123' })
+}
+
+async function makePost(author: UserRecord, title: string): Promise<PostRecord> {
+  return Post.forceCreate({ ...content(title), authorId: author.id })
+}
+
+async function revisionTitles(postId: number): Promise<string[]> {
+  const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+  return rows.map((row) => row.title)
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  beforeAll(async () => {
+    // Primed with a session and XSRF token, so PUT/POST/DELETE pass CSRF.
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+    author = await makeUser('author')
+    stranger = await makeUser('stranger')
+  })
+
+  async function revisionsProps(as: UserRecord, postId: number): Promise<RevisionsProps> {
+    const response = await http
+      .actingAs(as)
+      .withHeaders({ 'X-Inertia': 'true' })
+      .get(`/posts/${postId}/revisions`)
+      .assertOk()
+    const page = await response.json<{ component: string; props: RevisionsProps }>()
+    expect(page.component).toBe('posts/Revisions')
+    return page.props
+  }
+
+  it('keeps the previous version on each edit and restores one', async () => {
+    const post = await makePost(author, 'First')
+    expect(await revisionTitles(post.id)).toEqual([])
+
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const props = await revisionsProps(author, post.id)
+    expect(props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(typeof props.revisions[0]?.createdAt).toBe('string')
+
+    const first = props.revisions[1]!
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored).toMatchObject(content('First'))
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await makePost(author, 'Kept')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { ...content('Bad'), title: '' }).assertUnprocessable()
+    await http.actingAs(stranger).put(`/posts/${post.id}`, content('Hijack')).assertForbidden()
+
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('keeps history private to the author', async () => {
+    const post = await makePost(author, 'Private')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Private v2'))
+    const [revision] = await PostRevision.where({ postId: post.id }).get()
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(stranger).post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect(await Post.findOrFail(post.id)).toMatchObject(content('Private v2'))
+    expect(await revisionTitles(post.id)).toEqual(['Private'])
+  })
+
+  it('refuses a revision that belongs to another post', async () => {
+    const one = await makePost(author, 'One')
+    const two = await makePost(author, 'Two')
+    await http.actingAs(author).put(`/posts/${two.id}`, content('Two v2'))
+    const [foreign] = await PostRevision.where({ postId: two.id }).get()
+
+    await http.actingAs(author).post(`/posts/${one.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+
+    expect(await Post.findOrFail(one.id)).toMatchObject(content('One'))
+    expect(await revisionTitles(one.id)).toEqual([])
+  })
+
+  it('deletes a post together with its history only', async () => {
+    const doomed = await makePost(author, 'Doomed')
+    const other = await makePost(author, 'Other')
+    await http.actingAs(author).put(`/posts/${doomed.id}`, content('Doomed v2'))
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Other v2'))
+
+    await http.actingAs(author).delete(`/posts/${doomed.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(doomed.id)).toEqual([])
+    expect(await revisionTitles(other.id)).toEqual(['Other'])
+  })
+})
