+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,55 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('shows the 10 newest posts on page 1, not page 2', async () => {
+    const author = await User.forceCreate({
+      name: 'Author',
+      email: 'author@example.com',
+      passwordHash: 'hash',
+    })
+
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: author.id,
+      })
+    }
+
+    const res = await http.json().get('/posts')
+    res.assertOk()
+    const page = await res.json<{
+      props: {
+        data: Array<{ id: number; title: string }>
+        pagination: { meta: { currentPage: number; total: number; from: number; to: number } }
+      }
+    }>()
+
+    const props = page.props
+    if (props.pagination.meta.currentPage !== 1) {
+      throw new Error(`expected currentPage 1, got ${props.pagination.meta.currentPage}`)
+    }
+    if (props.data[0]?.title !== 'Post 25') {
+      throw new Error(`expected newest post first, got ${props.data[0]?.title}`)
+    }
+    if (props.data.length !== 10) {
+      throw new Error(`expected 10 posts, got ${props.data.length}`)
+    }
+    if (props.pagination.meta.from !== 1 || props.pagination.meta.to !== 10) {
+      throw new Error(`expected from/to 1-10, got ${props.pagination.meta.from}-${props.pagination.meta.to}`)
+    }
+  })
+})
