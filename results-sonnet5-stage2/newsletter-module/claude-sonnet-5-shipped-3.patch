@@ -0,0 +1,40 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { NewsletterSubscription } from '../modules/newsletter/index.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('subscribes, rejects duplicates and bad addresses, confirms, unsubscribes', async () => {
+    const csrf = (await http.withCsrf()).json().withHeader('Referer', 'http://localhost/posts')
+
+    const res = await csrf.post('/newsletter/subscribe', { email: 'a@example.com' })
+    expect([302, 303]).toContain(res.status)
+    expect(res.headers.get('location')).toBe('/posts')
+
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+
+    const row = (await NewsletterSubscription.first({ email: 'a@example.com' }))!
+    expect(row.confirmedAt).toBeNull()
+    expect(row.token.length).toBeGreaterThanOrEqual(16)
+
+    await http.get('/newsletter/confirm/nope').assertNotFound()
+    await http.get(`/newsletter/confirm/${row.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ email: 'a@example.com' }))!.confirmedAt).not.toBeNull()
+
+    await csrf.post('/newsletter/unsubscribe', { email: 'a@example.com' })
+    expect(await NewsletterSubscription.all()).toHaveLength(0)
+  })
+})
