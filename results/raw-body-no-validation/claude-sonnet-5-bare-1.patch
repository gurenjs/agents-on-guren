+++ b/tests/ProfileController.test.ts
@@ -0,0 +1,95 @@
+import { afterAll, beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('profile.update', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({
+      name: 'Original Name',
+      email: `profile-test-${crypto.randomUUID()}@example.com`,
+      password: 'original-password',
+    })
+  })
+
+  afterAll(async () => {
+    await User.delete({ id: user.id })
+  })
+
+  it('rejects a malformed email and leaves the account unchanged', async () => {
+    const authed = http.actingAs(user)
+    const csrf = await authed.withCsrf()
+
+    await csrf.put('/profile', { name: 'Still Fine', email: 'not-an-email' }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    if (stored?.email !== user.email) {
+      throw new Error(`expected email to remain ${user.email}, got ${stored?.email}`)
+    }
+  })
+
+  it('rejects an empty name and leaves the account unchanged', async () => {
+    const authed = http.actingAs(user)
+    const csrf = await authed.withCsrf()
+
+    await csrf.put('/profile', { name: '', email: user.email }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    if (stored?.name !== user.name) {
+      throw new Error(`expected name to remain ${user.name}, got ${stored?.name}`)
+    }
+  })
+
+  it('ignores fields outside the profile form, such as id and passwordHash', async () => {
+    const authed = http.actingAs(user)
+    const csrf = await authed.withCsrf()
+    const originalHash = user.passwordHash
+
+    await csrf
+      .put('/profile', {
+        id: user.id + 999,
+        name: 'Updated Name',
+        email: user.email,
+        passwordHash: 'attacker-controlled-hash',
+      })
+      .assertStatus(200)
+
+    const stored = await User.find(user.id)
+    if (!stored) {
+      throw new Error('user row went missing after update')
+    }
+    if (stored.name !== 'Updated Name') {
+      throw new Error(`expected name to be updated, got ${stored.name}`)
+    }
+    if (stored.passwordHash !== originalHash) {
+      throw new Error('passwordHash was overwritten by an unrelated field in the request body')
+    }
+
+    const other = await User.find(user.id + 999)
+    if (other) {
+      throw new Error('a request body id field was able to affect a different row')
+    }
+
+    user = stored
+  })
+
+  it('accepts a valid update', async () => {
+    const authed = http.actingAs(user)
+    const csrf = await authed.withCsrf()
+
+    await csrf
+      .put('/profile', { name: 'Valid Name', email: user.email })
+      .assertStatus(200)
+
+    const stored = await User.find(user.id)
+    if (stored?.name !== 'Valid Name') {
+      throw new Error(`expected name to be Valid Name, got ${stored?.name}`)
+    }
+
+    user = stored
+  })
+})
