@@ -0,0 +1,26 @@
+import { defineMiddleware } from '@guren/core'
+import { checkRateLimit } from '../../Services/RateLimiter.js'
+
+export const rateLimitMiddleware = defineMiddleware(async (c, next) => {
+  const apiToken = c.get('apiToken')
+
+  if (!apiToken) {
+    return await next()
+  }
+
+  const result = checkRateLimit(apiToken.id, 60, 60000)
+
+  if (!result.allowed) {
+    return c.json(
+      { message: 'Too many requests' },
+      {
+        status: 429,
+        headers: {
+          'Retry-After': String(result.retryAfter),
+        },
+      }
+    )
+  }
+
+  return await next()
+})
