+      .get()
+    const existingTagIds = (existingAssociations as any[]).map((a: any) => a.tag_id)
+
+    const toAdd = tagIds.filter((id: any) => !existingTagIds.includes(id))
+    const toRemove = existingTagIds.filter((id: any) => !tagIds.includes(id))
+
+    for (const tagId of toAdd) {
+      // @ts-expect-error - Guren query types are not fully inferred
+      await Tag.query().from('post_tags').insert({ post_id: postId, tag_id: tagId })
+    }
+
+    if (toRemove.length > 0) {
+      // @ts-expect-error - Guren query types are not fully inferred
+      await Tag.query()
+        .from('post_tags')
+        .where('post_id', '=', postId)
+        .whereIn('tag_id', toRemove)
+        .delete()
+    }
+  }
+
+  static async getTagsForPost(postId: number): Promise<string[]> {
+    // @ts-expect-error - Guren query types are not fully inferred
+    const postTags = await Tag.query()
+      .select('name')
+      .from('tags')
+      .whereIn('id', (q: any) =>
+        q.select('tag_id').from('post_tags').where('post_id', '=', postId),
+      )
+      .orderBy('name', 'asc')
+      .get()
+
+    return (postTags as any[]).map((t: any) => t.name)
+  }
+
+  static async findPostIdsByTag(tagName: string): Promise<number[]> {
+    // @ts-expect-error - Guren query types are not fully inferred
+    const results = await Tag.query()
+      .select('post_id')
+      .from('post_tags')
+      .whereIn('tag_id', (q: any) =>
+        q.select('id').from('tags').where('name', '=', tagName),
+      )
+      .get()
+
+    return (results as any[]).map((r: any) => r.post_id)
+  }
