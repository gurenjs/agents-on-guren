+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { requireBearerToken } from '../app/Http/Middleware/BearerTokenAuth.js'
+import { apiTokenRateLimit } from '../app/Http/Middleware/ApiTokenRateLimit.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  const apiRouter = baseRouter
+    .aliasMiddleware('bearerAuth', requireBearerToken)
+    .aliasMiddleware('apiRateLimit', apiTokenRateLimit)
+
+  apiRouter.group('/api', (api) => {
+    api.middleware('bearerAuth').group((bearer) => {
+      bearer.middleware('apiRateLimit').group((protected_) => {
+        protected_.group('/posts', (posts) => {
+          posts.get('/', [ApiPostController, 'index']).name('api.posts.index')
+          posts.post('/', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+        })
+      })
+    })
+  })
+}
