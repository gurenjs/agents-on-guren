diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..8c8910e
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,149 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+let userSeq = 0
+
+async function makeUser(name: string) {
+  userSeq += 1
+  return User.create({ name, email: `${name.toLowerCase()}${userSeq}@example.com`, password: 'password123' })
+}
+
+async function makePost(authorId: number) {
+  return Post.forceCreate({ title: 'A post', excerpt: 'Excerpt', body: 'Body', authorId })
+}
+
+// Loaded lazily so each behaviour fails on its own until the Comment model exists.
+const loadComment = async () => (await import('../app/Models/Comment.js')).Comment
+
+async function makeComment(postId: number, userId: number, body: string) {
+  const Comment = await loadComment()
+  return Comment.forceCreate({ postId, userId, body })
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('[AC-comments-1] A signed-in user can comment on someone else\'s post, and the post page lists the comment with its author.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const post = await makePost(writer.id)
+
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Nice post' }).assertRedirect(`/posts/${post.id}`)
+
+    const Comment = await loadComment()
+    const rows = await Comment.where({ postId: post.id }).get()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.body).toBe('Nice post')
+    expect(rows[0]?.userId).toBe(reader.id)
+  })
+
+  it('[AC-comments-2] An empty comment is rejected.', async () => {
+    const writer = await makeUser('Writer')
+    const post = await makePost(writer.id)
+
+    const csrf = await http.actingAs(writer).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    expect(await (await loadComment()).all()).toHaveLength(0)
+  })
+
+  it('[AC-comments-3] A comment longer than 2000 characters is rejected.', async () => {
+    const writer = await makeUser('Writer')
+    const post = await makePost(writer.id)
+
+    const csrf = await http.actingAs(writer).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await (await loadComment()).all()).toHaveLength(0)
+  })
+
+  it('[AC-comments-4] A guest who tries to comment is sent to the login page and nothing is stored.', async () => {
+    const writer = await makeUser('Writer')
+    const post = await makePost(writer.id)
+
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+    expect(await (await loadComment()).all()).toHaveLength(0)
+  })
+
+  it('[AC-comments-5] The post page lists visible comments oldest first, each with id, body, author and createdAt.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const post = await makePost(writer.id)
+    const first = await makeComment(post.id, reader.id, 'First')
+    const second = await makeComment(post.id, writer.id, 'Second')
+
+    await http.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`).assertInertia('posts/Show', {
+      comments: [
+        { id: first.id, body: 'First', author: { id: reader.id, name: 'Reader' }, createdAt: new Date(first.createdAt).toISOString() },
+        { id: second.id, body: 'Second', author: { id: writer.id, name: 'Writer' }, createdAt: new Date(second.createdAt).toISOString() },
+      ],
+    })
+  })
+
+  it('[AC-comments-6] The author of a comment can delete it.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const post = await makePost(writer.id)
+    const comment = await makeComment(post.id, reader.id, 'Mine')
+
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await (await loadComment()).find(comment.id)).toBeNull()
+  })
+
+  it('[AC-comments-7] The author of the post can delete someone else\'s comment on it.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const post = await makePost(writer.id)
+    const comment = await makeComment(post.id, reader.id, 'Theirs')
+
+    const csrf = await http.actingAs(writer).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await (await loadComment()).find(comment.id)).toBeNull()
+  })
+
+  it('[AC-comments-8] A user who wrote neither the comment nor the post cannot delete the comment, and it stays.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const stranger = await makeUser('Stranger')
+    const post = await makePost(writer.id)
+    const comment = await makeComment(post.id, reader.id, 'Keep me')
+
+    const csrf = await http.actingAs(stranger).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await (await loadComment()).find(comment.id)).not.toBeNull()
+  })
+
+  it('[AC-comments-9] A guest cannot delete a comment.', async () => {
+    const writer = await makeUser('Writer')
+    const post = await makePost(writer.id)
+    const comment = await makeComment(post.id, writer.id, 'Hello')
+
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect('/login')
+    expect(await (await loadComment()).find(comment.id)).not.toBeNull()
+  })
+
+  it('[AC-comments-10] Deleting a post removes its comments.', async () => {
+    const writer = await makeUser('Writer')
+    const reader = await makeUser('Reader')
+    const post = await makePost(writer.id)
+    await makeComment(post.id, reader.id, 'On a deleted post')
+
+    const csrf = await http.actingAs(writer).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await (await loadComment()).all()).toHaveLength(0)
+  })
+})
