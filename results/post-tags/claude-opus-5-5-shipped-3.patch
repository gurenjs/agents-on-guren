diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..7e50f6c
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,95 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface InertiaPage {
+  component: string
+  props: Record<string, any>
+}
+
+async function inertiaProps(http: TestApp, path: string): Promise<Record<string, any>> {
+  const res = await http.withHeaders({ 'X-Inertia': 'true', 'X-Inertia-Version': '' }).get(path)
+  const text = await res.text()
+  const page = JSON.parse(text) as InertiaPage
+  return page.props
+}
+
+const payload = (tags?: string) => ({ title: 'Hello', excerpt: 'Short', body: 'Long body', tags })
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function createPost(tags?: string): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', payload(tags)).assertRedirect()
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+    return posts[0]!.id
+  }
+
+  it('creates, edits and shows tags', async () => {
+    const id = await createPost('webdev, bun')
+    expect((await Tag.all()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(2)
+    expect((await inertiaProps(http, `/posts/${id}`)).post.tags).toEqual(['bun', 'webdev'])
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${id}`, payload('bun')).assertRedirect(`/posts/${id}`)
+    expect((await inertiaProps(http, `/posts/${id}`)).post.tags).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('filters the list by tag and keeps the filter in page links', async () => {
+    const tagged = await createPost('bun')
+    await createPost('')
+
+    const filtered = await inertiaProps(http, '/posts?tag=bun')
+    expect(filtered.data.map((post: { id: number }) => post.id)).toEqual([tagged])
+    expect(JSON.stringify(filtered.pagination.links)).toContain('tag=bun')
+
+    expect((await inertiaProps(http, '/posts?tag=nope')).data).toEqual([])
+
+    const all = await inertiaProps(http, '/posts')
+    expect(all.data.map((post: { tags: string[] }) => post.tags)).toEqual([[], ['bun']])
+  })
+
+  it('refuses six tags and overlong names without writing anything', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const emptyTitle = await csrf.json().post('/posts', { ...payload(), title: '' })
+    const status = emptyTitle.status
+
+    const six = await csrf.json().post('/posts', payload('a,b,c,d,e,f'))
+    expect(six.status).toBe(status)
+    expect(Object.keys((await six.json<{ errors: object }>()).errors)).toEqual(['tags'])
+
+    await csrf.json().post('/posts', payload('x'.repeat(31))).assertStatus(status)
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+
+    await createPost('x'.repeat(30))
+    expect(await Tag.newQuery().count()).toBe(1)
+  })
+
+  it('dedupes trimmed names and deletes tagged posts', async () => {
+    const id = await createPost(' bun ,bun,,')
+    expect((await Tag.all()).map((tag) => tag.name)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+})
