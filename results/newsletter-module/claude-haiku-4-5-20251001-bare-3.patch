+++ b/tests/NewsletterController.test.ts
@@ -0,0 +1,134 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+function uniqueEmail(prefix: string): string {
+  return `${prefix}-${Date.now()}-${Math.random().toString(36).substring(7)}@example.com`
+}
+
+describe('Newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  describe('POST /newsletter/subscribe', () => {
+    it('rejects an empty email', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.json().post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+    })
+
+    it('rejects an invalid email', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.json().post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    })
+
+    it('creates a subscription with a valid email', async () => {
+      const csrf = await http.withCsrf()
+      const email = uniqueEmail('test')
+      await csrf
+        .json()
+        .post('/newsletter/subscribe', { email })
+        .assertStatus(303)
+    })
+
+    it('prevents duplicate subscriptions', async () => {
+      const email = uniqueEmail('duplicate')
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .withHeader('Referer', 'http://localhost/')
+        .post('/newsletter/subscribe', { email })
+        .assertStatus(303)
+
+      const csrf2 = await http.withCsrf()
+      await csrf2
+        .json()
+        .withHeader('Referer', 'http://localhost/')
+        .post('/newsletter/subscribe', { email })
+        .assertStatus(422)
+    })
+
+    it('redirects to referer if provided', async () => {
+      const csrf = await http.withCsrf()
+      const email = uniqueEmail('referer')
+      await csrf
+        .json()
+        .withHeader('Referer', 'http://localhost/posts/123')
+        .post('/newsletter/subscribe', { email })
+        .assertRedirect('http://localhost/posts/123')
+    })
+
+    it('redirects to home if no referer', async () => {
+      const csrf = await http.withCsrf()
+      const email = uniqueEmail('noreferer')
+      await csrf
+        .json()
+        .post('/newsletter/subscribe', { email })
+        .assertRedirect('/')
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('returns 404 for invalid token', async () => {
+      await http.get('/newsletter/confirm/invalid-token').assertStatus(404)
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('rejects an empty email', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.json().post('/newsletter/unsubscribe', { email: '' }).assertStatus(422)
+    })
+
+    it('rejects an invalid email', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.json().post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertStatus(422)
+    })
+
+    it('redirects to referer if provided', async () => {
+      const email = uniqueEmail('unsub2')
+      // Create subscription first
+      const csrf1 = await http.withCsrf()
+      await csrf1
+        .json()
+        .withHeader('Referer', 'http://localhost/')
+        .post('/newsletter/subscribe', { email })
+        .assertStatus(303)
+
+      // Then unsubscribe
+      const csrf2 = await http.withCsrf()
+      await csrf2
+        .json()
+        .withHeader('Referer', 'http://localhost/posts/456')
+        .post('/newsletter/unsubscribe', { email })
+        .assertRedirect('http://localhost/posts/456')
+    })
+
+    it('redirects to home if no referer', async () => {
+      const email = uniqueEmail('unsub3')
+      // Create subscription first
+      const csrf1 = await http.withCsrf()
+      await csrf1
+        .json()
+        .withHeader('Referer', 'http://localhost/')
+        .post('/newsletter/subscribe', { email })
+        .assertStatus(303)
+
+      // Then unsubscribe without referer
+      const csrf2 = await http.withCsrf()
+      await csrf2.json().post('/newsletter/unsubscribe', { email }).assertRedirect('/')
+    })
+
+    it('handles unsubscribing non-existent email gracefully', async () => {
+      const csrf = await http.withCsrf()
+      const email = uniqueEmail('nonexistent')
+      await csrf
+        .json()
+        .withHeader('Referer', 'http://localhost/')
+        .post('/newsletter/unsubscribe', { email })
+        .assertStatus(303)
+    })
+  })
+})
