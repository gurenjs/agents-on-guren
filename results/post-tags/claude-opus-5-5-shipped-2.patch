+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+/** Splits the comma-separated field into trimmed, non-empty, de-duplicated (case-sensitive) names. */
+export function parseTagNames(input: string | null | undefined): string[] {
+  if (!input) return []
+  const names = input.split(',').map((name) => name.trim()).filter((name) => name.length > 0)
+  return [...new Set(names)]
+}
+
+// Stays a string after validation: codegen types `validated()` from a
+// transform's input side, so the controller splits it with parseTagNames().
+// Issues carry no path so they land on `tags` itself, not `tags.0`.
+const TagsFieldSchema = z
+  .string()
+  .nullish()
+  .superRefine((input, ctx) => {
+    const names = parseTagNames(input)
+    if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+  })
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: TagsFieldSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
