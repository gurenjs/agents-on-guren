@@ -0,0 +1,38 @@
+import { MemoryDriver, SyncDriver, RedisDriver, type QueueConfig } from '@guren/core'
+import { createRedisClient } from '@guren/core/redis'
+
+/**
+ * Background queue configuration, read from the environment.
+ *
+ * `QUEUE_CONNECTION` picks the driver:
+ *
+ * - `sync` (the development default) runs a dispatched job immediately, in the
+ *   dispatching process, so there is no worker to start locally.
+ * - `memory` holds jobs in this process until something pops them — what tests
+ *   use to assert that work was queued, then run it themselves.
+ * - `redis` hands jobs to Redis, where a separate `guren queue:work` process
+ *   picks them up. This is the production setup.
+ *
+ * Dispatchers never name a driver, so moving from `sync` to `redis` is an
+ * environment change, not a code change.
+ *
+ * Read lazily, like `config/database.ts` resolves its filename: the value is
+ * resolved when the queue manager is first built rather than when this module
+ * is imported, so a test or a worker can set the environment before booting.
+ */
+export function queueConfig(): QueueConfig {
+  return {
+    default: process.env.QUEUE_CONNECTION ?? 'sync',
+    drivers: {
+      sync: () => new SyncDriver(),
+      memory: () => new MemoryDriver(),
+      redis: () => {
+        const url = process.env.REDIS_URL?.trim()
+        if (!url) {
+          throw new Error('QUEUE_CONNECTION=redis requires REDIS_URL to point at the Redis instance holding the queue.')
+        }
+        return new RedisDriver(createRedisClient({ url }))
+      },
+    },
+  }
+}
