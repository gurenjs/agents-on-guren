+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,19 @@
+import { defineModel } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+export class PostRevision extends defineModel(postRevisions, {
+  fillable: ['title', 'excerpt', 'body'],
+}) {
+  // forceCreate: `postId` is set by the server, never from request input.
+  static keep(post: PostRecord) {
+    return PostRevision.forceCreate({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+  }
+}
