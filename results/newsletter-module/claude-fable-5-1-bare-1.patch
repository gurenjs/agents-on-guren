+import { defineArchRules } from '@guren/cli/arch'
+
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      // Stricter than the built-in module boundary, which lets outside code
+      // import a module's index.ts and db/schema.ts. Type-only imports count
+      // too: the blog must compile with modules/newsletter/ removed.
+      includeTypeImports: true,
+      message:
+        'The newsletter is a self-contained module that ships with other apps. The blog (app/, routes/) must not depend on it; src/app.ts is the only place that registers it.',
+    },
+  ],
+})
