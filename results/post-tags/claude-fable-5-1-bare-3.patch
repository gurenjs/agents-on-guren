+
+  /**
+   * Makes `names` the post's tags: a name never seen becomes a new tag, every
+   * name is attached, and an attached tag missing from `names` is detached.
+   * The tag itself stays, even when no post carries it. Takes the transaction
+   * the post is written in, so a post is never saved with half its tags.
+   */
+  static async syncTags(postId: number, names: readonly string[], trx: TransactionHandle): Promise<void> {
+    const known = names.length > 0 ? await Tag.newQuery({ trx }).whereIn('name', names).get() : []
+    const idsByName = new Map(known.map((tag) => [tag.name, tag.id]))
+
+    const wanted = new Set<number>()
+    for (const name of names) {
+      const id = idsByName.get(name) ?? (await Tag.create({ name }, { trx })).id
+      wanted.add(id)
+    }
+
+    const attached = new Set((await PostTag.newQuery({ trx }).where('postId', postId).get()).map((row) => row.tagId))
+
+    const removed = [...attached].filter((id) => !wanted.has(id))
+    if (removed.length > 0) {
+      await PostTag.newQuery({ trx }).where('postId', postId).whereIn('tagId', removed).delete()
+    }
+
+    for (const tagId of wanted) {
+      if (!attached.has(tagId)) {
+        await PostTag.create({ postId, tagId }, { trx })
+      }
+    }
   }
 }
 
