+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import {
+  LOGIN_MAX_ATTEMPTS,
+  LOGIN_THROTTLE_WINDOW_MS,
+  throttleLogin,
+} from '../app/Http/Middleware/ThrottleLogin.js'
+
+// The throttle counts submissions before the controller runs, so these cover
+// it without a login that reaches the database: a body the LoginSchema
+// rejects still spends an attempt, which is exactly the point — an attacker
+// must not be able to probe for free. The one client here is the shared
+// bucket TestApp requests fall into (no socket peer address in process).
+describe('login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('refuses submissions past the limit with 429 and Retry-After', async () => {
+    const client = await http.withCsrf()
+    const submit = () => client.post('/login', { email: 'nobody@example.com', password: 'wrong' })
+
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt += 1) {
+      const response = await submit()
+      expect(response.status).not.toBe(429)
+    }
+
+    const throttled = await submit()
+    throttled.assertStatus(429)
+
+    const retryAfter = throttled.headers.get('Retry-After')
+    expect(retryAfter).not.toBeNull()
+    expect(Number(retryAfter)).toBeGreaterThan(0)
+    expect(Number(retryAfter)).toBeLessThanOrEqual(60)
+  })
+
+  it('leaves the login form and other pages reachable while throttled', async () => {
+    await http.get('/login').assertOk()
+    await http.get('/health').assertOk()
+  })
+
+  // Mounted on a bare route with an injected clock, so the window can be
+  // stepped over instead of slept through.
+  it('lets the client submit again once the window has passed', async () => {
+    let clock = Date.parse('2026-08-18T09:00:00Z')
+    const isolated = await TestApp.create({
+      routes: (router) => {
+        router.post('/login', (c) => c.json({ ok: true }), throttleLogin({ now: () => clock }))
+      },
+    })
+
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt += 1) {
+      await isolated.post('/login', {}).assertOk()
+    }
+    await isolated.post('/login', {}).assertStatus(429)
+
+    // Forwarded-for style headers are client-controlled, so a spoofed one must
+    // not buy a fresh bucket.
+    await isolated
+      .withHeaders({ 'X-Forwarded-For': '203.0.113.9', 'X-Real-IP': '203.0.113.9' })
+      .post('/login', {})
+      .assertStatus(429)
+
+    clock += LOGIN_THROTTLE_WINDOW_MS
+    await isolated.post('/login', {}).assertOk()
+  })
+})
