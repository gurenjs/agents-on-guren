@@ -0,0 +1,19 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish in the future (id, title, published_at), soonest first'
+
+  async handle(): Promise<void> {
+    const now = Date.now()
+    const scheduled = (await Post.newQuery().whereNotNull('publishedAt').get())
+      .filter((post) => Date.parse(post.publishedAt as string) > now)
+      .sort((a, b) => Date.parse(a.publishedAt as string) - Date.parse(b.publishedAt as string) || a.id - b.id)
+
+    // Plain stdout, one line per post: this output is piped into other tools.
+    for (const post of scheduled) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+  }
+}
