diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..4134985
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,117 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+// The sign-in page renders for a guest without reading the database, so these
+// tests stay green without migrations or fixtures — like the other starter tests.
+const PAGE = '/login'
+
+type I18nProps = {
+  locale: string
+  messages: Record<string, Record<string, Record<string, string>>>
+}
+
+async function readI18n(http: TestApp, path = PAGE): Promise<I18nProps> {
+  const response = await http.get(path)
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props._i18n as I18nProps
+}
+
+function withCookie(http: TestApp, cookies: Record<string, string>, name: string, value: string): TestApp {
+  const jar = { ...cookies, [name]: value }
+  return http.withHeader('Cookie', Object.entries(jar).map(([key, val]) => `${key}=${val}`).join('; '))
+}
+
+describe('locale', () => {
+  let guest: TestApp
+  let browser: TestApp
+  let cookies: Record<string, string>
+
+  beforeAll(async () => {
+    guest = await TestApp.fromApp(app)
+
+    // A browser that already holds the session and XSRF-TOKEN cookies.
+    const primed = await guest.get(PAGE)
+    cookies = Object.fromEntries(
+      primed.headers.getSetCookie().map((header) => {
+        const [pair = ''] = header.split(';')
+        const separator = pair.indexOf('=')
+        return [pair.slice(0, separator).trim(), pair.slice(separator + 1).trim()]
+      }),
+    )
+    browser = await guest.withCsrf(PAGE)
+  })
+
+  it('renders English by default', async () => {
+    const i18n = await readI18n(guest)
+
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en?.nav?.posts).toBe('Posts')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    for (const header of ['ja', 'ja-JP,ja;q=0.9,en;q=0.8']) {
+      const i18n = await readI18n(guest.withHeader('Accept-Language', header))
+
+      expect(i18n.locale).toBe('ja')
+      expect(i18n.messages.ja?.nav?.posts).toBe('記事')
+    }
+  })
+
+  it('remembers the picked language and redirects back', async () => {
+    const response = await browser
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+
+    expect(response.status).toBe(303)
+    expect(response.headers.get('Location')).toBe('http://localhost/posts')
+    const picked = response.headers.getSetCookie().find((header) => header.startsWith('locale='))
+    expect(picked).toStartWith('locale=ja;')
+
+    const i18n = await readI18n(withCookie(guest, cookies, 'locale', 'ja'))
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja?.auth?.login).toBe('ログイン')
+  })
+
+  it('lets the pick win over the browser language', async () => {
+    const i18n = await readI18n(
+      withCookie(guest, cookies, 'locale', 'en').withHeader('Accept-Language', 'ja'),
+    )
+
+    expect(i18n.locale).toBe('en')
+  })
+
+  it('redirects home without a Referer', async () => {
+    const response = await browser.post('/locale', { locale: 'en' })
+
+    expect(response.headers.get('Location')).toBe('/')
+  })
+
+  it('never redirects to another site', async () => {
+    const response = await browser
+      .withHeader('Referer', 'https://elsewhere.example/posts?page=2')
+      .post('/locale', { locale: 'ja' })
+
+    expect(response.headers.get('Location')).toBe('/posts?page=2')
+  })
+
+  it('rejects an unsupported or missing locale without changing the pick', async () => {
+    for (const body of [{ locale: 'fr' }, {}]) {
+      const response = await browser.post('/locale', body)
+
+      expect(response.status).toBe(422)
+      expect(response.headers.getSetCookie().some((header) => header.startsWith('locale='))).toBe(false)
+    }
+  })
+
+  // The same redirect-with-errors an invalid post form gets from Inertia.
+  it('sends an Inertia visit with an unsupported locale back with errors', async () => {
+    const response = await browser
+      .withHeaders({ 'X-Inertia': 'true', Referer: 'http://localhost/posts' })
+      .post('/locale', { locale: 'fr' })
+
+    expect(response.status).toBe(303)
+    expect(response.headers.get('Location')).toBe('http://localhost/posts')
+    expect(response.headers.getSetCookie().some((header) => header.startsWith('locale='))).toBe(false)
+  })
+})
