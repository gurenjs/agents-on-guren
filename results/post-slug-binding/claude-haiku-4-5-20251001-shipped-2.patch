diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..15dc1ed
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,35 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('Post slugs', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('strips special characters from slug', () => {
+    const testCases = [
+      { title: 'Hello & World!', expected: 'hello-world' },
+      { title: '  Guren  &  Bun: 2026 Edition!  ', expected: 'guren-bun-2026-edition' },
+      { title: 'Multiple---Dashes', expected: 'multiple-dashes' },
+    ]
+
+    for (const { title, expected } of testCases) {
+      const slug = Post.generateSlug(title)
+      if (slug !== expected) {
+        throw new Error(`Expected slug "${expected}" for title "${title}", got "${slug}"`)
+      }
+    }
+  })
+
+  it('returns 404 for non-existent slug', async () => {
+    await http.get('/posts/nonexistent-slug-xyz-' + Date.now()).assertNotFound()
+  })
+
+  it('returns 404 for non-existent numeric ID', async () => {
+    await http.get('/posts/99999').assertNotFound()
+  })
+})
