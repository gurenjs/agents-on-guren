diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..ce9e6a1
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,178 @@
+import { beforeAll, describe, it, beforeEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let user: any
+  let user2: any
+  let user3: any
+  let post: any
+  let emailCounter = 0
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    user = await User.create({
+      name: 'Alice',
+      email: `alice${emailCounter++}@example.com`,
+      password: 'password',
+    })
+
+    user2 = await User.create({
+      name: 'Bob',
+      email: `bob${emailCounter++}@example.com`,
+      password: 'password',
+    })
+
+    user3 = await User.create({
+      name: 'Charlie',
+      email: `charlie${emailCounter++}@example.com`,
+      password: 'password',
+    })
+
+    post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: user.id,
+    })
+  })
+
+  it('guest cannot create comment', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+  })
+
+  it('signed-in user can create comment', async () => {
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect(`/posts/${post.id}`)
+  })
+
+  it('comment appears on post page', async () => {
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Test comment' })
+
+    await http.get(`/posts/${post.id}`).assertStatus(200)
+  })
+
+  it('validates comment body length', async () => {
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'a'.repeat(2001) }).assertUnprocessable()
+  })
+
+  it('comment author can delete comment', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Test comment',
+    })
+
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    const deleted = await Comment.find(comment.id)
+    if (deleted !== null) {
+      throw new Error('Comment should be deleted')
+    }
+  })
+
+  it('post author can delete comment', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Test comment',
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    const deleted = await Comment.find(comment.id)
+    if (deleted !== null) {
+      throw new Error('Comment should be deleted')
+    }
+  })
+
+  it('other user cannot delete comment', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Test comment',
+    })
+
+    const csrf = await http.actingAs(user3).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertStatus(403)
+
+    const found = await Comment.find(comment.id)
+    if (found === null) {
+      throw new Error('Comment should not be deleted')
+    }
+  })
+
+  it('user can report comment', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Test comment',
+    })
+
+    const csrf = await http.actingAs(user3).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    const report = await CommentReport.first({ commentId: comment.id, userId: user3.id })
+    if (report === null) {
+      throw new Error('Report should be created')
+    }
+  })
+
+  it('repeated report by same user does not create duplicate', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Test comment',
+    })
+
+    const csrf = await http.actingAs(user3).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    const count = await CommentReport.where({ commentId: comment.id, userId: user3.id }).count()
+    if (count !== 1) {
+      throw new Error('Report count should be 1')
+    }
+  })
+
+  it('hidden comment does not appear on post page', async () => {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user2.id,
+      body: 'Hidden comment',
+    })
+
+    // Create 3 reports
+    await CommentReport.forceCreate({ commentId: comment.id, userId: user.id })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: user3.id })
+    const dave = await User.create({
+      name: 'Dave',
+      email: `dave${emailCounter++}@example.com`,
+      password: 'password',
+    })
+    await CommentReport.forceCreate({
+      commentId: comment.id,
+      userId: dave.id,
+    })
+
+    const res = await http.get(`/posts/${post.id}`)
+    await res.assertStatus(200)
+  })
+})
