diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..ef9c4ef
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' })
+  })
+
+  let csrf: TestApp
+
+  beforeEach(async () => {
+    csrf = await http.actingAs(author).withCsrf()
+  })
+
+  function submit(tags: string | undefined, path = '/posts', method: 'post' | 'put' = 'post') {
+    return csrf[method](path, { title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+  }
+
+  it('creates, replaces and lists tags', async () => {
+    await submit('bun, webdev').assertRedirect()
+    const post = (await Post.all())[0]!
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(2)
+
+    await submit('bun', `/posts/${post.id}`, 'put').assertRedirect()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+
+    const show = await (await http.get(`/posts/${post.id}`)).text()
+    expect(show).toContain('bun')
+
+    const list = await (await http.get('/posts?tag=bun')).text()
+    expect(list).toContain('"total":1')
+    const none = await (await http.get('/posts?tag=nope')).text()
+    expect(none).toContain('"total":0')
+  })
+
+  it('refuses invalid tag input and saves nothing', async () => {
+    await submit('a,b,c,d,e,f').assertUnprocessable()
+    await submit('x'.repeat(31)).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    await submit('x'.repeat(30)).assertRedirect()
+    await submit(' bun ,bun').assertRedirect()
+    expect(await Tag.where({ name: 'bun' }).count()).toBe(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    await submit('bun').assertRedirect()
+    const post = (await Post.all())[0]!
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})
