diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..3c69527
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,96 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync, readdirSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const COVER_DIR = new URL('../storage/covers/', import.meta.url).pathname
+const stored = () => (existsSync(COVER_DIR) ? readdirSync(COVER_DIR).length : 0)
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 4, 5, 6])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  if (cover) data.append('cover', cover)
+  return data
+}
+
+const fields = { title: 'Hello', excerpt: 'Short', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const user = await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    http = await (await TestApp.fromApp(app)).actingAs(user).withCsrf('/posts')
+  })
+
+  async function latestPostId(): Promise<number> {
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    return post!.id
+  }
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const before = stored()
+    await http.post('/posts', form(fields, new File([PNG], 'a.png', { type: 'image/png' }))).assertRedirect()
+    const id = await latestPostId()
+    const first = await Attachment.newQuery().where('postId', id).first()
+    expect(first).toBeTruthy()
+    expect(stored()).toBe(before + 1)
+
+    const served = await http.get(`/covers/${first!.key}`)
+    served.assertStatus(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    // no file, no checkbox: cover untouched
+    await http.put(`/posts/${id}`, form(fields)).assertRedirect()
+    expect((await Attachment.newQuery().where('postId', id).first())!.key).toBe(first!.key)
+
+    // replace
+    await http.put(`/posts/${id}`, form(fields, new File([JPEG], 'b.jpg', { type: 'image/jpeg' }))).assertRedirect()
+    const second = await Attachment.newQuery().where('postId', id).first()
+    expect(second!.key).not.toBe(first!.key)
+    expect(stored()).toBe(before + 1)
+    ;(await http.get(`/covers/${first!.key}`)).assertStatus(404)
+    ;(await http.get(`/covers/${second!.key}`)).assertStatus(200)
+
+    // a GIF is refused and nothing changes
+    await http.put(`/posts/${id}`, form(fields, new File([GIF], 'c.gif', { type: 'image/gif' }))).assertStatus(422)
+    expect((await Attachment.newQuery().where('postId', id).first())!.key).toBe(second!.key)
+
+    // remove
+    await http.put(`/posts/${id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect(await Attachment.newQuery().where('postId', id).first()).toBeNull()
+    expect(stored()).toBe(before)
+
+    // delete with the post
+    await http.put(`/posts/${id}`, form(fields, new File([PNG], 'a.png', { type: 'image/png' }))).assertRedirect()
+    expect(stored()).toBe(before + 1)
+    await http.delete(`/posts/${id}`).assertRedirect()
+    expect(stored()).toBe(before)
+    expect(await Attachment.newQuery().where('postId', id).first()).toBeNull()
+  })
+
+  it('refuses a bad or oversized cover without creating a post', async () => {
+    const posts = (await Post.newQuery().get()).length
+    const before = stored()
+    await http.post('/posts', form(fields, new File([GIF], 'c.gif', { type: 'image/gif' }))).assertStatus(422)
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form(fields, new File([big], 'big.png', { type: 'image/png' }))).assertStatus(422)
+    expect((await Post.newQuery().get()).length).toBe(posts)
+    expect(stored()).toBe(before)
+  })
+})
