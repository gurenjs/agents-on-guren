new file mode 100644
index 0000000..9f7a4f1
--- /dev/null
+++ b/modules/newsletter/tests/NewsletterController.test.ts
@@ -0,0 +1,63 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { migrateDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const referer = 'http://localhost/posts?page=2'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  beforeEach(async () => {
+    for (const row of await NewsletterSubscription.all()) {
+      await NewsletterSubscription.delete({ id: row.id })
+    }
+  })
+
+  const post = (path: string, body: unknown) =>
+    http.withHeader('Referer', referer).post(path, body)
+
+  it('stores a pending subscription and redirects back', async () => {
+    await post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/posts?page=2')
+
+    const row = await NewsletterSubscription.first({ email: 'reader@example.com' })
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses', async () => {
+    await post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    await post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+    await post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    await post('/newsletter/subscribe', { email: 'reader@example.com' }).assertStatus(422)
+
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s on an unknown one', async () => {
+    await post('/newsletter/subscribe', { email: 'reader@example.com' })
+    const row = await NewsletterSubscription.first({ email: 'reader@example.com' })
+
+    await http.get('/newsletter/confirm/not-a-real-token-at-all').assertNotFound()
+    await http.get(`/newsletter/confirm/${row!.token}`).assertRedirect('/')
+
+    const confirmed = await NewsletterSubscription.first({ id: row!.id })
+    expect(confirmed?.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given address', async () => {
+    await post('/newsletter/subscribe', { email: 'a@example.com' })
+    await post('/newsletter/subscribe', { email: 'b@example.com' })
+
+    await post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('/posts?page=2')
+
+    const remaining = await NewsletterSubscription.all()
+    expect(remaining.map((row) => row.email)).toEqual(['b@example.com'])
+  })
+})
