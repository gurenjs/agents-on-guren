diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..558877b
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,108 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { posts, postTags, tags, users } from '../db/schema.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+const database = async () => (await getDatabase()) as SQLiteBunDatabase
+
+async function inertiaProps(http: TestApp, path: string): Promise<Record<string, any>> {
+  const response = await http.withHeaders({ 'X-Inertia': 'true' }).get(path)
+  const page = (await response.json()) as { props: Record<string, any> }
+  return page.props
+}
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const props = await inertiaProps(guest, `/posts/${postId}`)
+  return props.post.tags
+}
+
+async function latestPostId(): Promise<number> {
+  const [latest] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+  return latest!.id
+}
+
+let guest: TestApp
+let author: TestApp
+
+describe('post tags', () => {
+  beforeAll(async () => {
+    await migrateDatabase()
+    guest = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    const db = await database()
+    await db.delete(postTags)
+    await db.delete(tags)
+    await db.delete(posts)
+    await db.delete(users)
+    const user = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    author = await guest.actingAs(user).withCsrf('/posts')
+  })
+
+  const payload = (tagField?: string) => ({
+    title: 'Tagged',
+    excerpt: 'An excerpt',
+    body: 'A body',
+    ...(tagField === undefined ? {} : { tags: tagField }),
+  })
+
+  it('creates, edits and filters by tags', async () => {
+    await author.json().post('/posts', payload('webdev, bun')).assertStatus(303)
+    const tagged = await latestPostId()
+    expect(await tagNamesOf(tagged)).toEqual(['bun', 'webdev'])
+    expect(await (await database()).select().from(postTags)).toHaveLength(2)
+
+    await author.json().post('/posts', payload()).assertStatus(303)
+    const untagged = await latestPostId()
+    expect(await tagNamesOf(untagged)).toEqual([])
+
+    await author.json().put(`/posts/${tagged}`, payload('bun')).assertStatus(303)
+    expect(await tagNamesOf(tagged)).toEqual(['bun'])
+    expect(await (await database()).select().from(postTags)).toHaveLength(1)
+
+    const filtered = await inertiaProps(guest, '/posts?tag=bun')
+    expect(filtered.data.map((post: { id: number }) => post.id)).toEqual([tagged])
+    expect(filtered.pagination.links.pages[0].url).toContain('tag=bun')
+    expect((await inertiaProps(guest, '/posts?tag=webdev')).data).toEqual([])
+    expect((await inertiaProps(guest, '/posts?tag=nobody')).data).toEqual([])
+
+    const all = await inertiaProps(guest, '/posts')
+    expect(all.data.map((post: { tags: string[] }) => post.tags)).toEqual([[], ['bun']])
+
+    await author.json().delete(`/posts/${tagged}`).assertStatus(303)
+    expect(await (await database()).select().from(postTags)).toHaveLength(0)
+  })
+
+  it('trims and de-duplicates names', async () => {
+    await author.json().post('/posts', payload(' bun ,bun,, ')).assertStatus(303)
+    expect(await tagNamesOf(await latestPostId())).toEqual(['bun'])
+    expect(await (await database()).select().from(tags)).toHaveLength(1)
+    expect(await (await database()).select().from(postTags)).toHaveLength(1)
+  })
+
+  it('accepts a 30-character name', async () => {
+    await author.json().post('/posts', payload('a'.repeat(30))).assertStatus(303)
+    expect(await tagNamesOf(await latestPostId())).toEqual(['a'.repeat(30)])
+  })
+
+  it('refuses invalid tags like an empty title, saving nothing', async () => {
+    const emptyTitle = await author.json().post('/posts', { ...payload('bun'), title: '' })
+    const status = emptyTitle.status
+
+    for (const tagField of ['a, b, c, d, e, f', 'a'.repeat(31)]) {
+      const response = await author.json().post('/posts', payload(tagField))
+      expect(response.status).toBe(status)
+      const body = (await response.json()) as { errors?: Record<string, unknown> }
+      expect(Object.keys(body.errors ?? {})).toContain('tags')
+    }
+
+    expect(await (await database()).select().from(posts)).toHaveLength(0)
+    expect(await (await database()).select().from(tags)).toHaveLength(0)
+    expect(await (await database()).select().from(postTags)).toHaveLength(0)
+  })
+})
