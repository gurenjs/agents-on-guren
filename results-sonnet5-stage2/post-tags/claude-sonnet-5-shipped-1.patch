diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..cd634c9
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,43 @@
+import { defineModel } from '@guren/core'
+import { postTags, tags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {}
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+/** Sorted tag names per post id; posts without tags map to `[]`. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>(postIds.map((id) => [id, []]))
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.whereIn('postId', postIds).get()
+  const tagRows = await Tag.whereIn('id', [...new Set(links.map((link) => link.tagId))]).get()
+  const nameById = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name !== undefined) names.get(link.postId)?.push(name)
+  }
+  for (const list of names.values()) list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  return names
+}
+
+/** Makes the post carry exactly `names`, creating unknown tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  await PostTag.delete({ postId })
+
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    await PostTag.create({ postId, tagId: tag.id })
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  await PostTag.delete({ postId })
+}
