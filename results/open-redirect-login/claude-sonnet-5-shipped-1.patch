+++ b/tests/LoginController.test.ts
@@ -0,0 +1,50 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// Guards against the open-redirect regression: the post-login `redirect`
+// value must only ever send the user to a same-app path, never to another
+// origin or a protocol-relative/backslash lookalike of one.
+describe('login.store', () => {
+  let http: TestApp
+  const email = 'login-redirect@example.com'
+  const password = 'correct-horse-battery-staple'
+
+  beforeAll(async () => {
+    await resetDatabase()
+    await User.create({ name: 'Login Redirect Test', email, password })
+    http = await TestApp.fromApp(app)
+  })
+
+  it('falls back to the default destination with no redirect value', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password }).assertRedirect('/dashboard')
+  })
+
+  it('honors an in-app path', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password, redirect: '/posts/3/edit' }).assertRedirect('/posts/3/edit')
+  })
+
+  it('rejects an absolute URL to another origin', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password, redirect: 'https://evil.example' }).assertRedirect('/dashboard')
+  })
+
+  it('rejects a protocol-relative URL', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password, redirect: '//evil.example' }).assertRedirect('/dashboard')
+  })
+
+  it('rejects a backslash variant of a protocol-relative URL', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password, redirect: '/\\evil.example' }).assertRedirect('/dashboard')
+  })
+
+  it('still fails a wrong password without creating a session', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', { email, password: 'wrong-password' }).assertUnprocessable()
+  })
+})
