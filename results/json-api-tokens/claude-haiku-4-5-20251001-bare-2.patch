@@ -0,0 +1,45 @@
+import { Controller } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CreateApiTokenSchema, ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+import { generateToken } from '../../Utilities/TokenGenerator.js'
+
+export default class ProfileTokensController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateApiTokenSchema)
+
+    const { token, tokenPublic, tokenHashSecret } = generateToken()
+
+    const apiToken = await ApiToken.forceCreate({
+      userId: user.id,
+      name,
+      tokenPublic,
+      tokenHashSecret,
+    })
+
+    if (!apiToken) {
+      throw new Error('Failed to create token')
+    }
+
+    return this.json({
+      id: apiToken.id,
+      name: apiToken.name,
+      token,
+    }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      return this.json({ message: 'Not found' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id })
+
+    return this.json(null, { status: 204 })
+  }
+}
