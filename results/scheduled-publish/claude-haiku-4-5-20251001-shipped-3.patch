diff --git a/tests/PostScheduling.test.ts b/tests/PostScheduling.test.ts
new file mode 100644
index 0000000..758ed7a
--- /dev/null
+++ b/tests/PostScheduling.test.ts
@@ -0,0 +1,156 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('Post Scheduling', () => {
+  let http: TestApp
+  let user: any
+  let otherUser: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const timestamp = Date.now()
+    user = await User.create({
+      name: 'Test User',
+      email: `sched-user-${timestamp}@example.com`,
+      password: 'password123',
+    })
+    otherUser = await User.create({
+      name: 'Other User',
+      email: `sched-other-${timestamp}@example.com`,
+      password: 'password123',
+    })
+  })
+
+  test('creates a post with no publish date', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.post('/posts', {
+      title: 'Public Post',
+      excerpt: 'This is public',
+      body: 'Content',
+    })
+    expect(res.status).toBe(303)
+  })
+
+  test('creates a post with a future publish date', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const futureDate = new Date(Date.now() + 86400000).toISOString()
+    const timestamp = Date.now()
+    const res = await csrf.post('/posts', {
+      title: `Scheduled Post ${timestamp}`,
+      excerpt: 'This is scheduled',
+      body: 'Content',
+      publishAt: futureDate,
+    })
+    expect(res.status).toBe(303)
+  })
+
+  test('scheduled post returns 403 for other users', async () => {
+    const timestamp = Date.now()
+    const posts = await Post.where('title', `Scheduled Post ${timestamp - 1000}`).orWhere('excerpt', 'This is scheduled').get()
+    if (posts.length > 0) {
+      const scheduledPost = posts[posts.length - 1]
+      const res = await http.actingAs(otherUser).get('/posts/' + scheduledPost.id)
+      expect(res.status).toBe(403)
+    }
+  })
+
+  test('scheduled post is accessible to author', async () => {
+    const futureDate = new Date(Date.now() + 86400000).toISOString()
+    const timestamp = Date.now()
+    const post = await Post.forceCreate({
+      title: `Scheduled Post Unique ${timestamp}`,
+      excerpt: 'This is scheduled',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: futureDate,
+    })
+    expect(post.publishedAt).toBeTruthy()
+    expect(post.authorId).toBe(user.id)
+    const res = await http.actingAs(user).get('/posts/' + post.id)
+    expect(res.status).toBe(200)
+  })
+
+  test('public post is accessible to everyone', async () => {
+    const posts = await Post.where('title', 'Public Post').get()
+    const publicPost = posts[0]
+    const res = await http.actingAs(otherUser).get('/posts/' + publicPost.id)
+    expect(res.status).toBe(200)
+  })
+
+  test('scheduled post is hidden from search for other users', async () => {
+    const res = await http.query('/posts/search', {
+      keywords: ['scheduled'],
+      limit: 50,
+    })
+    const posts = await res.json() as any
+    const scheduledPosts = posts.data.filter((p: any) => p.title.includes('Scheduled Post Unique'))
+    expect(scheduledPosts.length).toBe(0)
+  })
+
+  test('scheduled post is visible in search for author', async () => {
+    const res = await http.actingAs(user).query('/posts/search', {
+      keywords: ['scheduled'],
+      limit: 50,
+    })
+    const posts = await res.json() as any
+    const scheduledPosts = posts.data.filter((p: any) => p.title.includes('Scheduled Post Unique'))
+    expect(scheduledPosts.length).toBeGreaterThan(0)
+  })
+
+  test('post with past date is public', async () => {
+    const pastDate = new Date(Date.now() - 1000).toISOString()
+    const post = await Post.forceCreate({
+      title: 'Past Date Post',
+      excerpt: 'Now public',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: pastDate,
+    })
+    const res = await http.actingAs(otherUser).get('/posts/' + post.id)
+    expect(res.status).toBe(200)
+  })
+
+  test('author can update a scheduled post', async () => {
+    const futureDate = new Date(Date.now() + 86400000).toISOString()
+    const post = await Post.forceCreate({
+      title: 'Post to Update',
+      excerpt: 'Original',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: futureDate,
+    })
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.put('/posts/' + post.id, {
+      title: 'Updated Title',
+      excerpt: 'Updated',
+      body: 'New content',
+      publishAt: futureDate,
+    })
+    expect(res.status).toBe(303)
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.title).toBe('Updated Title')
+  })
+
+  test('author can clear publish date', async () => {
+    const futureDate = new Date(Date.now() + 86400000).toISOString()
+    const post = await Post.forceCreate({
+      title: 'Post to Publish',
+      excerpt: 'Scheduled',
+      body: 'Content',
+      authorId: user.id,
+      publishedAt: futureDate,
+    })
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.put('/posts/' + post.id, {
+      title: 'Post to Publish',
+      excerpt: 'Scheduled',
+      body: 'Content',
