+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { DatabaseCheck, HealthManager } from '@guren/core'
+import app from '../src/app.js'
+
+describe('GET /health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('reports healthy and includes a database check when the db is reachable', async () => {
+    const res = await http.get('/health')
+    res.assertOk()
+    const body = await res.json<{ status: string; checks: Record<string, { status: string }> }>()
+
+    expect(body.status).toBe('healthy')
+    expect(body.checks.database?.status).toBe('healthy')
+  })
+})
+
+// The route wires HealthManager + DatabaseCheck with `critical: true` so a
+// failing database query drains traffic instead of staying "ok" — this is
+// what shipped broken last time. Exercised directly against the same
+// primitives the route uses, since forcing the real SQLite connection to
+// fail without leaving it broken for later tests is impractical.
+describe('health check wiring (critical database check)', () => {
+  it('maps a failing database query to an unhealthy report', async () => {
+    const manager = new HealthManager().register(
+      new DatabaseCheck({
+        async query() {
+          throw new Error('connection refused')
+        },
+      }),
+      { critical: true },
+    )
+
+    const report = await manager.check()
+
+    expect(report.status).toBe('unhealthy')
+    expect(report.checks).toHaveLength(1)
+    expect(report.checks[0]).toMatchObject({ name: 'database', status: 'unhealthy' })
+  })
+
+  it('would drive a 503 from the route, matching its status-code mapping', async () => {
+    const manager = new HealthManager().register(
+      new DatabaseCheck({
+        async query() {
+          throw new Error('timeout')
+        },
+      }),
+      { critical: true },
+    )
+
+    const report = await manager.check()
+    const statusCode = report.status === 'unhealthy' ? 503 : 200
+
+    expect(statusCode).toBe(503)
+  })
+
+  it('stays healthy (200) when the database query succeeds', async () => {
+    const manager = new HealthManager().register(
+      new DatabaseCheck({
+        async query() {
+          return { ok: true }
+        },
+      }),
+      { critical: true },
+    )
+
+    const report = await manager.check()
+    const statusCode = report.status === 'unhealthy' ? 503 : 200
+
+    expect(report.status).toBe('healthy')
+    expect(statusCode).toBe(200)
+  })
+})
