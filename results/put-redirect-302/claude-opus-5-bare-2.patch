+++ b/tests/PostUpdate.test.ts
@@ -0,0 +1,57 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+// posts.update answers a PUT. A 302 there tells the browser to replay the PUT
+// against /posts/:id — which is posts.update again — until the client aborts
+// with ERR_TOO_MANY_REDIRECTS, even though the row was already written. The
+// See Other status is what turns the follow-up into a plain GET of the post.
+describe('posts.update', () => {
+  let http: TestApp
+  let author: UserRecord
+  let postId: number
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = (await User.create({
+      name: 'Redirect Author',
+      email: `redirect-${Date.now()}@example.com`,
+      password: 'password',
+    })) as UserRecord
+
+    const post = await Post.forceCreate({
+      title: 'Before',
+      excerpt: 'Before excerpt',
+      body: 'Before body',
+      authorId: author.id,
+    })
+    postId = Number(post?.id)
+  })
+
+  it('sends the browser on to the post page with a 303', async () => {
+    const acting = await (await TestApp.fromApp(app)).actingAs(author).withCsrf(`/posts/${postId}/edit`)
+
+    await acting
+      .put(`/posts/${postId}`, {
+        title: 'After',
+        excerpt: 'After excerpt',
+        body: 'After body',
+      })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${postId}`)
+  })
+
+  it('keeps returning validation errors for an invalid payload', async () => {
+    const acting = await (await TestApp.fromApp(app)).actingAs(author).withCsrf(`/posts/${postId}/edit`)
+
+    await acting
+      .put(`/posts/${postId}`, { title: '', excerpt: '', body: '' })
+      .assertStatus(422)
+  })
+})
