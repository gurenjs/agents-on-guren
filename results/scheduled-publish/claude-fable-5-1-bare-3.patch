@@ -0,0 +1,19 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List the posts scheduled to publish later, soonest first'
+
+  // Output is meant for pipes: one `<id>\t<title>\t<published_at>` line per
+  // post and nothing else on stdout, so no header and no "nothing scheduled".
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled().get()
+
+    for (const post of posts) {
+      // A tab or line break inside a title would split the row in two.
+      const title = post.title.replace(/[\t\r\n]+/g, ' ')
+      this.line(`${post.id}\t${title}\t${post.publishedAt}`)
+    }
+  }
+}
