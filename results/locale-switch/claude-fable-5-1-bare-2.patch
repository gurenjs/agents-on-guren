diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..8e38852
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,125 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readdir } from 'node:fs/promises'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+interface I18nProps {
+  locale: string
+  messages: Record<string, Record<string, Record<string, unknown>>>
+}
+
+// The login page is the page under test throughout: it renders for a guest
+// without reading the database, so these tests need no migrations or fixtures.
+const PAGE = '/login'
+
+async function i18nOf(http: TestApp, path = PAGE): Promise<I18nProps> {
+  const response = await http.get(path).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props._i18n as I18nProps
+}
+
+function cookieHeader(setCookies: string[]): string {
+  return setCookies.map((cookie) => cookie.split(';')[0]).join('; ')
+}
+
+describe('locale', () => {
+  let http: TestApp
+  // A browser that already holds a session: it passes CSRF on POST /locale.
+  let browser: TestApp
+  let sessionCookies: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const first = await http.get(PAGE).assertOk()
+    sessionCookies = cookieHeader(first.headers.getSetCookie())
+    browser = await http.withCsrf(PAGE)
+  })
+
+  // What the browser sends once it has stored the cookies of `response`.
+  function returning(setCookies: string[]): TestApp {
+    return http.withHeader('Cookie', [sessionCookies, cookieHeader(setCookies)].filter(Boolean).join('; '))
+  }
+
+  describe('detection', () => {
+    it('defaults to English', async () => {
+      const i18n = await i18nOf(http)
+
+      expect(i18n.locale).toBe('en')
+      expect(i18n.messages.en?.nav?.posts).toBe('Posts')
+    })
+
+    it('follows a Japanese browser on a first visit', async () => {
+      for (const header of ['ja', 'ja-JP,ja;q=0.9,en;q=0.8']) {
+        const i18n = await i18nOf(http.withHeader('Accept-Language', header))
+
+        expect(i18n.locale).toBe('ja')
+        expect(i18n.messages.ja?.nav?.posts).toBe('記事')
+      }
+    })
+
+    it('stays English for a browser that asks for an unsupported language', async () => {
+      const i18n = await i18nOf(http.withHeader('Accept-Language', 'fr-FR,fr;q=0.9'))
+
+      expect(i18n.locale).toBe('en')
+    })
+  })
+
+  describe('POST /locale', () => {
+    it('remembers the pick and redirects back to the referring page', async () => {
+      const response = await browser
+        .withHeader('Referer', 'http://localhost/posts?page=2')
+        .post('/locale', { locale: 'ja' })
+        .assertRedirect('http://localhost/posts?page=2')
+        .assertCookie('locale', 'ja')
+
+      const i18n = await i18nOf(returning(response.headers.getSetCookie()))
+      expect(i18n.locale).toBe('ja')
+    })
+
+    it('lets the pick win over the browser language', async () => {
+      const response = await browser.post('/locale', { locale: 'en' }).assertCookie('locale', 'en')
+
+      const i18n = await i18nOf(
+        returning(response.headers.getSetCookie()).withHeader('Accept-Language', 'ja'),
+      )
+      expect(i18n.locale).toBe('en')
+    })
+
+    it('redirects home without a referer', async () => {
+      await browser.post('/locale', { locale: 'ja' }).assertRedirect('/')
+    })
+
+    it('does not redirect to another site', async () => {
+      await browser
+        .withHeader('Referer', 'https://evil.example/posts')
+        .post('/locale', { locale: 'ja' })
+        .assertRedirect('/')
+    })
+
+    it('rejects an unsupported or missing locale and keeps the current pick', async () => {
+      for (const body of [{ locale: 'fr' }, {}]) {
+        await browser.post('/locale', body).assertStatus(422).assertCookieMissing('locale')
+      }
+    })
+  })
+})
+
+describe('translation catalogs', () => {
+  async function keysOf(locale: string): Promise<string[]> {
+    const keys: string[] = []
+    const collect = (value: unknown, prefix: string) => {
+      if (typeof value === 'string') keys.push(prefix)
+      else for (const [key, child] of Object.entries(value as object)) collect(child, `${prefix}.${key}`)
+    }
+
+    const dir = new URL(`../lang/${locale}/`, import.meta.url)
+    for (const file of (await readdir(dir)).filter((name) => name.endsWith('.json'))) {
+      collect(await Bun.file(new URL(file, dir)).json(), file.slice(0, -'.json'.length))
+    }
+    return keys.sort()
+  }
+
+  it('hold the same keys in English and Japanese', async () => {
+    expect(await keysOf('ja')).toEqual(await keysOf('en'))
+  })
+})
