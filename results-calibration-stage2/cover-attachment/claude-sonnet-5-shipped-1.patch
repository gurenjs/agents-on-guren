diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..38f4be6
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,97 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { coverPath } from '../app/Support/CoverStorage.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 4, 5, 6])
+const GIF = new TextEncoder().encode('GIF89a-not-allowed')
+
+function form(cover?: Uint8Array, type = 'image/png', extra: Record<string, string> = {}): FormData {
+  const data = new FormData()
+  data.set('title', 'Hello')
+  data.set('excerpt', 'Short')
+  data.set('body', 'Body')
+  for (const [key, value] of Object.entries(extra)) data.set(key, value)
+  if (cover) data.set('cover', new File([cover as BlobPart], 'cover', { type }))
+  return data
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret' })
+  })
+
+  async function authed() {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function coverUrlOf(id: number): Promise<string | null> {
+    const res = await (await authed()).withHeader('X-Inertia', 'true').get(`/posts/${id}`)
+    const body = await res.json<{ props: { post: { coverUrl: string | null } } }>()
+    return body.props.post.coverUrl
+  }
+
+  it('stores, serves, replaces and removes a cover', async () => {
+    const client = await authed()
+    await client.post('/posts', form(PNG)).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+    const first = await coverUrlOf(post.id)
+    expect(first).toStartWith('/attachments/')
+
+    const served = await client.get(first!)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    const oldRow = (await Attachment.first({ postId: post.id }))!
+    await client.put(`/posts/${post.id}`, form(JPEG, 'image/jpeg')).assertRedirect()
+    expect(existsSync(coverPath(oldRow))).toBe(false)
+    expect((await client.get(first!)).status).toBe(404)
+    expect(await Attachment.where({ postId: post.id }).count()).toBe(1)
+
+    await client.put(`/posts/${post.id}`, form()).assertRedirect()
+    expect(await coverUrlOf(post.id)).not.toBeNull()
+
+    await client.put(`/posts/${post.id}`, form(undefined, 'image/png', { removeCover: '1' })).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBeNull()
+    expect(await Attachment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('refuses a GIF and an oversized PNG without saving anything', async () => {
+    const client = await authed()
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    for (const [bytes, type] of [[GIF, 'image/gif'], [big, 'image/png']] as const) {
+      await client.json().post('/posts', form(bytes, type)).assertUnprocessable()
+    }
+    expect(await Post.where({}).count()).toBe(0)
+  })
+
+  it('keeps the old cover when an edit is refused, and deletes it with the post', async () => {
+    const client = await authed()
+    await client.post('/posts', form(PNG)).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+    const row = (await Attachment.first({ postId: post.id }))!
+
+    await client.json().put(`/posts/${post.id}`, form(GIF, 'image/gif')).assertUnprocessable()
+    expect((await Attachment.first({ postId: post.id }))?.id).toBe(row.id)
+
+    await client.delete(`/posts/${post.id}`).assertRedirect()
+    expect(await Attachment.where({}).count()).toBe(0)
+    expect(existsSync(coverPath(row))).toBe(false)
+  })
+})
