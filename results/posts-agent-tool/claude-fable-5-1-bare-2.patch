@@ -0,0 +1,215 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+// The two agent tools derived from posts.search and posts.store, reached two
+// ways: through the TestApp agent bridge (same dispatch the MCP endpoint uses,
+// authenticated through the session) and over the real `/mcp` endpoint with a
+// bearer token issued by the framework's API-token support.
+
+interface RpcResponse {
+  result?: Record<string, unknown>
+  error?: { code: number; message: string }
+}
+
+interface ToolListing {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolCallResult {
+  content: Array<{ type: string; text?: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+// Streamable HTTP may answer JSON-RPC as an SSE stream; the payload is the
+// last `data:` line either way.
+async function readRpc(raw: Response): Promise<RpcResponse> {
+  const text = await raw.text()
+  const dataLines = text.split('\n').filter((line) => line.startsWith('data:'))
+  const payload = dataLines.length > 0 ? dataLines[dataLines.length - 1]!.slice('data:'.length) : text
+  return JSON.parse(payload.trim()) as RpcResponse
+}
+
+function toolResult(response: RpcResponse): ToolCallResult {
+  expect(response.error).toBeUndefined()
+  return response.result as unknown as ToolCallResult
+}
+
+function resultJson<T = Record<string, unknown>>(result: ToolCallResult): T {
+  if (result.structuredContent) return result.structuredContent as T
+  const text = result.content.find((part) => part.type === 'text')?.text ?? ''
+  return JSON.parse(text) as T
+}
+
+let sequence = 0
+async function createUser(): Promise<UserRecord> {
+  sequence += 1
+  const user = await User.create({
+    name: `Agent Author ${sequence}`,
+    email: `agent-author-${Date.now()}-${sequence}@example.com`,
+    password: 'secret',
+  })
+  return user as unknown as UserRecord
+}
+
+describe('agent tools', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('exposes exactly posts_search (read-only) and posts_store', async () => {
+    const tools = await http.agent().tools()
+    const byName = new Map(tools.map((tool) => [tool.toolName, tool]))
+
+    expect([...byName.keys()].sort()).toEqual(['posts_search', 'posts_store'])
+    expect(byName.get('posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(byName.get('posts_store')?.annotations?.readOnlyHint).toBe(false)
+  })
+
+  it('posts_search answers the search JSON for a guest', async () => {
+    const author = await createUser()
+    const marker = `bridge-${Date.now()}`
+    await Post.forceCreate({ title: `About ${marker}`, excerpt: 'x', body: 'y', authorId: author.id })
+
+    const result = await http.agent().call('posts_search', { keywords: [marker], limit: 5 }).assertOk()
+    const { data } = result.json<{ data: Array<{ title: string; authorId: number }> }>()
+
+    expect(data).toHaveLength(1)
+    expect(data[0]!.title).toBe(`About ${marker}`)
+    expect(data[0]!.authorId).toBe(author.id)
+  })
+
+  it('posts_store creates the post for the acting user', async () => {
+    const author = await createUser()
+    const other = await createUser()
+    const title = `Bridge post ${Date.now()}`
+
+    const result = await (await http.withCsrf('/posts'))
+      .agent()
+      .call('posts_store', { title, excerpt: 'From the bridge', body: 'Body', authorId: other.id }, { as: author })
+      .assertOk()
+
+    expect(result.status).toBe(201)
+    const post = await Post.newQuery().where('title', title).first()
+    expect(post?.authorId).toBe(author.id)
+  })
+
+  it('posts_store rejects invalid input with 422 and creates nothing', async () => {
+    const author = await createUser()
+    const before = await Post.newQuery().count()
+
+    const result = await (await http.withCsrf('/posts'))
+      .agent()
+      .call('posts_store', { title: '', excerpt: 'x', body: 'y' }, { as: author })
+
+    expect(result.isError).toBe(true)
+    expect(result.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('posts_store refuses a guest', async () => {
+    const before = await Post.newQuery().count()
+    const result = await http.agent().call('posts_store', { title: 'Guest', excerpt: 'x', body: 'y' })
+
+    expect([302, 303, 401, 403]).toContain(result.status)
+    if (result.status === 302 || result.status === 303) {
+      expect(result.response.headers.get('location')).toContain('/login')
+    }
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
+
+describe('POST /mcp', () => {
+  let http: TestApp
+  let user: UserRecord
+  let bearer: string
+  let requestId = 0
+
+  const rpc = (method: string, params: Record<string, unknown> = {}, token: string | null = bearer) => {
+    let client = http.json().withHeader('Accept', 'application/json, text/event-stream')
+    if (token) client = client.withHeader('Authorization', `Bearer ${token}`)
+    requestId += 1
+    return client.post('/mcp', { jsonrpc: '2.0', id: requestId, method, params })
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await createUser()
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('No API token store configured')
+    const issued = await createApiToken(store, { name: 'test', userId: user.id, abilities: ['tools:*'] })
+    bearer = issued.plainTextToken
+  })
+
+  it('refuses a call without a credential', async () => {
+    await rpc('tools/list', {}, null).assertStatus(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
+    const response = await rpc('tools/list')
+    expect(response.status).toBe(200)
+    const { tools } = toolResult(await readRpc(response.raw)) as unknown as { tools: ToolListing[] }
+    const app = tools.filter((tool) => !tool.name.startsWith('guren_'))
+    const byName = new Map(app.map((tool) => [tool.name, tool]))
+
+    expect([...byName.keys()].sort()).toEqual(['posts_search', 'posts_store'])
+    expect(byName.get('posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(byName.get('posts_store')?.annotations?.readOnlyHint).toBe(false)
+  })
+
+  it('posts_search returns the same JSON as QUERY /posts/search', async () => {
+    const marker = `mcp-${Date.now()}`
+    await Post.forceCreate({ title: `Note on ${marker}`, excerpt: 'x', body: 'y', authorId: user.id })
+    const input = { keywords: [marker], limit: 3 }
+
+    const direct = await http.query('/posts/search', input).assertOk()
+    const result = toolResult(await readRpc((await rpc('tools/call', { name: 'posts_search', arguments: input })).raw))
+
+    expect(result.isError ?? false).toBe(false)
+    expect(resultJson(result)).toEqual(await direct.json())
+  })
+
+  it('posts_store creates the post as the token user, ignoring authorId', async () => {
+    const other = await createUser()
+    const title = `MCP post ${Date.now()}`
+    const result = toolResult(await readRpc((await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title, excerpt: 'Drafted by an assistant', body: 'Body', authorId: other.id },
+    })).raw))
+
+    expect(result.isError ?? false).toBe(false)
+    const post = await Post.newQuery().where('title', title).first()
+    expect(post?.authorId).toBe(user.id)
+  })
+
+  it('posts_store answers a validation error without creating anything', async () => {
+    const before = await Post.newQuery().count()
+    const result = toolResult(await readRpc((await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'x', body: 'y' },
+    })).raw))
+
+    expect(result.isError).toBe(true)
+    const body = resultJson<{ errors: Record<string, string[]> }>(result)
+    expect(body.errors.title).toBeDefined()
+    expect(await Post.newQuery().count()).toBe(before)
+
+    // A plain tools/call result carries no HTTP status; the guren_preflight
+    // companion rehearses the same call and reports the 422 it resolved to.
+    const preflight = toolResult(await readRpc((await rpc('tools/call', {
+      name: 'guren_preflight',
+      arguments: { tool: 'posts_store', input: { title: '', excerpt: 'x', body: 'y' } },
+    })).raw))
+    const verdict = preflight.structuredContent as { allowed: boolean; status: number }
+    expect(verdict.allowed).toBe(false)
+    expect(verdict.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
