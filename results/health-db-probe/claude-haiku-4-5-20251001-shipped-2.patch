new file mode 100644
index 0000000..dddf25c
--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,29 @@
+import { Controller } from '@guren/core'
+import { User } from '../../Models/User.js'
+
+export default class HealthController extends Controller {
+  async check(): Promise<Response> {
+    try {
+      // Test database connection with a simple query
+      await User.first()
+
+      return this.json({
+        status: 'ok',
+        checks: {
+          db: { status: 'ok' },
+        },
+      })
+    } catch (error) {
+      // Database check failed
+      return this.json(
+        {
+          status: 'error',
+          checks: {
+            db: { status: 'error', message: 'Database connection failed' },
+          },
+        },
+        { status: 503 },
+      )
+    }
+  }
+}
