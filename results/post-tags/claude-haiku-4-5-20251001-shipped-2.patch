+export const parseAndValidateTags = (input: string): string[] => {
+  if (!input || typeof input !== 'string') return []
+  const tags = input
+    .split(',')
+    .map((tag) => tag.trim())
+    .filter((tag) => tag.length > 0)
+    // Deduplicate case-sensitively
+    .filter((tag, index, self) => self.indexOf(tag) === index)
+
+  if (tags.length > 5) throw new Error('You can have at most 5 tags.')
+  if (!tags.every((tag) => tag.length >= 1 && tag.length <= 30)) {
+    throw new Error('Each tag must be 1–30 characters.')
+  }
+  return tags
+}
+
 export type PostPayload = z.infer<typeof PostPayloadSchema>
