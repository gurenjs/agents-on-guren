diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..d98d8da
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,29 @@
+import { defineModel, type TransactionHandle } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import { Post, type PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+/** The part of a post a revision keeps, and a restore puts back. */
+export type PostContent = Pick<PostRecord, 'title' | 'excerpt' | 'body'>
+
+export class PostRevision extends defineModel(postRevisions, {
+  // `postId` comes from the post being edited, never from request input.
+  fillable: ['title', 'excerpt', 'body'],
+}) {
+  /**
+   * Replaces a post's content and keeps what it replaces as a revision. Takes
+   * the caller's transaction so the revision and the edit land together or not
+   * at all, and reads the post inside it: the version kept is the one this
+   * write overwrites, not the one the request loaded earlier.
+   */
+  static async replaceContent(postId: number, content: PostContent, trx: TransactionHandle): Promise<void> {
+    const current = await Post.findOrFail(postId, 'id', { trx })
+
+    await PostRevision.forceCreate(
+      { postId: current.id, title: current.title, excerpt: current.excerpt, body: current.body },
+      { trx },
+    )
+    await Post.update({ id: current.id }, content, { trx })
+  }
+}
