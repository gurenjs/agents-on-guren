@@ -0,0 +1,18 @@
+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { ApiPostsIndexQuerySchema, ApiPostsIndexOutputSchema } from '../app/Http/Validators/PostValidator.js'
+
+// Public JSON API for external consumers — no auth, no CSRF, no Inertia.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    api.get(
+      '/posts',
+      {
+        name: 'api.posts.index',
+        query: ApiPostsIndexQuerySchema,
+        output: ApiPostsIndexOutputSchema,
+      },
+      [ApiPostController, 'index'],
+    )
+  })
+}
