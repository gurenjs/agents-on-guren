--- /dev/null
+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+/** The JSON posts API, authenticated by a personal API token (routes/api.ts). */
+export default class PostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    // The token guard resolves auth.user() to the token's owner.
+    const author = await this.auth.userOrFail<UserRecord>()
+    // Validated here, after requireApiToken, so a request without a valid
+    // token answers 401 whatever its body holds.
+    const data = await this.validateBody(PostPayloadSchema)
+    // forceCreate, because `authorId` is deliberately absent from Post.fillable:
+    // it comes from the token, and a request body must never be able to set it.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..9790418
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,50 @@
+import { Controller, abort, createApiToken, readBearerToken, revokeApiToken } from '@guren/core'
+import { DatabaseApiTokenStore } from '../../Auth/DatabaseApiTokenStore.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+const store = new DatabaseApiTokenStore()
+
+/** Personal API tokens, managed by their owner from the profile page. */
+export default class ApiTokenController extends Controller {
+  // Only a signed-in session manages tokens: a bearer token must not be able
+  // to mint further tokens or revoke its siblings.
+  // A bearer header selects the token guard, so such a request is refused
+  // outright instead of being resolved to the token's owner.
+  private async sessionUser(): Promise<UserRecord> {
+    const user = readBearerToken(this.request.header('Authorization'))
+      ? null
+      : await this.auth.user<UserRecord>()
+    if (!user) {
+      abort(401, 'Unauthenticated.')
+    }
+    return user
+  }
+
+  async store(): Promise<Response> {
+    const user = await this.sessionUser()
+    const { name } = this.validated('profile.tokens.store').body
+
+    // The plain token leaves the server only in this response; the store
+    // keeps nothing but the SHA-256 of its secret half.
+    const { plainTextToken, token } = await createApiToken(store, { name, userId: user.id })
+
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.sessionUser()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Another user's token id answers exactly like one that does not exist.
+    const token = await ApiToken.first({ id, userId: user.id })
+    if (!token) {
+      abort(404, 'Token not found.')
+    }
+
+    await revokeApiToken(token.id, store)
+
+    return this.noContent()
+  }
+}
