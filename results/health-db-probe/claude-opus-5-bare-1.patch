@@ -11,7 +11,17 @@ export default class DatabaseProvider extends ServiceProvider {
       return
     }
 
-    await bootModels()
-    this.initialized = true
+    // A database that is unreachable at boot must not stop the app from
+    // serving: the deployment platform probes GET /health, and a process that
+    // never starts cannot report 503 and get itself drained from the pool.
+    // Requests that need the database still fail — `bootModels()` is not
+    // marked done, so the next boot (and every getDatabase() call, which
+    // reconnects on its own) retries the connection.
+    try {
+      await bootModels()
+      this.initialized = true
+    } catch (error) {
+      console.error('[app] Database bootstrap failed — the app is serving without a database.', error)
+    }
   }
 }
