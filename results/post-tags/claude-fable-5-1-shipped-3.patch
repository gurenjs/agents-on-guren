+++ b/db/seeders/003_tags.ts
@@ -0,0 +1,24 @@
+import { defineSeeder } from '@guren/core'
+import { eq, inArray } from 'drizzle-orm'
+import type { AppSeederContext } from '../../config/database.js'
+import { posts, postTags, tags } from '../schema.js'
+
+const SAMPLE_TAGS = ['guren', 'bun']
+
+export default defineSeeder(async ({ db }: AppSeederContext) => {
+  const existing = await db.select().from(tags).where(inArray(tags.name, SAMPLE_TAGS)).limit(1)
+  if (existing.length > 0) {
+    return
+  }
+
+  const [post] = await db.select().from(posts).where(eq(posts.title, 'Hello from Guren')).limit(1)
+  if (!post) {
+    return
+  }
+
+  const created = await db
+    .insert(tags)
+    .values(SAMPLE_TAGS.map((name) => ({ name })))
+    .returning()
+  await db.insert(postTags).values(created.map((tag) => ({ postId: post.id, tagId: tag.id })))
+})
