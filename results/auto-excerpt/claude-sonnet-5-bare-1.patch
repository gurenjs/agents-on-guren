diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..f129088
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,31 @@
+const EXCERPT_LENGTH = 140
+
+// Derives a teaser from a post body when the author leaves the excerpt
+// field blank: keep the opening up to 140 characters without splitting a
+// word, then mark the cut with a single ellipsis character.
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) {
+    return trimmed
+  }
+
+  let kept = trimmed.slice(0, EXCERPT_LENGTH)
+  const boundaryChar = trimmed[EXCERPT_LENGTH]
+  const lastKeptChar = kept[kept.length - 1]
+
+  if (!/\s/.test(boundaryChar) && !/\s/.test(lastKeptChar)) {
+    const cutIndex = lastWhitespaceIndex(kept)
+    if (cutIndex !== -1) {
+      kept = kept.slice(0, cutIndex)
+    }
+  }
+
+  return `${kept.trimEnd()}…`
+}
+
+function lastWhitespaceIndex(text: string): number {
+  for (let i = text.length - 1; i >= 0; i--) {
+    if (/\s/.test(text[i])) return i
+  }
+  return -1
+}
