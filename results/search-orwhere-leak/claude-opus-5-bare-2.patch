@@ -0,0 +1,73 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// Feature tests for posts.search against the test database (./data/guren.test.db,
+// which `bun test` selects for us). Unpublished posts exist only in the database —
+// there is no UI for them — so the fixtures are created with forceCreate, `published`
+// being outside Post.fillable.
+describe('posts.search', () => {
+  let http: TestApp
+  const createdIds: number[] = []
+
+  async function makePost(attributes: { title: string; excerpt: string; published: boolean }): Promise<void> {
+    const author = await User.newQuery().orderBy('id', 'asc').firstOrFail()
+    const post = (await Post.forceCreate({
+      ...attributes,
+      body: 'Fixture body.',
+      authorId: author.id,
+    })) as PostRecord | null
+    if (post?.id) {
+      createdIds.push(post.id)
+    }
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    await makePost({
+      title: 'A zephyrquill primer',
+      excerpt: 'Published, and about zephyrquill.',
+      published: true,
+    })
+    await makePost({
+      title: 'The zephyrquill draft',
+      excerpt: 'Unpublished, and about zephyrquill.',
+      published: false,
+    })
+    await makePost({
+      title: 'Marmalade notes',
+      excerpt: 'Unpublished, and about marmalade.',
+      published: false,
+    })
+  })
+
+  afterAll(async () => {
+    for (const id of createdIds) {
+      await Post.delete({ id })
+    }
+  })
+
+  it('returns only published posts matching the keyword', async () => {
+    const response = await http.query('/posts/search', { keywords: ['zephyrquill'] }).assertOk()
+    const { data } = (await response.json()) as { data: Array<{ title: string }> }
+
+    expect(data.map((post) => post.title)).toEqual(['A zephyrquill primer'])
+  })
+
+  it('never pads the results with posts that match no keyword', async () => {
+    const response = await http.query('/posts/search', { keywords: ['zephyrquill', 'marmalade'] }).assertOk()
+    const { data } = (await response.json()) as { data: Array<{ title: string }> }
+
+    expect(data.map((post) => post.title)).toEqual(['A zephyrquill primer'])
+  })
+
+  it('returns nothing for a word that only appears in unpublished posts', async () => {
+    const response = await http.query('/posts/search', { keywords: ['marmalade'] }).assertOk()
+    const { data } = (await response.json()) as { data: unknown[] }
+
+    expect(data).toEqual([])
+  })
+})
