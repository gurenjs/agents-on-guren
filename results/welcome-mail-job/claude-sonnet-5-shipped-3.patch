+import { ServiceProvider, registerJob, setQueueDriver } from '@guren/core'
+import { queueManager } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueServiceProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => queueManager)
+  }
+
+  boot(): void {
+    setQueueDriver(queueManager.driver())
+    registerJob(SendWelcomeEmailJob)
+  }
+}
