+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { Subscription } from '../app/Models/Subscription.js'
+
+// Booting the app migrates data/guren.test.db, which persists between runs,
+// so every address here is unique to this run.
+const run = Date.now().toString(36)
+const address = (label: string) => `${label}-${run}@example.com`
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Mutating routes need CSRF primed the way a browser would, and every
+    // request arrives from a page of this site.
+    const booted = await TestApp.fromApp(app)
+    http = (await booted.withCsrf('/')).withHeader('Referer', '/posts')
+  })
+
+  describe('subscribe', () => {
+    it('stores a pending subscription with a token and returns to the referring page', async () => {
+      const email = address('subscribe')
+      const response = await http.post('/newsletter/subscribe', { email })
+      expect([302, 303]).toContain(response.status)
+      response.assertRedirect('/posts')
+
+      const subscription = await Subscription.first({ email })
+      expect(subscription).not.toBeNull()
+      expect(subscription?.confirmedAt).toBeNull()
+      expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to the home page without a referer', async () => {
+      const bare = await (await TestApp.fromApp(app)).withCsrf('/')
+      await bare.post('/newsletter/subscribe', { email: address('no-referer') }).assertRedirect('/')
+    })
+
+    it('rejects an invalid address and stores nothing', async () => {
+      for (const email of ['', 'not-an-email']) {
+        const response = await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+        const body = (await response.json()) as { errors: Record<string, string[]> }
+        expect(body.errors.email?.length).toBeGreaterThan(0)
+      }
+      expect(await Subscription.first({ email: 'not-an-email' })).toBeNull()
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const email = address('duplicate')
+      await http.post('/newsletter/subscribe', { email }).assertRedirect()
+
+      const response = await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+      const body = (await response.json()) as { errors: Record<string, string[]> }
+      expect(body.errors.email?.length).toBeGreaterThan(0)
+      expect(await Subscription.where({ email }).count()).toBe(1)
+    })
+  })
+
+  describe('confirm', () => {
+    it('marks the subscription confirmed and redirects home', async () => {
+      const email = address('confirm')
+      await http.post('/newsletter/subscribe', { email })
+      const pending = await Subscription.first({ email })
+
+      const response = await http.get(`/newsletter/confirm/${pending?.token}`)
+      expect([302, 303]).toContain(response.status)
+      response.assertRedirect('/')
+
+      const confirmed = await Subscription.first({ email })
+      expect(confirmed?.confirmedAt).toEqual(expect.any(String))
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      await http.get('/newsletter/confirm/never-issued-token').assertStatus(404)
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes only that subscription and returns to the referring page', async () => {
+      const gone = address('unsubscribe')
+      const stays = address('stays')
+      await http.post('/newsletter/subscribe', { email: gone })
+      await http.post('/newsletter/subscribe', { email: stays })
+
+      await http.post('/newsletter/unsubscribe', { email: gone }).assertRedirect('/posts')
+
+      expect(await Subscription.first({ email: gone })).toBeNull()
+      expect(await Subscription.first({ email: stays })).not.toBeNull()
+    })
+  })
+})
