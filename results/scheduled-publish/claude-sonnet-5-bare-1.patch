+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,20 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/** Prints one tab-separated line per scheduled post, soonest first, and nothing else. */
+export default class ScheduledPostsCommand extends Command {
+  static override signature = 'posts:scheduled'
+  static override description = 'List posts scheduled to publish in the future'
+
+  async handle(): Promise<number> {
+    const now = Date.now()
+    const posts = (await Post.newQuery().whereNotNull('publishedAt').get())
+      .filter((post) => post.publishedAt && new Date(post.publishedAt).getTime() > now)
+      .sort((a, b) => new Date(a.publishedAt!).getTime() - new Date(b.publishedAt!).getTime() || a.id - b.id)
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+    return 0
+  }
+}
