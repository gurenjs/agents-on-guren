+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${id}`, { title: 'Renamed', excerpt: 'Excerpt', body: 'Body', tags: 'a, b, c, d, e, f' })
+        .assertUnprocessable()
+
+      expect(await attachedTo(id)).toEqual(['bun'])
+      expect((await Post.findOrFail(id)).title).toBe('Tagged')
