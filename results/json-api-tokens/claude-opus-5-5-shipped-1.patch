diff --git a/tests/controllers/ApiTokenController.test.ts b/tests/controllers/ApiTokenController.test.ts
new file mode 100644
index 0000000..1af6fdf
--- /dev/null
+++ b/tests/controllers/ApiTokenController.test.ts
@@ -0,0 +1,118 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { resetDatabase } from '../../config/database.js'
+import { apiRateLimitStore } from '../../app/Http/Middleware/ApiTokenMiddleware.js'
+import { ApiToken } from '../../app/Models/ApiToken.js'
+import { Post } from '../../app/Models/Post.js'
+import { User, type UserRecord } from '../../app/Models/User.js'
+
+let http: TestApp
+let alice: UserRecord
+let bob: UserRecord
+
+async function makeUser(name: string): Promise<UserRecord> {
+  const user = await User.create({ name, email: `${name}@example.com`, password: 'password123' })
+  return (await User.findOrFail(user.id)) as UserRecord
+}
+
+async function createToken(user: UserRecord, name = 'CI'): Promise<{ id: string; name: string; token: string }> {
+  const session = await http.actingAs(user).withCsrf()
+  const res = await session.json().post('/profile/tokens', { name })
+  res.assertCreated()
+  return res.json()
+}
+
+function bearer(token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
+
+describe('personal API tokens', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    apiRateLimitStore.clear()
+    alice = await makeUser('alice')
+    bob = await makeUser('bob')
+  })
+
+  it('creates a token and stores only a hash of it', async () => {
+    const created = await createToken(alice, 'old laptop')
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.all()
+    expect(rows).toHaveLength(1)
+    const stored = JSON.stringify(Object.values(rows[0] ?? {}))
+    expect(stored).not.toContain(secret)
+  })
+
+  it('rejects invalid names', async () => {
+    const session = await http.actingAs(alice).withCsrf()
+    await session.json().post('/profile/tokens', {}).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await createToken(alice)
+
+    const created = await bearer(token)
+      .post('/api/posts', { title: 'Release notes', excerpt: 'v1', body: 'Shipped.', authorId: bob.id })
+      .assertCreated()
+      .assertJsonPath('data.authorId', alice.id)
+    const { data } = await created.json<{ data: { id: number; createdAt: string } }>()
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    await bearer(token).get('/api/posts').assertOk().assertJsonPath('data.0.id', data.id)
+  })
+
+  it('rejects invalid post input with 422', async () => {
+    const { token } = await createToken(alice)
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('rejects missing, unknown and tampered tokens', async () => {
+    const { token } = await createToken(alice)
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('nonsense').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertUnauthorized()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('revokes only the owner’s token', async () => {
+    const first = await createToken(alice, 'one')
+    const second = await createToken(alice, 'two')
+    const bobs = await createToken(bob)
+
+    const session = await http.actingAs(alice).withCsrf()
+    await session.json().delete(`/profile/tokens/${bobs.id}`).assertNotFound()
+    await bearer(bobs.token).get('/api/posts').assertOk()
+
+    await session.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const first = await createToken(alice, 'one')
+    const second = await createToken(alice, 'two')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts').assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
