@@ -0,0 +1,50 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class NewsletterSubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.subscribe')
+
+    if (await NewsletterSubscription.first({ email: body.email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // 32 random bytes → 64 hex characters: unguessable and URL-safe.
+    await NewsletterSubscription.create({ email: body.email, token: randomBytes(32).toString('hex') })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.unsubscribe')
+
+    await NewsletterSubscription.delete({ email: body.email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  // A cross-origin Referer is reduced to its path, so the redirect never leaves this site.
+  private previousUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    if (isSafeRedirectUrl(referer, this.request.url)) return referer
+
+    try {
+      const url = new URL(referer)
+      return `${url.pathname}${url.search}${url.hash}`
+    } catch {
+      return '/'
+    }
+  }
+}
