diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..d8ce6ed
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,23 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+
+const LocaleSchema = z.object({
+  locale: z.enum(['en', 'ja']),
+})
+
+export default class LocaleController extends Controller {
+  async setLocale(): Promise<Response> {
+    const { locale } = await this.validateBody(LocaleSchema)
+
+    const redirectUrl = this.request.header('referer') || '/'
+    const response = new Response(null, {
+      status: 302,
+      headers: {
+        Location: redirectUrl,
+        'Set-Cookie': `locale=${locale}; Max-Age=${60 * 60 * 24 * 365}; HttpOnly; SameSite=Lax; Path=/`,
+      },
+    })
+
+    return response
+  }
+}
