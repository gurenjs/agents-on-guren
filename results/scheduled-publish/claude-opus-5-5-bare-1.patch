new file mode 100644
index 0000000..c84da2f
--- /dev/null
+++ b/app/Console/Commands/PostsScheduledCommand.ts
@@ -0,0 +1,18 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints `<id>\t<title>\t<published_at>` for each scheduled post, soonest
+ * first, and nothing else on stdout, so ops can pipe it into other tools.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later (tab-separated, soonest first)'
+
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled().get()
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
