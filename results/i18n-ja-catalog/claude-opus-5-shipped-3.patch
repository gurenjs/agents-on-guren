+import ja from '../lang/ja/auth.json'
+import { inertiaPage } from './helpers/inertia.js'
+
+describe('RegisterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  const visit = (acceptLanguage?: string) =>
+    (acceptLanguage === undefined ? http : http.withHeader('Accept-Language', acceptLanguage)).get('/register')
+
+  it('renders the registration page', async () => {
+    const page = await inertiaPage(await visit().assertOk())
+    expect(page.component).toBe('auth/Register')
+  })
+
+  it('serves Japanese copy to a Japanese browser', async () => {
+    const response = await visit('ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+    const page = await inertiaPage(response)
+
+    expect(page.props._i18n.locale).toBe('ja')
+    expect(page.props._i18n.messages.ja.auth.register).toEqual(ja.register)
+    expect(await response.text()).toContain('<title>アカウント登録</title>')
+  })
+
+  it.each([
+    ['no Accept-Language header', undefined],
+    ['English', 'en'],
+    ['English outranking Japanese', 'en-US,en;q=0.9,ja;q=0.5'],
+    ['an unsupported language', 'fr-FR,fr;q=0.9'],
+  ])('keeps the English copy for %s', async (_label, header) => {
+    const response = await visit(header)
+    const page = await inertiaPage(response)
+
+    expect(page.props._i18n.locale).toBe('en')
+    expect(page.props._i18n.messages.en.auth.register).toEqual(en.register)
+    expect(await response.text()).toContain('<title>Sign up</title>')
+  })
+})
diff --git a/tests/helpers/inertia.ts b/tests/helpers/inertia.ts
new file mode 100644
index 0000000..0a42e64
--- /dev/null
+++ b/tests/helpers/inertia.ts
@@ -0,0 +1,28 @@
+import type { TestResponse } from '@guren/testing'
+
+interface I18nPageProps {
+  locale: string
+  fallbackLocale: string
+  // Catalogs are keyed by locale, then by lang/<locale>/<namespace>.json.
+  messages: Record<string, Record<string, Record<string, Record<string, string>>>>
+}
+
+interface InertiaPage {
+  component: string
+  props: { _i18n: I18nPageProps } & Record<string, unknown>
+}
+
+const PAGE_JSON = /<script data-page="app" type="application\/json">(.*?)<\/script>/s
+
+/**
+ * Read the Inertia page object a full-page (HTML) response embeds in its
+ * `data-page` script tag — the same payload the client hydrates from, which
+ * carries the shared `_i18n` prop the auth pages translate with.
+ */
+export async function inertiaPage(response: TestResponse): Promise<InertiaPage> {
+  const match = PAGE_JSON.exec(await response.text())
+  if (!match?.[1]) {
+    throw new Error('Response does not contain an Inertia data-page payload.')
+  }
+  return JSON.parse(match[1]) as InertiaPage
+}
