+
+// api.posts.index is the public JSON feed for partner integrations. Its
+// `page`/`author` query params are validated by the route contract itself
+// (see PostApiIndexQuerySchema on the route) before the controller — and
+// thus the database — is ever touched, so these 422 cases stay fixture-free
+// like the search tests above. Cover the happy path with real feature tests
+// once your test database is set up.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects a non-positive page', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+  })
+
+  it('rejects a non-numeric page', async () => {
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects a non-numeric author', async () => {
+    await http.get('/api/posts?author=abc').assertStatus(422)
+  })
+
+  it('rejects a non-positive author', async () => {
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+})
