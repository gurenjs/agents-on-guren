@@ -4,8 +4,42 @@ export const PostIdParamSchema = z.object({
   id: z.coerce.number().int().positive(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+/**
+ * Splits the comma-separated form value into unique, trimmed tag names; an
+ * empty or missing field means no tags. Case-sensitive, first spelling wins.
+ */
+export function parseTagNames(value: string | string[] | undefined): string[] {
+  const raw = Array.isArray(value) ? value.join(',') : (value ?? '')
+  const names = raw
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+  return [...new Set(names)]
+}
+
+// Issues are added without a path, so they are reported on the `tags` field.
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .transform((value, ctx) => {
+    const names = parseTagNames(value)
+    if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Tags must be ${MAX_TAG_LENGTH} characters or fewer.` })
+      return z.NEVER
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+      return z.NEVER
+    }
+    return names
+  })
+
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().optional(),
 })
 
