+import type { Context } from '@guren/core'
+import type { ContainerLike } from '@guren/core'
+import { agentTools, type AgentToolName } from '@/.guren/agents.gen'
+
+export interface McpRequest {
+  jsonrpc: '2.0'
+  id?: string | number
+  method: string
+  params?: Record<string, unknown>
+}
+
+export interface McpResponse {
+  jsonrpc: '2.0'
+  id?: string | number
+  result?: unknown
+  error?: { code: number; message: string }
+}
+
+export class McpHandler {
+  constructor(private container: ContainerLike) {}
+
+  async handle(request: McpRequest, _context: Context): Promise<McpResponse> {
+    try {
+      if (request.method === 'tools/list') {
+        return this.handleListTools()
+      }
+      if (request.method === 'tools/call') {
+        return await this.handleCallTool(request.params as any)
+      }
+      return {
+        jsonrpc: '2.0',
+        id: request.id,
+        error: { code: -32601, message: 'Method not found' },
+      }
+    } catch (error) {
+      return {
+        jsonrpc: '2.0',
+        id: request.id,
+        error: {
+          code: -32603,
+          message: error instanceof Error ? error.message : 'Internal error',
+        },
+      }
+    }
+  }
+
+  private handleListTools(): McpResponse {
+    const tools = Object.values(agentTools).map((tool) => ({
+      name: tool.toolName,
+      description: tool.description,
+      inputSchema: tool.inputSchema,
+      annotations: {
+        readOnly: tool.annotations.readOnlyHint ?? false,
+      },
+    }))
+
+    return {
+      jsonrpc: '2.0',
+      result: { tools },
+    }
+  }
+
+  private async handleCallTool(
+    params: { name: string; arguments: Record<string, unknown> }
+  ): Promise<McpResponse> {
+    const toolName = params.name as AgentToolName
+    const tool = agentTools[toolName]
+    if (!tool) {
+      return {
+        jsonrpc: '2.0',
+        error: { code: -32602, message: `Tool not found: ${params.name}` },
+      }
+    }
+
+    try {
+      // Build HTTP request from tool definition
+      const urlObj = new URL(tool.path, 'http://localhost')
+
+      // Prepare body for methods that accept body
+      let body: string | undefined
+      const bodyData: Record<string, unknown> = {}
+
+      Object.entries(params.arguments).forEach(([key, value]) => {
+        const source = tool.inputSources[key as keyof typeof tool.inputSources]
+        if (source === 'body') {
+          bodyData[key] = value
+        } else if (source === 'query') {
+          urlObj.searchParams.set(key, String(value))
+        }
+      })
+
+      if (Object.keys(bodyData).length > 0) {
+        body = JSON.stringify(bodyData)
+      }
+
+      // Create and dispatch request
+      const request = new Request(urlObj.toString(), {
+        method: tool.method,
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body,
+      })
+
+      const app = this.container.make('app') as any
+      const response = await app.fetch(request)
+      const responseData = await response.json()
+
+      // Format response
+      const isError = response.status >= 400
+      if (isError) {
+        return {
+          jsonrpc: '2.0',
+          result: {
+            isError: true,
+            content: [
+              {
+                type: 'text',
+                text: JSON.stringify(responseData),
+              },
+            ],
+          },
+        }
+      } else {
+        return {
+          jsonrpc: '2.0',
+          result: {
+            content: [
+              {
+                type: 'text',
+                text: JSON.stringify(responseData),
+              },
+            ],
+          },
+        }
+      }
+    } catch (error) {
+      return {
+        jsonrpc: '2.0',
+        error: {
+          code: -32603,
+          message: error instanceof Error ? error.message : 'Tool call failed',
+        },
+      }
+    }
+  }
+}
