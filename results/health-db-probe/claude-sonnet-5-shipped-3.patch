@@ -0,0 +1,23 @@
+import { Controller } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../../config/database.js'
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const db = await this.checkDatabase()
+
+    const status = db.status === 'ok' ? 'ok' : 'error'
+    return this.json({ status, checks: { db } }, { status: status === 'ok' ? 200 : 503 })
+  }
+
+  private async checkDatabase(): Promise<{ status: 'ok' | 'error'; message?: string }> {
+    try {
+      const database = (await getDatabase()) as SQLiteBunDatabase
+      await database.run(sql`SELECT 1`)
+      return { status: 'ok' }
+    } catch (error) {
+      return { status: 'error', message: error instanceof Error ? error.message : 'Database check failed' }
+    }
+  }
+}
