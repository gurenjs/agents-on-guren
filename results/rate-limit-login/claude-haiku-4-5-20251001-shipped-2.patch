@@ -0,0 +1,21 @@
+import { defineMiddleware, HttpException } from '@guren/core'
+import { checkLoginRateLimit, getClientIP } from './LoginRateLimiter.js'
+
+export const throttleLogin = defineMiddleware(async (c, next) => {
+  const clientIP = getClientIP(c.req.raw)
+  const { allowed, retryAfterSeconds } = checkLoginRateLimit(clientIP)
+
+  if (!allowed) {
+    return c.json(
+      { message: 'Too many login attempts. Please try again later.' },
+      {
+        status: 429,
+        headers: {
+          'Retry-After': retryAfterSeconds!.toString(),
+        },
+      }
+    )
+  }
+
+  return next()
+})
