+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module must stay liftable into another app as is, so the
+// blog never depends on it; only src/app.ts and db/schema.ts wire it in.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'app/ and routes/ must not import from modules/newsletter/; wire the module in src/app.ts instead.',
+    },
+  ],
+})
