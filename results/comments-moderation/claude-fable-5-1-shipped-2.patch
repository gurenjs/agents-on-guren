diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..4fe0b8f
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,30 @@
+import { Resource, type WithRelations } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+import type { CommentRecord, CommentAuthorSummary } from '../../Models/Comment.js'
+
+type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author: CommentAuthorSummary
+  // Serialized here because `created_at` is a string on SQLite and a Date on
+  // PostgreSQL and MySQL — pages should not have to know which.
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentRecord | CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+    const author = 'author' in comment ? comment.author : null
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      // `user_id` is NOT NULL with a foreign key, so the name is only blank
+      // when the caller did not eager-load `author`.
+      author: { id: comment.userId, name: author?.name ?? '' },
+      createdAt: new Date(comment.createdAt).toISOString(),
+    }
+  }
+}
