@@ -0,0 +1,120 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { migrateDatabase } from '../../../../config/database.js'
+import app from '../../../../src/app.js'
+import { NewsletterSubscription } from '../../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+type ValidationErrorBody = { errors: Record<string, string[]> }
+
+// Feature tests against the test database (data/guren.test.db under
+// `bun test`), driven as a guest's browser would: CSRF primed, JSON bodies and
+// a Referer naming a page of this site.
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const guest = await TestApp.fromApp(app)
+    http = (await guest.withCsrf()).withHeader('Referer', REFERER)
+  })
+
+  beforeEach(async () => {
+    for (const row of await NewsletterSubscription.all()) {
+      await NewsletterSubscription.delete({ id: row.id })
+    }
+  })
+
+  async function subscribe(email: string) {
+    await http.post('/newsletter/subscribe', { email })
+    const subscription = await NewsletterSubscription.first({ email })
+    if (!subscription) {
+      throw new Error(`Expected a subscription for ${email}.`)
+    }
+    return subscription
+  }
+
+  describe('subscribe', () => {
+    it('stores a pending subscription and sends the visitor back', async () => {
+      const response = await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0]?.email).toBe('reader@example.com')
+      expect(rows[0]?.confirmedAt).toBeNull()
+      expect(rows[0]?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('issues a different token for every subscription', async () => {
+      const first = await subscribe('first@example.com')
+      const second = await subscribe('second@example.com')
+
+      expect(first.token).not.toBe(second.token)
+    })
+
+    it('falls back to the home page without a Referer on this site', async () => {
+      const response = await http
+        .withHeader('Referer', 'https://elsewhere.example/landing')
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      expect(response.headers.get('Location')).toBe('/')
+    })
+
+    it('rejects an invalid email address', async () => {
+      for (const email of ['', 'not-an-email']) {
+        const response = await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+        const { errors } = await response.json<ValidationErrorBody>()
+        expect(errors).toHaveProperty('email')
+      }
+
+      expect(await NewsletterSubscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const existing = await subscribe('reader@example.com')
+
+      const response = await http.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertStatus(422)
+      const { errors } = await response.json<ValidationErrorBody>()
+
+      expect(errors).toHaveProperty('email')
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription and redirects home', async () => {
+      const { id, token } = await subscribe('reader@example.com')
+
+      const response = await http.get(`/newsletter/confirm/${token}`)
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe('/')
+      expect((await NewsletterSubscription.find(id))?.confirmedAt).toEqual(expect.any(String))
+    })
+
+    it('answers 404 to a token that was never issued', async () => {
+      const existing = await subscribe('reader@example.com')
+
+      await http.get('/newsletter/confirm/never-issued-token').assertStatus(404)
+
+      expect(await NewsletterSubscription.all()).toEqual([existing])
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes only that subscription and sends the visitor back', async () => {
+      await subscribe('leaving@example.com')
+      const staying = await subscribe('staying@example.com')
+
+      const response = await http.post('/newsletter/unsubscribe', { email: 'leaving@example.com' })
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe(REFERER)
+      expect(await NewsletterSubscription.all()).toEqual([staying])
+    })
+  })
+})
