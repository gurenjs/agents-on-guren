+++ b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
@@ -0,0 +1,62 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+describe('newsletter module', () => {
+  let http: TestApp
+  let guest: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    guest = await http.withHeader('Referer', 'http://localhost/posts').json().withCsrf()
+  })
+
+  it('stores a pending subscription and redirects back', async () => {
+    await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('http://localhost/posts')
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0].email).toBe('reader@example.com')
+    expect(rows[0].confirmedAt).toBeNull()
+    expect(rows[0].token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses with 422', async () => {
+    await guest.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    await guest.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    await guest
+      .post('/newsletter/subscribe', { email: 'reader@example.com' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s on an unknown one', async () => {
+    await guest.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const { token } = (await NewsletterSubscription.first({ email: 'reader@example.com' }))!
+
+    await http.get('/newsletter/confirm/not-a-real-token').assertNotFound()
+    expect((await NewsletterSubscription.first({ token }))?.confirmedAt).toBeNull()
+
+    await http.get(`/newsletter/confirm/${token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ token }))?.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given address', async () => {
+    await guest.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+    await guest.post('/newsletter/subscribe', { email: 'b@example.com' }).assertRedirect()
+
+    await guest.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('http://localhost/posts')
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((row) => row.email)).toEqual(['b@example.com'])
+  })
+})
