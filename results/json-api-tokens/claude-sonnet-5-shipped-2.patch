+          <ul className="space-y-2">
+            {tokens.map((token) => (
+              <li key={token.id} className="flex items-center justify-between text-sm text-g-text">
+                <span>{token.name}</span>
+                <button
+                  type="button"
+                  className="text-g-danger"
+                  onClick={() => router.delete(`/profile/tokens/${token.id}`, { preserveScroll: true })}
+                >
+                  Revoke
+                </button>
+              </li>
+            ))}
