+import { defineArchRules } from '@guren/cli/arch'
+
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      // The newsletter module ships with other apps as is, so the blog must
+      // not grow a dependency on it — not even on its public index.ts or
+      // schema. src/app.ts registers it; that is the only place it is wired in.
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'The blog (app/, routes/) must not import from modules/newsletter/. Register the module in src/app.ts instead.',
+    },
+  ],
+})
