@@ -1,6 +1,9 @@
 import { beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,38 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.update previously built its redirect by hand with a raw 302 Response.
+// A 302 after a PUT is not converted to a GET by fetch/XHR, so the browser
+// replayed the PUT against `/posts/:id` — which is the update route itself —
+// forever (net::ERR_TOO_MANY_REDIRECTS), even though each replay did persist
+// the edit. `this.redirect()` sends 303 for non-GET methods, which the client
+// correctly follows as a GET to the post's page.
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects with a status that a PUT follows as GET, not back into itself', async () => {
+    const user = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: user.id,
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    const response = await csrf.put(`/posts/${post.id}`, {
+      title: 'Updated title',
+      excerpt: 'Updated excerpt',
+      body: 'Updated body',
+    })
+
+    response.assertRedirect(`/posts/${post.id}`)
+    response.assertStatus(303)
+  })
+})
