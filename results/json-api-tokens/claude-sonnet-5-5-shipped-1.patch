diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..e04ce43
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,38 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_USER_KEY = 'apiTokenUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Per-process request timestamps by token hash (ids are reused after a DB reset); stale entries are dropped on each hit.
+const hits = new Map<string, number[]>()
+
+const unauthenticated = (): Response =>
+  Response.json({ message: 'Unauthenticated.' }, { status: 401 })
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('authorization') ?? ''
+  const match = /^Bearer +(\S+)$/i.exec(header.trim())
+  if (!match) return unauthenticated()
+
+  const record = await ApiToken.first({ tokenHash: ApiToken.hash(match[1]!) })
+  if (!record) return unauthenticated()
+
+  const now = Date.now()
+  const recent = (hits.get(record.tokenHash) ?? []).filter((at) => now - at < WINDOW_MS)
+  if (recent.length >= LIMIT) {
+    hits.set(record.tokenHash, recent)
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((recent[0]! + WINDOW_MS - now) / 1000)))
+    return Response.json(
+      { message: 'Too many requests.' },
+      { status: 429, headers: { 'Retry-After': String(retryAfter) } },
+    )
+  }
+  recent.push(now)
+  hits.set(record.tokenHash, recent)
+
+  c.set(API_TOKEN_USER_KEY as never, record.userId as never)
+  await next()
+})
