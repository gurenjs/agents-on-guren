@@ -16,3 +16,32 @@ export class Post extends defineModel(posts) {
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
+
+const EXCERPT_LENGTH = 140
+
+// Derives a teaser from the body when no excerpt was supplied: the first
+// `EXCERPT_LENGTH` characters, never cutting a word in half, plus an
+// ellipsis — unless the whole (trimmed) body already fits.
+export function deriveExcerpt(body: string): string {
+  const trimmedBody = body.trim()
+  if (trimmedBody.length <= EXCERPT_LENGTH) return trimmedBody
+
+  const charAtCut = trimmedBody[EXCERPT_LENGTH - 1]
+  const charAfterCut = trimmedBody[EXCERPT_LENGTH]
+  const cutsInsideWord = !/\s/.test(charAtCut) && !/\s/.test(charAfterCut)
+
+  let end = EXCERPT_LENGTH
+  if (cutsInsideWord) {
+    const head = trimmedBody.slice(0, EXCERPT_LENGTH)
+    let lastWhitespaceIndex = -1
+    for (let i = head.length - 1; i >= 0; i--) {
+      if (/\s/.test(head[i]!)) {
+        lastWhitespaceIndex = i
+        break
+      }
+    }
+    end = lastWhitespaceIndex === -1 ? EXCERPT_LENGTH : lastWhitespaceIndex
+  }
+
+  return trimmedBody.slice(0, end).replace(/\s+$/, '') + '…'
+}
