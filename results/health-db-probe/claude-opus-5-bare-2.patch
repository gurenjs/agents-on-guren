diff --git a/tests/HealthController.test.ts b/tests/HealthController.test.ts
new file mode 100644
index 0000000..dc1ae28
--- /dev/null
+++ b/tests/HealthController.test.ts
@@ -0,0 +1,78 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createHealthManager } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { DatabaseHealthCheck } from '../app/Health/DatabaseHealthCheck.js'
+import { healthStatusCode } from '../app/Health/index.js'
+import type { AppDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+type HealthBody = {
+  status: string
+  checks: Array<{ name: string; status: string; message?: string }>
+}
+
+/** Stands in for the Drizzle handle, failing the way an unusable database does. */
+function failingDatabase(message: string): AppDatabase {
+  return {
+    get() {
+      throw new Error(message)
+    },
+  } as unknown as AppDatabase
+}
+
+describe('GET /health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('answers 200 with a passing database check', async () => {
+    const response = await http.get('/health').assertOk()
+    const body = await response.json<HealthBody>()
+
+    expect(body.status).toBe('healthy')
+    expect(body.checks.find((check) => check.name === 'database')?.status).toBe('healthy')
+  })
+})
+
+describe('database health check', () => {
+  it('reports healthy after a real round trip', async () => {
+    const result = await new DatabaseHealthCheck().check()
+
+    expect(result.status).toBe('healthy')
+  })
+
+  it('reports unhealthy when the connection cannot be opened', async () => {
+    const check = new DatabaseHealthCheck(() => Promise.reject(new Error('connection refused')))
+    const result = await check.check()
+
+    expect(result.status).toBe('unhealthy')
+    expect(result.message).toBe('connection refused')
+  })
+
+  it('reports unhealthy when the query throws', async () => {
+    const check = new DatabaseHealthCheck(async () => failingDatabase('no such table'))
+    const result = await check.check()
+
+    expect(result.status).toBe('unhealthy')
+    expect(result.message).toBe('no such table')
+  })
+
+  // A failing database has to reach the report as `unhealthy`, not `degraded`:
+  // only `unhealthy` drains the instance from the load-balancer pool.
+  it('drops the whole report to unhealthy, and 503, when it fails', async () => {
+    const manager = createHealthManager().register(
+      new DatabaseHealthCheck(() => Promise.reject(new Error('down'))),
+      { critical: true },
+    )
+    const report = await manager.check()
+
+    expect(report.status).toBe('unhealthy')
+    expect(healthStatusCode(report.status)).toBe(503)
+  })
+
+  it('keeps a passing report on 200', () => {
+    expect(healthStatusCode('healthy')).toBe(200)
+  })
+})
