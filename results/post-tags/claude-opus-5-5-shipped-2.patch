@@ -6,8 +6,36 @@ export const PostIdParamSchema = z.object({
 
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().trim().optional(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_NAME_LENGTH = 30
+
+type TagListInput = string | string[] | null | undefined
+
+/** The unique, trimmed, non-empty names of a comma-separated tag field, in input order. */
+export function normalizeTagNames(value: TagListInput): string[] {
+  const raw = value == null ? [] : Array.isArray(value) ? value : value.split(',')
+  return [...new Set(raw.map((name) => name.trim()).filter((name) => name.length > 0))]
+}
+
+// Validates without transforming: codegen types `validated()` from the input
+// side, so the controller normalizes with normalizeTagNames() itself.
+export const TagListSchema = z
+  .union([z.string(), z.array(z.string())])
+  .nullable()
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = normalizeTagNames(value)
+    if (names.some((name) => name.length > MAX_TAG_NAME_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_NAME_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+  })
+
