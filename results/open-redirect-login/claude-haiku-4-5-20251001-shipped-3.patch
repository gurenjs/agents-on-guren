+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+  })
+
+  describe('open redirect protection', () => {
+    beforeAll(async () => {
+      // Create a test user for authentication attempts
+      await User.create({
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123',
+      })
+    })
+
+    it('allows redirects to internal paths after successful login', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '/posts/3/edit',
+        })
+        .assertRedirect('/posts/3/edit')
+    })
+
+    it('allows redirects to root path', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '/',
+        })
+        .assertRedirect('/')
+    })
+
+    it('rejects redirects to external domains', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: 'https://evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects protocol-relative URLs', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '//evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects backslash protocol-relative variants', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '/\\evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects double backslash variants', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '/\\\\evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects URLs with http scheme', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: 'http://evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects URLs with ftp scheme', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: 'ftp://evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('allows empty redirect and redirects to dashboard', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: '',
+        })
+        .assertRedirect('/dashboard')
+    })
+
+    it('still rejects redirect validation error even with valid credentials', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: 'https://evil.example.com',
+        })
+        .assertStatus(422)
+    })
+
+    it('rejects login with invalid credentials regardless of redirect validity', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'wrongpassword',
+          redirect: '/dashboard',
+        })
+        .assertStatus(422)
+    })
+
+    it('accepts relative paths without leading slash', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'test@example.com',
+          password: 'password123',
+          redirect: 'posts/3',
+        })
+        .assertRedirect('posts/3')
+    })
+  })
+})
