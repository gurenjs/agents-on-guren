diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..32f0f47
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,41 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+  type Middleware,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+// The one store both the profile page (create/revoke) and the bearer guard
+// read. Rows keep only the SHA-256 of the secret, so a dump holds no working
+// credential; the `{id}|{secret}` plain text exists only in the 201 response.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const API_RATE_LIMIT = 60
+const API_RATE_WINDOW_MS = 60_000
+
+// Authenticates `/api/*` as the token's owner. Every failure — no header, a
+// malformed or unknown token, a revoked one — answers 401 JSON.
+export const requireApiToken: Middleware = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: async (userId) => User.find(Number(userId)),
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed on the token id, not the user, so each token gets its own budget.
+// Registered after requireApiToken, which puts the verified token on the context.
+export const throttleApiToken: Middleware = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  onRateLimited: (ctx, retryAfter) => {
+    const seconds = Math.min(60, Math.max(1, retryAfter))
+    ctx.header('Retry-After', String(seconds))
+    return ctx.json({ message: 'Too many requests.', retryAfter: seconds }, 429)
+  },
+})
