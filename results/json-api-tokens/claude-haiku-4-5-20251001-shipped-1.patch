+import { describe, test, expect, beforeAll } from 'bun:test'
+import app from '../src/app.js'
+import { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { ApiToken, type ApiTokenRecord } from '../app/Models/ApiToken.js'
+import { TokenService } from '../app/Services/TokenService.js'
+
+describe('ApiPostController', () => {
+  let http: TestApp
+  let user: UserRecord
+  let token: string
+  let _apiToken: ApiTokenRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({
+      name: 'Test User',
+      email: `api-post-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    const { token: plainToken, hash } = TokenService.generateToken()
+    token = plainToken
+    _apiToken = await ApiToken.create({
+      userId: user.id,
+      name: 'Test Token',
+      hashedToken: hash,
+    })
+
+    await Post.forceCreate({
+      title: 'First Post',
+      excerpt: 'First excerpt',
+      body: 'First body',
+      authorId: user.id,
+    })
+
+    await Post.forceCreate({
+      title: 'Second Post',
+      excerpt: 'Second excerpt',
+      body: 'Second body',
+      authorId: user.id,
+    })
+  })
+
+  test('GET /api/posts lists posts', async () => {
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .get('/api/posts')
+
+    expect(res.status).toBe(200)
+    const body = await res.json<{ data: any[] }>()
+    expect(body.data).toBeDefined()
+    expect(body.data.length).toBeGreaterThanOrEqual(2)
+    expect(body.data[0].title).toBeDefined()
+    expect(body.data[0].excerpt).toBeDefined()
+    expect(body.data[0].authorId).toBeDefined()
+    expect(body.data[0].createdAt).toBeDefined()
+  })
+
+  test('GET /api/posts returns 401 without token', async () => {
+    const res = await http.json().get('/api/posts')
+    expect(res.status).toBe(401)
+  })
+
+  test('GET /api/posts returns 401 with invalid token', async () => {
+    const res = await http
+      .withHeader('Authorization', 'Bearer invalid-token')
+      .json()
+      .get('/api/posts')
+
+    expect(res.status).toBe(401)
+  })
+
+  test('POST /api/posts creates post for token owner', async () => {
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .post('/api/posts', {
+        title: 'New Post',
+        excerpt: 'New excerpt',
+        body: 'New body',
+      })
+
+    expect(res.status).toBe(201)
+    const body = await res.json<{ data: any }>()
+    expect(body.data.title).toBe('New Post')
+    expect(body.data.excerpt).toBe('New excerpt')
+    expect(body.data.body).toBe('New body')
+    expect(body.data.authorId).toBe(user.id)
+  })
+
+  test('POST /api/posts returns 422 for invalid input', async () => {
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .post('/api/posts', {
+        title: '',
+        excerpt: 'New excerpt',
+        body: 'New body',
+      })
+
+    expect(res.status).toBe(422)
+  })
+
+  test('POST /api/posts ignores authorId in request', async () => {
+    const otherUser = await User.create({
+      name: 'Other User',
+      email: `api-other-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .post('/api/posts', {
+        title: 'Token Post',
+        excerpt: 'Token excerpt',
+        body: 'Token body',
+        authorId: otherUser.id,
+      })
+
+    expect(res.status).toBe(201)
+    const body = await res.json<{ data: any }>()
+    expect(body.data.authorId).toBe(user.id)
+  })
+})
