+
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('rejects invalid page and author query values', async () => {
+    await http.json().get('/api/posts?page=0').assertUnprocessable()
+    await http.json().get('/api/posts?page=abc').assertUnprocessable()
+    await http.json().get('/api/posts?author=abc').assertUnprocessable()
+    await http.json().get('/api/posts?author=0').assertUnprocessable()
+  })
+
+  it('lists posts newest first, 10 per page, with author id/name', async () => {
+    const author = await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret' })
+    for (let i = 0; i < 12; i++) {
+      await Post.forceCreate({ title: `Post ${i}`, excerpt: `Excerpt ${i}`, body: `Body ${i}`, authorId: author.id })
+    }
+
+    await http
+      .json()
+      .get('/api/posts')
+      .assertOk()
+      .assertJsonCount(10, 'data')
+      .assertJsonPath('meta.currentPage', 1)
+      .assertJsonPath('meta.lastPage', 2)
+      .assertJsonPath('meta.perPage', 10)
+      .assertJsonPath('meta.total', 12)
+      .assertJsonPath('data.0.title', 'Post 11')
+      .assertJsonPath('data.0.author.id', author.id)
+      .assertJsonPath('data.0.author.name', 'Alice')
+
+    await http.json().get('/api/posts?page=2').assertOk().assertJsonCount(2, 'data').assertJsonPath('meta.currentPage', 2)
+  })
+
+  it('filters by author, combines with page, and returns an empty page for an author with no posts', async () => {
+    const alice = await User.create({ name: 'Alice', email: 'alice2@example.com', password: 'secret' })
+    const bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret' })
+    await Post.forceCreate({ title: 'A1', excerpt: 'e', body: 'b', authorId: alice.id })
+    await Post.forceCreate({ title: 'A2', excerpt: 'e', body: 'b', authorId: alice.id })
+    await Post.forceCreate({ title: 'B1', excerpt: 'e', body: 'b', authorId: bob.id })
+
+    await http
+      .json()
+      .get(`/api/posts?author=${alice.id}`)
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('meta.total', 2)
+
+    const noPostsAuthor = await User.create({ name: 'Carol', email: 'carol@example.com', password: 'secret' })
+    await http
+      .json()
+      .get(`/api/posts?author=${noPostsAuthor.id}`)
+      .assertOk()
+      .assertJsonCount(0, 'data')
+      .assertJsonPath('meta.total', 0)
+  })
+})
