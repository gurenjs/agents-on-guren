diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..5bcd69e
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,300 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('CommentController', () => {
+  let http: TestApp
+  let author: UserRecord
+  let commenter: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    author = await User.create({
+      name: 'Post Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+
+    commenter = await User.create({
+      name: 'Commenter',
+      email: 'commenter@example.com',
+      password: 'password123',
+    })
+
+    post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'A test post',
+      body: 'This is the body of the test post',
+      authorId: author.id,
+    })
+  })
+
+  describe('POST /posts/:id/comments', () => {
+    it('redirects unauthenticated users to login', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'A comment' }).assertRedirect('/login')
+    })
+
+    it('stores a comment for authenticated users', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Great post!' }).assertRedirect(`/posts/${post.id}`)
+
+      const comment = await Comment.first({ postId: post.id, userId: commenter.id })
+      if (!comment) throw new Error('Comment not created')
+      if (comment.body !== 'Great post!') throw new Error('Comment body mismatch')
+    })
+
+    it('validates comment body length', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+
+      // Empty body
+      await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+
+      // Too long (2001 characters)
+      const longBody = 'a'.repeat(2001)
+      await csrf.json().post(`/posts/${post.id}/comments`, { body: longBody }).assertUnprocessable()
+
+      // Valid 2000 characters
+      const validBody = 'a'.repeat(2000)
+      await csrf.post(`/posts/${post.id}/comments`, { body: validBody }).assertRedirect(`/posts/${post.id}`)
+    })
+  })
+
+  describe('DELETE /comments/:id', () => {
+    it('allows comment author to delete', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment to delete',
+      })
+
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+      const deleted = await Comment.find(comment.id)
+      if (deleted) throw new Error('Comment not deleted')
+    })
+
+    it('allows post author to delete others comments', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment to delete by post author',
+      })
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+      const deleted = await Comment.find(comment.id)
+      if (deleted) throw new Error('Comment not deleted by post author')
+    })
+
+    it('denies other users from deleting', async () => {
+      const other = await User.create({
+        name: 'Other User',
+        email: 'other@example.com',
+        password: 'password123',
+      })
+
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment that should not be deleted',
+      })
+
+      const csrf = await http.actingAs(other).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertForbidden()
+
+      const notDeleted = await Comment.find(comment.id)
+      if (!notDeleted) throw new Error('Comment was deleted by unauthorized user')
+    })
+
+    it('redirects unauthenticated users to login', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment',
+      })
+
+      const csrf = await http.withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect('/login')
+    })
+  })
+
+  describe('POST /comments/:id/report', () => {
+    it('allows authenticated users to report', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Inappropriate comment',
+      })
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.json().post(`/comments/${comment.id}/report`).assertStatus(204)
+
+      const report = await CommentReport.first({
+        commentId: comment.id,
+        userId: author.id,
+      })
+      if (!report) throw new Error('Report not created')
+    })
+
+    it('returns 204 on duplicate reports', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Another inappropriate comment',
+      })
+
+      const csrf = await http.actingAs(author).withCsrf()
+
+      // First report
+      await csrf.json().post(`/comments/${comment.id}/report`).assertStatus(204)
+
+      // Second report from same user
+      await csrf.json().post(`/comments/${comment.id}/report`).assertStatus(204)
+
+      // Should still be only one report
+      const reports = await CommentReport.where({
+        commentId: comment.id,
+        userId: author.id,
+      }).get()
+      if (reports.length !== 1) throw new Error('Duplicate report was created')
+    })
+
+    it('redirects unauthenticated users to login', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment',
+      })
+
+      const csrf = await http.withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertRedirect('/login')
+    })
+  })
+
+  describe('GET /posts/:id - comments visibility', () => {
+    it('shows comments with fewer than 3 reports', async () => {
+      // Create a new post for this test
+      const testPost = await Post.forceCreate({
+        title: 'Test Post 2',
+        excerpt: 'Test',
+        body: 'Test body',
+        authorId: author.id,
+      })
+
+      const comment = await Comment.forceCreate({
+        postId: testPost.id,
+        userId: commenter.id,
+        body: 'Visible comment',
+      })
+
+      // Add 2 reports (less than 3)
+      const user1 = await User.create({
+        name: 'Reporter 1',
+        email: 'reporter1@example.com',
+        password: 'password123',
+      })
+      const user2 = await User.create({
+        name: 'Reporter 2',
+        email: 'reporter2@example.com',
+        password: 'password123',
+      })
+
+      await CommentReport.create({ commentId: comment.id, userId: user1.id })
+      await CommentReport.create({ commentId: comment.id, userId: user2.id })
+
+      // Check database directly
+      const comments = await Comment.where({ postId: testPost.id }).with('author').get()
+      const reportCounts = await CommentReport.where({ commentId: comment.id }).get()
+
+      if (reportCounts.length !== 2) throw new Error('Should have 2 reports')
+      if (!comments.find(c => c.id === comment.id)) throw new Error('Comment should exist in database')
+    })
+
+    it('counts reports correctly to determine visibility', async () => {
+      // Create a new post for this test
+      const testPost = await Post.forceCreate({
+        title: 'Test Post 3',
+        excerpt: 'Test',
+        body: 'Test body',
+        authorId: author.id,
+      })
+
+      const comment = await Comment.forceCreate({
+        postId: testPost.id,
+        userId: commenter.id,
+        body: 'Comment for reporting',
+      })
+
+      // Add 3 reports
+      const reporters = await Promise.all([
+        User.create({
+          name: 'Reporter A',
+          email: 'reporterA@example.com',
+          password: 'password123',
+        }),
+        User.create({
+          name: 'Reporter B',
+          email: 'reporterB@example.com',
+          password: 'password123',
+        }),
+        User.create({
+          name: 'Reporter C',
+          email: 'reporterC@example.com',
+          password: 'password123',
+        }),
+      ])
+
+      for (const reporter of reporters) {
+        await CommentReport.create({ commentId: comment.id, userId: reporter.id })
+      }
+
+      const reportCounts = await CommentReport.where({ commentId: comment.id }).get()
+      if (reportCounts.length !== 3) throw new Error('Should have 3 reports')
+    })
+
+    it('shows comments oldest first', async () => {
+      // Create a new post for this test
+      const testPost = await Post.forceCreate({
+        title: 'Test Post 4',
+        excerpt: 'Test',
+        body: 'Test body',
+        authorId: author.id,
+      })
+
+      const comment1 = await Comment.forceCreate({
+        postId: testPost.id,
+        userId: commenter.id,
+        body: 'First comment',
+      })
+
+      // Add small delay to ensure different timestamps
+      await new Promise(resolve => setTimeout(resolve, 10))
+
+      const comment2 = await Comment.forceCreate({
+        postId: testPost.id,
+        userId: author.id,
+        body: 'Second comment',
+      })
+
+      const comments = await Comment.where({ postId: testPost.id }).with('author').get()
+
+      if (comments.length < 2) throw new Error('Expected at least 2 comments')
+      if (comments[0].id !== comment1.id) throw new Error('First comment should be oldest')
+      if (comments[1].id !== comment2.id) throw new Error('Second comment should be newer')
+    })
+  })
+})
