+/** The tag names in a comma-separated `tags` field: trimmed, blanks dropped, each name once. */
+export function parseTagNames(value: string): string[] {
+  const names = value
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
+}
+
