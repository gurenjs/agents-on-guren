diff --git a/app/Utils/excerptDeriver.ts b/app/Utils/excerptDeriver.ts
new file mode 100644
index 0000000..da745b3
--- /dev/null
+++ b/app/Utils/excerptDeriver.ts
@@ -0,0 +1,42 @@
+/**
+ * Derive an excerpt from the body text.
+ *
+ * Rules:
+ * - If body ≤ 140 characters, return the whole body unchanged.
+ * - Otherwise, take the first 140 characters but don't cut words in half.
+ * - Append an ellipsis character (…) to truncated text.
+ */
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+
+  if (trimmed.length <= 140) {
+    return trimmed
+  }
+
+  // Get the first 140 characters
+  let excerpt = trimmed.substring(0, 140)
+
+  // Check if we need to cut back to avoid cutting a word in half
+  const nextChar = trimmed[140]
+
+  // If the character at position 140 is not whitespace, and position 139 is also not whitespace,
+  // then we've cut a word in half. Need to cut back to the last whitespace.
+  if (nextChar && !/\s/.test(nextChar) && !/\s/.test(trimmed[139])) {
+    // Find the last whitespace in the excerpt
+    let lastWhitespace = -1
+    for (let i = excerpt.length - 1; i >= 0; i--) {
+      if (/\s/.test(excerpt[i])) {
+        lastWhitespace = i
+        break
+      }
+    }
+
+    // If we found a whitespace, cut there. Otherwise keep the full 140 chars.
+    if (lastWhitespace > 0) {
+      excerpt = excerpt.substring(0, lastWhitespace)
+    }
+  }
+
+  // Trim trailing whitespace and append ellipsis
+  return excerpt.trim() + '…'
+}
