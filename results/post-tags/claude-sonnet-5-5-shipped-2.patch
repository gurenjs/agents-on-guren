diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..f84ece9
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,69 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  async function store(tags?: string) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return csrf.json().post('/posts', payload(tags))
+  }
+
+  it('creates, edits and filters by tags', async () => {
+    await (await store('bun, webdev')).assertRedirect()
+    const post = (await Post.all())[0]!
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(2)
+    const shown = await http.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`)
+    expect((await shown.json<{ props: { post: { tags: string[] } } }>()).props.post.tags).toEqual(['bun', 'webdev'])
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${post.id}`, payload('bun')).assertRedirect()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+
+    const res = await http.get('/posts?tag=bun')
+    expect(await res.text()).toContain('"tags":["bun"]')
+    expect(await (await http.get('/posts?tag=nope')).text()).toContain('"data":[]')
+  })
+
+  it('refuses invalid tag lists and writes nothing', async () => {
+    const titleStatus = (await (await http.actingAs(author).withCsrf()).json().post('/posts', { ...payload(), title: '' })).status
+    for (const tags of ['a,b,c,d,e,f', 'x'.repeat(31)]) {
+      expect((await store(tags)).status).toBe(titleStatus)
+    }
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+  })
+
+  it('accepts 30 characters and dedupes names', async () => {
+    await (await store('x'.repeat(30))).assertRedirect()
+    await (await store(' bun ,bun')).assertRedirect()
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'x'.repeat(30)])
+    expect(await PostTag.all()).toHaveLength(2)
+  })
+
+  it('deletes tagged posts', async () => {
+    await (await store('bun')).assertRedirect()
+    const post = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
