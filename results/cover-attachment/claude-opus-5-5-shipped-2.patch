+    const oversized = new Uint8Array(2 * 1024 * 1024 + 1)
+    oversized.set(PNG)
+
+    for (const file of [
+      new File([GIF], 'c.gif', { type: 'image/gif' }),
+      new File([GIF], 'c.png', { type: 'image/png' }),
+      new File([oversized], 'big.png', { type: 'image/png' }),
+    ]) {
+      const res = await client.json().post('/posts', postForm({ cover: file }))
+      res.assertUnprocessable()
+      expect((await res.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeArray()
+    }
+    expect(await Post.newQuery().count()).toBe(0)
+    expect((await Attachment.all()).length).toBe(0)
+  })
+
+  it('replaces, keeps and removes the cover on edit', async () => {
+    const client = await signedIn()
+    await client.post('/posts', postForm({ cover: new File([PNG], 'c.png', { type: 'image/png' }) })).assertRedirect()
+    const post = (await Post.first())!
+    const firstUrl = (await showProps(post.id)).coverUrl!
+
+    await client.json().put(`/posts/${post.id}`, postForm({ cover: new File([GIF], 'c.gif', { type: 'image/gif' }) })).assertUnprocessable()
+    expect((await showProps(post.id)).coverUrl).toBe(firstUrl)
+
+    await client.put(`/posts/${post.id}`, postForm({ cover: new File([JPEG], 'c.jpg', { type: 'image/jpeg' }) })).assertRedirect()
+    const secondUrl = (await showProps(post.id)).coverUrl!
+    await http.get(firstUrl).assertNotFound()
+    await http.get(secondUrl).assertOk().assertHeader('content-type', 'image/jpeg')
+    expect((await Attachment.all()).length).toBe(1)
+
+    await client.put(`/posts/${post.id}`, postForm({ title: 'Renamed' })).assertRedirect()
+    expect((await showProps(post.id)).coverUrl).toBe(secondUrl)
+
+    await client.put(`/posts/${post.id}`, postForm({ removeCover: '1' })).assertRedirect()
+    expect((await showProps(post.id)).coverUrl).toBeNull()
+    await http.get(secondUrl).assertNotFound()
+    expect((await Attachment.all()).length).toBe(0)
