diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..bb1493f
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,39 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+/** The cookie `detectLocaleMiddleware` reads (its default name), sent back for a year. */
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  // Serves `locale.update`: the route contract validates `{ locale }` against
+  // LocaleSchema before this runs, so an unsupported value fails exactly like an
+  // invalid post payload and never reaches the cookie.
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+
+    // Locale detection reads the query string ahead of the cookie, so the
+    // redirect target must not carry a stale `?locale=` from the referring page.
+    return this.redirect(this.backUrl(), {
+      headers: {
+        'Set-Cookie': `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${ONE_YEAR_SECONDS}; SameSite=Lax`,
+      },
+    })
+  }
+
+  // The page the reader was on, reduced to a same-origin path so the switcher
+  // can never become an open redirect; anything else goes home.
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer || !isSafeRedirectUrl(referer, this.request.url)) {
+      return '/'
+    }
+
+    try {
+      const target = new URL(referer, this.request.url)
+      target.searchParams.delete('locale')
+      return `${target.pathname}${target.search}${target.hash}`
+    } catch {
+      return '/'
+    }
+  }
+}
