@@ -0,0 +1,124 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+// Drafts: a post is private until its author publishes it. Guests and other
+// signed-in users must not see it in the list, in search results, or on its
+// own page — while the author keeps full access to it.
+describe('post visibility', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let draftId: number
+  let publishedId: number
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })) as UserRecord
+    stranger = (await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret' })) as UserRecord
+
+    const draft = await Post.forceCreate({
+      title: 'Unfinished thoughts on quokkas',
+      excerpt: 'A quokka draft nobody else should read.',
+      body: 'Still writing this one.',
+      authorId: author.id,
+      published: false,
+    })
+    const published = await Post.forceCreate({
+      title: 'Finished thoughts on wombats',
+      excerpt: 'A wombat post everyone may read.',
+      body: 'This one is done.',
+      authorId: author.id,
+      published: true,
+    })
+
+    draftId = draft?.id as number
+    publishedId = published?.id as number
+  })
+
+  it('hides drafts from the guest post list', async () => {
+    const response = await http.get('/posts')
+    const body = await response.text()
+
+    expect(body).toContain('wombats')
+    expect(body).not.toContain('quokkas')
+  })
+
+  it('hides drafts from another signed-in user', async () => {
+    const response = await http.actingAs(stranger).get('/posts')
+    const body = await response.text()
+
+    expect(body).not.toContain('quokkas')
+  })
+
+  it('keeps drafts out of search results', async () => {
+    await http.query('/posts/search', { keywords: ['quokka'] }).assertJsonCount(0, 'data')
+    await http.query('/posts/search', { keywords: ['wombat'] }).assertJsonCount(1, 'data')
+  })
+
+  it("answers 404 for a guest opening someone's draft", async () => {
+    await http.get(`/posts/${draftId}`).assertNotFound()
+    await http.actingAs(stranger).get(`/posts/${draftId}`).assertNotFound()
+  })
+
+  it('serves a published post to a guest', async () => {
+    await http.get(`/posts/${publishedId}`).assertOk()
+  })
+
+  it('lets the author read and edit their own draft', async () => {
+    const authed = http.actingAs(author)
+
+    await authed.get(`/posts/${draftId}`).assertOk()
+    await authed.get(`/posts/${draftId}/edit`).assertOk()
+    await authed.query('/posts/search', { keywords: ['quokka'] }).assertJsonCount(1, 'data')
+  })
+
+  it('creates a draft when the checkbox is missing, and publishes when it is set', async () => {
+    const authed = await http.actingAs(author).withCsrf()
+
+    await authed
+      .post('/posts', { title: 'Silent platypus', excerpt: 'A platypus draft.', body: 'Draft body.' })
