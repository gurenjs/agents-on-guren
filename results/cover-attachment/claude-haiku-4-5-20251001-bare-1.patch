@@ -0,0 +1,31 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+import { Attachment } from '../../Models/Attachment.js'
+import { FileStorageService } from '../../Services/FileStorageService.js'
+
+const AttachmentIdParamSchema = z.object({
+  id: z.coerce.number().int().positive(),
+})
+
+export default class AttachmentController extends Controller {
+  async show(): Promise<Response> {
+    const { id } = this.validateParams(AttachmentIdParamSchema)
+    const attachment = await Attachment.find(id)
+
+    if (!attachment) {
+      return this.json({ error: 'Not found' }, { status: 404 })
+    }
+
+    try {
+      const buffer = await FileStorageService.readFile(attachment.filePath)
+      return new Response(new Uint8Array(buffer), {
+        headers: {
+          'Content-Type': attachment.mimeType,
+          'Cache-Control': 'public, max-age=31536000',
+        },
+      })
+    } catch {
+      return this.json({ error: 'Not found' }, { status: 404 })
+    }
+  }
+}
