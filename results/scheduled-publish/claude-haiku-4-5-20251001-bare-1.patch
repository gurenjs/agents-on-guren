diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..011c5cc
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,204 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: any
+  let otherUser: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    const ts = Date.now()
+    author = await User.forceCreate({
+      name: 'Test Author',
+      email: `author-${ts}@example.com`,
+      password: 'password',
+    })
+
+    otherUser = await User.forceCreate({
+      name: 'Other User',
+      email: `other-${ts}@example.com`,
+      password: 'password',
+    })
+  })
+
+
+  it('hides scheduled posts from guests in list', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    await Post.forceCreate({
+      title: 'Secret Scheduled Post',
+      excerpt: 'Only author can see',
+      body: 'Hidden content',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    const response = await http.get('/posts').assertStatus(200)
+    const body = await response.text()
+    if (body.includes('Secret Scheduled Post')) {
+      throw new Error('Scheduled post should not be visible to guests')
+    }
+  })
+
+  it('shows scheduled posts to their author in list', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    await Post.forceCreate({
+      title: 'Author Only Post',
+      excerpt: 'Only author can see this',
+      body: 'Author only content',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    const response = await http.actingAs(author).get('/posts').assertStatus(200)
+    const body = await response.text()
+    if (!body.includes('Author Only Post')) {
+      throw new Error('Author should see their scheduled post')
+    }
+  })
+
+  it('returns 404 for scheduled post page when accessed by guest', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    const post = await Post.forceCreate({
+      title: 'Hidden Post',
+      excerpt: 'Hidden from public',
+      body: 'Hidden content',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    await http.get(`/posts/${post.id}`).assertStatus(404)
+  })
+
+  it('returns 404 for scheduled post when accessed by different user', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    const post = await Post.forceCreate({
+      title: 'Private Post',
+      excerpt: 'Not for others',
+      body: 'Private content',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    await http.actingAs(otherUser).get(`/posts/${post.id}`).assertStatus(404)
+  })
+
+  it('allows author to view their scheduled post', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    const post = await Post.forceCreate({
+      title: 'Author View Post',
+      excerpt: 'Author can view',
+      body: 'Author can see this',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    const response = await http.actingAs(author).get(`/posts/${post.id}`).assertStatus(200)
+    const body = await response.text()
+    if (!body.includes('Author View Post')) {
+      throw new Error('Author should be able to view their scheduled post')
+    }
+  })
+
+  it('shows published posts to everyone', async () => {
+    const post = await Post.forceCreate({
+      title: 'Published Post',
+      excerpt: 'Everyone can see this',
+      body: 'Public content',
+      authorId: author.id,
+      publishedAt: null,
+    })
+
+    let response = await http.get('/posts').assertStatus(200)
+    let body = await response.text()
+    if (!body.includes('Published Post')) {
+      throw new Error('Guest should see published post')
+    }
+
+    response = await http.actingAs(otherUser).get('/posts').assertStatus(200)
+    body = await response.text()
+    if (!body.includes('Published Post')) {
+      throw new Error('Other user should see published post')
+    }
+  })
+
+  it('shows posts with past publishedAt to everyone', async () => {
+    const pastTime = new Date(Date.now() - 3600000).toISOString()
+
+    const post = await Post.forceCreate({
+      title: 'Past Published Post',
+      excerpt: 'Published in the past',
+      body: 'Now public',
+      authorId: author.id,
+      publishedAt: pastTime,
+    })
+
+    let response = await http.get('/posts').assertStatus(200)
+    let body = await response.text()
+    if (!body.includes('Past Published Post')) {
+      throw new Error('Guest should see past-published post')
+    }
+
+    response = await http.actingAs(otherUser).get('/posts').assertStatus(200)
+    body = await response.text()
+    if (!body.includes('Past Published Post')) {
+      throw new Error('Other user should see past-published post')
+    }
+  })
+
+  it('search excludes scheduled posts from guests', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    await Post.forceCreate({
+      title: 'Scheduled Search Post',
+      excerpt: 'Searchable but hidden',
+      body: 'Hidden from search',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    const response = await http.query('/posts/search', {
+      keywords: ['Scheduled'],
+      limit: 10,
+    }).assertStatus(200)
+
+    const data = await response.json() as any
+    const found = (data?.data || []).some((post: any) => post.title === 'Scheduled Search Post')
+    if (found) {
+      throw new Error('Scheduled post should not appear in guest search')
+    }
+  })
+
+  it('search shows scheduled posts to their author', async () => {
+    const futureTime = new Date(Date.now() + 3600000).toISOString()
+
+    await Post.forceCreate({
+      title: 'Author Search Post',
+      excerpt: 'Author can find this',
+      body: 'Author search content',
+      authorId: author.id,
+      publishedAt: futureTime,
+    })
+
+    const response = await http.actingAs(author).query('/posts/search', {
+      keywords: ['Author'],
+      limit: 10,
+    }).assertStatus(200)
+
+    const data = await response.json() as any
+    const found = (data?.data || []).some((post: any) => post.title === 'Author Search Post')
+    if (!found) {
+      throw new Error('Author should find their scheduled post in search')
+    }
+  })
+
+})
