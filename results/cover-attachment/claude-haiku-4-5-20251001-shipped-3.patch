diff --git a/app/Services/AttachmentService.ts b/app/Services/AttachmentService.ts
new file mode 100644
index 0000000..5477554
--- /dev/null
+++ b/app/Services/AttachmentService.ts
@@ -0,0 +1,60 @@
+import { writeFile, unlink } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+const STORAGE_DIR = resolve(process.cwd(), 'storage')
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024
+
+export interface UploadedFile {
+  file: File
+  filename: string
+  size: number
+  type: string
+}
+
+export class AttachmentService {
+  static async saveAttachment(postId: number, uploadedFile: UploadedFile): Promise<AttachmentRecord> {
+    if (!ALLOWED_MIME_TYPES.includes(uploadedFile.type)) {
+      throw new Error('Invalid file type')
+    }
+
+    if (uploadedFile.size > MAX_FILE_SIZE) {
+      throw new Error('File too large')
+    }
+
+    const buffer = await uploadedFile.file.arrayBuffer()
+    const storagePath = `${postId}_${Date.now()}_${uploadedFile.filename}`
+    const fullPath = resolve(STORAGE_DIR, storagePath)
+
+    await writeFile(fullPath, Buffer.from(buffer))
+
+    const attachment = await Attachment.create({
+      postId,
+      filename: uploadedFile.filename,
+      mimeType: uploadedFile.type,
+      path: storagePath,
+    })
+
+    return attachment as AttachmentRecord
+  }
+
+  static async deleteAttachment(attachment: AttachmentRecord): Promise<void> {
+    try {
+      const fullPath = resolve(STORAGE_DIR, attachment.path)
+      await unlink(fullPath)
+    } catch {
+      // File might already be deleted, continue
+    }
+
+    await Attachment.delete({ id: attachment.id })
+  }
+
+  static getAttachmentPath(storagePath: string): string {
+    return resolve(STORAGE_DIR, storagePath)
+  }
+
+  static getAttachmentUrl(attachment: AttachmentRecord): string {
+    return `/attachments/${attachment.id}/${attachment.filename}`
+  }
+}
