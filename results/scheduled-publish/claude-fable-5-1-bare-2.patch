diff --git a/resources/js/lib/publishAt.ts b/resources/js/lib/publishAt.ts
new file mode 100644
index 0000000..3d6611e
--- /dev/null
+++ b/resources/js/lib/publishAt.ts
@@ -0,0 +1,32 @@
+// The "Publish at" field is a `datetime-local` input, whose value is the
+// browser's wall-clock time with no zone. The server only accepts ISO 8601
+// with a zone, so these convert at the edge in both directions.
+
+/** `datetime-local` value → ISO 8601 UTC for the request; null when blank. */
+export function localToIso(value: string | null | undefined): string | null {
+  if (!value) {
+    return null
+  }
+  const parsed = new Date(value)
+  // An unparsable value goes through as typed so the server's error shows
+  // under the field, rather than being silently dropped to "publish now".
+  return Number.isNaN(parsed.getTime()) ? value : parsed.toISOString()
+}
+
+/** ISO 8601 (or null) → `datetime-local` value in the browser's zone; '' when unset. */
+export function isoToLocal(value: string | null | undefined): string {
+  if (!value) {
+    return ''
+  }
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) {
+    return ''
+  }
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+/** True while a post's publish instant is still ahead. */
+export function isScheduled(publishedAt: string | null | undefined): boolean {
+  return Boolean(publishedAt) && new Date(publishedAt as string).getTime() > Date.now()
+}
