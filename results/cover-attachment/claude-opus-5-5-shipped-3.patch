+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 9, 9])
+
+function postForm(fields: Record<string, string | File>): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries({ title: 'Cover post', excerpt: 'Excerpt', body: 'Body', ...fields })) {
+    form.append(key, value)
+  }
+  return form
+}
+
+function image(bytes: Uint8Array<ArrayBuffer>, name: string, type: string): File {
+  return new File([bytes], name, { type })
+}
+
+async function coverRows(postId: number): Promise<number> {
+  return (await Attachment.where({ attachableType: 'Post', attachableId: String(postId) }).get()).length
+}
+
+async function storedFileContaining(bytes: Uint8Array, dir: string): Promise<boolean> {
+  const entries = await readdir(dir, { recursive: true, withFileTypes: true }).catch(() => [])
+  for (const entry of entries) {
+    if (!entry.isFile()) continue
+    const content = await readFile(join(entry.parentPath, entry.name))
+    if (Buffer.from(bytes).equals(content)) return true
+  }
+  return false
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'password123',
+    })) as UserRecord
+  })
+
+  async function showProps(id: number) {
+    const response = await http.get(`/posts/${id}`)
+    const { payload } = await readInertiaResponse(response.raw)
+    return payload.props as { post: { coverUrl: string | null } }
+  }
+
+  async function createPost(fields: Record<string, string | File>): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.post('/posts', postForm(fields))
+    response.assertRedirect()
+    return Number(response.headers.get('location')!.split('/').pop())
+  }
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+    const firstUrl = (await showProps(id)).post.coverUrl!
+    expect(firstUrl).toBeString()
+
+    const served = await http.get(firstUrl)
+    served.assertOk().assertHeader('content-type', 'image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+    expect(await storedFileContaining(PNG, 'storage')).toBe(true)
+    expect(await storedFileContaining(PNG, 'public')).toBe(false)
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${id}`, postForm({ cover: image(JPEG, 'new.jpg', 'image/jpeg') })).assertRedirect()
+    const secondUrl = (await showProps(id)).post.coverUrl!
+    expect(secondUrl).not.toBe(firstUrl)
+    await http.get(firstUrl).assertNotFound()
+    await http.get(secondUrl).assertOk().assertHeader('content-type', 'image/jpeg')
+    expect(await coverRows(id)).toBe(1)
+
+    await csrf.put(`/posts/${id}`, postForm({})).assertRedirect()
+    expect((await showProps(id)).post.coverUrl).not.toBeNull()
+
+    await csrf.put(`/posts/${id}`, postForm({ removeCover: '1' })).assertRedirect()
+    expect((await showProps(id)).post.coverUrl).toBeNull()
+    await http.get(secondUrl).assertNotFound()
+    expect(await coverRows(id)).toBe(0)
+
+    await csrf.put(`/posts/${id}`, postForm({ cover: image(PNG, 'again.png', 'image/png') })).assertRedirect()
+    const thirdUrl = (await showProps(id)).post.coverUrl!
+    await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+    await http.get(thirdUrl).assertNotFound()
+    expect(await coverRows(id)).toBe(0)
+  })
+
+  it('rejects a GIF or an oversized file on the cover field without saving', async () => {
+    const before = (await Post.all()).length
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.json().post('/posts', postForm({ cover: image(GIF, 'x.gif', 'image/gif') }))
+      .assertUnprocessable()
+      .assertJsonPath('errors.cover.0', 'The cover must be a PNG or JPEG image.')
+
+    const oversized = new Uint8Array(2 * 1024 * 1024 + 1)
+    oversized.set(PNG)
+    await csrf.json().post('/posts', postForm({ cover: image(oversized, 'big.png', 'image/png') })).assertUnprocessable()
+    expect((await Post.all()).length).toBe(before)
+
+    const id = await createPost({ cover: image(PNG, 'keep.png', 'image/png') })
+    const url = (await showProps(id)).post.coverUrl
+    await csrf.json().put(`/posts/${id}`, postForm({ cover: image(GIF, 'x.gif', 'image/gif') })).assertUnprocessable()
+    expect((await showProps(id)).post.coverUrl).toBe(url)
+    expect(await coverRows(id)).toBe(1)
+  })
+
+  it('lists posts with a coverUrl', async () => {
+    const id = await createPost({ cover: new File([], '') })
+    const { payload } = await readInertiaResponse((await http.get('/posts')).raw)
+    const listed = (payload.props.data as Array<{ id: number; coverUrl: string | null }>).find((post) => post.id === id)
+    expect(listed?.coverUrl).toBeNull()
+  })
+})
