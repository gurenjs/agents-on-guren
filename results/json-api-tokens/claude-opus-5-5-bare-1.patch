@@ -0,0 +1,29 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+// JSON posts API for scripts, authenticated by a personal bearer token
+// (see routes/api.ts). The session-based PostController serves the web pages.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    // Newest first; `id` breaks ties between posts created in the same millisecond.
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    const authorId = Number(this.apiTokenUserId())
+    // The same rules as the web form. The schema strips unknown keys, so an
+    // `authorId` in the body never reaches the model.
+    const data = await this.validateBody(PostPayloadSchema)
+    // forceCreate, because `authorId` is deliberately absent from Post.fillable.
+    const post = await Post.forceCreate({ ...data, authorId })
+
+    return this.created({ data: new PostResource(post).toJSON() })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..ed43b00
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,33 @@
+import { Controller, createApiToken, getUserApiTokens, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokens.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+// Personal API tokens, managed from the profile page by their signed-in owner.
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    // The only time the plain text leaves the server; only its hash is stored.
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Scoped to the owner's own tokens, so another user's id answers 404 and
+    // does not reveal whether it exists.
+    const owned = await getUserApiTokens(user.id, apiTokenStore)
+    if (!owned.some((token) => token.id === id)) {
+      return this.json({ message: 'Token not found.' }, { status: 404 })
+    }
+
+    await revokeApiToken(id, apiTokenStore)
+
+    return this.noContent()
+  }
+}
