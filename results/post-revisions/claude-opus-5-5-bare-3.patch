+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test database (NODE_ENV=test), which booting the
+// app migrates. Each test creates its own users and posts, so they neither
+// depend on nor disturb each other.
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Primed with a CSRF token so PUT/POST/DELETE pass like a browser's would.
+    http = await (await TestApp.fromApp(app)).withCsrf('/')
+  })
+
+  let sequence = 0
+  async function makeUser(): Promise<UserRecord> {
+    sequence += 1
+    return User.create({
+      name: `Author ${sequence}`,
+      email: `revisions-${Date.now()}-${sequence}@example.com`,
+      password: 'secret-password',
+    })
+  }
+
+  async function makePost(author: UserRecord, title: string): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+  }
+
+  function edit(author: UserRecord, post: PostRecord, title: string) {
+    return http
+      .actingAs(author)
+      .put(`/posts/${post.id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+  }
+
+  async function revisionTitles(post: PostRecord): Promise<string[]> {
+    const rows = await PostRevision.newQuery().where({ postId: post.id }).orderBy('id', 'desc').get()
+    return rows.map((row) => row.title)
+  }
+
+  it('keeps the previous version on every successful edit, and nothing on create', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'First')
+    expect(await revisionTitles(post)).toEqual([])
+
+    ;(await edit(author, post, 'Second')).assertRedirect(`/posts/${post.id}`)
+    ;(await edit(author, post, 'Third')).assertRedirect(`/posts/${post.id}`)
+
+    expect(await revisionTitles(post)).toEqual(['Second', 'First'])
+    const kept = await PostRevision.newQuery().where({ postId: post.id, title: 'First' }).firstOrFail()
+    expect(kept.excerpt).toBe('First excerpt')
+    expect(kept.body).toBe('First body')
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author, 'Original')
+
+    ;(await edit(other, post, 'Hijacked')).assertForbidden()
+    ;(await http.actingAs(author).put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' })).assertStatus(422)
+
+    expect(await revisionTitles(post)).toEqual([])
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'First')
+    await edit(author, post, 'Second')
+    await edit(author, post, 'Third')
+
+    const response = await http.actingAs(author).get(`/posts/${post.id}/revisions`)
+    response.assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const revisions = (payload.props as { revisions: { id: number; title: string; createdAt: string }[] }).revisions
+    expect(revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(typeof revisions[0]?.createdAt).toBe('string')
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'First')
+    await edit(author, post, 'Second')
+    await edit(author, post, 'Third')
+    const first = await PostRevision.newQuery().where({ postId: post.id, title: 'First' }).firstOrFail()
+
+    ;(await http.actingAs(author).post(`/posts/${post.id}/revisions/${first.id}/restore`)).assertRedirect(
+      `/posts/${post.id}`,
+    )
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users, redirects guests, and 404s a revision of another post', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author, 'Mine')
+    const sibling = await makePost(author, 'Sibling')
+    await edit(author, post, 'Mine v2')
+    await edit(author, sibling, 'Sibling v2')
+    const [revision] = await PostRevision.newQuery().where({ postId: post.id }).get()
+    const [siblingRevision] = await PostRevision.newQuery().where({ postId: sibling.id }).get()
+
+    ;(await http.actingAs(other).get(`/posts/${post.id}/revisions`)).assertForbidden()
+    ;(await http.actingAs(other).post(`/posts/${post.id}/revisions/${revision!.id}/restore`)).assertForbidden()
+    ;(await http.get(`/posts/${post.id}/revisions`)).assertRedirect('/login')
+    ;(await http.post(`/posts/${post.id}/revisions/${revision!.id}/restore`)).assertRedirect('/login')
+    ;(await http.actingAs(author).post(`/posts/${post.id}/revisions/${siblingRevision!.id}/restore`)).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine v2')
+    expect(await revisionTitles(post)).toEqual(['Mine'])
+    expect(await revisionTitles(sibling)).toEqual(['Sibling'])
+  })
+
+  it('deletes a post together with its revisions only', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'Doomed')
+    const keeper = await makePost(author, 'Keeper')
+    await edit(author, post, 'Doomed v2')
+    await edit(author, keeper, 'Keeper v2')
+
+    ;(await http.actingAs(author).delete(`/posts/${post.id}`)).assertRedirect('/posts')
+
+    expect(await revisionTitles(post)).toEqual([])
+    expect(await revisionTitles(keeper)).toEqual(['Keeper'])
+  })
+})
