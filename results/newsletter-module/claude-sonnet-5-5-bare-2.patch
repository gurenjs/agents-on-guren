+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module must stay liftable into another app: the blog may not
+// depend on it. The module is registered in src/app.ts, outside these layers.
+export default defineArchRules({
+  layers: {
+    app: 'app/**',
+    routes: 'routes/**',
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'app',
+      disallow: 'newsletter',
+      message: 'app/ must not import from modules/newsletter/; the module is self-contained.',
+    },
+    {
+      from: 'routes',
+      disallow: 'newsletter',
+      message: 'routes/ must not import from modules/newsletter/; the module is self-contained.',
+    },
+  ],
+})
