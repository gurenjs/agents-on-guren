@@ -0,0 +1,23 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Output is a contract for pipes: `<id>\t<title>\t<published_at>` per line on
+ * stdout and nothing else, so no header, summary or "nothing scheduled" note.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List scheduled posts, soonest first, as tab-separated lines'
+
+  async handle(): Promise<number> {
+    const posts = await Post.scheduled().get()
+
+    for (const post of posts) {
+      // A tab or line break inside a title would split the row for whatever reads it.
+      const title = post.title.replace(/[\t\r\n]+/g, ' ')
+      this.line(`${post.id}\t${title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
