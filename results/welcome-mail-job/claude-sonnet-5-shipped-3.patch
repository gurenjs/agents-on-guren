diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..8660244
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,84 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeMail, fakeQueue } from '@guren/testing'
+import { createMailManager, setMailManager, setQueueDriver } from '@guren/core'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { SendWelcomeEmailJob } from '../app/Jobs/SendWelcomeEmailJob.js'
+
+// FakeMail records at the transport level, so it has to be wired into a real
+// MailManager (whose `from` mirrors the app's mail config) rather than passed
+// to setMailManager() directly.
+function useFakeMail(mail: ReturnType<typeof fakeMail>): void {
+  const manager = createMailManager({
+    default: 'fake',
+    from: { email: 'hello@example.com', name: 'Guren' },
+  })
+  manager.registerTransport('fake', () => mail.getTransport())
+  setMailManager(manager)
+}
+
+// Registration must hand welcome-mail delivery off to the queue instead of
+// sending inline, so a slow/down mail provider never blocks sign-up. This
+// swaps in the fake queue driver and mail transport the same way a real
+// worker/mailer pair would be swapped in, dispatches through the real HTTP
+// route, then runs the queued job by hand the way a worker eventually would.
+describe('register.store', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('queues exactly one welcome email and sends nothing inline', async () => {
+    const queue = fakeQueue()
+    const mail = fakeMail()
+    setQueueDriver(queue.getDriver())
+    useFakeMail(mail)
+
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    queue.assertPushedTimes(SendWelcomeEmailJob, 1)
+    mail.assertNothingSent()
+
+    const [job] = queue.pushed(SendWelcomeEmailJob)
+    expect(job.payload).toEqual({ name: 'Ada Lovelace', email: 'ada@example.com' })
+
+    // Run the queued work the way a worker would.
+    const instance = new SendWelcomeEmailJob()
+    await instance.handle(job.payload)
+
+    mail.assertSentTimes(1)
+    mail.assertSentTo('ada@example.com')
+    mail.assertSentWithSubject('Welcome to Guren, Ada Lovelace!')
+    mail.assertSentWithBodyContaining('Ada Lovelace')
+  })
+
+  it('queues nothing when registration is refused', async () => {
+    const queue = fakeQueue()
+    const mail = fakeMail()
+    setQueueDriver(queue.getDriver())
+    useFakeMail(mail)
+
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/register', {
+        name: '',
+        email: 'not-an-email',
+        password: 'short',
+        passwordConfirmation: 'nope',
+      })
+      .assertStatus(422)
+
+    queue.assertNothingPushed()
+    mail.assertNothingSent()
+  })
+})
