new file mode 100644
index 0000000..c5a6c00
--- /dev/null
+++ b/tests/controllers/NewsletterController.test.ts
@@ -0,0 +1,109 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import app from '../../src/app.js'
+import { TestApp } from '@guren/testing'
+import { NewsletterSubscription } from '../../modules/newsletter/index.js'
+
+function randomToken(): string {
+  return Math.random().toString(36).substring(2, 18)
+}
+
+describe('NewsletterController', () => {
+  let http: TestApp
+  let csrf: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    csrf = await http.withCsrf()
+  })
+
+  test('subscribe with valid email creates subscription', async () => {
+    const email = `test-${randomToken()}@example.com`
+    const res = await csrf.json().post('/newsletter/subscribe', { email })
+    expect(res.status).toBeOneOf([302, 303])
+
+    const subscription = await NewsletterSubscription.first({ email })
+    expect(subscription).toBeDefined()
+    expect(subscription?.email).toBe(email)
+    expect(subscription?.token).toBeDefined()
+    expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    expect(subscription?.confirmedAt).toBeNull()
+  })
+
+  test('subscribe with invalid email returns 422', async () => {
+    const res = await csrf.json().post('/newsletter/subscribe', { email: 'not-an-email' })
+    expect(res.status).toBe(422)
+    const body = (await res.json()) as { errors: Record<string, unknown> }
+    expect(body.errors.email).toBeDefined()
+  })
+
+  test('subscribe with duplicate email returns 422', async () => {
+    const email = `duplicate-${randomToken()}@example.com`
+    const token = randomToken()
+    await NewsletterSubscription.create({
+      email,
+      token,
+    })
+
+    const res = await csrf.json().post('/newsletter/subscribe', { email })
+    expect(res.status).toBe(422)
+    const body = (await res.json()) as { errors: Record<string, unknown> }
+    expect(body.errors.email).toBeDefined()
+  })
+
+  test('confirm with valid token confirms subscription', async () => {
+    const subscription = await NewsletterSubscription.create({
+      email: `confirm-${randomToken()}@example.com`,
+      token: randomToken(),
+    })
+
+    const res = await http.get(`/newsletter/confirm/${subscription.token}`)
+    expect(res.status).toBeOneOf([302, 303])
+
+    const updated = await NewsletterSubscription.findOrFail(subscription.id)
+    expect(updated.confirmedAt).toBeDefined()
+    expect(updated.confirmedAt).not.toBeNull()
+  })
+
+  test('confirm with invalid token returns 404', async () => {
+    const res = await http.get(`/newsletter/confirm/invalid-token-${randomToken()}`)
+    expect(res.status).toBe(404)
+  })
+
+  test('unsubscribe with valid email deletes subscription', async () => {
+    const email = `unsubscribe-${randomToken()}@example.com`
+    const subscription = await NewsletterSubscription.create({
+      email,
+      token: randomToken(),
+    })
+
+    const res = await csrf.json().post('/newsletter/unsubscribe', { email })
+    expect(res.status).toBeOneOf([302, 303])
+
+    const deleted = await NewsletterSubscription.first({ id: subscription.id })
+    expect(deleted).toBeNull()
+  })
+
+  test('unsubscribe with nonexistent email succeeds silently', async () => {
+    const res = await csrf.json().post('/newsletter/unsubscribe', { email: `nonexistent-${randomToken()}@example.com` })
+    expect(res.status).toBeOneOf([302, 303])
+  })
+
+  test('subscribe respects referer header', async () => {
+    const email = `referer-${randomToken()}@example.com`
+    const csrfWithReferer = await csrf.withHeader('Referer', 'http://localhost:3333/some-page')
+    const res = await csrfWithReferer.json().post('/newsletter/subscribe', { email })
+
+    expect(res.status).toBeOneOf([302, 303])
+    const location = res.headers.get('Location')
+    expect(location).toContain('some-page')
+  })
+
+  test('subscribe defaults to root when no referer', async () => {
+    const email = `no-referer-${randomToken()}@example.com`
+    const res = await csrf.json().post('/newsletter/subscribe', { email })
+
+    expect(res.status).toBeOneOf([302, 303])
+    const location = res.headers.get('Location')
+    expect(location === '/' || location?.includes('/')).toBe(true)
+  })
+})
