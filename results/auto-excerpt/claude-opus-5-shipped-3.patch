+/**
+ * Excerpt derivation — writers may leave the excerpt blank, in which case the
+ * site writes one from the opening of the body.
+ */
+
+/** Longest excerpt derived from a body, before the ellipsis is appended. */
+const EXCERPT_LENGTH = 140
+
+/** U+2026, a single character — not three periods. */
+const ELLIPSIS = '…'
+
+function isWhitespace(character: string | undefined): boolean {
+  return character !== undefined && /\s/.test(character)
+}
+
+/**
+ * Build an excerpt from a post body: the whole body when it is short enough,
+ * otherwise its first 140 characters cut back to a word boundary and closed
+ * with an ellipsis.
+ */
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) {
+    return trimmed
+  }
+
+  let kept = trimmed.slice(0, EXCERPT_LENGTH)
+
+  // Only pull back when the cut would land inside a word — if character 141
+  // (or 140) is whitespace, the full 140 characters are already a clean break.
+  if (!isWhitespace(trimmed[EXCERPT_LENGTH - 1]) && !isWhitespace(trimmed[EXCERPT_LENGTH])) {
+    for (let index = EXCERPT_LENGTH - 1; index >= 0; index--) {
+      if (isWhitespace(kept[index])) {
+        kept = kept.slice(0, index)
+        break
+      }
+    }
+    // No whitespace at all in the first 140 characters: cut at 140.
+  }
+
+  return `${kept.trimEnd()}${ELLIPSIS}`
+}
+
+/**
+ * A provided excerpt always wins; a missing, empty, or whitespace-only one
+ * falls back to the body. The stored excerpt is never empty.
+ */
+export function resolveExcerpt(excerpt: string | undefined, body: string): string {
+  const provided = excerpt?.trim() ?? ''
+  return provided.length > 0 ? provided : deriveExcerpt(body)
+}
