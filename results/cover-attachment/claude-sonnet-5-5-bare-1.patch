diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..fe32ca1
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,73 @@
+import { mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+// Uploads live under storage/, never public/; the app serves them itself.
+const STORAGE_DIR = new URL('../../storage/covers/', import.meta.url).pathname
+
+const EXTENSIONS: Record<string, string> = { 'image/png': 'png', 'image/jpeg': 'jpg' }
+
+const PNG_MAGIC = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_MAGIC = [0xff, 0xd8, 0xff]
+
+function startsWith(bytes: Uint8Array, magic: number[]): boolean {
+  return magic.every((byte, index) => bytes[index] === byte)
+}
+
+export function coverUrl(attachment: AttachmentRecord | null | undefined): string | null {
+  return attachment ? `/covers/${attachment.id}` : null
+}
+
+/** Checks the bytes really are a PNG or JPEG; the declared type alone is client-controlled. */
+export async function readCover(file: File): Promise<{ bytes: Uint8Array; contentType: string }> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const contentType = startsWith(bytes, PNG_MAGIC) ? 'image/png' : startsWith(bytes, JPEG_MAGIC) ? 'image/jpeg' : null
+  if (!contentType || bytes.length > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image of at most 2 MB.' })
+  }
+  return { bytes, contentType }
+}
+
+export async function findCover(postId: number): Promise<AttachmentRecord | null> {
+  return (await Attachment.newQuery().where('postId', postId).first()) ?? null
+}
+
+export async function findCovers(postIds: number[]): Promise<Map<number, AttachmentRecord>> {
+  const map = new Map<number, AttachmentRecord>()
+  if (postIds.length === 0) return map
+  const rows = await Attachment.newQuery().whereIn('postId', postIds).get()
+  for (const row of rows) map.set(row.postId, row)
+  return map
+}
+
+export async function storeCover(postId: number, file: File): Promise<void> {
+  const { bytes, contentType } = await readCover(file)
+  // One cover per post: a new upload replaces (and deletes) the old one.
+  await removeCover(postId)
+  const id = crypto.randomUUID()
+  const path = `${id}.${EXTENSIONS[contentType]}`
+
+  await mkdir(STORAGE_DIR, { recursive: true })
+  await Bun.write(join(STORAGE_DIR, path), bytes)
+  try {
+    await Attachment.forceCreate({ id, postId, path, contentType, size: bytes.length })
+  } catch (error) {
+    await rm(join(STORAGE_DIR, path), { force: true })
+    throw error
+  }
+}
+
+export async function removeCover(postId: number): Promise<void> {
+  const rows = await Attachment.newQuery().where('postId', postId).get()
+  for (const row of rows) {
+    await Attachment.delete({ id: row.id })
+    await rm(join(STORAGE_DIR, row.path), { force: true })
+  }
+}
+
+export function coverFile(attachment: AttachmentRecord) {
+  return Bun.file(join(STORAGE_DIR, attachment.path))
+}
