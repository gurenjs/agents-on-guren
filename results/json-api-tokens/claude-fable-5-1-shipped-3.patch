@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { createUser, withToken, type IssuedToken } from './support/apiTokens.js'
+
+// The other token tests sign in through actingAs(). This one goes through the
+// login form and carries the cookies itself, which is how a browser — and the
+// profile page — reaches the token routes.
+describe('API tokens from a signed-in session', () => {
+  let http: TestApp
+  const cookies = new Map<string, string>()
+
+  async function send(method: string, path: string, body?: unknown): Promise<Response> {
+    const headers = new Headers({ Accept: 'application/json' })
+    if (cookies.size > 0) {
+      headers.set('Cookie', [...cookies].map(([name, value]) => `${name}=${value}`).join('; '))
+    }
+    const xsrf = cookies.get('XSRF-TOKEN')
+    if (xsrf) headers.set('X-XSRF-TOKEN', decodeURIComponent(xsrf))
+    if (body !== undefined) headers.set('Content-Type', 'application/json')
+
+    const response = await app.fetch(new Request(`http://localhost${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    }))
+    for (const cookie of response.headers.getSetCookie()) {
+      const [pair = ''] = cookie.split(';')
+      const separator = pair.indexOf('=')
+      cookies.set(pair.slice(0, separator), pair.slice(separator + 1))
+    }
+    return response
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    cookies.clear()
+  })
+
+  it('creates a token, uses it without cookies, and revokes it', async () => {
+    const user = await createUser('ada@example.com')
+    await send('GET', '/login')
+    const login = await send('POST', '/login', { email: user.email, password: 'password123' })
+    expect(login.status).toBeLessThan(400)
+
+    const created = await send('POST', '/profile/tokens', { name: 'CI' })
+    expect(created.status).toBe(201)
+    const issued = (await created.json()) as IssuedToken
+    expect(issued.name).toBe('CI')
+
+    const published = await withToken(http, issued.token).post('/api/posts', {
+      title: 'Release 1.2',
+      excerpt: 'What changed',
+      body: 'Notes.',
+    })
+    expect(published.status).toBe(201)
+    expect(await published.json<{ data: { authorId: number } }>()).toMatchObject({ data: { authorId: user.id } })
+
+    const revoked = await send('DELETE', `/profile/tokens/${issued.id}`)
+    expect(revoked.status).toBe(204)
+    await withToken(http, issued.token).get('/api/posts').assertUnauthorized()
+  })
+})
diff --git a/tests/PostApiController.test.ts b/tests/PostApiController.test.ts
new file mode 100644
index 0000000..e793478
--- /dev/null
+++ b/tests/PostApiController.test.ts
@@ -0,0 +1,183 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { API_TOKEN_RATE_LIMIT } from '../app/Http/Middleware/ThrottleApiTokenMiddleware.js'
+import { createUser, issueToken, withToken } from './support/apiTokens.js'
+
+interface PostJson {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+const payload = { title: 'Release 1.2', excerpt: 'What changed', body: 'Notes.' }
+
+describe('PostApiController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  describe('GET /api/posts', () => {
+    it('lists every post by every author, newest first', async () => {
+      const ada = await createUser('ada@example.com')
+      const grace = await createUser('grace@example.com')
+      await Post.forceCreate({ ...payload, title: 'Oldest', authorId: ada.id, createdAt: '2026-01-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...payload, title: 'Newest', authorId: grace.id, createdAt: '2026-03-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...payload, title: 'Middle', authorId: ada.id, createdAt: '2026-02-01T00:00:00.000Z' })
+      const { token } = await issueToken(http, ada)
+
+      const response = await withToken(http, token).get('/api/posts')
+
+      expect(response.status).toBe(200)
+      const { data } = await response.json<{ data: PostJson[] }>()
+      expect(data.map((post) => post.title)).toEqual(['Newest', 'Middle', 'Oldest'])
+      expect(data[0]).toMatchObject({
+        title: 'Newest',
+        excerpt: 'What changed',
+        authorId: grace.id,
+        createdAt: '2026-03-01T00:00:00.000Z',
+      })
+      expect(data[0]?.id).toBeNumber()
+    })
+
+    it('answers an empty list when there are no posts', async () => {
+      const user = await createUser('ada@example.com')
+      const { token } = await issueToken(http, user)
+
+      await withToken(http, token).get('/api/posts').assertOk().assertJson({ data: [] })
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it("creates the post as the token's owner", async () => {
+      const user = await createUser('ada@example.com')
+      const { token } = await issueToken(http, user)
+
+      const response = await withToken(http, token).post('/api/posts', payload)
+
+      expect(response.status).toBe(201)
+      const { data } = await response.json<{ data: PostJson }>()
+      expect(data).toMatchObject({ title: 'Release 1.2', excerpt: 'What changed', authorId: user.id })
+      expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+      const stored = await Post.findOrFail(data.id)
+      expect(stored.authorId).toBe(user.id)
+      expect(stored.body).toBe('Notes.')
+    })
+
+    it('ignores an authorId in the body', async () => {
+      const user = await createUser('ada@example.com')
+      const other = await createUser('grace@example.com')
+      const { token } = await issueToken(http, user)
+
+      const response = await withToken(http, token).post('/api/posts', { ...payload, authorId: other.id })
+
+      expect(response.status).toBe(201)
+      const { data } = await response.json<{ data: PostJson }>()
+      expect(data.authorId).toBe(user.id)
+      expect((await Post.findOrFail(data.id)).authorId).toBe(user.id)
+    })
+
+    it.each([
+      ['an empty title', { ...payload, title: '' }],
+      ['no body', { title: payload.title, excerpt: payload.excerpt }],
+      ['no excerpt', { title: payload.title, body: payload.body }],
+      ['an empty payload', {}],
+    ])('rejects %s with 422 and creates nothing', async (_label, body) => {
+      const user = await createUser('ada@example.com')
+      const { token } = await issueToken(http, user)
+
+      const response = await withToken(http, token).post('/api/posts', body)
+
+      expect(response.status).toBe(422)
+      expect(await response.json<Record<string, unknown>>()).toHaveProperty('errors')
+      expect(await Post.all()).toHaveLength(0)
+    })
+  })
+
+  describe('without a valid token', () => {
+    async function credentials(): Promise<Array<[string, string | null]>> {
+      const user = await createUser('ada@example.com')
+      const live = await issueToken(http, user, 'live')
+      const revoked = await issueToken(http, user, 'revoked')
+      const session = await http.actingAs(user).json().withCsrf()
+      await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+      const [id = '', secret = ''] = live.token.split('|')
+      const flipped = secret.startsWith('0') ? `1${secret.slice(1)}` : `0${secret.slice(1)}`
+
+      return [
+        ['no header', null],
+        ['another scheme', `Basic ${live.token}`],
+        ['an empty bearer', 'Bearer '],
+        ['a token without its id', `Bearer ${secret}`],
+        ['an unknown token', `Bearer ${'a'.repeat(32)}|${'b'.repeat(64)}`],
+        ['a tampered secret', `Bearer ${id}|${flipped}`],
+        ['a tampered id', `Bearer ${'f'.repeat(32)}|${secret}`],
+        ['a revoked token', `Bearer ${revoked.token}`],
+      ]
+    }
+
+    it('answers 401 with a JSON body on the list', async () => {
+      for (const [label, header] of await credentials()) {
+        const client = header === null ? http.json() : http.json().withHeader('Authorization', header)
+        const response = await client.get('/api/posts')
+
+        expect(response.status, label).toBe(401)
+        expect(await response.json<{ message: string }>(), label).toHaveProperty('message')
+      }
+    })
+
+    it('answers 401 on a write and creates nothing, even for an invalid payload', async () => {
+      for (const [label, header] of await credentials()) {
+        // A write without any bearer header is a cookie request to the CSRF
+        // middleware, which answers first with 403.
+        if (header === null || !/^Bearer\s+\S/.test(header)) continue
+        const client = http.json().withHeader('Authorization', header)
+
+        expect((await client.post('/api/posts', payload)).status, label).toBe(401)
+        expect((await client.post('/api/posts', {})).status, label).toBe(401)
+      }
+      expect(await Post.all()).toHaveLength(0)
+    })
+
+    it('does not accept a signed-in session in place of a token', async () => {
+      const user = await createUser('ada@example.com')
+
+      await http.actingAs(user).json().get('/api/posts').assertUnauthorized()
+    })
+  })
+
+  describe('rate limit', () => {
+    it('answers 429 with Retry-After on the 61st request, per token', async () => {
+      const user = await createUser('ada@example.com')
+      const first = await issueToken(http, user, 'first')
+      const second = await issueToken(http, user, 'second')
+      const client = withToken(http, first.token)
+
+      for (let request = 1; request <= API_TOKEN_RATE_LIMIT; request++) {
+        expect((await client.get('/api/posts')).status, `request ${request}`).toBe(200)
+      }
+      const limited = await client.get('/api/posts')
+
+      expect(limited.status).toBe(429)
+      expect(await limited.json<{ message: string }>()).toHaveProperty('message')
+      const retryAfter = Number(limited.headers.get('Retry-After'))
+      expect(Number.isInteger(retryAfter)).toBe(true)
+      expect(retryAfter).toBeGreaterThanOrEqual(1)
+      expect(retryAfter).toBeLessThanOrEqual(60)
+      expect((await client.post('/api/posts', payload)).status).toBe(429)
+      expect(await Post.all()).toHaveLength(0)
+
+      await withToken(http, second.token).get('/api/posts').assertOk()
+    })
+  })
+})
