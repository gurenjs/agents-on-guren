diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..14628bc
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,22 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+// Same name the framework's locale detection reads (its `cookieName` default),
+// so the cookie wins over Accept-Language on the next request.
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+    const referer = this.request.header('referer')
+    // The Referer is browser-set, but an absolute URL still gets the same
+    // origin check every other redirect target in the app gets.
+    const back = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(back, {
+      headers: {
+        'Set-Cookie': `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${ONE_YEAR_SECONDS}; SameSite=Lax`,
+      },
+    })
+  }
+}
diff --git a/app/Http/Validators/LocaleValidator.ts b/app/Http/Validators/LocaleValidator.ts
new file mode 100644
index 0000000..1136c2a
--- /dev/null
+++ b/app/Http/Validators/LocaleValidator.ts
@@ -0,0 +1,11 @@
+import { z } from 'zod'
+
+// Keep in step with `i18n.supported` in src/app.ts: a locale accepted here but
+// not listed there would be stored and then silently ignored by detection.
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export const LocaleSchema = z.object({
+  locale: z.enum(SUPPORTED_LOCALES),
+})
+
+export type Locale = (typeof SUPPORTED_LOCALES)[number]
