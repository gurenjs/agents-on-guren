diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..3472d62
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,81 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokenStore } from '../app/Support/ApiTokens.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  const idOf = (user: unknown) => Number((user as { id: unknown }).id)
+  const suffix = Math.random().toString(36).slice(2)
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await User.create({ name: 'Owner', email: `owner-${suffix}@example.com`, password: 'secret-pass' })
+    other = await User.create({ name: 'Other', email: `other-${suffix}@example.com`, password: 'secret-pass' })
+  })
+
+  async function session(user: unknown) {
+    return (await http.actingAs(user).withCsrf('/profile')).json()
+  }
+
+  async function mint(user: unknown, name = 'CI') {
+    const response = await (await session(user)).post('/profile/tokens', { name }).assertStatus(201)
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('rejects bad names and stores only a hash', async () => {
+    const s = await session(owner)
+    await s.post('/profile/tokens', {}).assertStatus(422)
+    await s.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await s.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+
+    const created = await mint(owner)
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await apiTokenStore.findByUserId(idOf(owner))
+    expect(rows.length).toBeGreaterThan(0)
+    expect(JSON.stringify(rows)).not.toContain(secret)
+  })
+
+  it('authenticates the API, scopes ownership and revokes', async () => {
+    const created = await mint(owner)
+
+    await bearer(created.token).get('/api/posts').assertStatus(200)
+    await http.json().get('/api/posts').assertStatus(401)
+    await bearer(`${created.token}x`).get('/api/posts').assertStatus(401)
+    await bearer('garbage').get('/api/posts').assertStatus(401)
+
+    const posted = await bearer(created.token)
+      .post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: idOf(other) })
+      .assertStatus(201)
+    expect(((await posted.json()) as { data: { authorId: number } }).data.authorId).toBe(idOf(owner))
+    await bearer(created.token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertStatus(422)
+
+    await (await session(other)).delete(`/profile/tokens/${created.id}`).assertStatus(404)
+    await bearer(created.token).get('/api/posts').assertStatus(200)
+
+    await (await session(owner)).delete(`/profile/tokens/${created.id}`).assertStatus(204)
+    await bearer(created.token).get('/api/posts').assertStatus(401)
+  })
+
+  it('rate limits per token', async () => {
+    const first = await mint(owner, 'one')
+    const second = await mint(owner, 'two')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertStatus(200)
+    }
+    const limited = await bearer(first.token).get('/api/posts').assertStatus(429)
+    const retryAfter = Number((await limited).headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertStatus(200)
+  })
+})
