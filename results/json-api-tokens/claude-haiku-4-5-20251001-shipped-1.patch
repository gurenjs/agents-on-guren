+++ b/tests/ProfileTokenController.test.ts
@@ -0,0 +1,95 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import app from '../src/app.js'
+import { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+describe('ProfileTokenController', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({
+      name: 'Test User',
+      email: `token-controller-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+  })
+
+  test('POST /profile/tokens creates a token for authenticated user', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf
+      .json()
+      .post('/profile/tokens', { name: 'My Token' })
+
+    expect(res.status).toBe(201)
+    const body = await res.json<{ id: number; name: string; token: string }>()
+    expect(body.name).toBe('My Token')
+    expect(body.token).toBeDefined()
+    expect(body.token.length).toBeGreaterThanOrEqual(16)
+
+    const token = await ApiToken.find(body.id)
+    expect(token).toBeDefined()
+    expect(token?.name).toBe('My Token')
+    expect(token?.userId).toBe(user.id)
+    expect(token?.hashedToken).not.toBe(body.token)
+  })
+
+  test('POST /profile/tokens returns 422 for empty name', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf
+      .json()
+      .post('/profile/tokens', { name: '' })
+
+    expect(res.status).toBe(422)
+  })
+
+  test('POST /profile/tokens returns 422 for name too long', async () => {
+    const longName = 'x'.repeat(51)
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf
+      .json()
+      .post('/profile/tokens', { name: longName })
+
+    expect(res.status).toBe(422)
+  })
+
+  test('DELETE /profile/tokens/:id deletes token', async () => {
+    const token = await ApiToken.create({
+      userId: user.id,
+      name: 'Token to Delete',
+      hashedToken: 'somehash',
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.delete(`/profile/tokens/${token.id}`)
+
+    expect(res.status).toBe(204)
+
+    const deleted = await ApiToken.find(token.id)
+    expect(deleted).toBeNull()
+  })
+
+  test('DELETE /profile/tokens/:id returns 404 for other users token', async () => {
+    const otherUser = await User.create({
+      name: 'Other User',
+      email: `other-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    const token = await ApiToken.create({
+      userId: otherUser.id,
+      name: 'Other Token',
+      hashedToken: 'somehash',
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.delete(`/profile/tokens/${token.id}`)
+
+    expect(res.status).toBe(404)
+
+    const exists = await ApiToken.find(token.id)
+    expect(exists).toBeDefined()
+  })
+})
diff --git a/tests/RateLimiting.test.ts b/tests/RateLimiting.test.ts
new file mode 100644
index 0000000..902a13b
--- /dev/null
+++ b/tests/RateLimiting.test.ts
@@ -0,0 +1,112 @@
+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import app from '../src/app.js'
+import { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { TokenService } from '../app/Services/TokenService.js'
+import { RateLimitService } from '../app/Services/RateLimitService.js'
+
+describe('Rate Limiting', () => {
+  let http: TestApp
+  let user: UserRecord
+  let token: string
+  let _tokenId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({
+      name: 'Test User',
+      email: `rate-limit-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    const { token: plainToken, hash } = TokenService.generateToken()
+    token = plainToken
+    const apiToken = await ApiToken.create({
+      userId: user.id,
+      name: 'Test Token',
+      hashedToken: hash,
+    })
+    _tokenId = apiToken.id
+  })
+
+  beforeEach(async () => {
+    RateLimitService.cleanup()
+  })
+
+  test('allows 60 requests per minute', async () => {
+    for (let i = 0; i < 60; i++) {
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .get('/api/posts')
+      expect(res.status).toBe(200)
+    }
+  })
+
+  test('returns 429 on 61st request', async () => {
+    for (let i = 0; i < 60; i++) {
+      await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .get('/api/posts')
+    }
+
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .get('/api/posts')
+
+    expect(res.status).toBe(429)
+  })
+
+  test('includes Retry-After header on rate limit', async () => {
+    for (let i = 0; i < 60; i++) {
+      await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .get('/api/posts')
+    }
+
+    const res = await http
+      .withHeader('Authorization', `Bearer ${token}`)
+      .json()
+      .get('/api/posts')
+
+    expect(res.status).toBe(429)
+    const retryAfter = res.headers.get('Retry-After')
+    expect(retryAfter).toBeDefined()
+    const seconds = parseInt(retryAfter || '0', 10)
+    expect(seconds).toBeGreaterThan(0)
+    expect(seconds).toBeLessThanOrEqual(60)
+  })
+
+  test('rate limits are per token, not per user', async () => {
+    const otherUser = await User.create({
+      name: 'Other User',
+      email: `rate-other-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    const { token: otherToken, hash: otherHash } = TokenService.generateToken()
+    await ApiToken.create({
+      userId: otherUser.id,
+      name: 'Other Token',
+      hashedToken: otherHash,
+    })
+
+    for (let i = 0; i < 60; i++) {
+      await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .get('/api/posts')
+    }
+
+    const res = await http
+      .withHeader('Authorization', `Bearer ${otherToken}`)
+      .json()
+      .get('/api/posts')
+
+    expect(res.status).toBe(200)
+  })
+})
