+/**
+ * Drafts are private to their author; everyone else — guests included — only
+ * ever sees published posts. Written as a `where(callback)` group so it AND-s
+ * with the rest of a query (keyword matching, pagination) instead of widening
+ * it. Pass `null` for a guest.
+ */
+export function visibleToViewer(viewerId: number | null): WhereGroupCallback<PostRecord> {
+  return (q) => {
+    q.where('published', true)
+    if (viewerId !== null) {
+      q.orWhere('authorId', viewerId)
+    }
+  }
