diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..7d3bb39
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,72 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Database } from 'bun:sqlite'
+import { User } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = (await User.first()) as { id: number }
+    session = (await http.withCsrf()).actingAs(user).json()
+  })
+
+  let session: TestApp
+
+  const mint = async (name: string) => {
+    const res = await session.post('/profile/tokens', { name })
+    res.assertCreated()
+    return (await res.json()) as { id: string; name: string; token: string }
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+  const call = async (method: 'get' | 'post', token: string, body?: unknown) =>
+    method === 'get' ? bearer(token).get('/api/posts') : bearer(token).post('/api/posts', body)
+
+  it('creates tokens, storing only a hash, and authenticates the API', async () => {
+    const created = await mint('CI')
+    const secret = created.token.split('|')[1]!
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+    const sqlite = new Database(process.env.TEST_DATABASE_URL || './data/guren.test.db', { readonly: true })
+    const rows = sqlite.query('select * from api_tokens').all()
+    sqlite.close()
+    expect(rows.length).toBeGreaterThan(0)
+    expect(JSON.stringify(rows)).not.toContain(secret)
+
+    ;(await call('get', created.token)).assertOk()
+    const post = await call('post', created.token, { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    post.assertCreated()
+    expect(((await post.json()) as { data: { authorId: number } }).data.authorId).toBe(user.id)
+    ;(await call('post', created.token, { title: '', excerpt: 'E', body: 'B' })).assertUnprocessable()
+  })
+
+  it('rejects bad tokens and revoked tokens', async () => {
+    const a = await mint('a')
+    const b = await mint('b')
+    ;(await call('get', `${a.token}x`)).assertUnauthorized()
+    ;(await call('get', 'nope')).assertUnauthorized()
+    expect((await session.delete(`/profile/tokens/${a.id}`)).status).toBe(204)
+    ;(await call('get', a.token)).assertUnauthorized()
+    ;(await call('get', b.token)).assertOk()
+    expect((await session.delete('/profile/tokens/nonexistent')).status).toBe(404)
+  })
+
+  it('validates names', async () => {
+    for (const name of ['', 'x'.repeat(51)]) {
+      expect((await session.post('/profile/tokens', { name })).status).toBe(422)
+    }
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const a = await mint('rl-a')
+    const b = await mint('rl-b')
+    for (let i = 0; i < 60; i++) (await call('get', a.token)).assertOk()
+    const limited = await call('get', a.token)
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    ;(await call('get', b.token)).assertOk()
+  })
+})
