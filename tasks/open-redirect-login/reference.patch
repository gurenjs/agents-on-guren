+/**
+ * Only a same-origin path (`/posts/3/edit`) may be used as a post-login
+ * destination. Absolute URLs, protocol-relative `//host` forms and backslash
+ * variants (browsers read `/\host` as `//host`) are rejected so the login
+ * page cannot be used to bounce users to another site.
+ */
+function safeRedirectPath(candidate: string | undefined): string | null {
+  if (!candidate || !candidate.startsWith('/') || /[\\\s]/.test(candidate)) return null
+  try {
+    const url = new URL(candidate, 'http://app.invalid')
+    if (url.origin !== 'http://app.invalid') return null
+    return url.pathname + url.search + url.hash
+  } catch {
+    return null
+  }
+}
