diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..531075b
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,260 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+  let testUser: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const uniqueId = Date.now()
+    testUser = await User.create({
+      name: 'Test User',
+      email: `test-${uniqueId}@example.com`,
+      password: 'password123',
+    })
+    await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: testUser.id,
+    })
+  })
+
+  describe('POST /profile/tokens (create token)', () => {
+    it('requires authentication', async () => {
+      await http.post('/profile/tokens', { name: 'Token 1' }).assertStatus(403)
+    })
+
+    it('validates token name', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+      await csrf.json().post('/profile/tokens', { name: 'a'.repeat(51) }).assertUnprocessable()
+    })
+
+    it('creates a token and returns it', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const res = await csrf.json().post('/profile/tokens', { name: 'My Token' }).assertCreated()
+      const body = await res.json<{ id: number; name: string; token: string }>()
+
+      expect(body.id).toBeDefined()
+      expect(body.name).toBe('My Token')
+      expect(body.token).toBeDefined()
+      expect(body.token.length).toBeGreaterThanOrEqual(32)
+
+      const stored = await ApiToken.find(body.id)
+      expect(stored).toBeDefined()
+      expect(stored?.name).toBe('My Token')
+      expect(stored?.userId).toBe(testUser.id)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id (revoke token)', () => {
+    it('requires authentication', async () => {
+      await http.delete('/profile/tokens/1').assertStatus(403)
+    })
+
+    it('returns 404 for non-existent token', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      await csrf.json().delete('/profile/tokens/99999').assertNotFound()
+    })
+
+    it('returns 404 for other user\'s token', async () => {
+      const otherUser = await User.create({
+        name: 'Other User',
+        email: `other-${Date.now()}@example.com`,
+        password: 'password123',
+      })
+      const token = await ApiToken.forceCreate({
+        userId: otherUser.id,
+        name: 'Other Token',
+        tokenHash: 'hash',
+      })
+
+      const csrf = await http.actingAs(testUser).withCsrf()
+      await csrf.json().delete(`/profile/tokens/${token.id}`).assertNotFound()
+    })
+
+    it('revokes a token', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'Token to Revoke' }).assertCreated()
+      const { id } = await createRes.json<{ id: number }>()
+
+      const deleteRes = await csrf.json().delete(`/profile/tokens/${id}`)
+      expect(deleteRes.status).toBe(204)
+
+      const revoked = await ApiToken.find(id)
+      expect(revoked?.revokedAt).toBeDefined()
+    })
+  })
+
+  describe('GET /api/posts (list posts)', () => {
+    it('requires bearer token', async () => {
+      await http.get('/api/posts').assertStatus(401)
+      await http.withHeader('Authorization', 'Bearer invalid').get('/api/posts').assertStatus(401)
+    })
+
+    it('returns posts', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .get('/api/posts')
+        .assertOk()
+
+      const body = await res.json<{ data: Array<any> }>()
+      expect(body.data).toBeInstanceOf(Array)
+      expect(body.data.length).toBeGreaterThan(0)
+      expect(body.data[0]).toHaveProperty('id')
+      expect(body.data[0]).toHaveProperty('title')
+      expect(body.data[0]).toHaveProperty('excerpt')
+      expect(body.data[0]).toHaveProperty('authorId')
+      expect(body.data[0]).toHaveProperty('createdAt')
+    })
+
+    it('returns posts newest first', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token 2' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      const newPost = await Post.forceCreate({
+        title: 'Newest Post',
+        excerpt: 'New excerpt',
+        body: 'New body',
+        authorId: testUser.id,
+      })
+
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .get('/api/posts')
+        .assertOk()
+
+      const body = await res.json<{ data: Array<any> }>()
+      expect(body.data[0].id).toBe(newPost.id)
+    })
+  })
+
+  describe('POST /api/posts (create post)', () => {
+    it('requires bearer token', async () => {
+      await http
+        .json()
+        .post('/api/posts', { title: 'Test', excerpt: 'Test', body: 'Test' })
+        .assertStatus(403)
+    })
+
+    it('validates input', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token 3' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .post('/api/posts', { title: '' })
+
+      expect(res.status).toBe(422)
+    })
+
+    it('creates a post with bearer token', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token 4' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .post('/api/posts', {
+          title: 'API Created Post',
+          excerpt: 'Created via API',
+          body: 'Full body text',
+        })
+        .assertCreated()
+
+      const body = await res.json<{ data: any }>()
+      expect(body.data.id).toBeDefined()
+      expect(body.data.title).toBe('API Created Post')
+      expect(body.data.authorId).toBe(testUser.id)
+      expect(body.data.createdAt).toBeDefined()
+    })
+
+    it('ignores authorId in request body', async () => {
+      const otherUser = await User.create({
+        name: 'Another User',
+        email: `another-${Date.now()}@example.com`,
+        password: 'password123',
+      })
+
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token 5' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      const res = await http
+        .withHeader('Authorization', `Bearer ${token}`)
+        .json()
+        .post('/api/posts', {
+          title: 'Ignore Author ID',
+          excerpt: 'Test',
+          body: 'Body',
+          authorId: otherUser.id,
+        })
+        .assertCreated()
+
+      const body = await res.json<{ data: any }>()
+      expect(body.data.authorId).toBe(testUser.id)
+    })
+  })
+
+  describe('Rate limiting', () => {
+    it('allows 60 requests per minute per token', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'Rate Limit Test' }).assertCreated()
+      const { token } = await createRes.json<{ token: string }>()
+
+      for (let i = 0; i < 60; i++) {
+        const res = await http.withHeader('Authorization', `Bearer ${token}`).get('/api/posts')
+        expect(res.status).toBe(200)
+      }
+
+      const over = await http.withHeader('Authorization', `Bearer ${token}`).get('/api/posts')
+      expect(over.status).toBe(429)
+      expect(over.headers.get('Retry-After')).toBeDefined()
+    })
+
+    it('limits per token not per user', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+
+      const token1Res = await csrf.json().post('/profile/tokens', { name: 'Token 1' }).assertCreated()
+      const { token: token1 } = await token1Res.json<{ token: string }>()
+
+      const token2Res = await csrf.json().post('/profile/tokens', { name: 'Token 2' }).assertCreated()
+      const { token: token2 } = await token2Res.json<{ token: string }>()
+
+      for (let i = 0; i < 60; i++) {
+        await http.withHeader('Authorization', `Bearer ${token1}`).get('/api/posts').assertOk()
+      }
+
+      await http.withHeader('Authorization', `Bearer ${token1}`).get('/api/posts').assertStatus(429)
+      await http.withHeader('Authorization', `Bearer ${token2}`).get('/api/posts').assertOk()
+    })
+  })
+
+  describe('Revoked token handling', () => {
+    it('stops working after revocation', async () => {
+      const csrf = await http.actingAs(testUser).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'Revokable Token' }).assertCreated()
+      const { id, token } = await createRes.json<{ id: number; token: string }>()
+
+      await http.withHeader('Authorization', `Bearer ${token}`).get('/api/posts').assertOk()
+
+      await csrf.json().delete(`/profile/tokens/${id}`).assertNoContent()
+
+      await http.withHeader('Authorization', `Bearer ${token}`).get('/api/posts').assertStatus(401)
+    })
+  })
+})
