+++ b/tests/LoginController.test.ts
@@ -0,0 +1,69 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// The login page accepts a `redirect` query/body value so a user lands back
+// on the page that asked them to sign in. It must only ever point back into
+// this app — never off-origin — or an attacker can phish with a link like
+// /login?redirect=https://evil.example that ends on a real login page but
+// hands the user to a look-alike site after they authenticate.
+describe('login redirect handling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-password' })
+  })
+
+  it('sends the user to the default destination with no redirect value', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-password' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('honors an in-app path', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-password', redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('ignores an absolute URL to another origin', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-password', redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a protocol-relative URL', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-password', redirect: '//evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores backslash variants that browsers treat as protocol-relative', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-password', redirect: '/\\evil.example' })
+      .assertRedirect('/dashboard')
+    const csrf2 = await http.withCsrf()
+    await csrf2
+      .post('/login', { email: 'ada@example.com', password: 'correct-password', redirect: '\\/evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('still rejects an invalid password even with a malicious redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'wrong-password', redirect: 'https://evil.example' })
+      .assertUnprocessable()
+  })
+})
