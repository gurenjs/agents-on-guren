@@ -0,0 +1,277 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface ShownComment {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let post: PostRecord
+
+  function createUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name.toLowerCase()}@example.com`, password: 'secret-password' })
+  }
+
+  function createComment(body: string, user: UserRecord = commenter, createdAt?: string): Promise<{ id: number }> {
+    return Comment.forceCreate({ body, postId: post.id, userId: user.id, ...(createdAt ? { createdAt } : {}) })
+  }
+
+  async function shownComments(client: TestApp = http): Promise<ShownComment[]> {
+    const response = await client.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`)
+    response.assertOk()
+    const page = await response.json<{ component: string; props: { comments: ShownComment[] } }>()
+    expect(page.component).toBe('posts/Show')
+    return page.props.comments
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    postAuthor = await createUser('Ada')
+    commenter = await createUser('Grace')
+    post = await Post.forceCreate({ title: 'Hello', excerpt: 'First', body: 'Post body', authorId: postAuthor.id })
+  })
+
+  describe('store', () => {
+    it('sends a guest to the login page and stores nothing', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Nice post' }).assertRedirect('/login')
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('stores the comment for the signed-in user and redirects to the post', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Nice post' }).assertRedirect(`/posts/${post.id}`)
+
+      const stored = await Comment.all()
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ postId: post.id, userId: commenter.id, body: 'Nice post' })
+    })
+
+    it('lets the author of a post comment on it', async () => {
+      const csrf = await http.actingAs(postAuthor).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Thanks for reading' }).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.where({ userId: postAuthor.id }).count()).toBe(1)
+    })
+
+    it('ignores an author or post sent in the request', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Nice post', userId: postAuthor.id, postId: 999 })
+
+      const stored = await Comment.all()
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ postId: post.id, userId: commenter.id })
+    })
+
+    it.each([
+      ['a missing body', {}],
+      ['an empty body', { body: '' }],
+      ['a blank body', { body: '   ' }],
+      ['a body over 2000 characters', { body: 'a'.repeat(2001) }],
+    ])('rejects %s and stores nothing', async (_label, payload) => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.json().post(`/posts/${post.id}/comments`, payload).assertUnprocessable()
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('accepts a body of exactly 2000 characters', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'a'.repeat(2000) }).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.all()).toHaveLength(1)
+    })
+
+    it('answers 404 for a post that does not exist', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post('/posts/999/comments', { body: 'Nice post' }).assertNotFound()
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+  })
+
+  describe('destroy', () => {
+    it('sends a guest to the login page and keeps the comment', async () => {
+      const comment = await createComment('Nice post')
+
+      const csrf = await http.withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect('/login')
+
+      expect(await Comment.find(comment.id)).not.toBeNull()
+    })
+
+    it('lets the author of the comment delete it, reports included', async () => {
+      const comment = await createComment('Nice post')
+      await CommentReport.forceCreate({ commentId: comment.id, userId: postAuthor.id })
+
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.find(comment.id)).toBeNull()
+      expect(await CommentReport.all()).toHaveLength(0)
+    })
+
+    it('lets the author of the post delete it', async () => {
+      const comment = await createComment('Nice post')
+
+      const csrf = await http.actingAs(postAuthor).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.find(comment.id)).toBeNull()
+    })
+
+    it('answers 403 to anyone else and keeps the comment', async () => {
+      const comment = await createComment('Nice post')
