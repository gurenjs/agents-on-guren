--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,161 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let counter = 0
+
+async function makeUser(name: string): Promise<UserRecord> {
+  counter += 1
+  const user = await User.create({ name, email: `${name.toLowerCase()}-${counter}@example.com`, password: 'secret' })
+  return user as UserRecord
+}
+
+async function makePost(authorId: number) {
+  const post = await Post.forceCreate({ title: 'A post', excerpt: 'Excerpt', body: 'Body', authorId })
+  if (!post) {
+    throw new Error('post not created')
+  }
+  return post
+}
+
+interface ShowProps {
+  post: { id: number }
+  comments: Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }>
+}
+
+async function showProps(http: TestApp, postId: number): Promise<ShowProps> {
+  const res = await http.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${postId}`)
+  res.assertOk()
+  const page = await res.json<{ props: ShowProps }>()
+  return page.props
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await makeUser('Author')
+    reader = await makeUser('Reader')
+    stranger = await makeUser('Stranger')
+    postId = (await makePost(author.id)).id
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${postId}/comments`, { body: 'Hello' }).assertRedirect('/login')
+    expect(await Comment.newQuery().count()).toBe(0)
+  })
+
+  it('stores a signed-in user comment and lists it oldest first with its author', async () => {
+    const asReader = await http.actingAs(reader).withCsrf()
+    await asReader.post(`/posts/${postId}/comments`, { body: 'First' }).assertRedirect(`/posts/${postId}`)
+    const asAuthor = await http.actingAs(author).withCsrf()
+    await asAuthor.post(`/posts/${postId}/comments`, { body: 'Second' }).assertRedirect(`/posts/${postId}`)
+
+    const { comments, post } = await showProps(http, postId)
+    expect(post.id).toBe(postId)
+    expect(comments.map((c) => c.body)).toEqual(['First', 'Second'])
+    expect(comments[0]?.author).toEqual({ id: reader.id, name: 'Reader' })
+    expect(Number.isNaN(Date.parse(comments[0]?.createdAt ?? ''))).toBe(false)
+  })
+
+  it('rejects an empty or oversized body with 422 and stores nothing', async () => {
+    const asReader = await http.actingAs(reader).withCsrf()
+    await asReader.json().post(`/posts/${postId}/comments`, { body: '   ' }).assertUnprocessable()
+    await asReader.json().post(`/posts/${postId}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    await asReader.json().post(`/posts/${postId}/comments`, {}).assertUnprocessable()
+    expect(await Comment.newQuery().count()).toBe(0)
+  })
+
+  it('404s when the post does not exist', async () => {
+    const asReader = await http.actingAs(reader).withCsrf()
+    await asReader.post('/posts/9999/comments', { body: 'Hello' }).assertNotFound()
+  })
+
+  it('lets the comment author delete it', async () => {
+    const comment = await Comment.forceCreate({ body: 'Mine', postId, userId: reader.id })
+    const asReader = await http.actingAs(reader).withCsrf()
+    await asReader.delete(`/comments/${comment!.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.find(comment!.id)).toBeNull()
+  })
+
+  it('lets the post author delete any comment on the post', async () => {
+    const comment = await Comment.forceCreate({ body: 'Theirs', postId, userId: reader.id })
+    const asAuthor = await http.actingAs(author).withCsrf()
+    await asAuthor.delete(`/comments/${comment!.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.find(comment!.id)).toBeNull()
+  })
+
+  it('forbids anyone else from deleting and keeps the comment', async () => {
+    const comment = await Comment.forceCreate({ body: 'Theirs', postId, userId: reader.id })
+    const asStranger = await http.actingAs(stranger).withCsrf()
+    await asStranger.delete(`/comments/${comment!.id}`).assertForbidden()
+    expect(await Comment.find(comment!.id)).not.toBeNull()
+  })
+
+  it('redirects a guest deleting a comment to login', async () => {
+    const comment = await Comment.forceCreate({ body: 'Theirs', postId, userId: reader.id })
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/comments/${comment!.id}`).assertRedirect('/login')
+    expect(await Comment.find(comment!.id)).not.toBeNull()
+  })
+
+  it('answers 204 to a report and counts a repeat by the same user once', async () => {
+    const comment = await Comment.forceCreate({ body: 'Spam', postId, userId: reader.id })
+    const asStranger = await http.actingAs(stranger).withCsrf()
+    await asStranger.post(`/comments/${comment!.id}/report`).assertNoContent()
+    await asStranger.post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment!.id }).count()).toBe(1)
+  })
+
+  it('hides a comment from the page after three distinct reporters but keeps the row', async () => {
+    const comment = await Comment.forceCreate({ body: 'Spam', postId, userId: reader.id })
+    const kept = await Comment.forceCreate({ body: 'Fine', postId, userId: reader.id })
+    const reporters = [author, stranger, await makeUser('Fourth')]
+
+    for (const reporter of reporters.slice(0, 2)) {
+      const client = await http.actingAs(reporter).withCsrf()
+      await client.post(`/comments/${comment!.id}/report`).assertNoContent()
+    }
+    expect((await showProps(http, postId)).comments.map((c) => c.id)).toEqual([comment!.id, kept!.id])
+
+    const third = await http.actingAs(reporters[2]!).withCsrf()
+    await third.post(`/comments/${comment!.id}/report`).assertNoContent()
+
+    expect((await showProps(http.actingAs(reader), postId)).comments.map((c) => c.id)).toEqual([kept!.id])
+    expect((await showProps(http.actingAs(author), postId)).comments.map((c) => c.id)).toEqual([kept!.id])
+    expect(await Comment.find(comment!.id)).not.toBeNull()
+  })
+
+  it('redirects a guest reporting to login', async () => {
+    const comment = await Comment.forceCreate({ body: 'Spam', postId, userId: reader.id })
+    const csrf = await http.withCsrf()
+    await csrf.post(`/comments/${comment!.id}/report`).assertRedirect('/login')
+    expect(await CommentReport.newQuery().count()).toBe(0)
+  })
+
+  it('removes comments and reports along with the post', async () => {
+    const comment = await Comment.forceCreate({ body: 'Bye', postId, userId: reader.id })
+    await CommentReport.forceCreate({ commentId: comment!.id, userId: stranger.id })
+
+    const asAuthor = await http.actingAs(author).withCsrf()
+    await asAuthor.delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    expect(await Comment.where({ postId }).count()).toBe(0)
+    expect(await CommentReport.where({ commentId: comment!.id }).count()).toBe(0)
+  })
+})
