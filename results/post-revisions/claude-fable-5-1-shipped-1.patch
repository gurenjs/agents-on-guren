@@ -0,0 +1,136 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface RevisionsPage {
+  component: string
+  props: { revisions: Array<{ id: number; title: string; createdAt: string }> }
+}
+
+async function createUser(email: string): Promise<UserRecord> {
+  return User.create({ name: email.split('@')[0] ?? email, email, password: 'secret-pass' })
+}
+
+async function createPost(author: UserRecord, title: string): Promise<PostRecord> {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+}
+
+function content(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+describe('PostRevisionController', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let post: PostRecord
+  // Primed as the author, so every mutating request carries that session's CSRF token.
+  let asAuthor: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await createUser('author@example.com')
+    other = await createUser('other@example.com')
+    post = await createPost(author, 'First')
+    asAuthor = await http.actingAs(author).withCsrf()
+  })
+
+  function edit(title: string) {
+    return asAuthor.put(`/posts/${post.id}`, content(title))
+  }
+
+  async function listRevisions(user: UserRecord = author) {
+    const response = await http.actingAs(user).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+    return response.json<RevisionsPage>()
+  }
+
+  it('keeps the previous version on every successful edit, newest first', async () => {
+    await edit('Second').assertRedirect(`/posts/${post.id}`)
+    await edit('Third').assertRedirect(`/posts/${post.id}`)
+
+    const page = await listRevisions()
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    for (const revision of page.props.revisions) {
+      expect(typeof revision.id).toBe('number')
+      expect(new Date(revision.createdAt).toISOString()).toBe(revision.createdAt)
+    }
+
+    const rows = await PostRevision.where({ postId: post.id }).get()
+    expect(rows).toHaveLength(2)
+    expect(rows.find((row) => row.title === 'First')?.body).toBe('First body')
+  })
+
+  it('keeps nothing on create or on a refused edit', async () => {
+    await asAuthor.post('/posts', content('Fresh')).assertRedirect()
+    await asAuthor.put(`/posts/${post.id}`, { title: '' }).assertUnprocessable()
+    const asOther = await http.actingAs(other).withCsrf()
+    await asOther.put(`/posts/${post.id}`, content('Stolen')).assertForbidden()
+
+    expect(await PostRevision.newQuery().count()).toBe(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    await edit('Second')
+    await edit('Third')
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+
+    await asAuthor.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.excerpt).toBe('First excerpt')
+    expect(restored.body).toBe('First body')
+
+    const page = await listRevisions()
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and redirects guests without changing anything', async () => {
+    await edit('Second')
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+    const restorePath = `/posts/${post.id}/revisions/${revision.id}/restore`
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const otherCsrf = await http.actingAs(other).withCsrf()
+    await otherCsrf.post(restorePath).assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const guestCsrf = await http.withCsrf()
+    await guestCsrf.post(restorePath).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await PostRevision.where({ postId: post.id }).count()).toBe(1)
+  })
+
+  it('answers 404 for a revision that belongs to another post by the same author', async () => {
+    const sibling = await createPost(author, 'Sibling')
+    await asAuthor.put(`/posts/${sibling.id}`, content('Sibling two'))
+    const foreign = await PostRevision.where({ postId: sibling.id }).firstOrFail()
+
+    await asAuthor.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect(await PostRevision.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const sibling = await createPost(author, 'Sibling')
+    await edit('Second')
+    await asAuthor.put(`/posts/${sibling.id}`, content('Sibling two'))
+
+    await asAuthor.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await PostRevision.where({ postId: post.id }).count()).toBe(0)
+    expect(await PostRevision.where({ postId: sibling.id }).count()).toBe(1)
+  })
+})
