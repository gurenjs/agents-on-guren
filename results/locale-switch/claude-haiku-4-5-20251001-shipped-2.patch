diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..243194b
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,42 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('LocaleController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('accepts valid locale and sets cookie', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', { locale: 'ja' }).assertRedirect().assertCookie('locale', 'ja')
+  })
+
+  it('rejects invalid locale', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', { locale: 'fr' }).assertUnprocessable()
+  })
+
+  it('rejects missing locale field', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/locale', {}).assertUnprocessable()
+  })
+
+  it('redirects to referer on valid locale', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .withHeader('referer', '/posts')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('/posts')
+  })
+
+  it('redirects to / when referer is unsafe', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .withHeader('referer', 'http://evil.com/page')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+})
