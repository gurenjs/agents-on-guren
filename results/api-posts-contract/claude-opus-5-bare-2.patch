index 0000000..7697f08
--- /dev/null
+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,48 @@
+import { Controller, paginate } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../../Validators/PostValidator.js'
+
+const PER_PAGE = 10
+
+// Public JSON feed of posts — no session, no CSRF token. Kept apart from the
+// Inertia PostController because nothing here renders a page: partners read it
+// straight, and our own front-end reaches it through the generated client.
+export default class PostController extends Controller {
+  async index(): Promise<Response> {
+    // The same schema the route declares as its query contract. The router
+    // records it for codegen and `guren audit`; validating here is what turns
+    // a bad ?page= or ?author= into a 422 before the database is touched.
+    const { page, author } = this.validateQuery(ApiListPostsQuerySchema)
+
+    // Counted and sliced by hand rather than through `paginate({ page })`,
+    // which resolves no eager loads — the partner contract requires `author`
+    // on every post, so the listing query has to be the one carrying `with()`.
+    const total = await this.postsBy(author).count()
+    const posts = await this.postsBy(author)
+      .with('author')
+      .orderBy('id', 'desc')
+      .limit(PER_PAGE)
+      .offset((page - 1) * PER_PAGE)
+      .get()
+
+    // The filter rides along in the page links, or paging a filtered feed
+    // would silently drop back to every author.
+    const paginator = paginate(posts, total, PER_PAGE, page, {
+      path: this.request.path ?? '/api/posts',
+      query: author !== undefined ? { author: String(author) } : undefined,
+    })
+
+    return this.json({
+      data: PostResource.collection(posts),
+      meta: paginator.meta(),
+      links: paginator.links(),
+    })
+  }
+
+  /** A fresh builder per call: `count()` must not see the listing's limit/offset. */
+  private postsBy(author?: number) {
+    const query = Post.newQuery()
+    return author === undefined ? query : query.where('authorId', author)
+  }
+}
