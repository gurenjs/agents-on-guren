+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The test database persists between runs, so every fixture gets a unique
+// email; posts are looked up by id, never by title.
+const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+async function createUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: `${label} ${runId}`,
+    email: `${label}-${runId}@example.com`,
+    password: 'secret-password',
+  })
+  if (!user) throw new Error('User.create returned null')
+  return user
+}
+
+async function createPost(author: UserRecord, title: string): Promise<PostRecord> {
+  const post = await Post.forceCreate({
+    title,
+    excerpt: `${title} excerpt`,
+    body: `${title} body`,
+    authorId: author.id,
+  })
+  if (!post) throw new Error('Post.forceCreate returned null')
+  return post
+}
+
+function payload(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function revisionsOf(postId: number) {
+  return PostRevision.newQuery().where('postId', postId).orderBy('id', 'desc').get()
+}
+
+async function revisionProps(client: TestApp, postId: number) {
+  const response = await client.get(`/posts/${postId}/revisions`)
+  response.assertOk()
+  const { payload: page } = await readInertiaResponse(response.raw)
+  expect(page.component).toBe('posts/Revisions')
+  return page.props as { revisions: Array<{ id: number; title: string; createdAt: string }> }
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let asAuthor: TestApp
+  let asOther: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await createUser('author')
+    other = await createUser('other')
+    asAuthor = await http.actingAs(author).withCsrf()
+    asOther = await http.actingAs(other).withCsrf()
+  })
+
+  it('keeps nothing on create', async () => {
+    await asAuthor.post('/posts', payload('Fresh')).assertRedirect()
+    const [post] = await Post.newQuery().where('authorId', author.id).orderBy('id', 'desc').limit(1).get()
+    expect(post).toBeDefined()
+    expect(await revisionsOf(post!.id)).toHaveLength(0)
+  })
+
+  it('keeps the previous version on every successful edit, newest first', async () => {
+    const post = await createPost(author, 'First')
+
+    await asAuthor.put(`/posts/${post.id}`, payload('Second')).assertRedirect(`/posts/${post.id}`)
+    await asAuthor.put(`/posts/${post.id}`, payload('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const rows = await revisionsOf(post.id)
+    expect(rows.map((row) => row.title)).toEqual(['Second', 'First'])
+    expect(rows[1]!.excerpt).toBe('First excerpt')
+    expect(rows[1]!.body).toBe('First body')
+    expect(Number.isNaN(Date.parse(rows[0]!.createdAt))).toBe(false)
+
+    const props = await revisionProps(asAuthor, post.id)
+    expect(props.revisions.map((row) => row.title)).toEqual(['Second', 'First'])
+    expect(props.revisions.map((row) => row.id)).toEqual(rows.map((row) => row.id))
+    expect(typeof props.revisions[0]!.createdAt).toBe('string')
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const post = await createPost(author, 'Stable')
+
+    await asAuthor.put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' }).assertUnprocessable()
+    await asOther.put(`/posts/${post.id}`, payload('Hijacked')).assertForbidden()
+
+    expect(await revisionsOf(post.id)).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('Stable')
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    const post = await createPost(author, 'First')
+    await asAuthor.put(`/posts/${post.id}`, payload('Second')).assertRedirect()
+    await asAuthor.put(`/posts/${post.id}`, payload('Third')).assertRedirect()
+
+    const before = await revisionsOf(post.id)
+    const first = before.find((row) => row.title === 'First')!
+
+    await asAuthor
+      .post(`/posts/${post.id}/revisions/${first.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.excerpt).toBe('First excerpt')
+    expect(restored.body).toBe('First body')
+
+    const props = await revisionProps(asAuthor, post.id)
+    expect(props.revisions.map((row) => row.title)).toEqual(['Third', 'Second', 'First'])
+    expect(props.revisions.some((row) => row.id === first.id)).toBe(true)
+  })
+
+  it('refuses another signed-in user with 403 and changes nothing', async () => {
+    const post = await createPost(author, 'Private')
+    await asAuthor.put(`/posts/${post.id}`, payload('Private v2')).assertRedirect()
+    const [revision] = await revisionsOf(post.id)
+
+    await asOther.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await asOther.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Private v2')
+    expect(await revisionsOf(post.id)).toHaveLength(1)
+  })
+
+  it('sends guests to the login page and changes nothing', async () => {
+    const post = await createPost(author, 'Guarded')
+    await asAuthor.put(`/posts/${post.id}`, payload('Guarded v2')).assertRedirect()
+    const [revision] = await revisionsOf(post.id)
+
+    const guest = await http.withCsrf()
+    await guest.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await guest.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Guarded v2')
+    expect(await revisionsOf(post.id)).toHaveLength(1)
+  })
+
+  it('answers 404 for a revision that belongs to a different post', async () => {
+    const mine = await createPost(author, 'Mine')
+    const theirs = await createPost(author, 'Also mine')
+    await asAuthor.put(`/posts/${theirs.id}`, payload('Also mine v2')).assertRedirect()
+    const [foreign] = await revisionsOf(theirs.id)
+
+    await asAuthor.post(`/posts/${mine.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(mine.id)).title).toBe('Mine')
+    expect(await revisionsOf(mine.id)).toHaveLength(0)
+    expect(await revisionsOf(theirs.id)).toHaveLength(1)
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const doomed = await createPost(author, 'Doomed')
+    const kept = await createPost(author, 'Kept')
+    await asAuthor.put(`/posts/${doomed.id}`, payload('Doomed v2')).assertRedirect()
+    await asAuthor.put(`/posts/${kept.id}`, payload('Kept v2')).assertRedirect()
+
+    await asAuthor.delete(`/posts/${doomed.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(doomed.id)).toBeNull()
+    expect(await revisionsOf(doomed.id)).toHaveLength(0)
+    expect(await revisionsOf(kept.id)).toHaveLength(1)
+  })
+})
