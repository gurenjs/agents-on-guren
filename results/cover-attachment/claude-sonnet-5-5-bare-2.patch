diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..ab4029f
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,103 @@
+import { mkdir, unlink } from 'node:fs/promises'
+import { dirname, join, resolve, sep } from 'node:path'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+// Kept outside public/ (which is served as-is): the app serves covers itself.
+const STORAGE_ROOT = resolve(new URL('../../storage', import.meta.url).pathname)
+const MAX_COVER_BYTES = 2 * 1024 * 1024
+
+const TYPES = {
+  'image/png': 'png',
+  'image/jpeg': 'jpg',
+} as const
+
+type CoverMime = keyof typeof TYPES
+
+export interface ValidCover {
+  bytes: Uint8Array
+  mimeType: CoverMime
+}
+
+// The stored bytes decide the type, not the client-declared one.
+function sniff(bytes: Uint8Array): CoverMime | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (bytes.length >= png.length && png.every((byte, i) => bytes[i] === byte)) return 'image/png'
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+/** Checks an uploaded cover; a missing or empty file field means "no cover". */
+export async function validateCover(file: File | null): Promise<ValidCover | null> {
+  if (!file || file.size === 0) return null
+
+  if (file.size > MAX_COVER_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover must be 2 MB or smaller.' })
+  }
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const mimeType = sniff(bytes)
+  if (!mimeType) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image.' })
+  }
+  return { bytes, mimeType }
+}
+
+function absolutePath(path: string): string | null {
+  const full = resolve(STORAGE_ROOT, path)
+  return full.startsWith(STORAGE_ROOT + sep) ? full : null
+}
+
+async function removeFile(path: string): Promise<void> {
+  const full = absolutePath(path)
+  if (!full) return
+  await unlink(full).catch(() => {})
+}
+
+export async function readCoverFile(attachment: AttachmentRecord): Promise<Blob | null> {
+  const full = absolutePath(attachment.path)
+  if (!full) return null
+  const file = Bun.file(full)
+  return (await file.exists()) ? file : null
+}
+
+export function findCover(postId: number): Promise<AttachmentRecord | null> {
+  return Attachment.first({ postId })
+}
+
+/** Adds `coverUrl` (or null) to each post, with one query for all of them. */
+export async function withCoverUrls<T extends { id: number }>(posts: T[]): Promise<Array<T & { coverUrl: string | null }>> {
+  if (posts.length === 0) return []
+  const rows = await Attachment.whereIn('postId', posts.map((post) => post.id)).get()
+  const byPost = new Map(rows.map((row) => [row.postId, row.id]))
+
+  return posts.map((post) => {
+    const attachmentId = byPost.get(post.id)
+    return Object.assign(post, { coverUrl: attachmentId === undefined ? null : `/attachments/${attachmentId}` })
+  })
+}
+
+/** Deletes a post's cover file and row, if it has one. */
+export async function removeCover(postId: number): Promise<void> {
+  const existing = await findCover(postId)
+  if (!existing) return
+  await Attachment.delete({ id: existing.id })
+  await removeFile(existing.path)
+}
+
+/** Stores a new cover for the post, replacing (and deleting) any earlier one. */
+export async function storeCover(postId: number, cover: ValidCover): Promise<void> {
+  const path = join('covers', `${crypto.randomUUID()}.${TYPES[cover.mimeType]}`)
+  const full = join(STORAGE_ROOT, path)
+  await mkdir(dirname(full), { recursive: true })
+  await Bun.write(full, cover.bytes)
+
+  const previous = await findCover(postId)
+  try {
+    if (previous) await Attachment.delete({ id: previous.id })
+    await Attachment.forceCreate({ postId, path, mimeType: cover.mimeType, size: cover.bytes.length })
+  } catch (error) {
+    await removeFile(path)
+    throw error
+  }
+  if (previous) await removeFile(previous.path)
+}
