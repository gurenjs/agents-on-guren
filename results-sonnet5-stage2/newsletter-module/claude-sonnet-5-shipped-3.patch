new file mode 100644
index 0000000..a19a7fe
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,48 @@
+import { Controller, HttpException, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { ConfirmParamsSchema, SubscribeSchema, UnsubscribeSchema } from '../../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    const token = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex')
+    await NewsletterSubscription.forceCreate({ email, token })
+
+    return this.redirect(this.backPath())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmParamsSchema)
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) throw HttpException.notFound()
+
+    await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.backPath())
+  }
+
+  // Only a same-origin Referer is followed, and only as a path, so a forged header cannot bounce visitors off-site.
+  private backPath(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const target = new URL(referer)
+      if (target.origin !== new URL(this.request.url).origin) return '/'
+      return `${target.pathname}${target.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
