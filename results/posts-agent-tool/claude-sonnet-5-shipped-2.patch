diff --git a/tests/Mcp.test.ts b/tests/Mcp.test.ts
new file mode 100644
index 0000000..dbe435c
--- /dev/null
+++ b/tests/Mcp.test.ts
@@ -0,0 +1,77 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken, DatabaseApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { resetDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('POST /mcp', () => {
+  let http: TestApp
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass-1' })
+    userId = user.id as number
+    const { plainTextToken } = await createApiToken(new DatabaseApiTokenStore(apiTokens), { name: 'test', userId, abilities: ['tools:*'] })
+    bearer = plainTextToken
+  })
+
+  const rpc = (method: string, params?: unknown, token: string | null = bearer) => {
+    const client = token ? http.withHeader('Authorization', `Bearer ${token}`) : http
+    return client
+      .withHeaders({ Accept: 'application/json, text/event-stream' })
