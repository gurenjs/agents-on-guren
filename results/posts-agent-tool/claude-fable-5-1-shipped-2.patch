+++ b/tests/AgentTools.test.ts
@@ -0,0 +1,179 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface ToolListing {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: unknown
+  isError?: boolean
+}
+
+// The endpoint answers a JSON-RPC call either as plain JSON or as a one-event
+// SSE stream, depending on the transport's choice; both carry the same message.
+async function readRpcResult<T>(response: { text(): Promise<string> }): Promise<T> {
+  const raw = await response.text()
+  const payload = raw.trimStart().startsWith('{')
+    ? raw
+    : raw.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5)).join('')
+  const message = JSON.parse(payload) as { result?: T; error?: unknown }
+  if (message.result === undefined) {
+    throw new Error(`MCP call failed: ${JSON.stringify(message.error)}`)
+  }
+  return message.result
+}
+
+describe('agent tools over /mcp', () => {
+  let http: TestApp
+  let author: UserRecord
+  let mcp: TestApp
+
+  const rpc = (method: string, params?: Record<string, unknown>) =>
+    mcp.post('/mcp', { jsonrpc: '2.0', id: 1, method, ...(params ? { params } : {}) })
+
+  const callTool = async (name: string, args: Record<string, unknown>) =>
+    readRpcResult<ToolResult>(await rpc('tools/call', { name, arguments: args }))
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('The app configures no API token store.')
+    const { plainTextToken } = await createApiToken(store, {
+      name: 'test assistant',
+      userId: author.id,
+      abilities: ['tools:*'],
+    })
+    mcp = http.withHeaders({
+      Authorization: `Bearer ${plainTextToken}`,
+      Accept: 'application/json, text/event-stream',
+    })
+  })
+
+  it('refuses a call without a credential', async () => {
+    await http
+      .withHeader('Accept', 'application/json, text/event-stream')
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list' })
+      .assertUnauthorized()
+  })
+
+  it('refuses a credential the store does not know', async () => {
+    await http
+      .withHeaders({ Authorization: 'Bearer nope|nope', Accept: 'application/json, text/event-stream' })
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list' })
+      .assertUnauthorized()
+  })
+
+  it('lists the two tools and marks only the search read-only', async () => {
+    const { tools } = await readRpcResult<{ tools: ToolListing[] }>(await rpc('tools/list'))
+    const own = tools.filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(own.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(own.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(own.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('posts_search answers with what QUERY /posts/search answers', async () => {
+    await Post.forceCreate({ title: 'Bun 1.3', excerpt: 'Release notes', body: 'Faster.', authorId: author.id })
+    await Post.forceCreate({ title: 'Gardening', excerpt: 'Tomatoes', body: 'Red.', authorId: author.id })
+
+    const input = { keywords: ['bun'], limit: 5 }
+    const expected = await (await http.query('/posts/search', input)).json<{ data: Array<{ title: string }> }>()
+    const result = await callTool('posts_search', input)
+
+    expect(result.isError).not.toBe(true)
+    expect(JSON.parse(result.content[0]!.text)).toEqual(expected)
+    expect(expected.data.map((post) => post.title)).toEqual(['Bun 1.3'])
+  })
+
+  it('posts_store creates the post as the token\'s user, whatever authorId says', async () => {
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+
+    const result = await callTool('posts_store', {
+      title: 'Drafted by an assistant',
+      excerpt: 'Short',
+      body: 'Long',
+      authorId: other.id,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const posts = await Post.all()
+    expect(posts).toHaveLength(1)
+    expect(posts[0]).toMatchObject({ title: 'Drafted by an assistant', authorId: author.id })
+    expect(JSON.parse(result.content[0]!.text)).toMatchObject({
+      data: { id: posts[0]!.id, title: 'Drafted by an assistant', authorId: author.id },
+    })
+  })
+
+  it('posts_store rejects what the web form rejects and creates nothing', async () => {
+    const result = await callTool('posts_store', { title: '', excerpt: 'Short', body: 'Long' })
+
+    expect(result.isError).toBe(true)
+    expect(result.content.map((block) => block.text).join('\n')).toContain('Title is required.')
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('posts_store is refused for a token whose scopes are read-only', async () => {
+    const store = app.auth.getApiTokenStore()!
+    const { plainTextToken } = await createApiToken(store, {
+      name: 'reader',
+      userId: author.id,
+      abilities: ['tools:read'],
+    })
+    const reader = http.withHeaders({
+      Authorization: `Bearer ${plainTextToken}`,
+      Accept: 'application/json, text/event-stream',
+    })
+
+    const result = await readRpcResult<ToolResult>(await reader.post('/mcp', {
+      jsonrpc: '2.0',
+      id: 1,
+      method: 'tools/call',
+      params: { name: 'posts_store', arguments: { title: 'T', excerpt: 'E', body: 'B' } },
+    }))
+
+    expect(result.isError).toBe(true)
+    expect(await Post.all()).toHaveLength(0)
+  })
+})
+
+describe('posts.store on the website', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('still sends a guest to the login page and creates nothing', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B' }).assertRedirect('/login')
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('still redirects the form to the new post', async () => {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const form = csrf.withHeaders({ Accept: 'text/html, application/xhtml+xml', 'X-Inertia': 'true' })
+    await form.post('/posts', { title: 'T', excerpt: 'E', body: 'B' }).assertRedirect('/posts/1')
+    expect(await Post.all()).toHaveLength(1)
+  })
+})
