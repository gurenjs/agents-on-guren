diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..cd1854d
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,92 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import {
+  MemoryDriver,
+  MemoryTransport,
+  Worker,
+  getQueueDriver,
+  setQueueDriver,
+  type MailManager,
+  type QueueDriver,
+} from '@guren/core'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+// Registration hands the welcome email to the queue and returns; the message
+// only goes out when the queued work runs. These tests point the app's queue at
+// a driver that holds the work instead of running it (development runs `sync`,
+// which would send inline) and its mailer at a transport that records what it
+// was asked to deliver.
+describe('register.store', () => {
+  let http: TestApp
+  let mailer: MailManager
+  let defaultTransport: string
+  let previousQueueDriver: QueueDriver | null
+  let queue: MemoryDriver
+  let mailbox: MemoryTransport
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    mailer = app.container.make<MailManager>('mail')
+    defaultTransport = mailer.getDefaultTransportName()
+    previousQueueDriver = getQueueDriver()
+  })
+
+  beforeEach(() => {
+    queue = new MemoryDriver()
+    setQueueDriver(queue)
+
+    mailbox = new MemoryTransport()
+    mailer.registerTransport(defaultTransport, () => mailbox)
+  })
+
+  afterAll(() => {
+    if (previousQueueDriver) {
+      setQueueDriver(previousQueueDriver)
+    }
+  })
+
+  it('queues the welcome email rather than sending it during sign-up', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'a-good-password',
+        passwordConfirmation: 'a-good-password',
+      })
+      .assertRedirect('/dashboard')
+
+    expect(mailbox.count()).toBe(0)
+    expect(await queue.size('default')).toBe(1)
+
+    // What a worker process does with the waiting work.
+    await new Worker(queue, { queues: ['default'], stopWhenEmpty: true }).start()
+
+    expect(mailbox.count()).toBe(1)
+    const message = mailbox.getLastMessage()
+    expect(message?.to.map((address) => address.email)).toEqual(['ada@example.com'])
+    expect(message?.from?.email).toBe(process.env.MAIL_FROM_ADDRESS)
+    expect(message?.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(message?.text).toContain('Hi Ada Lovelace,')
+  })
+
+  it('queues nothing when the registration is refused', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf
+      .post('/register', {
+        name: 'Grace Hopper',
+        email: 'grace@example.com',
+        password: 'a-good-password',
+        passwordConfirmation: 'a-different-password',
+      })
+      .assertUnprocessable()
+
+    expect(await queue.size('default')).toBe(0)
+    expect(mailbox.count()).toBe(0)
+  })
+})
