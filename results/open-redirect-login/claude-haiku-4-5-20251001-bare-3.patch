@@ -0,0 +1,101 @@
+import { describe, it } from 'bun:test'
+import { isSafeRedirect } from '../app/Http/Utils/RedirectValidator.js'
+
+describe('isSafeRedirect', () => {
+  describe('valid redirects', () => {
+    it('allows empty string', async () => {
+      if (!isSafeRedirect('')) {
+        throw new Error('Empty string should be allowed')
+      }
+    })
+
+    it('allows absolute paths', async () => {
+      const paths = ['/dashboard', '/posts/3/edit', '/profile', '/admin/users', '/api/data', '/']
+      for (const path of paths) {
+        if (!isSafeRedirect(path)) {
+          throw new Error(`Path ${path} should be allowed`)
+        }
+      }
+    })
+
+    it('allows paths with query strings', async () => {
+      if (!isSafeRedirect('/posts?page=2')) {
+        throw new Error('Path with query string should be allowed')
+      }
+    })
+
+    it('allows paths with hash fragments', async () => {
+      if (!isSafeRedirect('/posts#section')) {
+        throw new Error('Path with hash should be allowed')
+      }
+    })
+  })
+
+  describe('invalid redirects', () => {
+    it('blocks absolute URLs with https scheme', async () => {
+      if (isSafeRedirect('https://evil.example')) {
+        throw new Error('HTTPS URL should not be allowed')
+      }
+    })
+
+    it('blocks absolute URLs with http scheme', async () => {
+      if (isSafeRedirect('http://evil.example')) {
+        throw new Error('HTTP URL should not be allowed')
+      }
+    })
+
+    it('blocks protocol-relative URLs starting with //', async () => {
+      if (isSafeRedirect('//evil.example')) {
+        throw new Error('Protocol-relative URL should not be allowed')
+      }
+    })
+
+    it('blocks backslash variants', async () => {
+      if (isSafeRedirect('/\\evil.example')) {
+        throw new Error('Backslash variant should not be allowed')
+      }
+    })
+
+    it('blocks javascript protocol', async () => {
+      if (isSafeRedirect('javascript:alert("xss")')) {
+        throw new Error('JavaScript protocol should not be allowed')
+      }
+    })
+
+    it('blocks data protocol', async () => {
+      if (isSafeRedirect('data:text/html,<script>alert("xss")</script>')) {
+        throw new Error('Data protocol should not be allowed')
+      }
+    })
+
+    it('blocks relative paths without leading slash', async () => {
+      if (isSafeRedirect('posts/3/edit')) {
+        throw new Error('Relative path should not be allowed')
+      }
+    })
+
+    it('blocks single backslash', async () => {
+      if (isSafeRedirect('\\')) {
+        throw new Error('Single backslash should not be allowed')
+      }
+    })
+
+    it('blocks ftp protocol', async () => {
+      if (isSafeRedirect('ftp://files.example.com')) {
+        throw new Error('FTP protocol should not be allowed')
+      }
+    })
+
+    it('blocks file protocol', async () => {
+      if (isSafeRedirect('file:///etc/passwd')) {
+        throw new Error('File protocol should not be allowed')
+      }
+    })
+
+    it('blocks mailto protocol', async () => {
+      if (isSafeRedirect('mailto:attacker@evil.example')) {
+        throw new Error('Mailto protocol should not be allowed')
+      }
+    })
+  })
+})
