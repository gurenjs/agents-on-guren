--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,24 @@
+import { ServiceProvider, createQueueManager, getQueueDriver, registerJob, type QueueManager } from '@guren/core'
+import { queueConfig } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.instance('queue', createQueueManager(queueConfig()))
+  }
+
+  boot(): void {
+    // A queued message records only the job's name, and whoever runs it —
+    // the sync driver here, or the worker `bunx guren queue:work` boots —
+    // resolves the class back from this registry. Registered before the driver
+    // is activated, so even an inline dispatch finds it.
+    registerJob(SendWelcomeEmailJob)
+
+    // Job.dispatch() pushes to the globally activated driver, and resolving
+    // the configured connection activates it. A driver installed before boot —
+    // a test pointing the app at a queue of its own — is left alone.
+    if (!getQueueDriver()) {
+      this.container.make<QueueManager>('queue').driver()
+    }
+  }
+}
