+/**
+ * Guards for user-supplied post-login (and post-action) redirect targets.
+ *
+ * A redirect value coming from a query string or a form field must never be
+ * able to send the browser to another site: an attacker can mail a link to
+ * our own login page and have the victim handed to a look-alike host after
+ * they sign in. Only plain paths inside this app are accepted.
+ */
+
+/** Where a sign-in without a usable redirect value lands. */
+export const DEFAULT_REDIRECT = '/dashboard'
+
+/**
+ * Browsers drop control characters (tabs and newlines in particular) while
+ * parsing a URL, so a value like `/<TAB>/evil.example` would navigate to
+ * `//evil.example`. Strip them before inspecting the value.
+ */
+function stripControlCharacters(value: string): string {
+  return Array.from(value)
+    .filter((character) => {
+      const code = character.codePointAt(0) ?? 0
+      return code > 0x1f && code !== 0x7f
+    })
+    .join('')
+}
+
+/**
+ * Returns the value as a safe same-app path, or `null` when it points
+ * anywhere else — absolute URLs with a scheme, protocol-relative `//host`,
+ * their backslash variants, or anything that is not rooted at `/`.
+ */
+export function sanitizeRedirectPath(value: unknown): string | null {
+  if (typeof value !== 'string') {
+    return null
+  }
+
+  const candidate = stripControlCharacters(value).trim()
+  if (candidate === '') {
+    return null
+  }
+
+  // Browsers treat a backslash as a path separator, so `/\evil.example` is
+  // read as `//evil.example`. Normalize first, then judge what it really is.
+  const normalized = candidate.replace(/\\/g, '/')
+
+  // Must be rooted at this app: rejects `https://evil.example`,
+  // `javascript:...`, `evil.example` and other scheme/relative forms.
+  if (!normalized.startsWith('/')) {
+    return null
+  }
+
+  // `//evil.example` (and `/\evil.example`, normalized above) is
+  // protocol-relative — a different origin.
+  if (normalized.startsWith('//')) {
+    return null
+  }
+
+  return normalized
+}
+
+/**
+ * Same as {@link sanitizeRedirectPath}, but falls back to the default
+ * destination instead of returning `null`.
+ */
+export function safeRedirectPath(value: unknown, fallback: string = DEFAULT_REDIRECT): string {
+  return sanitizeRedirectPath(value) ?? fallback
+}
