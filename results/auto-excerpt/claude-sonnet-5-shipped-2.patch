diff --git a/tests/PostExcerpt.test.ts b/tests/PostExcerpt.test.ts
new file mode 100644
index 0000000..8a55137
--- /dev/null
+++ b/tests/PostExcerpt.test.ts
@@ -0,0 +1,77 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('post excerpt', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    user = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret123' }))!
+  })
+
+  it('creates a post with a derived excerpt when the excerpt is blank/whitespace', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    const body = 'x'.repeat(160)
+    await authed.post('/posts', { title: 'Hello', excerpt: '   ', body }).assertRedirect()
+
+    const post = await Post.first({ authorId: user.id })
+    expect(post?.excerpt).toBe(`${'x'.repeat(140)}…`)
+  })
+
+  it('creates a post with a derived excerpt when the excerpt is omitted entirely', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.post('/posts', { title: 'Hello', body: 'Some body text.' }).assertRedirect()
+
+    const post = await Post.first({ authorId: user.id })
+    expect(post?.excerpt).toBe('Some body text.')
+  })
+
+  it('stores a provided excerpt as typed, trimmed', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.post('/posts', { title: 'Hello', excerpt: '  My excerpt  ', body: 'Some body text.' }).assertRedirect()
+
+    const post = await Post.first({ authorId: user.id })
+    expect(post?.excerpt).toBe('My excerpt')
+  })
+
+  it('still rejects a blank title with no excerpt given', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.post('/posts', { title: '  ', body: 'Some body text.' }).assertUnprocessable()
+
+    const post = await Post.first({ authorId: user.id })
+    expect(post).toBeNull()
+  })
+
+  it('still rejects a blank body with no excerpt given', async () => {
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.post('/posts', { title: 'Hello', body: '   ' }).assertUnprocessable()
+
+    const post = await Post.first({ authorId: user.id })
+    expect(post).toBeNull()
+  })
+
+  it('re-derives the excerpt on update when left blank, replacing the old one', async () => {
+    const post = (await Post.forceCreate({ title: 'Hello', excerpt: 'old excerpt', body: 'Old body.', authorId: user.id }))!
+    const authed = await http.actingAs(user).withCsrf()
+    const newBody = 'y'.repeat(160)
+    await authed.put(`/posts/${post.id}`, { title: 'Hello', excerpt: '', body: newBody }).assertRedirect()
+
+    const updated = await Post.find(post.id)
+    expect(updated?.excerpt).toBe(`${'y'.repeat(140)}…`)
+  })
+
+  it('a provided excerpt wins over the derived one on update', async () => {
+    const post = (await Post.forceCreate({ title: 'Hello', excerpt: 'old excerpt', body: 'Old body.', authorId: user.id }))!
+    const authed = await http.actingAs(user).withCsrf()
+    await authed.put(`/posts/${post.id}`, { title: 'Hello', excerpt: '  New excerpt  ', body: 'New body text.' }).assertRedirect()
+
+    const updated = await Post.find(post.id)
+    expect(updated?.excerpt).toBe('New excerpt')
+  })
+})
diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..5494d3a
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerptFromBody } from '../app/Support/excerpt.js'
+
+describe('deriveExcerptFromBody', () => {
+  it('returns the trimmed body unchanged when it is 140 characters or fewer', () => {
+    expect(deriveExcerptFromBody('  Short body.  ')).toBe('Short body.')
+    expect(deriveExcerptFromBody('a'.repeat(140))).toBe('a'.repeat(140))
+  })
+
+  it('cuts back to the last whitespace when the 141st character falls inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ' +
+      'The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(body.length).toBe(150)
+
+    const excerpt = deriveExcerptFromBody(body)
+    expect(excerpt).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+    expect(excerpt.length).toBe(139)
+  })
+
+  it('keeps all 140 characters when the cut lands exactly on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and ' +
+      'stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+
+    const excerpt = deriveExcerptFromBody(body)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt.length).toBe(141)
+  })
+
+  it('cuts at 140 when the first 140 characters contain no whitespace', () => {
+    const body = `${'a'.repeat(160)}`
+    const excerpt = deriveExcerptFromBody(body)
+    expect(excerpt).toBe(`${'a'.repeat(140)}…`)
+  })
+})
