new file mode 100644
index 0000000..29dc514
--- /dev/null
+++ b/app/Http/Resources/PostListMetaResource.ts
@@ -0,0 +1,20 @@
+import { Resource, type PaginationMeta } from '@guren/core'
+
+export interface PostListMetaResourceData extends Record<string, unknown> {
+  currentPage: number
+  lastPage: number
+  perPage: number
+  total: number
+}
+
+export class PostListMetaResource extends Resource<PaginationMeta> {
+  toArray(): PostListMetaResourceData {
+    const { currentPage, lastPage, perPage, total } = this.resource
+
+    return { currentPage, lastPage, perPage, total }
+  }
+
+  override toJSON(): PostListMetaResourceData {
+    return super.toJSON() as PostListMetaResourceData
+  }
+}
