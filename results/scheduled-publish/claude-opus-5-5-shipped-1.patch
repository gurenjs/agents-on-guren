diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..bfae9f2
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,93 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2001-01-01T00:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-pass' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-pass' })
+    await Post.forceCreate({ title: 'Live post', excerpt: 'live', body: 'b', authorId: author.id })
+    scheduled = (await Post.forceCreate({
+      title: 'Launch post',
+      excerpt: 'launch',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    }))!
+  })
+
+  async function listedIds(client: TestApp): Promise<number[]> {
+    const res = await client.withHeader('X-Inertia', 'true').get('/posts')
+    const page = await res.json<{ props: { data: Array<{ id: number }> } }>()
+    return page.props.data.map((post) => post.id)
+  }
+
+  async function searchIds(client: TestApp): Promise<number[]> {
+    const res = await client.json().query('/posts/search', { keywords: ['post'] })
+    const body = await res.json<{ data: Array<{ id: number }> }>()
+    return body.data.map((post) => post.id)
+  }
+
+  it('hides a scheduled post from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+    expect(await listedIds(http)).not.toContain(scheduled.id)
+    expect(await listedIds(http.actingAs(other))).not.toContain(scheduled.id)
+    expect(await searchIds(http)).not.toContain(scheduled.id)
+    expect(await searchIds(http.actingAs(other))).not.toContain(scheduled.id)
+    expect((await listedIds(http)).length).toBe(1)
+  })
+
+  it('shows a scheduled post to its author with publishedAt', async () => {
+    const res = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${scheduled.id}`)
+    res.assertSuccessful()
+    const page = await res.json<{ props: { post: { publishedAt: string } } }>()
+    expect(new Date(page.props.post.publishedAt).toISOString()).toBe(FUTURE)
+    expect(await listedIds(http.actingAs(author))).toContain(scheduled.id)
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    expect(await listedIds(http)).toContain(scheduled.id)
+    expect(await searchIds(http)).toContain(scheduled.id)
+  })
+
+  it('stores publishAt on create and clears it on update', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'T', excerpt: 'e', body: 'b', publishAt: '2998-10-01T09:00:00.000Z' }).assertRedirect()
+    const created = await Post.first({ title: 'T' })
+    expect(created?.publishedAt).toBe('2998-10-01T09:00:00.000Z')
+
+    await csrf.put(`/posts/${created!.id}`, { title: 'T', excerpt: 'e', body: 'b', publishAt: null }).assertRedirect()
+    expect((await Post.find(created!.id))?.publishedAt).toBeNull()
+  })
+
+  it('rejects a publishAt that is not a date and time', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', { title: 'Bad', excerpt: 'e', body: 'b', publishAt: 'next tuesday' }).assertUnprocessable()
+    expect(await Post.first({ title: 'Bad' })).toBeNull()
+  })
+
+  it('lists only scheduled posts, soonest first', async () => {
+    await Post.forceCreate({ title: 'Sooner', excerpt: 'e', body: 'b', authorId: author.id, publishedAt: '2998-01-01T00:00:00.000Z' })
+    await Post.forceCreate({ title: 'Past', excerpt: 'e', body: 'b', authorId: author.id, publishedAt: PAST })
+    expect((await Post.scheduled()).map((post) => post.title)).toEqual(['Sooner', 'Launch post'])
+  })
+})
