diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..60f15c3
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,27 @@
+const EXCERPT_LENGTH = 140
+const ELLIPSIS = '…'
+
+/**
+ * Derives a post excerpt from its body when the author leaves the excerpt
+ * blank. Keeps the opening of the body up to 140 characters, never cutting a
+ * word in half, and marks the cut with a trailing ellipsis.
+ */
+export function deriveExcerpt(body: string): string {
+  const trimmedBody = body.trim()
+  if (trimmedBody.length <= EXCERPT_LENGTH) {
+    return trimmedBody
+  }
+
+  let kept = trimmedBody.slice(0, EXCERPT_LENGTH)
+  const charAt140 = kept[kept.length - 1]
+  const charAt141 = trimmedBody[EXCERPT_LENGTH]
+
+  if (!/\s/.test(charAt140) && !/\s/.test(charAt141)) {
+    const lastWhitespaceIndex = kept.search(/\s(?=\S*$)/)
+    if (lastWhitespaceIndex !== -1) {
+      kept = kept.slice(0, lastWhitespaceIndex)
+    }
+  }
+
+  return kept.trimEnd() + ELLIPSIS
+}
