--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,339 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+// node:zlib wraps the stream in the zlib envelope PNG requires; Bun.deflateSync emits raw deflate.
+import { deflateSync } from 'node:zlib'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import type { attachments } from '../db/schema.js'
+
+type AttachmentRow = typeof attachments.$inferSelect
+
+// config/storage.ts roots the `local` disk here under NODE_ENV=test.
+const STORAGE_ROOT = join(process.cwd(), 'storage', 'app', 'testing')
+const PUBLIC_ROOT = join(process.cwd(), 'public')
+
+const CRC_TABLE = new Uint32Array(256).map((_, n) => {
+  let c = n
+  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1
+  return c >>> 0
+})
+
+function crc32(bytes: Uint8Array): number {
+  let crc = 0xffffffff
+  for (const byte of bytes) crc = CRC_TABLE[(crc ^ byte) & 0xff]! ^ (crc >>> 8)
+  return (crc ^ 0xffffffff) >>> 0
+}
+
+function chunk(type: string, data: Uint8Array): Uint8Array {
+  const typeBytes = new TextEncoder().encode(type)
+  const out = new Uint8Array(12 + data.length)
+  const view = new DataView(out.buffer)
+  view.setUint32(0, data.length)
+  out.set(typeBytes, 4)
+  out.set(data, 8)
+  const crcInput = new Uint8Array(4 + data.length)
+  crcInput.set(typeBytes)
+  crcInput.set(data, 4)
+  view.setUint32(8 + data.length, crc32(crcInput))
+  return out
+}
+
+/** A real, decodable RGB PNG of the given size, filled with one colour. */
+function makePng(width: number, height: number, rgb: [number, number, number] = [200, 40, 40]): Uint8Array<ArrayBuffer> {
+  const ihdr = new Uint8Array(13)
+  const ihdrView = new DataView(ihdr.buffer)
+  ihdrView.setUint32(0, width)
+  ihdrView.setUint32(4, height)
+  ihdr.set([8, 2, 0, 0, 0], 8) // 8-bit, colour type 2 (RGB), no interlace
+
+  const raw = new Uint8Array(height * (1 + width * 3))
+  for (let y = 0; y < height; y++) {
+    const rowStart = y * (1 + width * 3)
+    raw[rowStart] = 0 // filter: none
+    for (let x = 0; x < width; x++) raw.set(rgb, rowStart + 1 + x * 3)
+  }
+
+  const parts = [
+    new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    chunk('IHDR', ihdr),
+    chunk('IDAT', new Uint8Array(deflateSync(raw))),
+    chunk('IEND', new Uint8Array(0)),
+  ]
+  const total = parts.reduce((sum, part) => sum + part.length, 0)
+  const png = new Uint8Array(new ArrayBuffer(total))
+  let offset = 0
+  for (const part of parts) {
+    png.set(part, offset)
+    offset += part.length
+  }
+  return png
+}
+
+async function makeJpeg(): Promise<Uint8Array<ArrayBuffer>> {
+  return new Uint8Array(await new Bun.Image(makePng(8, 8, [30, 30, 220])).jpeg().bytes())
+}
+
+function makeGif(): Uint8Array<ArrayBuffer> {
+  // A tiny but well-formed 1x1 GIF89a.
+  return new Uint8Array([
+    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x01, 0x00, 0x01, 0x00, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0xff, 0xff, 0xff, 0x2c, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x02, 0x02, 0x44,
+    0x01, 0x00, 0x3b,
+  ])
+}
+
+/** A PNG that starts like a PNG but weighs one byte over the 2 MB cap. */
+function makeOversizedPng(): Uint8Array<ArrayBuffer> {
+  const png = makePng(4, 4)
+  const out = new Uint8Array(new ArrayBuffer(2 * 1024 * 1024 + 1))
+  out.set(png)
+  return out
+}
+
+let counter = 0
+function uniqueTitle(label: string): string {
+  counter += 1
+  return `Cover ${label} ${Date.now()}-${counter}`
+}
+
+function postForm(fields: Record<string, string>, cover?: { bytes: Uint8Array<ArrayBuffer>; name: string; type: string }): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries(fields)) form.append(key, value)
+  if (cover) form.append('cover', new File([cover.bytes], cover.name, { type: cover.type }))
+  return form
+}
+
+function idFromLocation(location: string | null): number {
+  const match = /\/posts\/(\d+)$/.exec(location ?? '')
+  if (!match) throw new Error(`Expected a post URL in Location, got ${location}`)
+  return Number(match[1])
+}
+
+async function coverRows(postId: number): Promise<AttachmentRow[]> {
+  const rows = await Attachment.where({ attachableId: String(postId), collection: 'cover' })
+  return rows as unknown as AttachmentRow[]
+}
+
+function storedPath(row: AttachmentRow): string {
+  return join(STORAGE_ROOT, row.path)
+}
+
+async function bytesOf(response: Response): Promise<Uint8Array> {
+  return new Uint8Array(await response.arrayBuffer())
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: TestApp
+  let user: UserRecord
+
+  const fields = () => ({ title: uniqueTitle('post'), excerpt: 'An excerpt', body: 'A body' })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = (await User.create({
+      name: 'Cover Author',
+      email: `cover-author-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+    author = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  async function createPost(cover?: Parameters<typeof postForm>[1], overrides: Partial<Record<'title' | 'excerpt' | 'body', string>> = {}) {
+    const response = await author.post('/posts', postForm({ ...fields(), ...overrides }, cover))
+    return response
+  }
+
+  async function showProps(postId: number): Promise<PostResourceData> {
+    const response = await http.get(`/posts/${postId}`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    return payload.props.post as PostResourceData
+  }
+
+  it('creates a post with a PNG cover, serves it back, and stores it privately', async () => {
+    const png = makePng(16, 16)
+    const response = await createPost({ bytes: png, name: 'cover.png', type: 'image/png' })
+    expect([302, 303]).toContain(response.status)
+    const postId = idFromLocation(response.raw.headers.get('location'))
+
+    const post = await showProps(postId)
+    expect(post.coverUrl).toEqual(expect.any(String))
+
+    const served = await http.get(post.coverUrl!).assertOk()
+    expect(served.raw.headers.get('content-type')).toBe('image/png')
+    expect(await bytesOf(served.raw)).toEqual(png)
+
+    const list = await http.get('/posts').assertOk()
+    const { payload } = await readInertiaResponse(list.raw)
+    const listed = (payload.props.data as PostResourceData[]).find((item) => item.id === postId)
+    expect(listed?.coverUrl).toEqual(expect.any(String))
+
+    const rows = await coverRows(postId)
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.contentType).toBe('image/png')
+    const path = storedPath(rows[0]!)
+    expect(existsSync(path)).toBe(true)
+    expect(path.startsWith(join(process.cwd(), 'storage'))).toBe(true)
+    expect(path.startsWith(PUBLIC_ROOT)).toBe(false)
+    expect(existsSync(join(PUBLIC_ROOT, 'storage', rows[0]!.path))).toBe(false)
+  })
+
+  it('creates a post with a JPEG cover', async () => {
+    const jpeg = await makeJpeg()
+    const response = await createPost({ bytes: jpeg, name: 'cover.jpg', type: 'image/jpeg' })
+    const postId = idFromLocation(response.raw.headers.get('location'))
+
+    const post = await showProps(postId)
+    const served = await http.get(post.coverUrl!).assertOk()
+    expect(served.raw.headers.get('content-type')).toBe('image/jpeg')
+    expect(await bytesOf(served.raw)).toEqual(jpeg)
+  })
+
+  it('creates a post without a cover as before', async () => {
+    const response = await createPost()
+    const postId = idFromLocation(response.raw.headers.get('location'))
+    const post = await showProps(postId)
+    expect(post.coverUrl).toBeNull()
+    expect(await coverRows(postId)).toHaveLength(0)
+  })
+
+  it('refuses a GIF the way an empty title is refused, creating nothing', async () => {
+    const title = uniqueTitle('gif')
+    const response = await createPost({ bytes: makeGif(), name: 'cover.gif', type: 'image/gif' }, { title })
+    expect(response.status).toBe(422)
+    const body = (await response.raw.json()) as { errors: Record<string, string[]> }
+    expect(body.errors.cover?.length).toBeGreaterThan(0)
+
+    expect(await Post.where({ title })).toHaveLength(0)
+
+    const emptyTitle = await createPost({ bytes: makePng(4, 4), name: 'cover.png', type: 'image/png' }, { title: '' })
+    expect(emptyTitle.status).toBe(422)
+    const emptyBody = (await emptyTitle.raw.json()) as { errors: Record<string, string[]> }
+    expect(emptyBody.errors.title?.length).toBeGreaterThan(0)
+  })
+
+  it('refuses a PNG over 2 MB, creating nothing', async () => {
+    const title = uniqueTitle('big')
+    const response = await createPost({ bytes: makeOversizedPng(), name: 'big.png', type: 'image/png' }, { title })
+    expect(response.status).toBe(422)
+    const body = (await response.raw.json()) as { errors: Record<string, string[]> }
+    expect(body.errors.cover?.length).toBeGreaterThan(0)
+    expect(await Post.where({ title })).toHaveLength(0)
+  })
+
+  it('replaces the cover on edit and deletes the old file', async () => {
+    const png = makePng(10, 10)
+    const created = await createPost({ bytes: png, name: 'first.png', type: 'image/png' })
+    const postId = idFromLocation(created.raw.headers.get('location'))
+    const before = await showProps(postId)
+    const [oldRow] = await coverRows(postId)
+    const oldPath = storedPath(oldRow!)
+    expect(existsSync(oldPath)).toBe(true)
+
+    const jpeg = await makeJpeg()
+    const updated = await author.put(
+      `/posts/${postId}`,
+      postForm({ title: before.title, excerpt: before.excerpt, body: before.body }, { bytes: jpeg, name: 'second.jpg', type: 'image/jpeg' }),
+    )
+    expect([302, 303]).toContain(updated.status)
+
+    const after = await showProps(postId)
+    expect(after.coverUrl).not.toBe(before.coverUrl)
+    const served = await http.get(after.coverUrl!).assertOk()
+    expect(served.raw.headers.get('content-type')).toBe('image/jpeg')
+    expect(await bytesOf(served.raw)).toEqual(jpeg)
+
+    const oldServed = await http.get(before.coverUrl!)
+    expect(oldServed.status).not.toBe(200)
+
+    const rows = await coverRows(postId)
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.id).not.toBe(oldRow!.id)
+    expect(existsSync(oldPath)).toBe(false)
+    expect(existsSync(storedPath(rows[0]!))).toBe(true)
+  })
+
+  it('keeps the cover and the post when the replacement is refused', async () => {
+    const png = makePng(6, 6)
+    const created = await createPost({ bytes: png, name: 'keep.png', type: 'image/png' })
+    const postId = idFromLocation(created.raw.headers.get('location'))
+    const before = await showProps(postId)
+    const [row] = await coverRows(postId)
+
+    const refused = await author.put(
+      `/posts/${postId}`,
+      postForm({ title: 'Changed title', excerpt: before.excerpt, body: before.body }, { bytes: makeGif(), name: 'bad.gif', type: 'image/gif' }),
+    )
+    expect(refused.status).toBe(422)
+    const body = (await refused.raw.json()) as { errors: Record<string, string[]> }
+    expect(body.errors.cover?.length).toBeGreaterThan(0)
+
+    const after = await showProps(postId)
+    expect(after.title).toBe(before.title)
+    const rows = await coverRows(postId)
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.id).toBe(row!.id)
+    expect(existsSync(storedPath(row!))).toBe(true)
+    expect(await bytesOf((await http.get(after.coverUrl!).assertOk()).raw)).toEqual(png)
+  })
+
+  it('leaves the cover alone when editing without a file or the checkbox', async () => {
+    const png = makePng(5, 5)
+    const created = await createPost({ bytes: png, name: 'stay.png', type: 'image/png' })
+    const postId = idFromLocation(created.raw.headers.get('location'))
+    const [row] = await coverRows(postId)
+
+    // Multipart with no file picked.
+    await author.put(`/posts/${postId}`, postForm({ title: 'Edited title', excerpt: 'Edited excerpt', body: 'Edited body' }))
+    // And the JSON body Inertia sends when the form carries no file.
+    await author.put(`/posts/${postId}`, { title: 'Edited again', excerpt: 'Edited excerpt', body: 'Edited body', removeCover: false })
+
+    const after = await showProps(postId)
+    expect(after.title).toBe('Edited again')
+    const rows = await coverRows(postId)
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.id).toBe(row!.id)
+    expect(await bytesOf((await http.get(after.coverUrl!).assertOk()).raw)).toEqual(png)
+  })
+
+  it('removes the cover and its file when the checkbox is ticked', async () => {
+    const created = await createPost({ bytes: makePng(7, 7), name: 'gone.png', type: 'image/png' })
+    const postId = idFromLocation(created.raw.headers.get('location'))
+    const before = await showProps(postId)
+    const [row] = await coverRows(postId)
+    const path = storedPath(row!)
+
+    const response = await author.put(
+      `/posts/${postId}`,
+      postForm({ title: before.title, excerpt: before.excerpt, body: before.body, removeCover: '1' }),
+    )
+    expect([302, 303]).toContain(response.status)
+
+    const after = await showProps(postId)
+    expect(after.coverUrl).toBeNull()
+    expect(await coverRows(postId)).toHaveLength(0)
+    expect(existsSync(path)).toBe(false)
+    expect((await http.get(before.coverUrl!)).status).not.toBe(200)
+  })
+
+  it('deletes the cover file and row with the post', async () => {
+    const created = await createPost({ bytes: makePng(9, 9), name: 'bye.png', type: 'image/png' })
+    const postId = idFromLocation(created.raw.headers.get('location'))
+    const before = await showProps(postId)
+    const [row] = await coverRows(postId)
+    const path = storedPath(row!)
+
+    const response = await author.delete(`/posts/${postId}`)
+    expect([302, 303]).toContain(response.status)
+
+    await http.get(`/posts/${postId}`).assertStatus(404)
+    expect(await coverRows(postId)).toHaveLength(0)
+    expect(existsSync(path)).toBe(false)
+    expect((await http.get(before.coverUrl!)).status).not.toBe(200)
+  })
+})
