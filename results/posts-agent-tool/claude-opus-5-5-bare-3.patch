diff --git a/tests/McpEndpoint.test.ts b/tests/McpEndpoint.test.ts
new file mode 100644
index 0000000..06f2082
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,122 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The App MCP endpoint from @guren/plugin-mcp (src/app.ts). The tools are the
+// `.agent()` routes in routes/web.ts, so these calls run the same validation
+// and policy as the website.
+
+interface JsonRpcResult {
+  result?: {
+    tools?: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }>
+    isError?: boolean
+    structuredContent?: unknown
+    content?: Array<{ type: string; text?: string }>
+  }
+  error?: unknown
+}
+
+// A streamable HTTP response is either plain JSON or one SSE `data:` event.
+async function readRpc(response: Response): Promise<JsonRpcResult> {
+  const text = await response.text()
+  if (text.trimStart().startsWith('{')) return JSON.parse(text)
+  const data = text.split('\n').find((line) => line.startsWith('data:'))
+  return JSON.parse(data!.slice('data:'.length))
+}
+
+let rpcId = 0
+
+describe('App MCP endpoint', () => {
+  let http: TestApp
+  let bearer: string
+  let authorId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const suffix = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+    const user = await User.create({ name: 'MCP author', email: `mcp-${suffix}@example.com`, password: 'password123' })
+    authorId = Number(user.id)
+    const { plainTextToken } = await createApiToken(app.auth.getApiTokenStore()!, {
+      name: 'test assistant',
+      userId: authorId,
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  const call = (method: string, params: Record<string, unknown>, token: string | null = bearer) =>
+    http
+      .withHeaders({
+        'Content-Type': 'application/json',
+        Accept: 'application/json, text/event-stream',
+        ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      })
+      .post('/mcp', { jsonrpc: '2.0', id: ++rpcId, method, params })
+
+  it('refuses a request without a bearer', async () => {
+    await call('tools/list', {}, null).assertStatus(401)
+  })
+
+  it('lists the two post tools with their read-only flags', async () => {
+    const { result } = await readRpc((await call('tools/list', {})).raw)
+    const tools = (result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(tools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).toBe(false)
+  })
+
+  it('creates a post as the token user, ignoring authorId', async () => {
+    const title = `MCP post ${Date.now()}`
+    const { result } = await readRpc(
+      (await call('tools/call', {
+        name: 'posts_store',
+        arguments: { title, excerpt: 'Drafted by an assistant.', body: 'Hello.', authorId: 999999 },
+      })).raw,
+    )
+
+    expect(result?.isError).not.toBe(true)
+    const post = await Post.where({ title }).first()
+    expect(post?.authorId).toBe(authorId)
+  })
+
+  it('rejects input the form would reject with 422', async () => {
+    const excerpt = `invalid-${Date.now()}`
+    const { result } = await readRpc(
+      (await call('tools/call', { name: 'posts_store', arguments: { title: '', excerpt, body: 'x' } })).raw,
+    )
+
+    expect(result?.isError).toBe(true)
+    expect(JSON.stringify(result)).toContain('Title is required.')
+    expect(await Post.where({ excerpt }).first()).toBeNull()
+
+    // The MCP result carries no HTTP status; the framework's dispatch shows it.
+    const user = await User.findOrFail(authorId)
+    await (await http.withCsrf('/posts')).agent()
+      .call('posts_store', { title: '', excerpt, body: 'x' }, { as: user })
+      .assertStatus(422)
+  })
+
+  it('refuses posts_store to a guest', async () => {
+    const excerpt = `guest-${Date.now()}`
+    const outcome = await (await http.withCsrf('/posts')).agent()
+      .call('posts_store', { title: 'Guest post', excerpt, body: 'x' })
+
+    expect([302, 401, 403]).toContain(outcome.outcome.status)
+    expect(await Post.where({ excerpt }).first()).toBeNull()
+  })
+
+  it('searches posts', async () => {
+    const title = `Searchable ${Date.now()}`
+    await Post.forceCreate({ title, excerpt: 'Found by MCP.', body: 'x', authorId })
+    const { result } = await readRpc(
+      (await call('tools/call', { name: 'posts_search', arguments: { keywords: [title] } })).raw,
+    )
+
+    expect(result?.isError).not.toBe(true)
+    expect(JSON.stringify(result)).toContain(title)
+  })
+})
