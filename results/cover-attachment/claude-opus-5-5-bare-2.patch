diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..1588c39
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,129 @@
+import { existsSync, readdirSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const storageDir = resolve(process.cwd(), 'storage/app/attachments')
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 5, 6, 7, 8])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 9, 9])
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  data.set('title', 'Cover post')
+  data.set('excerpt', 'An excerpt')
+  data.set('body', 'A body')
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  return data
+}
+
+function image(bytes: Uint8Array<ArrayBuffer>, name: string, type: string): File {
+  return new File([bytes], name, { type })
+}
+
+function storedFiles(): string[] {
+  return existsSync(storageDir) ? readdirSync(storageDir) : []
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+async function pageOf(http: TestApp, path: string): Promise<{ props: any }> {
+  const response = await http.get(path).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload as { props: any }
+}
+
+async function latestPost() {
+  const [latest] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+  return Post.findWithOrFail(latest!.id, 'cover')
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const base = await TestApp.fromApp(app)
+    author = await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'password-123',
+    })
+    http = await base.actingAs(author).withCsrf('/posts')
+  })
+
+  it('stores a cover on create and serves it back byte for byte', async () => {
+    await http.post('/posts', form({ cover: image(PNG, 'a.png', 'image/png') })).assertRedirect()
+    const post = await latestPost()
+    expect(post.cover).not.toBeNull()
+
+    const response = await http.get(`/attachments/${post.cover!.key}`).assertOk()
+    expect(response.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await response.raw.arrayBuffer())).toEqual(PNG)
+    expect(storedFiles()).toContain(post.cover!.path)
+    expect(existsSync(resolve(process.cwd(), 'public', post.cover!.path))).toBe(false)
+
+    const coverUrl = `/attachments/${post.cover!.key}`
+    const showPage = await pageOf(http, `/posts/${post.id}`)
+    expect(showPage.props.post.coverUrl).toBe(coverUrl)
+    const indexPage = await pageOf(http, '/posts')
+    const listed = indexPage.props.data.find((item: { id: number }) => item.id === post.id)
+    expect(listed.coverUrl).toBe(coverUrl)
+  })
+
+  it('reports a null coverUrl for a post without a cover', async () => {
+    await http.post('/posts', form({})).assertRedirect()
+    const post = await latestPost()
+    expect(post.coverId).toBeNull()
+    expect((await pageOf(http, `/posts/${post.id}`)).props.post.coverUrl).toBeNull()
+  })
+
+  it('refuses a GIF and an oversized file without saving anything', async () => {
+    const posts = (await Post.newQuery().get()).length
+    const attachments = (await Attachment.newQuery().get()).length
+    const files = storedFiles().length
+
+    await http.post('/posts', form({ cover: image(GIF, 'a.gif', 'image/gif') })).assertUnprocessable()
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form({ cover: image(big, 'big.png', 'image/png') })).assertUnprocessable()
+
+    expect((await Post.newQuery().get()).length).toBe(posts)
+    expect((await Attachment.newQuery().get()).length).toBe(attachments)
+    expect(storedFiles().length).toBe(files)
+  })
+
+  it('replaces, keeps, removes and deletes covers along with their files', async () => {
+    await http.post('/posts', form({ cover: image(PNG, 'a.png', 'image/png') })).assertRedirect()
+    const created = await latestPost()
+    const first = created.cover!
+
+    await http.put(`/posts/${created.id}`, form({ cover: image(JPEG, 'b.jpg', 'image/jpeg') })).assertRedirect()
+    const replaced = (await Post.findWithOrFail(created.id, 'cover')).cover!
+    expect(replaced.contentType).toBe('image/jpeg')
+    expect(await Attachment.find(first.id)).toBeNull()
+    expect(storedFiles()).not.toContain(first.path)
+    await http.get(`/attachments/${first.key}`).assertNotFound()
+
+    await http.put(`/posts/${created.id}`, form({ cover: image(GIF, 'c.gif', 'image/gif') })).assertUnprocessable()
+    await http.put(`/posts/${created.id}`, form({ title: 'Renamed' })).assertRedirect()
+    expect((await Post.findOrFail(created.id)).coverId).toBe(replaced.id)
+
+    await http.put(`/posts/${created.id}`, form({ removeCover: '1' })).assertRedirect()
+    expect((await Post.findOrFail(created.id)).coverId).toBeNull()
+    expect(await Attachment.find(replaced.id)).toBeNull()
+    expect(storedFiles()).not.toContain(replaced.path)
+
+    await http.put(`/posts/${created.id}`, form({ cover: image(PNG, 'd.png', 'image/png') })).assertRedirect()
+    const last = (await Post.findWithOrFail(created.id, 'cover')).cover!
+    await http.delete(`/posts/${created.id}`).assertRedirect()
+    expect(await Attachment.find(last.id)).toBeNull()
+    expect(storedFiles()).not.toContain(last.path)
+  })
+})
