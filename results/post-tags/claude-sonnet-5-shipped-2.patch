--- /dev/null
+++ b/app/Services/PostTags.ts
@@ -0,0 +1,39 @@
+import { PostTag, Tag } from '../Models/Tag.js'
+
+/** Tag names per post id, sorted alphabetically; posts without tags are absent. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>()
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.where({ postId: postIds }).get()
+  if (links.length === 0) return names
+
+  const tags = await Tag.where({ id: [...new Set(links.map((link) => link.tagId))] }).get()
+  const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name === undefined) continue
+    names.set(link.postId, [...(names.get(link.postId) ?? []), name])
+  }
+  for (const list of names.values()) list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  return names
+}
+
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const names = await tagNamesByPost(posts.map((post) => post.id))
+  return posts.map((post) => ({ ...post, tags: names.get(post.id) ?? [] }))
+}
+
+/** Makes the post carry exactly `names`, creating unseen tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const tagIds: number[] = []
+  for (const name of names) {
+    const existing = await Tag.first({ name })
+    const tag = existing ?? (await Tag.create({ name }))
+    tagIds.push(tag.id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const tagId of tagIds) await PostTag.create({ postId, tagId })
+}
