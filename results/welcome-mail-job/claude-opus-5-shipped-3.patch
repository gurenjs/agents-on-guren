+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,95 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import {
+  MemoryQueueDriver,
+  MemoryTransport,
+  createMailManager,
+  processJob,
+  setMailManager,
+  setQueueDriver,
+  type MailMessage,
+} from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+// Registration hands the welcome email to the queue instead of sending it
+// inline, so these tests hold the work (a memory driver, nothing draining it)
+// and record what a worker would deliver (a memory transport). That is the
+// same wiring QUEUE_CONNECTION=memory / MAIL_MAILER=memory selects, installed
+// here directly so the test does not depend on the environment it runs in.
+describe('register.store', () => {
+  let http: TestApp
+  let queue: MemoryQueueDriver
+  let mailer: MemoryTransport
+
+  const credentials = {
+    name: 'Ada Lovelace',
+    email: 'ada@example.com',
+    password: 'correct horse battery',
+    passwordConfirmation: 'correct horse battery',
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    queue = new MemoryQueueDriver()
+    setQueueDriver(queue)
+
+    mailer = new MemoryTransport()
+    const manager = createMailManager({
+      default: 'memory',
+      // The sender the app is configured with (MAIL_FROM_ADDRESS / MAIL_FROM_NAME).
+      from: app.container.make('mail').getDefaultFrom(),
+    })
+    manager.registerTransport('memory', () => mailer)
+    setMailManager(manager)
+  })
+
+  async function register(body: Record<string, string>) {
+    const csrf = await http.withCsrf()
+    return await csrf.post('/register', body)
+  }
+
+  it('queues the welcome email instead of sending it during sign-up', async () => {
+    ;(await register(credentials)).assertRedirect('/dashboard')
+
+    expect(mailer.count()).toBe(0)
+    expect(await queue.size('default')).toBe(1)
+  })
+
+  it('sends one welcome email when the queued work runs', async () => {
+    ;(await register(credentials)).assertRedirect('/dashboard')
+
+    expect(await processJob(queue, 'default')).toBe(true)
+
+    const messages: MailMessage[] = mailer.getMessages()
+    expect(messages).toHaveLength(1)
+
+    const [message] = messages
+    expect(message?.to).toEqual([{ email: 'ada@example.com', name: 'Ada Lovelace' }])
+    expect(message?.from?.email).toBe(process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com')
+    expect(message?.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(message?.text).toContain('Hi Ada Lovelace,')
+
+    // Nothing is left behind for a second worker to pick up.
+    expect(await queue.size('default')).toBe(0)
+  })
+
+  it('queues nothing when the registration is refused', async () => {
+    ;(await register({ ...credentials, email: 'not-an-email' })).assertUnprocessable()
+
+    // An address that is already taken is refused the same way.
+    ;(await register(credentials)).assertRedirect('/dashboard')
+    await processJob(queue, 'default')
+    mailer.clear()
+
+    ;(await register(credentials)).assertUnprocessable()
+
+    expect(await queue.size('default')).toBe(0)
+    expect(mailer.count()).toBe(0)
+  })
+})
