 import type { UserRecord } from '../../Models/User.js'
 import { PostResource, type PostResourceData } from '../Resources/PostResource.js'
-import { PostIdParamSchema, PostPayloadSchema, PostSearchSchema, ListPostsQuerySchema } from '../Validators/PostValidator.js'
+import { PostIdParamSchema, PostPayloadSchema, PostSearchSchema, ListPostsQuerySchema, ApiPostsIndexQuerySchema } from '../Validators/PostValidator.js'
 
 type PostsIndexProps = PaginatedPageProps<PostResourceData>
 
@@ -105,4 +105,26 @@ export default class PostController extends Controller {
 
     return this.redirect('/posts')
   }
+
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+
+    const query = Post.newQuery().with('author').orderBy('createdAt', 'desc')
+
+    if (author !== undefined) {
+      query.where('authorId', author)
+    }
+
+    const result = await query.paginate({ page, perPage: 10 })
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: {
+        currentPage: result.meta.currentPage,
+        lastPage: result.meta.totalPages,
+        perPage: result.meta.perPage,
+        total: result.meta.total,
+      },
+    })
+  }
 }
