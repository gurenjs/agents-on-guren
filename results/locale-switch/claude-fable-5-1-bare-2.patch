+// The languages the app ships a catalog for under lang/<locale>/. The first
+// one is the default. Plain data with no server imports, so the language
+// switcher in resources/js can read the same list the server validates against.
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number]
+
+// The cookie the framework's locale detection reads by default; POST /locale
+// writes the reader's pick to it.
+export const LOCALE_COOKIE = 'locale'
