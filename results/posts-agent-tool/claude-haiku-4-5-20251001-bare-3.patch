diff --git a/tests/McpEndpoint.test.ts b/tests/McpEndpoint.test.ts
new file mode 100644
index 0000000..bec047d
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,21 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// MCP endpoint tests. The endpoint requires bearer token authentication.
+// POST /mcp without a credential should answer 401 (or 403 if host is not authorized).
+// With valid bearer token, tools/list and tools/call should work.
+describe('MCP endpoint', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects requests without authorization', async () => {
+    const response = await http.post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list' })
+    // Endpoint returns 401 for missing bearer token, or 403 if host authorization rejects first
+    const isUnauthorized = response.status === 401 || response.status === 403
+    expect(isUnauthorized).toBe(true)
+  })
+})
