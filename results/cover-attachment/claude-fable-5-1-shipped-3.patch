+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { attachments } from '../db/schema.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+type AttachmentRow = typeof attachments.$inferSelect
+
+const CRC_TABLE = new Uint32Array(256).map((_, n) => {
+  let c = n
+  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1
+  return c >>> 0
+})
+
+function crc32(bytes: Uint8Array): number {
+  let crc = 0xffffffff
+  for (const byte of bytes) crc = CRC_TABLE[(crc ^ byte) & 0xff]! ^ (crc >>> 8)
+  return (crc ^ 0xffffffff) >>> 0
+}
+
+function pngChunk(type: string, data: Uint8Array): Uint8Array {
+  const typeBytes = new TextEncoder().encode(type)
+  const out = new Uint8Array(12 + data.length)
+  const view = new DataView(out.buffer)
+  view.setUint32(0, data.length)
+  out.set(typeBytes, 4)
+  out.set(data, 8)
+  const crcInput = new Uint8Array(4 + data.length)
+  crcInput.set(typeBytes)
+  crcInput.set(data, 4)
+  view.setUint32(8 + data.length, crc32(crcInput))
+  return out
+}
+
+// Random pixels so every fixture is unique: the test disk persists between
+// runs, and a repeated file would make "exactly one copy on disk" ambiguous.
+// IDAT needs a zlib stream (node's deflateSync); Bun.deflateSync is raw deflate.
+function makePng(width = 4, height = 4): Uint8Array<ArrayBuffer> {
+  const ihdr = new Uint8Array(13)
+  const view = new DataView(ihdr.buffer)
+  view.setUint32(0, width)
+  view.setUint32(4, height)
+  ihdr.set([8, 2, 0, 0, 0], 8)
+  const raw = new Uint8Array(height * (1 + width * 3))
+  for (let y = 0; y < height; y++) {
+    raw[y * (1 + width * 3)] = 0
+    crypto.getRandomValues(raw.subarray(y * (1 + width * 3) + 1, (y + 1) * (1 + width * 3)))
+  }
+  const parts = [
+    new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    pngChunk('IHDR', ihdr),
+    pngChunk('IDAT', new Uint8Array(deflateSync(raw))),
+    pngChunk('IEND', new Uint8Array(0)),
+  ]
+  const total = parts.reduce((sum, part) => sum + part.length, 0)
+  const png = new Uint8Array(new ArrayBuffer(total))
+  let offset = 0
+  for (const part of parts) {
+    png.set(part, offset)
+    offset += part.length
+  }
+  return png
+}
+
+async function makeJpeg(): Promise<Uint8Array<ArrayBuffer>> {
+  const bytes = await new Bun.Image(makePng(8, 8)).jpeg().bytes()
+  return new Uint8Array(new Uint8Array(bytes))
+}
+
+function makeGif(): Uint8Array<ArrayBuffer> {
+  return new Uint8Array([
+    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x01, 0x00, 0x01, 0x00, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0xff, 0xff, 0xff, 0x2c, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x02, 0x02, 0x44,
+    0x01, 0x00, 0x3b,
+  ])
+}
+
+function formData(fields: Record<string, string>, cover?: { bytes: Uint8Array<ArrayBuffer>; type: string; name: string }): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries(fields)) form.append(key, value)
+  if (cover) form.append('cover', new File([cover.bytes], cover.name, { type: cover.type }))
+  return form
+}
+
+const fields = (suffix: string) => ({ title: `Cover ${suffix}`, excerpt: `Excerpt ${suffix}`, body: `Body ${suffix}` })
+
+async function coverRows(postId: number): Promise<AttachmentRow[]> {
+  return (await Attachment.where({ attachableId: String(postId), collection: 'cover' }).get()) as AttachmentRow[]
+}
+
+async function filesHolding(root: string, bytes: Uint8Array): Promise<string[]> {
+  let entries: Array<{ name: string; parentPath: string; isFile(): boolean }>
+  try {
+    entries = await readdir(root, { recursive: true, withFileTypes: true })
+  } catch {
+    return []
+  }
+  const hits: string[] = []
+  for (const entry of entries) {
+    if (!entry.isFile()) continue
+    const path = join(entry.parentPath, entry.name)
+    const content = await readFile(path)
+    if (content.length === bytes.length && content.equals(bytes)) hits.push(path)
+  }
+  return hits
+}
+
+async function showProps(http: TestApp, id: number): Promise<{ coverUrl: string | null }> {
+  const res = await http.get(`/posts/${id}`)
+  res.assertOk()
+  const { payload } = await readInertiaResponse(res.raw)
+  return (payload.props as { post: { coverUrl: string | null } }).post
+}
+
+async function lastPostId(): Promise<number> {
+  const post = await Post.newQuery().orderBy('id', 'desc').firstOrFail()
+  return post.id
+}
+
+describe('post cover images', () => {
+  let http: TestApp
+  let author: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = (await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+    author = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  it('creates a post with a PNG cover, serves it byte for byte, and keeps it under storage/', async () => {
+    const png = makePng()
+    await author.post('/posts', formData(fields('png'), { bytes: png, type: 'image/png', name: 'cover.png' })).assertRedirect()
+    const id = await lastPostId()
+
+    const { coverUrl } = await showProps(http, id)
+    expect(coverUrl).toBeString()
+
+    const served = await http.get(coverUrl!)
+    served.assertOk()
+    expect(served.headers.get('content-type')).toStartWith('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(png)
+
+    expect(await coverRows(id)).toHaveLength(1)
+    expect(await filesHolding('storage', png)).toHaveLength(1)
+    expect(await filesHolding('public', png)).toHaveLength(0)
+
+    const index = await http.get('/posts')
+    const { payload } = await readInertiaResponse(index.raw)
+    const listed = (payload.props as { data: Array<{ id: number; coverUrl: string | null }> }).data.find((p) => p.id === id)
+    expect(new URL(listed!.coverUrl!, 'http://localhost').pathname).toBe(new URL(coverUrl!, 'http://localhost').pathname)
+  })
+
+  it('accepts a JPEG cover and reports image/jpeg', async () => {
+    const jpeg = await makeJpeg()
+    await author.post('/posts', formData(fields('jpeg'), { bytes: jpeg, type: 'image/jpeg', name: 'cover.jpg' })).assertRedirect()
+    const { coverUrl } = await showProps(http, await lastPostId())
+    const served = await http.get(coverUrl!)
+    served.assertOk()
+    expect(served.headers.get('content-type')).toStartWith('image/jpeg')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(jpeg)
+  })
+
+  it('creates a post without a cover and reports coverUrl null', async () => {
+    await author.post('/posts', formData(fields('none'))).assertRedirect()
+    const id = await lastPostId()
+    expect((await showProps(http, id)).coverUrl).toBeNull()
+    expect(await coverRows(id)).toHaveLength(0)
+  })
+
+  it('refuses a GIF and an oversized PNG with a 422 on `cover` and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+
+    const gif = await author.post('/posts', formData(fields('gif'), { bytes: makeGif(), type: 'image/gif', name: 'cover.gif' }))
+    gif.assertStatus(422)
+    expect((await gif.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeDefined()
+
+    const big = new Uint8Array(new ArrayBuffer(2 * 1024 * 1024 + 1))
+    big.set(makePng())
+    const oversized = await author.post('/posts', formData(fields('big'), { bytes: big, type: 'image/png', name: 'big.png' }))
+    oversized.assertStatus(422)
+    expect((await oversized.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeDefined()
+
+    expect(await Post.newQuery().count()).toBe(before)
+    expect(await filesHolding('storage', makeGif())).toHaveLength(0)
+  })
+
+  it('replaces the cover on edit and deletes the old file and row', async () => {
+    const first = makePng()
+    await author.post('/posts', formData(fields('replace'), { bytes: first, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const id = await lastPostId()
+    const { coverUrl: oldUrl } = await showProps(http, id)
+
+    const second = makePng()
+    await author.put(`/posts/${id}`, formData(fields('replaced'), { bytes: second, type: 'image/png', name: 'b.png' })).assertRedirect()
+
+    const { coverUrl } = await showProps(http, id)
+    expect(new Uint8Array(await (await http.get(coverUrl!)).raw.arrayBuffer())).toEqual(second)
+    expect((await http.get(oldUrl!)).status).not.toBe(200)
+    expect(await coverRows(id)).toHaveLength(1)
+    expect(await filesHolding('storage', first)).toHaveLength(0)
+    expect(await filesHolding('storage', second)).toHaveLength(1)
+  })
+
+  it('keeps the cover when editing without a file, and when the upload is refused', async () => {
+    const png = makePng()
+    await author.post('/posts', formData(fields('keep'), { bytes: png, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const id = await lastPostId()
+
+    await author.put(`/posts/${id}`, formData(fields('kept'))).assertRedirect()
+    expect((await showProps(http, id)).coverUrl).toBeString()
+
+    await author.put(`/posts/${id}`, formData(fields('gif'), { bytes: makeGif(), type: 'image/gif', name: 'c.gif' })).assertStatus(422)
+    const post = await Post.findOrFail(id)
+    expect(post.title).toBe('Cover kept')
+    expect(await coverRows(id)).toHaveLength(1)
+    expect(await filesHolding('storage', png)).toHaveLength(1)
+  })
+
+  it('removes the cover when removeCover=1 is sent', async () => {
+    const png = makePng()
+    await author.post('/posts', formData(fields('remove'), { bytes: png, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const id = await lastPostId()
+    const { coverUrl } = await showProps(http, id)
+
+    await author.put(`/posts/${id}`, formData({ ...fields('removed'), removeCover: '1' })).assertRedirect()
+
+    expect((await showProps(http, id)).coverUrl).toBeNull()
+    expect((await http.get(coverUrl!)).status).not.toBe(200)
+    expect(await coverRows(id)).toHaveLength(0)
+    expect(await filesHolding('storage', png)).toHaveLength(0)
+  })
+
+  it('deletes the cover file and row with the post', async () => {
+    const png = makePng()
+    await author.post('/posts', formData(fields('delete'), { bytes: png, type: 'image/png', name: 'a.png' })).assertRedirect()
+    const id = await lastPostId()
+    const { coverUrl } = await showProps(http, id)
+
+    await author.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    expect((await http.get(coverUrl!)).status).not.toBe(200)
+    expect(await coverRows(id)).toHaveLength(0)
+    expect(await filesHolding('storage', png)).toHaveLength(0)
+  })
+
+  it('still accepts the JSON body Inertia sends when no file is picked', async () => {
+    const json = author.json()
+    await json.post('/posts', fields('json')).assertRedirect()
+    const id = await lastPostId()
+    await json.put(`/posts/${id}`, { ...fields('json edited'), removeCover: false }).assertRedirect()
+    expect((await Post.findOrFail(id)).title).toBe('Cover json edited')
+  })
+})
