+/**
+ * Findings `bunx guren audit` may skip, each with the reason it is safe. Keys
+ * are the exact `finding.key` values `guren audit --json` prints; an entry that
+ * matches nothing is reported as stale so this list cannot rot.
+ */
+export default {
+  ignore: [
+    {
+      key: 'authz:POST /locale',
+      reason:
+        'The language switcher is meant for guests as well as signed-in readers. It only writes the locale cookie, ' +
+        'accepts nothing but the two supported locales, and sits behind the app-wide CSRF check.',
+    },
+  ],
+}
