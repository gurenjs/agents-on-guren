@@ -0,0 +1,153 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, type TestResponse } from '@guren/testing'
+// The host application, by the path every Guren app keeps it at. The module
+// owns no database connection of its own, so its feature tests run against
+// the app that mounts it, whose boot applies the pending migrations.
+import app from '../../../../src/app.js'
+import { Subscription } from '../../app/Models/Subscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+async function expectEmailError(response: TestResponse): Promise<void> {
+  expect(response.status).toBe(422)
+  const { errors } = await response.json<{ errors: Record<string, unknown> }>()
+  expect(Object.keys(errors)).toEqual(['email'])
+}
+
+describe('SubscriptionController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    // Guests post with the CSRF cookie and header a browser would send.
+    http = (await booted.withCsrf('/health')).json().withHeader('Referer', REFERER)
+  })
+
+  beforeEach(async () => {
+    for (const { id } of await Subscription.all()) {
+      await Subscription.delete({ id })
+    }
+  })
+
+  describe('subscribe', () => {
+    it('stores a pending subscription and returns to the previous page', async () => {
+      const response = await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe(REFERER)
+
+      const rows = await Subscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0]?.email).toBe('reader@example.com')
+      expect(rows[0]?.confirmedAt).toBeNull()
+      expect(rows[0]?.token).toMatch(/^[0-9a-f]{64}$/)
+    })
+
+    it('issues a different token for every subscription', async () => {
+      await http.post('/newsletter/subscribe', { email: 'first@example.com' })
+      await http.post('/newsletter/subscribe', { email: 'second@example.com' })
+
+      const tokens = (await Subscription.all()).map((row) => row.token)
+      expect(new Set(tokens).size).toBe(2)
+    })
+
+    it('ignores a token sent with the request', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com', token: 'chosen-by-the-visitor' })
+
+      const row = await Subscription.first({ email: 'reader@example.com' })
+      expect(row?.token).not.toBe('chosen-by-the-visitor')
+    })
+
+    it('returns home when the previous page is on another site', async () => {
+      const response = await http
+        .withHeader('Referer', 'https://elsewhere.example/landing')
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      expect(response.headers.get('Location')).toBe('/')
+    })
+
+    it('returns home without a previous page', async () => {
+      const response = await http
+        .withHeader('Referer', '')
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      expect(response.headers.get('Location')).toBe('/')
+    })
+
+    it.each([[''], ['not-an-email']])('rejects the address %p', async (email) => {
+      await expectEmailError(await http.post('/newsletter/subscribe', { email }))
+
+      expect(await Subscription.all()).toHaveLength(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+      const before = await Subscription.all()
+
+      await expectEmailError(await http.post('/newsletter/subscribe', { email: 'Reader@Example.com' }))
+
+      expect(await Subscription.all()).toEqual(before)
+    })
+  })
+
+  describe('confirm', () => {
+    it('confirms the subscription and redirects home', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+      const pending = await Subscription.first({ email: 'reader@example.com' })
+
+      const response = await http.get(`/newsletter/confirm/${pending?.token}`)
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe('/')
+
+      const confirmed = await Subscription.first({ email: 'reader@example.com' })
+      expect(confirmed?.confirmedAt).toEqual(expect.any(String))
+    })
+
+    it('keeps the first confirmation time when the link is followed again', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+      const pending = await Subscription.first({ email: 'reader@example.com' })
+      await Subscription.forceUpdate({ id: pending?.id }, { confirmedAt: '2026-01-01T00:00:00.000Z' })
+
+      const response = await http.get(`/newsletter/confirm/${pending?.token}`)
+
+      expect([302, 303]).toContain(response.status)
+      const row = await Subscription.first({ email: 'reader@example.com' })
+      expect(row?.confirmedAt).toBe('2026-01-01T00:00:00.000Z')
+    })
+
+    it('answers 404 to a token that was never issued', async () => {
+      await http.post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      await http.get('/newsletter/confirm/never-issued').assertNotFound()
+
+      const row = await Subscription.first({ email: 'reader@example.com' })
+      expect(row?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('unsubscribe', () => {
+    it('deletes that subscription only and returns to the previous page', async () => {
+      await http.post('/newsletter/subscribe', { email: 'leaving@example.com' })
+      await http.post('/newsletter/subscribe', { email: 'staying@example.com' })
+
+      const response = await http.post('/newsletter/unsubscribe', { email: 'leaving@example.com' })
+
+      expect([302, 303]).toContain(response.status)
+      expect(response.headers.get('Location')).toBe(REFERER)
+
+      const emails = (await Subscription.all()).map((row) => row.email)
+      expect(emails).toEqual(['staying@example.com'])
+    })
+
+    it('answers an address it does not have the same way', async () => {
+      const response = await http.post('/newsletter/unsubscribe', { email: 'stranger@example.com' })
+
+      expect([302, 303]).toContain(response.status)
+    })
+
+    it('rejects an invalid address', async () => {
+      await expectEmailError(await http.post('/newsletter/unsubscribe', { email: 'not-an-email' }))
+    })
+  })
+})
