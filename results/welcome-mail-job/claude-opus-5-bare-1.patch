diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..252336c
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,40 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+/**
+ * The name and address are carried in the payload rather than looked up from a
+ * user id: the message is addressed to whoever registered, and the worker that
+ * finally runs this may live in another process entirely.
+ */
+export interface SendWelcomeEmailJobPayload {
+  name: string
+  email: string
+}
+
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  // Pinned so queued messages survive a rename or a bundler that mangles
+  // class names — the worker resolves the class back from this name.
+  static override jobName = 'SendWelcomeEmailJob'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ name, email }: SendWelcomeEmailJobPayload): Promise<void> {
+    // Jobs run outside the request, where the container is out of reach, so
+    // the manager comes from the global MailProvider.boot() published.
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured. Register app/Providers/MailProvider.ts.')
+    }
+
+    const result = await new WelcomeMail(manager, name).to(email).send()
+    // A transport reports delivery failures rather than throwing, and a job
+    // only retries on a thrown error.
+    if (!result.success) {
+      throw new Error(result.error ?? 'The mail transport rejected the welcome email.')
+    }
+  }
+
+  async failed({ email }: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${email}:`, error.message)
+  }
+}
