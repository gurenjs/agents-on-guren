diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..b23164e
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,262 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { readdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { resetDatabase } from '../config/database.js'
+import { COVER_MAX_BYTES } from '../app/Http/Validators/PostValidator.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// 1x1 images, small enough to inline. The JPEG has no end-of-image marker:
+// browsers display it, Bun.Image refuses to decode it, and it must be accepted.
+const PNG = Buffer.from(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==',
+  'base64',
+)
+const JPEG = Buffer.from(
+  '/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=',
+  'base64',
+)
+const GIF = Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', 'base64')
+// Decoders stop at the PNG's IEND chunk, so the padding only adds bytes.
+const OVERSIZED_PNG = Buffer.concat([PNG, Buffer.alloc(COVER_MAX_BYTES)])
+
+// config/storage.ts roots the `local` disk here under NODE_ENV=test.
+const STORAGE_ROOT = 'storage/app/testing'
+
+const TEXT = { title: 'A post', excerpt: 'An excerpt', body: 'A body' }
+
+interface Upload {
+  bytes: Buffer
+  name: string
+  type: string
+}
+
+const png: Upload = { bytes: PNG, name: 'cover.png', type: 'image/png' }
+const jpeg: Upload = { bytes: JPEG, name: 'cover.jpg', type: 'image/jpeg' }
+
+function form(fields: Record<string, string>, cover?: Upload): FormData {
+  const data = new FormData()
+  for (const [name, value] of Object.entries(fields)) {
+    data.append(name, value)
+  }
+  if (cover) {
+    data.append('cover', new File([new Uint8Array(cover.bytes)], cover.name, { type: cover.type }))
+  }
+  return data
+}
+
+async function storedFiles(root: string): Promise<string[]> {
+  const entries = await readdir(root, { recursive: true, withFileTypes: true }).catch(() => [])
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+async function isStored(root: string, bytes: Buffer): Promise<boolean> {
+  for (const path of await storedFiles(root)) {
+    if (Buffer.from(await Bun.file(path).arrayBuffer()).equals(bytes)) {
+      return true
+    }
+  }
+  return false
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+  })
+
+  afterAll(async () => {
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+  })
+
+  async function asAuthor(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function createPost(cover?: Upload): Promise<number> {
+    const client = await asAuthor()
+    await client.post('/posts', form(TEXT, cover)).assertRedirect()
+    const [post] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+    return post.id
+  }
+
+  async function coverUrlOf(postId: number): Promise<string | null> {
+    const response = await http.json().get(`/posts/${postId}`)
+    const page = await response.json<{ props: { post: { coverUrl: string | null } } }>()
+    return page.props.post.coverUrl
+  }
+
+  it('creates a post without a cover', async () => {
+    const postId = await createPost()
+
+    expect(await coverUrlOf(postId)).toBeNull()
+    expect(await Attachment.all()).toHaveLength(0)
+  })
+
+  for (const upload of [png, jpeg]) {
+    it(`stores a ${upload.type} cover and serves it back unchanged`, async () => {
+      const postId = await createPost(upload)
+
+      const coverUrl = await coverUrlOf(postId)
+      expect(coverUrl).toBeString()
+      const served = await http.get(coverUrl!)
+      served.assertOk()
+      expect(served.headers.get('content-type')).toBe(upload.type)
+      expect(Buffer.from(await served.raw.arrayBuffer()).equals(upload.bytes)).toBe(true)
+
+      expect(await Attachment.all()).toHaveLength(1)
+      expect(await isStored('storage', upload.bytes)).toBe(true)
+      expect(await isStored('public', upload.bytes)).toBe(false)
+    })
+  }
+
+  it('accepts a cover of exactly 2 MB', async () => {
+    const bytes = Buffer.concat([PNG, Buffer.alloc(COVER_MAX_BYTES - PNG.length)])
+
+    const postId = await createPost({ bytes, name: 'cover.png', type: 'image/png' })
+
+    const served = await http.get((await coverUrlOf(postId))!)
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(bytes)).toBe(true)
+  })
+
+  it('lists the cover on the posts index', async () => {
+    const withCover = await createPost(png)
+    const without = await createPost()
+
+    const response = await http.json().get('/posts')
+    const page = await response.json<{ props: { data: { id: number; coverUrl: string | null }[] } }>()
+    const byId = new Map(page.props.data.map((post) => [post.id, post.coverUrl]))
+
+    expect(byId.get(without)).toBeNull()
+    await http.get(byId.get(withCover)!).assertOk()
+  })
+
+  for (const [label, upload] of [
+    ['a GIF', { bytes: GIF, name: 'cover.gif', type: 'image/gif' }],
+    ['a GIF declared as a PNG', { bytes: GIF, name: 'cover.png', type: 'image/png' }],
+    ['a PNG over 2 MB', { bytes: OVERSIZED_PNG, name: 'cover.png', type: 'image/png' }],
+    ['a PNG of 12 MB', { bytes: Buffer.concat([PNG, Buffer.alloc(12 * 1024 * 1024)]), name: 'cover.png', type: 'image/png' }],
+  ] as const) {
+    it(`refuses ${label} on create and saves nothing`, async () => {
+      const client = await asAuthor()
+
+      const response = await client.json().post('/posts', form(TEXT, upload))
+      response.assertStatus(422)
+      const body = await response.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.cover).toBeArray()
+
+      expect(await Post.all()).toHaveLength(0)
+      expect(await Attachment.all()).toHaveLength(0)
+      expect(await storedFiles('storage')).toHaveLength(0)
+    })
+
+    it(`refuses ${label} on edit and keeps the post as it was`, async () => {
+      const postId = await createPost(jpeg)
+      const coverUrl = await coverUrlOf(postId)
+      const client = await asAuthor()
+
+      await client
+        .json()
+        .put(`/posts/${postId}`, form({ ...TEXT, title: 'Changed' }, upload))
+        .assertStatus(422)
+
+      expect((await Post.findOrFail(postId)).title).toBe(TEXT.title)
+      expect(await Attachment.all()).toHaveLength(1)
+      expect(await storedFiles('storage')).toHaveLength(1)
+      await http.get(coverUrl!).assertOk()
+    })
+  }
+
+  it('reports a bad cover the way it reports an empty title', async () => {
+    const client = await asAuthor()
+
+    const emptyTitle = await client.json().post('/posts', form({ ...TEXT, title: '' }))
+    const badCover = await client.json().post('/posts', form(TEXT, { bytes: GIF, name: 'cover.gif', type: 'image/gif' }))
+
+    expect(badCover.status).toBe(emptyTitle.status)
+    expect(badCover.headers.get('content-type')).toBe(emptyTitle.headers.get('content-type'))
+    const titleBody = await emptyTitle.json<{ message: string; errors: Record<string, string[]> }>()
+    const coverBody = await badCover.json<{ message: string; errors: Record<string, string[]> }>()
+    expect(coverBody.message).toBe(titleBody.message)
+    expect(Object.keys(titleBody.errors)).toEqual(['title'])
+    expect(Object.keys(coverBody.errors)).toEqual(['cover'])
+  })
+
+  it('replaces the cover and deletes the old file', async () => {
+    const postId = await createPost(png)
+    const oldUrl = await coverUrlOf(postId)
+    const client = await asAuthor()
+
+    await client.put(`/posts/${postId}`, form(TEXT, jpeg)).assertRedirect(`/posts/${postId}`)
+
+    const newUrl = await coverUrlOf(postId)
+    expect(newUrl).not.toBe(oldUrl)
+    const served = await http.get(newUrl!)
+    expect(served.headers.get('content-type')).toBe('image/jpeg')
+    await http.get(oldUrl!).assertNotFound()
+    expect(await Attachment.all()).toHaveLength(1)
+    expect(await isStored('storage', PNG)).toBe(false)
+    expect(await isStored('storage', JPEG)).toBe(true)
+  })
+
+  it('removes the cover when removeCover is ticked', async () => {
+    const postId = await createPost(png)
+    const oldUrl = await coverUrlOf(postId)
+    const client = await asAuthor()
+
+    await client.put(`/posts/${postId}`, form({ ...TEXT, removeCover: '1' })).assertRedirect(`/posts/${postId}`)
+
+    expect(await coverUrlOf(postId)).toBeNull()
+    await http.get(oldUrl!).assertNotFound()
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles('storage')).toHaveLength(0)
+  })
+
+  it('keeps the cover on an edit that neither uploads nor removes', async () => {
+    const postId = await createPost(png)
+    const coverUrl = await coverUrlOf(postId)
+    const client = await asAuthor()
+
+    await client.json().put(`/posts/${postId}`, { ...TEXT, title: 'Changed' }).assertRedirect(`/posts/${postId}`)
+    await client.put(`/posts/${postId}`, form({ ...TEXT, removeCover: '0' })).assertRedirect(`/posts/${postId}`)
+
+    expect((await Post.findOrFail(postId)).title).toBe(TEXT.title)
+    expect(await Attachment.all()).toHaveLength(1)
+    await http.get(coverUrl!).assertOk()
+  })
+
+  it('deletes the cover with its post', async () => {
+    const postId = await createPost(png)
+    const coverUrl = await coverUrlOf(postId)
+    const client = await asAuthor()
+
+    await client.delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles('storage')).toHaveLength(0)
+    await http.get(coverUrl!).assertNotFound()
+  })
+
+  it("leaves another author's cover alone", async () => {
+    const postId = await createPost(png)
+    const stranger = await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret-password' })
+    const client = await http.actingAs(stranger).withCsrf()
+
+    await client.put(`/posts/${postId}`, form({ ...TEXT, removeCover: '1' }, jpeg)).assertForbidden()
+
+    expect(await Attachment.all()).toHaveLength(1)
+    expect(await isStored('storage', PNG)).toBe(true)
+  })
+})
