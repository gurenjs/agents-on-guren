+++ b/modules/newsletter/newsletter.test.ts
@@ -0,0 +1,45 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { migrateDatabase } from '../../config/database.js'
+import app from '../../src/app.js'
+import { Subscription } from './Subscription.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = (await (await TestApp.fromApp(app)).withCsrf()).withHeaders({ Referer: 'http://localhost/posts' })
+  })
+
+  beforeEach(async () => {
+    await Subscription.delete({})
+  })
+
+  it('subscribes, confirms and unsubscribes', async () => {
+    const res = await http.post('/newsletter/subscribe', { email: 'a@example.com' })
+    expect([302, 303]).toContain(res.status)
+
+    const [row] = await Subscription.where({ email: 'a@example.com' })
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+
+    const confirmed = await http.get(`/newsletter/confirm/${row!.token}`)
+    expect([302, 303]).toContain(confirmed.status)
+    expect((await Subscription.where({ email: 'a@example.com' }))[0]?.confirmedAt).not.toBeNull()
+
+    await http.post('/newsletter/unsubscribe', { email: 'a@example.com' })
+    expect(await Subscription.where({ email: 'a@example.com' })).toHaveLength(0)
+  })
+
+  it('rejects invalid and duplicate emails', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    await http.post('/newsletter/subscribe', { email: 'b@example.com' })
+    await http.post('/newsletter/subscribe', { email: 'b@example.com' }).assertStatus(422)
+    expect(await Subscription.all()).toHaveLength(1)
+  })
+
+  it('404s on an unknown token', async () => {
+    await http.get('/newsletter/confirm/nope').assertStatus(404)
+  })
+})
