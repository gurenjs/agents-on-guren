+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,32 @@
+import { Mail, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+
+/**
+ * The greeting every newly registered account receives.
+ *
+ * The sender comes from the manager's configured default (MAIL_FROM_ADDRESS /
+ * MAIL_FROM_NAME — see app/Providers/MailProvider.ts), so only the recipient
+ * has to be addressed: `new WelcomeMail(manager, name).to(email).send()`.
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    private readonly recipientName: string,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const app = appName()
+
+    return this.subject(`Welcome to ${app}, ${this.recipientName}!`).text(
+      [
+        `Hi ${this.recipientName},`,
+        '',
+        `Welcome to ${app}! Your account is ready — sign in any time to write your first post.`,
+        '',
+        `— The ${app} team`,
+      ].join('\n'),
+    )
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..b3231d1
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,39 @@
+import { ServiceProvider, createMailManager, setMailManager, type MailAddress, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+
+/**
+ * Every message the app sends is from this address — MAIL_FROM_ADDRESS /
+ * MAIL_FROM_NAME in .env — unless a mailable overrides it with `from()`.
+ */
+function defaultFrom(): MailAddress {
+  return {
+    email: process.env.MAIL_FROM_ADDRESS?.trim() || 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME?.trim() || appName(),
+  }
+}
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    const manager = createMailManager({
+      // MAIL_MAILER picks the transport: 'log' writes the message to the
+      // server output (development), 'resend' delivers it (production),
+      // 'memory' keeps it inspectable in tests. Mailables never name one,
+      // so switching is env-only.
+      default: process.env.MAIL_MAILER?.trim() || 'log',
+      from: defaultFrom(),
+      transports: {
+        log: { driver: 'log' },
+        memory: { driver: 'memory' },
+        resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+      },
+    })
+
+    this.container.instance('mail', manager)
+  }
+
+  boot(): void {
+    // Queued mail is sent from a worker, where the container is out of reach —
+    // app/Jobs/SendWelcomeEmailJob.ts reads the manager from here.
+    setMailManager(this.container.make<MailManager>('mail'))
+  }
+}
diff --git a/app/Providers/QueueProvider.ts b/app/Providers/QueueProvider.ts
new file mode 100644
index 0000000..71ac757
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,44 @@
+import {
+  ServiceProvider,
+  MemoryDriver,
+  RedisDriver,
+  SyncDriver,
+  createQueueManager,
+  registerJob,
+  type QueueDriverFactory,
+  type QueueManager,
+} from '@guren/core'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  async register(): Promise<void> {
+    // QUEUE_CONNECTION picks the driver: 'sync' runs jobs inline on dispatch
+    // (development, no worker process needed), 'memory' holds them for a
+    // Worker in the same process, 'redis' hands them to a worker process.
+    // Dispatching code never names a driver, so switching is env-only.
+    const connection = process.env.QUEUE_CONNECTION?.trim() || 'sync'
+
+    const drivers: Record<string, QueueDriverFactory> = {
+      sync: () => new SyncDriver(),
+      memory: () => new MemoryDriver(),
+    }
+
+    // Imported only when the connection actually needs it: createRedisClient
+    // pulls in ioredis, which a bundle for an edge runtime cannot carry.
+    if (connection === 'redis') {
+      const { createRedisClient } = await import('@guren/core/redis')
+      drivers.redis = () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL || undefined }))
+    }
+
+    this.container.instance('queue', createQueueManager({ default: connection, drivers }))
+  }
+
+  boot(): void {
+    // Register job classes before the driver so sync dispatches — which run
+    // the job right where it is dispatched — can resolve them.
+    registerJob(SendWelcomeEmailJob)
+
+    // Resolving the default driver is what publishes it to Job.dispatch().
+    this.container.make<QueueManager>('queue').driver()
+  }
+}
