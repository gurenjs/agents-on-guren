diff --git a/tests/PostExcerpt.test.ts b/tests/PostExcerpt.test.ts
new file mode 100644
index 0000000..f6d269b
--- /dev/null
+++ b/tests/PostExcerpt.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from 'bun:test'
+import { Post } from '../app/Models/Post.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+const SENTENCE = 'The quick brown fox jumps over the lazy dog. '
+
+describe('Post.excerptFrom', () => {
+  it('keeps a short body whole, without an ellipsis', () => {
+    expect(Post.excerptFrom('  A short post body.  ')).toBe('A short post body.')
+  })
+
+  it('keeps a body of exactly 140 characters whole', () => {
+    const body = 'a'.repeat(140)
+    expect(Post.excerptFrom(body)).toBe(body)
+  })
+
+  it('cuts back to the last word boundary when the cut splits a word', () => {
+    // 150 characters: the first 140 end mid-way through "quick".
+    const body = `${SENTENCE.repeat(3)}The quick brown`
+    expect(body.length).toBe(150)
+
+    const excerpt = Post.excerptFrom(body)
+    expect(excerpt).toBe(`${SENTENCE.repeat(3)}The…`)
+    expect(excerpt.length).toBe(139)
+  })
+
+  it('keeps all 140 characters when the cut lands on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+
+    const excerpt = Post.excerptFrom(body)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt.length).toBe(141)
+  })
+
+  it('cuts at 140 when the opening holds no whitespace at all', () => {
+    const body = `${'a'.repeat(200)} tail`
+    expect(Post.excerptFrom(body)).toBe(`${'a'.repeat(140)}…`)
+  })
+
+  it('trims the leading and trailing whitespace of the body first', () => {
+    const body = `\n\n  ${SENTENCE.repeat(4)}  \n`
+    expect(Post.excerptFrom(body).endsWith('…')).toBe(true)
+    expect(Post.excerptFrom(body).startsWith('The quick')).toBe(true)
+  })
+})
+
+describe('PostPayloadSchema', () => {
+  it('accepts a payload without an excerpt', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'A title', body: 'A body' })
+    expect(result.success).toBe(true)
+    expect(result.data?.excerpt).toBeUndefined()
+  })
+
+  it('treats a whitespace-only excerpt as blank', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'A title', excerpt: '   ', body: 'A body' })
+    expect(result.success).toBe(true)
+    expect(result.data?.excerpt).toBe('')
+  })
+
+  it('keeps a provided excerpt, trimmed', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'A title', excerpt: '  Mine  ', body: 'A body' })
+    expect(result.data?.excerpt).toBe('Mine')
+  })
+
+  it('still refuses a blank title or body', () => {
+    expect(PostPayloadSchema.safeParse({ title: '  ', body: 'A body' }).success).toBe(false)
+    expect(PostPayloadSchema.safeParse({ title: 'A title', body: '  ' }).success).toBe(false)
+  })
+})
