diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..7c5fb71
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,143 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Personal API tokens: created and revoked from a signed-in session, then used
+// alone (no session cookie) as `Authorization: Bearer <token>` on /api/posts.
+
+let http: TestApp
+// Carries the session and XSRF-TOKEN cookies, like a signed-in browser tab.
+let browser: TestApp
+let owner: UserRecord
+let other: UserRecord
+
+async function createUser(label: string): Promise<UserRecord> {
+  const email = `${label}-${crypto.randomUUID()}@example.test`
+  await User.create({ name: label, email, password: 'password123' })
+  const [user] = await User.where({ email }).get()
+  return user as UserRecord
+}
+
+async function createToken(user: UserRecord, name = 'CI'): Promise<{ id: string; name: string; token: string }> {
+  const response = await browser.actingAs(user).json().post('/profile/tokens', { name })
+  response.assertStatus(201)
+  return (await response.json()) as { id: string; name: string; token: string }
+}
+
+function bearer(token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
+
+describe('personal API tokens', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    browser = await http.withCsrf('/login')
+    owner = await createUser('owner')
+    other = await createUser('other')
+  })
+
+  it('creates a token shown once and stores only a hash of it', async () => {
+    const created = await createToken(owner, 'old laptop')
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const [row] = await ApiToken.where({ id: created.id }).get()
+    expect(row).toBeDefined()
+    for (const value of Object.values(row as Record<string, unknown>)) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name', async () => {
+    const before = (await ApiToken.where({ userId: owner.id }).get()).length
+    const client = browser.actingAs(owner).json()
+    await client.post('/profile/tokens', {}).assertStatus(422)
+    await client.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await client.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+    expect((await ApiToken.where({ userId: owner.id }).get()).length).toBe(before)
+  })
+
+  it('lists posts for a valid bearer token, newest first', async () => {
+    const { token } = await createToken(owner)
+    const response = await bearer(token).get('/api/posts')
+    response.assertStatus(200)
+    const { data } = (await response.json()) as { data: Array<{ id: number; createdAt: string }> }
+    expect(Array.isArray(data)).toBe(true)
+    for (let i = 1; i < data.length; i++) {
+      expect(data[i - 1]!.createdAt >= data[i]!.createdAt).toBe(true)
+    }
+  })
+
+  it('creates a post owned by the token owner whatever the body says', async () => {
+    const { token } = await createToken(owner)
+    const response = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What shipped',
+      body: 'Everything.',
+      authorId: other.id,
+    })
+    response.assertStatus(201)
+    const { data } = (await response.json()) as { data: { id: number; authorId: number; createdAt: string } }
+    expect(data.authorId).toBe(owner.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+  })
+
+  it('answers 422 for input the web form would reject, creating nothing', async () => {
+    const { token } = await createToken(owner)
+    const before = (await Post.all()).length
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x', body: 'y' }).assertStatus(422)
+    await bearer(token).post('/api/posts', { title: 'x', excerpt: 'y' }).assertStatus(422)
+    expect((await Post.all()).length).toBe(before)
+  })
+
+  it('answers 401 as JSON for missing, unknown or tampered tokens', async () => {
+    const { token } = await createToken(owner)
+    await http.json().get('/api/posts').assertStatus(401)
+    await bearer('not-a-token').get('/api/posts').assertStatus(401)
+    await bearer(`${token}x`).get('/api/posts').assertStatus(401)
+    await bearer(token.replace(/^[^|]+/, 'unknown')).get('/api/posts').assertStatus(401)
+
+    const before = (await Post.all()).length
+    await bearer('not-a-token').post('/api/posts', { title: 'a', excerpt: 'b', body: 'c' }).assertStatus(401)
+    expect((await Post.all()).length).toBe(before)
+  })
+
+  it('revokes only the owner\'s own token', async () => {
+    const revoked = await createToken(owner)
+    const kept = await createToken(owner)
+    const foreign = await createToken(other)
+
+    await browser.actingAs(owner).json().delete(`/profile/tokens/${foreign.id}`).assertStatus(404)
+    await bearer(foreign.token).get('/api/posts').assertStatus(200)
+
+    await browser.actingAs(owner).json().delete(`/profile/tokens/${revoked.id}`).assertStatus(204)
+    await bearer(revoked.token).get('/api/posts').assertStatus(401)
+    await bearer(kept.token).get('/api/posts').assertStatus(200)
+  })
+
+  it('does not let a bearer token manage tokens', async () => {
+    const { token } = await createToken(owner)
+    const response = await bearer(token).post('/profile/tokens', { name: 'minted' })
+    expect([401, 403]).toContain(response.status)
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const limited = await createToken(owner, 'limited')
+    const fresh = await createToken(owner, 'fresh')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(limited.token).get('/api/posts').assertStatus(200)
+    }
+    const response = await bearer(limited.token).get('/api/posts')
+    response.assertStatus(429)
+    const retryAfter = Number(response.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(fresh.token).get('/api/posts').assertStatus(200)
+  })
+})
