diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..72cd4cb
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,252 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { readdir, readFile, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { TestApp } from '@guren/testing'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Attachment } from '../config/attachments.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+// Cover images on posts, through the real app: uploads go in as
+// multipart/form-data, land under storage/ (config/storage.ts roots the test
+// disk at storage/app/testing) and come back through the URL the pages get.
+
+const STORAGE_ROOT = 'storage/app/testing'
+
+const PNG = Buffer.from(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==',
+  'base64',
+)
+const JPEG = Buffer.from(
+  '/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=',
+  'base64',
+)
+const GIF = Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', 'base64')
+
+function image(bytes: Uint8Array, name: string, type: string): File {
+  return new File([new Uint8Array(bytes)], name, { type })
+}
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  for (const [name, value] of Object.entries({ title: 'Hello', excerpt: 'A post', body: 'Text', ...fields })) {
+    data.append(name, value)
+  }
+  return data
+}
+
+async function storedFiles(directory = STORAGE_ROOT): Promise<string[]> {
+  if (!existsSync(directory)) return []
+  const entries = await readdir(directory, { recursive: true, withFileTypes: true })
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+  })
+
+  afterAll(async () => {
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+  })
+
+  const signedIn = () => http.actingAs(author).withCsrf()
+
+  async function pageProps<T>(path: string): Promise<T> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path)
+    response.assertOk()
+    return (await response.json<{ props: T }>()).props
+  }
+
+  const coverUrlOf = async (id: number) =>
+    (await pageProps<{ post: { coverUrl: string | null } }>(`/posts/${id}`)).post.coverUrl
+
+  // Straight through the app rather than the test client, which reads a body
+  // as text.
+  const fetchCover = async (coverUrl: string) => app.fetch(new Request(new URL(coverUrl, 'http://localhost')))
+
+  async function createPost(fields: Record<string, string | File> = {}): Promise<number> {
+    await (await signedIn()).post('/posts', form(fields)).assertRedirect()
+    const posts = await Post.all()
+    return posts[posts.length - 1].id
+  }
+
+  it('creates a post without a cover', async () => {
+    const id = await createPost()
+
+    expect(await coverUrlOf(id)).toBeNull()
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('still creates a post from a JSON body', async () => {
+    await (await signedIn()).post('/posts', { title: 'Hello', excerpt: 'A post', body: 'Text' }).assertRedirect()
+
+    expect(await Post.all()).toHaveLength(1)
+  })
+
+  it('stores a PNG cover under storage/ and serves it back unchanged', async () => {
+    const publicFiles = await storedFiles('public')
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+
+    const files = await storedFiles()
+    expect(files).toHaveLength(1)
+    expect(Buffer.compare(await readFile(files[0]), PNG)).toBe(0)
+    expect(await storedFiles('public')).toEqual(publicFiles)
+    expect(await Attachment.all()).toHaveLength(1)
+
+    const response = await fetchCover((await coverUrlOf(id)) as string)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('content-type')).toBe('image/png')
+    expect(Buffer.compare(Buffer.from(await response.arrayBuffer()), PNG)).toBe(0)
+  })
+
+  it('serves a JPEG cover as image/jpeg', async () => {
+    const id = await createPost({ cover: image(JPEG, 'cover.jpg', 'image/jpeg') })
+
+    const response = await fetchCover((await coverUrlOf(id)) as string)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('content-type')).toBe('image/jpeg')
+    expect(Buffer.compare(Buffer.from(await response.arrayBuffer()), JPEG)).toBe(0)
+  })
+
+  it('keeps a PNG it cannot decode as it was uploaded', async () => {
+    const truncated = PNG.subarray(0, 40)
+    const id = await createPost({ cover: image(truncated, 'cover.png', 'application/octet-stream') })
+
+    const response = await fetchCover((await coverUrlOf(id)) as string)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('content-type')).toBe('image/png')
+    expect(Buffer.compare(Buffer.from(await response.arrayBuffer()), truncated)).toBe(0)
+  })
+
+  it('carries coverUrl on the posts list', async () => {
+    const withCover = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+    const without = await createPost()
+
+    const { data } = await pageProps<{ data: Array<{ id: number; coverUrl: string | null }> }>('/posts')
+    expect(data.find((post) => post.id === withCover)?.coverUrl).toBeString()
+    expect(data.find((post) => post.id === without)?.coverUrl).toBeNull()
+  })
+
+  it('refuses a GIF on the cover field and saves nothing', async () => {
+    const response = await (await signedIn()).json().post('/posts', form({ cover: image(GIF, 'cover.gif', 'image/gif') }))
+
+    response.assertUnprocessable()
+    expect((await response.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeDefined()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('refuses a GIF that calls itself a PNG', async () => {
+    const response = await (await signedIn()).json().post('/posts', form({ cover: image(GIF, 'cover.png', 'image/png') }))
+
+    response.assertUnprocessable()
+    expect((await response.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeDefined()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('refuses a cover over 2 MB', async () => {
+    const oversized = new Uint8Array(2_000_001)
+    oversized.set(PNG)
+
+    const response = await (await signedIn())
+      .json()
+      .post('/posts', form({ cover: image(oversized, 'cover.png', 'image/png') }))
+
+    response.assertUnprocessable()
+    expect((await response.json<{ errors: Record<string, string[]> }>()).errors.cover).toBeDefined()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('answers an invalid cover the way it answers an empty title', async () => {
+    const client = await signedIn()
+    const emptyTitle = await client.post('/posts', form({ title: '' }))
+    const badCover = await client.post('/posts', form({ cover: image(GIF, 'cover.gif', 'image/gif') }))
+
+    expect(badCover.status).toBe(emptyTitle.status)
+    expect(badCover.headers.get('content-type')).toBe(emptyTitle.headers.get('content-type'))
+    expect(Object.keys((await emptyTitle.json<{ errors: object }>()).errors)).toEqual(['title'])
+    expect(Object.keys((await badCover.json<{ errors: object }>()).errors)).toEqual(['cover'])
+  })
+
+  it('replaces the cover and deletes the old file', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+    const oldUrl = (await coverUrlOf(id)) as string
+
+    await (await signedIn()).put(`/posts/${id}`, form({ cover: image(JPEG, 'new.jpg', 'image/jpeg') })).assertRedirect()
+
+    const files = await storedFiles()
+    expect(files).toHaveLength(1)
+    expect(Buffer.compare(await readFile(files[0]), JPEG)).toBe(0)
+    expect(await Attachment.all()).toHaveLength(1)
+
+    const newUrl = (await coverUrlOf(id)) as string
+    expect(newUrl).not.toBe(oldUrl)
+    await http.get(newUrl).assertOk().assertHeader('content-type', 'image/jpeg')
+    await http.get(oldUrl).assertNotFound()
+  })
+
+  it('keeps the cover when an edit touches neither the file nor the box', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+
+    await (await signedIn()).put(`/posts/${id}`, form({ title: 'Renamed' })).assertRedirect()
+
+    expect((await Post.findOrFail(id)).title).toBe('Renamed')
+    expect(await Attachment.all()).toHaveLength(1)
+    await http.get((await coverUrlOf(id)) as string).assertOk()
+  })
+
+  it('keeps the post and its cover when the replacement is refused', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+
+    await (await signedIn())
+      .json()
+      .put(`/posts/${id}`, form({ title: 'Renamed', removeCover: '1', cover: image(GIF, 'cover.gif', 'image/gif') }))
+      .assertUnprocessable()
+
+    expect((await Post.findOrFail(id)).title).toBe('Hello')
+    const files = await storedFiles()
+    expect(files).toHaveLength(1)
+    expect(Buffer.compare(await readFile(files[0]), PNG)).toBe(0)
+    await http.get((await coverUrlOf(id)) as string).assertOk().assertHeader('content-type', 'image/png')
+  })
+
+  it('removes the cover when the box is ticked', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+    const oldUrl = (await coverUrlOf(id)) as string
+
+    await (await signedIn()).put(`/posts/${id}`, form({ removeCover: '1' })).assertRedirect()
+
+    expect(await coverUrlOf(id)).toBeNull()
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+    await http.get(oldUrl).assertNotFound()
+  })
+
+  it('deletes the cover with the post', async () => {
+    const id = await createPost({ cover: image(PNG, 'cover.png', 'image/png') })
+    const oldUrl = (await coverUrlOf(id)) as string
+
+    await (await signedIn()).delete(`/posts/${id}`).assertRedirect()
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+    await http.get(oldUrl).assertNotFound()
+  })
+})
