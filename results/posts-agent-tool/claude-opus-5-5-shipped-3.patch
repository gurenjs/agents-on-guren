+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, DatabaseApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { apiTokens } from '../db/schema.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+interface ToolResult {
+  isError?: boolean
+  content: Array<{ type: string; text: string }>
+  structuredContent?: Record<string, unknown>
+}
+
+// The endpoint may answer as JSON or as a one-event SSE stream.
+async function rpcResult(response: Response): Promise<Record<string, unknown>> {
+  const raw = await response.text()
+  const json = response.headers.get('content-type')?.includes('text/event-stream')
+    ? raw.split('\n').find((line) => line.startsWith('data:'))!.slice(5)
+    : raw
+  const message = JSON.parse(json) as { result?: Record<string, unknown>; error?: unknown }
+  if (!message.result) throw new Error(`JSON-RPC error: ${JSON.stringify(message.error)}`)
+  return message.result
+}
+
+describe('/mcp', () => {
+  let http: TestApp
+  let user: UserRecord
+  let bearer: string
+  let nextId = 1
+
+  function rpc(method: string, params: Record<string, unknown>, authorization = `Bearer ${bearer}`) {
+    return app.fetch(new Request('http://localhost/mcp', {
+      method: 'POST',
+      headers: {
+        Authorization: authorization,
+        'Content-Type': 'application/json',
+        Accept: 'application/json, text/event-stream',
+      },
+      body: JSON.stringify({ jsonrpc: '2.0', id: nextId++, method, params }),
+    }))
+  }
+
+  async function callTool(name: string, args: Record<string, unknown>): Promise<ToolResult> {
+    return (await rpcResult(await rpc('tools/call', { name, arguments: args }))) as unknown as ToolResult
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const stamp = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+    user = (await User.create({ name: 'Agent Author', email: `agent-${stamp}@example.com`, password: 'password123' })) as UserRecord
+    const { plainTextToken } = await createApiToken(new DatabaseApiTokenStore(apiTokens), {
+      name: 'test assistant',
+      userId: user.id,
+      // The MCP scope gate reads `tools:` abilities; the bare '*' default grants no tool.
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  it('refuses a request without a bearer', async () => {
+    const response = await http.post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+    expect(response.status).toBe(401)
+  })
+
+  it('lists exactly the two post tools with their read-only flags', async () => {
+    const { tools } = (await rpcResult(await rpc('tools/list', {}))) as {
+      tools: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }>
+    }
+    const appTools = tools.filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(appTools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(appTools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(appTools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('creates a post as the token user, ignoring a supplied authorId', async () => {
+    const title = `MCP draft ${Date.now()}`
+    const result = await callTool('posts_store', {
+      title,
+      excerpt: 'Drafted by an assistant.',
+      body: 'Body text.',
+      authorId: user.id + 1000,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const post = await Post.first({ title })
+    expect(post?.authorId).toBe(user.id)
+    expect(JSON.parse(result.content[0]!.text)).toMatchObject({ data: { id: post!.id, title } })
+  })
+
+  it('rejects input the web form rejects, creating nothing', async () => {
+    const excerpt = `Invalid ${Date.now()}`
+    const result = await callTool('posts_store', { title: '', excerpt, body: 'Body.' })
+
+    // The MCP result carries the route's 422 body, not the status code itself.
+    expect(result.isError).toBe(true)
+    expect(JSON.parse(result.content[0]!.text)).toEqual({
+      message: 'The given data was invalid.',
+      errors: { title: ['Title is required.'] },
+    })
+    expect(await Post.first({ excerpt })).toBeNull()
+  })
+
+  it('answers a search with the same JSON as QUERY /posts/search', async () => {
+    const keyword = `bun-${Date.now()}`
+    await Post.forceCreate({ title: `About ${keyword}`, excerpt: 'Runtime notes.', body: '...', authorId: user.id })
+
+    const result = await callTool('posts_search', { keywords: [keyword] })
+    const viaHttp = await (await http.query('/posts/search', { keywords: [keyword] })).json()
+    const viaTool = result.structuredContent ?? JSON.parse(result.content[0]!.text)
+
+    expect(viaTool).toEqual(viaHttp)
+    expect((viaTool as { data: unknown[] }).data).toHaveLength(1)
+  })
+})
