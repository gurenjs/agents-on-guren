diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..535243d
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,33 @@
+// Writers usually paste the opening of the body into the excerpt, so the site
+// does it for them when the field is left blank. Kept as a pure function so
+// create and update derive the same way — an update with a blank excerpt
+// re-derives from the new body.
+
+/** Longest excerpt derived from a body, before the ellipsis is appended. */
+export const EXCERPT_LENGTH = 140
+
+/** U+2026, a single character — never three periods. */
+const ELLIPSIS = '…'
+
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+  let kept = trimmed.slice(0, EXCERPT_LENGTH)
+  // Only cut back when the boundary falls inside a word: if the character
+  // after the cut is whitespace, all EXCERPT_LENGTH characters are kept.
+  const splitsAWord = !/\s/.test(kept[EXCERPT_LENGTH - 1]) && !/\s/.test(trimmed[EXCERPT_LENGTH])
+  if (splitsAWord) {
+    // Index of the last whitespace in the kept part; -1 when the first
+    // EXCERPT_LENGTH characters are one unbroken run, which stays cut at 140.
+    const lastWhitespace = kept.search(/\s\S*$/)
+    if (lastWhitespace >= 0) kept = kept.slice(0, lastWhitespace)
+  }
+
+  return `${kept.replace(/\s+$/, '')}${ELLIPSIS}`
+}
+
+/** The excerpt to store: the one typed, or one derived from the body. */
+export function resolveExcerpt(excerpt: string | undefined, body: string): string {
+  return excerpt && excerpt.length > 0 ? excerpt : deriveExcerpt(body)
+}
