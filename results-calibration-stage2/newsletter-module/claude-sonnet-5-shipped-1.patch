@@ -0,0 +1,48 @@
+import { Controller, NotFoundHttpException, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { EmailSchema } from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    const token = `${crypto.randomUUID()}${crypto.randomUUID()}`.replaceAll('-', '')
+    await NewsletterSubscription.create({ email, token })
+
+    return this.redirect(this.back())
+  }
+
+  async confirm(): Promise<Response> {
+    const token = this.ctx.req.param('token') ?? ''
+    const subscription = token ? await NewsletterSubscription.first({ token }) : null
+    if (!subscription) throw new NotFoundHttpException('Unknown confirmation token.')
+
+    await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.back())
+  }
+
+  // Only a same-origin Referer is honoured, so the redirect cannot leave the site.
+  private back(): string {
+    const referer = this.ctx.req.header('referer')
+    if (!referer) return '/'
+    try {
+      const url = new URL(referer)
+      if (url.origin !== new URL(this.ctx.req.url).origin) return '/'
+      return `${url.pathname}${url.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
