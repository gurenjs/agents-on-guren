+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,21 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled for the future, soonest first (id, title, published_at)'
+
+  async handle(): Promise<void> {
+    const now = Date.now()
+    const posts = await Post.newQuery().whereNotNull('publishedAt').get()
+    const scheduled = posts
+      .map((post) => ({ post, time: Date.parse(post.publishedAt as string) }))
+      .filter(({ time }) => !Number.isNaN(time) && time > now)
+      .sort((a, b) => a.time - b.time || a.post.id - b.post.id)
+
+    // Plain stdout, one line per post: the report is meant to be piped.
+    for (const { post } of scheduled) {
+      process.stdout.write(`${post.id}\t${post.title.replace(/[\t\r\n]+/g, ' ')}\t${post.publishedAt}\n`)
+    }
+  }
+}
