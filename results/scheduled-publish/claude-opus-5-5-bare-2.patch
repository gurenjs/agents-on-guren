diff --git a/app/Console/Commands/ListScheduledPostsCommand.ts b/app/Console/Commands/ListScheduledPostsCommand.ts
new file mode 100644
index 0000000..32b242a
--- /dev/null
+++ b/app/Console/Commands/ListScheduledPostsCommand.ts
@@ -0,0 +1,27 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints one `<id>\t<title>\t<published_at>` line per scheduled post, soonest
+ * first, and nothing else on stdout, so ops can pipe it into other tools.
+ */
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later (tab-separated: id, title, published_at)'
+
+  async handle(): Promise<number> {
+    const now = Date.now()
+    // Parsed rather than compared as text, so a row written by hand in another
+    // ISO 8601 spelling is still classified and ordered by the instant it names.
+    const scheduled = (await Post.whereNotNull('publishedAt').get())
+      .map((post) => ({ post, at: Date.parse(post.publishedAt as string) }))
+      .filter(({ at }) => at > now)
+      .sort((a, b) => a.at - b.at || a.post.id - b.post.id)
+
+    for (const { post } of scheduled) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
