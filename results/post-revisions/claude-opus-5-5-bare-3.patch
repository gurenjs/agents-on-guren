diff --git a/tests/PostRevisions.test.ts b/tests/PostRevisions.test.ts
new file mode 100644
index 0000000..68bafc2
--- /dev/null
+++ b/tests/PostRevisions.test.ts
@@ -0,0 +1,117 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+const unique = () => `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+async function makeUser(): Promise<UserRecord> {
+  return (await User.create({ name: 'Author', email: `author-${unique()}@example.com`, password: 'secret123' })) as UserRecord
+}
+
+async function makePost(author: UserRecord, title = 'First') {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+}
+
+function payload(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function revisionTitles(postId: number): Promise<string[]> {
+  const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+  return rows.map((row) => row.title)
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser()
+    stranger = await makeUser()
+  })
+
+  async function as(user: UserRecord) {
+    return http.actingAs(user).withCsrf('/posts')
+  }
+
+  it('keeps the previous version on each edit and restores one', async () => {
+    const post = await makePost(author)
+    const client = await as(author)
+
+    await client.put(`/posts/${post.id}`, payload('Second')).assertRedirect(`/posts/${post.id}`)
+    await client.put(`/posts/${post.id}`, payload('Third')).assertRedirect(`/posts/${post.id}`)
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+
+    const response = await client
+      .withHeaders({ 'X-Inertia': 'true' })
+      .get(`/posts/${post.id}/revisions`)
+      .assertOk()
+    const page = (await response.json()) as { component: string; props: { revisions: { id: number; title: string; createdAt: string }[] } }
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(typeof page.props.revisions[0]?.createdAt).toBe('string')
+
+    const first = page.props.revisions[1]!
+    await client.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await makePost(author)
+
+    await (await as(author)).put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' })
+    await (await as(stranger)).put(`/posts/${post.id}`, payload('Hijack')).assertForbidden()
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('keeps history private to the author', async () => {
+    const post = await makePost(author)
+    await (await as(author)).put(`/posts/${post.id}`, payload('Second'))
+    const [revision] = await PostRevision.where({ postId: post.id }).get()
+
+    const other = await as(stranger)
+    await other.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await other.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    const guest = await http.withCsrf('/posts')
+    await guest.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await guest.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionTitles(post.id)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const post = await makePost(author, 'Mine')
+    const otherPost = await makePost(author, 'Other')
+    const client = await as(author)
+    await client.put(`/posts/${otherPost.id}`, payload('Other edited'))
+    const [foreign] = await PostRevision.where({ postId: otherPost.id }).get()
+
+    await client.post(`/posts/${post.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post history with the post', async () => {
+    const post = await makePost(author)
+    const kept = await makePost(author, 'Kept')
+    const client = await as(author)
+    await client.put(`/posts/${post.id}`, payload('Second'))
+    await client.put(`/posts/${kept.id}`, payload('Kept edited'))
+
+    await client.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(kept.id)).toEqual(['Kept'])
+  })
+})
