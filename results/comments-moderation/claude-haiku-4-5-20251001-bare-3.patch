index 0000000..8652001
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,15 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+}
+
+interface PostLike {
+  authorId: number
+}
+
+export class CommentPolicy extends Policy {
+  delete(user: AuthUser | null, comment: CommentLike, post: PostLike): boolean {
+    return user !== null && (Number(user.id) === comment.userId || Number(user.id) === post.authorId)
+  }
+}
