+import { z } from 'zod'
+import type { Router } from '@guren/core'
+import NewsletterController from './Http/NewsletterController.js'
+import { EmailSchema } from './Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post(
+    '/subscribe',
+    { name: 'newsletter.subscribe', body: EmailSchema },
+    [NewsletterController, 'subscribe'],
+  )
+  router.get(
+    '/confirm/:token',
+    { name: 'newsletter.confirm', params: z.object({ token: z.string().min(1) }) },
+    [NewsletterController, 'confirm'],
+  )
+  router.post(
+    '/unsubscribe',
+    { name: 'newsletter.unsubscribe', body: EmailSchema },
+    [NewsletterController, 'unsubscribe'],
+  )
+}
