+      const { data } = (await res.json()) as { data: PostRecord[] }
+      const ids = data.map((post) => post.id)
+
+      expect(ids).toContain(published.id)
+      expect(ids).not.toContain(unpublished.id)
+      expect(ids).not.toContain(decoy.id)
+    })
+
+    it('returns nothing for a keyword that only appears in an unpublished post', async () => {
+      const res = await http.query('/posts/search', { keywords: ['draft'] }).assertOk()
+      const { data } = (await res.json()) as { data: PostRecord[] }
+
+      expect(data).toHaveLength(0)
+    })
+  })
 })
