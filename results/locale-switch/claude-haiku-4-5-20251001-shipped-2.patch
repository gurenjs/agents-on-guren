diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..899db8e
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,46 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('LocaleController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  describe('locale switching', () => {
+
+    it('accepts Japanese locale', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .post('/locale', { locale: 'ja' })
+        .assertRedirect('/')
+    })
+
+    it('accepts English locale', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .post('/locale', { locale: 'en' })
+        .assertRedirect('/')
+    })
+
+    it('rejects invalid locale', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .post('/locale', { locale: 'fr' })
+        .assertUnprocessable()
+    })
+
+    it('redirects to referer', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .post('/locale', { locale: 'ja' })
+        .assertRedirect()
+    })
+  })
+})
