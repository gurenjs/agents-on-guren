+++ b/resources/js/pages/posts/Revisions.tsx
@@ -0,0 +1,52 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostRevisionResourceData } from '@/app/Http/Resources/PostRevisionResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: { id: number; title: string }
+  revisions: PostRevisionResourceData[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`Revisions of ${post.title}`} />
+      <section className="space-y-6">
+        <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+          <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+          Revisions
+        </h1>
+        <p className="text-g-text-2">Earlier versions of “{post.title}”, newest first.</p>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-muted">No earlier versions yet — one is kept each time you save an edit.</p>
+        ) : (
+          <ul className="divide-y divide-g-line border-y border-g-line">
+            {revisions.map((revision) => (
+              <li key={revision.id} className="flex items-center justify-between gap-4 py-3">
+                <div>
+                  <p className="font-bold text-g-heading">{revision.title}</p>
+                  <p className="text-sm text-g-muted">{new Date(revision.createdAt).toLocaleString()}</p>
+                </div>
+                <Link
+                  href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm('Restore this version? The current one is kept as a revision.')}
+                  className="rounded-g-ctl border border-g-line-strong px-3 py-1 text-sm font-bold text-g-accent-text transition hover:underline"
+                >
+                  Restore
+                </Link>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        <Link href={route('posts.show', { id: post.id })} className="text-sm text-g-text-2 transition hover:text-g-heading">
+          ← Back to post
+        </Link>
+      </section>
+    </Layout>
+  )
+}
