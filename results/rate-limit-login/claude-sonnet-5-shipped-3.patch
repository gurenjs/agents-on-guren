+++ b/tests/LoginController.test.ts
@@ -0,0 +1,43 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// The rate limiter keys on client IP, but TestApp's in-process fetch() never
+// goes through a real socket, so the middleware can't resolve one — per its
+// documented fail-closed fallback, every POST /login in this file lands in
+// the same shared per-route bucket. That's exactly what we want to exercise:
+// 5 submissions allowed, the 6th (even with the right password) refused.
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).json().withCsrf()
+    await User.create({ name: 'Throttle Target', email: 'throttle@example.com', password: 'correct-horse' })
+  })
+
+  it('allows up to 5 attempts per minute, then blocks with 429 + Retry-After', async () => {
+    for (let i = 0; i < 5; i++) {
+      await http
+        .post('/login', { email: 'throttle@example.com', password: 'wrong-password' })
+        .assertUnprocessable()
+    }
+
+    const blocked = await http
+      .post('/login', { email: 'throttle@example.com', password: 'correct-horse' })
+
+    expect(blocked.status).toBe(429)
+    expect(blocked.headers.get('Retry-After')).toBeTruthy()
+  })
+
+  it('still serves GET /login while a client is throttled', async () => {
+    await http.get('/login').assertOk()
+  })
+
+  it('leaves unrelated endpoints unaffected', async () => {
+    await http.get('/health').assertOk()
+  })
+})
