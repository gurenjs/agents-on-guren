diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..075ca8d
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,262 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import { resetDatabase, seedDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface IndexProps {
+  data: PostResourceData[]
+  pagination: { meta: { total: number; currentPage: number }; links: { pages: Array<{ page: number; url: string | null }> } }
+  tag: string | null
+}
+
+const PAYLOAD = { title: 'Hello', excerpt: 'A post.', body: 'The body.' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+  let asAuthor: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    asAuthor = await http.actingAs(author).withCsrf()
+  })
+
+  // The app seeds once, on boot, and test files share that boot: hand the next
+  // file the database a fresh boot would have given it.
+  afterAll(async () => {
+    await resetDatabase()
+    await seedDatabase()
+  })
+
+  // An Inertia visit answers with the page object as JSON instead of a document.
+  async function pageProps<TProps>(client: TestApp, path: string): Promise<TProps> {
+    const response = await client.withHeader('X-Inertia', 'true').get(path).assertOk()
+    const page = await response.json<{ props: TProps }>()
+
+    return page.props
+  }
+
+  async function createPost(tagsField?: string): Promise<number> {
+    const body = tagsField === undefined ? PAYLOAD : { ...PAYLOAD, tags: tagsField }
+    const response = await asAuthor.post('/posts', body).assertRedirect()
+    const id = Number(response.headers.get('location')?.split('/').pop())
+    expect(id).toBeGreaterThan(0)
+
+    return id
+  }
+
+  async function tagNames(): Promise<string[]> {
+    const rows = await Tag.all()
+
+    return rows.map((row) => row.name).sort()
+  }
+
+  async function attachedTo(postId: number): Promise<string[]> {
+    const post = await Post.findWithOrFail(postId, 'tags')
+
+    return post.tags.map((tag) => tag.name).sort()
+  }
+
+  async function rowCounts(): Promise<{ posts: number; tags: number; postTags: number }> {
+    return {
+      posts: await Post.newQuery().count(),
+      tags: await Tag.newQuery().count(),
+      postTags: await PostTag.newQuery().count(),
+    }
+  }
+
+  it('stores the tags of a new post and shows them on the post page', async () => {
+    const id = await createPost('webdev, bun')
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await attachedTo(id)).toEqual(['bun', 'webdev'])
+
+    const { post } = await pageProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('reuses a tag another post already carries', async () => {
+    await createPost('bun')
+    await createPost('bun, webdev')
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect((await rowCounts()).postTags).toBe(3)
+  })
+
+  it('treats a missing or empty field as no tags', async () => {
+    const withoutField = await createPost()
+    const withEmptyField = await createPost(' , ')
+
+    expect(await attachedTo(withoutField)).toEqual([])
+    expect(await attachedTo(withEmptyField)).toEqual([])
+    expect(await rowCounts()).toEqual({ posts: 2, tags: 0, postTags: 0 })
+  })
+
+  it('trims names, skips empty entries and counts a repeated name once', async () => {
+    const id = await createPost(' bun ,bun,,Bun,')
+
+    expect(await attachedTo(id)).toEqual(['Bun', 'bun'])
+    expect(await rowCounts()).toEqual({ posts: 1, tags: 2, postTags: 2 })
+  })
+
+  it('detaches a tag removed on edit and keeps it in the table', async () => {
+    const id = await createPost('bun, webdev')
+
+    await asAuthor.put(`/posts/${id}`, { ...PAYLOAD, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedTo(id)).toEqual(['bun'])
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+
+    const { post } = await pageProps<{ post: PostResourceData }>(http, `/posts/${id}`)
+    expect(post.tags).toEqual(['bun'])
+  })
+
+  it('detaches every tag when the edit leaves the field out', async () => {
+    const id = await createPost('bun, webdev')
+
+    await asAuthor.put(`/posts/${id}`, PAYLOAD).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedTo(id)).toEqual([])
+  })
+
+  it('starts the edit form with the current tags', async () => {
+    const id = await createPost('webdev, bun')
+
+    const { post } = await pageProps<{ post: PostResourceData }>(asAuthor, `/posts/${id}/edit`)
+    expect(post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('refuses more than five tags like an empty title, saving nothing', async () => {
+    const before = await rowCounts()
+    const sixTags = { ...PAYLOAD, tags: 'a, b, c, d, e, f' }
+
+    // The same answer to a form post as to a JSON client.
+    for (const client of [asAuthor, asAuthor.json()]) {
+      const emptyTitle = await client.post('/posts', { ...PAYLOAD, title: '' })
+      const refused = await client.post('/posts', sixTags)
+
+      expect(refused.status).toBe(emptyTitle.status)
+      expect(refused.headers.get('content-type')).toBe(emptyTitle.headers.get('content-type'))
+    }
+
+    const refused = await asAuthor.json().post('/posts', sixTags).assertStatus(422)
+    const { errors } = await refused.json<{ errors: Record<string, string[]> }>()
+    expect(Object.keys(errors)).toEqual(['tags'])
+    expect(await rowCounts()).toEqual(before)
+  })
+
+  it('accepts five tags', async () => {
+    const id = await createPost('a, b, c, d, e')
+
+    expect(await attachedTo(id)).toEqual(['a', 'b', 'c', 'd', 'e'])
+  })
+
+  it('refuses a 31-character name and accepts a 30-character one', async () => {
+    const tooLong = await asAuthor.json().post('/posts', { ...PAYLOAD, tags: 'x'.repeat(31) })
+    tooLong.assertStatus(422)
+    const { errors } = await tooLong.json<{ errors: Record<string, string[]> }>()
+    expect(Object.keys(errors)).toEqual(['tags'])
+    expect(await rowCounts()).toEqual({ posts: 0, tags: 0, postTags: 0 })
+
+    const id = await createPost('x'.repeat(30))
+    expect(await attachedTo(id)).toEqual(['x'.repeat(30)])
+  })
+
+  it('refuses an edit that breaks a rule and keeps the post as it was', async () => {
+    const id = await createPost('bun')
+
+    await asAuthor
+      .json()
+      .put(`/posts/${id}`, { ...PAYLOAD, title: 'Changed', tags: 'a, b, c, d, e, f' })
+      .assertStatus(422)
+
+    expect(await attachedTo(id)).toEqual(['bun'])
+    expect((await Post.findOrFail(id)).title).toBe(PAYLOAD.title)
+  })
+
+  it('lists every post with its tags, and only the tagged ones under a filter', async () => {
+    const both = await createPost('bun, webdev')
+    const untagged = await createPost()
+    const bunOnly = await createPost('bun')
+
+    const all = await pageProps<IndexProps>(http, '/posts')
+    expect(all.tag).toBeNull()
+    expect(all.data.map((post) => [post.id, post.tags])).toEqual([
+      [bunOnly, ['bun']],
+      [untagged, []],
+      [both, ['bun', 'webdev']],
+    ])
+
+    const bun = await pageProps<IndexProps>(http, '/posts?tag=bun')
+    expect(bun.tag).toBe('bun')
+    expect(bun.data.map((post) => post.id)).toEqual([bunOnly, both])
+    expect(bun.data[1]?.tags).toEqual(['bun', 'webdev'])
+    expect(bun.data[0]?.author?.name).toBe('Author')
+
+    const webdev = await pageProps<IndexProps>(http, '/posts?tag=webdev')
+    expect(webdev.data.map((post) => post.id)).toEqual([both])
+  })
+
+  it('lists nothing for a tag no post carries', async () => {
+    const id = await createPost('bun, webdev')
+    await asAuthor.put(`/posts/${id}`, { ...PAYLOAD, tags: 'bun' }).assertRedirect()
+
+    const unknown = await pageProps<IndexProps>(http, '/posts?tag=nope')
+    expect(unknown.data).toEqual([])
+    expect(unknown.pagination.meta.total).toBe(0)
+
+    const unused = await pageProps<IndexProps>(http, '/posts?tag=webdev')
+    expect(unused.data).toEqual([])
+
+    // Names are case-sensitive.
+    const otherCase = await pageProps<IndexProps>(http, '/posts?tag=Bun')
+    expect(otherCase.data).toEqual([])
+  })
+
+  it('paginates a filtered list and keeps the filter in the page links', async () => {
+    const ids: number[] = []
+    for (let index = 0; index < 12; index += 1) {
+      ids.push(await createPost('bun'))
+      await createPost('other')
+    }
+    const newestFirst = [...ids].reverse()
