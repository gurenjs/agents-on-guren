+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+type CreatedToken = { id: string; name: string; token: string }
+type ApiPost = { id: number; title: string; excerpt: string; authorId: number; createdAt: string }
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: label,
+    email: `${label}-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+    password: 'secret-password',
+  })
+  if (!user) throw new Error('user not created')
+  return user
+}
+
+describe('api.posts', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let token: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await makeUser('api-owner')
+    token = (await createToken(owner)).token
+  })
+
+  async function createToken(user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+    const client = await http.actingAs(user).withCsrf()
+    const response = await client.json().post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<CreatedToken>()
+  }
+
+  function bearer(value: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${value}`)
+  }
+
+  it('lists every post newest first', async () => {
+    const other = await makeUser('api-other')
+    const older = await Post.forceCreate({ title: 'Older', excerpt: 'e', body: 'b', authorId: other.id })
+    const newer = await Post.forceCreate({ title: 'Newer', excerpt: 'e', body: 'b', authorId: owner.id })
+
+    const response = await bearer(token).get('/api/posts')
+    response.assertOk()
+    const { data } = await response.json<{ data: ApiPost[] }>()
+
+    const ids = data.map((post) => post.id)
+    expect(ids.indexOf(newer!.id)).toBeLessThan(ids.indexOf(older!.id))
+    const first = data[0]!
+    expect(first).toMatchObject({ id: expect.any(Number), title: expect.any(String), excerpt: expect.any(String), authorId: expect.any(Number) })
+    expect(new Date(first.createdAt).toISOString()).toBe(first.createdAt)
+  })
+
+  it('creates a post owned by the token user, ignoring authorId in the body', async () => {
+    const other = await makeUser('api-victim')
+    const response = await bearer(token).post('/api/posts', {
+      title: 'From a script',
+      excerpt: 'Release notes',
+      body: 'Shipped it.',
+      authorId: other.id,
+    })
+    response.assertCreated()
+    const { data } = await response.json<{ data: ApiPost }>()
+
+    expect(data.title).toBe('From a script')
+    expect(data.authorId).toBe(owner.id)
+    expect(typeof data.createdAt).toBe('string')
+    expect((await Post.find(data.id))?.authorId).toBe(owner.id)
+  })
+
+  it('rejects input the web form would reject', async () => {
+    const before = await Post.newQuery().count()
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'e', body: 'b' }).assertUnprocessable()
+    await bearer(token).post('/api/posts', { title: 'T', excerpt: 'e' }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('answers 401 JSON for missing, malformed, unknown or tampered tokens', async () => {
+    const before = await Post.newQuery().count()
+    const payload = { title: 'T', excerpt: 'e', body: 'b' }
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', 'Basic abc').get('/api/posts').assertUnauthorized()
+    await bearer('not-a-token').get('/api/posts').assertUnauthorized()
+    await bearer('999|deadbeefdeadbeefdeadbeef').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+
+    const response = await bearer(`${token}x`).post('/api/posts', payload)
+    response.assertUnauthorized()
+    expect(response.headers.get('content-type')).toContain('application/json')
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('limits each token to 60 requests a minute, independently', async () => {
+    const limited = (await createToken(owner, 'limited')).token
+    const sibling = (await createToken(owner, 'sibling')).token
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(limited).get('/api/posts').assertOk()
+    }
+    const blocked = await bearer(limited).get('/api/posts')
+    blocked.assertStatus(429)
+    const retryAfter = Number(blocked.headers.get('retry-after'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(sibling).get('/api/posts').assertOk()
+  })
+})
