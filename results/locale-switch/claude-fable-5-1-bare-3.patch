new file mode 100644
index 0000000..f7b7df6
--- /dev/null
+++ b/config/locales.ts
@@ -0,0 +1,9 @@
+// The languages the app speaks, first one the default. Dependency-free on
+// purpose: the server (src/app.ts, the locale validator) and the browser (the
+// header's language switcher) both import it. Each needs a lang/<locale>/ catalog.
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number]
+
+// Read by the framework's locale detection ahead of Accept-Language.
+export const LOCALE_COOKIE = 'locale'
