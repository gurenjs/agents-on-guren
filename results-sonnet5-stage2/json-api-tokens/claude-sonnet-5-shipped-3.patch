diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..5ec4e56
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,43 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_USER_KEY = 'apiTokenUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Process-local fixed windows keyed by token hash (ids are reused after a
+// database reset); a multi-instance deploy needs a shared store here.
+const windows = new Map<string,{ resetAt: number; count: number }>()
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+const unauthorized = (c: { json: (body: unknown, status: 401) => Response }) =>
+  c.json({ message: 'Unauthenticated.' }, 401)
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const match = /^Bearer[ \t]+([A-Za-z0-9_-]{16,200})$/i.exec(c.req.header('Authorization') ?? '')
+  if (!match) return unauthorized(c)
+
+  const row = await ApiToken.first({ tokenHash: hashApiToken(match[1]!) })
+  if (!row) return unauthorized(c)
+
+  const now = Date.now()
+  let entry = windows.get(row.tokenHash)
+  if (!entry || entry.resetAt <= now) {
+    entry = { resetAt: now + WINDOW_MS, count: 0 }
+    windows.set(row.tokenHash, entry)
+    for (const [id, other] of windows) if (other.resetAt <= now) windows.delete(id)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((entry.resetAt - now) / 1000)))
+    return c.json({ message: 'Too many requests.' }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  c.set(API_TOKEN_USER_KEY, row.userId)
+  await next()
+})
