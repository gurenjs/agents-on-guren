@@ -29,4 +29,14 @@ export class PostPolicy extends Policy {
   delete(user: AuthUser | null, post: PostLike): boolean {
     return user !== null && Number(user.id) === post.authorId
   }
+
+  // Revision history is private to the author: the same rule as editing,
+  // named separately so the revisions routes read as their own ability.
+  viewRevisions(user: AuthUser | null, post: PostLike): boolean {
+    return this.update(user, post)
+  }
+
+  restore(user: AuthUser | null, post: PostLike): boolean {
+    return this.update(user, post)
+  }
 }
