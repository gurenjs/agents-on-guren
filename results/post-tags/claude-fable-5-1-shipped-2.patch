+   * Takes the caller's `trx` so the post and its tags are saved or refused together.
+   */
+  static async syncTags(postId: PostRecord['id'], names: readonly string[], trx: TransactionHandle): Promise<void> {
+    const known = await Tag.newQuery({ trx }).whereIn('name', names).get()
+    const wanted = new Set<TagRecord['id']>()
+    for (const name of names) {
+      const tag = known.find((candidate) => candidate.name === name) ?? (await Tag.create({ name }, { trx }))
+      wanted.add(tag.id)
+    }
+
+    const attached = await PostTag.newQuery({ trx }).where({ postId }).get()
+    const current = new Set(attached.map((row) => row.tagId))
+
+    const removed = [...current].filter((tagId) => !wanted.has(tagId))
+    if (removed.length > 0) {
+      await PostTag.newQuery({ trx }).where({ postId }).whereIn('tagId', removed).delete()
+    }
+    for (const tagId of wanted) {
+      if (!current.has(tagId)) {
+        await PostTag.create({ postId, tagId }, { trx })
+      }
+    }
   }
