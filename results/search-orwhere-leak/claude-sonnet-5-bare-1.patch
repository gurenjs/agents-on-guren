@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -19,4 +22,59 @@ describe('posts.search', () => {
   it('rejects a search without keywords', async () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  it('never returns unpublished posts, and only returns posts matching a keyword', async () => {
+    // The test database file persists across runs, so every fixture string
+    // is namespaced with a run-unique token — otherwise a previous run's
+    // published fixture (same title) would still match today's search.
+    const token = `${Date.now()}${Math.floor(Math.random() * 1e6)}`
+    const keywordA = `zephyrquill${token}`
+    const keywordB = `marmalade${token}`
+
+    const author = await User.forceCreate({
+      name: 'Search Fixture Author',
+      email: `search-fixture-${token}@example.com`,
+      password: 'secret1234',
+    })
+
+    const published = await Post.forceCreate({
+      title: `${keywordA} notes`,
+      excerpt: `about ${keywordB}`,
+      body: 'body',
+      authorId: author!.id,
+      published: true,
+    })
+    const unpublished = await Post.forceCreate({
+      title: `${keywordA} drafts`,
+      excerpt: `about ${keywordB} too`,
+      body: 'body',
+      authorId: author!.id,
+      published: false,
+    })
+    // Shares no keyword with the search below — proves results aren't padded
+    // with unrelated published posts.
+    await Post.forceCreate({
+      title: `unrelated ${token}`,
+      excerpt: `unrelated ${token}`,
+      body: 'body',
+      authorId: author!.id,
+      published: true,
+    })
+
+    const singleResponse = await http.query('/posts/search', { keywords: [keywordA] }).assertOk()
+    const single = await singleResponse.json<{ data: PostResourceData[] }>()
+    expect(single.data.map((p) => p.id)).toEqual([published!.id])
+
+    const multiResponse = await http.query('/posts/search', { keywords: [keywordA, keywordB] }).assertOk()
+    const multi = await multiResponse.json<{ data: PostResourceData[] }>()
+    expect(multi.data.map((p) => p.id)).toEqual([published!.id])
+
+    const unpublishedOnlyResponse = await http.query('/posts/search', { keywords: [`${keywordA} drafts`] }).assertOk()
+    const unpublishedOnly = await unpublishedOnlyResponse.json<{ data: PostResourceData[] }>()
+    expect(unpublishedOnly.data).toEqual([])
+
+    // Sanity: the fixture actually created an unpublished post with the
+    // shared keyword, so the assertions above are meaningful.
+    expect(unpublished!.published).toBe(false)
+  })
 })
