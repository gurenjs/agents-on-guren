diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..8bd4163
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,138 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let http: TestApp
+let author: UserRecord
+let stranger: UserRecord
+
+async function makePost(title: string, owner: UserRecord = author): Promise<PostRecord> {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: owner.id })
+}
+
+async function edit(post: PostRecord, title: string) {
+  const csrf = await http.actingAs(author).withCsrf()
+  await csrf
+    .put(`/posts/${post.id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+    .assertRedirect(`/posts/${post.id}`)
+}
+
+async function revisionTitles(postId: number): Promise<string[]> {
+  const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+  return rows.map((row) => row.title)
+}
+
+async function inertiaProps(client: TestApp, path: string): Promise<Record<string, unknown>> {
+  const res = await client.withHeader('X-Inertia', 'true').get(path)
+  res.assertOk()
+  const page = await res.json<{ component: string; props: Record<string, unknown> }>()
+  expect(page.component).toBe('posts/Revisions')
+  return page.props
+}
+
+describe('post revisions', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    stranger = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-password' })
+  })
+
+  it('keeps nothing on create and the previous version on each edit', async () => {
+    const post = await makePost('First')
+    expect(await revisionTitles(post.id)).toEqual([])
+
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+
+    const [kept] = await PostRevision.where({ postId: post.id }).orderBy('id', 'asc').get()
+    expect(kept).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await makePost('First')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+
+    const other = await http.actingAs(stranger).withCsrf()
+    await other.put(`/posts/${post.id}`, { title: 'Hijack', excerpt: 'x', body: 'y' }).assertForbidden()
+
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    const post = await makePost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+
+    const props = await inertiaProps(http.actingAs(author), `/posts/${post.id}/revisions`)
+    const revisions = props.revisions as Array<{ id: number; title: string; createdAt: string }>
+    expect(revisions.map((r) => r.title)).toEqual(['Second', 'First'])
+    expect(typeof revisions[0]?.createdAt).toBe('string')
+  })
+
+  it('restores a revision and keeps the replaced version', async () => {
+    const post = await makePost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    expect(await Post.find(post.id)).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and redirects guests on both routes', async () => {
+    const post = await makePost('First')
+    await edit(post, 'Second')
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+    const restorePath = `/posts/${post.id}/revisions/${revision.id}/restore`
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const other = await http.actingAs(stranger).withCsrf()
+    await other.post(restorePath).assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const guest = await http.withCsrf()
+    await guest.post(restorePath).assertRedirect('/login')
+
+    expect((await Post.find(post.id))?.title).toBe('Second')
+    expect(await revisionTitles(post.id)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const post = await makePost('Mine')
+    const otherPost = await makePost('Also mine')
+    await edit(otherPost, 'Edited')
+    const foreign = await PostRevision.where({ postId: otherPost.id }).firstOrFail()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+
+    expect((await Post.find(post.id))?.title).toBe('Mine')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post history along with the post', async () => {
+    const post = await makePost('Doomed')
+    const keeper = await makePost('Keeper')
+    await edit(post, 'Doomed 2')
+    await edit(keeper, 'Keeper 2')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(keeper.id)).toEqual(['Keeper'])
+  })
+})
