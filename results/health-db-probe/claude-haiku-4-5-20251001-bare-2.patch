+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('health check', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns ok status when database is accessible', async () => {
+    const response = await http.get('/health')
+    const json = await response.json()
+
+    console.log('Status:', response.status)
+    console.log('Body:', JSON.stringify(json, null, 2))
+
+    if (response.status !== 200) {
+      throw new Error(`Expected 200, got ${response.status}`)
+    }
+    if (json.status !== 'ok') {
+      throw new Error(`Expected status="ok", got status="${json.status}"`)
+    }
+    if (!json.checks?.db?.status) {
+      throw new Error('Missing checks.db.status in response')
+    }
+    if (json.checks.db.status !== 'ok') {
+      throw new Error(`Expected db status="ok", got status="${json.checks.db.status}"`)
+    }
+  })
+})
