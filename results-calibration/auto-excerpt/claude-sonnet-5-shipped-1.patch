@@ -6,6 +6,39 @@ export type PostRecord = typeof posts.$inferSelect
 export type NewPostRecord = typeof posts.$inferInsert
 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
+const EXCERPT_MAX_LENGTH = 140
+
+// Derives a teaser from the post body when no excerpt was supplied: the
+// first 140 characters, cut back to the last whitespace so a word is never
+// split across the boundary, then trimmed and suffixed with an ellipsis.
+export function deriveExcerptFromBody(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_MAX_LENGTH) {
+    return trimmed
+  }
+
+  const head = trimmed.slice(0, EXCERPT_MAX_LENGTH)
+  const charAtLimit = trimmed[EXCERPT_MAX_LENGTH - 1]
+  const charAfterLimit = trimmed[EXCERPT_MAX_LENGTH]
+  const splitsAWord = !/\s/.test(charAtLimit) && !/\s/.test(charAfterLimit)
+
+  let kept = head
+  if (splitsAWord) {
+    let lastWhitespaceIndex = -1
+    for (let i = head.length - 1; i >= 0; i--) {
+      if (/\s/.test(head[i])) {
+        lastWhitespaceIndex = i
+        break
+      }
+    }
+    if (lastWhitespaceIndex !== -1) {
+      kept = head.slice(0, lastWhitespaceIndex)
+    }
+  }
+
+  return `${kept.replace(/\s+$/, '')}…`
+}
