@@ -0,0 +1,138 @@
+import { useState } from 'react'
+import { Link, router, useForm } from '@inertiajs/react'
+import type { CommentResourceData } from '@/app/Http/Resources/CommentResource'
+import { createApiClient, type ApiRoutes } from '@/.guren/api-client.gen'
+import { route } from '@/.guren/routes.gen'
+
+type CommentFormData = ApiRoutes['posts.comments.store']['body']
+
+interface Props {
+  postId: number
+  postAuthorId: number
+  comments: CommentResourceData[]
+  viewerId?: number
+}
+
+// comments.report answers 204 with no body, which Inertia cannot visit — the
+// page calls it through the generated client and reloads the list itself.
+const api = createApiClient<ApiRoutes>({ baseUrl: '' })
+
+export default function PostComments({ postId, postAuthorId, comments, viewerId }: Props) {
+  const form = useForm<CommentFormData>({ body: '' })
+  const [reported, setReported] = useState<number[]>([])
+  const [reportError, setReportError] = useState<string | null>(null)
+  const signedIn = viewerId !== undefined
+
+  async function report(commentId: number) {
+    setReportError(null)
+    try {
+      const response = await api.request('comments.report', { params: { id: commentId } })
+      if (!response.ok) {
+        setReportError('Report failed — try again.')
+        return
+      }
+      setReported((ids) => [...ids, commentId])
+      // This report may have been the one that hides the comment.
+      router.reload({ only: ['comments'] })
+    } catch {
+      setReportError('Report failed — check your connection and try again.')
+    }
+  }
+
+  return (
+    <section className="space-y-6 border-t border-g-line pt-6">
+      <h2 className="text-xl font-bold text-g-heading">Comments ({comments.length})</h2>
+
+      {comments.length === 0 ? <p className="text-sm text-g-muted">No comments yet.</p> : null}
+
+      <ul className="space-y-4">
+        {comments.map((comment) => {
+          // Mirrors CommentPolicy — the server rejects it either way, this only
+          // keeps controls the viewer cannot use off the page.
+          const canDelete = signedIn && (viewerId === comment.author.id || viewerId === postAuthorId)
+
+          return (
+            <li key={comment.id} className="space-y-2 rounded-g-ctl border border-g-line bg-g-panel p-4">
+              <p className="text-sm text-g-muted">
+                {comment.author.name} · {new Date(comment.createdAt).toLocaleString()}
+              </p>
+              <p className="whitespace-pre-wrap text-g-text">{comment.body}</p>
+              {signedIn ? (
+                <div className="flex items-center gap-4 text-sm">
+                  {canDelete ? (
+                    <Link
+                      href={route('comments.destroy', { id: comment.id })}
+                      method="delete"
+                      as="button"
+                      preserveScroll
+                      onBefore={() => window.confirm('Delete this comment?')}
+                      className="font-bold text-g-danger transition hover:underline"
+                    >
+                      Delete
+                    </Link>
+                  ) : null}
+                  {reported.includes(comment.id) ? (
+                    <span className="text-g-muted">Reported</span>
+                  ) : (
+                    <button
+                      type="button"
+                      onClick={() => report(comment.id)}
+                      className="text-g-text-2 transition hover:text-g-heading"
+                    >
+                      Report
+                    </button>
+                  )}
+                </div>
+              ) : null}
+            </li>
+          )
+        })}
+      </ul>
+
+      {reportError !== null && <p className="text-sm text-g-danger">{reportError}</p>}
+
+      {signedIn ? (
+        <form
+          className="space-y-4"
+          onSubmit={(event) => {
+            event.preventDefault()
+            form.post(route('posts.comments.store', { id: postId }), {
+              preserveScroll: true,
+              onSuccess: () => form.reset(),
+            })
+          }}
+        >
+          <div>
+            <label htmlFor="comment-body" className="block text-sm font-bold text-g-heading">
+              Add a comment
+            </label>
+            <textarea
+              id="comment-body"
+              rows={4}
+              maxLength={2000}
+              value={form.data.body}
+              onChange={(event) => form.setData('body', event.target.value)}
+              className="mt-1 w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent"
+            />
+            {form.errors.body ? <p className="mt-1 text-sm text-g-danger">{form.errors.body}</p> : null}
+          </div>
+
+          <button
+            type="submit"
+            disabled={form.processing}
+            className="rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent transition hover:bg-g-accent-down disabled:cursor-not-allowed disabled:opacity-45"
+          >
+            Post comment
+          </button>
+        </form>
+      ) : (
+        <p className="text-sm text-g-text-2">
+          <Link href={route('login')} className="text-g-accent-text transition hover:underline">
+            Sign in
+          </Link>{' '}
+          to leave a comment.
+        </p>
+      )}
+    </section>
+  )
+}
