diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..4b6fd1e
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,118 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+
+// Exercises the real database (data/guren.test.db, migrated by `bun run
+// db:migrate` under NODE_ENV=test) — the demo user seeded by
+// db/seeders/001_users.ts is the author for every post created here.
+describe('post slugs', () => {
+  let http: TestApp
+  let author: { id: number; name: string; email: string }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const demo = await User.first({ email: DEMO_EMAIL })
+    if (!demo) {
+      throw new Error('Expected the demo user (db/seeders/001_users.ts) to be seeded in the test database.')
+    }
+    author = { id: demo.id, name: demo.name, email: demo.email }
+  })
+
+  // The on-disk SQLite file persists across test runs, so posts left behind
+  // by a previous run would otherwise shift the numbered-suffix assertions
+  // below. Clearing by exact title first keeps this file self-contained and
+  // repeatable without touching the seeded sample posts.
+  async function clearPostsTitled(title: string): Promise<void> {
+    // PostPayloadSchema trims the title before it hits the database, so
+    // match on the trimmed form too.
+    const existing = await Post.where('title', title.trim()).get()
+    for (const post of existing) {
+      await Post.delete({ id: post.id })
+    }
+  }
+
+  async function authedClient(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  it('slugifies the title: lowercase, ascii letters/digits, hyphen-joined', async () => {
+    await clearPostsTitled('Hello, World!')
+    const client = await authedClient()
+
+    await client
+      .post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' })
+      .assertRedirect('/posts/hello-world')
+
+    const post = await Post.first({ title: 'Hello, World!' })
+    expect(post?.slug).toBe('hello-world')
+  })
+
+  it('drops punctuation and collapses whitespace from messier titles', async () => {
+    const title = '  Guren  &  Bun: 2026 Edition!  '
+    await clearPostsTitled(title)
+    const client = await authedClient()
+
+    await client.post('/posts', { title, excerpt: 'e', body: 'b' }).assertRedirect('/posts/guren-bun-2026-edition')
+  })
+
+  it('assigns the next free numbered suffix to a repeated title', async () => {
+    await clearPostsTitled('Duplicate Title')
+    const client = await authedClient()
+
+    await client.post('/posts', { title: 'Duplicate Title', excerpt: 'e', body: 'b' }).assertRedirect('/posts/duplicate-title')
+    await client.post('/posts', { title: 'Duplicate Title', excerpt: 'e', body: 'b' }).assertRedirect('/posts/duplicate-title-2')
