+
+  /**
+   * Condition group for "posts this viewer may read": everything published,
+   * plus the viewer's own drafts. Pass it to `where()` so it is AND-ed with
+   * the rest of the query instead of widening it:
+   *
+   * ```typescript
+   * Post.newQuery().where(Post.visibleTo(viewerId))
+   * ```
+   */
+  static visibleTo(viewerId: number | null): WhereGroupCallback<PostRecord> {
+    return (q) => {
+      q.where('published', true)
+      if (viewerId !== null) {
+        q.orWhere('authorId', viewerId)
+      }
+    }
+  }
+
+  /** The same rule as {@link Post.visibleTo}, applied to a record in hand. */
+  static isVisibleTo(post: PostVisibility, viewerId: number | null): boolean {
+    return post.published || post.authorId === viewerId
+  }
 }
 
