--- /dev/null
+++ b/app/Console/Commands/ListScheduledPostsCommand.ts
@@ -0,0 +1,21 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'Print scheduled posts as tab-separated id, title, published_at, soonest first'
+
+  async handle(): Promise<number> {
+    const scheduled = await Post.where('publishedAt', '>', new Date().toISOString())
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()
+
+    // stdout carries only the report rows so ops can pipe it.
+    for (const post of scheduled) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+
+    return 0
+  }
+}
