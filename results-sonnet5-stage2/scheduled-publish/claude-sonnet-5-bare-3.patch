@@ -0,0 +1,54 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { ready } from '../src/main.js'
+import { getDatabase } from '../config/database.js'
+import { posts, users } from '../db/schema.js'
+import { eq } from 'drizzle-orm'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: typeof users.$inferSelect
+  let other: typeof users.$inferSelect
+  let scheduledId: number
+  const future = new Date(Date.now() + 86_400_000).toISOString()
+
+  beforeAll(async () => {
+    await ready
+    http = await TestApp.fromApp(app)
+    const db = (await getDatabase()) as any
+    const suffix = crypto.randomUUID()
+    ;[author] = await db.insert(users).values({ name: 'A', email: `a-${suffix}@x.test`, passwordHash: 'x' }).returning()
+    ;[other] = await db.insert(users).values({ name: 'B', email: `b-${suffix}@x.test`, passwordHash: 'x' }).returning()
+    ;[{ id: scheduledId }] = await db
+      .insert(posts)
+      .values({ title: 'Later', excerpt: 'e', body: 'b', authorId: author.id, publishedAt: future })
+      .returning()
+  })
+
+  it('hides a scheduled post from guests and other users, shows it to its author', async () => {
+    await http.get(`/posts/${scheduledId}`).assertStatus(404)
+    await http.actingAs(other).get(`/posts/${scheduledId}`).assertStatus(404)
+    await http.actingAs(author).get(`/posts/${scheduledId}`).assertOk()
+  })
+
+  it('shows it to everyone once the time has passed', async () => {
+    const db = (await getDatabase()) as any
+    await db.update(posts).set({ publishedAt: new Date(Date.now() - 1000).toISOString() }).where(eq(posts.id, scheduledId))
+    await http.get(`/posts/${scheduledId}`).assertOk()
+    await db.update(posts).set({ publishedAt: future }).where(eq(posts.id, scheduledId))
+  })
+
+  it('rejects a publishAt that is not a date', async () => {
+    await (await http.withCsrf())
+      .actingAs(author)
+      .post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+      .assertStatus(422)
+  })
+
+  it('lists scheduled posts from the console command', async () => {
+    const proc = Bun.spawnSync(['bun', 'run', 'console', 'posts:scheduled'], { env: { ...process.env, NODE_ENV: 'test' } })
+    expect(proc.exitCode).toBe(0)
+    expect(proc.stdout.toString()).toContain(`${scheduledId}\tLater\t${future}\n`)
+  })
+})
