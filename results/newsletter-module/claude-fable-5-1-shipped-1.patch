+import { defineArchRules } from '@guren/cli/arch'
+
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      // A type-only import compiles away, but it still stops the module from
+      // being lifted into another app without the blog noticing.
+      includeTypeImports: true,
+      message:
+        'The newsletter module ships with other products: the blog must not depend on it. '
+        + 'Only src/app.ts registers it with the application.',
+    },
+  ],
+})
