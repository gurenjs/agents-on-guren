@@ -6,8 +6,44 @@ export const PostIdParamSchema = z.object({
 
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  // Not held to the tag rules below: a name no post carries lists nothing.
+  tag: z.string().trim().optional(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+// The `tags` field is one text input, names separated by commas. This is the
+// one reading of it: the schema below checks the names it returns and the
+// controller saves them, so the rules count what is stored rather than what
+// was typed — ` bun ,bun` is the one tag `bun`.
+export function parseTagNames(value: string | undefined): string[] {
+  const names = (value ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
+}
+
+// Stays a string through validation rather than being transformed into the
+// names: codegen renders the field as it travels, and the parsed type would
+// otherwise disagree with what the controller receives.
+const TagsFieldSchema = z
+  .string()
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+
+    // Counted in characters rather than UTF-16 units, so an emoji is one.
+    if (names.some((name) => [...name].length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post can have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+  })
+
