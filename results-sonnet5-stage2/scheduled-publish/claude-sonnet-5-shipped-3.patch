@@ -0,0 +1,61 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const future = () => new Date(Date.now() + 86_400_000).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' }))!
+    other = (await User.create({ name: 'B', email: 'b@example.com', password: 'secret-pass-1' }))!
+  })
+
+  async function scheduled(publishedAt: string | null = future()) {
+    return (await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt,
+    }))!
+  }
+
+  it('hides a scheduled post from guests and other users, shows it to the author', async () => {
+    const post = await scheduled()
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other as never).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author as never).get(`/posts/${post.id}`).assertOk()
+  })
+
