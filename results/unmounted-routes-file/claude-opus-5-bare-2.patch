diff --git a/tests/AdminPostController.test.ts b/tests/AdminPostController.test.ts
new file mode 100644
index 0000000..3b0d0d8
--- /dev/null
+++ b/tests/AdminPostController.test.ts
@@ -0,0 +1,20 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The admin post list is mounted behind the 'auth' alias, so a guest is sent
+// to /login rather than getting a 404. Reading the list itself needs the
+// database, which the starter suite has no fixtures for — this asserts the
+// route is served at all, which is what regressed when routes/admin.ts was
+// never registered on the router.
+describe('admin.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects a guest to the login page', async () => {
+    await http.get('/admin/posts').assertRedirect('/login')
+  })
+})
