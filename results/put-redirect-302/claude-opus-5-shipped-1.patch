+++ b/tests/PostUpdate.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// posts.update answers a PUT. A 302 there tells the browser to repeat the
+// PUT against the redirect target, which loops forever; 303 See Other is the
+// status that turns the follow-up into a GET, so the author lands on the
+// post page.
+describe('posts.update', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({
+      name: 'Edna Author',
+      email: 'edna@example.com',
+      password: 'secret',
+    })
+  })
+
+  it('redirects to the post with 303 after a successful save', async () => {
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, {
+        title: 'Updated title',
+        excerpt: 'Updated excerpt',
+        body: 'Updated body',
+      })
+      .assertStatus(303)
+      .assertHeader('location', `/posts/${post.id}`)
+
+    const updated = await Post.findOrFail(post.id)
+    if (updated.title !== 'Updated title') {
+      throw new Error(`expected the edit to be saved, got ${updated.title}`)
+    }
+  })
+
+  it('still answers an invalid payload with 422', async () => {
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' }).assertStatus(422)
+  })
+})
