+++ b/resources/js/components/publishAt.ts
@@ -0,0 +1,20 @@
+// A datetime-local input speaks the browser's local wall-clock time without an
+// offset; the server takes an ISO 8601 instant, so convert at the boundary.
+
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
+  return local.toISOString().slice(0, 16)
+}
+
+export function fromLocalInput(value: string): string | null {
+  if (value === '') return null
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+export function isScheduled(publishedAt: string | null | undefined): boolean {
+  return publishedAt != null && new Date(publishedAt).getTime() > Date.now()
+}
