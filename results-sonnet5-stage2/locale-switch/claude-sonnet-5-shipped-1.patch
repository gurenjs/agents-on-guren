diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..178d278
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,28 @@
+import { Controller } from '@guren/core'
+
+const ONE_YEAR_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { body } = this.validated('locale.update')
+
+    return this.redirect(this.backPath(), {
+      headers: {
+        'Set-Cookie': `locale=${body.locale}; Path=/; Max-Age=${ONE_YEAR_SECONDS}; SameSite=Lax`,
+      },
+    })
+  }
+
+  // Only the path and query of the Referer are kept, so a foreign Referer
+  // cannot turn this into an open redirect.
+  private backPath(): string {
+    const referer = this.ctx.req.header('Referer')
+    if (!referer) return '/'
+    try {
+      const url = new URL(referer, 'http://localhost')
+      return url.pathname + url.search
+    } catch {
+      return '/'
+    }
+  }
+}
