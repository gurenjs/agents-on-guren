@@ -0,0 +1,34 @@
+import { describe, expect, it } from 'bun:test'
+import { sanitizeRedirectPath } from '../app/Support/Redirects.js'
+
+// The login flow feeds every user-supplied "come back here" value through
+// this guard, so the open-redirect vectors are pinned down here rather than
+// behind an HTTP round trip that also needs a database.
+describe('sanitizeRedirectPath', () => {
+  it('keeps same-app paths', () => {
+    expect(sanitizeRedirectPath('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(sanitizeRedirectPath('/posts?page=2#top')).toBe('/posts?page=2#top')
+    expect(sanitizeRedirectPath('/')).toBe('/')
+  })
+
+  it('rejects anything that could leave this origin', () => {
+    const hostile = [
+      'https://evil.example',
+      'http://evil.example/login',
+      '//evil.example',
+      '/\\evil.example',
+      '\\\\evil.example',
+      '/\t/evil.example',
+      ' //evil.example',
+      'javascript:alert(1)',
+      'evil.example',
+      '',
+      undefined,
+      null,
+    ]
+
+    for (const value of hostile) {
+      expect(sanitizeRedirectPath(value)).toBeNull()
+    }
+  })
+})
