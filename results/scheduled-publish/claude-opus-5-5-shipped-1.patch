@@ -8,11 +8,35 @@ export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
 export class Post extends defineModel(posts, {
   // `authorId` is set from the signed-in user, never from request input.
-  fillable: ['title', 'excerpt', 'body'],
+  fillable: ['title', 'excerpt', 'body', 'publishedAt'],
 }) {
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /** Posts the viewer may see: public ones, plus their own scheduled posts. */
+  static visibleTo(viewerId: number | null, now: Date = new Date()) {
+    // `published_at` holds `toISOString()` output, so text comparison orders by instant.
+    const nowIso = now.toISOString()
+    return Post.newQuery().where((q) => {
+      q.whereNull('publishedAt').orWhere('publishedAt', '<=', nowIso)
+      if (viewerId !== null) {
+        q.orWhere('authorId', viewerId)
+      }
+    })
+  }
+
+  /** Scheduled posts, soonest first; compared as instants, so any stored ISO 8601 form sorts right. */
+  static async scheduled(now: Date = new Date()): Promise<PostRecord[]> {
+    const dated = await Post.newQuery().whereNotNull('publishedAt').orderBy('id', 'asc').get()
+    return dated
+      .filter((post) => Post.isScheduled(post, now))
+      .sort((a, b) => Date.parse(a.publishedAt!) - Date.parse(b.publishedAt!))
+  }
+
+  static isScheduled(post: Pick<PostRecord, 'publishedAt'>, now: Date = new Date()): boolean {
+    return post.publishedAt !== null && new Date(post.publishedAt).getTime() > now.getTime()
+  }
 }
 
