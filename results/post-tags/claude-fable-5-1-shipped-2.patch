+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.put(`/posts/${id}`, { title: 'Tagged', excerpt: 'Excerpt', body: 'Body', tags: 'bun' }).assertStatus(303)
+
+      for (const tag of ['webdev', 'never-used', 'BUN']) {
+        const page = await inertiaProps<PostsIndexPage>(`/posts?tag=${tag}`)
