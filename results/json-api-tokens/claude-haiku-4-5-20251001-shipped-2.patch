+    .get(
+      '/api/posts',
+      { middlewares: [bearerTokenAuth, requireBearerToken, apiRateLimit], name: 'api.posts.index' },
+      [ApiPostController, 'index'],
+    )
+
+  baseRouter
+    .post(
+      '/api/posts',
+      { name: 'api.posts.store', body: PostPayloadSchema, middlewares: [bearerTokenAuth, requireBearerToken, apiRateLimit] },
+      [ApiPostController, 'store'],
+    )
+}
