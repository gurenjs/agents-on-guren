diff --git a/resources/js/lib/useTranslation.ts b/resources/js/lib/useTranslation.ts
new file mode 100644
index 0000000..76a88e6
--- /dev/null
+++ b/resources/js/lib/useTranslation.ts
@@ -0,0 +1,73 @@
+import { usePage } from '@inertiajs/react'
+import type { TranslationKey } from '@/.guren/translations.gen'
+
+type TranslationMessages = { [key: string]: string | TranslationMessages }
+
+interface I18nPageProps {
+  locale: string
+  fallbackLocale: string
+  messages: Record<string, TranslationMessages>
+}
+
+export type ReplacementValues = Record<string, string | number>
+
+export interface Translation {
+  locale: string
+  t: (key: TranslationKey, replacements?: ReplacementValues) => string
+}
+
+function lookup(messages: TranslationMessages | undefined, key: string): string | undefined {
+  let current: string | TranslationMessages | undefined = messages
+  for (const part of key.split('.')) {
+    if (current === undefined || typeof current === 'string') {
+      return undefined
+    }
+    current = current[part]
+  }
+  return typeof current === 'string' ? current : undefined
+}
+
+function interpolate(message: string, replacements?: ReplacementValues): string {
+  if (!replacements) {
+    return message
+  }
+  return Object.entries(replacements).reduce((result, [name, value]) => {
+    const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+    return result
+      .replace(new RegExp(`:${escaped}`, 'g'), () => String(value))
+      .replace(new RegExp(`\\{${escaped}\\}`, 'g'), () => String(value))
+  }, message)
+}
+
+/**
+ * Translate with the locale and messages the server shared for this request:
+ * the `_i18n` prop `createApp({ i18n })` (see src/app.ts) puts on every Inertia
+ * page, carrying the locale detected from `?locale=`, the locale cookie, or
+ * `Accept-Language`, plus the catalogs loaded from lang/<locale>/*.json.
+ *
+ * Guren ships the same hook in `@guren/inertia-client`, but the dev server
+ * import map points that bare specifier at the vendored *client* entry, which
+ * exports `startInertiaClient` alone — importing `useTranslation` from it
+ * leaves the browser unable to link the page module, so the pages read the
+ * shared prop themselves. Lookup matches the server-side Translator:
+ * dot-notation keys, `:name`/`{name}` interpolation, and a fallback-locale
+ * lookup for keys the request locale is missing.
+ *
+ * @example
+ * const { t } = useTranslation()
+ * <h1>{t('auth.login.heading')}</h1>
+ */
+export function useTranslation(): Translation {
+  const { props } = usePage<{ _i18n?: I18nPageProps }>()
+  const i18n = props._i18n
+
+  return {
+    locale: i18n?.locale ?? 'en',
+    t: (key, replacements) => {
+      const message =
+        lookup(i18n?.messages[i18n.locale], key) ??
+        lookup(i18n?.messages[i18n.fallbackLocale], key)
+      return message === undefined ? key : interpolate(message, replacements)
+    },
+  }
+}
