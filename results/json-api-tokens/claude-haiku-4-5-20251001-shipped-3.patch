diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..cad9181
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,199 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+  let user: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'John Doe',
+      email: 'john@example.com',
+      password: 'password123',
+    })
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('creates a token for authenticated user', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const res = await csrf.json().post('/profile/tokens', { name: 'CI Token' })
+
+      res.assertCreated()
+      await res.assertJsonPath('name', 'CI Token')
+      const json = (await res.json()) as any
+      if (json.token && json.token.length < 16) {
+        throw new Error('Token must be at least 16 characters')
+      }
+    })
+
+    it('requires name to be provided', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    })
+
+    it('requires name to be 50 characters or fewer', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const longName = 'a'.repeat(51)
+      await csrf
+        .json()
+        .post('/profile/tokens', { name: longName })
+        .assertUnprocessable()
+    })
+
+    it('redirects guest to login', async () => {
+      await http.json().post('/profile/tokens', { name: 'Test' }).assertForbidden()
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    it('revokes a token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'Test Token' })
+      const { id } = (await createRes.json()) as any
+
+      await csrf.delete(`/profile/tokens/${id}`).assertNoContent()
+
+      const revoked = await ApiToken.find(id)
+      if (revoked !== null) {
+        throw new Error('Token should have been deleted')
+      }
+    })
+
+    it('returns 404 for token of another user', async () => {
+      const otherUser = await User.create({
+        name: 'Jane Doe',
+        email: 'jane@example.com',
+        password: 'password123',
+      })
+
+      const token = await ApiToken.forceCreate({
+        userId: otherUser.id,
+        name: 'Other Token',
+        tokenHash: 'fakehash',
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.delete(`/profile/tokens/${token.id}`).assertNotFound()
+
+      const stillExists = await ApiToken.find(token.id)
+      if (stillExists === null) {
+        throw new Error('Token was deleted unexpectedly')
+      }
+    })
+
+    it('returns 404 for nonexistent token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.delete('/profile/tokens/9999').assertNotFound()
+    })
+
+    it('redirects guest to login', async () => {
+      await http.delete('/profile/tokens/1').assertForbidden()
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    it('requires bearer token', async () => {
+      await http.json().get('/api/posts').assertUnauthorized()
+    })
+
+    it('rejects invalid bearer token', async () => {
+      const app2 = http.withHeader('Authorization', 'Bearer invalid-token')
+      await app2.json().get('/api/posts').assertUnauthorized()
+    })
+
+    it('lists posts with valid bearer token', async () => {
+      await Post.forceCreate({
+        title: 'Test Post',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        authorId: user.id,
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token' })
+      const { token } = (await createRes.json()) as any
+
+      const app2 = http.withHeader('Authorization', `Bearer ${token}`)
+      const res = await app2.json().get('/api/posts')
+
+      res.assertOk()
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it('requires bearer token', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .json()
+        .post('/api/posts', { title: 'Test', excerpt: 'E', body: 'B' })
+        .assertUnauthorized()
+    })
+
+    it('creates post for token owner', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token' })
+      const { token } = (await createRes.json()) as any
+
+      const app2 = http.withHeader('Authorization', `Bearer ${token}`)
+      const res = await app2
+        .json()
+        .post('/api/posts', {
+          title: 'API Post',
+          excerpt: 'Created via API',
+          body: 'This was created using the API',
+        })
+
+      res.assertCreated()
+      await res.assertJsonPath('data.title', 'API Post')
+      await res.assertJsonPath('data.authorId', user.id)
+    })
+
+    it('ignores authorId in request body', async () => {
+      const otherUser = await User.create({
+        name: 'Other User',
+        email: 'other@example.com',
+        password: 'password123',
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token' })
+      const { token } = (await createRes.json()) as any
+
+      const app2 = http.withHeader('Authorization', `Bearer ${token}`)
+      const res = await app2
+        .json()
+        .post('/api/posts', {
+          title: 'API Post',
+          excerpt: 'Created via API',
+          body: 'This was created using the API',
+          authorId: otherUser.id,
+        })
+
+      res.assertCreated()
+      await res.assertJsonPath('data.authorId', user.id)
+    })
+
+    it('validates required fields', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'API Token' })
+      const { token } = (await createRes.json()) as any
+
+      const app2 = http.withHeader('Authorization', `Bearer ${token}`)
+      await app2
+        .json()
+        .post('/api/posts', { title: '', excerpt: 'E', body: 'B' })
+        .assertUnprocessable()
+    })
+  })
+
+})
