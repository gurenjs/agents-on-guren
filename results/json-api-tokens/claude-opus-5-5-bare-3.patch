+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import app from '../src/app.js'
+
+// Personal API tokens: issued and revoked from a signed-in session, then used
+// alone (no session cookie) as a bearer credential against /api/posts.
+describe('personal API tokens', () => {
+  let http: TestApp
+  let browser: TestApp
+  let owner: UserRecord
+  let other: UserRecord
+
+  async function makeUser(label: string): Promise<UserRecord> {
+    const email = `${label}-${crypto.randomUUID()}@example.test`
+    await User.create({ name: label, email, password: 'password123' })
+    const [user] = await User.where({ email })
+    return user as UserRecord
+  }
+
+  async function issueToken(user: UserRecord, name = 'CI'): Promise<{ id: string; name: string; token: string }> {
+    const response = await browser.actingAs(user).json().post('/profile/tokens', { name }).assertStatus(201)
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+
+  const bearer = (token: string) => http.json().withHeaders({ Authorization: `Bearer ${token}` })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    // Session requests carry the CSRF cookie and header, like the profile page.
+    browser = await http.withCsrf('/')
+    owner = await makeUser('owner')
+    other = await makeUser('other')
+  })
+
+  it('issues a token once and stores only a derived value', async () => {
+    const created = await issueToken(owner, 'old laptop')
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|').pop() ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const db = (await getDatabase()) as SQLiteBunDatabase
+    const rows: Record<string, unknown>[] = await db.select().from(apiTokens)
+    expect(rows.length).toBeGreaterThan(0)
+    for (const row of rows) {
+      for (const value of Object.values(row)) {
+        expect(String(value)).not.toContain(secret)
+      }
+    }
+  })
+
+  it('rejects missing, empty and over-long names', async () => {
+    await browser.actingAs(owner).json().post('/profile/tokens', {}).assertStatus(422)
+    await browser.actingAs(owner).json().post('/profile/tokens', { name: '' }).assertStatus(422)
+    await browser.actingAs(owner).json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+  })
+
+  it('lists posts and creates posts owned by the token owner', async () => {
+    const { token } = await issueToken(owner)
+
+    const created = await bearer(token)
+      .post('/api/posts', { title: 'Release notes', excerpt: 'v1', body: 'Shipped.', authorId: other.id })
+      .assertStatus(201)
+    const { data } = (await created.json()) as { data: { id: number; authorId: number; createdAt: string } }
+    expect(data.authorId).toBe(owner.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const listed = await bearer(token).get('/api/posts').assertStatus(200)
+    const list = (await listed.json()) as { data: { id: number }[] }
+    expect(list.data[0]?.id).toBe(data.id)
+  })
+
+  it('rejects invalid posts with 422 and creates nothing', async () => {
+    const { token } = await issueToken(owner)
+    const before = (await Post.all()).length
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertStatus(422)
+    expect((await Post.all()).length).toBe(before)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const { token } = await issueToken(owner)
+    await http.json().get('/api/posts').assertStatus(401)
+    await http.json().withHeaders({ Authorization: 'Token abc' }).get('/api/posts').assertStatus(401)
+    await bearer('nope').get('/api/posts').assertStatus(401)
+    await bearer(`${token}x`).get('/api/posts').assertStatus(401)
+    await bearer(token).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertStatus(201)
+    await bearer(`${token}x`).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertStatus(401)
+  })
+
+  it('revokes only the owner\'s own token', async () => {
+    const mine = await issueToken(owner)
+    const kept = await issueToken(owner)
+    const theirs = await issueToken(other)
+
+    await browser.actingAs(owner).json().delete(`/profile/tokens/${theirs.id}`).assertStatus(404)
+    await bearer(theirs.token).get('/api/posts').assertStatus(200)
+
+    await browser.actingAs(owner).json().delete(`/profile/tokens/${mine.id}`).assertStatus(204)
+    await bearer(mine.token).get('/api/posts').assertStatus(401)
+    await bearer(kept.token).get('/api/posts').assertStatus(200)
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const first = await issueToken(owner)
+    const second = await issueToken(owner)
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertStatus(200)
+    }
+    const limited = await bearer(first.token).get('/api/posts').assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertStatus(200)
+  })
+})
