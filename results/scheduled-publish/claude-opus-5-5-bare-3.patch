--- /dev/null
+++ b/app/Console/Commands/ListScheduledPostsCommand.ts
@@ -0,0 +1,25 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints every scheduled post, soonest first, as `<id>\t<title>\t<published_at>`
+ * with `published_at` exactly as stored — plain lines and nothing else on
+ * stdout, so ops can pipe it into other tools.
+ */
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish later (tab-separated: id, title, published_at)'
+
+  async handle(): Promise<void> {
+    const posts = await Post.newQuery()
+      .whereNotNull('publishedAt')
+      .where('publishedAt', '>', new Date().toISOString())
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
