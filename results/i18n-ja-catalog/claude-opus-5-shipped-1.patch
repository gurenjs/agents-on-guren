new file mode 100644
index 0000000..884d5be
--- /dev/null
+++ b/tests/AuthLocale.test.ts
@@ -0,0 +1,130 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The auth pages read their copy from lang/<locale>/auth.json through
+// `useTranslation()`, so the strings themselves only exist in the `_i18n`
+// shared prop until React mounts (or SSR renders). These tests assert what
+// the server actually decides per request: the resolved locale, the catalog
+// it ships, and the document title/`<html lang>` it renders.
+
+type I18nProps = {
+  locale: string
+  fallbackLocale: string
+  messages: Record<string, Record<string, Record<string, Record<string, string>>>>
+}
+
+function readPage(html: string): { title: string; lang: string; i18n: I18nProps } {
+  const payload = html.match(/<script data-page="app" type="application\/json">(.*?)<\/script>/s)
+  if (!payload) throw new Error('no Inertia page payload in the response')
+
+  const page = JSON.parse(payload[1]!) as { props: { _i18n: I18nProps } }
+
+  return {
+    title: html.match(/<title>(.*?)<\/title>/s)?.[1] ?? '',
+    lang: html.match(/<html lang="(.*?)"/)?.[1] ?? '',
+    i18n: page.props._i18n,
+  }
+}
+
+async function visit(http: TestApp, path: string, acceptLanguage?: string) {
+  const client = acceptLanguage ? http.withHeader('Accept-Language', acceptLanguage) : http
+  const response = await client.get(path)
+  response.assertOk()
+  return readPage(await response.text())
+}
+
+const JAPANESE_HEADERS = ['ja', 'ja-JP', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7']
+const ENGLISH_HEADERS = ['en', 'en-US,en;q=0.9', 'en-US,en;q=0.9,ja;q=0.5', 'fr-FR,fr;q=0.9']
+
+describe('auth pages locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  for (const header of JAPANESE_HEADERS) {
+    it(`renders /login in Japanese for "${header}"`, async () => {
+      const page = await visit(http, '/login', header)
+
+      expect(page.i18n.locale).toBe('ja')
+      expect(page.lang).toBe('ja')
+      expect(page.title).toBe('ログイン')
+      expect(page.i18n.messages.ja!.auth!.login).toEqual({
+        title: 'ログイン',
+        heading: 'ログイン',
+        subtitle: 'アカウントの認証情報を入力して続行してください。',
+        email: 'メールアドレス',
+        password: 'パスワード',
+        remember: 'ログイン状態を保持する',
+        submit: 'ログイン',
+        noAccount: 'アカウントをお持ちでないですか？',
+        signUp: 'アカウント登録',
+      })
+    })
+
+    it(`renders /register in Japanese for "${header}"`, async () => {
+      const page = await visit(http, '/register', header)
+
+      expect(page.i18n.locale).toBe('ja')
+      expect(page.lang).toBe('ja')
+      expect(page.title).toBe('アカウント登録')
+      expect(page.i18n.messages.ja!.auth!.register).toEqual({
+        title: 'アカウント登録',
+        heading: 'アカウント登録',
+        subtitle: 'アカウントを作成して始めましょう。',
+        name: '名前',
+        email: 'メールアドレス',
+        password: 'パスワード',
+        passwordConfirmation: 'パスワード（確認）',
+        submit: '登録',
+        haveAccount: 'すでにアカウントをお持ちですか？',
+        signIn: 'ログイン',
+      })
+    })
+  }
+
+  for (const header of [...ENGLISH_HEADERS, undefined]) {
+    it(`renders /login in English for "${header ?? 'no Accept-Language'}"`, async () => {
+      const page = await visit(http, '/login', header)
+
+      expect(page.i18n.locale).toBe('en')
+      expect(page.lang).toBe('en')
+      expect(page.title).toBe('Sign in')
+      expect(page.i18n.messages.ja).toBeUndefined()
+      expect(page.i18n.messages.en!.auth!.login).toEqual({
+        title: 'Sign in',
+        heading: 'Sign in',
+        subtitle: 'Use your account credentials to continue.',
+        email: 'Email',
+        password: 'Password',
+        remember: 'Remember me',
+        submit: 'Sign in',
+        noAccount: "Don't have an account?",
+        signUp: 'Sign up',
+      })
+    })
+
+    it(`renders /register in English for "${header ?? 'no Accept-Language'}"`, async () => {
+      const page = await visit(http, '/register', header)
+
+      expect(page.i18n.locale).toBe('en')
+      expect(page.lang).toBe('en')
+      expect(page.title).toBe('Sign up')
+      expect(page.i18n.messages.ja).toBeUndefined()
+      expect(page.i18n.messages.en!.auth!.register).toEqual({
+        title: 'Sign up',
+        heading: 'Create an account',
+        subtitle: 'Sign up to get started.',
+        name: 'Name',
+        email: 'Email',
+        password: 'Password',
+        passwordConfirmation: 'Confirm password',
+        submit: 'Create account',
+        haveAccount: 'Already have an account?',
+        signIn: 'Sign in',
+      })
+    })
+  }
+})
diff --git a/tests/TranslationCatalogs.test.ts b/tests/TranslationCatalogs.test.ts
new file mode 100644
index 0000000..80329ac
--- /dev/null
+++ b/tests/TranslationCatalogs.test.ts
@@ -0,0 +1,55 @@
+import { readdirSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'bun:test'
+
+// lang/ is a JsonLoader bundle: lang/<locale>/<namespace>.json, keys addressed
+// as `<namespace>.<path.to.key>`. Every key must exist in every locale — a key
+// translated on one side only makes a page silently fall back to English for
+// that one label.
+
+const LANG_DIR = fileURLToPath(new URL('../lang', import.meta.url))
+const LOCALES = ['en', 'ja'] as const
+
+type Messages = { [key: string]: string | Messages }
+
+async function loadCatalog(locale: string): Promise<Map<string, string>> {
+  const flat = new Map<string, string>()
+
+  for (const file of readdirSync(`${LANG_DIR}/${locale}`).filter((name) => name.endsWith('.json')).sort()) {
+    const namespace = file.slice(0, -'.json'.length)
+    const messages = (await import(`${LANG_DIR}/${locale}/${file}`, { with: { type: 'json' } })).default as Messages
+
+    const walk = (node: Messages, prefix: string): void => {
+      for (const [key, value] of Object.entries(node)) {
+        if (typeof value === 'string') flat.set(`${prefix}.${key}`, value)
+        else walk(value, `${prefix}.${key}`)
+      }
+    }
+
+    walk(messages, namespace)
+  }
+
+  return flat
+}
+
+function placeholders(message: string): string[] {
+  return (message.match(/:[a-zA-Z_][a-zA-Z0-9_]*|\{[a-zA-Z_][a-zA-Z0-9_]*\}/g) ?? []).sort()
+}
+
+describe('translation catalogs', () => {
+  it('defines the same keys in every locale', async () => {
+    const [en, ja] = await Promise.all(LOCALES.map(loadCatalog))
+
+    expect([...ja!.keys()].sort()).toEqual([...en!.keys()].sort())
+    expect(en!.size).toBeGreaterThan(0)
+  })
+
+  it('keeps every placeholder from the English message', async () => {
+    const en = await loadCatalog('en')
+    const ja = await loadCatalog('ja')
+
+    for (const [key, message] of en) {
+      expect(placeholders(ja.get(key) ?? '')).toEqual(placeholders(message))
+    }
+  })
+})
