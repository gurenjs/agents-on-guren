diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..a51d8f4
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,94 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2000-01-01T00:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+  let open: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })) as UserRecord
+    scheduled = (await Post.forceCreate({
+      title: 'Launch post',
+      excerpt: 'Soon',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as PostRecord
+    open = (await Post.forceCreate({ title: 'Live post', excerpt: 'Now', body: 'Body', authorId: author.id })) as PostRecord
+  })
+
+  function listedIds(page: { props: { data: { id: number }[] } }): number[] {
+    return page.props.data.map((post) => post.id)
+  }
+
+  async function indexIds(client: TestApp): Promise<number[]> {
+    const res = await client.withHeader('X-Inertia', 'true').get('/posts')
+    return listedIds(await res.json())
+  }
+
+  it('hides a scheduled post from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+    expect(await indexIds(http)).toEqual([open.id])
+    expect(await indexIds(http.actingAs(other))).toEqual([open.id])
+
+    const res = await http.json().query('/posts/search', { keywords: ['post'] })
+    const ids = ((await res.json()) as { data: { id: number }[] }).data.map((post) => post.id)
+    expect(ids).toEqual([open.id])
+  })
+
+  it('shows a scheduled post to its author with its publish time', async () => {
+    await http
+      .actingAs(author)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${scheduled.id}`)
+      .assertOk()
+      .assertJsonPath('props.post.publishedAt', FUTURE)
+    expect(await indexIds(http.actingAs(author))).toEqual([open.id, scheduled.id])
+  })
+
+  it('is public once the time has passed', async () => {
+    await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    expect(await indexIds(http)).toEqual([open.id, scheduled.id])
+  })
+
+  it('stores publishAt on create and rejects a non-date', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: FUTURE }).assertRedirect()
+    const created = await Post.first({ title: 'T' })
+    expect(created?.publishedAt).toBe(FUTURE)
+
+    await csrf
+      .put(`/posts/${created!.id}`, { title: 'T', excerpt: 'E', body: 'B', publishAt: null })
+      .assertRedirect()
+    expect((await Post.find(created!.id))?.publishedAt).toBeNull()
+  })
+
+  it('reports scheduled posts from the console', async () => {
+    const proc = Bun.spawn(['bun', 'run', 'console', 'posts:scheduled'], { stdout: 'pipe', stderr: 'pipe' })
+    const stdout = await new Response(proc.stdout).text()
+    expect(await proc.exited).toBe(0)
+    expect(stdout).toBe(`${scheduled.id}\tLaunch post\t${FUTURE}\n`)
+  })
+})
