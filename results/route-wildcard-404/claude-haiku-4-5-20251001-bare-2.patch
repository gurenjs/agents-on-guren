+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns archive by year', async () => {
+    const res = await http.get('/posts/archive/2026')
+    res.assertStatus(200)
+    const body = await res.json()
+    // Verify the response has the expected structure
+    if (typeof body !== 'object' || !('data' in body)) {
+      throw new Error('Expected { data: [...] } structure')
+    }
+  })
+
+  it('returns archive by year and month with leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/08')
+    res.assertStatus(200)
+    const body = await res.json()
+    if (typeof body !== 'object' || !('data' in body)) {
+      throw new Error('Expected { data: [...] } structure')
+    }
+  })
+
+  it('returns archive by year and month without leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/8')
+    res.assertStatus(200)
+    const body = await res.json()
+    if (typeof body !== 'object' || !('data' in body)) {
+      throw new Error('Expected { data: [...] } structure')
+    }
+  })
+
+  it('rejects invalid month', async () => {
+    const res = await http.get('/posts/archive/2026/13')
+    res.assertStatus(422)
+  })
