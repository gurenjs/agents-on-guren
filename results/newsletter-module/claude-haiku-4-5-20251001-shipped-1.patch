@@ -0,0 +1,38 @@
+import { Controller, ValidationException } from '@guren/core'
+import { SubscribeSchema, UnsubscribeSchema } from '../Validators/SubscribeValidator.js'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class SubscribeController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    const token = this.generateToken()
+    await NewsletterSubscription.create({ email, token })
+
+    const referer = this.request.header('Referer') ?? '/'
+    return this.redirect(referer)
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    const referer = this.request.header('Referer') ?? '/'
+    return this.redirect(referer)
+  }
+
+  private generateToken(): string {
+    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
+    let token = ''
+    for (let i = 0; i < 32; i++) {
+      token += chars.charAt(Math.floor(Math.random() * chars.length))
+    }
+    return token
+  }
+}
