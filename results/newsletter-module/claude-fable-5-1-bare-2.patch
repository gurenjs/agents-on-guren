index 0000000..47d93f3
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/SubscriptionController.ts
@@ -0,0 +1,72 @@
+import { Controller, ValidationException } from '@guren/core'
+import { Subscription } from '../../Models/Subscription.js'
+
+const ALREADY_SUBSCRIBED = 'This email address is already subscribed.'
+
+export default class SubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await Subscription.first({ email })) {
+      throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+    }
+
+    try {
+      // forceCreate, because `token` is deliberately absent from
+      // Subscription.fillable: a request must never be able to choose it.
+      await Subscription.forceCreate({ email, token: Subscription.generateToken() })
+    } catch (error) {
+      // Two requests for one address can both pass the lookup above; the
+      // unique index then rejects the second, which is the same outcome.
+      if (await Subscription.first({ email })) {
+        throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+      }
+      throw error
+    }
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validated('newsletter.confirm').params
+    const subscription = await Subscription.findOrFail(token, 'token')
+
+    // Following the link again keeps the original confirmation time.
+    if (!subscription.confirmedAt) {
+      await Subscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    // An address we do not have gets the same answer, so this endpoint does
+    // not reveal who is subscribed.
+    await Subscription.delete({ email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  /**
+   * The page the visitor came from, or the home page. `Referer` is
+   * client-controlled, so it is followed only when it names this site —
+   * otherwise a crafted form could bounce visitors to another origin.
+   */
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) return '/'
+
+    try {
+      const current = new URL(this.request.url)
+      // Resolved the way a browser resolves `Location`, so what is compared
+      // here is where the redirect would actually land.
+      const previous = new URL(referer, current)
+      const sameSite = previous.host === current.host && /^https?:$/.test(previous.protocol)
+      return sameSite ? referer : '/'
+    } catch {
+      return '/'
+    }
+  }
+}
diff --git a/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
new file mode 100644
index 0000000..b7d9032
--- /dev/null
+++ b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
@@ -0,0 +1,22 @@
+import { z } from 'zod'
+
+// Lowercased so the same address typed with different casing is one
+// subscription, and unsubscribing finds the row subscribing stored.
+const email = z
+  .string()
+  .trim()
+  .min(1, 'Email is required.')
+  .max(254, 'Email must be 254 characters or fewer.')
+  .toLowerCase()
+  .pipe(z.email('Enter a valid email address.'))
+
+export const SubscribeSchema = z.object({ email })
+
+export const UnsubscribeSchema = z.object({ email })
+
+export const ConfirmParamsSchema = z.object({
+  token: z.string().min(1).max(255),
+})
+
+export type SubscribeInput = z.infer<typeof SubscribeSchema>
+export type UnsubscribeInput = z.infer<typeof UnsubscribeSchema>
