+
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns paginated posts with metadata', async () => {
+    const res = await http.get('/api/posts')
+    expect(res.status).toBe(200)
+    const json = await res.json()
+    expect(json.data).toBeInstanceOf(Array)
+    expect(json.meta.currentPage).toBe(1)
+    expect(json.meta.perPage).toBe(10)
+    expect(json.meta.total).toBeGreaterThanOrEqual(0)
+    expect(json.meta.lastPage).toBeGreaterThanOrEqual(1)
+    if (json.data.length > 0) {
+      const post = json.data[0]
+      expect(post).toHaveProperty('id')
+      expect(post).toHaveProperty('title')
+      expect(post).toHaveProperty('excerpt')
+      expect(post).toHaveProperty('createdAt')
+      expect(post).toHaveProperty('authorId')
+      if (post.author) {
+        expect(post.author).toHaveProperty('id')
+        expect(post.author).toHaveProperty('name')
+      }
+    }
+  })
+
+  it('rejects invalid page parameter', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects invalid author parameter', async () => {
+    await http.get('/api/posts?author=0').assertStatus(422)
+    await http.get('/api/posts?author=abc').assertStatus(422)
+  })
+})
