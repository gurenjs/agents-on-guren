diff --git a/app/Services/StorageService.ts b/app/Services/StorageService.ts
new file mode 100644
index 0000000..87fbdf0
--- /dev/null
+++ b/app/Services/StorageService.ts
@@ -0,0 +1,50 @@
+import fs from 'fs/promises'
+import path from 'path'
+import { Attachment } from '../Models/Attachment.js'
+import type { AttachmentRecord } from '../Models/Attachment.js'
+
+const STORAGE_DIR = path.join(process.cwd(), 'storage', 'attachments')
+
+export class StorageService {
+  static async ensureStorageDir(): Promise<void> {
+    await fs.mkdir(STORAGE_DIR, { recursive: true })
+  }
+
+  static async saveFile(file: File, filename: string): Promise<AttachmentRecord> {
+    await this.ensureStorageDir()
+
+    const filepath = path.join(STORAGE_DIR, filename)
+    const buffer = await file.arrayBuffer()
+    await fs.writeFile(filepath, Buffer.from(buffer))
+
+    const attachment = await Attachment.create({
+      path: filename,
+      mimeType: file.type,
+    })
+
+    return attachment
+  }
+
+  static async deleteFile(attachment: AttachmentRecord): Promise<void> {
+    const filepath = path.join(STORAGE_DIR, attachment.path)
+    try {
+      await fs.unlink(filepath)
+    } catch (error) {
+      // File might already be deleted or not exist
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
+        throw error
+      }
+    }
+
+    await Attachment.delete({ id: attachment.id })
+  }
+
+  static getFilePath(filename: string): string {
+    return path.join(STORAGE_DIR, filename)
+  }
+
+  static async readFile(filename: string): Promise<Buffer> {
+    const filepath = this.getFilePath(filename)
+    return fs.readFile(filepath)
+  }
+}
