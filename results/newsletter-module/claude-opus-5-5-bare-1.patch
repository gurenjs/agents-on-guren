+import { z } from 'zod'
+
+// Lowercased so the same address always maps to the same subscription row.
+const EmailSchema = z
+  .string()
+  .trim()
+  .min(1, 'Email is required.')
+  .toLowerCase()
+  .pipe(z.email('The email address is badly formatted.'))
+
+export const NewsletterEmailSchema = z.object({
+  email: EmailSchema,
+})
+
+export const NewsletterTokenParamSchema = z.object({
+  token: z.string().min(1),
+})
+
+export type NewsletterEmailInput = z.infer<typeof NewsletterEmailSchema>
