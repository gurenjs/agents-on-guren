  "tasks": [
    {
      "id": "task.comments",
      "entity": "Comment",
      "summary": "Comment on a post, delete a comment as its author or the post's author, and remove a post's comments with it.",
      "covers": [
        "model.user",
        "model.post",
        "model.comment",
        "validator.commentId",
        "validator.comment",
        "controller.posts",
        "controller.comments",
        "route.comments.store",
        "route.comments.destroy",
        "view.posts.show",
        "resource.comment",
        "policy.comment"
      ],
      "acceptance": [
        {
          "id": "AC-comments-1",
          "description": "A signed-in user can comment on someone else's post, and the post page lists the comment with its author.",
          "kind": "success",
          "actor": "user",
          "route": "route.comments.store",
          "given": [
            "a post written by another user exists"
          ],
          "input": [
            {
              "name": "body",
              "json": "\"Nice post\""
            }
          ],
          "expect": {
            "status": 303,
            "redirect": "/posts/:id",
            "database": [
              {
                "table": "comments",
                "has": [
                  {
                    "name": "body",
                    "json": "\"Nice post\""
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "AC-comments-2",
          "description": "An empty comment is rejected.",
          "kind": "validation",
          "actor": "user",
          "route": "route.comments.store",
          "given": [
            "a post exists"
          ],
          "input": [
            {
              "name": "body",
              "json": "\"\""
            }
          ],
          "expect": {
            "status": 422,
            "errors": [
              "body"
            ]
          }
        },
        {
          "id": "AC-comments-3",
          "description": "A comment longer than 2000 characters is rejected.",
          "kind": "validation",
          "actor": "user",
          "route": "route.comments.store",
          "given": [
            "a post exists"
          ],
          "input": [
            {
              "name": "body",
              "json": "\"\""
            }
          ],
          "expect": {
            "status": 422,
            "errors": [
              "body"
            ]
          }
        },
        {
          "id": "AC-comments-4",
          "description": "A guest who tries to comment is sent to the login page and nothing is stored.",
          "kind": "unauthenticated",
          "actor": "guest",
          "route": "route.comments.store",
          "given": [
            "a post exists"
          ],
          "input": [
            {
              "name": "body",
              "json": "\"Hello\""
            }
          ],
          "expect": {
            "redirect": "/login"
          }
        },
        {
          "id": "AC-comments-5",
          "description": "The post page lists visible comments oldest first, each with id, body, author and createdAt.",
          "kind": "success",
          "actor": "guest",
          "route": "route.posts.show",
          "given": [
            "a post with two comments exists"
          ],
          "expect": {
            "status": 200,
            "inertia": "view.posts.show"
          }
        },
        {
          "id": "AC-comments-6",
          "description": "The author of a comment can delete it.",
          "kind": "success",
          "actor": "user",
          "route": "route.comments.destroy",
          "given": [
            "a comment the user wrote exists"
          ],
          "expect": {
            "status": 303,
            "database": [
              {
                "table": "comments",
                "missing": [
                  {
                    "name": "body",
                    "json": "\"Mine\""
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "AC-comments-7",
          "description": "The author of the post can delete someone else's comment on it.",
          "kind": "success",
          "actor": "user",
          "route": "route.comments.destroy",
          "given": [
            "another user commented on the user's post"
          ],
          "expect": {
            "status": 303,
            "database": [
              {
                "table": "comments",
                "missing": [
                  {
                    "name": "body",
                    "json": "\"Theirs\""
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "AC-comments-8",
          "description": "A user who wrote neither the comment nor the post cannot delete the comment, and it stays.",
          "kind": "forbidden",
          "actor": "user",
          "route": "route.comments.destroy",
          "given": [
            "a comment by another user on a third user's post exists"
          ],
          "expect": {
            "status": 403,
            "database": [
              {
                "table": "comments",
                "has": [
                  {
                    "name": "body",
                    "json": "\"Keep me\""
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "AC-comments-9",
          "description": "A guest cannot delete a comment.",
          "kind": "unauthenticated",
          "actor": "guest",
          "route": "route.comments.destroy",
          "given": [
            "a comment exists"
          ],
          "expect": {
            "redirect": "/login"
          }
        },
        {
          "id": "AC-comments-10",
          "description": "Deleting a post removes its comments.",
          "kind": "state",
          "actor": "user",
          "route": "route.posts.destroy",
          "given": [
            "the user's post has a comment"
          ],
          "expect": {
            "status": 303,
            "database": [
              {
                "table": "comments",
                "missing": [
                  {
                    "name": "body",
                    "json": "\"On a deleted post\""
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "task.commentReports",
      "entity": "CommentReport",
      "summary": "Report a comment once per user; a comment three different users reported disappears from the post page and stays in the database.",
      "covers": [
        "model.commentReport",
        "action.comments.report",
        "route.comments.report",
        "action.posts.show"
      ],
      "acceptance": [
        {
          "id": "AC-reports-1",
          "description": "A signed-in user can report a comment.",
          "kind": "success",
          "actor": "user",
          "route": "route.comments.report",
          "given": [
            "a comment exists"
          ],
          "expect": {
            "status": 204
          }
        },
        {
          "id": "AC-reports-2",
          "description": "Reporting the same comment twice keeps one report and answers 204 both times.",
          "kind": "state",
          "actor": "user",
          "route": "route.comments.report",
          "given": [
            "the user already reported the comment"
          ],
          "expect": {
            "status": 204
          }
        },
        {
          "id": "AC-reports-3",
          "description": "A guest cannot report a comment.",
          "kind": "unauthenticated",
          "actor": "guest",
          "route": "route.comments.report",
          "given": [
            "a comment exists"
          ],
          "expect": {
            "redirect": "/login"
          }
        },
        {
          "id": "AC-reports-4",
          "description": "A comment reported by three different users is absent from the post page and still in the database.",
          "kind": "state",
          "actor": "guest",
          "route": "route.posts.show",
          "given": [
            "three different users reported a comment on the post"
          ],
          "expect": {
            "status": 200,
            "inertia": "view.posts.show",
            "database": [
              {
                "table": "comments",
                "has": [
                  {
                    "name": "body",
                    "json": "\"Spam\""
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
