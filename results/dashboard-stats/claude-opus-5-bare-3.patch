diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..a47ea48
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,87 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+// The dashboard reads the signed-in user's own posts, so this suite needs a
+// real database: migrations run against ./data/guren.test.db (config/database.ts
+// picks that file under NODE_ENV=test, which `bun test` sets). Each run makes
+// its own author with a unique email, so it never collides with the seeders or
+// with a previous run's leftovers.
+describe('dashboard', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    const stamp = `${Date.now()}-${Math.round(Math.random() * 1e6)}`
+    author = (await User.create({
+      name: 'Dashboard Author',
+      email: `author-${stamp}@example.com`,
+      password: 'secret',
+    })) as UserRecord
+    other = (await User.create({
+      name: 'Someone Else',
+      email: `other-${stamp}@example.com`,
+      password: 'secret',
+    })) as UserRecord
+
+    for (let index = 1; index <= 7; index += 1) {
+      await Post.forceCreate({
+        title: `Author post ${index}`,
+        excerpt: `Excerpt ${index}`,
+        body: `Body ${index}`,
+        authorId: author.id,
+      })
+    }
+
+    await Post.forceCreate({
+      title: 'Not mine',
+      excerpt: 'Written by someone else',
+      body: 'Should never show on the other dashboard',
+      authorId: other.id,
+    })
+  })
+
+  it('sends guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows the signed-in user their post count and five newest posts', async () => {
+    const response = await http.actingAs(author).get('/dashboard').assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const props = payload.props as {
+      postCount: number
+      recentPosts: Array<{ id: number; title: string }>
+    }
+
+    expect(props.postCount).toBe(7)
+    expect(props.recentPosts).toHaveLength(5)
+    expect(props.recentPosts.map((post) => post.title)).toEqual([
+      'Author post 7',
+      'Author post 6',
+      'Author post 5',
+      'Author post 4',
+      'Author post 3',
+    ])
+    expect(props.recentPosts.every((post) => typeof post.id === 'number')).toBe(true)
+  })
+
+  it('never leaks another user’s posts', async () => {
+    const response = await http.actingAs(other).get('/dashboard').assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const props = payload.props as {
+      postCount: number
+      recentPosts: Array<{ id: number; title: string }>
+    }
+
+    expect(props.postCount).toBe(1)
+    expect(props.recentPosts.map((post) => post.title)).toEqual(['Not mine'])
+  })
+})
