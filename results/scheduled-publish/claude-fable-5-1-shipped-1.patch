diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..4a5f446
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,253 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2999-10-01T09:00:00.000Z'
+const PAST = '2001-10-01T09:00:00.000Z'
+
+interface PostJson {
+  id: number
+  title: string
+  publishedAt: string | null
+  scheduled: boolean
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    stranger = await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret-password' })
+  })
+
+  function createPost(title: string, publishedAt: string | null, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: owner.id, publishedAt })
+  }
+
+  async function inertiaProps<T>(client: TestApp, path: string): Promise<T> {
+    const response = await client.withHeader('X-Inertia', 'true').get(path)
+    response.assertOk()
+    const page = await response.json<{ props: T }>()
+    return page.props
+  }
+
+  async function listedTitles(client: TestApp): Promise<string[]> {
+    const { data } = await inertiaProps<{ data: PostJson[] }>(client, '/posts')
+    return data.map((post) => post.title)
+  }
+
+  async function searchTitles(client: TestApp, keyword: string): Promise<string[]> {
+    const response = await client.json().query('/posts/search', { keywords: [keyword] })
+    response.assertOk()
+    const { data } = await response.json<{ data: PostJson[] }>()
+    return data.map((post) => post.title)
+  }
+
+  describe('storing the date', () => {
+    it('publishes immediately when publishAt is absent', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', { title: 'Now', excerpt: 'e', body: 'b' }).assertRedirect()
+
+      const post = await Post.first({ title: 'Now' })
+      expect(post?.publishedAt).toBeNull()
+      expect(await listedTitles(http)).toEqual(['Now'])
+    })
+
+    it('publishes immediately when publishAt is null', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', { title: 'Now', excerpt: 'e', body: 'b', publishAt: null }).assertRedirect()
+
+      expect((await Post.first({ title: 'Now' }))?.publishedAt).toBeNull()
+    })
+
+    it('stores publishAt as an ISO 8601 UTC timestamp', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', { title: 'Later', excerpt: 'e', body: 'b', publishAt: FUTURE }).assertRedirect()
+
+      expect((await Post.first({ title: 'Later' }))?.publishedAt).toBe(FUTURE)
+    })
+
+    it('normalizes an offset to UTC', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .post('/posts', { title: 'Offset', excerpt: 'e', body: 'b', publishAt: '2999-10-01T11:00:00+02:00' })
+        .assertRedirect()
+
+      expect((await Post.first({ title: 'Offset' }))?.publishedAt).toBe(FUTURE)
+    })
+
+    it('rejects a value that is not a date and time, and saves nothing', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+
+      for (const publishAt of ['next tuesday', '', '2999-10-01', '2999-10-01T09:00:00', '2999-02-30T09:00:00.000Z', 42]) {
+        const response = await csrf.json().post('/posts', { title: 'Bad', excerpt: 'e', body: 'b', publishAt })
+        response.assertUnprocessable()
+        const { errors } = await response.json<{ errors: Record<string, string[]> }>()
+        expect(errors.publishAt).toBeDefined()
+      }
+
+      expect(await Post.newQuery().count()).toBe(0)
+    })
+
+    it('rejects an invalid date on update and keeps the post as it was', async () => {
+      const post = await createPost('Launch', FUTURE)
+      const csrf = await http.actingAs(author).withCsrf()
+
+      await csrf
+        .json()
+        .put(`/posts/${post.id}`, { title: 'Changed', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+        .assertUnprocessable()
+
+      const stored = await Post.findOrFail(post.id)
+      expect(stored.title).toBe('Launch')
+      expect(stored.publishedAt).toBe(FUTURE)
+    })
+
+    it('sets, changes and clears the date on update', async () => {
+      const post = await createPost('Launch', null)
+      const csrf = await http.actingAs(author).withCsrf()
+      const payload = { title: 'Launch', excerpt: 'e', body: 'b' }
+
+      await csrf.put(`/posts/${post.id}`, { ...payload, publishAt: FUTURE }).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBe(FUTURE)
+
+      await csrf.put(`/posts/${post.id}`, { ...payload, publishAt: '2998-01-01T00:00:00.000Z' }).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBe('2998-01-01T00:00:00.000Z')
+
+      await csrf.put(`/posts/${post.id}`, { ...payload, publishAt: null }).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+
+      await csrf.put(`/posts/${post.id}`, { ...payload, publishAt: FUTURE }).assertRedirect()
+      await csrf.put(`/posts/${post.id}`, payload).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+    })
+  })
+
+  describe('a scheduled post', () => {
+    let scheduled: PostRecord
+
+    beforeEach(async () => {
+      await createPost('Public', null)
+      scheduled = await createPost('Launch', FUTURE)
+    })
+
+    it('answers 404 on its page for guests and other users', async () => {
+      await http.get(`/posts/${scheduled.id}`).assertNotFound()
+      await http.actingAs(stranger).get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('opens for its author with publishedAt', async () => {
+      const { post } = await inertiaProps<{ post: PostJson }>(http.actingAs(author), `/posts/${scheduled.id}`)
+
+      expect(post.publishedAt).toBe(FUTURE)
+      expect(post.scheduled).toBe(true)
+    })
+
+    it('is absent from the list for guests and other users', async () => {
+      expect(await listedTitles(http)).toEqual(['Public'])
+      expect(await listedTitles(http.actingAs(stranger))).toEqual(['Public'])
+    })
+
+    it('is listed for its author with publishedAt', async () => {
+      const { data } = await inertiaProps<{ data: PostJson[] }>(http.actingAs(author), '/posts')
+
+      expect(data.map((post) => post.title)).toEqual(['Launch', 'Public'])
+      expect(data[0]?.publishedAt).toBe(FUTURE)
+    })
+
+    it('does not count towards the list total for those who cannot see it', async () => {
+      const guest = await inertiaProps<{ pagination: { meta: { total: number } } }>(http, '/posts')
+      const owner = await inertiaProps<{ pagination: { meta: { total: number } } }>(http.actingAs(author), '/posts')
+
+      expect(guest.pagination.meta.total).toBe(1)
+      expect(owner.pagination.meta.total).toBe(2)
+    })
+
+    it('does not come up in search for guests and other users', async () => {
+      expect(await searchTitles(http, 'Launch')).toEqual([])
+      expect(await searchTitles(http.actingAs(stranger), 'Launch')).toEqual([])
+      expect(await searchTitles(http, 'excerpt')).toEqual(['Public'])
+    })
+
+    it('is hidden from the home page', async () => {
+      const { latest } = await inertiaProps<{ latest: PostJson[] }>(http, '/')
+
+      expect(latest.map((post) => post.title)).toEqual(['Public'])
+    })
+
+    it('does not reveal itself to another user through edit, update or delete', async () => {
+      const csrf = await http.actingAs(stranger).withCsrf()
+
+      await csrf.get(`/posts/${scheduled.id}/edit`).assertNotFound()
+      await csrf.put(`/posts/${scheduled.id}`, { title: 't', excerpt: 'e', body: 'b' }).assertNotFound()
+      await csrf.delete(`/posts/${scheduled.id}`).assertNotFound()
+
+      expect((await Post.findOrFail(scheduled.id)).title).toBe('Launch')
+    })
+
+    it('another user scheduling their own post does not expose this one', async () => {
+      await createPost('Theirs', FUTURE, stranger)
+
+      expect(await listedTitles(http.actingAs(stranger))).toEqual(['Theirs', 'Public'])
+    })
+
+    it('is public everywhere once its time has passed', async () => {
+      await Post.forceUpdate({ id: scheduled.id }, { publishedAt: PAST })
+
+      await http.get(`/posts/${scheduled.id}`).assertOk()
+      await http.actingAs(stranger).get(`/posts/${scheduled.id}`).assertOk()
+      expect(await listedTitles(http)).toEqual(['Launch', 'Public'])
+      expect(await searchTitles(http, 'Launch')).toEqual(['Launch'])
+
+      const { post } = await inertiaProps<{ post: PostJson }>(http, `/posts/${scheduled.id}`)
+      expect(post.publishedAt).toBe(PAST)
+      expect(post.scheduled).toBe(false)
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    async function report(): Promise<{ stdout: string; exitCode: number }> {
+      const child = Bun.spawn(['bun', 'run', 'console', 'posts:scheduled'], {
+        cwd: new URL('..', import.meta.url).pathname,
+        env: { ...process.env, NODE_ENV: 'test' },
+        stdout: 'pipe',
+        stderr: 'pipe',
+      })
+      const stdout = await new Response(child.stdout).text()
+      return { stdout, exitCode: await child.exited }
+    }
+
+    it('prints scheduled posts soonest first and nothing else', async () => {
+      await createPost('Public', null)
+      await createPost('Already live', PAST)
+      const later = await createPost('Later', '2999-12-01T09:00:00.000Z')
+      const sooner = await createPost('Sooner', FUTURE)
+
+      const { stdout, exitCode } = await report()
+
+      expect(exitCode).toBe(0)
+      expect(stdout).toBe(
+        `${sooner.id}\tSooner\t${FUTURE}\n${later.id}\tLater\t2999-12-01T09:00:00.000Z\n`,
+      )
+    })
+
+    it('prints nothing when nothing is scheduled', async () => {
+      await createPost('Public', null)
+
+      const { stdout, exitCode } = await report()
+
+      expect(exitCode).toBe(0)
+      expect(stdout).toBe('')
+    })
+  })
+})
