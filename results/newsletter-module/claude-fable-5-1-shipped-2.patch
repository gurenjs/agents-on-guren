new file mode 100644
index 0000000..e0dc87d
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,63 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+const ALREADY_SUBSCRIBED = 'This email address is already subscribed.'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+    }
+
+    try {
+      // forceCreate, because `token` is deliberately absent from the model's
+      // fillable: it is generated here and a request must never set it.
+      await NewsletterSubscription.forceCreate({ email, token: randomBytes(32).toString('hex') })
+    } catch (error) {
+      // Two concurrent sign-ups can both pass the lookup above; the unique
+      // index on `email` rejects the second one.
+      if (isUniqueViolation(error)) {
+        throw ValidationException.withMessages({ email: ALREADY_SUBSCRIBED })
+      }
+      throw error
+    }
+
+    return this.redirect(this.previousUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    // A repeated visit keeps the time of the first confirmation.
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.previousUrl())
+  }
+
+  // The Referer header is request input: following it to another origin would
+  // make these endpoints an open redirect.
+  private previousUrl(): string {
+    const referer = this.request.header('referer')
+    return referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+  }
+}
+
+function isUniqueViolation(error: unknown): boolean {
+  return error instanceof Error && /unique constraint/i.test(`${error.message} ${String(error.cause ?? '')}`)
+}
