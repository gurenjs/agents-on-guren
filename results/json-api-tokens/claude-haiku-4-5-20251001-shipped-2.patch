--- /dev/null
+++ b/app/Http/Middleware/RateLimitApiToken.ts
@@ -0,0 +1,25 @@
+import { defineMiddleware, type Context } from '@guren/core'
+import { RateLimiterService } from '../../Services/RateLimiterService.js'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export const rateLimitApiToken = defineMiddleware(async (c: Context, next) => {
+  const apiToken = c.get('apiToken') as ApiTokenRecord | undefined
+
+  if (!apiToken) {
+    return next()
+  }
+
+  const { allowed, secondsUntilReset } = RateLimiterService.checkAndIncrement(apiToken.id)
+
+  if (!allowed) {
+    return c.json(
+      { message: 'Too many requests.' },
+      {
+        status: 429,
+        headers: { 'Retry-After': secondsUntilReset.toString() },
+      }
+    )
+  }
+
+  return next()
+})
