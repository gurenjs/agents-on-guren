@@ -0,0 +1,26 @@
+import { Controller, NotFoundHttpException, createApiToken, getUserApiTokens, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/api-tokens.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    // The plain text exists only in this response; the store keeps its hash.
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    const owned = await getUserApiTokens(user.id, apiTokenStore)
+    if (!owned.some((token) => token.id === id)) {
+      throw new NotFoundHttpException('API token not found.')
+    }
+
+    await revokeApiToken(id, apiTokenStore)
+    return this.noContent()
+  }
+}
