@@ -0,0 +1,17 @@
+import { z } from 'zod'
+
+export const ApiTokenCreateSchema = z.object({
+  name: z
+    .string()
+    .trim()
+    .min(1, 'Name is required.')
+    .max(50, 'Name must be 50 characters or fewer.'),
+})
+
+export type ApiTokenCreateInput = z.infer<typeof ApiTokenCreateSchema>
+
+// Token ids are the 32 hex characters `createApiToken` generates; anything
+// else cannot name a token, so it is rejected before the store is asked.
+export const ApiTokenIdParamSchema = z.object({
+  id: z.string().regex(/^[0-9a-f]{1,64}$/i, 'Invalid token id.'),
+})
