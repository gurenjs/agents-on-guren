+import { PostRevision, type PostRevisionRecord } from './PostRevision.js'
 import type { UserRecord } from './User.js'
 
 export type PostRecord = typeof posts.$inferSelect
 export type NewPostRecord = typeof posts.$inferInsert
 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+export type PostContent = Pick<PostRecord, 'title' | 'excerpt' | 'body'>
 
 export class Post extends defineModel(posts, {
   // `authorId` is set from the signed-in user, never from request input.
   fillable: ['title', 'excerpt', 'body'],
 }) {
-  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    revisions: HasManyRecord<PostRevisionRecord>
+  } = {
     author: null,
+    revisions: [],
+  }
+
+  /**
+   * Overwrites a post's content and keeps what it replaces as a revision, in
+   * one transaction: a failed save keeps nothing, a kept revision is never
+   * missing its save.
+   */
+  static async revise(id: PostRecord['id'], content: PostContent): Promise<void> {
+    await Post.transaction(async (trx) => {
+      // Read inside the transaction, so the revision is the version this save
+      // replaces even when another save landed after the caller loaded the post.
+      const current = await Post.findOrFail(id, 'id', { trx })
+      await PostRevision.forceCreate(
+        { postId: current.id, title: current.title, excerpt: current.excerpt, body: current.body },
+        { trx },
+      )
+      await Post.update(
+        { id: current.id },
+        { title: content.title, excerpt: content.excerpt, body: content.body },
+        { trx },
+      )
+    })
+  }
+
+  /** SQLite enforces `ON DELETE CASCADE` only with foreign keys switched on, so the history is deleted explicitly. */
+  static async deleteWithRevisions(id: PostRecord['id']): Promise<void> {
+    await Post.transaction(async (trx) => {
+      await PostRevision.delete({ postId: id }, { trx })
+      await Post.delete({ id }, { trx })
+    })
   }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
+Post.hasMany('revisions', PostRevision, 'postId', 'id')
