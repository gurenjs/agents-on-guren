+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+// posts.archive lists posts created in a given year (`/posts/archive/2026`)
+// or a given month (`/posts/archive/2026/08`), newest first, as JSON.
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function seedPosts(): Promise<void> {
+    const author = await User.forceCreate({
+      name: 'Author',
+      email: 'author@example.com',
+      passwordHash: 'hashed',
+    })
+
+    for (const [title, createdAt] of [
+      ['August post (early)', '2026-08-05T12:00:00.000Z'],
+      ['August post (late)', '2026-08-20T09:00:00.000Z'],
+      ['July post', '2026-07-15T00:00:00.000Z'],
+    ] as const) {
+      await Post.forceCreate({
+        title,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: author!.id,
+        createdAt,
+      })
+    }
+  }
+
+  it('lists posts created in a zero-padded month, newest first', async () => {
+    await seedPosts()
+
+    await http
+      .get('/posts/archive/2026/08')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'August post (late)')
+      .assertJsonPath('data.1.title', 'August post (early)')
+  })
+
+  it('accepts a month without a leading zero', async () => {
+    await seedPosts()
+
+    await http.get('/posts/archive/2026/8').assertOk().assertJsonCount(2, 'data')
+  })
+
+  it('lists every post created in the given year', async () => {
+    await seedPosts()
+
+    await http.get('/posts/archive/2026').assertOk().assertJsonCount(3, 'data')
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await seedPosts()
+
+    await http.get('/posts/archive/2025').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+  })
+})
