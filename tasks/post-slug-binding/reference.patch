diff --git a/app/Models/Post.ts b/app/Models/Post.ts
index 4c4a643..616ec21 100644
--- a/app/Models/Post.ts
+++ b/app/Models/Post.ts
@@ -8,11 +8,47 @@ export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
 export class Post extends defineModel(posts) {
   // `authorId` is set from the signed-in user, never from request input.
+  // `slug` is derived from the title on create and never changes afterwards.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /**
+   * Route-binding target for `/posts/:slug`. Route model binding resolves a
+   * bound param through `findOrFail(value)`, which looks the model up by
+   * primary key; this target looks it up by slug (author loaded) instead, so
+   * `bind: { slug: Post.bySlug }` + `this.model(Post.bySlug)` give the
+   * controller the post — or a 404 — with no lookup of its own.
+   */
+  static readonly bySlug = {
+    name: 'Post',
+    findOrFail: (slug: unknown) => Post.findWithOrFail(String(slug), 'author', 'slug'),
+  }
+
+  /** `"Hello, World!"` → `hello-world`; falls back to `post` when nothing survives. */
+  static slugify(title: string): string {
+    const slug = title
+      .normalize('NFKD')
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, '-')
+      .replace(/^-+|-+$/g, '')
+    return slug.length > 0 ? slug : 'post'
+  }
+
+  /** The slug for a new post titled `title`: the base slug, or `-2`, `-3`, … when taken. */
+  static async uniqueSlugFor(title: string): Promise<string> {
+    const base = Post.slugify(title)
+    const taken = new Set(
+      (await Post.newQuery().where('slug', 'like', `${base}%`).get()).map((post) => post.slug),
+    )
+    if (!taken.has(base)) return base
+    for (let n = 2; ; n += 1) {
+      const candidate = `${base}-${n}`
+      if (!taken.has(candidate)) return candidate
+    }
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
