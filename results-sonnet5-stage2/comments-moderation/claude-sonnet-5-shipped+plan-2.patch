 export default class PostController extends Controller {
@@ -54,8 +60,22 @@ export default class PostController extends Controller {
     const { id } = this.validateParams(PostIdParamSchema)
     const post = await Post.findWithOrFail(id, 'author')
 
+    const comments = await Comment.with('author', { postId: post.id })
+    const reports = comments.length
+      ? await CommentReport.where({ commentId: comments.map((comment) => comment.id) }).get()
+      : []
+    // Rows are unique per (comment, user), so a row count is a distinct-reporter count.
+    const reportCounts = new Map<number, number>()
+    for (const report of reports) {
+      reportCounts.set(report.commentId, (reportCounts.get(report.commentId) ?? 0) + 1)
+    }
+    const visible = comments
+      .filter((comment) => (reportCounts.get(comment.id) ?? 0) < HIDE_AFTER_REPORTS)
+      .sort((a, b) => a.id - b.id)
+
     return this.inertia(pages.posts.Show, {
       post: new PostResource(post).toJSON(),
+      comments: visible.map((comment) => new CommentResource(comment).toJSON()),
     })
   }
 
diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..183dd33
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,25 @@
+import { Resource, type WithRelations } from '@guren/core'
+import { Comment } from '../../Models/Comment.js'
+
+type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  // ISO string: `created_at` is text on SQLite and a Date on the other dialects.
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      author: { id: comment.author?.id as number, name: comment.author?.name as string },
+      createdAt: new Date(comment.createdAt).toISOString(),
+    }
+  }
+}
