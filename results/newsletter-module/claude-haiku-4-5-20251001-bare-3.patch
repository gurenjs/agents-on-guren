@@ -0,0 +1,19 @@
+import { Router } from '@guren/core'
+import NewsletterController from './Http/Controllers/NewsletterController.js'
+import { SubscribeSchema, UnsubscribeSchema } from './Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (group) => {
+    group.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [
+      NewsletterController,
+      'subscribe',
+    ])
+    group.get('/confirm/:token', { name: 'newsletter.confirm' }, [NewsletterController, 'confirm'])
+    group.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [
+      NewsletterController,
+      'unsubscribe',
+    ])
+  })
+}
+
+export * from './db/schema.js'
