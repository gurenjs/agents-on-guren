diff --git a/app/Support/Covers.ts b/app/Support/Covers.ts
new file mode 100644
index 0000000..a12ca90
--- /dev/null
+++ b/app/Support/Covers.ts
@@ -0,0 +1,89 @@
+import { randomUUID } from 'node:crypto'
+import { mkdir, rm } from 'node:fs/promises'
+import { join, resolve } from 'node:path'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPES = ['image/png', 'image/jpeg'] as const
+
+const STORAGE_DIR = resolve(import.meta.dir, '../../storage/covers')
+const EXTENSIONS: Record<string, string> = { 'image/png': 'png', 'image/jpeg': 'jpg' }
+
+export const coverUrl = (attachment: Pick<AttachmentRecord, 'id'>): string => `/attachments/${attachment.id}`
+
+export function isUpload(value: unknown): value is File {
+  return value instanceof File && (value.size > 0 || value.name !== '')
+}
+
+function sniffType(bytes: Uint8Array): string | null {
+  if (bytes.length >= 8 && [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].every((b, i) => bytes[i] === b)) {
+    return 'image/png'
+  }
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+/** Throws the same 422 as a schema failure when the bytes are not the PNG/JPEG the upload claims to be. */
+export async function readCover(file: File): Promise<{ bytes: Uint8Array; mimeType: string }> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const mimeType = sniffType(bytes)
+  if (!mimeType || mimeType !== file.type || bytes.length > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image of at most 2 MB.' })
+  }
+  return { bytes, mimeType }
+}
+
+export async function storeCover(postId: number, cover: { bytes: Uint8Array; mimeType: string }): Promise<AttachmentRecord> {
+  await mkdir(STORAGE_DIR, { recursive: true })
+  const path = `${randomUUID()}.${EXTENSIONS[cover.mimeType]}`
+  await Bun.write(join(STORAGE_DIR, path), cover.bytes)
+  try {
+    return (await Attachment.forceCreate({
+      postId,
+      path,
+      mimeType: cover.mimeType,
+      size: cover.bytes.length,
+    })) as AttachmentRecord
+  } catch (error) {
+    await rm(join(STORAGE_DIR, path), { force: true })
+    throw error
+  }
+}
+
+export async function deleteCovers(postId: number, except?: number): Promise<void> {
+  const rows = await Attachment.where({ postId }).get()
+  for (const row of rows) {
+    if (row.id === except) continue
+    await Attachment.delete({ id: row.id })
+    await rm(join(STORAGE_DIR, row.path), { force: true })
+  }
+}
+
+export async function coversFor(postIds: number[]): Promise<Map<number, string>> {
+  const map = new Map<number, string>()
+  if (postIds.length === 0) return map
+  for (const row of await Attachment.where({ postId: postIds }).orderBy('id', 'asc').get()) {
+    map.set(row.postId, coverUrl(row))
+  }
+  return map
+}
+
+export async function withCover<T extends { id: number }>(posts: T[]): Promise<Array<T & { coverUrl: string | null }>> {
+  const urls = await coversFor(posts.map((post) => post.id))
+  return posts.map((post) => ({ ...post, coverUrl: urls.get(post.id) ?? null }))
+}
+
+export async function serveCover(id: number): Promise<Response | null> {
+  const row = await Attachment.find(id)
+  if (!row) return null
+  const file = Bun.file(join(STORAGE_DIR, row.path))
+  if (!(await file.exists())) return null
+  return new Response(file, {
+    headers: {
+      'Content-Type': row.mimeType,
+      'Content-Length': String(row.size),
+      'X-Content-Type-Options': 'nosniff',
+    },
+  })
+}
