diff --git a/app/Models/ApiToken.ts b/app/Models/ApiToken.ts
new file mode 100644
index 0000000..b2c9ae6
--- /dev/null
+++ b/app/Models/ApiToken.ts
@@ -0,0 +1,24 @@
+import { defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+export type ApiTokenSummary = Pick<ApiTokenRecord, 'id' | 'name'> & {
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// Rows are written by DatabaseApiTokenStore (see AuthProvider); this model
+// only reads them, so nothing is mass-assignable.
+export class ApiToken extends defineModel(apiTokens, {
+  fillable: [],
+  hidden: ['hashedToken'],
+}) {
+  static summarize(token: ApiTokenRecord): ApiTokenSummary {
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: new Date(token.createdAt).toISOString(),
+      lastUsedAt: token.lastUsedAt ? new Date(token.lastUsedAt).toISOString() : null,
+    }
+  }
+}
