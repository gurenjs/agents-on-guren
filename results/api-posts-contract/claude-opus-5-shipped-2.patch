@@ -0,0 +1,26 @@
+import type { Router } from '@guren/core'
+import PostController from '../app/Http/Controllers/PostController.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// Public JSON API — no auth, no session, no CSRF token. Consumed by partner
+// integrations over plain fetch and by our own front-end through the generated
+// client (`createApiClient<ApiRoutes>()`), which is why every route here is
+// named and declares its contract.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    // `query` states what the endpoint accepts and is enforced before the
+    // controller runs — the same schema the controller reads its values from,
+    // so the route manifest and the 422 can never disagree.
+    // `resource` is the type-level response hint: no runtime cost, it just
+    // tells codegen the envelope carries PostResource rows, so the client's
+    // json() comes back typed.
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+      summary: 'List published posts, newest first, 10 per page.',
+      tags: ['posts'],
+    }, [PostController, 'apiIndex'])
+  })
+}
