+})
+
+export const UnsubscribeEmailSchema = z.object({
+  email: z.string().trim().email('Please enter a valid email address.'),
+})
+
+export const ConfirmTokenSchema = z.object({
+  token: z.string(),
+})
+
+export type SubscribeEmail = z.infer<typeof SubscribeEmailSchema>
+export type UnsubscribeEmail = z.infer<typeof UnsubscribeEmailSchema>
