index 0000000..ae46dad
--- /dev/null
+++ b/tests/Mcp.test.ts
@@ -0,0 +1,102 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// Assistants reach the blog over MCP at /mcp with a bearer credential that
+// belongs to a user; the tools are the `.agent()` routes, so validation and
+// policies are the website's own.
+describe('POST /mcp', () => {
+  let bearer: string
+  let userId: number
+  let rpcId = 0
+  // The test database persists between runs, so each run looks for its own post.
+  const postTitle = `Bun release ${Date.now()}`
+
+  async function rpc(method: string, params: unknown = {}, token: string | null = bearer) {
+    const headers: Record<string, string> = {
+      accept: 'application/json, text/event-stream',
+      'content-type': 'application/json',
+    }
+    if (token) headers.authorization = `Bearer ${token}`
+    return await app.fetch(
+      new Request('http://localhost:3333/mcp', {
+        method: 'POST',
+        headers,
+        body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method, params }),
+      }),
+    )
+  }
+
+  async function call(name: string, args: unknown) {
+    const response = await rpc('tools/call', { name, arguments: args })
+    return JSON.parse(await parseBody(response)).result as {
+      isError?: boolean
+      content: { text: string }[]
+      structuredContent?: Record<string, unknown>
+    }
+  }
+
+  async function parseBody(response: { text(): Promise<string> }): Promise<string> {
+    const text = await response.text()
+    const data = text.split('\n').find((line) => line.startsWith('data:'))
+    return data ? data.slice(5).trim() : text
+  }
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    await migrateDatabase()
+    const user = await User.forceCreate({
+      name: 'Mcp Author',
+      email: `mcp-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    userId = Number(user?.id)
+    const store = app.auth.getApiTokenStore()!
+    bearer = (await createApiToken(store, { name: 'test', userId, abilities: ['tools:*'] })).plainTextToken
+  })
+
+  it('refuses a call without a credential', async () => {
+    const response = await rpc('tools/list', {}, null)
+    expect(response.status).toBe(401)
+  })
+
+  it('lists exactly the two tools with their read-only flags', async () => {
+    const list = JSON.parse(await parseBody(await rpc('tools/list'))).result.tools as {
+      name: string
+      annotations?: { readOnlyHint?: boolean }
+    }[]
+    const tools = list.filter((tool) => !tool.name.startsWith('guren_'))
+    expect(tools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).toBeFalsy()
+  })
+
+  it('creates a post as the credential user and ignores authorId', async () => {
+    const result = await call('posts_store', {
+      title: postTitle,
+      excerpt: 'What is new in Bun',
+      body: 'Body text',
+      authorId: 9999,
+    })
+    expect(result.isError).toBeFalsy()
+    const post = await Post.where({ title: postTitle }).first()
+    expect(Number(post?.authorId)).toBe(userId)
+  })
+
+  it('rejects invalid input with 422 and creates nothing', async () => {
+    const result = await call('posts_store', { title: '', excerpt: 'x', body: 'y' })
+    expect(result.isError).toBe(true)
+    expect(JSON.stringify(result)).toContain('Title is required.')
+    expect(await Post.where({ excerpt: 'x' }).first()).toBeNull()
+  })
+
+  it('searches posts', async () => {
+    const result = await call('posts_search', { keywords: ['Bun'] })
+    expect(result.isError).toBeFalsy()
+    expect(JSON.stringify(result)).toContain('Bun release')
+  })
