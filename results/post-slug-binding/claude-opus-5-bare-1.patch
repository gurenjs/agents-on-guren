+  // `authorId` is set from the signed-in user, never from request input, and
+  // `slug` is derived from the title on create and frozen from then on — a
+  // request must not be able to set or rewrite either.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  /**
+   * The slug `title` should be published at: its slugified form, or that form
+   * with the next free `-N` suffix when another post already holds it
+   * (`hello-world`, then `hello-world-2`, `hello-world-3`, …).
+   *
+   * Call this only when creating a post. Slugs are stable, so renaming a post
+   * deliberately leaves the old address in place.
+   */
+  static async uniqueSlug(title: string): Promise<string> {
+    const base = slugify(title)
+    // Slugs are `[a-z0-9-]` only, so `base` can carry no LIKE wildcard of its
+    // own — every candidate this method can return starts with it.
+    const rows = await Post.newQuery().where('slug', 'like', `${base}%`).select('slug').get()
+    const taken = new Set(rows.map((row) => row.slug))
+
+    if (!taken.has(base)) {
+      return base
+    }
+
+    let suffix = 2
+    while (taken.has(`${base}-${suffix}`)) {
+      suffix += 1
+    }
+
+    return `${base}-${suffix}`
+  }
 }
 
