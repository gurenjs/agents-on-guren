@@ -0,0 +1,26 @@
+import { sql } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+
+export interface HealthCheckResult {
+  status: 'ok' | 'error'
+  message?: string
+}
+
+/**
+ * Runs a trivial round trip against the database so `/health` reflects
+ * whether the connection actually works, not just that the process is up.
+ * Takes a resolver (defaulting to the real `getDatabase`) so tests can
+ * simulate an unreachable database without touching the real connection.
+ */
+export async function checkDatabaseConnection(
+  resolveDatabase: () => Promise<unknown> = getDatabase,
+): Promise<HealthCheckResult> {
+  try {
+    const database = (await resolveDatabase()) as SQLiteBunDatabase
+    await database.run(sql`select 1`)
+    return { status: 'ok' }
+  } catch (error) {
+    return { status: 'error', message: error instanceof Error ? error.message : String(error) }
+  }
+}
