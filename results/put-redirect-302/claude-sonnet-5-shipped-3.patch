@@ -1,6 +1,9 @@
 import { beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,45 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects to the post page with a 303 so the browser follows up with GET', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.put(`/posts/${post.id}`, {
+      title: 'Updated title',
+      excerpt: 'Updated excerpt',
+      body: 'Updated body',
+    })
+
+    response.assertStatus(303)
+    response.assertHeader('Location', `/posts/${post.id}`)
+  })
+
+  it('returns 422 on invalid input without touching the redirect path', async () => {
+    const author = await User.create({ name: 'Author2', email: 'author2@example.com', password: 'password' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' }).assertUnprocessable()
+  })
+})
