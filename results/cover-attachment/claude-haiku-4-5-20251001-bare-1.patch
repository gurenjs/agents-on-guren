diff --git a/app/Services/FileStorageService.ts b/app/Services/FileStorageService.ts
new file mode 100644
index 0000000..b433d17
--- /dev/null
+++ b/app/Services/FileStorageService.ts
@@ -0,0 +1,62 @@
+import { mkdir, unlink } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+const STORAGE_DIR = './storage'
+const STORAGE_RELATIVE_DIR = 'storage'
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024
+
+export class FileStorageService {
+  static async validateFile(
+    file: File,
+  ): Promise<{ valid: boolean; error?: string }> {
+    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
+      return {
+        valid: false,
+        error: 'Cover must be a PNG or JPEG image.',
+      }
+    }
+
+    if (file.size > MAX_FILE_SIZE) {
+      return {
+        valid: false,
+        error: 'Cover must be at most 2 MB.',
+      }
+    }
+
+    return { valid: true }
+  }
+
+  static async storeFile(file: File): Promise<AttachmentRecord> {
+    await mkdir(STORAGE_DIR, { recursive: true })
+
+    const timestamp = Date.now()
+    const ext = file.type === 'image/png' ? 'png' : 'jpg'
+    const storagePath = `${STORAGE_RELATIVE_DIR}/${timestamp}.${ext}`
+    const fullPath = join(STORAGE_DIR, `${timestamp}.${ext}`)
+
+    const buffer = await file.arrayBuffer()
+    await Bun.write(fullPath, new Uint8Array(buffer))
+
+    const attachment = await Attachment.create({
+      filename: file.name,
+      contentType: file.type,
+      path: storagePath,
+    })
+
+    return attachment as AttachmentRecord
+  }
+
+  static async deleteFile(attachment: AttachmentRecord): Promise<void> {
+    const fullPath = join(STORAGE_DIR, attachment.path.replace(`${STORAGE_RELATIVE_DIR}/`, ''))
+
+    try {
+      await unlink(fullPath)
+    } catch (error) {
+      // Ignore if file doesn't exist
+    }
+
+    await Attachment.delete({ id: attachment.id })
+  }
+}
