@@ -0,0 +1,23 @@
+import type { Router } from '@guren/core'
+import PostController from '../app/Http/Controllers/PostController.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// Public, unauthenticated JSON API. Nothing here goes through the 'auth'
+// alias: these routes are read-only and meant for external consumers, so they
+// carry no session and no CSRF token.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    // `query` is the route's contract, not just a hint: the router validates
+    // `?page=`/`?author=` against it and answers 422 before the controller is
+    // reached, while `guren codegen` and `guren audit` read the same schema to
+    // report what the endpoint accepts. `resource` declares the response shape
+    // the controller builds with PostResource, so the generated client's
+    // json() comes back typed — declared, never validated at runtime.
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+    }, [PostController, 'apiIndex'])
+  })
+}
