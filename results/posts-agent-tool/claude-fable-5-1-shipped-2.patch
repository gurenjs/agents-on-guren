+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ToolListing {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolCallResult {
+  isError?: boolean
+  content: Array<{ type: string; text?: string }>
+  structuredContent?: unknown
+}
+
+interface JsonRpcResponse<T> {
+  result?: T
+  error?: { code: number; message: string }
+}
+
+// The streamable-HTTP transport may answer a POST as SSE; the last `data:` line
+// carries the JSON-RPC response either way.
+async function rpc<T>(http: TestApp, method: string, params: Record<string, unknown> = {}): Promise<JsonRpcResponse<T>> {
+  const response = await http
+    .json()
+    .withHeader('Accept', 'application/json, text/event-stream')
+    .post('/mcp', { jsonrpc: '2.0', id: 1, method, params })
+  expect(response.status).toBe(200)
+  const raw = await response.text()
+  const data = raw
+    .split('\n')
+    .filter((line) => line.startsWith('data:'))
+    .map((line) => line.slice(5).trim())
+    .pop()
+  return JSON.parse(data ?? raw) as JsonRpcResponse<T>
+}
+
+async function callTool(http: TestApp, name: string, args: Record<string, unknown>): Promise<ToolCallResult> {
+  const { result, error } = await rpc<ToolCallResult>(http, 'tools/call', { name, arguments: args })
+  expect(error).toBeUndefined()
+  return result as ToolCallResult
+}
+
+function parseJson(result: ToolCallResult): unknown {
+  if (result.structuredContent !== undefined) return result.structuredContent
+  const text = result.content.find((item) => item.type === 'text')?.text ?? ''
+  return JSON.parse(text)
+}
+
+describe('MCP endpoint', () => {
+  let http: TestApp
+  let bearer: TestApp
+  let author: UserRecord
+  const stamp = Date.now()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({
+      name: 'MCP Author',
+      email: `mcp-${stamp}@example.com`,
+      password: 'correct horse battery staple',
+    })) as UserRecord
+
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('the app configures no API token store')
+    const { plainTextToken } = await createApiToken(store, {
+      name: 'assistant',
+      userId: author.id,
+      abilities: ['tools:*'],
+    })
+    bearer = http.withHeader('Authorization', `Bearer ${plainTextToken}`)
+  })
+
+  it('refuses a request without a credential', async () => {
+    await http
+      .json()
+      .withHeader('Accept', 'application/json, text/event-stream')
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+      .assertUnauthorized()
+  })
+
+  it('lists exactly the two post tools with their read-only flags', async () => {
+    const { result } = await rpc<{ tools: ToolListing[] }>(bearer, 'tools/list')
+    const tools = (result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+    const byName = Object.fromEntries(tools.map((tool) => [tool.name, tool]))
+
+    expect(Object.keys(byName).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(byName.posts_search?.annotations?.readOnlyHint).toBe(true)
+    expect(byName.posts_store?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('posts_search answers what QUERY /posts/search answers', async () => {
+    const keyword = `needle-${stamp}`
+    await Post.forceCreate({ title: `Haystack ${keyword}`, excerpt: 'e', body: 'b', authorId: author.id })
+    await Post.forceCreate({ title: 'Unrelated', excerpt: 'nothing here', body: 'b', authorId: author.id })
+
+    const expected = await (await http.query('/posts/search', { keywords: [keyword], limit: 5 })).json()
+    const result = await callTool(bearer, 'posts_search', { keywords: [keyword], limit: 5 })
+
+    expect(result.isError).not.toBe(true)
+    expect(parseJson(result)).toEqual(expected)
+    expect((expected as { data: unknown[] }).data).toHaveLength(1)
+  })
+
+  it('posts_search works without a signed-in user', async () => {
+    const guestToken = http.agent()
+    await guestToken.call('posts_search', { keywords: ['anything'] }).assertOk()
+  })
+
+  it('posts_store creates the post for the credential user, ignoring authorId', async () => {
+    const other = (await User.create({
+      name: 'Someone Else',
+      email: `other-${stamp}@example.com`,
+      password: 'correct horse battery staple',
+    })) as UserRecord
+    const title = `Via MCP ${stamp}`
+
+    const result = await callTool(bearer, 'posts_store', {
+      title,
+      excerpt: 'Drafted by an assistant',
+      body: 'Body text',
+      authorId: other.id,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const created = await Post.first({ title })
+    expect(created?.authorId).toBe(author.id)
+    expect(created?.excerpt).toBe('Drafted by an assistant')
+  })
+
+  it('posts_store rejects input the web form rejects with 422 and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+
+    const result = await callTool(bearer, 'posts_store', { title: '', excerpt: 'x', body: 'y' })
+    expect(result.isError).toBe(true)
+    expect(JSON.stringify(result)).toContain('Title is required')
+
+    // The bridge's `as` signs in through the session, so it needs a CSRF token.
+    const csrf = await http.withCsrf('/posts')
+    await csrf
+      .agent()
+      .call('posts_store', { title: '', excerpt: 'x', body: 'y' }, { as: author })
+      .assertStatus(422)
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('posts_store refuses a guest and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+    const title = `Guest attempt ${stamp}`
+
+    const result = await http.agent().call('posts_store', { title, excerpt: 'x', body: 'y' })
+    expect([301, 302, 303, 401, 403]).toContain(result.status)
+
+    expect(await Post.first({ title })).toBeNull()
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('web form still redirects after creating a post', async () => {
+    const csrf = await http.actingAs(author).withCsrf('/posts')
+    const title = `Via form ${stamp}`
+    await csrf.post('/posts', { title, excerpt: 'x', body: 'y' }).assertRedirect()
+    expect(await Post.first({ title })).not.toBeNull()
+  })
+})
