+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Http/Middleware/ApiTokenMiddleware.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+// Bearer-token API for scripts. Authentication runs before throttling so the
+// limit is keyed by token, and unauthenticated calls never spend a budget.
+// Cookie-less bearer writes are exempt from CSRF by the framework.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    const middlewares = [authenticateApiToken, throttleApiToken]
+
+    api.get('/posts', {
+      name: 'api.posts.index',
+      middlewares,
+      resource: { data: [PostResource] },
+    }, [ApiPostController, 'index'])
+
+    api.post('/posts', {
+      name: 'api.posts.store',
+      middlewares,
+      body: PostPayloadSchema,
+      resource: { data: PostResource },
+    }, [ApiPostController, 'store'])
+  })
+}
