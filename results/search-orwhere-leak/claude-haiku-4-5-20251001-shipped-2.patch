@@ -16,7 +19,128 @@ describe('posts.search', () => {
     http = await TestApp.fromApp(app)
   })
 
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
   it('rejects a search without keywords', async () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  it('filters out unpublished posts', async () => {
+    const user = await User.create({ name: 'Test Author', email: 'test@example.com', password: 'password' })
+
+    await Post.forceCreate({
+      title: 'Published Post with zephyrquill',
+      excerpt: 'Excerpt with zephyrquill',
+      body: 'Body content',
+      authorId: user.id,
+      published: true,
+    })
+
+    await Post.forceCreate({
+      title: 'Unpublished Post with zephyrquill',
+      excerpt: 'Unpublished excerpt',
+      body: 'Unpublished body',
+      authorId: user.id,
+      published: false,
+    })
+
+    const response = await http
+      .json()
+      .query('/posts/search', { keywords: ['zephyrquill'], limit: 10 })
+      .assertOk()
+
+    const data = await response.json<{ data: any[] }>()
+    expect(data.data).toHaveLength(1)
+    expect(data.data[0].title).toContain('Published')
+  })
+
+  it('returns empty results when keyword only exists in unpublished posts', async () => {
+    const user = await User.create({ name: 'Test Author', email: 'test@example.com', password: 'password' })
+
+    await Post.forceCreate({
+      title: 'Unpublished Post with uniqueword',
+      excerpt: 'Unpublished excerpt',
+      body: 'Unpublished body',
+      authorId: user.id,
+      published: false,
+    })
+
+    const response = await http
+      .json()
+      .query('/posts/search', { keywords: ['uniqueword'], limit: 10 })
+      .assertOk()
+
+    const data = await response.json<{ data: any[] }>()
+    expect(data.data).toHaveLength(0)
+  })
+
+  it('finds published posts matching any of multiple keywords', async () => {
+    const user = await User.create({ name: 'Test Author', email: 'test@example.com', password: 'password' })
+
+    await Post.forceCreate({
+      title: 'Published Post with zephyrquill',
+      excerpt: 'Excerpt content',
+      body: 'Body content',
+      authorId: user.id,
+      published: true,
+    })
+
+    await Post.forceCreate({
+      title: 'Published Post with marmalade',
+      excerpt: 'Another excerpt',
+      body: 'Another body',
+      authorId: user.id,
+      published: true,
+    })
+
+    await Post.forceCreate({
+      title: 'Published Post without keywords',
+      excerpt: 'Different content',
+      body: 'Different body',
+      authorId: user.id,
+      published: true,
+    })
+
+    const response = await http
+      .json()
+      .query('/posts/search', { keywords: ['zephyrquill', 'marmalade'], limit: 10 })
+      .assertOk()
+
+    const data = await response.json<{ data: any[] }>()
+    expect(data.data).toHaveLength(2)
+    const titles = data.data.map((p: any) => p.title)
+    expect(titles).toContain('Published Post with zephyrquill')
+    expect(titles).toContain('Published Post with marmalade')
+  })
+
+  it('never includes unpublished posts even with multiple keywords', async () => {
+    const user = await User.create({ name: 'Test Author', email: 'test@example.com', password: 'password' })
+
+    await Post.forceCreate({
+      title: 'Published Post with zephyrquill',
+      excerpt: 'Excerpt content',
+      body: 'Body content',
+      authorId: user.id,
+      published: true,
+    })
+
+    await Post.forceCreate({
+      title: 'Unpublished Post with marmalade',
+      excerpt: 'Unpublished excerpt',
+      body: 'Unpublished body',
+      authorId: user.id,
+      published: false,
+    })
+
+    const response = await http
+      .json()
+      .query('/posts/search', { keywords: ['zephyrquill', 'marmalade'], limit: 10 })
+      .assertOk()
+
+    const data = await response.json<{ data: any[] }>()
+    expect(data.data).toHaveLength(1)
+    expect(data.data[0].title).toContain('Published Post with zephyrquill')
+  })
 })
