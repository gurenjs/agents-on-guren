diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..1eb336f
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,18 @@
+/**
+ * Turns a human title into a URL-safe slug: lowercase ASCII letters and
+ * digits, words joined by a single `-`, no leading or trailing `-`.
+ *
+ * Accents are folded to their ASCII base (`Café` → `cafe`) via NFD
+ * normalisation; anything else that is not `[a-z0-9]` — punctuation, spaces,
+ * CJK, emoji — is a word separator. A title made entirely of such characters
+ * therefore slugifies to an empty string, which callers must handle (see
+ * `Post.generateSlug`).
+ */
+export function slugify(value: string): string {
+  return value
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
