+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('profile API tokens', () => {
+  let http: TestApp
+  let ada: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    ada = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+  })
+
+  async function createToken(user: UserRecord, name: string): Promise<CreatedToken> {
+    const csrf = await http.actingAs(user).json().withCsrf()
+    const response = await csrf.post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<CreatedToken>()
+  }
+
+  it('answers 201 with the plain token, shown once', async () => {
+    const created = await createToken(ada, 'CI')
+
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+    expect((await createToken(ada, 'CI')).token).not.toBe(created.token)
+  })
+
+  it('creates and revokes a token from a session signed in through /login', async () => {
+    const cookies = new Map<string, string>()
+    const remember = (response: { headers: Headers }) => {
+      for (const cookie of response.headers.getSetCookie()) {
+        const [pair = ''] = cookie.split(';')
+        const separator = pair.indexOf('=')
+        cookies.set(pair.slice(0, separator), pair.slice(separator + 1))
+      }
+    }
+    const browser = () =>
+      http.json().withHeaders({
+        Cookie: [...cookies].map(([name, value]) => `${name}=${value}`).join('; '),
+        'X-XSRF-TOKEN': decodeURIComponent(cookies.get('XSRF-TOKEN') ?? ''),
+      })
+
+    remember(await http.get('/login'))
+    const login = await browser().post('/login', { email: 'ada@example.com', password: 'secret-password' })
+    expect(login.status).toBeLessThan(400)
+    remember(login)
+    remember(await browser().get('/profile'))
+
+    const response = await browser().post('/profile/tokens', { name: 'CI' })
+    response.assertCreated()
+    const created = await response.json<CreatedToken>()
+
+    const bearer = http.json().withHeader('Authorization', `Bearer ${created.token}`)
+    const post = await bearer.post('/api/posts', { title: 'Hi', excerpt: 'Short', body: 'Long' })
+    post.assertCreated()
+    expect((await post.json<{ data: { authorId: number } }>()).data.authorId).toBe(ada.id)
+
+    await browser().delete(`/profile/tokens/${created.id}`).assertNoContent()
+    await bearer.get('/api/posts').assertUnauthorized()
+  })
+
+  it('stores a digest, never the plain token or its secret part', async () => {
+    const created = await createToken(ada, 'CI')
+    const secret = created.token.split('|')[1] ?? ''
+
+    const rows = await ApiToken.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.userId).toBe(ada.id)
+    const stored = JSON.stringify(rows)
+    expect(stored).not.toContain(created.token)
+    expect(stored).not.toContain(secret)
+  })
+
+  it('rejects a missing, empty or over-long name and creates nothing', async () => {
+    const csrf = await http.actingAs(ada).json().withCsrf()
+
+    await csrf.post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.post('/profile/tokens', { name: '   ' }).assertUnprocessable()
+    await csrf.post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    await csrf.post('/profile/tokens', { name: 'x'.repeat(50) }).assertCreated()
+
+    expect(await ApiToken.all()).toHaveLength(1)
+  })
+
+  it('gives a guest no token', async () => {
+    const csrf = await http.json().withCsrf()
+
+    const response = await csrf.post('/profile/tokens', { name: 'CI' })
+
+    expect([302, 303, 401]).toContain(response.status)
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('does not accept a bearer token in place of a session', async () => {
+    const created = await createToken(ada, 'CI')
+
+    const response = await http
+      .json()
+      .withHeader('Authorization', `Bearer ${created.token}`)
+      .post('/profile/tokens', { name: 'minted by a token' })
+
+    expect([302, 303, 401]).toContain(response.status)
+    expect(await ApiToken.all()).toHaveLength(1)
+  })
+
+  it('revokes a token with 204, leaving the owner\'s other tokens working', async () => {
+    const revoked = await createToken(ada, 'old laptop')
+    const kept = await createToken(ada, 'CI')
+
+    const csrf = await http.actingAs(ada).json().withCsrf()
+    await csrf.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+
+    await http.json().withHeader('Authorization', `Bearer ${revoked.token}`).get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', `Bearer ${kept.token}`).get('/api/posts').assertOk()
+  })
+
+  it('answers 404 for another user\'s token, which keeps working', async () => {
+    const created = await createToken(bob, 'CI')
+
+    const csrf = await http.actingAs(ada).json().withCsrf()
+    await csrf.delete(`/profile/tokens/${created.id}`).assertNotFound()
+    await csrf.delete('/profile/tokens/unknown').assertNotFound()
+
+    await http.json().withHeader('Authorization', `Bearer ${created.token}`).get('/api/posts').assertOk()
+  })
+
+  it('lists the user\'s own tokens by name on the profile page', async () => {
+    await createToken(ada, 'CI')
+    await createToken(bob, 'old laptop')
+
+    const response = await http.actingAs(ada).get('/profile')
+    response.assertOk()
+    const body = await response.text()
+
+    expect(body).toContain('CI')
+    expect(body).not.toContain('old laptop')
+  })
+})
