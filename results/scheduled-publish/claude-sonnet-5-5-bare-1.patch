+/**
+ * Restricts a posts query to what `viewerId` may see: public posts (no date or
+ * a date that has passed) plus the viewer's own scheduled ones. Evaluated at
+ * query time, so a post goes live with no job running.
+ */
+export function visibleTo<Q extends { where: (cb: (q: any) => void) => Q }>(query: Q, viewerId: number | null): Q {
+  const now = new Date().toISOString()
+  return query.where((q) => {
+    q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+    if (viewerId !== null) q.orWhere('authorId', viewerId)
+  })
+}
+
