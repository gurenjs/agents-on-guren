diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..9ca33fc
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,75 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// The sign-up payload schema is bound to the `register.store` route so the
+// page can derive its field names from the server (see routes/auth.ts). These
+// tests pin the behaviour that binding must not change.
+describe('register.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('renders the sign-up page', async () => {
+    await http
+      .withHeaders({ 'X-Inertia': 'true', 'X-Inertia-Version': '1' })
+      .get('/register')
+      .assertOk()
+      .assertInertia('auth/Register')
+  })
+
+  it('creates the account and redirects to the dashboard', async () => {
+    const csrf = await http.json().withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'analytical-engine',
+        passwordConfirmation: 'analytical-engine',
+      })
+      .assertRedirect('/dashboard')
+
+    const created = await User.first({ email: 'ada@example.com' })
+    expect(created?.name).toBe('Ada Lovelace')
+  })
+
+  it('rejects a mismatched confirmation with errors keyed by field', async () => {
+    const csrf = await http.json().withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'analytical-engine',
+        passwordConfirmation: 'difference-engine',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.passwordConfirmation.0', 'Passwords do not match.')
+
+    expect(await User.first({ email: 'ada@example.com' })).toBeNull()
+  })
+
+  it('rejects a blank name and a badly formatted email', async () => {
+    const csrf = await http.json().withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: '',
+        email: 'not-an-email',
+        password: 'analytical-engine',
+        passwordConfirmation: 'analytical-engine',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.name.0', 'Name is required.')
+      .assertJsonPath('errors.email.0', 'The email address is badly formatted.')
+  })
+})
