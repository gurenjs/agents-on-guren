diff --git a/app/Http/Resources/CommentResource.ts b/app/Http/Resources/CommentResource.ts
new file mode 100644
index 0000000..57ddf26
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,25 @@
+import { Resource, type WithRelations } from '@guren/core'
+import { Comment, type CommentAuthorSummary, type CommentRecord } from '../../Models/Comment.js'
+
+type CommentWithAuthor = WithRelations<typeof Comment, 'author'>
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author: CommentAuthorSummary
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentRecord | CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+    const author = (comment as CommentWithAuthor).author
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      author: { id: author?.id ?? comment.userId, name: author?.name ?? '' },
+      createdAt: new Date(comment.createdAt).toISOString(),
+    }
+  }
+}
