+import { Controller } from '@guren/core'
+import { getDatabase } from '../../../config/database.js'
+import { checkDatabaseHealth, type HealthCheckConnection } from '../Health.js'
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const db = await checkDatabaseHealth(async () => (await getDatabase()) as HealthCheckConnection)
+    const healthy = db.status === 'ok'
+
+    return this.json(
+      { status: healthy ? 'ok' : 'error', checks: { db } },
+      { status: healthy ? 200 : 503 },
+    )
+  }
+}
