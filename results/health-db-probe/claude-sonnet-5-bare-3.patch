new file mode 100644
index 0000000..fdb2f4d
--- /dev/null
+++ b/app/Http/HealthCheck.ts
@@ -0,0 +1,42 @@
+import { sql } from 'drizzle-orm'
+import { getDatabase } from '../../config/database.js'
+
+export type CheckStatus = 'ok' | 'error'
+
+export interface HealthCheckResult {
+  httpStatus: 200 | 503
+  body: {
+    status: 'ok' | 'error'
+    checks: {
+      db: { status: CheckStatus; message?: string }
+    }
+  }
+}
+
+/** A cheap round trip that only succeeds if the database is actually reachable. */
+export async function checkDatabaseConnection(): Promise<void> {
+  const db = (await getDatabase()) as { run(query: unknown): Promise<unknown> }
+  await db.run(sql`select 1`)
+}
+
+/**
+ * Runs the dependency checks backing `GET /health`. Takes the database probe
+ * as a parameter so it can be swapped out in tests without touching the real
+ * connection; production code always calls it with the default.
+ */
+export async function getHealth(checkDatabase: () => Promise<void> = checkDatabaseConnection): Promise<HealthCheckResult> {
+  try {
+    await checkDatabase()
+    return { httpStatus: 200, body: { status: 'ok', checks: { db: { status: 'ok' } } } }
+  } catch (error) {
+    return {
+      httpStatus: 503,
+      body: {
+        status: 'error',
+        checks: {
+          db: { status: 'error', message: error instanceof Error ? error.message : String(error) },
+        },
+      },
+    }
+  }
+}
