diff --git a/tests/TagsIntegration.test.ts b/tests/TagsIntegration.test.ts
new file mode 100644
index 0000000..2f62137
--- /dev/null
+++ b/tests/TagsIntegration.test.ts
@@ -0,0 +1,96 @@
+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Tag } from '../app/Models/Tag.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('Tags Integration', () => {
+  let http: TestApp
+  let user: User
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  it('creates and saves tags with a post', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post('/posts', {
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      tags: 'bun, webdev',
+    }).assertRedirect()
+
+    const post = await Post.first()
+    expect(post).toBeDefined()
+
+    const tags = await Tag.all()
+    expect(tags).toHaveLength(2)
+
+    const postTags = await PostTag.all()
+    expect(postTags).toHaveLength(2)
+  })
+
+  it('updates post tags correctly', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post('/posts', {
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      tags: 'bun, webdev, typescript',
+    })
+
+    const post = await Post.first()
+    const updateCsrf = await http.actingAs(user).withCsrf()
+    await updateCsrf.put(`/posts/${post!.id}`, {
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body updated',
+      tags: 'bun, javascript',
+    })
+
+    const postTags = await PostTag.where({ postId: post!.id }).get()
+    expect(postTags).toHaveLength(2)
+  })
+
+  it('validates tag limits', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post('/posts', {
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      tags: 'a, b, c, d, e, f',
+    }).assertUnprocessable()
+
+    const posts = await Post.all()
+    expect(posts).toHaveLength(0)
+  })
+
+  it('handles duplicate tags correctly', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post('/posts', {
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      tags: 'bun, bun, bun',
+    }).assertRedirect()
+
+    const postTags = await PostTag.all()
+    expect(postTags).toHaveLength(1)
+
+    const tags = await Tag.all()
+    expect(tags).toHaveLength(1)
+  })
+})
