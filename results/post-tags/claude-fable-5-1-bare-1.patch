+  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary>; tags: BelongsToManyRecord<TagRecord> } = {
     author: null,
+    tags: [],
+  }
+
+  /**
+   * Makes `names` the post's exact set of tags: a name never seen becomes a
+   * new tag, each listed name is attached, and an attached name absent from
+   * `names` is detached. The tag rows themselves stay, whether or not a post
+   * still uses them. `names` is expected trimmed and distinct (see
+   * `parseTagNames`).
+   */
+  static async syncTags(postId: number, names: readonly string[]): Promise<void> {
+    const existing = names.length > 0 ? await Tag.whereIn('name', names).get() : []
+    const tagIds = new Map(existing.map((tag) => [tag.name, tag.id]))
+    for (const name of names) {
+      if (!tagIds.has(name)) {
+        const tag = await Tag.create({ name })
+        tagIds.set(name, tag.id)
+      }
+    }
+    const wanted = new Set(names.map((name) => tagIds.get(name) as number))
+
+    const attached = await PostTag.where('postId', postId).get()
+    const current = new Set(attached.map((row) => row.tagId))
+
+    const detach = [...current].filter((tagId) => !wanted.has(tagId))
+    if (detach.length > 0) {
+      await PostTag.newQuery().where('postId', postId).whereIn('tagId', detach).delete()
+    }
+    for (const tagId of wanted) {
+      if (!current.has(tagId)) {
+        await PostTag.create({ postId, tagId })
+      }
+    }
+  }
+
+  /** Ids of the posts carrying the tag named `name`; empty for a name no post uses. */
+  static async idsTagged(name: string): Promise<number[]> {
+    const tag = await Tag.where('name', name).first()
+    if (!tag) {
+      return []
+    }
+    const rows = await PostTag.where('tagId', tag.id).get()
+    return rows.map((row) => row.postId)
   }
 }
 
