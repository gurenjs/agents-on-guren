@@ -0,0 +1,20 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List all scheduled posts'
+
+  async handle(): Promise<void> {
+    const now = new Date()
+    const posts = await Post.where((q) => {
+      q.whereNotNull('publishedAt').where('publishedAt', '>', now.toISOString())
+    })
+      .orderBy('publishedAt', 'asc')
+      .get()
+
+    for (const post of posts) {
+      console.log(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
