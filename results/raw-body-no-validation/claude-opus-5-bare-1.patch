+++ b/tests/ProfileController.test.ts
@@ -0,0 +1,79 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// profile.update validates its body with ProfileUpdateSchema before touching
+// the database, so a bad email or an empty name comes back as a 422 with the
+// field errors resources/js/pages/profile/Edit.tsx renders — and keys that are
+// not part of the form (id, passwordHash, …) are dropped by the schema instead
+// of reaching User.update().
+describe('profile.update', () => {
+  const email = 'profile-controller-test@example.com'
+  const renamedEmail = 'profile-controller-renamed@example.com'
+  let user: UserRecord
+
+  const authed = async () => (await TestApp.fromApp(app)).actingAs(user).withCsrf('/profile')
+
+  // The suite writes to the shared test database, so both addresses it can
+  // leave behind are cleared before and after the run.
+  const removeFixtures = async () => {
+    for (const address of [email, renamedEmail]) {
+      for (const existing of await User.where({ email: address })) {
+        await User.delete({ id: existing.id })
+      }
+    }
+  }
+
+  beforeAll(async () => {
+    // Boots src/app.ts, which is what binds the models to the connection.
+    await TestApp.fromApp(app)
+    await migrateDatabase()
+    await removeFixtures()
+
+    user = await User.create({ name: 'Original Name', email, password: 'secret-password' })
+  })
+
+  afterAll(removeFixtures)
+
+  it('rejects a badly formatted email', async () => {
+    const csrf = await authed()
+    await csrf.put('/profile', { name: 'Original Name', email: 'not-an-email' }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    expect(stored?.email).toBe(user.email)
+  })
+
+  it('rejects an empty name', async () => {
+    const csrf = await authed()
+    await csrf.put('/profile', { name: '   ', email: user.email }).assertStatus(422)
+
+    const stored = await User.find(user.id)
+    expect(stored?.name).toBe('Original Name')
+  })
+
+  it('rejects a password shorter than 8 characters', async () => {
+    const csrf = await authed()
+    await csrf.put('/profile', { name: 'Original Name', email: user.email, password: 'short' }).assertStatus(422)
+  })
+
+  it('ignores fields the profile form does not have', async () => {
+    const csrf = await authed()
+    await csrf
+      .put('/profile', {
+        name: 'Renamed',
+        email: renamedEmail.toUpperCase(),
+        id: user.id + 4321,
+        passwordHash: 'overwritten',
+      })
+      .assertOk()
+
+    const stored = await User.find(user.id)
+    expect(stored?.id).toBe(user.id)
+    expect(stored?.name).toBe('Renamed')
+    // Stored in lowercase, exactly as the registration form stores it.
+    expect(stored?.email).toBe(renamedEmail)
+    expect((stored as unknown as { passwordHash?: string } | null)?.passwordHash).not.toBe('overwritten')
+  })
+})
