     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  describe('with fixtures', () => {
+    beforeEach(async () => {
+      await resetDatabase()
+    })
+
+    it('never returns unpublished posts, and only returns keyword matches', async () => {
+      const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password' })
+      const published = await Post.forceCreate({
+        title: 'The zephyrquill chronicles',
+        excerpt: 'a tale',
+        body: '...',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'Secret zephyrquill draft',
+        excerpt: 'not yet',
+        body: '...',
+        authorId: author.id,
+        published: false,
+      })
+      const unrelated = await Post.forceCreate({
+        title: 'Something else entirely',
+        excerpt: 'no match here',
+        body: '...',
+        authorId: author.id,
+        published: true,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill'] }).assertOk()
+      const body = await res.json<{ data: { id: number }[] }>()
+      const ids = body.data.map((post) => post.id)
+
+      if (!ids.includes(published.id)) throw new Error('expected published match to be returned')
+      if (ids.includes(unrelated.id)) throw new Error('unrelated post leaked into results')
+      if (ids.length !== 1) throw new Error(`expected exactly 1 result, got ${ids.length}`)
+    })
+
+    it('returns nothing when the keyword only exists in an unpublished post', async () => {
+      const author = await User.create({ name: 'Author', email: 'author2@example.com', password: 'password' })
+      await Post.forceCreate({
+        title: 'Marmalade musings',
+        excerpt: 'unpublished only',
+        body: '...',
+        authorId: author.id,
+        published: false,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['marmalade'] }).assertOk()
+      const body = await res.json<{ data: unknown[] }>()
+
+      if (body.data.length !== 0) throw new Error(`expected no results, got ${body.data.length}`)
+    })
+  })
 })
