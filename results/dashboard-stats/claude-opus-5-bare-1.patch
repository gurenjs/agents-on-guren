diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..143656c
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,99 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface DashboardProps {
+  user: { id: number; name: string; email: string } | null
+  postCount: number
+  recentPosts: Array<{ id: number; title: string }>
+}
+
+// Unlike the other starter tests this one needs real rows: the dashboard's
+// counts and recent list are the behaviour under test. Fixtures use emails
+// unique to this file and are removed again in afterAll, so the shared test
+// database is left as it was found.
+const AUTHOR_EMAIL = 'dashboard-author@example.test'
+const STRANGER_EMAIL = 'dashboard-stranger@example.test'
+const EMPTY_EMAIL = 'dashboard-empty@example.test'
+
+async function props(http: TestApp, user: UserRecord): Promise<DashboardProps> {
+  const response = await http.actingAs(user).get('/dashboard').assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as unknown as DashboardProps
+}
+
+async function writePost(author: UserRecord, title: string, createdAt: string) {
+  return Post.forceCreate({
+    title,
+    excerpt: `${title} excerpt`,
+    body: `${title} body`,
+    authorId: author.id,
+    createdAt,
+  })
+}
+
+describe('dashboard', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let loner: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    author = await User.create({ name: 'Dashboard Author', email: AUTHOR_EMAIL, password: 'secret' })
+    stranger = await User.create({ name: 'Dashboard Stranger', email: STRANGER_EMAIL, password: 'secret' })
+    loner = await User.create({ name: 'Dashboard Loner', email: EMPTY_EMAIL, password: 'secret' })
+
+    // Seven posts, oldest first, so the newest five are posts 3..7 reversed.
+    for (let index = 1; index <= 7; index += 1) {
+      await writePost(author, `Author post ${index}`, `2026-01-0${index}T00:00:00.000Z`)
+    }
+    // Newer than everything above, but written by someone else.
+    await writePost(stranger, 'Stranger post', '2026-02-01T00:00:00.000Z')
+  })
+
+  afterAll(async () => {
+    for (const user of [author, stranger, loner]) {
+      if (!user) continue
+      await Post.delete({ authorId: user.id })
+      await User.delete({ id: user.id })
+    }
+  })
+
+  it('redirects guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('counts only the signed-in user\'s posts', async () => {
+    const { postCount } = await props(http, author)
+    expect(postCount).toBe(7)
+  })
+
+  it('lists the five most recent posts, newest first', async () => {
+    const { recentPosts } = await props(http, author)
+    expect(recentPosts.map((post) => post.title)).toEqual([
+      'Author post 7',
+      'Author post 6',
+      'Author post 5',
+      'Author post 4',
+      'Author post 3',
+    ])
+    expect(recentPosts.every((post) => typeof post.id === 'number')).toBe(true)
+  })
+
+  it('never shows another user\'s posts', async () => {
+    const { recentPosts } = await props(http, stranger)
+    expect(recentPosts.map((post) => post.title)).toEqual(['Stranger post'])
+  })
+
+  it('reports an empty state for a user without posts', async () => {
+    const { postCount, recentPosts } = await props(http, loner)
+    expect(postCount).toBe(0)
+    expect(recentPosts).toEqual([])
+  })
+})
