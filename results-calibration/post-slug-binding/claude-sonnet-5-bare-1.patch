diff --git a/app/Support/Slug.ts b/app/Support/Slug.ts
new file mode 100644
index 0000000..62d04b1
--- /dev/null
+++ b/app/Support/Slug.ts
@@ -0,0 +1,14 @@
+/**
+ * Slugify a title: lowercase, ASCII letters/digits only, words joined by a
+ * single `-`, no leading/trailing `-`.
+ *
+ * @example
+ * slugify('Hello, World!') // 'hello-world'
+ * slugify('  Guren  &  Bun: 2026 Edition!  ') // 'guren-bun-2026-edition'
+ */
+export function slugify(title: string): string {
+  return title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
