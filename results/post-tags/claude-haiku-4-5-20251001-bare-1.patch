+const parseAndValidateTags = (input: string | undefined) => {
+  if (!input || input.trim() === '') return []
+
+  const tags = input
+    .split(',')
+    .map((tag) => tag.trim())
+    .filter((tag) => tag.length > 0)
+    .filter((tag, index, arr) => arr.indexOf(tag) === index)
+
+  if (tags.some((tag) => tag.length < 1 || tag.length > 30)) {
+    throw new Error('Each tag name must be 1–30 characters.')
+  }
+
+  if (tags.length > 5) {
+    throw new Error('A post may have at most 5 tags.')
+  }
+
+  return tags
+}
