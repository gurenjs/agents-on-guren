diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..bf7e8f3
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+  })
+
+  const payload = (tags?: string) => ({ title: 'Hello', excerpt: 'Ex', body: 'Body', ...(tags === undefined ? {} : { tags }) })
+
+  async function create(tags?: string) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return csrf.json().post('/posts', payload(tags))
+  }
+
+  it('creates, dedupes and re-syncs tags', async () => {
+    await create(' bun ,bun, webdev,')
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.all()).toHaveLength(2)
+
+    const post = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${post.id}`, payload('bun'))
+    expect(await PostTag.all()).toHaveLength(1)
+
+    const inertia = http.withHeaders({ 'X-Inertia': 'true', 'X-Inertia-Version': '' })
+    const show = await (await inertia.get(`/posts/${post.id}`)).json<any>()
+    expect(show.props.post.tags).toEqual(['bun'])
+    const hit = await (await inertia.get('/posts?tag=bun')).json<any>()
+    expect(hit.props.data.map((p: any) => p.tags)).toEqual([['bun']])
+    const miss = await (await inertia.get('/posts?tag=nope')).json<any>()
+    expect(miss.props.data).toEqual([])
+  })
+
+  it('refuses invalid tags like an empty title', async () => {
+    const bad = await http.actingAs(author).withCsrf()
+    const status = (await bad.json().post('/posts', { ...payload(''), title: '' })).status
+    for (const tags of ['a,b,c,d,e,f', 'x'.repeat(31)]) {
+      expect((await create(tags)).status).toBe(status)
+    }
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    expect((await create('x'.repeat(30))).status).not.toBe(status)
+    expect(await Tag.all()).toHaveLength(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    await create('bun')
+    const post = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`)
+    expect(await Post.all()).toHaveLength(0)
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})
