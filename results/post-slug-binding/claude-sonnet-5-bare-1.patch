-export class Post extends defineModel(posts) {
+// Lowercase ASCII letters/digits only, words joined by a single `-`, no
+// leading/trailing `-`. Everything else (punctuation, whitespace, non-ASCII)
+// is treated as a word boundary rather than transliterated. Exported for the
+// posts seeder, which inserts rows directly through Drizzle and so bypasses
+// the `creating` hook below.
+export function slugify(title: string): string {
+  return title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
+
+export class Post extends defineModel(posts, {
+  // Filled in by the `creating` hook below, so callers never pass it.
+  optionalOnCreate: ['slug'],
+}) {
   // `authorId` is set from the signed-in user, never from request input.
+  // `slug` is derived server-side in the `creating` hook below, so it is
+  // never mass-assignable either.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  static override hooks: ModelHooks = {
+    // Slugs are assigned once, from the title at creation time, and never
+    // touched again on update — a post keeps the address it was created
+    // with even after its title changes.
+    async creating(data) {
+      const base = slugify(String(data.title ?? '')) || 'post'
+      data.slug = await Post.nextAvailableSlug(base)
+    },
+  }
+
+  // `base` itself if free, otherwise the lowest-numbered `base-2`, `base-3`,
+  // … that isn't already taken.
+  static async nextAvailableSlug(base: string): Promise<string> {
+    const conflicts = await Post.newQuery().where('slug', 'like', `${base}%`).get()
+    const taken = new Set(conflicts.map((post) => post.slug))
+
+    if (!taken.has(base)) {
+      return base
+    }
+
+    let suffix = 2
+    while (taken.has(`${base}-${suffix}`)) {
+      suffix += 1
+    }
+    return `${base}-${suffix}`
+  }
 }
 
