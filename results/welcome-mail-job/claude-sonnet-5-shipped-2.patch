@@ -0,0 +1,31 @@
+import { createMailManager, setMailManager, type MailManager } from '@guren/core'
+
+let mailManager: MailManager | null = null
+
+/**
+ * MAIL_MAILER selects the transport: `log` writes messages to the server
+ * output (the dev default), `resend` sends through the Resend API. Setting
+ * the global mail manager is what lets queued sends (Mail.queue() ->
+ * SendMailJob, run on a worker) find it without going through the container.
+ */
+export function configureMail(): MailManager {
+  if (mailManager) {
+    return mailManager
+  }
+
+  mailManager = createMailManager({
+    default: process.env.MAIL_MAILER ?? 'log',
+    from: {
+      email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+      name: process.env.MAIL_FROM_NAME,
+    },
+    transports: {
+      log: { driver: 'log' },
+      resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+    },
+  })
+
+  setMailManager(mailManager)
+
+  return mailManager
+}
