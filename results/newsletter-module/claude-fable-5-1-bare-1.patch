new file mode 100644
index 0000000..c9c7cfc
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/SubscriptionController.ts
@@ -0,0 +1,49 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, NotFoundHttpException, ValidationException } from '@guren/core'
+import { Subscription } from '../../Models/Subscription.js'
+import { SubscriptionTokenParamSchema } from '../Validators/SubscriptionValidator.js'
+
+export default class SubscriptionController extends Controller {
+  // Stores a pending subscription. Sending the confirmation email is a
+  // separate ticket; for now only the token is issued and stored.
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await Subscription.first({ email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from
+    // Subscription.fillable: it is issued here, never accepted from input.
+    await Subscription.forceCreate({ email, token: randomBytes(32).toString('hex') })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(SubscriptionTokenParamSchema)
+    const subscription = await Subscription.first({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException('Subscription not found.')
+    }
+
+    if (subscription.confirmedAt === null) {
+      await Subscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+    await Subscription.delete({ email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  // The page the visitor submitted from, the same way the framework's own
+  // validation redirect resolves it.
+  private backUrl(): string {
+    return this.request.header('referer') ?? '/'
+  }
+}
diff --git a/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
new file mode 100644
index 0000000..e971b45
--- /dev/null
+++ b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
@@ -0,0 +1,20 @@
+import { z } from 'zod'
+
+// Shared by subscribe and unsubscribe: both take a single email address.
+// Lower-cased so the unique index treats `Ada@Example.com` and
+// `ada@example.com` as the same subscriber.
+export const SubscriptionEmailSchema = z.object({
+  email: z
+    .string({ error: 'Email is required.' })
+    .trim()
+    .toLowerCase()
+    .min(1, 'Email is required.')
+    .max(255, 'Email must be 255 characters or fewer.')
+    .pipe(z.email('Enter a valid email address.')),
+})
+
+export type SubscriptionEmailPayload = z.infer<typeof SubscriptionEmailSchema>
+
+export const SubscriptionTokenParamSchema = z.object({
+  token: z.string().min(1),
+})
