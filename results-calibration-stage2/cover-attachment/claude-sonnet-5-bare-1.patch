@@ -16,10 +16,41 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPES = ['image/png', 'image/jpeg'] as const
+
+// An empty file input submits an empty, unnamed file (or an empty string):
+// that is "no file picked", not an invalid cover. Use `pickCover` to read it.
+const CoverSchema = z.custom<File | undefined>(
+  (value) =>
+    value === undefined ||
+    value === '' ||
+    (value instanceof File &&
+      (value.size === 0 ||
+        ((COVER_TYPES as readonly string[]).includes(value.type) && value.size <= COVER_MAX_BYTES))),
+  { message: `Cover must be a PNG or JPEG image of ${COVER_MAX_BYTES / 1024 / 1024} MB or less.` },
+)
+
+/** The uploaded cover, or undefined when no file was picked. */
+export function pickCover(cover: unknown): File | undefined {
+  return cover instanceof File && cover.size > 0 ? cover : undefined
+}
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  cover: CoverSchema.optional(),
+  // A ticked checkbox arrives as "1" (or "true"); only meaningful on edit.
+  removeCover: z.union([z.string(), z.boolean()]).optional(),
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+/** Whether the bytes start with the PNG or JPEG signature, whatever type the client claimed. */
+export async function hasImageSignature(file: File): Promise<boolean> {
+  const head = new Uint8Array(await file.slice(0, 8).arrayBuffer())
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].every((byte, i) => head[i] === byte)
+  const jpeg = head[0] === 0xff && head[1] === 0xd8 && head[2] === 0xff
+  return png || jpeg
+}
