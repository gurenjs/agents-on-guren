@@ -0,0 +1,375 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Comment, REPORTS_TO_HIDE } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface CommentProp {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let bystander: UserRecord
+  let postId: number
+
+  function createUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name.toLowerCase()}@example.com`, password: 'secret-password' })
+  }
+
+  // Under fromApp() every mutating request needs the CSRF cookies primed, or
+  // it answers 403 before the route is reached.
+  function as(user: UserRecord): Promise<TestApp> {
+    return http.actingAs(user).withCsrf()
+  }
+
+  async function createComment(author: UserRecord, body = 'Nice post.', onPost = postId): Promise<number> {
+    const comment = await Comment.forceCreate({ body, postId: onPost, userId: author.id })
+    return comment.id
+  }
+
+  async function shownComments(viewer?: UserRecord): Promise<CommentProp[]> {
+    const client = (viewer ? http.actingAs(viewer) : http).withHeader('X-Inertia', 'true')
+    const response = await client.get(`/posts/${postId}`).assertOk().assertInertia('posts/Show')
+    const page = await response.json<{ props: { comments: CommentProp[] } }>()
+    return page.props.comments
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    postAuthor = await createUser('Ada')
+    commenter = await createUser('Grace')
+    bystander = await createUser('Linus')
+    const post = await Post.forceCreate({ title: 'Hello', excerpt: 'First', body: 'Post body', authorId: postAuthor.id })
+    postId = post.id
+  })
+
+  describe('POST /posts/:id/comments', () => {
+    it('sends a guest to the login page and stores nothing', async () => {
+      const guest = await http.withCsrf()
+
+      await guest.post(`/posts/${postId}/comments`, { body: 'Hi' }).assertRedirect('/login')
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it("stores a signed-in user's comment and redirects to the post", async () => {
+      const client = await as(commenter)
+
+      await client.post(`/posts/${postId}/comments`, { body: 'Nice post.' }).assertRedirect(`/posts/${postId}`)
+
+      const stored = await Comment.all()
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ postId, userId: commenter.id, body: 'Nice post.' })
+    })
+
+    it('lets the author of a post comment on it', async () => {
+      const client = await as(postAuthor)
+
+      await client.post(`/posts/${postId}/comments`, { body: 'Thanks for reading.' }).assertRedirect(`/posts/${postId}`)
+
+      expect(await Comment.all()).toHaveLength(1)
+    })
+
+    it('takes the author from the session, not from the request', async () => {
+      const client = await as(commenter)
+
+      await client.post(`/posts/${postId}/comments`, { body: 'Mine', userId: postAuthor.id, postId: 999 })
+
+      const stored = await Comment.all()
+      expect(stored[0]).toMatchObject({ postId, userId: commenter.id })
+    })
+
+    it('accepts a body of 2000 characters', async () => {
+      const client = await as(commenter)
+
+      await client.post(`/posts/${postId}/comments`, { body: 'a'.repeat(2000) }).assertRedirect(`/posts/${postId}`)
+
+      expect(await Comment.all()).toHaveLength(1)
+    })
+
+    it.each([
+      ['empty', ''],
+      ['blank', '   '],
+      ['longer than 2000 characters', 'a'.repeat(2001)],
+    ])('rejects a body that is %s, the way an invalid post title is rejected', async (_label, body) => {
+      const client = await as(commenter)
+
+      const invalidPost = await client.post('/posts', { title: '', excerpt: 'Excerpt', body: 'Body' })
+      const invalidComment = await client.post(`/posts/${postId}/comments`, { body })
+
+      expect(invalidComment.status).toBe(invalidPost.status)
+      expect(invalidComment.headers.get('location')).toBe(invalidPost.headers.get('location'))
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('answers 422 with the field error to a JSON client', async () => {
+      const client = await as(commenter)
+
+      await client
+        .json()
+        .post(`/posts/${postId}/comments`, { body: '' })
+        .assertUnprocessable()
+        .assertJsonPath('errors.body.0', 'Comment is required.')
+    })
+
+    it('answers 404 for a post that does not exist', async () => {
+      const client = await as(commenter)
+
+      await client.post('/posts/999/comments', { body: 'Hi' }).assertNotFound()
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+  })
+
+  describe('DELETE /comments/:id', () => {
+    it('sends a guest to the login page and keeps the comment', async () => {
+      const commentId = await createComment(commenter)
+      const guest = await http.withCsrf()
+
+      await guest.delete(`/comments/${commentId}`).assertRedirect('/login')
+
+      expect(await Comment.find(commentId)).not.toBeNull()
+    })
+
+    it('lets the author of the comment delete it', async () => {
+      const commentId = await createComment(commenter)
+      const client = await as(commenter)
+
+      await client.delete(`/comments/${commentId}`).assertRedirect(`/posts/${postId}`)
+
+      expect(await Comment.find(commentId)).toBeNull()
+    })
+
+    it('lets the author of the post delete it', async () => {
+      const commentId = await createComment(commenter)
+      const client = await as(postAuthor)
+
+      await client.delete(`/comments/${commentId}`).assertRedirect(`/posts/${postId}`)
+
+      expect(await Comment.find(commentId)).toBeNull()
+    })
+
+    it('answers 403 to anyone else and keeps the comment', async () => {
+      const commentId = await createComment(commenter)
+      const client = await as(bystander)
+
+      await client.delete(`/comments/${commentId}`).assertForbidden()
+
+      expect(await Comment.find(commentId)).not.toBeNull()
+    })
+
+    it('does not let the author of another post delete it', async () => {
+      const otherPost = await Post.forceCreate({ title: 'Other', excerpt: 'Other', body: 'Other', authorId: bystander.id })
+      const commentId = await createComment(commenter)
+      const client = await as(bystander)
+
+      await client.delete(`/comments/${commentId}`).assertForbidden()
+
+      expect(await Comment.find(commentId)).not.toBeNull()
+      expect(await Post.find(otherPost.id)).not.toBeNull()
