@@ -0,0 +1,50 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body unchanged when it is 140 characters or fewer', () => {
+    const body = 'A short post body.'
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('returns the whole trimmed body when it is exactly 140 characters', () => {
+    const body = 'x'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('trims leading and trailing whitespace before measuring the body', () => {
+    expect(deriveExcerpt('  Hello world.  ')).toBe('Hello world.')
+  })
+
+  it('cuts back to the last whitespace when character 141 falls inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ' +
+      'The quick brown fox jumps over the lazy dog. The quick brown'
+
+    expect(body.length).toBe(150)
+    expect(deriveExcerpt(body)).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+  })
+
+  it('keeps all 140 characters when character 141 is whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening ' +
+      'of the body intact and stopping right at a space, then adds a mark.'
+
+    expect(body.length).toBe(170)
+    expect(deriveExcerpt(body)).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+  })
+
+  it('cuts at exactly 140 characters when the opening has no whitespace at all', () => {
+    const body = 'x'.repeat(200)
+    const result = deriveExcerpt(body)
+    expect(result).toBe(`${'x'.repeat(140)}…`)
+  })
+
+  it('returns a non-empty excerpt for a body with real content', () => {
+    expect(deriveExcerpt('hello')).not.toBe('')
+  })
+})
