--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,23 @@
+import { ServiceProvider } from '@guren/core'
+import { SyncDriver, setQueueDriver, registerJob } from '@guren/server/queue'
+import { queueConfig } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    const driver = this.resolveDriver(queueConfig.connection)
+    setQueueDriver(driver)
+    this.registerJobs()
+  }
+
+  private registerJobs(): void {
+    registerJob(SendWelcomeEmailJob)
+  }
+
+  private resolveDriver(connection: string) {
+    if (connection === 'sync') {
+      return new SyncDriver()
+    }
+    throw new Error(`Unknown queue connection: ${connection}`)
+  }
+}
