diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..623a3f3
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,83 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import {
+  MemoryDriver,
+  MemoryTransport,
+  createMailManager,
+  processJob,
+  setMailManager,
+  setQueueDriver,
+} from '@guren/core'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('registration', () => {
+  let http: TestApp
+  let queueDriver: MemoryDriver
+  let mailTransport: MemoryTransport
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    // Point the queue at a holding driver (records dispatches without
+    // running them) and the mailer at a transport that records what's sent,
+    // instead of the sync/log drivers the app boots with for development.
+    queueDriver = new MemoryDriver()
+    setQueueDriver(queueDriver)
+
+    const mailManager = createMailManager({
+      default: 'memory',
+      from: { email: 'hello@example.com', name: 'Guren' },
+      transports: { memory: { driver: 'memory' } },
+    })
+    mailTransport = mailManager.transport('memory') as MemoryTransport
+    setMailManager(mailManager)
+  })
+
+  it('queues a welcome email without sending it, then delivers it once the job runs', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    expect(await queueDriver.size('default')).toBe(1)
+    expect(mailTransport.getMessages()).toHaveLength(0)
+
+    const processed = await processJob(queueDriver, 'default')
+    expect(processed).toBe(true)
+
+    const messages = mailTransport.getMessages()
+    expect(messages).toHaveLength(1)
+    const [message] = messages
+    expect(message.to).toEqual([{ email: 'ada@example.com' }])
+    expect(message.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(message.from?.email).toBe('hello@example.com')
+    expect(message.text).toContain('Ada Lovelace')
+  })
+
+  it('queues nothing and sends nothing when registration is refused', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf
+      .post('/register', {
+        name: 'Grace Hopper',
+        email: 'not-an-email',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertUnprocessable()
+
+    expect(await queueDriver.size('default')).toBe(0)
+    expect(mailTransport.getMessages()).toHaveLength(0)
+  })
+})
