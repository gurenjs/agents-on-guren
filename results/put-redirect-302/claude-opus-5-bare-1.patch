@@ -0,0 +1,53 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// A browser replays the original method on a 302, so a PUT answered with 302
+// is re-sent as a PUT to /posts/:id — which redirects again, and the save
+// never leaves the edit form. 303 See Other tells the browser (and Inertia)
+// to follow up with a GET on the post page instead.
+describe('posts.update', () => {
+  let author: TestApp
+  let postId: number
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    const http = await TestApp.fromApp(app)
+
+    const user = await User.create({
+      name: 'Redirect Author',
+      email: `redirect-${Date.now()}@example.com`,
+      password: 'secret',
+    })
+    const post = await Post.forceCreate({
+      title: 'Before the edit',
+      excerpt: 'Original excerpt.',
+      body: 'Original body.',
+      authorId: user!.id,
+    })
+
+    postId = post!.id
+    author = await http.actingAs(user).withCsrf(`/posts/${postId}/edit`)
+  })
+
+  it('sends the browser on to the post page after a successful save', async () => {
+    await author
+      .put(`/posts/${postId}`, {
+        title: 'After the edit',
+        excerpt: 'Updated excerpt.',
+        body: 'Updated body.',
+      })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${postId}`)
+
+    const updated = await Post.findOrFail(postId)
+    expect(updated.title).toBe('After the edit')
+  })
+
+  it('keeps answering an invalid edit with a validation error', async () => {
+    await author.put(`/posts/${postId}`, { title: '', excerpt: '', body: '' }).assertStatus(422)
+  })
+})
