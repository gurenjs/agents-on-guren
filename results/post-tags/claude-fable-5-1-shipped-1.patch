diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..2f7dbcc
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,158 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+interface InertiaPage<TProps> {
+  component: string
+  props: TProps
+}
+
+const PAYLOAD = { title: 'Tagged', excerpt: 'An excerpt', body: 'Some body' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret' })
+  })
+
+  async function authed(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function page<TProps>(path: string): Promise<InertiaPage<TProps>> {
+    const res = await http.withHeader('X-Inertia', 'true').get(path)
+    res.assertOk()
+    return res.json<InertiaPage<TProps>>()
+  }
+
+  async function createPost(tags: unknown): Promise<number> {
+    const csrf = await authed()
+    await csrf.post('/posts', { ...PAYLOAD, tags }).assertRedirect()
+    const post = await Post.newQuery().orderBy('id', 'desc').firstOrFail()
+    return post.id
+  }
+
+  it('stores, attaches and shows tags on create', async () => {
+    const id = await createPost('bun, webdev')
+
+    const names = (await Tag.all()).map((tag) => tag.name).sort()
+    expect(names).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(2)
+
+    const show = await page<{ post: { tags: string[] } }>(`/posts/${id}`)
+    expect(show.component).toBe('posts/Show')
+    expect(show.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('detaches tags removed on edit and keeps the rest', async () => {
+    const id = await createPost('bun, webdev')
+    const csrf = await authed()
+    await csrf.put(`/posts/${id}`, { ...PAYLOAD, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+
+    const links = await PostTag.where({ postId: id }).get()
+    const bun = await Tag.first({ name: 'bun' })
+    expect(links.map((link) => link.tagId)).toEqual([bun!.id])
+
+    const show = await page<{ post: { tags: string[] } }>(`/posts/${id}`)
+    expect(show.props.post.tags).toEqual(['bun'])
+
+    const edit = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${id}/edit`)
+    edit.assertOk()
+    const editPage = await edit.json<InertiaPage<{ post: { tags: string[] } }>>()
+    expect(editPage.props.post.tags).toEqual(['bun'])
+  })
+
+  it('clears tags when the field is left out', async () => {
+    const id = await createPost('bun')
+    const csrf = await authed()
+    await csrf.put(`/posts/${id}`, PAYLOAD).assertRedirect()
+
+    expect(await PostTag.where({ postId: id }).count()).toBe(0)
+    expect(await Tag.first({ name: 'bun' })).not.toBeNull()
+  })
+
+  it('filters the list by tag and carries tags on every post', async () => {
+    const tagged = await createPost('bun')
+    const plain = await createPost(undefined)
+
+    type IndexProps = { data: Array<{ id: number; tags: string[] }>; pagination: { links: { pages: Array<{ url: string | null }> } } }
+    const filtered = await page<IndexProps>('/posts?tag=bun')
+    expect(filtered.component).toBe('posts/Index')
+    expect(filtered.props.data.map((post) => post.id)).toEqual([tagged])
+    expect(filtered.props.pagination.links.pages[0]?.url).toContain('tag=bun')
+
+    const unused = await page<IndexProps>('/posts?tag=nobody')
+    expect(unused.props.data).toEqual([])
+
+    const all = await page<IndexProps>('/posts')
+    expect(all.props.data.map((post) => [post.id, post.tags])).toEqual([
+      [plain, []],
+      [tagged, ['bun']],
+    ])
+  })
+
+  it('refuses six tags the way an empty title is refused, writing nothing', async () => {
+    const csrf = await authed()
+    const emptyTitle = await csrf.post('/posts', { ...PAYLOAD, title: '' })
+
+    const res = await csrf.post('/posts', { ...PAYLOAD, tags: 'a, b, c, d, e, f' })
+    expect(res.status).toBe(emptyTitle.status)
+
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+
+  it('reports tag errors on the tags field', async () => {
+    const csrf = (await authed()).json()
+    await csrf
+      .post('/posts', { ...PAYLOAD, tags: 'x'.repeat(31) })
+      .assertUnprocessable()
+      .assertJsonStructure(['errors'])
+    const res = await csrf.post('/posts', { ...PAYLOAD, tags: 'x'.repeat(31) })
+    const body = await res.json<{ errors: Record<string, unknown> }>()
+    expect(Object.keys(body.errors)).toEqual(['tags'])
+  })
+
+  it('accepts a 30-character name and refuses a 31-character one', async () => {
+    const csrf = await authed()
+    const emptyTitle = await csrf.post('/posts', { ...PAYLOAD, title: '' })
+
+    const tooLong = await csrf.post('/posts', { ...PAYLOAD, tags: 'x'.repeat(31) })
+    expect(tooLong.status).toBe(emptyTitle.status)
+    expect(await Post.newQuery().count()).toBe(0)
+
+    const id = await createPost('y'.repeat(30))
+    const show = await page<{ post: { tags: string[] } }>(`/posts/${id}`)
+    expect(show.props.post.tags).toEqual(['y'.repeat(30)])
+  })
+
+  it('trims, drops empties and dedupes names', async () => {
+    const id = await createPost(' bun ,bun,, ')
+
+    const names = (await Tag.all()).map((tag) => tag.name)
+    expect(names).toEqual(['bun'])
+    expect(await PostTag.where({ postId: id }).count()).toBe(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun, webdev')
+    const csrf = await authed()
+    await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.where({ postId: id }).count()).toBe(0)
+  })
+})
