@@ -0,0 +1,61 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('login', () => {
+  let http: TestApp
+  const credentials = { email: 'redirect-test@example.com', password: 'correct-horse' }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await User.create({ name: 'Redirect Test', email: credentials.email, password: credentials.password })
+  })
+
+  it('sends the user to the requested in-app path after a correct password', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('falls back to the default destination when redirect is an absolute URL to another origin', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('falls back to the default destination when redirect is protocol-relative', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: '//evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('falls back to the default destination when redirect is a backslash variant', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { ...credentials, redirect: '/\\evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('falls back to the default destination when no redirect is given', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/login', credentials).assertRedirect('/dashboard')
+  })
+
+  it('rejects a wrong password without creating a session', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .post('/login', { email: credentials.email, password: 'wrong-password' })
+      .assertUnprocessable()
+  })
+})
