+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { ScryptHasher } from '@guren/core'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('Post excerpt derivation', () => {
+  let http: TestApp
+  let user: typeof User.$inferSelect
+  let testCounter = 0
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+  })
+
+  beforeEach(async () => {
+    // Create a test user with unique email
+    testCounter++
+    const uniqueEmail = `test-${testCounter}@example.com`
+    user = await User.create({
+      name: 'Test User',
+      email: uniqueEmail,
+      password: 'password',
+    })
+  })
+
+  it('derives excerpt from short body (≤140 chars)', async () => {
+    const shortBody = 'The quick brown fox jumps over the lazy dog.'
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Post',
+      excerpt: '',
+      body: shortBody,
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    expect(post?.excerpt).toBe(shortBody)
+  })
+
+  it('derives excerpt from long body (>140 chars) with ellipsis', async () => {
+    const longBody = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Post Long',
+      excerpt: '',
+      body: longBody,
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    expect(post?.excerpt).toBe('The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…')
+  })
+
+  it('does not cut words when deriving excerpt', async () => {
+    const body = 'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Word Boundary',
+      excerpt: '',
+      body: body,
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    // Character 141 should be a space after 'right', so keep all 140 chars
+    expect(post?.excerpt).toBe('When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…')
+  })
+
+  it('uses provided excerpt over derived one', async () => {
+    const longBody = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const customExcerpt = 'Custom excerpt'
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Custom Excerpt',
+      excerpt: customExcerpt,
+      body: longBody,
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    expect(post?.excerpt).toBe(customExcerpt)
+  })
+
+  it('trims whitespace-only excerpt and derives instead', async () => {
+    const body = 'Some interesting content about something.'
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Whitespace Excerpt',
+      excerpt: '   ',
+      body: body,
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    expect(post?.excerpt).toBe(body)
+  })
+
+  it('derives excerpt on post update with empty excerpt', async () => {
+    // First create a post with an excerpt
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Update Test',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+    }).assertRedirect()
+
+    const post = await Post.newQuery().orderBy('id', 'desc').first()
+    expect(post?.excerpt).toBe('Original excerpt')
+
+    // Now update with empty excerpt and new body
+    const newBody = 'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const csrf2 = await http.actingAs(user).withCsrf()
+
+    await csrf2.put(`/posts/${post!.id}`, {
+      title: 'Update Test',
+      excerpt: '',
+      body: newBody,
+    }).assertRedirect()
+
+    const updated = await Post.find(post!.id)
+    expect(updated?.excerpt).toBe('The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…')
+  })
+
+  it('rejects post with empty title', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: '',
+      excerpt: '',
+      body: 'Some body',
+    }).assertUnprocessable()
+  })
+
+  it('rejects post with empty body', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Title',
+      excerpt: '',
+      body: '',
+    }).assertUnprocessable()
+  })
+
+  it('handles excerpt with max length validation', async () => {
+    const longExcerpt = 'x'.repeat(501)
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', {
+      title: 'Test Max Length',
+      excerpt: longExcerpt,
+      body: 'Body',
+    }).assertUnprocessable()
+  })
+})
