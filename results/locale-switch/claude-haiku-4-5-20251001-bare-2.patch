@@ -0,0 +1,9 @@
+import { z } from 'zod'
+
+export const LocaleSchema = z.object({
+  locale: z
+    .string()
+    .refine((v) => ['en', 'ja'].includes(v), { message: 'Invalid locale.' }),
+})
+
+export type LocaleInput = z.infer<typeof LocaleSchema>
