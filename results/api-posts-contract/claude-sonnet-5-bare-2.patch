+  // Serves the public JSON feed `api.posts.index` — no auth, newest first,
+  // 10 per page, optionally narrowed to one author. `page`/`author` are
+  // validated twice on purpose: the route's `query:` contract rejects a bad
+  // request with 422 before this method runs (and feeds codegen), while
+  // `validateQuery` here gets the parsed, typed values — the same split
+  // `posts.search` uses for its `body:` contract.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsQuerySchema)
+
+    const query = Post.newQuery().with('author').orderBy('id', 'desc')
+    if (author !== undefined) {
+      query.where('authorId', author)
+    }
+
+    const result = await query.paginate({ page, perPage: 10 })
+    const paginator = paginate(result)
+
+    return this.json({
+      data: PostResource.collection(result.data),
+      meta: paginator.meta(),
+    })
+  }
+
