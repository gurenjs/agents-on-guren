@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,50 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.destroy touches the database (creating the author, a second user,
+// and the post under test), so it gets its own suite with resetDatabase()
+// between tests, rather than reusing the DB-free posts.search suite above.
+describe('posts.destroy', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it("forbids a signed-in user from deleting another author's post", async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    const other = await User.create({ name: 'Other', email: 'other@example.com', password: 'password123' })
+    const post = await Post.forceCreate({ title: 'Mine', excerpt: 'excerpt', body: 'body', authorId: author.id })
+
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertForbidden()
+
+    await Post.findOrFail(post.id)
+  })
+
+  it('rejects an unauthenticated delete', async () => {
+    const author = await User.create({ name: 'Author', email: 'author2@example.com', password: 'password123' })
+    const post = await Post.forceCreate({ title: 'Mine', excerpt: 'excerpt', body: 'body', authorId: author.id })
+
+    const csrf = await http.withCsrf()
+    const status = (await csrf.delete(`/posts/${post.id}`)).status
+    if (status !== 401 && status !== 403 && status !== 302) {
+      throw new Error(`expected an unauthenticated delete to be refused, got ${status}`)
+    }
+
+    await Post.findOrFail(post.id)
+  })
+
+  it('lets the author delete their own post', async () => {
+    const author = await User.create({ name: 'Author', email: 'author3@example.com', password: 'password123' })
+    const post = await Post.forceCreate({ title: 'Mine', excerpt: 'excerpt', body: 'body', authorId: author.id })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+})
