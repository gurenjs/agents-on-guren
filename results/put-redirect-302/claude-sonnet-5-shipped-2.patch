+++ b/tests/PostController.update.test.ts
@@ -0,0 +1,49 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects to the post page after a successful save, not back to the form', async () => {
+    const author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'Updated title', excerpt: 'Original excerpt', body: 'Original body' })
+      .assertRedirect(`/posts/${post.id}`)
+      .assertStatus(303)
+  })
+
+  it('still returns 422 with field errors on invalid input', async () => {
+    const author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, { title: '', excerpt: 'Original excerpt', body: 'Original body' })
+      .assertUnprocessable()
+  })
+})
