@@ -19,4 +22,96 @@ describe('posts.search', () => {
   it('rejects a search without keywords', async () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  describe('with data', () => {
+    beforeEach(async () => {
+      await resetDatabase()
+    })
+
+    it('never returns unpublished posts, and only returns keyword matches', async () => {
+      const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+
+      const publishedMatch = await Post.forceCreate({
+        title: 'zephyrquill notes',
+        excerpt: 'about zephyrquill',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'zephyrquill secrets',
+        excerpt: 'unpublished zephyrquill draft',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+      const publishedNonMatch = await Post.forceCreate({
+        title: 'unrelated post',
+        excerpt: 'no keyword here',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill'] })
+      res.assertOk()
+      const body = await res.json<{ data: { id: number }[] }>()
+      const ids = body.data.map((p) => p.id)
+
+      if (ids.length !== 1 || ids[0] !== publishedMatch.id) {
+        throw new Error(`expected only published matching post, got ${JSON.stringify(ids)}`)
+      }
+      if (ids.includes(publishedNonMatch.id)) {
+        throw new Error('search returned a post that does not contain the keyword')
+      }
+    })
+
+    it('returns an empty result when a keyword only matches unpublished posts', async () => {
+      const author = await User.create({ name: 'Author2', email: 'author2@example.com', password: 'password123' })
+      await Post.forceCreate({
+        title: 'marmalade only in draft',
+        excerpt: 'still draft',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+
+      await http.query('/posts/search', { keywords: ['marmalade'] }).assertJson({ data: [] })
+    })
+
+    it('matches posts on any of several keywords, published only', async () => {
+      const author = await User.create({ name: 'Author3', email: 'author3@example.com', password: 'password123' })
+      const matchesFirst = await Post.forceCreate({
+        title: 'zephyrquill title',
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      const matchesSecond = await Post.forceCreate({
+        title: 'title',
+        excerpt: 'has marmalade in it',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'zephyrquill unpublished',
+        excerpt: 'marmalade too',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill', 'marmalade'] })
+      res.assertOk()
+      const body = await res.json<{ data: { id: number }[] }>()
+      const ids = body.data.map((p) => p.id).sort()
+
+      const expected = [matchesFirst.id, matchesSecond.id].sort()
+      if (JSON.stringify(ids) !== JSON.stringify(expected)) {
+        throw new Error(`expected ${JSON.stringify(expected)}, got ${JSON.stringify(ids)}`)
+      }
+    })
+  })
 })
