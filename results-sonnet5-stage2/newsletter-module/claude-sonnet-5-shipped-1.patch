@@ -0,0 +1,41 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { NewsletterSubscription } from '../modules/newsletter/index.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('subscribes, rejects duplicates and bad emails', async () => {
+    const csrf = (await http.withCsrf()).json().withHeader('Referer', 'http://localhost/posts')
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect('/posts')
+    const row = await NewsletterSubscription.first({ email: 'a@example.com' })
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    expect((await NewsletterSubscription.all()).length).toBe(1)
+  })
+
+  it('confirms and unsubscribes', async () => {
+    const csrf = (await http.withCsrf()).json()
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' })
+    const row = (await NewsletterSubscription.all())[0]!
+    await csrf.get(`/newsletter/confirm/${row.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ email: 'a@example.com' }))?.confirmedAt).not.toBeNull()
+    await csrf.get('/newsletter/confirm/nope').assertNotFound()
+
+    await csrf.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('/')
+    expect((await NewsletterSubscription.all()).length).toBe(0)
+  })
+})
