+// Shared by the New and Edit post forms: the input works in the browser's local
+// time (`datetime-local`), the server wants ISO 8601 UTC or null.
+
+interface Props {
+  value: string
+  onChange: (value: string) => void
+  error?: string
+}
+
+const fieldClass =
+  'mt-1 w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent'
+
+/** ISO timestamp from the server → the `YYYY-MM-DDTHH:mm` local value the input takes. */
+export function toDateTimeLocal(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+/** Input value → ISO 8601 UTC for the request; empty means "publish now". */
+export function toPublishAt(local: string): string | null {
+  if (local.trim() === '') return null
+  const date = new Date(local)
+  return Number.isNaN(date.getTime()) ? local : date.toISOString()
+}
+
+export default function PublishAtField({ value, onChange, error }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">Publish at</label>
+      <input
+        type="datetime-local"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        className={fieldClass}
+      />
+      <p className="mt-1 text-xs text-g-muted">
+        Leave empty to publish as soon as the post is saved. Until this time only you can see the post.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
