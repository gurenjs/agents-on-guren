@@ -0,0 +1,23 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeMailData {
+  name: string
+  appName: string
+}
+
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const { name, appName } = this.data
+
+    return this.subject(`Welcome to ${appName}, ${name}!`).text(
+      `Hi ${name},\n\nWelcome to ${appName}! We're glad to have you on board.\n\n— The ${appName} team`,
+    )
+  }
+}
