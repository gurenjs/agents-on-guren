diff --git a/tests/PostController.excerpt.test.ts b/tests/PostController.excerpt.test.ts
new file mode 100644
index 0000000..b488188
--- /dev/null
+++ b/tests/PostController.excerpt.test.ts
@@ -0,0 +1,128 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { deriveExcerpt } from '../app/Models/Post.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const LONG_BODY_UNBROKEN_CUT =
+  'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+const EXPECTED_UNBROKEN_CUT =
+  'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+
+const LONG_BODY_EXACT_BOUNDARY =
+  'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+const EXPECTED_EXACT_BOUNDARY =
+  'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…'
+
+describe('deriveExcerpt', () => {
+  it('keeps a short body unchanged, with no ellipsis', () => {
+    expect(deriveExcerpt('  A short body.  ')).toBe('A short body.')
+  })
+
+  it('keeps exactly 140 characters unchanged', () => {
+    const body = 'a'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('backs up to the last whitespace when the cut lands inside a word', () => {
+    expect(deriveExcerpt(LONG_BODY_UNBROKEN_CUT)).toBe(EXPECTED_UNBROKEN_CUT)
+  })
+
+  it('keeps all 140 characters when the cut lands exactly on a word boundary', () => {
+    expect(deriveExcerpt(LONG_BODY_EXACT_BOUNDARY)).toBe(EXPECTED_EXACT_BOUNDARY)
+  })
+
+  it('cuts at 140 when the first 140 characters contain no whitespace', () => {
+    const body = 'a'.repeat(160)
+    expect(deriveExcerpt(body)).toBe('a'.repeat(140) + '…')
+  })
+})
+
+describe('PostController excerpt handling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function actingUser() {
+    const user = await User.create({ name: 'Writer', email: `writer-${Date.now()}-${Math.random()}@example.com`, password: 'secret1234' })
+    return user
+  }
+
+  it('derives an excerpt from the body when the excerpt is omitted on create', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const res = await csrf.post('/posts', { title: 'Hello', body: LONG_BODY_UNBROKEN_CUT })
+    res.assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe(EXPECTED_UNBROKEN_CUT)
+  })
+
+  it('derives an excerpt from the body when the excerpt is only whitespace', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const res = await csrf.post('/posts', { title: 'Hello', excerpt: '   ', body: 'Short body here.' })
+    res.assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe('Short body here.')
+  })
+
+  it('stores a provided excerpt trimmed, overriding the derived one', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const res = await csrf.post('/posts', {
+      title: 'Hello',
+      excerpt: '  My own excerpt  ',
+      body: LONG_BODY_UNBROKEN_CUT,
+    })
+    res.assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(post?.excerpt).toBe('My own excerpt')
+  })
+
+  it('still rejects a blank title with 422 and saves nothing', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', { title: '  ', body: 'Some body.' }).assertUnprocessable()
+    expect(await Post.first({ body: 'Some body.' })).toBeNull()
+  })
+
+  it('still rejects a blank body with 422 and saves nothing', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.post('/posts', { title: 'A title', body: '   ' }).assertUnprocessable()
+    expect(await Post.first({ title: 'A title' })).toBeNull()
+  })
+
+  it('re-derives the excerpt from the new body on update when left blank', async () => {
+    const user = await actingUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const created = await Post.forceCreate({
+      title: 'Original',
+      excerpt: 'An original excerpt',
+      body: 'Original body.',
+      authorId: user.id,
+    })
+
+    await csrf.put(`/posts/${created!.id}`, { title: 'Original', body: LONG_BODY_EXACT_BOUNDARY }).assertRedirect()
+
+    const updated = await Post.find(created!.id)
+    expect(updated?.excerpt).toBe(EXPECTED_EXACT_BOUNDARY)
+  })
+})
