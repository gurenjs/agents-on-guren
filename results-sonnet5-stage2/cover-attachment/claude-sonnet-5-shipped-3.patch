diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..688b001
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,74 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', cover)
+  return data
+}
+
+const fields = { title: 'T', excerpt: 'E', body: 'B' }
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.forceCreate>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.forceCreate({ name: 'A', email: 'a@example.com', password: 'secret-pass' })
+  })
+
+  it('stores, serves, replaces and removes a cover', async () => {
+    const csrf = await http.actingAs(author!).withCsrf()
+    await csrf.post('/posts', form(fields, new File([PNG], 'c.png', { type: 'image/png' }))).assertRedirect()
+
+    const post = (await Post.all())[0]!
+    const first = (await Attachment.all())[0]!
+    const served = await http.get(`/attachments/${first.id}`)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    const jpeg = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 9])
+    await csrf.put(`/posts/${post.id}`, form(fields, new File([jpeg], 'c.jpg', { type: 'image/jpeg' }))).assertRedirect()
+    expect(existsSync(first.path)).toBe(false)
+    expect(await Attachment.newQuery().count()).toBe(1)
+    await http.get(`/attachments/${first.id}`).assertNotFound()
+
+    const second = (await Attachment.all())[0]!
+    await csrf.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect(existsSync(second.path)).toBe(false)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+
+  it('refuses a GIF without saving anything', async () => {
+    const csrf = await http.actingAs(author!).withCsrf()
+    const res = await csrf.json().post('/posts', form(fields, new File([GIF], 'c.gif', { type: 'image/gif' })))
+    expect(res.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(0)
+  })
+
+  it('deletes the cover with the post', async () => {
+    const csrf = await http.actingAs(author!).withCsrf()
+    await csrf.post('/posts', form(fields, new File([PNG], 'c.png', { type: 'image/png' }))).assertRedirect()
+    const cover = (await Attachment.all())[0]!
+    const post = (await Post.all())[0]!
+    await csrf.delete(`/posts/${post.id}`).assertRedirect()
+    expect(existsSync(cover.path)).toBe(false)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+})
