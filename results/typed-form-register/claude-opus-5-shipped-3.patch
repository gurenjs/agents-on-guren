diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..ee588ef
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,48 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The sign-up form is typed off the schema bound to `register.store`, so these
+// cover the two halves that type-checking cannot: the page the route renders,
+// and the error keys the server actually sends back for the form to display.
+// Validation runs before any query, so an invalid payload needs no database —
+// cover the happy path with a feature test once your test database is seeded.
+describe('register', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Sign-up is a mutating POST behind CSRF protection: prime the session and
+    // XSRF cookies once, or every submission comes back 403 before validating.
+    http = (await TestApp.fromApp(app)).json()
+    http = await http.withCsrf()
+  })
+
+  it('renders the sign-up page', async () => {
+    await http.get('/register').assertOk()
+  })
+
+  it('rejects a mismatched password confirmation', async () => {
+    await http
+      .post('/register', {
+        name: 'Ada',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'not-the-same',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.passwordConfirmation.0', 'Passwords do not match.')
+  })
+
+  it('rejects a blank name and a malformed email', async () => {
+    await http
+      .post('/register', {
+        name: '',
+        email: 'nope',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.name.0', 'Name is required.')
+      .assertJsonPath('errors.email.0', 'The email address is badly formatted.')
+  })
+})
