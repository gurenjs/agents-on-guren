--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,115 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+// A post with a future `published_at` is visible only to its author until
+// that time passes; after that it is public with nothing left to run.
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+  const tag = `sched-${Date.now()}`
+
+  const future = () => new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
+  const past = () => new Date(Date.now() - 60 * 1000).toISOString()
+
+  async function makeUser(name: string): Promise<UserRecord> {
+    return (await User.forceCreate({
+      name,
+      email: `${name}-${tag}@example.com`,
+      password: 'password',
+    })) as UserRecord
+  }
+
+  async function props(client: TestApp, path: string): Promise<Record<string, any>> {
+    const response = await client.withHeaders({ 'X-Inertia': 'true' }).get(path).assertOk()
+    return ((await response.json()) as { props: Record<string, any> }).props
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('author')
+    other = await makeUser('other')
+    scheduled = (await Post.forceCreate({
+      title: `Launch ${tag}`,
+      excerpt: 'Coming soon',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: future(),
+    })) as PostRecord
+  })
+
+  afterAll(async () => {
+    await Post.delete({ id: scheduled.id })
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+  })
+
+  it('shows a scheduled post page to its author with publishedAt', async () => {
+    const { post } = await props(http.actingAs(author), `/posts/${scheduled.id}`)
+    expect(post.id).toBe(scheduled.id)
+    expect(new Date(post.publishedAt).getTime()).toBe(new Date(scheduled.publishedAt!).getTime())
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const guest = await props(http, '/posts')
+    expect(guest.data.some((p: PostRecord) => p.id === scheduled.id)).toBe(false)
+
+    const stranger = await props(http.actingAs(other), '/posts')
+    expect(stranger.data.some((p: PostRecord) => p.id === scheduled.id)).toBe(false)
+
+    const own = await props(http.actingAs(author), '/posts')
+    const listed = own.data.find((p: PostRecord) => p.id === scheduled.id)
+    expect(listed?.publishedAt).toBeString()
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    const response = await http.query('/posts/search', { keywords: [tag] }).assertOk()
+    const { data } = (await response.json()) as { data: PostRecord[] }
+    expect(data.some((p) => p.id === scheduled.id)).toBe(false)
+  })
+
+  it('reports scheduled posts soonest first', async () => {
+    const ids = (await Post.scheduled()).map((post) => post.id)
+    expect(ids).toContain(scheduled.id)
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    await Post.update({ id: scheduled.id }, { publishedAt: past() })
+
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    const guest = await props(http, '/posts')
+    expect(guest.data.some((p: PostRecord) => p.id === scheduled.id)).toBe(true)
+    const response = await http.query('/posts/search', { keywords: [tag] }).assertOk()
+    const { data } = (await response.json()) as { data: PostRecord[] }
+    expect(data.some((p) => p.id === scheduled.id)).toBe(true)
+    expect((await Post.scheduled()).map((post) => post.id)).not.toContain(scheduled.id)
+  })
+})
+
+describe('publishAt validation', () => {
+  const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+  it('treats absent, null and blank as publish now', () => {
+    expect(PostPayloadSchema.parse(base).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: null }).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '' }).publishAt).toBeNull()
+  })
+
+  it('accepts an ISO 8601 UTC timestamp', () => {
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '2026-10-01T09:00:00.000Z' }).publishAt).toBe(
+      '2026-10-01T09:00:00.000Z',
+    )
+  })
+
+  it('rejects text that is not a date and time', () => {
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: 'next tuesday' }).success).toBe(false)
+  })
+})
