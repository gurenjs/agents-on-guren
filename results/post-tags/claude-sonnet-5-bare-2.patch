diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..bab16c1
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,62 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { postTags, posts, tags, users } from '../db/schema.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let db: any
+  let author: any
+
+  const payload = (tagsField?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tagsField === undefined ? {} : { tags: tagsField }) })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    db = await getDatabase()
+    await db.delete(postTags)
+    await db.delete(posts)
+    await db.delete(tags)
+    await db.delete(users)
+    ;[author] = await db
+      .insert(users)
+      .values({ name: 'A', email: 'a@example.com', passwordHash: 'x' })
+      .returning()
+  })
+
+  it('normalizes the field', () => {
+    expect(parseTagNames(' bun ,bun')).toEqual(['bun'])
+    expect(parseTagNames('a,,b,')).toEqual(['a', 'b'])
+    expect(parseTagNames(undefined)).toEqual([])
+  })
+
+  it('creates, edits, filters and deletes tagged posts', async () => {
+    const me = (await http.withCsrf('/login')).actingAs(author)
+    await me.post('/posts', payload('bun, webdev')).assertRedirect()
+    const [post] = await db.select().from(posts)
+    expect((await db.select().from(tags)).map((t: any) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await db.select().from(postTags).where(eq(postTags.postId, post.id))).toHaveLength(2)
+
+    const inertia = async (path: string) =>
+      (await (await me.withHeaders({ 'X-Inertia': 'true' }).get(path).assertOk()).json()) as { props: any }
+
+    expect((await inertia(`/posts/${post.id}`)).props.post.tags).toEqual(['bun', 'webdev'])
+
+    await me.put(`/posts/${post.id}`, payload('bun')).assertRedirect()
+    expect(await db.select().from(postTags).where(eq(postTags.postId, post.id))).toHaveLength(1)
+
+    expect((await inertia(`/posts/${post.id}`)).props.post.tags).toEqual(['bun'])
+    expect((await inertia('/posts?tag=bun')).props.data).toHaveLength(1)
+    expect((await inertia('/posts?tag=nope')).props.data).toEqual([])
+
+    await me.post('/posts', payload('a,b,c,d,e,f')).assertStatus(422)
+    await me.post('/posts', payload('x'.repeat(31))).assertStatus(422)
+    expect(await db.select().from(posts)).toHaveLength(1)
+    await me.post('/posts', payload('x'.repeat(30))).assertRedirect()
+
+    await me.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+})
