+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+// Feature tests for PostPolicy: only the author may mutate their own post.
+// They run against the test SQLite file config/database.ts picks when
+// NODE_ENV=test, migrated once here so no fixtures leak into development data.
+describe('posts.destroy authorization', () => {
+  let http: TestApp
+  let author: { id: number }
+  let stranger: { id: number }
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    const suffix = `${process.pid}`
+    author = (await User.create({
+      name: 'Author',
+      email: `author-${suffix}@example.com`,
+      password: 'secret',
+    })) as { id: number }
+    stranger = (await User.create({
+      name: 'Stranger',
+      email: `stranger-${suffix}@example.com`,
+      password: 'secret',
+    })) as { id: number }
+
+    const post = await Post.forceCreate({
+      title: 'Owned by the author',
+      excerpt: 'Only its author may delete it.',
+      body: 'Body text.',
+      authorId: author.id,
+    })
+    postId = Number((post as { id: number }).id)
+  })
+
+  it('refuses a signed-in user who is not the author', async () => {
+    const csrf = await (await http.actingAs(stranger).withCsrf()).json()
+    await csrf.delete(`/posts/${postId}`).assertStatus(403)
+
+    expect(await Post.find(postId)).not.toBeNull()
+  })
+
+  it('refuses a guest', async () => {
+    const csrf = await (await http.withCsrf()).json()
+    const response = await csrf.delete(`/posts/${postId}`)
+
+    expect(response.status).not.toBe(200)
+    expect(await Post.find(postId)).not.toBeNull()
+  })
+
+  it('lets the author delete their own post', async () => {
+    const csrf = await (await http.actingAs(author).withCsrf()).json()
+    await csrf.delete(`/posts/${postId}`)
+
+    expect(await Post.find(postId)).toBeNull()
+  })
+})
