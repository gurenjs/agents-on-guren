diff --git a/tests/PostArchiveController.test.ts b/tests/PostArchiveController.test.ts
new file mode 100644
index 0000000..5ad75d0
--- /dev/null
+++ b/tests/PostArchiveController.test.ts
@@ -0,0 +1,79 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Unlike the other starter tests, the archive is a database read, so this file
+// migrates the test database and creates its own fixtures. They sit in years no
+// seeder uses, so the assertions count only these posts however often the suite
+// has run before.
+const AUTHOR_EMAIL = 'archive-fixture@example.com'
+const FIXTURES = [
+  { title: 'Early March', excerpt: 'March', body: 'March', createdAt: '1998-03-04T09:00:00.000Z' },
+  { title: 'Late March', excerpt: 'March', body: 'March', createdAt: '1998-03-27T21:30:00.000Z' },
+  { title: 'November', excerpt: 'November', body: 'November', createdAt: '1998-11-02T00:00:00.000Z' },
+]
+
+async function archivedTitles(http: TestApp, path: string): Promise<string[]> {
+  const response = await http.get(path).assertOk()
+  const { data } = (await response.json()) as { data: PostResourceData[] }
+  return data.map((post) => post.title)
+}
+
+describe('posts.archive', () => {
+  let http: TestApp
+  let authorId: number
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+
+    const author =
+      (await User.where({ email: AUTHOR_EMAIL }).first()) ??
+      (await User.create({ name: 'Archive Fixture', email: AUTHOR_EMAIL, password: 'secret' }))
+    authorId = author!.id as number
+
+    // forceCreate: `authorId` and `createdAt` are both outside Post.fillable.
+    for (const fixture of FIXTURES) {
+      await Post.forceCreate({ ...fixture, authorId })
+    }
+  })
+
+  afterAll(async () => {
+    await Post.delete({ authorId })
+    await User.delete({ id: authorId })
+  })
+
+  it('lists the posts of a month, newest first', async () => {
+    expect(await archivedTitles(http, '/posts/archive/1998/03')).toEqual(['Late March', 'Early March'])
+  })
+
+  it('accepts a month without its leading zero', async () => {
+    expect(await archivedTitles(http, '/posts/archive/1998/3')).toEqual(['Late March', 'Early March'])
+  })
+
+  it('lists the posts of a whole year', async () => {
+    expect(await archivedTitles(http, '/posts/archive/1998')).toEqual([
+      'November',
+      'Late March',
+      'Early March',
+    ])
+  })
+
+  it('answers a period with no posts with an empty list', async () => {
+    expect(await archivedTitles(http, '/posts/archive/1998/07')).toEqual([])
+    expect(await archivedTitles(http, '/posts/archive/1997')).toEqual([])
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/1998/13').assertStatus(422)
+    await http.get('/posts/archive/1998/00').assertStatus(422)
+  })
+
+  it('rejects a year that is not four digits', async () => {
+    await http.get('/posts/archive/98').assertStatus(422)
+  })
+})
