diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..fe5573c
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,99 @@
+import { existsSync } from 'node:fs'
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// PNG signature plus filler: the cover is stored as opaque bytes, never decoded.
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 5, 6, 7, 8])
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  data.set('title', 'Cover post')
+  data.set('excerpt', 'An excerpt')
+  data.set('body', 'A body')
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  return data
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.forceCreate>>
+
+  const countAttachments = async () => (await Attachment.newQuery().get()).length
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    user = await User.forceCreate({
+      name: 'Cover Author',
+      email: `cover-${Date.now()}@example.com`,
+      password: 'secret-pass',
+    })
+    http = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  async function coverOf(id: number) {
+    const [found] = await Post.withAttachments([await Post.findOrFail(id)], ['cover'])
+    return found!.cover
+  }
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const before = await countAttachments()
+    await http
+      .post('/posts', form({ cover: new File([PNG], 'a.png', { type: 'image/png' }) }))
+      .assertStatus(303)
+    const post = (await Post.newQuery().orderBy('id', 'desc').first())!
+    const first = (await coverOf(post.id))!
+    expect(first.url).toBeTruthy()
+    expect(await countAttachments()).toBe(before + 1)
+
+    const served = await app.fetch(new Request(`http://localhost:3333${first.url}`))
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toContain('image/png')
+    expect(new Uint8Array(await served.arrayBuffer())).toEqual(PNG)
+
+    await http
+      .put(`/posts/${post.id}`, form({ cover: new File([JPEG], 'b.jpg', { type: 'image/jpeg' }) }))
+      .assertStatus(303)
+    const second = (await coverOf(post.id))!
+    expect(second.id).not.toBe(first.id)
