+++ b/routes/api.ts
@@ -0,0 +1,41 @@
+import { createRateLimitMiddleware, getApiToken, requireAuthenticated, type Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_WINDOW_MS = 60_000
+
+/**
+ * Bearer-only JSON routes for scripts. AuthProvider registers the token guard,
+ * so a request carrying `Authorization: Bearer` authenticates as the token's
+ * owner; without one the session guard answers and, with no session cookie,
+ * fails the same way. No `redirectTo`: a script gets a JSON 401, never /login.
+ */
+export const requireApiToken = requireAuthenticated()
+
+/**
+ * 60 requests per minute per token, not per account: the key is the verified
+ * token's id, which the auth middleware ahead of this one resolved. The
+ * in-memory store is per process — swap in a shared store behind a load
+ * balancer.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  keyGenerator: (ctx) => `api-token:${getApiToken(ctx)?.token.id ?? 'anonymous'}`,
+})
+
+// Uses the 'api.auth' and 'api.throttle' aliases routes/web.ts registers.
+export function registerApiRoutes(router: Router<'api.auth' | 'api.throttle'>): void {
+  router.group('/api', (api) => {
+    api.middleware('api.auth', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [ApiPostController, 'store'])
+    })
+  })
+}
