index 0000000..1db2490
--- /dev/null
+++ b/app/Http/Resources/CommentResource.ts
@@ -0,0 +1,26 @@
+import { Resource } from '@guren/core'
+import type { CommentAuthorSummary, CommentWithAuthor } from '../../Models/Comment.js'
+
+export interface CommentResourceData extends Record<string, unknown> {
+  id: number
+  body: string
+  author: CommentAuthorSummary
+  // Serialized here because `created_at` is a string on SQLite and a Date on
+  // PostgreSQL and MySQL — pages should not have to know which.
+  createdAt: string
+}
+
+export class CommentResource extends Resource<CommentWithAuthor, CommentResourceData> {
+  toArray(): CommentResourceData {
+    const comment = this.resource
+
+    return {
+      id: comment.id,
+      body: comment.body,
+      // `user_id` is NOT NULL, so the name only falls back for an author row
+      // removed behind the ORM's back.
+      author: { id: comment.userId, name: comment.author?.name ?? '' },
+      createdAt: new Date(comment.createdAt).toISOString(),
+    }
+  }
+}
