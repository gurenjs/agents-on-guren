diff --git a/tests/PostController.drafts.test.ts b/tests/PostController.drafts.test.ts
new file mode 100644
index 0000000..bc428ea
--- /dev/null
+++ b/tests/PostController.drafts.test.ts
@@ -0,0 +1,203 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { ScryptHasher } from '@guren/core'
+import app from '../src/app.js'
+import { getDatabase } from '../config/database.js'
+import { posts, users } from '../db/schema.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Covers the draft/published visibility rules: guests and non-authors only
+// ever see published posts (list, search, show), while the author keeps full
+// access to their own drafts. Fixtures are inserted directly against the
+// schema (mirroring the seeders) so this test doesn't depend on HTTP auth
+// flows just to set up data.
+describe('post drafts', () => {
+  let http: TestApp
+  let userA: { id: number }
+  let userB: { id: number }
+  let draft: { id: number }
+  let published: { id: number }
+  const suffix = crypto.randomUUID()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const db = await getDatabase()
+    const hasher = new ScryptHasher()
+
+    const [insertedA] = await db
+      .insert(users)
+      .values({ name: 'Author A', email: `author-a-${suffix}@example.com`, passwordHash: await hasher.hash('secret') })
+      .returning({ id: users.id })
+    userA = insertedA!
+
+    const [insertedB] = await db
+      .insert(users)
+      .values({ name: 'Author B', email: `author-b-${suffix}@example.com`, passwordHash: await hasher.hash('secret') })
+      .returning({ id: users.id })
+    userB = insertedB!
+
+    const [insertedDraft] = await db
+      .insert(posts)
+      .values({
+        title: `Draft ${suffix}`,
+        excerpt: `secret-excerpt-${suffix}`,
+        body: 'A post still being written.',
+        authorId: userA.id,
+        published: false,
+      })
+      .returning({ id: posts.id })
+    draft = insertedDraft!
+
+    const [insertedPublished] = await db
+      .insert(posts)
+      .values({
+        title: `Published ${suffix}`,
+        excerpt: `public-excerpt-${suffix}`,
+        body: 'A post anyone can read.',
+        authorId: userA.id,
+        published: true,
+      })
+      .returning({ id: posts.id })
+    published = insertedPublished!
+  })
+
+  async function indexData(client: TestApp): Promise<PostResourceData[]> {
+    const response = await client.json().get('/posts')
+    const { props } = await response.json()
+    return props.data
+  }
+
+  async function searchData(client: TestApp, keyword: string): Promise<PostResourceData[]> {
+    const response = await client.query('/posts/search', { keywords: [keyword] })
+    const { data } = await response.json()
+    return data
+  }
+
+  for (const [label, clientFor] of [
+    ['guest', () => http] as const,
+    ['a signed-in non-author', () => http.actingAs(userB)] as const,
+  ]) {
+    describe(label, () => {
+      it('never lists the draft on the index', async () => {
+        const data = await indexData(clientFor())
+        expect(data.some((post) => post.id === draft.id)).toBe(false)
+        expect(data.some((post) => post.id === published.id)).toBe(true)
+      })
+
+      it('never returns the draft from search, even on an exact keyword match', async () => {
+        expect(await searchData(clientFor(), suffix)).toEqual(
+          expect.not.arrayContaining([expect.objectContaining({ id: draft.id })]),
+        )
+        expect(await searchData(clientFor(), suffix)).toEqual(
+          expect.arrayContaining([expect.objectContaining({ id: published.id, published: true })]),
+        )
+      })
+
+      it('404s opening the draft directly', async () => {
+        await clientFor().json().get(`/posts/${draft.id}`).assertNotFound()
+      })
+
+      it('opens the published post', async () => {
+        const response = await clientFor().json().get(`/posts/${published.id}`)
+        const { props } = await response.json()
+        expect(props.post.published).toBe(true)
+      })
+    })
+  }
+
+  describe('the author', () => {
+    it('can open their own draft', async () => {
+      const response = await http.actingAs(userA).json().get(`/posts/${draft.id}`)
+      const { props } = await response.json()
+      expect(props.post.id).toBe(draft.id)
+      expect(props.post.published).toBe(false)
+    })
+
+    it('can open the edit form for their own draft', async () => {
+      await http.actingAs(userA).json().get(`/posts/${draft.id}/edit`).assertOk()
+    })
+  })
+
+  describe('creating a post', () => {
+    it('defaults to a draft when the published field is omitted', async () => {
+      const author = http.actingAs(userA)
+      const csrf = await author.withCsrf()
+      const created = await csrf.post('/posts', { title: `Untitled ${suffix}`, excerpt: 'e', body: 'b' })
+      created.assertRedirect()
+
+      const guestList = await indexData(http)
+      expect(guestList.some((post) => post.title === `Untitled ${suffix}`)).toBe(false)
+
+      const ownList = await author.json().get('/posts')
+      // The author still can't see their own draft in the shared index —
+      // only the list's visibility rule changes, not who can query it.
+      const { props } = await ownList.json()
+      expect(props.data.some((post: PostResourceData) => post.title === `Untitled ${suffix}`)).toBe(false)
+    })
+
+    it('publishes immediately when published: true is submitted', async () => {
+      const author = http.actingAs(userA)
+      const csrf = await author.withCsrf()
+      const created = await csrf.post('/posts', {
+        title: `Immediate ${suffix}`,
+        excerpt: 'e',
+        body: 'b',
+        published: true,
+      })
+      created.assertRedirect()
+
+      const guestList = await indexData(http)
+      expect(guestList.some((post) => post.title === `Immediate ${suffix}`)).toBe(true)
+    })
+  })
+
+  describe('editing a post', () => {
+    it('publishing a draft makes it visible to guests', async () => {
+      const author = http.actingAs(userA)
+      const csrf = await author.withCsrf()
+      const response = await csrf.put(`/posts/${draft.id}`, {
+        title: `Draft ${suffix}`,
+        excerpt: `secret-excerpt-${suffix}`,
+        body: 'No longer a secret.',
+        published: true,
+      })
+      response.assertRedirect()
+
+      await http.json().get(`/posts/${draft.id}`).assertOk()
+
+      // Revert so later assertions in this file keep seeing a draft.
+      const revert = await csrf.put(`/posts/${draft.id}`, {
+        title: `Draft ${suffix}`,
+        excerpt: `secret-excerpt-${suffix}`,
+        body: 'A post still being written.',
+        published: false,
+      })
+      revert.assertRedirect()
+      await http.json().get(`/posts/${draft.id}`).assertNotFound()
+    })
+
+    it('unpublishing a published post hides it from guests again', async () => {
+      const author = http.actingAs(userA)
+      const csrf = await author.withCsrf()
+      const response = await csrf.put(`/posts/${published.id}`, {
+        title: `Published ${suffix}`,
+        excerpt: `public-excerpt-${suffix}`,
+        body: 'Temporarily withdrawn.',
+        published: false,
+      })
+      response.assertRedirect()
+
+      await http.json().get(`/posts/${published.id}`).assertNotFound()
+
+      // Revert so earlier assertions about `published` in this file stay valid.
+      const revert = await csrf.put(`/posts/${published.id}`, {
+        title: `Published ${suffix}`,
+        excerpt: `public-excerpt-${suffix}`,
+        body: 'A post anyone can read.',
+        published: true,
+      })
+      revert.assertRedirect()
+      await http.json().get(`/posts/${published.id}`).assertOk()
+    })
+  })
+})
