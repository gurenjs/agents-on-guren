new file mode 100644
index 0000000..d8e9359
--- /dev/null
+++ b/tests/NewsletterController.test.ts
@@ -0,0 +1,140 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { NewsletterSubscription } from '../modules/newsletter/index.js'
+
+describe('Newsletter', () => {
+  let http: TestApp
+  let httpWithCsrf: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    httpWithCsrf = await http.withCsrf()
+    const all = await NewsletterSubscription.all()
+    for (const sub of all) {
+      await NewsletterSubscription.delete({ id: sub.id })
+    }
+  })
+
+  beforeEach(async () => {
+    const all = await NewsletterSubscription.all()
+    for (const sub of all) {
+      await NewsletterSubscription.delete({ id: sub.id })
+    }
+  })
+
+  describe('POST /newsletter/subscribe', () => {
+    it('creates a subscription with a valid email', async () => {
+      const response = await httpWithCsrf
+        .post('/newsletter/subscribe', { email: 'test@example.com' })
+
+      const subscription = await NewsletterSubscription.where({ email: 'test@example.com' }).first()
+
+      if (!subscription) {
+        throw new Error('Subscription not created')
+      }
+
+      if (!subscription.token || subscription.token.length < 16) {
+        throw new Error('Invalid token')
+      }
+
+      if (subscription.confirmedAt !== null) {
+        throw new Error('confirmedAt should be null')
+      }
+
+      if (response.status !== 302 && response.status !== 303) {
+        throw new Error(`Expected 302 or 303, got ${response.status}`)
+      }
+    })
+
+    it('fails with invalid email', async () => {
+      const response = await httpWithCsrf
+        .post('/newsletter/subscribe', { email: 'not-an-email' })
+
+      if (response.status !== 422) {
+        throw new Error(`Expected 422, got ${response.status}`)
+      }
+
+      const all = await NewsletterSubscription.all()
+      if (all.length !== 0) {
+        throw new Error('No subscription should be created')
+      }
+    })
+
+    it('fails with already subscribed email', async () => {
+      await NewsletterSubscription.create({
+        email: 'test@example.com',
+        token: 'existing-token-12345678901234567890',
+        confirmedAt: null,
+      })
+
+      const response = await httpWithCsrf
+        .post('/newsletter/subscribe', { email: 'test@example.com' })
+
+      if (response.status !== 422) {
+        throw new Error(`Expected 422, got ${response.status}`)
+      }
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('confirms a subscription with valid token', async () => {
+      const subscription = await NewsletterSubscription.create({
+        email: 'test@example.com',
+        token: 'valid-token-12345678901234567890ab',
+        confirmedAt: null,
+      })
+
+      const response = await http
+        .get('/newsletter/confirm/valid-token-12345678901234567890ab')
+
+      if (response.status !== 302 && response.status !== 303) {
+        throw new Error(`Expected 302 or 303, got ${response.status}`)
+      }
+
+      const confirmed = await NewsletterSubscription.find(subscription.id)
+      if (!confirmed || !confirmed.confirmedAt) {
+        throw new Error('Subscription should be confirmed')
+      }
+    })
+
+    it('returns 404 for invalid token', async () => {
+      const response = await http.get('/newsletter/confirm/invalid-token')
+
+      if (response.status !== 404) {
+        throw new Error(`Expected 404, got ${response.status}`)
+      }
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('deletes subscription with valid email', async () => {
+      await NewsletterSubscription.create({
+        email: 'test@example.com',
+        token: 'token-12345678901234567890ab',
+        confirmedAt: null,
+      })
+
+      const response = await httpWithCsrf
+        .post('/newsletter/unsubscribe', { email: 'test@example.com' })
+
+      if (response.status !== 302 && response.status !== 303) {
+        throw new Error(`Expected 302 or 303, got ${response.status}`)
+      }
+
+      const all = await NewsletterSubscription.all()
+      if (all.length !== 0) {
+        throw new Error('Subscription should be deleted')
+      }
+    })
+
+    it('succeeds even if email not found', async () => {
+      const response = await httpWithCsrf
+        .post('/newsletter/unsubscribe', { email: 'notfound@example.com' })
+
+      if (response.status !== 302 && response.status !== 303) {
+        throw new Error(`Expected 302 or 303, got ${response.status}`)
+      }
+    })
+  })
+})
