+const GIF = Uint8Array.from(Buffer.from('R0lGODlhAQABAAAAACw=', 'base64'))
+
+function postForm(fields: Record<string, string>, cover?: File): FormData {
+  const form = new FormData()
+  for (const [key, value] of Object.entries({ title: 'Hello', excerpt: 'Short', body: 'Long', ...fields })) {
+    form.append(key, value)
+  }
+  if (cover) form.append('cover', cover)
+  return form
+}
+
+async function coverUrlOf(id: number): Promise<string | null> {
+  const [post] = await Post.withAttachments([await Post.findOrFail(id)], ['cover'])
+  return post?.cover?.url ?? null
+}
+
+describe('post covers', () => {
+  let http: TestApp
