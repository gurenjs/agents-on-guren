+import type { Router } from '@guren/core'
+import NewsletterController from './Http/NewsletterController.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', [NewsletterController, 'subscribe']).name('newsletter.subscribe')
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', [NewsletterController, 'unsubscribe']).name('newsletter.unsubscribe')
+}
