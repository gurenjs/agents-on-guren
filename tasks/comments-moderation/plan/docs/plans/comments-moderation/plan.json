              "ability": "delete"
            }
          },
          "response": {
            "kind": "redirect",
            "to": "/posts"
          },
          "rules": [
            "The post's comments and their reports go with it, through the foreign keys' ON DELETE CASCADE."
          ]
        }
      ]
    },
