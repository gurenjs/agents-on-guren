+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function seed() {
+    const author = await User.create({ name: 'A', email: 'a@x.test', password: 'secret-pass-1' })
+    const other = await User.create({ name: 'B', email: 'b@x.test', password: 'secret-pass-1' })
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: future,
+    })
+    return { author, other, post }
+  }
+
+  it('hides a scheduled post from guests and other users, shows it to its author', async () => {
+    const { author, other, post } = await seed()
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+    await http.query('/posts/search', { keywords: ['Later'] }).assertJsonCount(0, 'data')
+  })
+
+  it('shows it to everyone once the time has passed', async () => {
+    const { post } = await seed()
+    await Post.forceUpdate({ id: post.id }, { publishedAt: '2000-01-01T00:00:00.000Z' })
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('rejects a publishAt that is not a date', async () => {
+    const { author } = await seed()
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+  })
+
+  it('posts:scheduled prints scheduled posts only', async () => {
+    const { post } = await seed()
+    const proc = Bun.spawnSync(['bun', 'run', 'console', 'posts:scheduled'], { env: process.env })
+    expect(proc.stdout.toString()).toBe(`${post.id}\tLater\t${future}\n`)
+    expect(proc.exitCode).toBe(0)
+  })
+})
