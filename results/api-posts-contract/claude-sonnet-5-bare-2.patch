diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..18f20df 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -20,3 +20,38 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// api.posts.index is a public, unauthenticated JSON feed. `page`/`author` are
+// declared on the route's `query:` contract, so an invalid value never
+// reaches the controller — it 422s from the same contract-validation
+// middleware that guards posts.search's body.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects an invalid page', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects an invalid author', async () => {
+    await http.get('/api/posts?author=abc').assertStatus(422)
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+
+  it('lists posts newest first in a paginated envelope', async () => {
+    await http
+      .get('/api/posts')
+      .assertOk()
+      .assertJsonStructure(['data', 'meta'])
+      .assertJsonPath('meta.currentPage', 1)
+      .assertJsonPath('meta.perPage', 10)
+  })
+
+  it('returns an empty page for an author with no posts', async () => {
+    await http.get('/api/posts?author=999999').assertOk().assertJsonPath('meta.total', 0).assertJsonCount(0, 'data')
+  })
+})
