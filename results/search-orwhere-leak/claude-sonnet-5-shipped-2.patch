+  describe('published visibility', () => {
+    beforeEach(async () => {
+      await resetDatabase()
+    })
+
+    it('excludes unpublished posts, even alongside a matching published one', async () => {
+      const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
