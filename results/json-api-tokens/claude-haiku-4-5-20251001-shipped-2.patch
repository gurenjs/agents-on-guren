diff --git a/app/Services/ApiTokenService.ts b/app/Services/ApiTokenService.ts
new file mode 100644
index 0000000..5b9e9a0
--- /dev/null
+++ b/app/Services/ApiTokenService.ts
@@ -0,0 +1,23 @@
+import { createHash, randomBytes } from 'node:crypto'
+
+export interface TokenPair {
+  token: string
+  hash: string
+}
+
+export class ApiTokenService {
+  static generateToken(): TokenPair {
+    const token = randomBytes(32).toString('hex')
+    const hash = this.hashToken(token)
+    return { token, hash }
+  }
+
+  static hashToken(token: string): string {
+    return createHash('sha256').update(token).digest('hex')
+  }
+
+  static verifyToken(token: string, hash: string): boolean {
+    const tokenHash = this.hashToken(token)
+    return tokenHash === hash
+  }
+}
diff --git a/app/Services/RateLimiterService.ts b/app/Services/RateLimiterService.ts
new file mode 100644
index 0000000..bf8288d
--- /dev/null
+++ b/app/Services/RateLimiterService.ts
@@ -0,0 +1,39 @@
+interface RateLimitEntry {
+  count: number
+  firstRequestAt: number
+}
+
+export class RateLimiterService {
+  private static limits = new Map<number, RateLimitEntry>()
+  private static readonly MAX_REQUESTS_PER_MINUTE = 60
+  private static readonly MINUTE_MS = 60 * 1000
+
+  static checkAndIncrement(tokenId: number): { allowed: boolean; secondsUntilReset: number } {
+    const now = Date.now()
+    const entry = this.limits.get(tokenId)
+
+    if (!entry) {
+      this.limits.set(tokenId, { count: 1, firstRequestAt: now })
+      return { allowed: true, secondsUntilReset: 0 }
+    }
+
+    const timeSinceFirst = now - entry.firstRequestAt
+
+    if (timeSinceFirst > this.MINUTE_MS) {
+      this.limits.set(tokenId, { count: 1, firstRequestAt: now })
+      return { allowed: true, secondsUntilReset: 0 }
+    }
+
+    entry.count++
+    if (entry.count > this.MAX_REQUESTS_PER_MINUTE) {
+      const secondsUntilReset = Math.ceil((this.MINUTE_MS - timeSinceFirst) / 1000)
+      return { allowed: false, secondsUntilReset }
+    }
+
+    return { allowed: true, secondsUntilReset: 0 }
+  }
+
+  static reset(tokenId: number): void {
+    this.limits.delete(tokenId)
+  }
+}
