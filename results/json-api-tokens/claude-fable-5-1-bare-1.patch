--- /dev/null
+++ b/app/Auth/apiTokens.ts
@@ -0,0 +1,10 @@
+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+/**
+ * Personal API tokens, `{id}|{secret}`: only the id and a SHA-256 of the
+ * secret are stored, so a database dump holds no usable credential.
+ * Not registered with `auth.useTokens()`, which would let a token sign in on
+ * every route, the profile page included. Tokens work in routes/api.ts only.
+ */
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
diff --git a/app/Http/Controllers/ApiPostController.ts b/app/Http/Controllers/ApiPostController.ts
new file mode 100644
index 0000000..6c7dcb0
--- /dev/null
+++ b/app/Http/Controllers/ApiPostController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import type { UserRecord } from '../../Models/User.js'
+import { PostResource } from '../Resources/PostResource.js'
+
+// The JSON API for scripts. Every route here sits behind the bearer-token
+// middleware in routes/api.ts, so `this.auth` answers with the token's owner.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      // `id` breaks the tie between posts created in the same millisecond.
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // forceCreate, because `authorId` is deliberately absent from Post.fillable:
+    // it comes from the token, and a request must never be able to set it.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.created({ data: new PostResource(post).toJSON() })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..ff2551e
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,37 @@
+import { Controller, createApiToken, resetRateLimit, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokens.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { API_RATE_LIMIT_KEY_PREFIX, apiRateLimitStore } from '../Middleware/apiToken.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name: body.name,
+      userId: user.id,
+    })
+
+    // The only response that ever carries the plain text, so nothing between
+    // here and the user may keep a copy.
+    return this.created(
+      { id: token.id, name: token.name, token: plainTextToken },
+      { headers: { 'Cache-Control': 'no-store' } },
+    )
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+    // Scoped to the owner, so another user's token id is a plain 404 and
+    // reveals nothing about whether it exists.
+    const token = await ApiToken.where({ id, userId: user.id }).firstOrFail()
+
+    await revokeApiToken(token.id, apiTokenStore)
+    await resetRateLimit(token.id, apiRateLimitStore, { keyPrefix: API_RATE_LIMIT_KEY_PREFIX })
+
+    return this.noContent()
+  }
+}
