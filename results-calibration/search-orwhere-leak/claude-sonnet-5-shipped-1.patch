@@ -19,4 +22,70 @@ describe('posts.search', () => {
   it('rejects a search without keywords', async () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
+
+  describe('with fixture posts', () => {
+    beforeEach(async () => {
+      await resetDatabase()
+
+      const author = await User.forceCreate({
+        name: 'Author',
+        email: 'author@example.com',
+        password: 'password123',
+      })
+
+      // Unpublished posts are only ever created directly in the database —
+      // `published` is deliberately absent from Post.fillable.
+      await Post.forceCreate({
+        title: 'zephyrquill in the wild',
+        excerpt: 'a published post',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'zephyrquill secrets',
+        excerpt: 'an unpublished post',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+      await Post.forceCreate({
+        title: 'marmalade on toast',
+        excerpt: 'another published post',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+      await Post.forceCreate({
+        title: 'totally unrelated',
+        excerpt: 'no keyword match here',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+    })
+
+    it('never returns unpublished posts, even when they match the keyword', async () => {
+      const res = await http.json().query('/posts/search', { keywords: ['zephyrquill'] })
+      res.assertOk()
+      const body = await res.json<{ data: Array<{ title: string }> }>()
+      const titles = body.data.map((post) => post.title)
+
+      expect(titles).toEqual(['zephyrquill in the wild'])
+    })
+
+    it('returns an empty result when the keyword only matches unpublished posts', async () => {
+      await http
+        .json()
+        .query('/posts/search', { keywords: ['secrets'] })
+        .assertJsonCount(0, 'data')
+    })
+
+    it('matches published posts containing any of several keywords, and nothing else', async () => {
+      await http
+        .json()
+        .query('/posts/search', { keywords: ['zephyrquill', 'marmalade'] })
+        .assertJsonCount(2, 'data')
+    })
+  })
 })
