@@ -0,0 +1,50 @@
+---
+type: adr
+status: stable
+entities: [ApiToken, Post]
+related:
+  - app/Auth/apiTokenStore.ts
+  - app/Providers/AuthProvider.ts
+  - app/Http/Controllers/ApiTokenController.ts
+  - app/Http/Controllers/Api/ApiPostController.ts
