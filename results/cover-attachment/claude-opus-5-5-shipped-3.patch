diff --git a/app/Http/Validators/PostValidator.ts b/app/Http/Validators/PostValidator.ts
index 804642a..b3d347b 100644
--- a/app/Http/Validators/PostValidator.ts
+++ b/app/Http/Validators/PostValidator.ts
@@ -23,3 +23,38 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPE_MESSAGE = 'The cover must be a PNG or JPEG image.'
+
+// A file input left empty still submits a zero-byte File (Bun parses its name
+// as undefined, not ''); Inertia sends a null field as ''. All mean "no cover picked".
+export function isEmptyUpload(value: unknown): boolean {
+  return value === undefined || value === null || value === '' || (value instanceof File && value.size === 0)
+}
+
+// The PNG/JPEG check needs the file's bytes (the client-declared type is not
+// trusted), so PostController runs it with `sniffCoverType()` after this passes.
+const CoverUploadSchema = z
+  .custom<File | '' | null>((value) => isEmptyUpload(value) || value instanceof File, COVER_TYPE_MESSAGE)
+  .refine((value) => isEmptyUpload(value) || (value as File).size <= COVER_MAX_BYTES, 'The cover must be 2 MB or smaller.')
+  .optional()
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+export function sniffCoverType(bytes: Uint8Array): 'image/png' | 'image/jpeg' | null {
+  const startsWith = (signature: number[]) => signature.every((byte, index) => bytes[index] === byte)
+  if (startsWith(PNG_SIGNATURE)) return 'image/png'
+  if (startsWith(JPEG_SIGNATURE)) return 'image/jpeg'
+  return null
+}
+
+export const PostStoreSchema = PostPayloadSchema.extend({
+  cover: CoverUploadSchema,
+})
+
+export const PostUpdateSchema = PostStoreSchema.extend({
+  // A ticked checkbox arrives as '1' in multipart bodies, a boolean in JSON.
+  removeCover: z.union([z.boolean(), z.enum(['0', '1'])]).optional(),
+})
