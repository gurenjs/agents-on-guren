index 0000000..9c81d35
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt, resolveExcerpt } from '../app/Support/excerpt.js'
+
+const SENTENCE = 'The quick brown fox jumps over the lazy dog. '
+
+describe('deriveExcerpt', () => {
+  it('keeps a short body whole, with no ellipsis', () => {
+    expect(deriveExcerpt('A tiny post.')).toBe('A tiny post.')
+    expect(deriveExcerpt('  padded on both sides  ')).toBe('padded on both sides')
+  })
+
+  it('keeps a body of exactly 140 characters whole', () => {
+    const body = 'a'.repeat(140)
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('cuts back to the last whitespace when the cut lands inside a word', () => {
+    const body = `${SENTENCE.repeat(3)}The quick brown`
+    expect(body).toHaveLength(150)
+    expect(deriveExcerpt(body)).toBe(`${SENTENCE.repeat(3)}The…`)
+    expect(deriveExcerpt(body)).toHaveLength(139)
+  })
+
+  it('keeps all 140 characters when the cut lands on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body).toHaveLength(170)
+    expect(deriveExcerpt(body)).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(deriveExcerpt(body)).toHaveLength(141)
+  })
+
+  it('cuts at 140 when the first 140 characters hold no whitespace', () => {
+    const excerpt = deriveExcerpt('x'.repeat(200))
+    expect(excerpt).toBe(`${'x'.repeat(140)}…`)
+  })
+
+  it('appends a single ellipsis character, not three periods', () => {
+    const excerpt = deriveExcerpt(SENTENCE.repeat(10))
+    expect(excerpt.endsWith('…')).toBe(true)
+    expect(excerpt.endsWith('...')).toBe(false)
+    expect(excerpt.at(-2)).not.toMatch(/\s/)
+  })
+})
+
+describe('resolveExcerpt', () => {
+  it('prefers a provided excerpt', () => {
+    expect(resolveExcerpt('Hand written.', 'A body.')).toBe('Hand written.')
+  })
+
+  it('falls back to the body when the excerpt is missing, empty, or blank', () => {
+    expect(resolveExcerpt(undefined, 'A body.')).toBe('A body.')
+    expect(resolveExcerpt('', 'A body.')).toBe('A body.')
+    expect(resolveExcerpt('   \n\t ', 'A body.')).toBe('A body.')
+  })
+})
