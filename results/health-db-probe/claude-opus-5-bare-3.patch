+++ b/tests/HealthController.test.ts
@@ -0,0 +1,59 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { checkDatabase, healthStatusCode, runHealthChecks } from '../app/Health/HealthCheck.js'
+
+describe('GET /health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('answers 200 with a per-check status while the database is reachable', async () => {
+    const response = await http.get('/health').assertOk().assertJsonPath('status', 'ok')
+
+    await response.assertJsonPath('checks.db.status', 'ok')
+  })
+})
+
+describe('health checks', () => {
+  it('reports the database as ok when the probe succeeds', async () => {
+    const report = await runHealthChecks(async () => {})
+
+    expect(report.status).toBe('ok')
+    expect(report.checks.db.status).toBe('ok')
+    expect(healthStatusCode(report)).toBe(200)
+  })
+
+  it('reports 503 rather than a throw when the query fails', async () => {
+    const report = await runHealthChecks(async () => {
+      throw new Error('unable to open database file')
+    })
+
+    expect(report.status).toBe('error')
+    expect(report.checks.db.status).toBe('error')
+    expect(report.checks.db.message).toBe('unable to open database file')
+    expect(healthStatusCode(report)).toBe(503)
+  })
+
+  it('fails the check when the connection cannot even be opened', async () => {
+    const check = await checkDatabase(() => {
+      throw new Error('connection refused')
+    })
+
+    expect(check.status).toBe('error')
+  })
+
+  it('touches the database on every probe rather than caching the result', async () => {
+    let probes = 0
+    const probe = async () => {
+      probes += 1
+    }
+
+    await runHealthChecks(probe)
+    await runHealthChecks(probe)
+
+    expect(probes).toBe(2)
+  })
+})
