diff --git a/tests/Auth/LoginController.test.ts b/tests/Auth/LoginController.test.ts
new file mode 100644
index 0000000..f36dad1
--- /dev/null
+++ b/tests/Auth/LoginController.test.ts
@@ -0,0 +1,134 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import DatabaseProvider from '../../app/Providers/DatabaseProvider.js'
+import AuthProvider from '../../app/Providers/AuthProvider.js'
+import AuthorizationProvider from '../../app/Providers/AuthorizationProvider.js'
+import { registerWebRoutes } from '../../routes/web.js'
+
+describe('LoginController - Rate Limiting', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Create a TestApp with proper auth and providers for CSRF middleware
+    http = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider, AuthProvider, AuthorizationProvider],
+      routes: registerWebRoutes,
+    })
+  })
+
+  it('allows first 5 login attempts within the limit', async () => {
+    const csrf = await http.withCsrf()
+    for (let i = 0; i < 5; i++) {
+      const res = await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrong',
+        remember: false,
+      })
+      // Should not be throttled (may be 422 from invalid credentials, but not 429)
+      if (res.status === 429) {
+        throw new Error(`Request ${i + 1} was throttled unexpectedly`)
+      }
+    }
+  })
+
+  it('throttles requests after 5 attempts within 60 seconds', async () => {
+    // Make a fresh app to start with a clean rate limiter state
+    const freshHttp = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider, AuthProvider, AuthorizationProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await freshHttp.withCsrf()
+
+    // Make 5 attempts
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrong',
+        remember: false,
+      })
+    }
+
+    // 6th attempt should be throttled
+    const res = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'wrong',
+      remember: false,
+    })
+
+    if (res.status !== 429) {
+      throw new Error(`Expected 429, got ${res.status}`)
+    }
+
+    // Check for Retry-After header
+    const retryAfter = res.headers.get('retry-after')
+    if (!retryAfter) {
+      throw new Error('Retry-After header is missing')
+    }
+
+    const seconds = parseInt(retryAfter, 10)
+    if (isNaN(seconds) || seconds <= 0 || seconds > 60) {
+      throw new Error(`Invalid Retry-After value: ${retryAfter}`)
+    }
+  })
+
+  it('allows GET /login regardless of rate limit status', async () => {
+    const freshHttp = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider, AuthProvider, AuthorizationProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await freshHttp.withCsrf()
+
+    // Make 5 attempts to build up the counter
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrong',
+        remember: false,
+      })
+    }
+
+    // GET /login should still work (not affected by POST throttling)
+    const res = await freshHttp.get('/login')
+    if (res.status !== 200) {
+      throw new Error(`GET /login returned ${res.status}, expected 200`)
+    }
+  })
+
+  it('returns 429 response with proper JSON body', async () => {
+    const freshHttp = await TestApp.create({
+      auth: {},
+      providers: [DatabaseProvider, AuthProvider, AuthorizationProvider],
+      routes: registerWebRoutes,
+    })
+    const csrf = await freshHttp.withCsrf()
+
+    // Make 5 attempts
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrong',
+        remember: false,
+      })
+    }
+
+    // 6th attempt should be throttled
+    const res = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'wrong',
+      remember: false,
+    })
+
+    if (res.status !== 429) {
+      throw new Error(`Expected 429, got ${res.status}`)
+    }
+
+    // Verify response body is valid JSON with a message
+    const body = await res.json()
+    if (!body.message) {
+      throw new Error('Response body missing message field')
+    }
+  })
+})
