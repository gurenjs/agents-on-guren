diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..6b97aa4
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,32 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// register.store carries RegisterSchema as its bound body schema, which is
+// what codegen turns into the type the sign-up page builds its form from —
+// binding it must not move validation off the controller. A mismatched
+// confirmation is rejected by validateBody() before any user lookup runs, so
+// this stays green without migrations or fixtures; cover the happy path with
+// real feature tests once your test database is set up.
+describe('register.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects a sign-up whose confirmation does not match', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: 'Ada',
+        email: 'ada@example.com',
+        password: 'secret123',
+        passwordConfirmation: 'secret124',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.passwordConfirmation', ['Passwords do not match.'])
+  })
+})
