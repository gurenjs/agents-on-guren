diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..8144f8e
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,147 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import ListScheduledPostsCommand from '../app/Console/Commands/ListScheduledPostsCommand.js'
+
+// Runs against the test database (`bun test` sets NODE_ENV=test), creating its
+// own users and posts and removing them afterwards.
+const FUTURE = '2099-10-01T09:00:00.000Z'
+const PAST = '2001-01-01T00:00:00.000Z'
+
+interface ListedPost {
+  id: number
+  publishedAt: string | null
+}
+
+async function inertiaProps(response: Response): Promise<Record<string, unknown>> {
+  const { payload } = await readInertiaResponse(response)
+  return payload.props as Record<string, unknown>
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: { id: number }
+  let open: { id: number }
+  const tag = `sched${Date.now()}`
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({ name: 'Author', email: `${tag}-a@example.com`, password: 'secret' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: `${tag}-b@example.com`, password: 'secret' })) as UserRecord
+    scheduled = (await Post.forceCreate({
+      title: `${tag} scheduled`,
+      excerpt: tag,
+      body: 'later',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as { id: number }
+    open = (await Post.forceCreate({ title: `${tag} open`, excerpt: tag, body: 'now', authorId: author.id })) as {
+      id: number
+    }
+  })
+
+  afterAll(async () => {
+    await Post.delete({ id: scheduled.id })
+    await Post.delete({ id: open.id })
+    await User.delete({ id: author.id })
+    await User.delete({ id: other.id })
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+  })
+
+  it('shows a scheduled post page to its author with publishedAt', async () => {
+    const response = await http.actingAs(author).get(`/posts/${scheduled.id}`).assertOk()
+    const props = await inertiaProps(response.raw)
+    expect((props.post as ListedPost).publishedAt).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const guestIds = ((await inertiaProps((await http.get('/posts')).raw)).data as ListedPost[]).map((p) => p.id)
+    expect(guestIds).toContain(open.id)
+    expect(guestIds).not.toContain(scheduled.id)
+
+    const otherIds = ((await inertiaProps((await http.actingAs(other).get('/posts')).raw)).data as ListedPost[]).map(
+      (p) => p.id,
+    )
+    expect(otherIds).not.toContain(scheduled.id)
+
+    const mine = (await inertiaProps((await http.actingAs(author).get('/posts')).raw)).data as ListedPost[]
+    expect(mine.find((p) => p.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+  })
+
+  it('leaves a scheduled post out of search for guests', async () => {
+    const response = await http.query('/posts/search', { keywords: [tag] }).assertOk()
+    const ids = (await response.json<{ data: ListedPost[] }>()).data.map((p) => p.id)
+    expect(ids).toContain(open.id)
+    expect(ids).not.toContain(scheduled.id)
+  })
+
+  it('reports scheduled posts from the console command', async () => {
+    const lines: string[] = []
+    const write = process.stdout.write
+    process.stdout.write = ((chunk: string) => {
+      lines.push(chunk)
+      return true
+    }) as typeof process.stdout.write
+    try {
+      await new ListScheduledPostsCommand().handle()
+    } finally {
+      process.stdout.write = write
+    }
+    expect(lines).toContain(`${scheduled.id}\t${tag} scheduled\t${FUTURE}\n`)
+    expect(lines.some((line) => line.startsWith(`${open.id}\t`))).toBe(false)
+  })
+
+  it('stores publishAt from the create and edit forms, and rejects a non-date', async () => {
+    const client = (await http.actingAs(author).withCsrf('/posts')).json()
+    const before = await Post.newQuery().count()
+    const blankTitle = await client.post('/posts', { title: '', excerpt: 'e', body: 'b' })
+    const badDate = await client.post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+    expect(blankTitle.status).toBe(422)
+    expect(badDate.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(before)
+
+    await client.put(`/posts/${open.id}`, { title: `${tag} open`, excerpt: tag, body: 'now', publishAt: FUTURE })
+    expect((await Post.findOrFail(open.id)).publishedAt).toBe(FUTURE)
+    await http.get(`/posts/${open.id}`).assertNotFound()
+
+    await client.put(`/posts/${open.id}`, { title: `${tag} open`, excerpt: tag, body: 'now', publishAt: null })
+    expect((await Post.findOrFail(open.id)).publishedAt).toBeNull()
+  })
+
+  it('makes the post public once published_at has passed', async () => {
+    await Post.update({ id: scheduled.id }, { publishedAt: PAST })
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+    const response = await http.query('/posts/search', { keywords: [tag] }).assertOk()
+    const ids = (await response.json<{ data: ListedPost[] }>()).data.map((p) => p.id)
+    expect(ids).toContain(scheduled.id)
+  })
+})
+
+describe('publishAt validation', () => {
+  const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+  it('treats absent, null and blank as publish now', () => {
+    expect(PostPayloadSchema.parse(base).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: null }).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '' }).publishAt).toBeNull()
+  })
+
+  it('normalizes a date and time to ISO UTC', () => {
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '2026-10-01T18:00:00+09:00' }).publishAt).toBe(
+      '2026-10-01T09:00:00.000Z',
+    )
+  })
+
+  it('rejects a value that is not a date and time', () => {
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: 'next tuesday' }).success).toBe(false)
+  })
+})
