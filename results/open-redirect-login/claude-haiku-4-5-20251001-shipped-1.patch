+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  describe('store', () => {
+    it('authenticates with valid credentials and redirects to dashboard by default', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'demo@example.com',
+          password: 'secret',
+          redirect: '',
+        })
+        .assertRedirect('/dashboard')
+    })
+
+    it('authenticates and respects safe redirects', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'demo@example.com',
+          password: 'secret',
+          redirect: '/posts/123',
+        })
+        .assertRedirect('/posts/123')
+    })
+
+    it('ignores unsafe redirects and goes to dashboard instead', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'demo@example.com',
+          password: 'secret',
+          redirect: 'https://evil.example',
+        })
+        .assertRedirect('/dashboard')
+    })
+
+    it('ignores protocol-relative redirects', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'demo@example.com',
+          password: 'secret',
+          redirect: '//evil.example',
+        })
+        .assertRedirect('/dashboard')
+    })
+
+    it('ignores backslash protocol-relative variants', async () => {
+      const csrf = await http.withCsrf()
+      await csrf
+        .post('/login', {
+          email: 'demo@example.com',
+          password: 'secret',
+          redirect: '/\\evil.example',
+        })
+        .assertRedirect('/dashboard')
+    })
+  })
+})
diff --git a/tests/RedirectValidator.test.ts b/tests/RedirectValidator.test.ts
new file mode 100644
index 0000000..61cecbb
--- /dev/null
+++ b/tests/RedirectValidator.test.ts
@@ -0,0 +1,62 @@
+import { describe, it } from 'bun:test'
+import { isSafeRedirect } from '../app/Http/Utilities/RedirectValidator.js'
+import { expect } from 'bun:test'
+
+describe('isSafeRedirect', () => {
+  describe('valid redirects', () => {
+    it('accepts absolute paths', () => {
+      expect(isSafeRedirect('/posts')).toBe(true)
+      expect(isSafeRedirect('/posts/123')).toBe(true)
+      expect(isSafeRedirect('/posts/123/edit')).toBe(true)
+      expect(isSafeRedirect('/')).toBe(true)
+    })
+
+    it('accepts paths with query strings', () => {
+      expect(isSafeRedirect('/posts?page=2')).toBe(true)
+      expect(isSafeRedirect('/posts?sort=name&order=asc')).toBe(true)
+    })
+
+    it('accepts paths with fragments', () => {
+      expect(isSafeRedirect('/posts#top')).toBe(true)
+      expect(isSafeRedirect('/posts/123#comments')).toBe(true)
+    })
+  })
+
+  describe('unsafe redirects', () => {
+    it('rejects absolute URLs with schemes', () => {
+      expect(isSafeRedirect('https://evil.example')).toBe(false)
+      expect(isSafeRedirect('http://evil.example')).toBe(false)
+      expect(isSafeRedirect('http://evil.example/path')).toBe(false)
+      expect(isSafeRedirect('ftp://evil.example')).toBe(false)
+      expect(isSafeRedirect('javascript:alert(1)')).toBe(false)
+    })
+
+    it('rejects protocol-relative URLs', () => {
+      expect(isSafeRedirect('//evil.example')).toBe(false)
+      expect(isSafeRedirect('\\\\evil.example')).toBe(false)
+    })
+
+    it('rejects backslash variants', () => {
+      expect(isSafeRedirect('/\\evil.example')).toBe(false)
+      expect(isSafeRedirect('\\/')).toBe(false)
+    })
+
+    it('rejects relative paths', () => {
+      expect(isSafeRedirect('posts')).toBe(false)
+      expect(isSafeRedirect('./posts')).toBe(false)
+      expect(isSafeRedirect('../posts')).toBe(false)
+    })
+
+    it('rejects null and undefined', () => {
+      expect(isSafeRedirect(null)).toBe(false)
+      expect(isSafeRedirect(undefined)).toBe(false)
+      expect(isSafeRedirect('')).toBe(false)
+    })
+
+    it('rejects whitespace-only strings', () => {
+      expect(isSafeRedirect('  ')).toBe(false)
+      expect(isSafeRedirect('\t')).toBe(false)
+      expect(isSafeRedirect('\n')).toBe(false)
+    })
+  })
+})
