+++ b/app/Auth/api-tokens.ts
@@ -0,0 +1,26 @@
+import {
+  DatabaseApiTokenStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+// The loaded user becomes the request's principal, so this.auth answers with
+// the token's owner in API controllers.
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+})
+
+// Keyed by the verified token, so it must run after authenticateApiToken: two
+// tokens of one account get separate budgets.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'unauthenticated',
+})
