+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createAuthor(email: string, name: string) {
+    return User.create({ name, email, password: 'secret' })
+  }
+
+  async function createPosts(authorId: number, count: number) {
+    for (let i = 1; i <= count; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId,
+      })
+    }
+  }
+
+  it('lists posts newest first, 10 per page, with no auth required', async () => {
+    const author = await createAuthor('alice@example.com', 'Alice')
+    await createPosts(author.id, 12)
+
+    await http
+      .get('/api/posts')
+      .assertOk()
+      .assertJsonCount(10, 'data')
+      .assertJsonPath('data.0.title', 'Post 12')
+      .assertJsonPath('data.0.author.name', 'Alice')
+      .assertJsonPath('meta.currentPage', 1)
+      .assertJsonPath('meta.lastPage', 2)
+      .assertJsonPath('meta.perPage', 10)
+      .assertJsonPath('meta.total', 12)
+  })
+
+  it('returns the second page', async () => {
+    const author = await createAuthor('alice@example.com', 'Alice')
+    await createPosts(author.id, 12)
+
+    await http
+      .get('/api/posts?page=2')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Post 2')
+      .assertJsonPath('meta.currentPage', 2)
+  })
+
+  it('narrows to one author and its own total', async () => {
+    const alice = await createAuthor('alice@example.com', 'Alice')
+    const bob = await createAuthor('bob@example.com', 'Bob')
+    await createPosts(alice.id, 3)
+    await createPosts(bob.id, 2)
+
+    await http
+      .get(`/api/posts?author=${bob.id}`)
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('meta.total', 2)
+  })
+
+  it('returns an empty page for an author with no posts', async () => {
+    const author = await createAuthor('alice@example.com', 'Alice')
+
+    await http
+      .get(`/api/posts?author=${author.id}`)
+      .assertOk()
+      .assertJsonCount(0, 'data')
+      .assertJsonPath('meta.total', 0)
+  })
+
+  it.each([['page', '0'], ['page', 'abc'], ['author', 'abc'], ['author', '0']])(
+    'rejects an invalid %s=%s with 422',
+    async (key, value) => {
+      await http.get(`/api/posts?${key}=${value}`).assertUnprocessable()
+    },
+  )
+})
