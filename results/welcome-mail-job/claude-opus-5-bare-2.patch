diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..fa9d0f4
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,46 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailJobPayload {
+  name: string
+  email: string
+}
+
+/**
+ * Delivers the welcome mail outside the registration request, so sign-up
+ * neither waits for the mail provider nor fails with it. RegisterController
+ * dispatches this; QUEUE_CONNECTION decides whether the work runs inline
+ * (`sync`, development) or in a worker process reading a shared queue.
+ *
+ * The payload carries the name and address rather than a user id: it is the
+ * account as it was registered, so the message still goes out unchanged if
+ * the record is edited (or removed) between dispatch and delivery.
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  // Pinned so queued messages survive a class rename and the identifier
+  // mangling of a production bundle — the worker resolves the class by name.
+  static override jobName = 'SendWelcomeEmail'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ name, email }: SendWelcomeEmailJobPayload): Promise<void> {
+    // Resolved when the job runs, not when it was dispatched: the worker can
+    // be a different process from the one that queued the message.
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured — MailProvider.boot() installs it with setMailManager().')
+    }
+
+    const result = await new WelcomeMail(manager, name).to(email).send()
+
+    // Throwing hands the job back to the queue, which retries it up to
+    // maxAttempts before recording it as failed.
+    if (!result.success) {
+      throw new Error(result.error ?? `Failed to send the welcome email to ${email}.`)
+    }
+  }
+
+  async failed({ email }: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${email}:`, error.message)
+  }
+}
diff --git a/app/Mail/WelcomeMail.ts b/app/Mail/WelcomeMail.ts
