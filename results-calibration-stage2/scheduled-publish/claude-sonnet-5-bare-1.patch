+/**
+ * Restricts a query to what a viewer may see: posts with no date or a date that
+ * has passed, plus the viewer's own posts. Evaluated per query, so a scheduled
+ * post goes public as time passes with nothing to run.
+ */
+export function visibleTo<Q extends { where(callback: (q: any) => void): Q }>(query: Q, viewerId: number | null): Q {
+  const now = new Date().toISOString()
+  return query.where((q) => {
+    q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+    if (viewerId !== null) q.orWhere('authorId', viewerId)
+  })
+}
