+async function createUser(label: string): Promise<UserRecord> {
+  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+  return User.create({
+    name: `${label} ${suffix}`,
+    email: `${label}-${suffix}@example.com`,
+    password: 'secret-password',
+  })
+}
+
+type TokenRow = typeof apiTokens.$inferSelect
+
+async function readTokenRows(): Promise<TokenRow[]> {
+  const db = (await getDatabase()) as { select: () => { from: (table: typeof apiTokens) => Promise<TokenRow[]> } }
+  return db.select().from(apiTokens)
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  // A signed-in, CSRF-primed client that accepts JSON, like the acceptance run.
+  async function signedIn(user: UserRecord): Promise<TestApp> {
+    return (await http.actingAs(user).withCsrf('/profile')).json()
+  }
+
+  it('creates a named token for the signed-in user and shows it once', async () => {
+    const user = await createUser('token-owner')
+    const client = await signedIn(user)
+
+    const response = await client.post('/profile/tokens', { name: 'CI' })
+    response.assertCreated()
+
+    const created = await response.json<CreatedToken>()
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    expect(created.id.length).toBeGreaterThan(0)
+
+    // `{id}|{secret}`: the secret is random and comfortably longer than 16 characters.
+    const [publicPart, secret] = created.token.split('|')
+    expect(publicPart).toBe(created.id)
+    expect(secret?.length ?? 0).toBeGreaterThanOrEqual(16)
+
+    // Only something derived from the token is stored — never the secret itself.
+    const row = (await readTokenRows()).find((candidate) => candidate.id === created.id)
+    expect(row).toBeDefined()
+    expect(row?.userId).toBe(user.id)
+    for (const value of Object.values(row ?? {})) {
+      expect(String(value)).not.toContain(secret)
+      expect(String(value)).not.toBe(created.token)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name with 422 and creates nothing', async () => {
+    const user = await createUser('token-validation')
+    const client = await signedIn(user)
+    const before = (await readTokenRows()).length
+
+    await client.post('/profile/tokens', {}).assertStatus(422)
+    await client.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await client.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+
+    expect((await readTokenRows()).length).toBe(before)
+  })
+
+  it('does not hand a guest a token', async () => {
+    const client = (await http.withCsrf('/login')).json()
+    const response = await client.post('/profile/tokens', { name: 'CI' })
+    expect([302, 303, 401]).toContain(response.status)
+    if (response.status !== 401) {
+      expect(response.headers.get('location')).toContain('/login')
+    }
+  })
+
+  it('lists the owner tokens by name on the profile page', async () => {
+    const user = await createUser('token-lister')
+    const client = await signedIn(user)
+    await client.post('/profile/tokens', { name: 'old laptop' }).assertCreated()
+
+    const page = await client.withHeader('X-Inertia', 'true').get('/profile')
+    page.assertOk()
+    const payload = await page.json<{ props: { tokens: Array<{ id: string; name: string }> } }>()
+    expect(payload.props.tokens.map((token) => token.name)).toEqual(['old laptop'])
+    // The page never sees the token or its hash.
+    const serialized = JSON.stringify(payload.props.tokens)
+    expect(serialized).not.toContain('hashedToken')
+    expect(serialized).not.toContain('"token"')
+  })
+
+  it('revokes the owner token with 204 and answers 404 for another user token', async () => {
+    const owner = await createUser('token-revoker')
+    const other = await createUser('token-bystander')
+    const ownerClient = await signedIn(owner)
+    const otherClient = await signedIn(other)
+
+    const mine = await ownerClient.post('/profile/tokens', { name: 'mine' }).then((r) => r.json<CreatedToken>())
+    const theirs = await otherClient.post('/profile/tokens', { name: 'theirs' }).then((r) => r.json<CreatedToken>())
+
+    // Another user's id: 404, and that token keeps working.
+    await ownerClient.delete(`/profile/tokens/${theirs.id}`).assertNotFound()
+    await http.json().withHeader('Authorization', `Bearer ${theirs.token}`).get('/api/posts').assertOk()
+
+    // Own id: 204, and the token stops working at once.
+    await ownerClient.delete(`/profile/tokens/${mine.id}`).assertNoContent()
+    await http.json().withHeader('Authorization', `Bearer ${mine.token}`).get('/api/posts').assertStatus(401)
+
+    // Revoking twice is a 404: the row is gone.
+    await ownerClient.delete(`/profile/tokens/${mine.id}`).assertNotFound()
+  })
+})
