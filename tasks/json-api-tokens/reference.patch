+import { Resource } from '@guren/core'
+import type { PostRecord as ApiPostSource } from '../../Models/Post.js'
+
+export interface ApiPostData extends Record<string, unknown> {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+export class ApiPostResource extends Resource<ApiPostSource, ApiPostData> {
+  toArray(): ApiPostData {
+    const post = this.resource
+
+    return {
+      id: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      authorId: post.authorId,
+      createdAt: new Date(post.createdAt).toISOString(),
+    }
+  }
+}
