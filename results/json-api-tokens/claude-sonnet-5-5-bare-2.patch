diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..a7b98be
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,85 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { getDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+const unique = () => `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    owner = await User.create({ name: 'Owner', email: `owner-${unique()}@example.com`, password: 'password123' })
+    other = await User.create({ name: 'Other', email: `other-${unique()}@example.com`, password: 'password123' })
+  })
+
+  const createToken = async (user: unknown, name = 'CI') => {
+    const response = await (await session(user)).post('/profile/tokens', { name }).assertCreated()
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+  const session = async (user: unknown) => (await http.actingAs(user).withCsrf()).json()
+  const api = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('creates a token, stores only a hash, and authenticates with it', async () => {
+    const created = await createToken(owner)
+    expect(created.token.split('|')[1]!.length).toBeGreaterThanOrEqual(16)
+
+    const db = (await getDatabase()) as { select(): { from(table: unknown): Promise<unknown[]> } }
+    const rows = await db.select().from(apiTokens)
+    const secret = created.token.split('|')[1]!
+    expect(JSON.stringify(rows)).not.toContain(secret)
+
+    const res = await api(created.token).get('/api/posts')
+    res.assertOk()
+  })
+
+  it('rejects bad names', async () => {
+    for (const name of ['', 'x'.repeat(51)]) {
+      await (await session(owner)).post('/profile/tokens', { name }).assertUnprocessable()
+    }
+  })
+
+  it('creates posts as the token owner and validates input', async () => {
+    const { token } = await createToken(owner)
+    const res = await api(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: other.id as number }).assertCreated()
+    const body = (await res.json()) as { data: { id: number; authorId: number } }
+    expect(body.data.authorId).toBe(owner.id as number)
+    expect((await Post.findOrFail(body.data.id)).authorId).toBe(owner.id as number)
+
+    await api(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+  })
+
+  it('answers 401 for missing, tampered and revoked tokens; 404 for foreign ids', async () => {
+    await http.json().get('/api/posts').assertUnauthorized()
+    const created = await createToken(owner)
+    await api(`${created.token}x`).get('/api/posts').assertUnauthorized()
+
+    await (await session(other)).delete(`/profile/tokens/${created.id}`).assertNotFound()
+    await api(created.token).get('/api/posts').assertOk()
+
+    await (await session(owner)).delete(`/profile/tokens/${created.id}`).assertNoContent()
+    await api(created.token).get('/api/posts').assertUnauthorized()
+  })
+
+  it('rate limits per token', async () => {
+    const a = await createToken(owner, 'a')
+    const b = await createToken(owner, 'b')
+    for (let i = 0; i < 60; i++) {
+      await api(a.token).get('/api/posts').assertOk()
+    }
+    const limited = await api(a.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retry = Number(limited.headers.get('Retry-After'))
+    expect(retry).toBeGreaterThan(0)
+    expect(retry).toBeLessThanOrEqual(60)
+    await api(b.token).get('/api/posts').assertOk()
+  })
+})
