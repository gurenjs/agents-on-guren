diff --git a/tests/Mcp.test.ts b/tests/Mcp.test.ts
new file mode 100644
index 0000000..cf6d2e6
--- /dev/null
+++ b/tests/Mcp.test.ts
@@ -0,0 +1,85 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The App MCP endpoint serves the routes that declare `.agent()`, bearer-only,
+// acting as the token's user.
+describe('/mcp', () => {
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    await app.boot()
+    const user = await User.forceCreate({
+      name: 'Agent Author',
+      email: `agent-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    userId = Number(user!.id)
+    const store = app.auth.getApiTokenStore()!
+    bearer = (await createApiToken(store, { name: 'test', userId, abilities: ['tools:*'] })).plainTextToken
+  })
+
+  async function rpc(method: string, params: unknown, token: string | null = bearer) {
+    const response = await app.fetch(
+      new Request('http://localhost:3333/mcp', {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          accept: 'application/json, text/event-stream',
+          ...(token ? { authorization: `Bearer ${token}` } : {}),
+        },
+        body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+      }),
+    )
+    return response
+  }
+
+  async function result(method: string, params: unknown) {
+    const response = await rpc(method, params)
+    const text = await response.text()
+    const line = text.startsWith('{') ? text : text.split('\n').find((l) => l.startsWith('data:'))!.slice(5)
+    return JSON.parse(line).result
+  }
+
+  it('refuses a call without a credential', async () => {
+    expect((await rpc('tools/list', {}, null)).status).toBe(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
+    const { tools } = await result('tools/list', {})
+    const own = tools.filter((t: { name: string }) => !t.name.startsWith('guren_'))
+    expect(own.map((t: { name: string }) => t.name).sort()).toEqual(['posts_search', 'posts_store'])
+    const flag = (name: string) => own.find((t: { name: string }) => t.name === name).annotations?.readOnlyHint
+    expect(flag('posts_search')).toBe(true)
+    expect(flag('posts_store')).not.toBe(true)
+  })
+
+  it('creates a post as the calling user and finds it again', async () => {
+    const title = `MCP post ${Date.now()}`
+    const created = await result('tools/call', {
+      name: 'posts_store',
+      arguments: { title, excerpt: 'An excerpt', body: 'A body', authorId: 999999 },
+    })
+    expect(created.isError).toBeFalsy()
+    const posts = await Post.newQuery().where('title', title).get()
+    expect(posts.length).toBe(1)
+    expect(Number(posts[0]!.authorId)).toBe(userId)
+
+    const found = await result('tools/call', { name: 'posts_search', arguments: { keywords: [title] } })
+    expect(JSON.stringify(found)).toContain(title)
+  })
+
+  it('rejects invalid input with a 422 and creates nothing', async () => {
+    const before = (await Post.newQuery().get()).length
+    const res = await result('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'x', body: 'y' },
+    })
+    expect(res.isError).toBe(true)
+    expect(JSON.stringify(res)).toContain('Title is required.')
+    expect((await Post.newQuery().get()).length).toBe(before)
+  })
+})
