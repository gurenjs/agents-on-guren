@@ -0,0 +1,96 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { closeDatabase, configureOrm } from '../config/database.js'
+import { createAppHealthManager } from '../config/health.js'
+import app from '../src/app.js'
+
+describe('health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('reports the database as healthy when the probe query succeeds', async () => {
+    const response = await http.get('/health').assertOk()
+    const body = await response.json<{
+      status: string
+      checks: Array<{ name: string; status: string }>
+    }>()
+
+    expect(body.status).toBe('healthy')
+    expect(body.checks).toContainEqual(expect.objectContaining({ name: 'database', status: 'healthy' }))
+  })
+
+  it('touches the database on every probe rather than caching the verdict', async () => {
+    let queries = 0
+    const manager = createAppHealthManager({
+      async query() {
+        queries += 1
+        return null
+      },
+    })
+
+    await manager.check()
+    await manager.check()
+
+    expect(queries).toBe(2)
+  })
+
+  it('reports unhealthy when the database query throws', async () => {
+    const manager = createAppHealthManager({
+      query() {
+        return Promise.reject(new Error('unable to open database file'))
+      },
+    })
+
+    const report = await manager.check()
+
+    expect(report.status).toBe('unhealthy')
+    expect(report.checks[0]).toMatchObject({ name: 'database', status: 'unhealthy' })
+  })
+
+  it('reports unhealthy when the database query never settles', async () => {
+    const manager = createAppHealthManager(
+      {
+        query() {
+          return new Promise<unknown>(() => {})
+        },
+      },
+      50,
+    )
+
+    const report = await manager.check()
+
+    expect(report.status).toBe('unhealthy')
+  })
+
+  // The whole point of the change: a deploy whose database cannot even be
+  // opened must fall out of the load balancer pool, so drop the connection and
+  // point it at a path SQLite cannot create.
+  it('answers 503 when the database connection cannot be opened', async () => {
+    const previous = process.env.TEST_DATABASE_URL
+    await closeDatabase()
+    process.env.TEST_DATABASE_URL = '/dev/null/unopenable/guren.db'
+
+    try {
+      const response = await http.get('/health').assertStatus(503)
+      const body = await response.json<{
+        status: string
+        checks: Array<{ name: string; status: string }>
+      }>()
+
+      expect(body.status).toBe('unhealthy')
+      expect(body.checks).toContainEqual(expect.objectContaining({ name: 'database', status: 'unhealthy' }))
+    } finally {
+      if (previous === undefined) {
+        delete process.env.TEST_DATABASE_URL
+      } else {
+        process.env.TEST_DATABASE_URL = previous
+      }
+      await closeDatabase()
+      // Rebind the ORM to the reopened handle for whatever runs next.
+      await configureOrm()
+    }
+  })
+})
