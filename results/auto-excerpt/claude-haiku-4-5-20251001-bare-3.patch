@@ -0,0 +1,36 @@
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+
+  // If body is 140 characters or fewer, use the whole body
+  if (trimmed.length <= 140) {
+    return trimmed
+  }
+
+  // Take the first 140 characters
+  let text = trimmed.substring(0, 140)
+
+  // Check if character 141 exists and is non-whitespace
+  const char141 = trimmed[140]
+  const char140 = trimmed[139]
+
+  // If both character 140 and 141 are non-whitespace, we need to cut at the last whitespace
+  if (char140 && !/\s/.test(char140) && char141 && !/\s/.test(char141)) {
+    // Find the last whitespace position in the first 140 characters
+    let lastSpaceIndex = -1
+    for (let i = text.length - 1; i >= 0; i--) {
+      if (/\s/.test(text[i])) {
+        lastSpaceIndex = i
+        break
+      }
+    }
+
+    if (lastSpaceIndex !== -1) {
+      // Cut at the last whitespace
+      text = text.substring(0, lastSpaceIndex)
+    }
+    // If no whitespace found in first 140 chars, keep all 140
+  }
+
+  // Trim trailing whitespace and append ellipsis
+  return text.trimEnd() + '…'
+}
