+++ b/tests/LoginController.test.ts
@@ -0,0 +1,65 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// Regression coverage for the open-redirect report: `redirect` must only be
+// honored when it is a same-app path. Absolute URLs, protocol-relative URLs,
+// and backslash variants are all attacker-controlled ways to leave the site
+// from a link that otherwise starts on our own domain.
+describe('login.store redirect handling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-horse' })
+  })
+
+  it('redirects to a same-app path passed via redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-horse', redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('falls back to the default destination with no redirect value', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-horse' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores an absolute URL redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-horse', redirect: 'https://evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a protocol-relative redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-horse', redirect: '//evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('ignores a backslash-variant redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'correct-horse', redirect: '/\\evil.example' })
+      .assertRedirect('/dashboard')
+  })
+
+  it('still rejects a wrong password even with a malicious redirect', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', { email: 'ada@example.com', password: 'wrong-password', redirect: 'https://evil.example' })
+      .assertUnprocessable()
+  })
+})
