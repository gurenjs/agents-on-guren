+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,354 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Feature tests against the test database (data/guren.test.db, migrated when
+// the app boots). The file is shared with whatever else runs under
+// NODE_ENV=test, so every row carries a token unique to this run and is
+// deleted afterwards — a scheduled post left behind would show up in someone
+// else's `posts:scheduled` report.
+const RUN = `sched${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`
+
+const HOUR = 60 * 60 * 1000
+const future = (hours = 1) => new Date(Date.now() + hours * HOUR).toISOString()
+const past = (hours = 1) => new Date(Date.now() - hours * HOUR).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  // Carries the session and XSRF token a browser would, for requests that write.
+  let form: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let scheduled: PostRecord
+  let immediate: PostRecord
+
+  async function createUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name}-${RUN}@example.test`, password: 'secret-password' })
+  }
+
+  async function createPost(title: string, publishedAt: string | null, authorId = author.id): Promise<PostRecord> {
+    return Post.forceCreate({
+      title: `${title} ${RUN}`,
+      excerpt: `Excerpt of ${title}`,
+      body: `Body of ${title}`,
+      authorId,
+      publishedAt,
+    })
+  }
+
+  async function ownPosts(): Promise<PostRecord[]> {
+    return Post.where('authorId', author.id).orderBy('id', 'asc').get()
+  }
+
+  async function inertiaProps<TProps>(client: TestApp, path: string): Promise<TProps> {
+    const response = await client.get(path).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    return payload.props as TProps
+  }
+
+  // Newest first and ten to a page, so this run's posts are on page one as
+  // long as nothing else writes to the test database meanwhile.
+  async function listedIds(client: TestApp): Promise<number[]> {
+    const { data } = await inertiaProps<{ data: PostResourceData[] }>(client, '/posts')
+    return data.map((post) => post.id)
+  }
+
+  async function searchedIds(client: TestApp): Promise<number[]> {
+    const response = await client.query('/posts/search', { keywords: [RUN], limit: 50 }).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+    return data.map((post) => post.id)
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    form = await http.withCsrf()
+    author = await createUser('author')
+    stranger = await createUser('stranger')
+    scheduled = await createPost('Launch announcement', future())
+    immediate = await createPost('Already out', null)
+  })
+
+  afterAll(async () => {
+    for (const user of [author, stranger]) {
+      if (user) {
+        await Post.delete({ authorId: user.id })
+        await User.delete({ id: user.id })
+      }
+    }
+  })
+
+  describe('the post page', () => {
+    it('does not exist for a guest', async () => {
+      await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('does not exist for another signed-in user', async () => {
+      await http.actingAs(stranger).get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('opens for its author, with the time it goes live', async () => {
+      const { post } = await inertiaProps<{ post: PostResourceData }>(http.actingAs(author), `/posts/${scheduled.id}`)
+
+      expect(post.id).toBe(scheduled.id)
+      expect(post.publishedAt).toBe(scheduled.publishedAt)
+      expect(post.scheduled).toBe(true)
+    })
+
+    it('opens for everyone when the post has no publish time', async () => {
+      const { post } = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${immediate.id}`)
+
+      expect(post.publishedAt).toBeNull()
+      expect(post.scheduled).toBe(false)
+    })
+  })
+
+  describe('the posts list', () => {
+    it('leaves a scheduled post out for a guest', async () => {
+      const ids = await listedIds(http)
+
+      expect(ids).toContain(immediate.id)
+      expect(ids).not.toContain(scheduled.id)
+    })
+
+    it('leaves a scheduled post out for another signed-in user', async () => {
+      const ids = await listedIds(http.actingAs(stranger))
+
+      expect(ids).toContain(immediate.id)
+      expect(ids).not.toContain(scheduled.id)
+    })
+
+    it('shows the author their own scheduled post and its date', async () => {
+      const { data } = await inertiaProps<{ data: PostResourceData[] }>(http.actingAs(author), '/posts')
+      const listed = data.find((post) => post.id === scheduled.id)
+
+      expect(listed?.publishedAt).toBe(scheduled.publishedAt)
+      expect(listed?.scheduled).toBe(true)
+    })
+
+    it('does not show an author the scheduled posts of someone else', async () => {
+      const theirs = await createPost('Not yours', future(), stranger.id)
+
+      expect(await listedIds(http.actingAs(author))).not.toContain(theirs.id)
+    })
+  })
+
+  describe('search', () => {
+    it('does not find a scheduled post for a guest', async () => {
+      const ids = await searchedIds(http)
+
+      expect(ids).toContain(immediate.id)
+      expect(ids).not.toContain(scheduled.id)
+    })
+
+    it('does not find a scheduled post for another signed-in user', async () => {
+      const ids = await searchedIds(http.actingAs(stranger))
+
+      expect(ids).toContain(immediate.id)
+      expect(ids).not.toContain(scheduled.id)
+    })
+  })
+
+  describe('the home page', () => {
+    it('never lists a scheduled post', async () => {
+      const { latest } = await inertiaProps<{ latest: PostResourceData[] }>(http.actingAs(author), '/')
+
+      expect(latest.map((post) => post.id)).not.toContain(scheduled.id)
+    })
+  })
+
+  describe('managing a scheduled post', () => {
+    const payload = { title: `Hijacked ${RUN}`, excerpt: 'Excerpt', body: 'Body' }
+
+    it('answers 404, not 403, to anyone but its author', async () => {
+      const other = form.actingAs(stranger)
+
+      await other.get(`/posts/${scheduled.id}/edit`).assertNotFound()
+      await other.put(`/posts/${scheduled.id}`, payload).assertNotFound()
+      await other.delete(`/posts/${scheduled.id}`).assertNotFound()
+
+      expect((await Post.findOrFail(scheduled.id)).title).toBe(scheduled.title)
+    })
+
+    it('still answers 403 for a post the viewer can see', async () => {
+      await form.actingAs(stranger).put(`/posts/${immediate.id}`, payload).assertForbidden()
+    })
+
+    it('opens the edit form for its author', async () => {
+      const { post } = await inertiaProps<{ post: PostResourceData }>(
+        http.actingAs(author),
+        `/posts/${scheduled.id}/edit`,
+      )
+
+      expect(post.publishedAt).toBe(scheduled.publishedAt)
+    })
+  })
+
+  describe('once the time has passed', () => {
+    it('is public everywhere with nothing else having run', async () => {
+      const post = await createPost('Goes live', future())
+      await http.get(`/posts/${post.id}`).assertNotFound()
+
+      const publishedAt = past()
+      await Post.forceUpdate({ id: post.id }, { publishedAt })
+
+      const shown = await inertiaProps<{ post: PostResourceData }>(http, `/posts/${post.id}`)
+      expect(shown.post.publishedAt).toBe(publishedAt)
+      expect(shown.post.scheduled).toBe(false)
+      expect(await listedIds(http)).toContain(post.id)
+      expect(await searchedIds(http.actingAs(stranger))).toContain(post.id)
+    })
+  })
+
+  describe('the publishAt field', () => {
+    const fields = (title: string) => ({ title: `${title} ${RUN}`, excerpt: 'Excerpt', body: 'Body' })
+
+    async function createdBy(title: string): Promise<PostRecord> {
+      const post = (await ownPosts()).find((candidate) => candidate.title === `${title} ${RUN}`)
+      if (!post) {
+        throw new Error(`No post titled "${title}" was saved`)
+      }
+      return post
+    }
+
+    it('schedules a new post', async () => {
+      const publishAt = '2126-10-01T09:00:00.000Z'
+      await form.actingAs(author).post('/posts', { ...fields('Created scheduled'), publishAt }).assertRedirect()
+
+      const post = await createdBy('Created scheduled')
+      expect(post.publishedAt).toBe(publishAt)
+      await http.get(`/posts/${post.id}`).assertNotFound()
+    })
+
+    it('stores any offset as the same instant in UTC', async () => {
+      await form
+        .actingAs(author)
+        .post('/posts', { ...fields('Created with offset'), publishAt: '2126-10-01T18:00:00+09:00' })
+        .assertRedirect()
+
+      expect((await createdBy('Created with offset')).publishedAt).toBe('2126-10-01T09:00:00.000Z')
+    })
+
+    it('publishes a new post at once when it is absent or null', async () => {
+      await form.actingAs(author).post('/posts', fields('Created absent')).assertRedirect()
+      await form.actingAs(author).post('/posts', { ...fields('Created null'), publishAt: null }).assertRedirect()
+
+      for (const title of ['Created absent', 'Created null']) {
+        const post = await createdBy(title)
+        expect(post.publishedAt).toBeNull()
+        await http.get(`/posts/${post.id}`).assertOk()
+      }
+    })
+
+    it('rejects a value that is not a date and time, the way an empty title is rejected', async () => {
+      const before = (await ownPosts()).length
+      const client = form.actingAs(author)
+
+      await client.post('/posts', { ...fields('Rejected'), title: '' }).assertUnprocessable()
+      for (const publishAt of ['next tuesday', '2126-10-01', '2126-10-01T09:00', '', 1_800_000_000_000]) {
+        const rejected = await client.post('/posts', { ...fields('Rejected'), publishAt }).assertUnprocessable()
+        const { errors } = await rejected.json<{ errors: Record<string, string[]> }>()
+        expect(Object.keys(errors)).toEqual(['publishAt'])
+      }
+
+      expect((await ownPosts()).length).toBe(before)
+    })
+
+    it('sets, changes and clears the date on an existing post', async () => {
+      const post = await createPost('Edited', null)
+      const client = form.actingAs(author)
+      const stored = async () => (await Post.findOrFail(post.id)).publishedAt
+
+      await client.put(`/posts/${post.id}`, { ...fields('Edited'), publishAt: '2126-10-01T09:00:00.000Z' }).assertRedirect()
+      expect(await stored()).toBe('2126-10-01T09:00:00.000Z')
+      await http.get(`/posts/${post.id}`).assertNotFound()
+
+      await client.put(`/posts/${post.id}`, { ...fields('Edited'), publishAt: '2126-11-15T12:30:00.000Z' }).assertRedirect()
+      expect(await stored()).toBe('2126-11-15T12:30:00.000Z')
+
+      await client.put(`/posts/${post.id}`, { ...fields('Edited'), publishAt: null }).assertRedirect()
+      expect(await stored()).toBeNull()
+      await http.get(`/posts/${post.id}`).assertOk()
+    })
+
+    it('rejects a bad date on an edit and keeps what was stored', async () => {
+      const client = form.actingAs(author)
+
+      await client
+        .put(`/posts/${scheduled.id}`, { ...fields('Overwritten'), publishAt: 'next tuesday' })
+        .assertUnprocessable()
+
+      const post = await Post.findOrFail(scheduled.id)
+      expect(post.title).toBe(scheduled.title)
+      expect(post.publishedAt).toBe(scheduled.publishedAt)
+    })
+  })
+
+  describe('bun run console posts:scheduled', () => {
+    async function report(readAfterMs = 0): Promise<{ exitCode: number; lines: string[] }> {
+      const child = Bun.spawn(['bun', 'run', 'console', 'posts:scheduled'], {
+        cwd: new URL('..', import.meta.url).pathname,
+        env: { ...process.env, NODE_ENV: 'test' },
+        stdout: 'pipe',
+        stderr: 'ignore',
+      })
+      await Bun.sleep(readAfterMs)
+      const stdout = await new Response(child.stdout).text()
+
+      return { exitCode: await child.exited, lines: stdout.split('\n').filter((line) => line !== '') }
+    }
+
+    it('prints one tab-separated line per scheduled post, soonest first, and nothing else', async () => {
+      // Deleted before the run ends, like every other row of this file.
+      const reporter = await createUser('reporter')
+      try {
