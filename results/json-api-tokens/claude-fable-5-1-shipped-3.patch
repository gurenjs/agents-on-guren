+import { expect } from 'bun:test'
+import type { TestApp } from '@guren/testing'
+import { User, type UserRecord } from '../../app/Models/User.js'
+
+export interface IssuedToken {
+  id: string
+  name: string
+  token: string
+}
+
+export async function createUser(email: string): Promise<UserRecord> {
+  return User.create({ name: email.split('@')[0] ?? email, email, password: 'password123' })
+}
+
+/** Issues a token the way the profile page does: signed in, CSRF primed. */
+export async function issueToken(http: TestApp, user: UserRecord, name = 'CI'): Promise<IssuedToken> {
+  const session = await http.actingAs(user).json().withCsrf()
+  const response = await session.post('/profile/tokens', { name })
+  expect(response.status).toBe(201)
+  return response.json<IssuedToken>()
+}
+
+/** A client carrying only the bearer header, like a script would. */
+export function withToken(http: TestApp, token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
