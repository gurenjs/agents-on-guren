diff --git a/tests/PostArchive.test.ts b/tests/PostArchive.test.ts
new file mode 100644
index 0000000..72735a7
--- /dev/null
+++ b/tests/PostArchive.test.ts
@@ -0,0 +1,83 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The archive is served by two routes (/posts/archive/:year and
+// /posts/archive/:year/:month) that share one controller action, so both URL
+// shapes are exercised here. Fixtures sit in 2019 so they cannot collide with
+// posts created "now", and set `created_at` explicitly — the stored ISO
+// timestamp is what the period filter matches, in UTC.
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    const author = await User.create({
+      name: 'Archive Author',
+      email: 'archive@example.com',
+      password: 'secret',
+    })
+
+    const fixtures: Array<[string, string]> = [
+      ['July 2019', '2019-07-31T23:00:00.000Z'],
+      ['August 2019, early', '2019-08-01T00:00:00.000Z'],
+      ['August 2019, late', '2019-08-31T23:59:59.000Z'],
+      ['September 2019', '2019-09-01T12:00:00.000Z'],
+      ['August 2018', '2018-08-15T12:00:00.000Z'],
+    ]
+
+    for (const [title, createdAt] of fixtures) {
+      // forceCreate: `createdAt` and `authorId` are deliberately not fillable.
+      await Post.forceCreate({
+        title,
+        excerpt: `${title} excerpt`,
+        body: `${title} body`,
+        authorId: author?.id as number,
+        createdAt,
+      })
+    }
+  })
+
+  async function titles(path: string): Promise<string[]> {
+    const res = await http.get(path).assertOk()
+    const body = await res.json<{ data: Array<{ id: number; title: string }> }>()
+
+    return body.data.map((post) => post.title)
+  }
+
+  it('lists the posts of a month, newest first', async () => {
+    expect(await titles('/posts/archive/2019/08')).toEqual(['August 2019, late', 'August 2019, early'])
+  })
+
+  it('accepts a month written without a leading zero', async () => {
+    expect(await titles('/posts/archive/2019/8')).toEqual(['August 2019, late', 'August 2019, early'])
+  })
+
+  it('lists every post of a year', async () => {
+    expect(await titles('/posts/archive/2019')).toEqual([
+      'September 2019',
+      'August 2019, late',
+      'August 2019, early',
+      'July 2019',
+    ])
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/1999').assertOk().assertJson({ data: [] })
+    await http.get('/posts/archive/2019/03').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2019/13').assertStatus(422)
+    await http.get('/posts/archive/2019/00').assertStatus(422)
+  })
+
+  it('rejects a malformed year', async () => {
+    await http.get('/posts/archive/20xx').assertStatus(422)
+  })
+})
