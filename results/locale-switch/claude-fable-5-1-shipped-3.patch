diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..f85216a
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,21 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+// The `locale` cookie is what detectLocaleMiddleware reads ahead of
+// Accept-Language, so storing the pick there is the whole switch.
+const LOCALE_COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = this.validated('locale.store').body
+
+    const referer = this.request.header('referer')
+    const backTo = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    const response = this.redirect(backTo)
+    response.headers.append(
+      'Set-Cookie',
+      `locale=${locale}; Path=/; Max-Age=${LOCALE_COOKIE_MAX_AGE_SECONDS}; SameSite=Lax`,
+    )
+    return response
+  }
+}
