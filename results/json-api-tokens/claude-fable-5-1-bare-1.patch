diff --git a/app/Http/Controllers/Api/ApiPostController.ts b/app/Http/Controllers/Api/ApiPostController.ts
new file mode 100644
index 0000000..aed232c
--- /dev/null
+++ b/app/Http/Controllers/Api/ApiPostController.ts
@@ -0,0 +1,33 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+/**
+ * The JSON posts API for scripts. Every route is bearer-authenticated and
+ * rate-limited per token in routes/api.ts, so by the time an action runs
+ * `this.auth.user()` is the token's owner. Named ApiPostController rather
+ * than PostController: `guren audit` keys its findings on the class name.
+ */
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      // Posts created in the same millisecond share a createdAt; ids still order them.
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // The schema strips any `authorId` the body carries, and forceCreate sets
+    // it from the token's owner — same rule as the web form.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.created({ data: new PostResource(post).toJSON() })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..7a07908
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,56 @@
+import {
+  Controller,
+  NotFoundHttpException,
+  createApiToken,
+  getUserApiTokens,
+  revokeApiToken,
+  type ApiTokenStore,
+} from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+/**
+ * Personal API tokens, managed from the profile page by their owner. Both
+ * actions sit behind the 'auth' middleware, so a guest is redirected to /login
+ * before reaching them.
+ */
+export default class ApiTokenController extends Controller {
+  private tokenStore(): ApiTokenStore {
+    const store = this.make('auth').getApiTokenStore()
+    if (!store) {
+      throw new Error('No API token store is configured. AuthProvider must call auth.useTokens().')
+    }
+    return store
+  }
+
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+
+    const { plainTextToken, token } = await createApiToken(this.tokenStore(), {
+      name,
+      userId: user.id,
+    })
+
+    // The only time the plain token leaves the server: the store keeps its
+    // SHA-256 and nothing else.
+    return this.created({ id: token.id, name: token.name, token: plainTextToken })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+    const store = this.tokenStore()
+
+    // Looked up through the owner's tokens rather than by id alone, so another
+    // user's token id answers 404 and stays valid.
+    const owned = (await getUserApiTokens(user.id, store)).some((token) => token.id === id)
+    if (!owned) {
+      throw new NotFoundHttpException('Token not found.')
+    }
+
+    await revokeApiToken(id, store)
+
+    return this.noContent()
+  }
+}
