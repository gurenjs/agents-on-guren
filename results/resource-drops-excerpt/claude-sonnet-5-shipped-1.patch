+
+describe('post excerpts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('is included in posts.index, posts.show, and posts.search responses', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })
+    const post = await Post.forceCreate({
+      title: 'Bees',
+      excerpt: 'Bees remember faces',
+      body: 'Bee body text.',
+      authorId: author.id,
+    })
+
+    await http
+      .withHeader('X-Inertia', 'true')
+      .get('/posts')
+      .assertJsonPath('props.data.0.excerpt', 'Bees remember faces')
+
+    await http
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${post.id}`)
+      .assertJsonPath('props.post.excerpt', 'Bees remember faces')
+
+    await http.query('/posts/search', { keywords: ['Bees'] }).assertJsonPath('data.0.excerpt', 'Bees remember faces')
+  })
+})
