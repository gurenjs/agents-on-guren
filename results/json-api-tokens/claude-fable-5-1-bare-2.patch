--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,23 @@
+import { Resource, type ApiToken } from '@guren/core'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// What the profile page lists. The hash stays out: nothing a page receives
+// should be derived from the secret.
+export class ApiTokenResource extends Resource<ApiToken, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: token.createdAt.toISOString(),
+      lastUsedAt: token.lastUsedAt ? token.lastUsedAt.toISOString() : null,
+    }
+  }
+}
