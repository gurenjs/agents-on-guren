          ],
          "expect": {
            "status": 303
          }
        },
        {
          "id": "AC-post-tags-3",
          "description": "The posts list filtered by ?tag=bun lists only posts carrying bun; another tag lists none.",
          "kind": "success",
          "actor": "guest",
          "route": "route.posts.index",
          "given": [
            "one post tagged bun",
            "one post without tags"
          ],
          "expect": {
            "status": 200,
            "inertia": "view.posts.index"
          }
        },
        {
          "id": "AC-post-tags-4",
          "description": "Six tags are rejected like an invalid title and nothing is saved.",
          "kind": "validation",
