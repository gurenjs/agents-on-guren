diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..e6ac238
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,66 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+async function createUser(email: string) {
+  return User.create({ name: 'Test Author', email, password: 'secret123' })
+}
+
+async function createPost(authorId: number, title: string, createdAt: string) {
+  return Post.forceCreate({ title, excerpt: 'excerpt', body: 'body', authorId, createdAt })
+}
+
+describe('dashboard', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('reports 0 posts and an empty list for a user with no posts', async () => {
+    const user = await createUser('empty@example.com')
+
+    await http
+      .actingAs(user)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', { postCount: 0, recentPosts: [] })
+  })
+
+  it('counts only the signed-in user posts and lists at most 5, newest first', async () => {
+    const user = await createUser('writer@example.com')
+    const other = await createUser('someone-else@example.com')
+
+    // Belongs to another user — must never show up, however recent.
+    await createPost(other.id, "Someone else's post", '2026-08-18T00:00:00.000Z')
+
+    const posts = []
+    for (let i = 0; i < 6; i++) {
+      posts.push(await createPost(user.id, `Post ${i}`, `2026-08-${10 + i}T00:00:00.000Z`))
+    }
+
+    await http
+      .actingAs(user)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', {
+        postCount: 6,
+        recentPosts: [
+          { id: posts[5]?.id, title: 'Post 5' },
+          { id: posts[4]?.id, title: 'Post 4' },
+          { id: posts[3]?.id, title: 'Post 3' },
+          { id: posts[2]?.id, title: 'Post 2' },
+          { id: posts[1]?.id, title: 'Post 1' },
+        ],
+      })
+  })
+})
