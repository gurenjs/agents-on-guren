@@ -0,0 +1,23 @@
+import { getMailManager, ServiceProvider, setMailManager } from '@guren/core'
+import { appMailManager } from '../../config/mail.js'
+
+/**
+ * Binds the mail manager configured in config/mail.ts — the framework's own
+ * provider would build an unconfigured one, with no transports and no sender.
+ *
+ * The same instance is published globally, because queued mail is sent outside
+ * a request, where there is no container to resolve it from.
+ */
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('mail', () => appMailManager())
+  }
+
+  boot(): void {
+    // A worker process — or a test pointing the app at a recording transport —
+    // may have installed its own manager already; leave it alone.
+    if (!getMailManager()) {
+      setMailManager(appMailManager())
+    }
+  }
+}
