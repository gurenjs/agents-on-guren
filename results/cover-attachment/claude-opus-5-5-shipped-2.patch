+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,51 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export const MAX_COVER_BYTES = 2 * 1024 * 1024
+
+// An untouched file input still submits an empty, nameless File.
+const CoverFileSchema = z.preprocess(
+  (value) => (value === '' || value === null || (value instanceof File && value.size === 0) ? undefined : value),
+  z
+    .instanceof(File, { message: 'The cover must be a PNG or JPEG image.' })
+    .refine((file) => file.size <= MAX_COVER_BYTES, 'The cover must be 2 MB or smaller.')
+    .optional(),
+).optional()
+
+export const StorePostSchema = PostPayloadSchema.extend({
+  cover: CoverFileSchema,
+})
+
+export const UpdatePostSchema = PostPayloadSchema.extend({
+  cover: CoverFileSchema,
+  // `1` is what a ticked checkbox sends in a multipart form.
+  removeCover: z.union([z.boolean(), z.enum(['0', '1', 'true', 'false', 'on'])]).optional(),
+})
+
+export type UpdatePostPayload = z.infer<typeof UpdatePostSchema>
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+function startsWith(bytes: Uint8Array, signature: number[]): boolean {
+  return bytes.length >= signature.length && signature.every((byte, index) => bytes[index] === byte)
+}
+
+/**
+ * Decides the cover's type from its magic bytes, never the client's declared
+ * MIME type, and returns a File carrying that type so the attachment row does.
+ */
+export async function toCoverImage(file: File): Promise<File> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const format = startsWith(bytes, PNG_SIGNATURE)
+    ? { type: 'image/png', extension: 'png' }
+    : startsWith(bytes, JPEG_SIGNATURE)
+      ? { type: 'image/jpeg', extension: 'jpg' }
+      : null
+  if (!format) {
+    throw new ValidationException({ cover: ['The cover must be a PNG or JPEG image.'] })
+  }
+
+  return new File([bytes], `cover.${format.extension}`, { type: format.type })
+}
