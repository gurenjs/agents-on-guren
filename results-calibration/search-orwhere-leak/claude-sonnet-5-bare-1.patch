+        excerpt: 'An unpublished post about zephyrquill.',
+        body: 'body',
+        authorId: author.id,
+        published: false,
+      })
+      decoy = await Post.forceCreate({
+        title: 'completely unrelated post',
+        excerpt: 'Shares no keyword with the search.',
+        body: 'body',
+        authorId: author.id,
+        published: true,
+      })
+    })
+
+    afterAll(async () => {
+      await Post.delete({ id: published.id })
+      await Post.delete({ id: unpublished.id })
+      await Post.delete({ id: decoy.id })
+    })
+
+    it('excludes unpublished posts from single-keyword results', async () => {
+      const res = await http.query('/posts/search', { keywords: ['zephyrquill'] }).assertOk()
+      const { data } = (await res.json()) as { data: PostRecord[] }
+      const ids = data.map((post) => post.id)
+
+      expect(ids).toContain(published.id)
+      expect(ids).not.toContain(unpublished.id)
+      expect(ids).not.toContain(decoy.id)
+    })
+
