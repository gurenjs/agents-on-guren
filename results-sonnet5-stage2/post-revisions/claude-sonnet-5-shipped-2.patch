@@ -0,0 +1,61 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User } from '../app/Models/User.js'
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  beforeEach(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    other = await User.create({ name: 'B', email: 'b@example.com', password: 'secret-pass-1' })
+  })
+
+  const edit = async (id: number, title: string) => {
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf.put(`/posts/${id}`, { title, excerpt: 'x', body: 'y' }).assertRedirect(`/posts/${id}`)
+  }
+
+  it('keeps the previous version on edit and restores it', async () => {
+    const post = await Post.forceCreate({ title: 'First', excerpt: 'x', body: 'y', authorId: Number(author!.id) })
+    await edit(post!.id, 'Second')
+    await edit(post!.id, 'Third')
+
+    const rows = await PostRevision.where({ postId: post!.id }).orderBy('id', 'desc').get()
+    expect(rows.map((r) => r.title)).toEqual(['Second', 'First'])
+
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf.post(`/posts/${post!.id}/revisions/${rows[1]!.id}/restore`).assertRedirect(`/posts/${post!.id}`)
+
+    expect((await Post.findOrFail(post!.id)).title).toBe('First')
+    const after = await PostRevision.where({ postId: post!.id }).orderBy('id', 'desc').get()
+    expect(after.map((r) => r.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users, guests and foreign revisions', async () => {
+    const post = await Post.forceCreate({ title: 'P', excerpt: 'x', body: 'y', authorId: Number(author!.id) })
+    const twin = await Post.forceCreate({ title: 'T', excerpt: 'x', body: 'y', authorId: Number(author!.id) })
+    const rev = await PostRevision.keep(post!)
+
+    await http.actingAs(other as never).get(`/posts/${post!.id}/revisions`).assertForbidden()
+    await http.get(`/posts/${post!.id}/revisions`).assertRedirect('/login')
+
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf.post(`/posts/${twin!.id}/revisions/${rev!.id}/restore`).assertNotFound()
+  })
+
+  it('deletes history with the post', async () => {
+    const post = await Post.forceCreate({ title: 'P', excerpt: 'x', body: 'y', authorId: Number(author!.id) })
+    await PostRevision.keep(post!)
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf.delete(`/posts/${post!.id}`).assertRedirect('/posts')
+    expect((await PostRevision.where({ postId: post!.id }).get()).length).toBe(0)
+  })
+})
