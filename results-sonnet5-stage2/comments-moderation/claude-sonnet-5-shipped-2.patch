diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..d1edd6e
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment, CommentReport } from '../app/Models/Comment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Owner', email: 'o@example.com', password: 'secret-pass' })
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: Number(owner.id) })
+    postId = post!.id
+  })
+
+  async function as(user: typeof owner) {
+    return http.actingAs(user).withCsrf()
+  }
+
+  it('redirects guests and validates the body', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect('/login')
+    const authed = await as(owner)
+    await authed.json().post(`/posts/${postId}/comments`, { body: '' }).assertUnprocessable()
+    await authed.json().post(`/posts/${postId}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect((await Comment.all()).length).toBe(0)
+  })
+
+  it('stores, deletes, reports and hides', async () => {
+    const other = await User.create({ name: 'Other', email: 'x@example.com', password: 'secret-pass' })
+    const third = await User.create({ name: 'Third', email: 't@example.com', password: 'secret-pass' })
+    const fourth = await User.create({ name: 'Fourth', email: 'f@example.com', password: 'secret-pass' })
+    await (await as(other)).post(`/posts/${postId}/comments`, { body: 'hello' }).assertRedirect(`/posts/${postId}`)
+    const [comment] = await Comment.all()
+    expect(comment.userId).toBe(other.id)
+
+    await (await as(third)).delete(`/comments/${comment.id}`).assertForbidden()
+    expect((await Comment.all()).length).toBe(1)
+
+    const reporter = await as(third)
+    await reporter.post(`/comments/${comment.id}/report`).assertNoContent()
+    await reporter.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await CommentReport.all()).length).toBe(1)
+    await (await as(fourth)).post(`/comments/${comment.id}/report`).assertNoContent()
+    await (await as(owner)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await CommentReport.all()).length).toBe(3)
+    expect((await Comment.all()).length).toBe(1)
+
+    await (await as(owner)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${postId}`)
+    expect((await Comment.all()).length).toBe(0)
+  })
+
+  it('removes comments with their post', async () => {
+    await (await as(owner)).post(`/posts/${postId}/comments`, { body: 'mine' }).assertRedirect(`/posts/${postId}`)
+    await (await as(owner)).delete(`/posts/${postId}`).assertRedirect('/posts')
+    expect((await Comment.all()).length).toBe(0)
+  })
+})
