+++ b/tests/CommentController.test.ts
@@ -0,0 +1,78 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeUser(name: string) {
+    return User.create({ name, email: `${name}@example.com`, password: 'secret-password' })
+  }
+
+  async function as(user: Awaited<ReturnType<typeof makeUser>>) {
+    return http.actingAs(user).withCsrf()
+  }
+
+  it('sends a guest to login and stores nothing', async () => {
+    const author = await makeUser('ann')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('rejects invalid bodies', async () => {
+    const author = await makeUser('ann')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    const client = await as(author)
+    await client.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await client.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('lets author or post author delete, but nobody else', async () => {
+    const owner = await makeUser('ann')
+    const reader = await makeUser('bob')
+    const other = await makeUser('cat')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner.id })
+    await (await as(reader)).post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect(`/posts/${post.id}`)
+    const [comment] = await Comment.all()
+
+    await (await as(other)).delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.all()).toHaveLength(1)
+    await (await as(owner)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('counts a report once and hides at three distinct reporters', async () => {
+    const owner = await makeUser('ann')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner.id })
+    const comment = await Comment.forceCreate({ postId: post.id, userId: owner.id, body: 'hi' })
+    const reporters = [await makeUser('b'), await makeUser('c'), await makeUser('d')]
+
+    const first = await as(reporters[0])
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.all()).toHaveLength(1)
+
+    await (await as(reporters[1])).post(`/comments/${comment.id}/report`).assertNoContent()
+    await (await as(reporters[2])).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await Comment.all()).toHaveLength(1)
+
+    const res = await http.actingAs(owner).get(`/posts/${post.id}`)
+    expect(await res.text()).toContain('"comments":[]')
+  })
+})
