+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('MCP /mcp endpoint', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects requests without credentials (401 or 403)', async () => {
+    // The /mcp endpoint rejects unauthenticated requests
+    await http.post('/mcp')
+      .assertStatus(403) // Guren framework returns 403 Forbidden for missing auth
+  })
+})
