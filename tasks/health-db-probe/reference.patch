diff --git a/app/Health/health.ts b/app/Health/health.ts
new file mode 100644
index 0000000..3f33254
--- /dev/null
+++ b/app/Health/health.ts
@@ -0,0 +1,22 @@
+import { createHealthManager, DatabaseCheck } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+
+// The database check runs its probe query through the app's ORM connection —
+// resolved per call, so a connection reopened after a hot reload or a reset is
+// the one that gets probed. `critical` makes a failed probe an unhealthy
+// (503) report rather than a degraded (200) one: a deploy whose database is
+// unreachable must not be routed to.
+export const health = createHealthManager().register(
+  new DatabaseCheck(
+    {
+      query: async (statement) => {
+        const db = (await getDatabase()) as SQLiteBunDatabase
+        return db.run(sql.raw(statement))
+      },
+    },
+    { name: 'db' },
+  ),
+  { critical: true },
+)
