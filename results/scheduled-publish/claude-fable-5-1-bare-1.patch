   }
+
+  /**
+   * Whether `post` is still waiting for its publish time. Compared as ISO 8601
+   * text, which is how `published_at` is stored, so no clock has to run when
+   * the time arrives: the same row simply stops matching.
+   */
+  static isScheduled(post: Pick<PostScheduleLike, 'publishedAt'>, now: Date = new Date()): boolean {
+    return post.publishedAt !== null && post.publishedAt > now.toISOString()
+  }
+
+  /** Public to everyone, or scheduled and being looked at by its author. */
+  static isVisibleTo(post: PostScheduleLike, viewerId: number | null, now: Date = new Date()): boolean {
+    return !Post.isScheduled(post, now) || viewerId === post.authorId
+  }
+
+  /**
+   * The posts `viewerId` may see: every public post, plus the viewer's own
+   * scheduled ones. Pass `null` for a guest. Further `where()` calls AND onto
+   * this group, so search keywords cannot widen it back open.
+   */
+  static visibleTo(viewerId: number | null, now: Date = new Date()): QueryBuilder<PostRecord> {
+    const cutoff = now.toISOString()
+
+    return this.newQuery().where((q) => {
+      q.whereNull('publishedAt').orWhere('publishedAt', '<=', cutoff)
+      if (viewerId !== null) {
+        q.orWhere('authorId', viewerId)
+      }
+    })
+  }
+
+  /** Posts whose publish time has not arrived yet, whoever wrote them. */
+  static scheduled(now: Date = new Date()): QueryBuilder<PostRecord> {
+    return this.newQuery().where('publishedAt', '>', now.toISOString())
+  }
 }
 
