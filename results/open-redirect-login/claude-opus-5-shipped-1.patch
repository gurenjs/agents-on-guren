@@ -0,0 +1,35 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+
+// The sign-in page carries a `redirect` value into its form so the user lands
+// back where they came from. Only same-app paths survive that trip — a value
+// aimed at another origin is dropped before it ever reaches the browser, so
+// /login?redirect=https://evil.example cannot be used as a phishing hop.
+// Signing in itself needs migrations and fixtures; the guard behind the
+// post-login redirect is covered directly in tests/Redirects.test.ts.
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // X-Inertia asks for the JSON page payload instead of the HTML shell,
+    // which is what assertInertia() reads.
+    http = (await TestApp.fromApp(app)).withHeader('X-Inertia', 'true')
+  })
+
+  it('passes a same-app redirect to the form', async () => {
+    await http
+      .get('/login?redirect=/posts/3/edit')
+      .assertOk()
+      .assertInertia('auth/Login', { redirect: '/posts/3/edit' })
+  })
+
+  it('drops a cross-origin redirect', async () => {
+    for (const value of ['https://evil.example', '//evil.example', '/\\evil.example']) {
+      await http
+        .get(`/login?redirect=${encodeURIComponent(value)}`)
+        .assertOk()
+        .assertInertia('auth/Login', { redirect: '' })
+    }
+  })
+})
