diff --git a/app/Utils/ExcerptDeriver.ts b/app/Utils/ExcerptDeriver.ts
new file mode 100644
index 0000000..2ca1cf1
--- /dev/null
+++ b/app/Utils/ExcerptDeriver.ts
@@ -0,0 +1,31 @@
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+
+  if (trimmed.length <= 140) {
+    return trimmed
+  }
+
+  // Body is longer than 140 characters
+  const first140 = trimmed.substring(0, 140)
+  const char141 = trimmed[140]
+
+  // Check if character 141 exists and if char 140 and 141 are both non-whitespace
+  if (char141 && /\S/.test(trimmed[139]) && /\S/.test(char141)) {
+    // We're cutting inside a word. Find the last whitespace before position 140
+    let cutPoint = 139
+    while (cutPoint >= 0 && /\S/.test(trimmed[cutPoint])) {
+      cutPoint--
+    }
+
+    if (cutPoint >= 0) {
+      // Found whitespace, trim trailing whitespace and add ellipsis
+      return trimmed.substring(0, cutPoint + 1).trimEnd() + '…'
+    }
+
+    // No whitespace found in first 140 chars, cut at 140
+    return first140 + '…'
+  }
+
+  // Character 141 is whitespace or doesn't exist, keep all 140 chars
+  return first140.trimEnd() + '…'
+}
