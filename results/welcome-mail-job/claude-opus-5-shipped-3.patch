+++ b/config/queue.ts
@@ -0,0 +1,36 @@
+import {
+  MemoryQueueDriver,
+  RedisQueueDriver,
+  SyncQueueDriver,
+  createQueueManager,
+  createRedisClient,
+  type QueueManager,
+} from '@guren/core'
+
+/**
+ * Which driver `QUEUE_CONNECTION` selects:
+ *
+ * - `sync` (development default) runs a dispatched job inline, right where it
+ *   was dispatched — no worker process, failures surface immediately.
+ * - `memory` holds jobs in this process until a worker pops them. Useful in
+ *   tests, where the dispatch and the work have to be observed separately.
+ * - `redis` is the production connection: `bunx guren queue:work` (or any
+ *   other worker process) drains what the web process pushed.
+ *
+ * Driver factories are lazy — only the selected connection is ever
+ * constructed, so an empty `REDIS_URL` in development costs nothing.
+ */
+function resolveQueueConnection(): string {
+  return process.env.QUEUE_CONNECTION?.trim() || 'sync'
+}
+
+export function createAppQueueManager(): QueueManager {
+  return createQueueManager({
+    default: resolveQueueConnection(),
+    drivers: {
+      sync: () => new SyncQueueDriver(),
+      memory: () => new MemoryQueueDriver(),
+      redis: () => new RedisQueueDriver(createRedisClient({ url: process.env.REDIS_URL })),
+    },
+  })
+}
