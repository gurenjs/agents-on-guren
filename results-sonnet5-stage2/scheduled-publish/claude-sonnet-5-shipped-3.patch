+++ b/app/Console/Commands/ScheduledPostsCommand.ts
@@ -0,0 +1,18 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled to publish in the future, soonest first'
+
+  async handle(): Promise<void> {
+    const now = Date.now()
+    const posts = (await Post.newQuery().whereNotNull('publishedAt').get())
+      .filter((post) => Date.parse(post.publishedAt as string) > now)
+      .sort((a, b) => Date.parse(a.publishedAt as string) - Date.parse(b.publishedAt as string))
+
+    for (const post of posts) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+  }
+}
