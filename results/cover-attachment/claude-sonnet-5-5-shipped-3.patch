diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..2bd57b0
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,80 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 9, 8, 7])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', cover)
+  return data
+}
+
+const fields = { title: 'Hello', excerpt: 'Short', body: 'Long body' }
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  async function authed() {
+    return http.actingAs(author as never).withCsrf()
+  }
+
+  it('stores, serves, replaces and removes a cover', async () => {
+    const client = await authed()
+    await client.post('/posts', form(fields, new File([PNG], 'c.png', { type: 'image/png' }))).assertRedirect()
+
+    const [post] = await Post.all()
+    const first = (await Attachment.all())[0]
+    const res = await http.get(`/attachments/${first.id}`)
+    expect(res.status).toBe(200)
+    expect(res.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await res.raw.arrayBuffer())).toEqual(PNG)
+
+    await client.put(`/posts/${post.id}`, form(fields, new File([JPEG], 'c.jpg', { type: 'image/jpeg' }))).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+    await http.get(`/attachments/${first.id}`).assertNotFound()
+
+    await client.put(`/posts/${post.id}`, form(fields)).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+
+    const kept = (await Attachment.all())[0]
+    await client.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+    await http.get(`/attachments/${kept.id}`).assertNotFound()
+    expect(existsSync(`storage/attachments/${kept.path}`)).toBe(false)
+  })
+
+  it('refuses a GIF and deletes the cover with the post', async () => {
+    const client = await authed()
+    await client
+      .json()
+      .post('/posts', form(fields, new File([GIF], 'c.gif', { type: 'image/gif' })))
+      .assertUnprocessable()
+    expect((await Post.all()).length).toBe(0)
+
+    await client.post('/posts', form(fields, new File([PNG], 'c.png', { type: 'image/png' }))).assertRedirect()
+    const [post] = await Post.all()
+    const attachment = (await Attachment.all())[0]
+    await client.delete(`/posts/${post.id}`).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+    expect(existsSync(`storage/attachments/${attachment.path}`)).toBe(false)
+  })
+})
