+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password123' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'password123' })
+  })
+
+  async function createPost(title: string): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+  }
+
+  async function edit(post: PostRecord, title: string) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return csrf.put(`/posts/${post.id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+  }
+
+  async function titles(postId: number): Promise<string[]> {
+    const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+    return rows.map((row) => row.title)
+  }
+
+  it('keeps the previous version on each successful edit, newest first', async () => {
+    const post = await createPost('First')
+    expect(await titles(post.id)).toEqual([])
+
+    ;(await edit(post, 'Second')).assertRedirect(`/posts/${post.id}`)
+    ;(await edit(post, 'Third')).assertRedirect(`/posts/${post.id}`)
+
+    expect(await titles(post.id)).toEqual(['Second', 'First'])
+    const [second, first] = await PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+    await http
+      .actingAs(author)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${post.id}/revisions`)
+      .assertOk()
+      .assertInertia('posts/Revisions', {
+        revisions: [
+          { id: second!.id, title: 'Second', createdAt: new Date(second!.createdAt).toISOString() },
+          { id: first!.id, title: 'First', createdAt: new Date(first!.createdAt).toISOString() },
+        ],
+      })
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const post = await createPost('First')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+
+    const intruder = await http.actingAs(other).withCsrf()
+    await intruder.put(`/posts/${post.id}`, { title: 'Hijack', excerpt: 'x', body: 'y' }).assertForbidden()
+
+    expect(await titles(post.id)).toEqual([])
+  })
+
+  it('restores a revision and keeps the replaced version', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+    const first = await PostRevision.first({ postId: post.id, title: 'First' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${first!.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await titles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and guests', async () => {
+    const post = await createPost('First')
+    await edit(post, 'Second')
+    const revision = await PostRevision.first({ postId: post.id })
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const intruder = await http.actingAs(other).withCsrf()
+    await intruder.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const guest = await http.withCsrf()
+    await guest.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await titles(post.id)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const post = await createPost('A1')
+    const otherPost = await createPost('B1')
+    await edit(otherPost, 'B2')
+    const foreign = await PostRevision.first({ postId: otherPost.id })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('A1')
+    expect(await titles(post.id)).toEqual([])
+  })
+
+  it('deletes the history with the post', async () => {
+    const post = await createPost('A1')
+    const keep = await createPost('B1')
+    await edit(post, 'A2')
+    await edit(keep, 'B2')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await titles(post.id)).toEqual([])
+    expect(await titles(keep.id)).toEqual(['B1'])
+  })
+})
