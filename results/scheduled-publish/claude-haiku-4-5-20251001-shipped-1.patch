+describe('Post scheduling', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    // Create a test user with unique email
+    const uniqueId = Date.now()
+    author = (await User.create({
+      name: 'Test Author',
+      email: `author-${uniqueId}@test.com`,
+      password: 'password123',
+    })) as UserRecord
+  })
+
+  it('creates a post that publishes immediately when no publishAt is provided', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', {
+        title: 'Published Post',
+        excerpt: 'This is published',
+        body: 'Published content',
+      })
+      .assertRedirect()
+
+    const saved = await Post.first({ title: 'Published Post' })
+    if (!saved || saved.publishedAt !== null) {
+      throw new Error('Post should be created with no publishedAt')
+    }
+  })
+
+  it('creates a scheduled post with publishAt', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const futureTime = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
+
+    await csrf
+      .post('/posts', {
+        title: 'Scheduled Post',
+        excerpt: 'This is scheduled',
+        body: 'Scheduled content',
+        publishAt: futureTime,
+      })
+      .assertRedirect()
+
+    const saved = await Post.first({ title: 'Scheduled Post' })
+    if (!saved) {
+      throw new Error('Post should be created')
+    }
+    if (!saved.publishedAt) {
+      throw new Error(`Post publishedAt should be set, got: ${saved.publishedAt}`)
+    }
+    // Check that it's a future time (approximately 24 hours from now)
+    const savedDate = new Date(saved.publishedAt)
+    const now = new Date()
+    const hoursDiff = (savedDate.getTime() - now.getTime()) / (1000 * 60 * 60)
+    if (hoursDiff < 23 || hoursDiff > 25) {
+      throw new Error(
+        `Post publishedAt should be approximately 24 hours in future, got ${hoursDiff.toFixed(2)} hours`
+      )
+    }
+  })
+
+  it('returns 404 for scheduled posts when accessed by guests', async () => {
+    const futureTime = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
+    const scheduledPost = await Post.forceCreate({
+      title: 'Hidden Post',
+      excerpt: 'Should be 404',
+      body: 'Content',
+      publishedAt: futureTime,
+      authorId: author.id,
+    })
+
+    await http.get(`/posts/${scheduledPost.id}`).assertNotFound()
+  })
+
+  it('returns 200 for scheduled posts when accessed by author', async () => {
+    const futureTime = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
+    const post = await Post.forceCreate({
+      title: 'Author Visible Post',
+      excerpt: 'Visible to author',
+      body: 'Content',
+      publishedAt: futureTime,
+      authorId: author.id,
+    })
+
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('hides scheduled posts from search for guests', async () => {
+    const futureTime = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
+    await Post.forceCreate({
+      title: 'Searchable Scheduled Post',
+      excerpt: 'Should not appear in search',
+      body: 'Content',
+      publishedAt: futureTime,
+      authorId: author.id,
+    })
+
+    const response = await http.query('/posts/search', {
+      keywords: ['Searchable'],
+      limit: 10,
+    })
+    await response.assertOk()
+    const body = (await response.json()) as unknown as { data: Array<{ title: string }> }
+    const found = body.data.find((p) => p.title === 'Searchable Scheduled Post')
+
+    if (found) {
+      throw new Error('Scheduled post should be hidden from guest search')
+    }
+  })
+
+  it('shows published posts to guests', async () => {
+    // Post with no publishedAt
+    await Post.forceCreate({
+      title: 'Published Post Guest View',
+      excerpt: 'Visible to all',
+      body: 'Content',
+      publishedAt: null,
+      authorId: author.id,
+    })
+
+    const response = await http.query('/posts/search', {
+      keywords: ['Published'],
+      limit: 10,
+    })
+    await response.assertOk()
+    const body = (await response.json()) as unknown as { data: Array<{ title: string }> }
+    const found = body.data.find((p) => p.title === 'Published Post Guest View')
+
+    if (!found) {
+      throw new Error('Published post should be visible in guest search')
+    }
+  })
+
+  it('shows posts with past publishedAt to guests', async () => {
+    const pastTime = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString()
+    await Post.forceCreate({
+      title: 'Past Published Post',
+      excerpt: 'Visible to all',
+      body: 'Content',
+      publishedAt: pastTime,
+      authorId: author.id,
+    })
+
+    const response = await http.query('/posts/search', {
+      keywords: ['Past'],
+      limit: 10,
+    })
+    await response.assertOk()
+    const body = (await response.json()) as unknown as { data: Array<{ title: string }> }
+    const found = body.data.find((p) => p.title === 'Past Published Post')
+
+    if (!found) {
+      throw new Error('Post with past publishedAt should be visible in search')
+    }
+  })
