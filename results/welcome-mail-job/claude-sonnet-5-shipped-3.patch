new file mode 100644
index 0000000..14f56c2
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,20 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail, type WelcomeMailData } from '../Mail/WelcomeMail.js'
+
+export class SendWelcomeEmailJob extends Job<WelcomeMailData> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: WelcomeMailData): Promise<void> {
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured. Call setMailManager() first.')
+    }
+
+    await new WelcomeMail(manager, payload).send()
+  }
+
+  async failed(payload: WelcomeMailData, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${payload.email}:`, error.message)
+  }
+}
