@@ -0,0 +1,45 @@
+---
+type: adr
+status: stable
+entities: [NewsletterSubscription]
+related:
+  - modules/newsletter/**
+  - guren.arch.ts
+generated: { by: "claude-fable/5.1", at: 2026-09-25T05:06:22.442Z }
+---
+
+# Newsletter sign-up lives in a self-contained module
+
+## Context
+
+Marketing wants readers to subscribe to a newsletter, and the same sign-up
+will ship with the next product. It therefore has to be liftable into
+another app as one folder, and the blog must not grow a dependency on it
+that would make that lift painful later.
+
+## Decision
+
+Everything newsletter-specific lives under `modules/newsletter/`: its
+routes, controller, validator, model and Drizzle table
+(`newsletter_subscriptions`). `src/app.ts` mounts it through
+`defineModule()` under the `/newsletter` prefix; nothing under `app/` or
+`routes/` references it.
+
+Two custom rules in [guren.arch.ts](../../guren.arch.ts) make that
+boundary a `guren check` failure: files under `app/` and `routes/` may not
+import from `modules/**`, type-only imports included. The one sanctioned
+crossing is `db/schema.ts` re-exporting the module's tables, which
+`make:module` wires so drizzle-kit and the migrate command see them; it is
+outside the guarded layers on purpose.
+
+Subscriptions are created pending with a random 32-character confirmation
+token; sending the confirmation email is a later ticket. Subscribe and
+unsubscribe redirect back to the `Referer` only when it is same-origin,
+falling back to `/` otherwise, so the header cannot become an open redirect.
+
+## Consequences
+
+The module can be copied into another Guren app with its migration and
+tests. Blog code that needs newsletter data must go through the module's
+`index.ts`, and any attempt to import it from `app/` or `routes/` fails
+`bunx guren check --arch` before it reaches CI.
diff --git a/guren.arch.ts b/guren.arch.ts
new file mode 100644
index 0000000..e603c18
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,26 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module ships with other products as is, so the blog must
+// never depend on it. `db/schema.ts` re-exporting the module's tables (wired by
+// `make:module` for drizzle-kit) is the one sanctioned crossing and stays out.
+export default defineArchRules({
+  layers: {
+    app: 'app/**',
+    routes: 'routes/**',
+    modules: 'modules/**',
+  },
+  rules: [
+    {
+      from: 'app',
+      disallow: ['modules'],
+      includeTypeImports: true,
+      message: 'app/ must not depend on a module. Modules are self-contained and mounted only from src/app.ts.',
+    },
+    {
+      from: 'routes',
+      disallow: ['modules'],
+      includeTypeImports: true,
+      message: 'routes/ must not depend on a module. A module registers its own routes through defineModule().',
+    },
+  ],
+})
