diff --git a/tests/api-tokens.test.ts b/tests/api-tokens.test.ts
new file mode 100644
index 0000000..f20ff05
--- /dev/null
+++ b/tests/api-tokens.test.ts
@@ -0,0 +1,328 @@
+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { hashToken } from '../app/Http/Middleware/BearerTokenAuth.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  describe('POST /profile/tokens', () => {
+    test('creates a token with valid name', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const res = await csrf.json().post('/profile/tokens', { name: 'Test Token' })
+
+      expect(res.status).toBe(201)
+      const body = await res.json() as Record<string, unknown>
+      expect(body).toHaveProperty('id')
+      expect(body).toHaveProperty('name')
+      expect(body.name).toBe('Test Token')
+      expect(body).toHaveProperty('token')
+      expect(typeof body.token).toBe('string')
+      expect((body.token as string).length).toBeGreaterThanOrEqual(16)
+
+      // Verify token was stored hashed
+      const storedToken = await ApiToken.find(body.id as number)
+      expect(storedToken).not.toBeNull()
+      expect(storedToken?.name).toBe('Test Token')
+      expect(storedToken?.tokenHash).toBe(hashToken(body.token as string))
+    })
+
+    test('rejects empty name', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+
+      const count = await ApiToken.where({ userId: user.id }).count()
+      expect(count).toBe(0)
+    })
+
+    test('rejects name longer than 50 characters', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const longName = 'a'.repeat(51)
+      await csrf.json().post('/profile/tokens', { name: longName }).assertUnprocessable()
+    })
+
+    test('rejects unauthenticated request', async () => {
+      const res = await http.json().post('/profile/tokens', { name: 'Test' })
+      // Either 401 (no session) or 403 (CSRF check) is acceptable
+      expect([401, 403]).toContain(res.status)
+    })
+  })
+
+  describe('DELETE /profile/tokens/:id', () => {
+    test('deletes own token', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      const createRes = await csrf.json().post('/profile/tokens', { name: 'Token to Delete' })
+      const { id } = await createRes.json() as { id: number }
+
+      const deleteRes = await csrf.delete(`/profile/tokens/${id}`)
+      expect(deleteRes.status).toBe(204)
+
+      const token = await ApiToken.find(id)
+      expect(token).toBeNull()
+    })
+
+    test('returns 404 for other user\'s token', async () => {
+      const otherUser = await User.create({
+        name: 'Other User',
+        email: 'other@example.com',
+        password: 'password123',
+      })
+
+      const otherToken = await ApiToken.create({
+        userId: otherUser.id,
+        name: 'Other Token',
+        tokenHash: hashToken('some-token'),
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf.delete(`/profile/tokens/${otherToken.id}`).assertNotFound()
+
+      const stillExists = await ApiToken.find(otherToken.id)
+      expect(stillExists).not.toBeNull()
+    })
+  })
+
+  describe('GET /api/posts', () => {
+    test('returns posts with valid bearer token', async () => {
+      await ApiToken.create({
+        userId: user.id,
+        name: 'API Token',
+        tokenHash: hashToken('test-token-12345678'),
+      })
+
+      const res = await http
+        .withHeader('Authorization', 'Bearer test-token-12345678')
+        .json()
+        .get('/api/posts')
+
+      expect(res.status).toBe(200)
+      const body = await res.json() as Record<string, unknown>
+      expect(body).toHaveProperty('data')
+      expect(Array.isArray(body.data)).toBe(true)
+    })
+
+    test('returns 401 without bearer token', async () => {
+      await http.json().get('/api/posts').assertUnauthorized()
+    })
+
+    test('returns 401 with invalid bearer token', async () => {
+      await http
+        .withHeader('Authorization', 'Bearer invalid-token')
+        .json()
+        .get('/api/posts')
+        .assertUnauthorized()
+    })
+
+    test('returns 401 with malformed authorization header', async () => {
+      await http
+        .withHeader('Authorization', 'NotBearer token')
+        .json()
+        .get('/api/posts')
+        .assertUnauthorized()
+    })
+
+    test('returns posts sorted by createdAt descending', async () => {
+      const { Post } = await import('../app/Models/Post.js')
+
+      await Post.forceCreate({
+        title: 'Post 1',
+        excerpt: 'Excerpt 1',
+        body: 'Body 1',
+        authorId: user.id,
+      })
+
+      await Post.forceCreate({
+        title: 'Post 2',
+        excerpt: 'Excerpt 2',
+        body: 'Body 2',
+        authorId: user.id,
+      })
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'API Token',
+        tokenHash: hashToken('test-token-for-list'),
+      })
+
+      const res = await http
+        .withHeader('Authorization', 'Bearer test-token-for-list')
+        .json()
+        .get('/api/posts')
+
+      const body = await res.json() as Record<string, unknown>
+      const data = body.data as Array<Record<string, unknown>>
+      expect(data.length).toBeGreaterThanOrEqual(2)
+      // Verify sorting - second post should be created after first post, so should be at index 0
+      expect(data[0].title).toBe('Post 2')
+      expect(data[1].title).toBe('Post 1')
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    test('creates post with valid bearer token', async () => {
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Create Token',
+        tokenHash: hashToken('create-token-12345'),
+      })
+
+      const res = await http
+        .withHeader('Authorization', 'Bearer create-token-12345')
+        .json()
+        .post('/api/posts', {
+          title: 'New Post',
+          excerpt: 'New excerpt',
+          body: 'New body content',
+        })
+
+      expect(res.status).toBe(201)
+      const body = await res.json() as Record<string, unknown>
+      expect(body).toHaveProperty('data')
+      const data = body.data as Record<string, unknown>
+      expect(data.title).toBe('New Post')
+      expect(data.authorId).toBe(user.id)
+    })
+
+    test('ignores authorId in request body', async () => {
+      const otherUser = await User.create({
+        name: 'Other User for Body Test',
+        email: 'other2@example.com',
+        password: 'password123',
+      })
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Auth Token',
+        tokenHash: hashToken('auth-token-12345678'),
+      })
+
+      const res = await http
+        .withHeader('Authorization', 'Bearer auth-token-12345678')
+        .json()
+        .post('/api/posts', {
+          title: 'Another Post',
+          excerpt: 'Excerpt',
+          body: 'Body content',
+          authorId: otherUser.id,
+        })
+
+      const body = await res.json() as Record<string, unknown>
+      const data = body.data as Record<string, unknown>
+      expect(data.authorId).toBe(user.id)
+    })
+
+    test('validates input', async () => {
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Validation Token',
+        tokenHash: hashToken('validation-token'),
+      })
+
+      const res = await http
+        .withHeader('Authorization', 'Bearer validation-token')
+        .json()
+        .post('/api/posts', {
+          title: '',
+          excerpt: 'Excerpt',
+          body: 'Body',
+        })
+
+      expect(res.status).toBe(422)
+    })
+
+    test('returns 401 without bearer token', async () => {
+      const res = await http
+        .json()
+        .post('/api/posts', {
+          title: 'Post',
+          excerpt: 'Excerpt',
+          body: 'Body',
+        })
+      // Either 401 (no auth) or 403 (CSRF check) is acceptable
+      expect([401, 403]).toContain(res.status)
+    })
+  })
+
+  describe('Rate Limiting', () => {
+    test('rate limits requests per token (60 per minute)', async () => {
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Rate Limit Token',
+        tokenHash: hashToken('rate-limit-token'),
+      })
+
+      let successCount = 0
+      let rateLimited = false
+
+      for (let i = 0; i < 61; i++) {
+        const res = await http
+          .withHeader('Authorization', 'Bearer rate-limit-token')
+          .json()
+          .get('/api/posts')
+
+        if (res.status === 200) {
+          successCount++
+        } else if (res.status === 429) {
+          rateLimited = true
+          expect(res.headers.get('Retry-After')).toBeTruthy()
+        }
+      }
+
+      expect(successCount).toBe(60)
+      expect(rateLimited).toBe(true)
+    })
+
+    test('different tokens have separate rate limits', async () => {
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Token 1',
+        tokenHash: hashToken('token-1-for-limit'),
+      })
+
+      await ApiToken.create({
+        userId: user.id,
+        name: 'Token 2',
+        tokenHash: hashToken('token-2-for-limit'),
+      })
+
+      // Make 61 requests with token1 (should get rate limited)
+      let token1Limited = false
+      for (let i = 0; i < 61; i++) {
+        const res = await http
+          .withHeader('Authorization', 'Bearer token-1-for-limit')
+          .json()
+          .get('/api/posts')
+        if (res.status === 429) {
+          token1Limited = true
+        }
+      }
+
+      expect(token1Limited).toBe(true)
+
+      // token2 should still work
+      const res = await http
+        .withHeader('Authorization', 'Bearer token-2-for-limit')
+        .json()
+        .get('/api/posts')
+
+      expect(res.status).toBe(200)
+    })
+  })
+})
