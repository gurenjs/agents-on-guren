diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..ad79e6b
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,140 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Booting the real app migrates data/guren.test.db, which persists between
+// runs, so every fixture carries a unique suffix.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+interface RevisionProps {
+  revisions: Array<{ id: number; title: string; createdAt: string }>
+}
+
+async function makeUser(label: string): Promise<UserRecord> {
+  return User.create({
+    name: `${label} ${run}`,
+    email: `${label}-${run}@example.com`,
+    password: 'secret-password',
+  })
+}
+
+function makePost(author: UserRecord, title: string): Promise<PostRecord> {
+  return Post.forceCreate({
+    title,
+    excerpt: `${title} excerpt`,
+    body: `${title} body`,
+    authorId: author.id,
+  })
+}
+
+async function revisionsOf(postId: number) {
+  return PostRevision.newQuery().where('postId', postId).orderBy('id', 'desc').get()
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let asAuthor: TestApp
+  let asStranger: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('author')
+    stranger = await makeUser('stranger')
+    asAuthor = await http.actingAs(author).withCsrf('/posts')
+    asStranger = await http.actingAs(stranger).withCsrf('/posts')
+  })
+
+  it('keeps the previous version on every successful edit, and restores any of them', async () => {
+    const post = await makePost(author, 'First')
+    expect(await revisionsOf(post.id)).toHaveLength(0)
+
+    await asAuthor
+      .put(`/posts/${post.id}`, { title: 'Second', excerpt: 'Second excerpt', body: 'Second body' })
+      .assertRedirect(`/posts/${post.id}`)
+    await asAuthor
+      .put(`/posts/${post.id}`, { title: 'Third', excerpt: 'Third excerpt', body: 'Third body' })
+      .assertRedirect(`/posts/${post.id}`)
+
+    const kept = await revisionsOf(post.id)
+    expect(kept.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(kept[1]).toMatchObject({ postId: post.id, excerpt: 'First excerpt', body: 'First body' })
+    expect(new Date(kept[0]!.createdAt).toISOString()).toBe(kept[0]!.createdAt)
+
+    const page = await asAuthor.get(`/posts/${post.id}/revisions`).assertOk()
+    const { payload } = await readInertiaResponse(page.raw)
+    const props = payload.props as unknown as RevisionProps
+    expect(props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(props.revisions.map((revision) => revision.id)).toEqual(kept.map((revision) => revision.id))
+    expect(typeof props.revisions[0]!.createdAt).toBe('string')
+
+    const first = kept[1]!
+    await asAuthor.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+
+    const afterRestore = await revisionsOf(post.id)
+    expect(afterRestore.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+    expect(afterRestore.some((revision) => revision.id === first.id)).toBe(true)
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const post = await makePost(author, 'Untouched')
+
+    await asAuthor.put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'x' }).assertStatus(422)
+    await asStranger
+      .put(`/posts/${post.id}`, { title: 'Hijacked', excerpt: 'x', body: 'x' })
+      .assertForbidden()
+
+    expect(await revisionsOf(post.id)).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('Untouched')
+  })
+
+  it('refuses other users and sends guests to login, changing nothing', async () => {
+    const post = await makePost(author, 'Private')
+    await asAuthor.put(`/posts/${post.id}`, { title: 'Private v2', excerpt: 'x', body: 'x' }).assertRedirect()
+    const [revision] = await revisionsOf(post.id)
+
+    await asStranger.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await asStranger.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    const guest = await http.withCsrf('/posts')
+    await guest.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await guest.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Private v2')
+    expect(await revisionsOf(post.id)).toHaveLength(1)
+  })
+
+  it('answers 404 for a revision of a different post, even by the same author', async () => {
+    const one = await makePost(author, 'One')
+    const other = await makePost(author, 'Other')
+    await asAuthor.put(`/posts/${other.id}`, { title: 'Other v2', excerpt: 'x', body: 'x' }).assertRedirect()
+    const [otherRevision] = await revisionsOf(other.id)
+
+    await asAuthor.post(`/posts/${one.id}/revisions/${otherRevision!.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(one.id)).title).toBe('One')
+    expect((await Post.findOrFail(other.id)).title).toBe('Other v2')
+    expect(await revisionsOf(one.id)).toHaveLength(0)
+    expect(await revisionsOf(other.id)).toHaveLength(1)
+  })
+
+  it('deletes a post history with the post and leaves other histories alone', async () => {
+    const doomed = await makePost(author, 'Doomed')
+    const kept = await makePost(author, 'Kept')
+    await asAuthor.put(`/posts/${doomed.id}`, { title: 'Doomed v2', excerpt: 'x', body: 'x' }).assertRedirect()
+    await asAuthor.put(`/posts/${kept.id}`, { title: 'Kept v2', excerpt: 'x', body: 'x' }).assertRedirect()
+
+    await asAuthor.delete(`/posts/${doomed.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(doomed.id)).toBeNull()
+    expect(await revisionsOf(doomed.id)).toHaveLength(0)
+    expect(await revisionsOf(kept.id)).toHaveLength(1)
+  })
+})
