diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..3129c1c
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,83 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 1, 2, 3, 4])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', cover)
+  return data
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  const fields = { title: 'Cover post', excerpt: 'An excerpt', body: 'A body' }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const user = await User.forceCreate({
+      name: 'Cover Author',
+      email: `cover-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    http = await http.actingAs(user).withCsrf('/')
+  })
+
+  async function latestPost() {
+    return (await Post.newQuery().orderBy('id', 'desc').first())!
+  }
+
+  it('stores, replaces, removes and deletes a cover', async () => {
+    const before = await Attachment.newQuery().get()
+    await http.post('/posts', form(fields, new File([PNG], 'a.png', { type: 'image/png' })))
+    const post = await latestPost()
+    expect(post.coverId).toBeTruthy()
+
+    const served = await app.fetch(new Request(`http://localhost:3000/attachments/${post.coverId}`))
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await served.arrayBuffer())).toEqual(PNG)
+
+    const oldId = post.coverId!
+    const oldFile = await Attachment.find(oldId)
+    await http.put(`/posts/${post.id}`, form(fields, new File([JPEG], 'b.jpg', { type: 'image/jpeg' })))
+    const replaced = (await Post.find(post.id))!
+    expect(replaced.coverId).not.toBe(oldId)
+    expect(await Attachment.find(oldId)).toBeNull()
+    expect(existsSync(join(process.cwd(), 'storage', 'attachments', oldFile!.path))).toBe(false)
+
+    await http.put(`/posts/${post.id}`, form(fields))
+    expect((await Post.find(post.id))!.coverId).toBe(replaced.coverId)
+
+    await http.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' }))
+    expect((await Post.find(post.id))!.coverId).toBeNull()
+
+    await http.put(`/posts/${post.id}`, form(fields, new File([PNG], 'a.png', { type: 'image/png' })))
+    await http.delete(`/posts/${post.id}`)
+    expect(await Post.find(post.id)).toBeNull()
+    expect((await Attachment.newQuery().get()).length).toBe(before.length)
+  })
+
+  it('refuses a GIF and an oversized image without saving anything', async () => {
+    const posts = (await Post.newQuery().get()).length
+    const attachments = (await Attachment.newQuery().get()).length
+
+    await http.post('/posts', form(fields, new File([GIF], 'a.gif', { type: 'image/gif' }))).assertStatus(422)
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form(fields, new File([big], 'big.png', { type: 'image/png' }))).assertStatus(422)
+    await http.post('/posts', form(fields, new File([GIF], 'fake.png', { type: 'image/png' }))).assertStatus(422)
+
+    expect((await Post.newQuery().get()).length).toBe(posts)
+    expect((await Attachment.newQuery().get()).length).toBe(attachments)
+  })
+})
