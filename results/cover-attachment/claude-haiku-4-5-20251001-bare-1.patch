new file mode 100644
index 0000000..5edb7ac
--- /dev/null
+++ b/app/Services/FileStorageService.ts
@@ -0,0 +1,41 @@
+import { mkdir, rm, readFile } from 'fs/promises'
+import { join } from 'path'
+import { createHash } from 'crypto'
+import { fileURLToPath } from 'url'
+
+const __dirname = fileURLToPath(new URL('.', import.meta.url))
+const STORAGE_DIR = join(__dirname, '../../storage')
+
+export class FileStorageService {
+  static async saveFile(file: File): Promise<{ filePath: string; fileName: string }> {
+    await mkdir(STORAGE_DIR, { recursive: true })
+
+    const buffer = Buffer.from(await file.arrayBuffer())
+    const hash = createHash('sha256').update(buffer).digest('hex')
+    const ext = file.name.split('.').pop() || 'bin'
+    const fileName = `${hash}.${ext}`
+    const filePath = join(STORAGE_DIR, fileName)
+
+    await Bun.write(filePath, buffer)
+
+    return { filePath: fileName, fileName: file.name }
+  }
+
+  static async readFile(fileName: string): Promise<Buffer> {
+    const filePath = join(STORAGE_DIR, fileName)
+    return readFile(filePath)
+  }
+
+  static async deleteFile(fileName: string): Promise<void> {
+    const filePath = join(STORAGE_DIR, fileName)
+    try {
+      await rm(filePath)
+    } catch {
+      // File doesn't exist, ignore
+    }
+  }
+
+  static getStorageDir(): string {
+    return STORAGE_DIR
+  }
+}
