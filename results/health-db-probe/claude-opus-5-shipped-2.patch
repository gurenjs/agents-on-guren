diff --git a/tests/HealthController.test.ts b/tests/HealthController.test.ts
new file mode 100644
index 0000000..9cc8523
--- /dev/null
+++ b/tests/HealthController.test.ts
@@ -0,0 +1,66 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { closeDatabase } from '../config/database.js'
+
+// The probe has to fail when the database is unreachable, so the failure case
+// is exercised for real: close the connection, point the filename resolver at
+// a path SQLite cannot open, and let the next probe try to open it. The
+// filename is resolved per connection and a failed open is never cached, so
+// restoring the variable and closing again puts the suite back on the test DB.
+const UNOPENABLE_DATABASE = '/dev/null/unreachable.db'
+
+// Assigning `undefined` would leave the literal string "undefined" behind.
+function setTestDatabaseUrl(value: string | undefined): void {
+  if (value === undefined) {
+    delete process.env.TEST_DATABASE_URL
+  } else {
+    process.env.TEST_DATABASE_URL = value
+  }
+}
+
+describe('GET /health', () => {
+  let http: TestApp
+  const originalTestDatabaseUrl = process.env.TEST_DATABASE_URL
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  afterAll(async () => {
+    setTestDatabaseUrl(originalTestDatabaseUrl)
+    await closeDatabase()
+  })
+
+  it('reports the database as healthy while it answers', async () => {
+    const response = await http.get('/health').assertOk()
+    const body = await response.json<{
+      status: string
+      checks: Record<string, { status: string }>
+    }>()
+
+    expect(body.status).toBe('healthy')
+    expect(body.checks.database?.status).toBe('healthy')
+  })
+
+  it('answers 503 when the database cannot be reached', async () => {
+    await closeDatabase()
+    setTestDatabaseUrl(UNOPENABLE_DATABASE)
+
+    const response = await http.get('/health').assertStatus(503)
+    const body = await response.json<{
+      status: string
+      checks: Record<string, { status: string }>
+    }>()
+
+    expect(body.status).toBe('unhealthy')
+    expect(body.checks.database?.status).toBe('unhealthy')
+  })
+
+  it('recovers once the database is reachable again', async () => {
+    setTestDatabaseUrl(originalTestDatabaseUrl)
+    await closeDatabase()
+
+    await http.get('/health').assertOk()
+  })
+})
