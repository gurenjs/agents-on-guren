+++ b/app/Mail/WelcomeEmailMail.ts
@@ -0,0 +1,19 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export class WelcomeEmailMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: Record<string, unknown> = {},
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const name = this.data.name as string
+    const appName = process.env.APP_NAME ?? 'App'
+
+    return this
+      .subject(`Welcome to ${appName}, ${name}!`)
+      .text(`Hi ${name},\n\nWelcome to ${appName}! We're excited to have you on board.\n\nBest regards,\nThe ${appName} Team`)
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..2f2c54a
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,28 @@
+import { ServiceProvider, createMailManager, setMailManager, type MailManager } from '@guren/core'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    const mailFromName = (process.env.MAIL_FROM_NAME ?? 'App').replace('${APP_NAME}', process.env.APP_NAME ?? 'App')
+
+    const manager = createMailManager({
+      // MAIL_MAILER=log writes messages to the server output (default);
+      // 'memory' keeps them inspectable in tests.
+      default: process.env.MAIL_MAILER === 'memory' ? 'memory' : 'log',
+      from: {
+        email: process.env.MAIL_FROM_ADDRESS ?? 'noreply@example.com',
+        name: mailFromName,
+      },
+      transports: {
+        log: { driver: 'log' },
+        memory: { driver: 'memory' },
+      },
+    })
+
+    this.container.instance('mail', manager)
+  }
+
+  boot(): void {
+    const manager = this.container.make<MailManager>('mail')
+    setMailManager(manager)
+  }
+}
diff --git a/app/Providers/QueueProvider.ts b/app/Providers/QueueProvider.ts
new file mode 100644
index 0000000..59bd387
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,25 @@
+import { ServiceProvider, MemoryDriver, SyncDriver, createQueueManager, registerJob, type QueueManager } from '@guren/core'
+import { ProcessWelcomeSequenceJob } from '../Jobs/ProcessWelcomeSequenceJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    const queue = createQueueManager({
+      // QUEUE_CONNECTION=sync executes jobs inline on dispatch (default,
+      // no worker process needed); 'memory' queues them for a Worker.
+      default: process.env.QUEUE_CONNECTION === 'memory' ? 'memory' : 'sync',
+      drivers: {
+        sync: () => new SyncDriver(),
+        memory: () => new MemoryDriver(),
+      },
+    })
+
+    this.container.instance('queue', queue)
+  }
+
+  boot(): void {
+    // Register job classes before the driver so sync dispatches can resolve them.
+    registerJob(ProcessWelcomeSequenceJob)
+    const queue = this.container.make<QueueManager>('queue')
+    queue.driver()
+  }
+}
