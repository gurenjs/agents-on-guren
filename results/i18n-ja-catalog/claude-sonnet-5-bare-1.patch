diff --git a/tests/AuthLocale.test.ts b/tests/AuthLocale.test.ts
new file mode 100644
index 0000000..1ce4ca7
--- /dev/null
+++ b/tests/AuthLocale.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// The auth pages (Login/Register) read their copy from the lang/ catalog via
+// useTranslation(), and the server resolves the locale from Accept-Language
+// (see src/app.ts's i18n.supported). Requesting with X-Inertia turns the
+// response into the JSON payload Inertia would otherwise embed in the HTML
+// shell, so the resolved locale and catalog contents can be asserted
+// directly without needing SSR to render the React tree.
+describe('auth pages locale detection', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  function inertiaGet(path: string, acceptLanguage?: string) {
+    const headers: Record<string, string> = { 'X-Inertia': 'true', 'X-Inertia-Version': '1' }
+    if (acceptLanguage !== undefined) headers['Accept-Language'] = acceptLanguage
+    return http.withHeaders(headers).get(path)
+  }
+
+  it('resolves ja for a typical Japanese browser header on /login', async () => {
+    await inertiaGet('/login', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.messages.auth.login.heading', 'ログイン')
+      .assertJsonPath('props._i18n.messages.ja.messages.auth.login.subtitle', 'アカウントの認証情報を入力して続行してください。')
+      .assertJsonPath('props._i18n.messages.ja.messages.auth.login.submit', 'ログイン')
+  })
+
+  it('resolves ja for a typical Japanese browser header on /register', async () => {
+    await inertiaGet('/register', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.messages.auth.register.heading', 'アカウント登録')
+      .assertJsonPath('props._i18n.messages.ja.messages.auth.register.submit', '登録')
+  })
+
+  it('falls back to en when there is no Accept-Language header', async () => {
+    await inertiaGet('/login').assertOk().assertJsonPath('props._i18n.locale', 'en')
+  })
+
+  it('resolves en for a plain English header', async () => {
+    await inertiaGet('/login', 'en-US,en;q=0.9').assertOk().assertJsonPath('props._i18n.locale', 'en')
+  })
+
+  it('resolves en when English outranks Japanese', async () => {
+    await inertiaGet('/login', 'en-US,en;q=0.9,ja;q=0.5').assertOk().assertJsonPath('props._i18n.locale', 'en')
+  })
+
+  it('falls back to en when the header names only unsupported languages', async () => {
+    await inertiaGet('/login', 'fr-FR,fr;q=0.9').assertOk().assertJsonPath('props._i18n.locale', 'en')
+  })
+
+  it('keeps the English catalog wording unchanged', async () => {
+    await inertiaGet('/login', 'en-US,en;q=0.9')
+      .assertOk()
+      .assertJsonPath('props._i18n.messages.en.messages.auth.login.heading', 'Sign in')
+      .assertJsonPath('props._i18n.messages.en.messages.auth.login.subtitle', 'Use your account credentials to continue.')
+      .assertJsonPath('props._i18n.messages.en.messages.auth.login.submit', 'Sign in')
+  })
+})
