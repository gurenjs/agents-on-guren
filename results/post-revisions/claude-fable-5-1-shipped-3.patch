@@ -0,0 +1,182 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Post, type PostContent, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface RevisionsPage {
+  component: string
+  props: { revisions: Array<{ id: number; title: string; createdAt: string }> }
+}
+
+function content(title: string): PostContent {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-password' })
+    post = await Post.forceCreate({ ...content('First'), authorId: author.id })
+  })
+
+  async function edit(target: PostRecord, title: string, as: UserRecord = author) {
+    const csrf = await http.actingAs(as).withCsrf()
+    return csrf.put(`/posts/${target.id}`, content(title))
+  }
+
+  async function revisionsPage(target: PostRecord, as: UserRecord = author): Promise<RevisionsPage> {
+    const response = await http
+      .actingAs(as)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${target.id}/revisions`)
+      .assertOk()
+    return response.json<RevisionsPage>()
+  }
+
+  function titlesOf(target: PostRecord): Promise<string[]> {
+    return PostRevision.where({ postId: target.id })
+      .orderBy('id', 'desc')
+      .get()
+      .then((revisions) => revisions.map((revision) => revision.title))
+  }
+
+  it('keeps nothing when a post is created', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', content('Fresh')).assertRedirect()
+
+    expect(await PostRevision.all()).toHaveLength(0)
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    await (await edit(post, 'Second')).assertRedirect(`/posts/${post.id}`)
+    await (await edit(post, 'Third')).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await PostRevision.where({ postId: post.id }).orderBy('id', 'asc').get()
+    expect(revisions.map(({ title, excerpt, body }) => ({ title, excerpt, body }))).toEqual([
+      content('First'),
+      content('Second'),
+    ])
+    expect(new Date(revisions[0].createdAt).toISOString()).toBe(revisions[0].createdAt)
+    expect((await Post.findOrFail(post.id)).title).toBe('Third')
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const csrf = await http.actingAs(author).json().withCsrf()
+    await csrf.put(`/posts/${post.id}`, { ...content('Second'), title: '' }).assertUnprocessable()
+    await (await edit(post, 'Hijacked', other)).assertForbidden()
+
+    expect(await PostRevision.all()).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('lists the revisions newest first', async () => {
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+
+    const page = await revisionsPage(post)
+
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    const stored = await PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+    expect(page.props.revisions.map((revision) => revision.id)).toEqual(stored.map((revision) => revision.id))
+    expect(page.props.revisions.map((revision) => revision.createdAt)).toEqual(
+      stored.map((revision) => revision.createdAt),
+    )
+  })
+
+  it('lists only the revisions of the post asked for', async () => {
+    const second = await Post.forceCreate({ ...content('Unrelated'), authorId: author.id })
+    await edit(post, 'Second')
+    await edit(second, 'Unrelated again')
+
+    const page = await revisionsPage(post)
+
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['First'])
+  })
+
+  it('restores a revision and keeps the version it replaces', async () => {
+    await edit(post, 'Second')
+    await edit(post, 'Third')
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect({ title: restored.title, excerpt: restored.excerpt, body: restored.body }).toEqual(content('First'))
+    expect(await titlesOf(post)).toEqual(['Third', 'Second', 'First'])
+    expect((await revisionsPage(post)).props.revisions.map((revision) => revision.title)).toEqual([
+      'Third',
+      'Second',
+      'First',
+    ])
+  })
+
+  it('refuses a signed-in user who is not the author', async () => {
+    await edit(post, 'Second')
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await titlesOf(post)).toEqual(['First'])
+  })
+
+  it('sends a guest to the login page', async () => {
+    await edit(post, 'Second')
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await titlesOf(post)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post by the same author', async () => {
+    const second = await Post.forceCreate({ ...content('Unrelated'), authorId: author.id })
+    await edit(second, 'Unrelated again')
+    const foreign = await PostRevision.where({ postId: second.id }).firstOrFail()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+    await csrf.post(`/posts/${post.id}/revisions/999999/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect(await titlesOf(post)).toEqual([])
+    expect(await titlesOf(second)).toEqual(['Unrelated'])
+  })
+
+  it('answers 404 for the revisions of a post that does not exist', async () => {
+    await http.actingAs(author).get('/posts/999999/revisions').assertNotFound()
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const second = await Post.forceCreate({ ...content('Unrelated'), authorId: author.id })
+    await edit(post, 'Second')
+    await edit(second, 'Unrelated again')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await titlesOf(post)).toEqual([])
+    expect(await titlesOf(second)).toEqual(['Unrelated'])
+  })
+})
