@@ -0,0 +1,50 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: any
+  let other: any
+  let postId: number
+  let tag: string
+  const future = new Date(Date.now() + 86_400_000).toISOString()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const stamp = Date.now()
+    tag = `zebra${stamp}`
+    author = await User.forceCreate({ name: 'A', email: `a${stamp}@x.test`, password: 'secret123' })
+    other = await User.forceCreate({ name: 'B', email: `b${stamp}@x.test`, password: 'secret123' })
+    const post = await Post.forceCreate({
+      title: `Scheduled ${tag}`,
+      excerpt: `${tag} excerpt`,
+      body: 'body',
+      authorId: author.id,
+      publishedAt: future,
+    })
+    postId = post!.id
+  })
+
+  it('hides a scheduled post from guests and others, shows it to its author', async () => {
+    await http.get(`/posts/${postId}`).assertStatus(404)
+    await http.actingAs(other).get(`/posts/${postId}`).assertStatus(404)
+    await http.actingAs(author).get(`/posts/${postId}`).assertOk()
+    const search = await http.query('/posts/search', { keywords: [tag] })
+    expect(JSON.stringify(await search.json())).not.toContain(tag)
+  })
