+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('API Tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  describe('GET /api/posts', () => {
+    it('returns 401 without bearer token', async () => {
+      await http.get('/api/posts').assertStatus(401)
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it('returns 403 without CSRF token (unauthenticated)', async () => {
+      // CSRF protection prevents unauthenticated POST requests
+      await http.post('/api/posts').assertStatus(403)
+    })
+  })
+
+  describe('POST /profile/tokens', () => {
+    it('returns 403 without authentication', async () => {
+      // Auth middleware protects this route
+      await http.post('/profile/tokens').assertStatus(403)
+    })
+  })
+})
