+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// POST /login is throttled to 5 attempts per minute per client (see
+// routes/auth.ts) to slow down credential stuffing / brute force. Every
+// submission counts, whether or not the credentials are right, and the
+// window resets a minute after the first attempt in it.
+describe('login rate limiting', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const base = await TestApp.fromApp(app)
+    http = await base.withCsrf('/login')
+  })
+
+  it('throttles a 6th submission within a minute and leaves other routes untouched', async () => {
+    const credentials = { email: 'nobody@example.com', password: 'wrong-password' }
+
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      const response = await http.post('/login', credentials)
+      expect(response.status).not.toBe(429)
+    }
+
+    const throttled = await http.post('/login', credentials)
+    expect(throttled.status).toBe(429)
+    expect(throttled.headers.get('Retry-After')).not.toBeNull()
+
+    // Rendering the form and other pages must stay unaffected by the throttle.
+    await http.get('/login').assertStatus(200)
+  })
+})
