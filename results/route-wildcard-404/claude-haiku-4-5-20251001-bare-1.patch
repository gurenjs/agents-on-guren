+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('accepts a year archive request', async () => {
+    const res = await http.get('/posts/archive/2026')
+    res.assertStatus(200)
+    const data = await res.json() as { data: unknown[] }
+    if (!(Array.isArray(data?.data))) {
+      throw new Error('Expected data array in response')
+    }
+  })
+
+  it('accepts a month archive request with leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/08')
+    res.assertStatus(200)
+    const data = await res.json() as { data: unknown[] }
+    if (!(Array.isArray(data?.data))) {
+      throw new Error('Expected data array in response')
+    }
+  })
+
+  it('accepts a month archive request without leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/8')
+    res.assertStatus(200)
+    const data = await res.json() as { data: unknown[] }
+    if (!(Array.isArray(data?.data))) {
+      throw new Error('Expected data array in response')
+    }
+  })
+
+  it('rejects an invalid month', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+  })
+
+  it('rejects month 0', async () => {
+    await http.get('/posts/archive/2026/0').assertStatus(422)
+  })
+})
