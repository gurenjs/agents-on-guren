+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/ApiPostController.js'
+import { authenticateApiToken, rateLimitApiToken } from '../app/Http/Middleware/ApiAuth.js'
+
+// Bearer-token JSON API. Authentication runs first so the rate limit can be
+// keyed on the token.
+export function registerApiRoutes(router: Router<'auth' | 'guest'>): void {
+  router.middleware(authenticateApiToken, rateLimitApiToken).group((api) => {
+    api.get('/api/posts', [ApiPostController, 'index']).name('api.posts.index')
+    api.post('/api/posts', [ApiPostController, 'store']).name('api.posts.store')
+  })
+}
