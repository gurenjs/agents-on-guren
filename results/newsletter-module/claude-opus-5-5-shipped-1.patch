+++ b/modules/newsletter/tests/NewsletterController.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  const client = async () => (await http.withHeader('Referer', 'http://localhost/posts').withCsrf()).json()
+
+  it('stores a pending subscription and redirects back', async () => {
+    await (await client()).post('/newsletter/subscribe', { email: 'reader@example.com' })
+      .assertRedirect('http://localhost/posts')
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.email).toBe('reader@example.com')
+    expect(rows[0]!.confirmedAt).toBeNull()
+    expect(rows[0]!.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses with 422 under email', async () => {
+    const csrf = await client()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const dup = await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' })
+    dup.assertUnprocessable()
+    expect((await dup.json<{ errors: Record<string, string[]> }>()).errors.email).toBeDefined()
+
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s on an unknown token', async () => {
+    await (await client()).post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const [row] = await NewsletterSubscription.all()
+
+    await http.get('/newsletter/confirm/not-a-real-token').assertNotFound()
+    expect((await NewsletterSubscription.first({ id: row!.id }))!.confirmedAt).toBeNull()
+
+    await http.get(`/newsletter/confirm/${row!.token}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ id: row!.id }))!.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given address', async () => {
+    const csrf = await client()
+    await csrf.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+    await csrf.post('/newsletter/subscribe', { email: 'b@example.com' }).assertRedirect()
+
+    await csrf.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('http://localhost/posts')
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((r) => r.email)).toEqual(['b@example.com'])
+  })
+})
