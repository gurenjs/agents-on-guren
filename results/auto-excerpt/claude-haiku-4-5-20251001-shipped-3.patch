+
+describe('deriveExcerpt', () => {
+  it('returns the whole body if it is 140 characters or fewer', () => {
+    const short = 'This is a short body.'
+    expect(deriveExcerpt(short)).toBe(short)
+  })
+
+  it('handles exactly 140 characters', () => {
+    const exactly140 = 'a'.repeat(140)
+    expect(deriveExcerpt(exactly140)).toBe(exactly140)
+  })
+
+  it('truncates to 140 characters and appends ellipsis when body is longer', () => {
+    const long = 'a'.repeat(150)
+    const result = deriveExcerpt(long)
+    expect(result).toBe('a'.repeat(140) + '…')
+  })
+
+  it('cuts at word boundary when character 141 is inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const result = deriveExcerpt(body)
+    // First 140 chars end with "The q"; character 141 is "u" (inside word)
+    // Should cut at the last space before position 140
+    expect(result).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+    )
+  })
+
+  it('keeps all 140 characters if character 141 is whitespace', () => {
+    // Create a string where the 141st character is a space
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const result = deriveExcerpt(body)
+    // First 140 characters should end at "right" and character 141 should be space
+    expect(result.length).toBe(141) // 140 chars + "…"
+    expect(result).toContain('…')
+  })
+
+  it('trims leading and trailing whitespace from body', () => {
+    const body = '  \n  Some text here  \n  '
+    const result = deriveExcerpt(body)
+    expect(result).toBe('Some text here')
+  })
+
+  it('trims trailing whitespace before appending ellipsis', () => {
+    const body = 'a'.repeat(130) + '   ' + 'b'.repeat(20)
+    const result = deriveExcerpt(body)
+    expect(result.endsWith('…')).toBe(true)
+    expect(result).not.toContain('   …')
+  })
+
+  it('handles body with no whitespace by keeping first 140 characters', () => {
+    const body = 'abcdefghijklmnopqrstuvwxyz'.repeat(10) // No spaces, 260 chars total
+    const result = deriveExcerpt(body)
+    // First 140 chars: 5 full repetitions (130) + 10 chars from next = 140
+    expect(result).toBe('abcdefghijklmnopqrstuvwxyz'.repeat(5) + 'abcdefghij' + '…')
+  })
+
+  it('uses the ellipsis character (U+2026), not three periods', () => {
+    const body = 'a'.repeat(150)
+    const result = deriveExcerpt(body)
+    expect(result.endsWith('…')).toBe(true)
+    expect(result).not.toContain('...')
+  })
+})
