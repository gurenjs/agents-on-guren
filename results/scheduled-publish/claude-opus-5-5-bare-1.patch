diff --git a/resources/js/lib/publishAt.ts b/resources/js/lib/publishAt.ts
new file mode 100644
index 0000000..35b484d
--- /dev/null
+++ b/resources/js/lib/publishAt.ts
@@ -0,0 +1,20 @@
+// A `datetime-local` input holds wall-clock time without a zone; the server
+// stores UTC. These convert between the two in the browser's time zone.
+
+/** ISO timestamp → `YYYY-MM-DDTHH:mm` for a datetime-local input ('' for none). */
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  const pad = (value: number) => String(value).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+/** datetime-local value → ISO UTC timestamp, or null to publish now. */
+export function fromLocalInput(value: string | null | undefined): string | null {
+  return value ? new Date(value).toISOString() : null
+}
+
+/** True while a post's publish time is still ahead. */
+export function isScheduled(publishedAt: string | null | undefined): boolean {
+  return publishedAt != null && new Date(publishedAt).getTime() > Date.now()
+}
