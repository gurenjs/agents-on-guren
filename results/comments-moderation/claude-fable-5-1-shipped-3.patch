diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..18eafd5
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,133 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface CommentProp {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+// The test database persists between runs, so every fixture carries a unique
+// suffix instead of relying on a clean table.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+let counter = 0
+
+async function makeUser(label: string): Promise<UserRecord> {
+  counter += 1
+  const user = await User.create({
+    name: `${label} ${run}`,
+    email: `${label}-${counter}-${run}@example.com`,
+    password: 'secret',
+  })
+  return user as UserRecord
+}
+
+async function makePost(author: UserRecord): Promise<PostRecord> {
+  const post = await Post.forceCreate({
+    title: `Post ${run}`,
+    excerpt: 'excerpt',
+    body: 'body',
+    authorId: author.id,
+  })
+  return post as PostRecord
+}
+
+async function pageComments(http: TestApp, postId: number): Promise<CommentProp[]> {
+  const response = await http.get(`/posts/${postId}`)
+  response.assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { comments: CommentProp[] }).comments
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('Author')
+    reader = await makeUser('Reader')
+    stranger = await makeUser('Stranger')
+    post = await makePost(author)
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('rejects an empty or oversized body with 422', async () => {
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '   ' }).assertUnprocessable()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('stores a comment for the signed-in user and lists it oldest first', async () => {
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    const authorCsrf = await http.actingAs(author).withCsrf()
+    await authorCsrf.post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await pageComments(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['first', 'second'])
+    expect(comments[0]?.author).toEqual({ id: reader.id, name: reader.name })
+    expect(new Date(comments[0]?.createdAt ?? '').toISOString()).toBe(comments[0]?.createdAt)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const comment = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'mine' })
+    const other = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'also mine' })
+
+    const strangerCsrf = await http.actingAs(stranger).withCsrf()
+    await strangerCsrf.delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.find(comment.id)).not.toBeNull()
+
+    const readerCsrf = await http.actingAs(reader).withCsrf()
+    await readerCsrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(comment.id)).toBeNull()
+
+    const authorCsrf = await http.actingAs(author).withCsrf()
+    await authorCsrf.delete(`/comments/${other.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(other.id)).toBeNull()
+  })
+
+  it('hides a comment after three distinct reports and dedupes repeat reports', async () => {
+    const comment = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'spam' })
+    const reporters = [author, stranger, await makeUser('Third')]
+
+    const first = await http.actingAs(reporters[0]!).withCsrf()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+    expect((await pageComments(http, post.id)).some((entry) => entry.id === comment.id)).toBe(true)
+
+    for (const reporter of reporters.slice(1)) {
+      const csrf = await http.actingAs(reporter).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(3)
+    expect((await pageComments(http, post.id)).some((entry) => entry.id === comment.id)).toBe(false)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    const doomed = await makePost(author)
+    await Comment.forceCreate({ postId: doomed.id, userId: reader.id, body: 'gone soon' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${doomed.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: doomed.id }).count()).toBe(0)
+  })
+})
