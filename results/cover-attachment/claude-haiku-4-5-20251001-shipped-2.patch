diff --git a/app/Services/AttachmentService.ts b/app/Services/AttachmentService.ts
new file mode 100644
index 0000000..434be56
--- /dev/null
+++ b/app/Services/AttachmentService.ts
@@ -0,0 +1,68 @@
+import { mkdir, rm, writeFile } from 'fs/promises'
+import { dirname, join } from 'path'
+import { fileURLToPath } from 'url'
+import { Attachment } from '../Models/Attachment.js'
+import type { AttachmentRecord } from '../Models/Attachment.js'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const STORAGE_DIR = join(__dirname, '../../storage')
+const MAX_FILE_SIZE = 2 * 1024 * 1024 // 2 MB
+const ALLOWED_TYPES = ['image/png', 'image/jpeg']
+
+export interface FileValidationError {
+  field: string
+  message: string
+}
+
+export class AttachmentService {
+  static async validateFile(file: File | null | undefined): Promise<FileValidationError | null> {
+    if (!file) return null
+
+    if (!ALLOWED_TYPES.includes(file.type)) {
+      return {
+        field: 'cover',
+        message: 'Cover must be a PNG or JPEG image.',
+      }
+    }
+
+    if (file.size > MAX_FILE_SIZE) {
+      return {
+        field: 'cover',
+        message: 'Cover must be at most 2 MB.',
+      }
+    }
+
+    return null
+  }
+
+  static async storeFile(file: File): Promise<AttachmentRecord> {
+    await mkdir(STORAGE_DIR, { recursive: true })
+
+    const timestamp = Date.now()
+    const random = Math.random().toString(36).substring(2, 8)
+    const filename = `${timestamp}-${random}`
+    const diskPath = join(STORAGE_DIR, filename)
+
+    const buffer = await file.arrayBuffer()
+    await writeFile(diskPath, new Uint8Array(buffer))
+
+    const attachment = await Attachment.create({
+      filename: file.name,
+      mimeType: file.type,
+      size: file.size,
+      diskPath: filename,
+    })
+
+    return attachment
+  }
+
+  static async deleteFile(attachment: AttachmentRecord): Promise<void> {
+    const diskPath = join(STORAGE_DIR, attachment.diskPath)
+    try {
+      await rm(diskPath, { force: true })
+    } catch {
+      // Ignore errors if file is already deleted
+    }
+    await Attachment.delete({ id: attachment.id })
+  }
+}
