diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..a6b785b
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,71 @@
+import type { SqliteSeederContext } from '@guren/core'
+import { and, desc, eq, inArray } from 'drizzle-orm'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+async function db(): Promise<SqliteSeederContext['db']> {
+  return (await getDatabase()) as SqliteSeederContext['db']
+}
+
+/** Tag names per post id, sorted alphabetically; posts without tags are absent. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) {
+    return byPost
+  }
+
+  const conn = await db()
+  const rows = await conn
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const row of rows) {
+    byPost.set(row.postId, [...(byPost.get(row.postId) ?? []), row.name])
+  }
+  for (const names of byPost.values()) {
+    names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  }
+  return byPost
+}
+
+/** Ids of the posts carrying the tag, newest first. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const conn = await db()
+  const rows = await conn
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+    .orderBy(desc(postTags.postId))
+  return rows.map((row) => row.postId)
+}
+
+/** Makes the post carry exactly `names`, creating unseen tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const conn = await db()
+
+  if (names.length > 0) {
+    await conn.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing()
+  }
+  const wanted = names.length > 0 ? await conn.select().from(tags).where(inArray(tags.name, names)) : []
+  const wantedIds = new Set(wanted.map((tag) => tag.id))
+
+  const current = await conn.select().from(postTags).where(eq(postTags.postId, postId))
+  const currentIds = new Set(current.map((row) => row.tagId))
+
+  const stale = [...currentIds].filter((id) => !wantedIds.has(id))
+  if (stale.length > 0) {
+    await conn.delete(postTags).where(and(eq(postTags.postId, postId), inArray(postTags.tagId, stale)))
+  }
+  const fresh = [...wantedIds].filter((id) => !currentIds.has(id))
+  if (fresh.length > 0) {
+    await conn.insert(postTags).values(fresh.map((tagId) => ({ postId, tagId })))
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  const conn = await db()
+  await conn.delete(postTags).where(eq(postTags.postId, postId))
+}
