@@ -0,0 +1,46 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { Comment, CommentReport } from '../app/Models/Comment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  const users: Array<{ id: number }> = []
+  let postId = 0
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    await migrateDatabase()
+    void getDatabase
+    const tag = Date.now()
+    for (let i = 0; i < 5; i++) {
+      users.push((await User.create({ name: `U${i}`, email: `c${tag}-${i}@x.test`, password: 'password123' })) as { id: number })
+    }
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: users[0]!.id })
+    postId = post!.id
+  })
+
+  it('sends guests to login and stores nothing', async () => {
+    await http.post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect('/login')
+  })
+
+  it('creates, reports, hides and deletes', async () => {
+    await http.actingAs(users[1]).post(`/posts/${postId}/comments`, { body: '' }).assertStatus(422)
+    await http.actingAs(users[1]).post(`/posts/${postId}/comments`, { body: 'hello' }).assertRedirect(`/posts/${postId}`)
+    const comment = (await Comment.newQuery().where('postId', postId).first())!
+    expect(comment.userId).toBe(users[1]!.id)
+
+    await http.actingAs(users[2]).delete(`/comments/${comment.id}`).assertStatus(403)
+    for (const u of [users[2], users[2], users[3], users[4]]) {
+      await http.actingAs(u).post(`/comments/${comment.id}/report`).assertStatus(204)
+    }
+    expect((await CommentReport.newQuery().where('commentId', comment.id).get()).length).toBe(3)
+    expect((await Comment.newQuery().where('id', comment.id).get()).length).toBe(1)
+
+    await http.actingAs(users[0]).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${postId}`)
+    expect((await Comment.newQuery().where('id', comment.id).get()).length).toBe(0)
+  })
+})
