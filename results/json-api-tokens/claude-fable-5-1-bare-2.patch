+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { defineModel } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { apiRateLimitStore } from '../app/Http/Middleware/ApiToken.js'
+import { resetDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import app from '../src/app.js'
+import { Browser, script, secretOf, signedIn, type CreatedToken } from './support/clients.js'
+
+// Managing personal API tokens from a signed-in session, against the real app
+// and the test database.
+
+// The app reaches this table through the framework's token store, so the tests
+// read its rows through a model of their own.
+class ApiTokenRow extends defineModel(apiTokens) {}
+
+function tokenRows() {
+  return ApiTokenRow.all()
+}
+
+beforeAll(async () => {
+  await TestApp.fromApp(app)
+  await resetDatabase()
+})
+
+beforeEach(() => {
+  apiRateLimitStore.clear()
+})
+
+describe('POST /profile/tokens', () => {
+  it('creates a named token and shows it once', async () => {
+    const browser = await signedIn('Ada')
+    const response = await browser.request('POST', '/profile/tokens', { name: 'CI' })
+
+    expect(response.status).toBe(201)
+    const created = (await response.json()) as CreatedToken
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    expect(created.token.startsWith(`${created.id}|`)).toBe(true)
+    expect(secretOf(created.token).length).toBeGreaterThanOrEqual(16)
+
+    const another = await browser.createToken('CI')
+    expect(another.token).not.toBe(created.token)
+  })
+
+  it('stores nothing the token could be read back from', async () => {
+    const browser = await signedIn('Ada')
+    const created = await browser.createToken('old laptop')
+
+    const row = (await tokenRows()).find((candidate) => candidate.id === created.id)
+    expect(row?.name).toBe('old laptop')
+    for (const value of Object.values(row ?? {})) {
+      expect(String(value)).not.toContain(secretOf(created.token))
+    }
+  })
+
+  it('rejects a missing, empty or over-long name and creates nothing', async () => {
+    const browser = await signedIn('Ada')
+    const before = (await tokenRows()).length
+
+    for (const body of [{}, { name: '' }, { name: '   ' }, { name: 'x'.repeat(51) }, { name: 42 }]) {
+      const response = await browser.request('POST', '/profile/tokens', body)
+      expect(response.status).toBe(422)
+      expect(response.headers.get('content-type')).toContain('application/json')
+    }
+
+    expect((await tokenRows()).length).toBe(before)
+    expect((await browser.request('POST', '/profile/tokens', { name: 'x'.repeat(50) })).status).toBe(201)
+  })
+
+  it('gives a guest no token', async () => {
+    const guest = new Browser()
+    await guest.request('GET', '/login')
+    const before = (await tokenRows()).length
+
+    const response = await guest.request('POST', '/profile/tokens', { name: 'CI' })
+
+    expect([302, 303, 401]).toContain(response.status)
+    expect((await tokenRows()).length).toBe(before)
+  })
+
+  it('does not accept a bearer token in place of the session', async () => {
+    const browser = await signedIn('Ada')
+    const { token } = await browser.createToken('CI')
+    const before = (await tokenRows()).length
+
+    const response = await script('POST', '/profile/tokens', { token, body: { name: 'minted by a script' } })
+
+    expect([302, 303, 401, 403]).toContain(response.status)
+    expect((await tokenRows()).length).toBe(before)
+  })
+})
+
+describe('DELETE /profile/tokens/:id', () => {
+  it('revokes the token at once and leaves the others working', async () => {
+    const browser = await signedIn('Ada')
+    const revoked = await browser.createToken('old laptop')
+    const kept = await browser.createToken('CI')
+    expect((await script('GET', '/api/posts', { token: revoked.token })).status).toBe(200)
+
+    const response = await browser.request('DELETE', `/profile/tokens/${revoked.id}`)
+
+    expect(response.status).toBe(204)
+    expect((await script('GET', '/api/posts', { token: revoked.token })).status).toBe(401)
+    expect((await script('GET', '/api/posts', { token: kept.token })).status).toBe(200)
+    expect((await browser.request('DELETE', `/profile/tokens/${revoked.id}`)).status).toBe(404)
+  })
+
+  it("answers 404 for another user's token, which keeps working", async () => {
+    const ada = await signedIn('Ada')
+    const grace = await signedIn('Grace')
+    const theirs = await grace.createToken('CI')
+
+    const response = await ada.request('DELETE', `/profile/tokens/${theirs.id}`)
+
+    expect(response.status).toBe(404)
+    expect((await script('GET', '/api/posts', { token: theirs.token })).status).toBe(200)
+  })
+
+  it('does not accept a bearer token in place of the session', async () => {
+    const browser = await signedIn('Ada')
+    const { id, token } = await browser.createToken('CI')
+
+    const response = await script('DELETE', `/profile/tokens/${id}`, { token })
+
+    expect([302, 303, 401, 403]).toContain(response.status)
+    expect((await script('GET', '/api/posts', { token })).status).toBe(200)
+  })
+})
+
+describe('GET /profile', () => {
+  it('lists the tokens by name without their secrets', async () => {
+    const browser = await signedIn('Ada')
+    const created = await browser.createToken('release cron')
+
+    const response = await browser.request('GET', '/profile')
+    const html = await response.text()
+
+    expect(response.status).toBe(200)
+    expect(html).toContain('release cron')
+    expect(html).not.toContain(secretOf(created.token))
+  })
+})
diff --git a/tests/support/clients.ts b/tests/support/clients.ts
new file mode 100644
index 0000000..e2eac70
--- /dev/null
+++ b/tests/support/clients.ts
@@ -0,0 +1,100 @@
+import { expect } from 'bun:test'
+import app from '../../src/app.js'
+
+// The two kinds of caller the API token tests need, both straight through
+// app.fetch(): a browser holding a session, and a script holding a token.
+
+const ORIGIN = 'http://localhost'
+
+export interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+/** A browser: keeps the cookies it is sent and echoes the XSRF token on writes. */
+export class Browser {
+  private readonly cookies = new Map<string, string>()
+
+  async request(method: string, path: string, body?: unknown): Promise<Response> {
+    const headers = new Headers({ Accept: 'application/json' })
+    if (this.cookies.size > 0) {
+      headers.set('Cookie', [...this.cookies].map(([name, value]) => `${name}=${value}`).join('; '))
+    }
+    const xsrf = this.cookies.get('XSRF-TOKEN')
+    if (xsrf && method !== 'GET') {
+      headers.set('X-XSRF-TOKEN', decodeURIComponent(xsrf))
+    }
+    if (body !== undefined) {
+      headers.set('Content-Type', 'application/json')
+    }
+
+    const response = await app.fetch(new Request(`${ORIGIN}${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    }))
+
+    for (const cookie of response.headers.getSetCookie()) {
+      const [pair = ''] = cookie.split(';')
+      const separator = pair.indexOf('=')
+      this.cookies.set(pair.slice(0, separator).trim(), pair.slice(separator + 1).trim())
+    }
+
+    return response
+  }
+
+  async register(name: string, email: string): Promise<void> {
+    await this.request('GET', '/register')
+    const response = await this.request('POST', '/register', {
+      name,
+      email,
+      password: 'password-123',
+      passwordConfirmation: 'password-123',
+    })
+    expect(response.status).toBeLessThan(400)
+  }
+
+  async createToken(name: string): Promise<CreatedToken> {
+    const response = await this.request('POST', '/profile/tokens', { name })
+    expect(response.status).toBe(201)
+    return (await response.json()) as CreatedToken
+  }
+}
+
+/** A browser signed in as a newly registered user. */
+export async function signedIn(name: string): Promise<Browser> {
+  const browser = new Browser()
+  await browser.register(name, `${name.toLowerCase()}-${crypto.randomUUID()}@example.com`)
+  return browser
+}
+
+export interface ScriptRequest {
+  token?: string
+  /** The raw Authorization header, for credentials that are not `Bearer <token>`. */
+  authorization?: string
+  body?: unknown
+}
+
+/** A script: no cookies, only what it is told to send. */
+export async function script(method: string, path: string, options: ScriptRequest = {}): Promise<Response> {
+  const headers = new Headers({ Accept: 'application/json' })
+  const authorization = options.authorization ?? (options.token ? `Bearer ${options.token}` : undefined)
+  if (authorization !== undefined) {
+    headers.set('Authorization', authorization)
+  }
+  if (options.body !== undefined) {
+    headers.set('Content-Type', 'application/json')
+  }
+
+  return app.fetch(new Request(`${ORIGIN}${path}`, {
+    method,
+    headers,
+    body: options.body === undefined ? undefined : JSON.stringify(options.body),
+  }))
+}
+
+/** The secret half of a `<id>|<secret>` token. */
+export function secretOf(token: string): string {
+  return token.split('|')[1] ?? ''
+}
