@@ -20,3 +23,36 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// Saving an edit must send the browser on to the post page as a normal GET.
+// Inertia/XHR re-issues a redirect with the *same* method it used for the
+// original request, so a PUT response redirected with 302 loops back into
+// this very PUT action forever (net::ERR_TOO_MANY_REDIRECTS in the browser).
+// A 303 forces the follow-up request to be a GET, matching posts.store and
+// posts.destroy.
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects to the post page with a 303 after a successful save', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const authed = http.actingAs(author)
+    const csrf = await authed.withCsrf()
+
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'Updated title', excerpt: 'Updated excerpt', body: 'Updated body' })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${post.id}`)
+  })
+})
