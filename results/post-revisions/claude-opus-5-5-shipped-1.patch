diff --git a/app/Http/Controllers/PostRevisionController.ts b/app/Http/Controllers/PostRevisionController.ts
new file mode 100644
index 0000000..7b687f0
--- /dev/null
+++ b/app/Http/Controllers/PostRevisionController.ts
@@ -0,0 +1,46 @@
+import { Controller, NotFoundHttpException } from '@guren/core'
+import { pages } from '@/.guren/pages.gen'
+import { Post } from '../../Models/Post.js'
+import { PostRevision } from '../../Models/PostRevision.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { PostIdParamSchema, PostRevisionParamSchema } from '../Validators/PostValidator.js'
+
+export default class PostRevisionController extends Controller {
+  async index(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    // History is as private as the edit form: only the author may see it.
+    await this.authorize('update', [Post, post])
+
+    // By id rather than created_at: two saves within one millisecond share a timestamp.
+    const revisions = await PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: new PostResource(post).toJSON(),
+      revisions: revisions.map((revision) => ({
+        id: revision.id,
+        title: revision.title,
+        createdAt: new Date(revision.createdAt).toISOString(),
+      })),
+    })
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(PostRevisionParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('update', [Post, post])
+
+    const revision = await PostRevision.first({ id: revisionId, postId: post.id })
+    if (!revision) {
+      throw NotFoundHttpException.forModel('PostRevision', revisionId)
+    }
+
+    await PostRevision.keep(post)
+    await Post.update(
+      { id: post.id },
+      { title: revision.title, excerpt: revision.excerpt, body: revision.body },
+    )
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+}
