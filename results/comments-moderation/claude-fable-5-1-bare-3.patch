diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..3691f3b
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,165 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { CommentResourceData } from '../app/Http/Resources/CommentResource.js'
+
+// The test database persists between runs, so every fixture gets a unique
+// email and the assertions scope themselves to the rows they created.
+const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+let userCount = 0
+
+async function makeUser(label: string): Promise<UserRecord> {
+  userCount += 1
+  return User.create({
+    name: `${label} ${runId}`,
+    email: `${label.toLowerCase()}-${userCount}-${runId}@example.com`,
+    password: 'secret',
+  })
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({
+    title: `Comments fixture ${runId}`,
+    excerpt: 'A post to comment on.',
+    body: 'Body.',
+    authorId: author.id,
+  })
+}
+
+async function pageComments(http: TestApp, postId: number): Promise<CommentResourceData[]> {
+  const response = await http.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { comments: CommentResourceData[] }).comments
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let bystander: UserRecord
+
+  const as = async (user: UserRecord) => http.actingAs(user).withCsrf('/posts')
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    postAuthor = await makeUser('Author')
+    commenter = await makeUser('Commenter')
+    bystander = await makeUser('Bystander')
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const post = await makePost(postAuthor)
+    const guest = await http.withCsrf('/posts')
+
+    await guest.post(`/posts/${post.id}/comments`, { body: 'Hello?' }).assertRedirect('/login')
+    await guest.delete('/comments/1').assertRedirect('/login')
+    await guest.post('/comments/1/report').assertRedirect('/login')
+
+    expect(await Comment.where({ postId: post.id })).toHaveLength(0)
+  })
+
+  it('stores a signed-in user\'s comment and lists it under the post, oldest first', async () => {
+    const post = await makePost(postAuthor)
+    const client = await as(commenter)
+
+    await client.post(`/posts/${post.id}/comments`, { body: 'First!' }).assertRedirect(`/posts/${post.id}`)
+    await (await as(postAuthor)).post(`/posts/${post.id}/comments`, { body: 'Thanks for reading.' }).assertRedirect(
+      `/posts/${post.id}`,
+    )
+
+    const rows = await Comment.where({ postId: post.id })
+    expect(rows).toHaveLength(2)
+    expect(rows[0]?.userId).toBe(commenter.id)
+
+    const comments = await pageComments(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['First!', 'Thanks for reading.'])
+    expect(comments[0]?.author).toEqual({ id: commenter.id, name: commenter.name })
+    expect(comments[1]?.author).toEqual({ id: postAuthor.id, name: postAuthor.name })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects a blank or too-long body without storing anything', async () => {
+    const post = await makePost(postAuthor)
+    const client = (await as(commenter)).json()
+
+    await client.post(`/posts/${post.id}/comments`, { body: '' }).assertStatus(422)
+    await client.post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertStatus(422)
+    await client.post(`/posts/${post.id}/comments`, {}).assertStatus(422)
+
+    expect(await Comment.where({ postId: post.id })).toHaveLength(0)
+  })
+
+  it('lets the comment author delete it', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Mine' })
+
+    await (await as(commenter)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    expect(await Comment.find(comment.id)).toBeNull()
+  })
+
+  it('lets the post author delete any comment on their post', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Spam' })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: bystander.id })
+
+    await (await as(postAuthor)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    expect(await Comment.find(comment.id)).toBeNull()
+    expect(await CommentReport.where({ commentId: comment.id })).toHaveLength(0)
+  })
+
+  it('answers 403 to anyone else and keeps the comment', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Stays' })
+
+    await (await as(bystander)).delete(`/comments/${comment.id}`).assertStatus(403)
+
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('records one report per user and answers 204 every time', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Hmm' })
+    const client = await as(bystander)
+
+    await client.post(`/comments/${comment.id}/report`).assertNoContent()
+    await client.post(`/comments/${comment.id}/report`).assertNoContent()
+
+    expect(await CommentReport.where({ commentId: comment.id })).toHaveLength(1)
+    expect((await pageComments(http, post.id)).map((row) => row.id)).toEqual([comment.id])
+  })
+
+  it('hides a comment from the page once three different users report it, but keeps the row', async () => {
+    const post = await makePost(postAuthor)
+    const kept = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Fine' })
+    const hidden = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Nasty' })
+    const reporters = [postAuthor, bystander, await makeUser('Third')]
+
+    for (const reporter of reporters) {
+      await (await as(reporter)).post(`/comments/${hidden.id}/report`).assertNoContent()
+    }
+
+    expect((await pageComments(http, post.id)).map((row) => row.id)).toEqual([kept.id])
+    expect((await pageComments(http.actingAs(commenter), post.id)).map((row) => row.id)).toEqual([kept.id])
+    expect((await pageComments(http.actingAs(postAuthor), post.id)).map((row) => row.id)).toEqual([kept.id])
+    expect(await Comment.find(hidden.id)).not.toBeNull()
+    expect(await CommentReport.where({ commentId: hidden.id })).toHaveLength(3)
+  })
+
+  it('removes a post\'s comments and their reports along with the post', async () => {
+    const post = await makePost(postAuthor)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: commenter.id, body: 'Bye' })
+    await CommentReport.forceCreate({ commentId: comment.id, userId: bystander.id })
+
+    await (await as(postAuthor)).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await Comment.where({ postId: post.id })).toHaveLength(0)
+    expect(await CommentReport.where({ commentId: comment.id })).toHaveLength(0)
+  })
+})
