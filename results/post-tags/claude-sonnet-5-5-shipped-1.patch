diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..c15aaf3
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,44 @@
+import { defineModel } from '@guren/core'
+import { tags, postTags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {}
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+/** Tag names per post id, sorted alphabetically; posts without tags map to []. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const result = new Map<number, string[]>(postIds.map((id) => [id, []]))
+  if (postIds.length === 0) return result
+
+  const links = await PostTag.whereIn('postId', postIds).get()
+  const tagIds = [...new Set(links.map((link) => link.tagId))]
+  const names = new Map((await Tag.whereIn('id', tagIds).get()).map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = names.get(link.tagId)
+    if (name !== undefined) result.get(link.postId)?.push(name)
+  }
+  for (const list of result.values()) list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  return result
+}
+
+/** Replaces the post's tag set with `names`, creating tags never seen before. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const existing = names.length > 0 ? await Tag.whereIn('name', names).get() : []
+  const ids = new Map(existing.map((tag) => [tag.name, tag.id]))
+
+  for (const name of names) {
+    if (!ids.has(name)) ids.set(name, (await Tag.create({ name })).id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const name of names) {
+    await PostTag.create({ postId, tagId: ids.get(name)! })
+  }
+}
