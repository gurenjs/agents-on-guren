@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../../src/app.js'
+import { resetDatabase } from '../../../../config/database.js'
+import { Subscription } from '../../app/Models/Subscription.js'
+
+describe('newsletter subscriptions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function guest(): Promise<TestApp> {
+    return (await http.withCsrf()).json().withHeader('Referer', 'http://localhost/posts/1')
+  }
+
+  it('stores a pending subscription and redirects back', async () => {
+    const client = await guest()
+    await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/posts/1')
+
+    const rows = await Subscription.where({ email: 'reader@example.com' }).get()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]!.confirmedAt).toBeNull()
+    expect(rows[0]!.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses', async () => {
+    const client = await guest()
+    await client.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    await client.post('/newsletter/subscribe', { email: '' }).assertStatus(422)
+
+    await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const duplicate = await client.post('/newsletter/subscribe', { email: 'reader@example.com' })
+    duplicate.assertStatus(422)
+    const body = await duplicate.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.email).toBeDefined()
+
+    expect(await Subscription.where({ email: 'reader@example.com' }).get()).toHaveLength(1)
+  })
+
+  it('confirms by token and 404s on an unknown one', async () => {
+    const client = await guest()
+    await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect()
+    const row = await Subscription.first({ email: 'reader@example.com' })
+
+    await client.get('/newsletter/confirm/not-a-real-token').assertNotFound()
+    expect((await Subscription.first({ email: 'reader@example.com' }))!.confirmedAt).toBeNull()
+
+    await client.get(`/newsletter/confirm/${row!.token}`).assertRedirect('/')
+    expect((await Subscription.first({ email: 'reader@example.com' }))!.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes one address and keeps the rest', async () => {
+    const client = await guest()
+    await client.post('/newsletter/subscribe', { email: 'a@example.com' }).assertRedirect()
+    await client.post('/newsletter/subscribe', { email: 'b@example.com' }).assertRedirect()
+
+    await client.post('/newsletter/unsubscribe', { email: 'a@example.com' }).assertRedirect('/posts/1')
+
+    expect(await Subscription.first({ email: 'a@example.com' })).toBeNull()
+    expect(await Subscription.first({ email: 'b@example.com' })).not.toBeNull()
+  })
+})
