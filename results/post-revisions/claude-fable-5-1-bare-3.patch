+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import type { PostRevisionResourceData } from '@/app/Http/Resources/PostRevisionResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  // Newest first, as the controller orders them.
+  revisions: PostRevisionResourceData[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History of ${post.title}`} />
+      <section className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            History
+          </h1>
+          <p className="text-sm text-g-muted">
+            Earlier versions of{' '}
+            <Link href={route('posts.show', { id: post.id })} className="text-g-accent-text transition hover:underline">
+              {post.title}
+            </Link>
+            . Restoring one keeps the current version here too, so nothing is lost.
+          </p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No earlier versions yet — a revision is kept each time you save an edit.</p>
+        ) : (
+          <ol className="space-y-4">
+            {revisions.map((revision) => (
+              <li key={revision.id} className="rounded-g-card border border-g-line bg-g-panel p-5 shadow-g-card">
+                <div className="flex items-start justify-between gap-4">
+                  <div className="min-w-0 space-y-1">
+                    <h2 className="text-lg font-bold text-g-heading">{revision.title}</h2>
+                    <p className="font-mono text-xs uppercase tracking-wide text-g-muted">
+                      Kept {new Date(revision.createdAt).toLocaleString()}
+                    </p>
+                    <p className="text-sm text-g-text-2">{revision.excerpt}</p>
+                  </div>
+                  {/* Inertia's Link posts through Axios, which carries the CSRF
+                      header a native <form> would not. */}
+                  <Link
+                    href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                    method="post"
+                    as="button"
+                    onBefore={() => window.confirm(`Restore "${revision.title}"? The current version will be kept in this list.`)}
+                    className="shrink-0 rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-1 text-sm font-bold text-g-text transition hover:border-g-muted"
+                  >
+                    Restore
+                  </Link>
+                </div>
+                <details className="mt-3 text-sm">
+                  <summary className="cursor-pointer text-g-accent-text transition hover:underline">Show body</summary>
+                  <div className="mt-2 whitespace-pre-wrap text-g-text">{revision.body}</div>
+                </details>
+              </li>
+            ))}
+          </ol>
+        )}
+
+        <footer className="border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </section>
+    </Layout>
+  )
+}
