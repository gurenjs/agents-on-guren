@@ -0,0 +1,77 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('profile.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('rejects a malformed email and leaves the account unchanged', async () => {
+    const user = await User.create({ name: 'Ada Lovelace', email: 'ada@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).json().withCsrf()
+
+    await csrf.put('/profile', { name: 'Ada Lovelace', email: 'not-an-email' }).assertUnprocessable()
+
+    const unchanged = await User.findOrFail(user.id)
+    if (unchanged.email !== 'ada@example.com') {
+      throw new Error('email should not have changed')
+    }
+  })
+
+  it('rejects an empty name', async () => {
+    const user = await User.create({ name: 'Ada Lovelace', email: 'ada@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).json().withCsrf()
+
+    await csrf.put('/profile', { name: '', email: 'ada@example.com' }).assertUnprocessable()
+  })
+
+  it('ignores extra fields like id and passwordHash', async () => {
+    const user = await User.create({ name: 'Ada Lovelace', email: 'ada@example.com', password: 'password123' })
+    const otherUser = await User.create({ name: 'Grace Hopper', email: 'grace@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).json().withCsrf()
+
+    await csrf
+      .put('/profile', {
+        id: otherUser.id,
+        name: 'Ada Updated',
+        email: 'ada-updated@example.com',
+        passwordHash: 'hacked',
+      })
+      .assertOk()
+
+    const stillUs = await User.findOrFail(user.id)
+    if (stillUs.name !== 'Ada Updated' || stillUs.email !== 'ada-updated@example.com') {
+      throw new Error('expected the profile fields to be saved')
+    }
+    if (stillUs.passwordHash === 'hacked') {
+      throw new Error('passwordHash must not be settable via the profile form')
+    }
+
+    const other = await User.findOrFail(otherUser.id)
+    if (other.email !== 'grace@example.com') {
+      throw new Error('other accounts must not be affected')
+    }
+  })
+
+  it('accepts a valid update, lowercasing the email and trimming the name', async () => {
+    const user = await User.create({ name: 'Ada Lovelace', email: 'ada@example.com', password: 'password123' })
+    const csrf = await http.actingAs(user).json().withCsrf()
+
+    await csrf.put('/profile', { name: '  Ada L.  ', email: 'ADA@EXAMPLE.COM' }).assertOk()
+
+    const updated = await User.findOrFail(user.id)
+    if (updated.name !== 'Ada L.' || updated.email !== 'ada@example.com') {
+      throw new Error('expected trimmed name and lowercased email to be saved')
+    }
+  })
+})
