+import { defineModel } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Reads api_tokens rows as stored, the way an audit of a leaked dump would.
+const ApiTokenRow = defineModel(apiTokens, {})
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+// The test database persists between runs, so every user gets a fresh email.
+async function createUser(label: string): Promise<UserRecord> {
+  const stamp = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+  return (await User.create({
+    name: `${label} ${stamp}`,
+    email: `${label}-${stamp}@example.com`,
+    password: 'secret-password',
+  })) as UserRecord
+}
+
+async function sessionFor(http: TestApp, user: UserRecord): Promise<TestApp> {
+  return (await http.actingAs(user).withCsrf('/profile')).json()
+}
+
+async function createToken(session: TestApp, name: string): Promise<CreatedToken> {
+  const response = await session.post('/profile/tokens', { name }).assertCreated()
+  return response.json<CreatedToken>()
+}
+
+function bearer(http: TestApp, token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('creates a named token for the signed-in user and shows it once', async () => {
+    const user = await createUser('owner')
+    const session = await sessionFor(http, user)
+
+    const created = await createToken(session, 'CI')
+
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    expect(created.id.length).toBeGreaterThan(0)
+
+    const [publicPart, secret] = created.token.split('|')
+    expect(publicPart).toBe(created.id)
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    // Only a digest is stored: no column of the row holds the secret.
+    const row = await ApiTokenRow.where({ id: created.id }).first()
+    expect(row).not.toBeNull()
+    expect(row?.userId).toBe(user.id)
+    expect(row?.name).toBe('CI')
+    for (const value of Object.values(row ?? {})) {
+      const text = typeof value === 'string' ? value : JSON.stringify(value)
+      expect(text).not.toContain(secret)
+      expect(text).not.toContain(created.token)
+    }
+
+    // The token authenticates a JSON request as its owner.
+    await bearer(http, created.token).get('/api/posts').assertOk()
+  })
+
+  it('lists the owner tokens by name on the profile page', async () => {
+    const user = await createUser('lister')
+    const session = await sessionFor(http, user)
+    await createToken(session, 'old laptop')
+
+    const response = await http.actingAs(user).json().get('/profile').assertOk()
+    const payload = await response.json<{ props: { tokens: Array<{ id: string; name: string }> } }>()
+    const names = payload.props.tokens.map((token) => token.name)
+    expect(names).toEqual(['old laptop'])
+    expect(JSON.stringify(payload)).not.toContain('hashedToken')
+  })
+
+  it('rejects a missing, empty or over-long name and creates nothing', async () => {
+    const user = await createUser('validator')
+    const session = await sessionFor(http, user)
+
+    await session.post('/profile/tokens', {}).assertStatus(422)
+    await session.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await session.post('/profile/tokens', { name: '   ' }).assertStatus(422)
+    await session.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+
+    expect(await ApiTokenRow.where({ userId: user.id }).get()).toHaveLength(0)
+
+    // Exactly 50 characters is the longest accepted name.
+    await session.post('/profile/tokens', { name: 'y'.repeat(50) }).assertCreated()
+  })
+
+  it('gives a guest no token', async () => {
+    const guest = (await http.withCsrf('/login')).json()
+    const response = await guest.post('/profile/tokens', { name: 'CI' })
+    expect([302, 303, 401]).toContain(response.status)
+    if (response.status !== 401) {
+      expect(response.headers.get('location')).toContain('/login')
+    }
+  })
+
+  it('revokes the owner token at once and leaves the others working', async () => {
+    const user = await createUser('revoker')
+    const session = await sessionFor(http, user)
+    const revoked = await createToken(session, 'CI')
+    const kept = await createToken(session, 'old laptop')
+
+    await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+
+    expect(await ApiTokenRow.where({ id: revoked.id }).first()).toBeNull()
+    await bearer(http, revoked.token).get('/api/posts').assertStatus(401)
+    await bearer(http, kept.token).get('/api/posts').assertOk()
+
+    // Revoking the same id again is a miss.
+    await session.delete(`/profile/tokens/${revoked.id}`).assertNotFound()
+  })
+
+  it("answers 404 for another user's token and keeps it working", async () => {
+    const owner = await createUser('victim')
+    const other = await createUser('intruder')
+    const ownerToken = await createToken(await sessionFor(http, owner), 'CI')
+    const otherSession = await sessionFor(http, other)
+
+    await otherSession.delete(`/profile/tokens/${ownerToken.id}`).assertNotFound()
+
+    expect(await ApiTokenRow.where({ id: ownerToken.id }).first()).not.toBeNull()
+    await bearer(http, ownerToken.token).get('/api/posts').assertOk()
+  })
+})
