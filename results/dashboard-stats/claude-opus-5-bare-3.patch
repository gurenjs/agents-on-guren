+    const recent = currentUser
+      ? await Post.newQuery()
+          .where('authorId', currentUser.id)
+          // `id` breaks ties, because SQLite stores `created_at` as a string
+          // and posts written in the same second would otherwise be unordered.
+          .orderBy('createdAt', 'desc')
