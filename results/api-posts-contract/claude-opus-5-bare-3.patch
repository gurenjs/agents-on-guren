+// Bound to the api.posts.index route contract, so the router rejects bad
+// input with a 422 before the controller runs and `guren codegen`/`audit` can
+// see what the endpoint accepts. Query values arrive as strings — `?page=2`,
+// `?author=3` — hence the coercion; `page=abc`, `page=0`, `author=abc` and
+// `author=0` all fail it.
+export const ApiListPostsQuerySchema = z.object({
+  page: z.coerce.number().int().min(1, 'Page must be 1 or greater.').default(1),
+  author: z.coerce.number().int().positive('Author must be a positive user id.').optional(),
+})
+
 export const PostSearchSchema = z.object({
   keywords: z
     .array(z.string().trim().min(1, 'Keywords must not be blank.'))
