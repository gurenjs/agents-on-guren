diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..0b904f4
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,70 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createUser(overrides: { name: string; email: string }): Promise<UserRecord> {
+    return User.create({ ...overrides, password: 'password123' })
+  }
+
+  it('shows a post count and empty state for a user with no posts', async () => {
+    const user = await createUser({ name: 'Ada', email: 'ada@example.com' })
+
+    await http
+      .actingAs(user)
+      .withHeader('X-Inertia', 'true')
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', { postCount: 0, recentPosts: [] })
+  })
+
+  it('only counts and lists the signed-in user\'s own posts, newest first, capped at 5', async () => {
+    const user = await createUser({ name: 'Ada', email: 'ada@example.com' })
+    const other = await createUser({ name: 'Bob', email: 'bob@example.com' })
+
+    await Post.forceCreate({
+      title: 'Other User Post',
+      excerpt: 'x',
+      body: 'x',
+      authorId: other.id,
+    })
+
+    const created = []
+    for (let i = 0; i < 6; i++) {
+      created.push(
+        await Post.forceCreate({
+          title: `Post ${i}`,
+          excerpt: 'x',
+          body: 'x',
+          authorId: user.id,
+        }),
+      )
+    }
+
+    const expectedRecent = created
+      .slice()
+      .reverse()
+      .slice(0, 5)
+      .map((post) => ({ id: post.id, title: post.title }))
+
+    await http
+      .actingAs(user)
+      .withHeader('X-Inertia', 'true')
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', { postCount: 6, recentPosts: expectedRecent })
+  })
+})
