index 0000000..0291122
--- /dev/null
+++ b/app/Http/Controllers/Api/ApiPostController.ts
@@ -0,0 +1,23 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    const { body: data } = this.validated('api.posts.store')
+    // forceCreate, because `authorId` is not fillable: it comes from the bearer
+    // token's owner, and the request body must never be able to set it.
+    const post = await Post.forceCreate({ ...data, authorId: Number(this.apiTokenUserId()) })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..aa6ddd1
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,26 @@
+import { Controller, createApiToken, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokenStore.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    // The only response that ever carries the plain token; the store keeps its hash.
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    // Scoped to the owner, so another user's token id is a 404 like an unknown one.
+    const token = await ApiToken.where({ id, userId: user.id }).firstOrFail()
+
+    await revokeApiToken(token.id, apiTokenStore)
+
+    return new Response(null, { status: 204 })
+  }
+}
