+import { describe, expect, it } from 'bun:test'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import type { PostRecord } from '../app/Models/Post.js'
+
+const post: PostRecord = {
+  id: 1,
+  title: 'Bees',
+  excerpt: 'Bees remember faces',
+  body: 'The long version.',
+  authorId: 7,
+  createdAt: '2026-08-18T00:00:00.000Z',
+} as PostRecord
+
+// Regression: the excerpt is what the list cards, the show page and the edit
+// form all read, so it has to survive serialization even without `author`
+// eager-loaded.
+describe('PostResource', () => {
+  it('serializes the excerpt', () => {
+    expect(new PostResource(post).toJSON().excerpt).toBe('Bees remember faces')
+  })
+
+  it('keeps the rest of the payload intact', () => {
+    const data = new PostResource(post).toJSON()
+
+    expect(data.id).toBe(1)
+    expect(data.title).toBe('Bees')
+    expect(data.body).toBe('The long version.')
+    expect(data.authorId).toBe(7)
+    expect(data.createdAt).toBe('2026-08-18T00:00:00.000Z')
+  })
+})
