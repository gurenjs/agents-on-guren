diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..7ea0064
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,302 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+interface PostsIndexPage {
+  data: PostResourceData[]
+  pagination: {
+    meta: { total: number; currentPage: number; lastPage: number }
+    links: { next: string | null; pages: Array<{ page: number; url: string | null }> }
+  }
+  tag: string | null
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function inertiaProps<TProps>(path: string): Promise<TProps> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path).assertOk()
+    const page = await response.json<{ props: TProps }>()
+    return page.props
+  }
+
+  async function savePost(title: string, tags?: string): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title, excerpt: 'Excerpt', body: 'Body', tags }).assertStatus(303)
+    const post = await Post.newQuery().orderBy('id', 'desc').firstOrFail()
+    return post.id
+  }
+
+  async function tagNames(): Promise<string[]> {
+    const tags = await Tag.all()
+    return tags.map((tag) => tag.name).sort()
+  }
+
+  async function attachedTo(postId: number): Promise<string[]> {
+    const rows = await PostTag.where({ postId }).get()
+    const tags = await Tag.where({ id: rows.map((row) => row.tagId) }).get()
+    expect(tags).toHaveLength(rows.length)
+    return tags.map((tag) => tag.name).sort()
+  }
+
+  async function showTags(postId: number): Promise<string[]> {
+    const { post } = await inertiaProps<{ post: PostResourceData }>(`/posts/${postId}`)
+    return post.tags
+  }
+
+  describe('saving', () => {
+    it('creates unknown tags and attaches every listed name', async () => {
+      const id = await savePost('Tagged', 'webdev, bun')
+
+      expect(await tagNames()).toEqual(['bun', 'webdev'])
+      expect(await attachedTo(id)).toEqual(['bun', 'webdev'])
+      expect(await showTags(id)).toEqual(['bun', 'webdev'])
+    })
+
+    it('reuses a tag another post already carries', async () => {
+      const first = await savePost('First', 'bun')
+      const second = await savePost('Second', 'bun, webdev')
+
+      expect(await tagNames()).toEqual(['bun', 'webdev'])
+      expect(await attachedTo(first)).toEqual(['bun'])
+      expect(await attachedTo(second)).toEqual(['bun', 'webdev'])
+    })
+
+    it('detaches a name removed on edit and keeps the unused tag', async () => {
+      const id = await savePost('Tagged', 'bun, webdev')
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${id}`, { title: 'Tagged', excerpt: 'Excerpt', body: 'Body', tags: 'bun' })
+        .assertRedirect(`/posts/${id}`)
+
+      expect(await attachedTo(id)).toEqual(['bun'])
+      expect(await showTags(id)).toEqual(['bun'])
+      expect(await tagNames()).toEqual(['bun', 'webdev'])
+    })
+
+    it('attaches a name added on edit next to the ones kept', async () => {
+      const id = await savePost('Tagged', 'bun')
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${id}`, { title: 'Tagged', excerpt: 'Excerpt', body: 'Body', tags: 'bun, orm' })
+        .assertRedirect(`/posts/${id}`)
+
+      expect(await attachedTo(id)).toEqual(['bun', 'orm'])
+      expect(await PostTag.where({ postId: id }).count()).toBe(2)
+    })
+
+    it.each([
+      ['left out', undefined],
+      ['empty', ''],
+      ['only separators', ' , ,'],
+    ])('leaves the post without tags when the field is %s', async (_case, tags) => {
+      const id = await savePost('Tagged', 'bun, webdev')
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .put(`/posts/${id}`, { title: 'Tagged', excerpt: 'Excerpt', body: 'Body', tags })
+        .assertRedirect(`/posts/${id}`)
+
+      expect(await attachedTo(id)).toEqual([])
+      expect(await showTags(id)).toEqual([])
+    })
+
+    it('creates a post without tags when the field is left out', async () => {
+      const id = await savePost('Untagged')
+
+      expect(await Tag.newQuery().count()).toBe(0)
+      expect(await showTags(id)).toEqual([])
+    })
+
+    it('starts the edit form with the current tags', async () => {
+      const id = await savePost('Tagged', 'webdev, bun')
+
+      const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${id}/edit`).assertOk()
+      const page = await response.json<{ component: string; props: { post: PostResourceData } }>()
+
+      expect(page.component).toBe('posts/Edit')
+      expect(page.props.post.tags).toEqual(['bun', 'webdev'])
+    })
+
+    it('deletes a tagged post together with its attachments', async () => {
+      const kept = await savePost('Kept', 'bun')
+      const id = await savePost('Doomed', 'bun, webdev')
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.delete(`/posts/${id}`).assertRedirect('/posts')
+
+      expect(await Post.find(id)).toBeNull()
+      expect(await PostTag.where({ postId: id }).count()).toBe(0)
+      expect(await attachedTo(kept)).toEqual(['bun'])
+    })
+  })
+
+  describe('field rules', () => {
