@@ -0,0 +1,46 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, isSafeRedirectUrl, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class NewsletterSubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // 32 random bytes → 43 base64url characters; unguessable, URL-safe.
+    const token = randomBytes(32).toString('base64url')
+    await NewsletterSubscription.forceCreate({ email, token, confirmedAt: null })
+
+    return this.redirectBack()
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    if (subscription.confirmedAt === null) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirectBack()
+  }
+
+  // Only a same-origin Referer is followed, so the header cannot be used as an open redirect.
+  private redirectBack(): Response {
+    const referer = this.request.header('referer')
+    const target = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+    return this.redirect(target)
+  }
+}
