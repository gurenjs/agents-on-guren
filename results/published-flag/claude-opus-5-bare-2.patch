@@ -0,0 +1,144 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { eq, inArray } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase } from '../config/database.js'
+import { posts, users } from '../db/schema.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// `actingAs` injects the user through a header the auth middleware only trusts
+// when GUREN_TESTING is set.
+process.env.GUREN_TESTING = '1'
+
+const AUTHOR_EMAIL = 'drafts-author@example.com'
+const OTHER_EMAIL = 'drafts-reader@example.com'
+const DRAFT_KEYWORD = 'zibbleflux'
+
+let http: TestApp
+let author: { id: number; name: string; email: string }
+let other: { id: number; name: string; email: string }
+let draftId: number
+let publishedId: number
+
+async function inertiaProps(response: Response): Promise<Record<string, unknown>> {
+  const { payload } = await readInertiaResponse(response)
+  return payload.props as Record<string, unknown>
+}
+
+describe('post drafts', () => {
+  beforeAll(async () => {
+    // Booting the app runs the migrations, so the `published` column exists.
+    http = await TestApp.fromApp(app)
+    const db = await getDatabase()
+
+    const emails = [AUTHOR_EMAIL, OTHER_EMAIL]
+    const stale = await db.select().from(users).where(inArray(users.email, emails))
+    if (stale.length > 0) {
+      await db.delete(posts).where(inArray(posts.authorId, stale.map((user) => user.id)))
+      await db.delete(users).where(inArray(users.email, emails))
+    }
+
+    const inserted = await db
+      .insert(users)
+      .values(
+        emails.map((email) => ({ name: email, email, passwordHash: 'not-used-by-actingAs' })),
+      )
+      .returning()
+    author = inserted.find((user) => user.email === AUTHOR_EMAIL)!
+    other = inserted.find((user) => user.email === OTHER_EMAIL)!
+
+    const created = await db
+      .insert(posts)
+      .values([
+        {
+          title: `Draft about ${DRAFT_KEYWORD}`,
+          excerpt: 'Still being written.',
+          body: 'Not for anyone else yet.',
+          published: false,
+          authorId: author.id,
+        },
+        {
+          title: 'A published post',
+          excerpt: 'Anyone may read this one.',
+          body: 'Public.',
+          published: true,
+          authorId: author.id,
+        },
+      ])
+      .returning()
+    draftId = created[0]!.id
+    publishedId = created[1]!.id
+  })
+
+  it('hides drafts from the list for guests and other users', async () => {
