diff --git a/app/Http/Middleware/BearerTokenAuth.ts b/app/Http/Middleware/BearerTokenAuth.ts
new file mode 100644
index 0000000..94ebedb
--- /dev/null
+++ b/app/Http/Middleware/BearerTokenAuth.ts
@@ -0,0 +1,27 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { ApiTokenService } from '../../Services/ApiTokenService.js'
+
+export const bearerTokenAuth = defineMiddleware(async (c, next) => {
+  const authHeader = c.req.header('Authorization')
+  const token = authHeader?.match(/^Bearer\s+(\S+)$/)?.[1]
+
+  if (!token) {
+    return c.json({ message: 'Unauthenticated.' }, { status: 401 })
+  }
+
+  const tokenHash = ApiTokenService.hashToken(token)
+  const apiToken = await ApiToken.where({ tokenHash })
+    .whereNull('revokedAt')
+    .with('user')
+    .first()
+
+  if (!apiToken) {
+    return c.json({ message: 'Unauthenticated.' }, { status: 401 })
+  }
+
+  c.set('apiToken', apiToken)
+  c.set('user', (apiToken as any).user)
+
+  return next()
+})
diff --git a/app/Http/Middleware/RateLimitApiToken.ts b/app/Http/Middleware/RateLimitApiToken.ts
