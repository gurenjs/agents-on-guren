diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..1aed83d
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,118 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment, type CommentRecord } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let http: TestApp
+let seq = 0
+
+async function makeUser(): Promise<UserRecord> {
+  seq += 1
+  return (await User.create({ name: `User ${seq}`, email: `user${seq}@example.com`, password: 'secret123' })) as UserRecord
+}
+
+async function makePost(author: UserRecord): Promise<PostRecord> {
+  return (await Post.forceCreate({ title: 'T', excerpt: 'E', body: 'B', authorId: author.id })) as PostRecord
+}
+
+async function makeComment(post: PostRecord, author: UserRecord, body = 'hi'): Promise<CommentRecord> {
+  return (await Comment.forceCreate({ body, postId: post.id, userId: author.id })) as CommentRecord
+}
+
+async function showProps(postId: number, viewer?: UserRecord) {
+  const client = viewer ? http.actingAs(viewer) : http
+  const res = await client.withHeaders({ 'X-Inertia': 'true', 'X-Requested-With': 'XMLHttpRequest' }).get(`/posts/${postId}`)
+  const page = await res.json<{ props: { comments: Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }> } }>()
+  return page.props
+}
+
+describe('comments', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores a comment and lists it oldest first with its author', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const post = await makePost(author)
+
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const props = await showProps(post.id)
+    expect(props.comments.map((c) => c.body)).toEqual(['first', 'second'])
+    expect(props.comments[0]?.author).toEqual({ id: reader.id, name: reader.name })
+    expect(Number.isNaN(Date.parse(props.comments[0]!.createdAt))).toBe(false)
+  })
+
+  it('rejects an empty or oversized body', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const postAuthor = await makeUser()
+    const commenter = await makeUser()
+    const stranger = await makeUser()
+    const post = await makePost(postAuthor)
+    const a = await makeComment(post, commenter)
+    const b = await makeComment(post, commenter)
+
+    await (await http.actingAs(stranger).withCsrf()).delete(`/comments/${a.id}`).assertForbidden()
+    expect(await Comment.find(a.id)).not.toBeNull()
+
+    await (await http.actingAs(commenter).withCsrf()).delete(`/comments/${a.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(a.id)).toBeNull()
+
+    await (await http.actingAs(postAuthor).withCsrf()).delete(`/comments/${b.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(b.id)).toBeNull()
+  })
+
+  it('counts a repeated report once and hides after three reporters', async () => {
+    const postAuthor = await makeUser()
+    const post = await makePost(postAuthor)
+    const comment = await makeComment(post, postAuthor)
+    const reporters = [await makeUser(), await makeUser(), await makeUser()]
+
+    const first = await http.actingAs(reporters[0]!).withCsrf()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+
+    await (await http.actingAs(reporters[1]!).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(post.id, postAuthor)).comments).toHaveLength(1)
+
+    await (await http.actingAs(reporters[2]!).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await showProps(post.id, postAuthor)).comments).toHaveLength(0)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    await makeComment(post, author)
+    await (await http.actingAs(author).withCsrf()).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
