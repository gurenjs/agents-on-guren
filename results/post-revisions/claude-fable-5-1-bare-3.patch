diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..69a0cd2
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,168 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Runs against the test database (NODE_ENV=test), which booting the app
+// migrates. The file outlives a run, so every fixture is created fresh with a
+// unique email and the assertions only ever look at the posts made here.
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  const content = (title: string) => ({ title, excerpt: `${title} excerpt`, body: `${title} body` })
+
+  async function createUser(name: string): Promise<UserRecord> {
+    return User.create({
+      name,
+      email: `${name}-${crypto.randomUUID()}@example.test`,
+      password: 'secret-password',
+    })
+  }
+
+  async function createPost(title: string, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ ...content(title), authorId: owner.id })
+  }
+
+  async function revisionsOf(post: PostRecord) {
+    return PostRevision.newQuery().where('postId', post.id).orderBy('id', 'desc').get()
+  }
+
+  async function listedRevisions(post: PostRecord) {
+    const response = await http.actingAs(author).get(`/posts/${post.id}/revisions`).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    expect(payload.component).toBe('posts/Revisions')
+    return payload.props.revisions as Array<{ id: number; title: string; createdAt: string }>
+  }
+
+  beforeAll(async () => {
+    // Mutating requests are CSRF-protected, so the client is primed like a
+    // browser that has loaded a page first.
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    author = await createUser('author')
+    stranger = await createUser('stranger')
+  })
+
+  it('keeps nothing when a post is created', async () => {
+    const response = await http.actingAs(author).post('/posts', content('Created'))
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+    const post = await Post.findOrFail(id)
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    const post = await createPost('First')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third')).assertRedirect(`/posts/${post.id}`)
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Third')
+    const revisions = await revisionsOf(post)
+    expect(revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(revisions[1]).toMatchObject({ postId: post.id, ...content('First') })
+    expect(new Date(revisions[1]!.createdAt).toISOString()).toBe(revisions[1]!.createdAt)
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await createPost('Untouched')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { ...content('Invalid'), title: '' }).assertUnprocessable()
+    await http.actingAs(stranger).put(`/posts/${post.id}`, content('Hijacked')).assertForbidden()
+    await http.put(`/posts/${post.id}`, content('Guest')).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Untouched')
+    expect(await revisionsOf(post)).toHaveLength(0)
+  })
+
+  it('lists revisions newest first', async () => {
+    const post = await createPost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second'))
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third'))
+
+    const listed = await listedRevisions(post)
+    const stored = await revisionsOf(post)
+
+    expect(listed.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(listed.map((revision) => revision.id)).toEqual(stored.map((revision) => revision.id))
+    expect(typeof listed[0]!.createdAt).toBe('string')
+  })
+
+  it('lists only the revisions of the post asked for', async () => {
+    const post = await createPost('Mine')
+    const other = await createPost('Other')
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Other edited'))
+
+    expect(await listedRevisions(post)).toEqual([])
+  })
+
+  it('restores a revision and keeps the version it replaces', async () => {
+    const post = await createPost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second'))
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third'))
+    const first = (await revisionsOf(post)).find((revision) => revision.title === 'First')!
+
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    expect(await Post.findOrFail(post.id)).toMatchObject(content('First'))
+    const listed = await listedRevisions(post)
+    expect(listed.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+    expect(listed[2]!.id).toBe(first.id)
+  })
+
+  it('refuses everyone but the author', async () => {
+    const post = await createPost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second'))
+    const [revision] = await revisionsOf(post)
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(stranger).post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionsOf(post)).toHaveLength(1)
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const post = await createPost('Mine')
+    const other = await createPost('Other')
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Other edited'))
+    const [foreign] = await revisionsOf(other)
+
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/999999999/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+
+  it('deletes the history with the post, and only that history', async () => {
+    const post = await createPost('Doomed')
+    const other = await createPost('Survivor')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Doomed edited'))
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Survivor edited'))
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+
+  it('deletes a post that has no history', async () => {
+    const post = await createPost('Never edited')
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+  })
+})
