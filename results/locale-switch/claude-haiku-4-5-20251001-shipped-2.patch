new file mode 100644
index 0000000..bcd0ab3
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,20 @@
+import { Controller } from '@guren/core'
+import z from 'zod'
+import { isSafeRedirectUrl } from '@guren/core'
+
+const LocaleSchema = z.object({
+  locale: z.enum(['en', 'ja']),
+})
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = await this.validateBody(LocaleSchema)
+
+    const referer = this.request.header('referer') || '/'
+    const redirectUrl = isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    const response = this.redirect(redirectUrl)
+    response.headers.append('Set-Cookie', `locale=${locale}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax`)
+    return response
+  }
+}
