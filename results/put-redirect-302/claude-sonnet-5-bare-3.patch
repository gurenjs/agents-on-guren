-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,44 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.update redirects with 303 rather than 302: the request arrives as a
+// PUT, and a 302 tells fetch/browsers to replay the *same method* against
+// the Location — a PUT back to posts.update itself, forever. 303 always
+// switches the follow-up to GET, landing on posts.show like publishing a
+// new post already does. Regression test for that redirect loop.
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects to the post with 303 so the browser follows up with GET', async () => {
+    const author = await User.create({
+      name: 'Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, {
+        title: 'Updated title',
+        excerpt: 'Updated excerpt',
+        body: 'Updated body',
+      })
+      .assertStatus(303)
+      .assertRedirect(`/posts/${post.id}`)
+  })
+})
