+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+// The one token store the app configures: AuthProvider hands it to
+// `auth.useTokens()` so bearer credentials on `/mcp` resolve to a user, and
+// anything that issues tokens (ops from a terminal, tests) writes to the
+// same table through the same instance.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
