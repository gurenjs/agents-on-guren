diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..51d0eb7
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,29 @@
+import { defineModel } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import { Post, type PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+type PostContent = Pick<PostRecord, 'title' | 'excerpt' | 'body'>
+
+export class PostRevision extends defineModel(postRevisions, {
+  fillable: ['postId', 'title', 'excerpt', 'body'],
+}) {
+  /**
+   * Overwrites the post's content, keeping its current title, excerpt and body
+   * as a revision in the same transaction — a failed save keeps nothing.
+   */
+  static async replaceContent(post: PostRecord, content: PostContent): Promise<void> {
+    await Post.transaction(async (trx) => {
+      await PostRevision.create(
+        { postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body },
+        { trx },
+      )
+      await Post.update(
+        { id: post.id },
+        { title: content.title, excerpt: content.excerpt, body: content.body },
+        { trx },
+      )
+    })
+  }
+}
