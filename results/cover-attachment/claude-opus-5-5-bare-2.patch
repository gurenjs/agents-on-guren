+const PNG = new Uint8Array([
+  0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00,
+  0x01, 0x00, 0x00, 0x00, 0x01, 0x08, 0x06, 0x00, 0x00, 0x00, 0x1f, 0x15, 0xc4, 0x89, 0x00, 0x00, 0x00, 0x0d, 0x49,
+  0x44, 0x41, 0x54, 0x78, 0x9c, 0x63, 0xf8, 0xcf, 0xc0, 0xf0, 0x1f, 0x00, 0x05, 0x00, 0x01, 0xff, 0x89, 0x99, 0x3d,
+  0x1d, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82,
+])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0x01, 0xff, 0xd9])
+const GIF = new TextEncoder().encode('GIF89a\x01\x00\x01\x00\x00\x00\x00;')
+
+interface PagePost {
+  id: number
+  coverUrl: string | null
+}
+
+function postForm(fields: Record<string, string | File>): FormData {
+  const form = new FormData()
+  form.set('title', 'Cover test')
+  form.set('excerpt', 'An excerpt')
+  form.set('body', 'A body')
+  for (const [key, value] of Object.entries(fields)) form.set(key, value)
+  return form
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: TestApp
+  const createdIds: number[] = []
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    const user = await User.create({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    author = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  afterAll(async () => {
+    for (const id of createdIds) {
+      await Post.purgeAttachments(id)
+      await Post.delete({ id })
+    }
+  })
+
+  async function showPost(id: number): Promise<PagePost> {
+    const response = await author.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${id}`)
+    expect(response.status).toBe(200)
+    const page = await response.json<{ props: { post: PagePost } }>()
+    return page.props.post
+  }
+
+  async function latestPostId(): Promise<number> {
+    const [post] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+    return post!.id
+  }
+
+  async function createPost(fields: Record<string, string | File>): Promise<number> {
+    const response = await author.post('/posts', postForm(fields))
+    expect(response.status).toBe(303)
+    const id = await latestPostId()
+    createdIds.push(id)
+    return id
+  }
+
+  async function countRows(): Promise<{ posts: number; attachments: number }> {
+    return { posts: await Post.newQuery().count(), attachments: await Attachment.newQuery().count() }
+  }
+
+  async function coverRows(id: number): Promise<number> {
+    return Attachment.where({ attachableId: String(id) }).count()
+  }
+
+  it('creates a post without a cover', async () => {
+    const id = await createPost({ cover: new File([], '', { type: 'application/octet-stream' }) })
+    expect((await showPost(id)).coverUrl).toBeNull()
+  })
+
+  it('stores and serves an uploaded PNG unchanged', async () => {
+    const id = await createPost({ cover: new File([PNG], 'cover.png', { type: 'image/png' }) })
+    const { coverUrl } = await showPost(id)
+    expect(coverUrl).not.toBeNull()
+
+    const served = await author.get(coverUrl!)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toStartWith('image/png')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    const row = await Attachment.first({ attachableId: String(id) })
+    const path = (row as { path: string }).path
+    expect(existsSync(`storage/app/testing/${path}`)).toBe(true)
+  })
+
+  it('judges the format by the bytes, not the declared type', async () => {
+    const id = await createPost({ cover: new File([JPEG], 'photo', { type: 'application/octet-stream' }) })
+    const served = await author.get((await showPost(id)).coverUrl!)
+    expect(served.headers.get('content-type')).toStartWith('image/jpeg')
+  })
+
+  it('refuses a GIF and an oversized image on the cover field, saving nothing', async () => {
+    const before = await countRows()
+
+    for (const cover of [
+      new File([GIF], 'cover.gif', { type: 'image/gif' }),
+      new File([PNG, new Uint8Array(2 * 1024 * 1024)], 'big.png', { type: 'image/png' }),
+      new File([GIF], 'lying.png', { type: 'image/png' }),
+    ]) {
+      const response = await author.withHeaders({ Accept: 'application/json' }).post('/posts', postForm({ cover }))
+      expect(response.status).toBe(422)
+      const body = await response.json<{ errors: Record<string, unknown> }>()
+      expect(Object.keys(body.errors)).toEqual(['cover'])
+    }
+
+    expect(await countRows()).toEqual(before)
+  })
+
+  it('replaces, keeps and removes a cover on edit', async () => {
+    const id = await createPost({ cover: new File([PNG], 'cover.png', { type: 'image/png' }) })
+    const first = (await showPost(id)).coverUrl!
+
+    await author.put(`/posts/${id}`, postForm({ cover: new File([JPEG], 'cover.jpg', { type: 'image/jpeg' }) }))
+    const second = (await showPost(id)).coverUrl!
+    expect(second).not.toBe(first)
+    expect((await author.get(first)).status).toBe(404)
+    const served = await author.get(second)
+    expect(served.headers.get('content-type')).toStartWith('image/jpeg')
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(JPEG)
+
+    // A refused replacement keeps the current cover.
+    const refused = await author
+      .withHeaders({ Accept: 'application/json' })
+      .put(`/posts/${id}`, postForm({ cover: new File([GIF], 'cover.gif', { type: 'image/gif' }) }))
+    expect(refused.status).toBe(422)
+    expect((await author.get(second)).status).toBe(200)
+
+    // Neither a file nor the checkbox: the cover stays.
+    await author.put(`/posts/${id}`, postForm({}))
+    expect((await author.get((await showPost(id)).coverUrl!)).status).toBe(200)
+
+    await author.put(`/posts/${id}`, postForm({ removeCover: '1' }))
+    expect((await showPost(id)).coverUrl).toBeNull()
+    expect(await coverRows(id)).toBe(0)
+  })
+
+  it('deletes the cover with its post', async () => {
+    const id = await createPost({ cover: new File([PNG], 'cover.png', { type: 'image/png' }) })
+    const { coverUrl } = await showPost(id)
+    const row = (await Attachment.first({ attachableId: String(id) })) as { path: string }
+
+    await author.delete(`/posts/${id}`)
+
+    expect((await author.get(coverUrl!)).status).toBe(404)
+    expect(await coverRows(id)).toBe(0)
+    expect(existsSync(`storage/app/testing/${row.path}`)).toBe(false)
+  })
+})
