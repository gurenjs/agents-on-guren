@@ -0,0 +1,22 @@
+import { createMailManager } from '@guren/core'
+
+// MAIL_MAILER selects the transport: 'log' (the default, used in
+// development) writes the message to the server log instead of delivering
+// it; 'resend' sends through the Resend API. Mailables never name a
+// transport directly, so switching environments is only ever a `.env`
+// change.
+function resolveMailer(): string {
+  return process.env.MAIL_MAILER ?? 'log'
+}
+
+export const mailManager = createMailManager({
+  default: resolveMailer(),
+  from: {
+    email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME,
+  },
+  transports: {
+    log: { driver: 'log' },
+    resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY },
+  },
+})
diff --git a/config/queue.ts b/config/queue.ts
new file mode 100644
index 0000000..82cd785
--- /dev/null
+++ b/config/queue.ts
@@ -0,0 +1,18 @@
+import { createQueueManager, SyncDriver, RedisDriver, createRedisClient } from '@guren/core'
+
+// QUEUE_CONNECTION selects the driver: 'sync' (the default, used in
+// development) runs a dispatched job immediately, in the same process;
+// 'redis' hands it to a separate worker process instead. Job.dispatch()
+// reads whichever driver this resolves to, so switching environments is
+// only ever a `.env` change — no code here needs to know which one is live.
+function resolveConnection(): string {
+  return process.env.QUEUE_CONNECTION ?? 'sync'
+}
+
+export const queueManager = createQueueManager({
+  default: resolveConnection(),
+  drivers: {
+    sync: () => new SyncDriver(),
+    redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+  },
+})
