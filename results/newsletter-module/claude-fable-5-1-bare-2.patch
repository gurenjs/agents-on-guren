--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,24 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Read by `bunx guren check` (and `--arch` alone). These add to the built-in
+// module boundary, which still lets outside code import a module's index.ts
+// and db/schema.ts.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      // The newsletter ships with the next product as is, so the blog must not
+      // come to depend on it. src/app.ts mounting the module is the only link.
+      from: 'blog',
+      disallow: 'newsletter',
+      // A type-only import is still the blog knowing about the module.
+      includeTypeImports: true,
+      message:
+        'The blog must not depend on the newsletter module: modules/newsletter/ is lifted into other apps as is. ' +
+        'Keep newsletter code inside the module; src/app.ts registering it is the only link.',
+    },
+  ],
+})
