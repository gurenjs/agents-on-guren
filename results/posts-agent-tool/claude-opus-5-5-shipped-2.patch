+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken, DatabaseApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+interface ToolResult {
+  isError?: boolean
+  content: Array<{ type: string; text: string }>
+  structuredContent?: unknown
+}
+
+describe('/mcp endpoint', () => {
+  let http: TestApp
+  let bearer: string
+  let userId: number
+  let nextId = 1
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    userId = Number(user.id)
+    const { plainTextToken } = await createApiToken(new DatabaseApiTokenStore(apiTokens), {
+      name: 'test assistant',
+      userId,
+      // The store's default ['*'] grants no agent tool; tool scopes are opt-in.
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  // Stateless streamable HTTP may answer with JSON or a one-event SSE stream.
+  async function rpc(method: string, params: Record<string, unknown>, token: string | null = bearer) {
+    const headers: Record<string, string> = {
+      'Content-Type': 'application/json',
+      Accept: 'application/json, text/event-stream',
+    }
+    if (token) headers.Authorization = `Bearer ${token}`
+    const response = await http.withHeaders(headers).post('/mcp', { jsonrpc: '2.0', id: nextId++, method, params })
+    const text = await response.text()
+    const data = text.trimStart().startsWith('{')
+      ? text
+      : text.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5)).join('')
+    return { status: response.status, body: data ? JSON.parse(data) : null }
+  }
+
+  async function callTool(name: string, args: Record<string, unknown>): Promise<ToolResult & { _meta?: unknown }> {
+    const { body } = await rpc('tools/call', { name, arguments: args })
+    return body.result
+  }
+
+  it('refuses a request without a credential', async () => {
+    const { status } = await rpc('tools/list', {}, null)
+    expect(status).toBe(401)
+  })
+
+  it('lists the two post tools with their read-only flags', async () => {
+    const { status, body } = await rpc('tools/list', {})
+    expect(status).toBe(200)
+    const tools = (body.result.tools as Array<{ name: string; annotations?: { readOnlyHint?: boolean } }>)
+      .filter((tool) => !tool.name.startsWith('guren_'))
+    expect(tools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('creates a post as the credential user, ignoring authorId', async () => {
+    const result = await callTool('posts_store', {
+      title: 'Bun release',
+      excerpt: 'What shipped today',
+      body: 'Details.',
+      authorId: 999,
+    })
+    expect(result.isError).not.toBe(true)
+    const posts = await Post.all()
+    expect(posts).toHaveLength(1)
+    expect(posts[0]?.authorId).toBe(userId)
+    expect(JSON.parse(result.content[0]!.text).data).toMatchObject({ title: 'Bun release', authorId: userId })
+  })
+
+  it('returns a 422 error result for input the form rejects', async () => {
+    const result = await callTool('posts_store', { title: '', excerpt: 'x', body: 'y' })
+    expect(result.isError).toBe(true)
+    // The MCP result carries the route's 422 body; the status line itself is not forwarded.
+    expect(JSON.parse(result.content[0]!.text).errors.title).toEqual(['Title is required.'])
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('searches posts with the same JSON as the QUERY route', async () => {
+    await Post.forceCreate({ title: 'About Bun', excerpt: 'fast', body: 'b', authorId: userId })
+    await Post.forceCreate({ title: 'Other', excerpt: 'unrelated', body: 'b', authorId: userId })
+
+    const result = await callTool('posts_search', { keywords: ['Bun'] })
+    expect(result.isError).not.toBe(true)
+    const payload = result.structuredContent ?? JSON.parse(result.content[0]!.text)
+    const direct = await (await http.query('/posts/search', { keywords: ['Bun'] })).json()
+    expect(payload).toEqual(direct)
+    expect((payload as { data: unknown[] }).data).toHaveLength(1)
+  })
+})
