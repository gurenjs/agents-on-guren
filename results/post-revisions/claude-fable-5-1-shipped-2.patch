+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import type { PostRevisionResourceData } from '@/app/Http/Resources/PostRevisionResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  revisions: PostRevisionResourceData[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History of ${post.title}`} />
+      <section className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Revisions
+          </h1>
+          <p className="text-g-text-2">
+            Earlier versions of “{post.title}”. Restoring one keeps the current version here too.
+          </p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-sm text-g-muted">No revisions yet — one is kept each time this post is edited.</p>
+        ) : (
+          <ol className="space-y-4">
+            {revisions.map((revision) => (
+              <li
+                key={revision.id}
+                className="flex items-start justify-between gap-4 rounded-g-card border border-g-line bg-g-panel p-5 shadow-g-card"
+              >
+                <div className="min-w-0">
+                  <h2 className="text-lg font-bold text-g-heading">{revision.title}</h2>
+                  <p className="mt-2 text-sm text-g-text-2">{revision.excerpt}</p>
+                  <p className="mt-3 font-mono text-xs uppercase tracking-wide text-g-muted">
+                    Kept <time dateTime={revision.createdAt}>{new Date(revision.createdAt).toLocaleString()}</time>
+                  </p>
+                </div>
+                <Link
+                  href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm('Restore this version?')}
+                  className="shrink-0 rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-1 text-sm font-bold text-g-text transition hover:border-g-muted"
+                >
+                  Restore
+                </Link>
+              </li>
+            ))}
+          </ol>
+        )}
+
+        <footer className="flex items-center gap-4 border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </section>
+    </Layout>
+  )
+}
