+import type { Router } from '@guren/core'
+import NewsletterController from './Http/Controllers/NewsletterController.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (newsletter) => {
+    newsletter.post('/subscribe', [NewsletterController, 'subscribe']).name('newsletter.subscribe')
+    newsletter.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+    newsletter.post('/unsubscribe', [NewsletterController, 'unsubscribe']).name('newsletter.unsubscribe')
+  })
+}
