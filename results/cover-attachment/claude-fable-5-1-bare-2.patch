diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..2ef2312
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,283 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { readdir, readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { Attachment } from '../config/attachments.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+// Feature tests for post covers, against the real app and the test database
+// (./data/guren.test.db). Every post and user made here is removed again, so
+// the file can run against a database other tests have written to.
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff, 0xe0]
+const GIF_SIGNATURE = [0x47, 0x49, 0x46, 0x38, 0x39, 0x61]
+const TWO_MEGABYTES = 2 * 1024 * 1024
+
+// A signature and then random bytes: no two uploads compare equal, in this run
+// or against a file an earlier, interrupted run left on the disk.
+function image(signature: number[], name: string, type: string, size = 64): File {
+  const bytes = new Uint8Array(size)
+  crypto.getRandomValues(bytes.subarray(0, 64))
+  bytes.set(signature)
+  return new File([bytes], name, { type })
+}
+
+const png = (size?: number) => image(PNG_SIGNATURE, 'cover.png', 'image/png', size)
+const jpeg = () => image(JPEG_SIGNATURE, 'cover.jpg', 'image/jpeg')
+const gif = () => image(GIF_SIGNATURE, 'cover.gif', 'image/gif')
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  data.set('title', 'A post with a cover')
+  data.set('excerpt', 'About the cover.')
+  data.set('body', 'The body.')
+  for (const [name, value] of Object.entries(fields)) {
+    data.set(name, value)
+  }
+  return data
+}
+
+async function filesUnder(directory: string): Promise<string[]> {
+  if (!existsSync(directory)) {
+    return []
+  }
+  const entries = await readdir(directory, { recursive: true, withFileTypes: true })
+  return entries.filter((entry) => entry.isFile()).map((entry) => join(entry.parentPath, entry.name))
+}
+
+/** Whether any file under `directory` holds exactly these bytes. */
+async function holds(directory: string, file: File): Promise<boolean> {
+  const wanted = Buffer.from(await file.arrayBuffer())
+  for (const path of await filesUnder(directory)) {
+    if (wanted.equals(await readFile(path))) {
+      return true
+    }
+  }
+  return false
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    const guest = await TestApp.fromApp(app)
+    await migrateDatabase()
+    author = await User.create({
+      name: 'Cover Author',
+      email: `cover-author-${Date.now()}@example.com`,
+      password: 'secret-password',
+    })
+    http = await guest.actingAs(author).withCsrf('/posts')
+  })
+
+  // By author rather than from a list the tests keep: a test that fails halfway
+  // has made a post it never got to record.
+  afterAll(async () => {
+    if (!author) {
+      return
+    }
+    for (const post of await Post.where({ authorId: author.id }).get()) {
+      await Post.purgeAttachments(post.id)
+      await Post.delete({ id: post.id })
+    }
+    await User.delete({ id: author.id })
+  })
+
+  async function createPost(fields: Record<string, string | File> = {}): Promise<number> {
+    const response = await http.post('/posts', form(fields))
+    expect([302, 303]).toContain(response.status)
+    const id = Number(response.headers.get('location')?.split('/').pop())
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  async function coverUrlOf(id: number): Promise<string | null> {
+    const { payload } = await readInertiaResponse((await http.get(`/posts/${id}`)).raw)
+    expect(payload.component).toBe('posts/Show')
+    const post = payload.props.post as { coverUrl: string | null }
+    expect(post).toHaveProperty('coverUrl')
+    return post.coverUrl
+  }
+
+  const attachmentRows = (id: number) => Attachment.where({ attachableType: 'Post', attachableId: String(id) }).get()
+  const postCount = async () => (await Post.all()).length
+
+  async function expectServed(url: string | null, file: File): Promise<void> {
+    expect(url).toBeString()
+    const response = await http.get(url as string)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('content-type')).toBe(file.type)
+    expect(Buffer.from(await response.raw.arrayBuffer()).equals(Buffer.from(await file.arrayBuffer()))).toBe(true)
+  }
+
+  it('leaves a post without a cover as it was', async () => {
+    const id = await createPost()
+
+    expect(await coverUrlOf(id)).toBeNull()
+    expect(await attachmentRows(id)).toHaveLength(0)
+  })
+
+  it('accepts a JSON body, as the forms send without a file', async () => {
+    const response = await http.post('/posts', { title: 'Plain', excerpt: 'No file.', body: 'Text.', cover: null })
+    expect([302, 303]).toContain(response.status)
+    const id = Number(response.headers.get('location')?.split('/').pop())
+
+    expect(await coverUrlOf(id)).toBeNull()
+  })
+
+  it('stores a PNG cover under storage/ and serves it back unchanged', async () => {
+    const cover = png()
+    const id = await createPost({ cover })
+
+    await expectServed(await coverUrlOf(id), cover)
+    expect(await attachmentRows(id)).toHaveLength(1)
+    expect(await holds('storage', cover)).toBe(true)
+    expect(await holds('public', cover)).toBe(false)
+  })
+
+  it('stores a JPEG cover', async () => {
+    const cover = jpeg()
+    const id = await createPost({ cover })
+
+    await expectServed(await coverUrlOf(id), cover)
+  })
+
+  it('carries coverUrl on every post of the list', async () => {
+    const cover = png()
+    const withCover = await createPost({ cover })
+    const without = await createPost()
+
+    const { payload } = await readInertiaResponse((await http.get('/posts')).raw)
+    expect(payload.component).toBe('posts/Index')
+    const posts = payload.props.data as Array<{ id: number; coverUrl: string | null }>
+    for (const post of posts) {
+      expect(post).toHaveProperty('coverUrl')
+    }
+
+    expect(posts.find((post) => post.id === without)?.coverUrl).toBeNull()
+    await expectServed(posts.find((post) => post.id === withCover)?.coverUrl ?? null, cover)
+  })
+
+  it('refuses a GIF like an empty title, and saves nothing', async () => {
+    const before = await postCount()
+    const cover = gif()
+
+    const emptyTitle = await http.post('/posts', form({ title: '' }))
+    const refused = await http.post('/posts', form({ cover }))
+
+    expect(refused.status).toBe(emptyTitle.status)
+    expect(refused.headers.get('content-type')).toBe(emptyTitle.headers.get('content-type'))
+    const errors = (await refused.json<{ errors: Record<string, unknown> }>()).errors
+    expect(Object.keys(errors)).toEqual(['cover'])
+    expect(await postCount()).toBe(before)
+    expect(await holds('storage', cover)).toBe(false)
+  })
+
+  it('refuses a GIF that calls itself a PNG', async () => {
+    const before = await postCount()
+    const cover = image(GIF_SIGNATURE, 'cover.png', 'image/png')
+
+    const refused = await http.post('/posts', form({ cover }))
+
+    expect(refused.status).toBe(422)
+    expect(Object.keys((await refused.json<{ errors: Record<string, unknown> }>()).errors)).toEqual(['cover'])
+    expect(await postCount()).toBe(before)
+    expect(await holds('storage', cover)).toBe(false)
+  })
+
+  it('refuses a cover over 2 MB and accepts one of exactly 2 MB', async () => {
+    const before = await postCount()
+    const oversized = png(TWO_MEGABYTES + 1)
+
+    const refused = await http.post('/posts', form({ cover: oversized }))
+
+    expect(refused.status).toBe(422)
+    expect(Object.keys((await refused.json<{ errors: Record<string, unknown> }>()).errors)).toEqual(['cover'])
+    expect(await postCount()).toBe(before)
+    expect(await holds('storage', oversized)).toBe(false)
+
+    const limit = png(TWO_MEGABYTES)
+    await expectServed(await coverUrlOf(await createPost({ cover: limit })), limit)
+  })
+
+  it('replaces the cover on edit and deletes the old file', async () => {
+    const first = png()
+    const second = jpeg()
+    const id = await createPost({ cover: first })
+    const firstUrl = await coverUrlOf(id)
+
+    await http.put(`/posts/${id}`, form({ title: 'Retitled', cover: second })).assertRedirect()
+
+    await expectServed(await coverUrlOf(id), second)
+    expect((await http.get(firstUrl as string)).status).toBe(404)
+    expect(await attachmentRows(id)).toHaveLength(1)
+    expect(await holds('storage', first)).toBe(false)
+    expect((await Post.findOrFail(id)).title).toBe('Retitled')
+  })
+
+  it('keeps the cover on an edit that names no file and ticks no box', async () => {
+    const cover = png()
+    const id = await createPost({ cover })
+
+    await http.put(`/posts/${id}`, form({ title: 'Retitled' })).assertRedirect()
+    await expectServed(await coverUrlOf(id), cover)
+
+    await http
+      .put(`/posts/${id}`, { title: 'Again', excerpt: 'Still there.', body: 'Text.', cover: null, removeCover: false })
+      .assertRedirect()
+    await expectServed(await coverUrlOf(id), cover)
+  })
+
+  it('keeps the post and its cover when the edit is refused', async () => {
+    const cover = png()
+    const rejected = gif()
+    const id = await createPost({ cover })
+
+    await http.put(`/posts/${id}`, form({ title: 'Retitled', cover: rejected })).assertStatus(422)
+
+    await expectServed(await coverUrlOf(id), cover)
+    expect(await attachmentRows(id)).toHaveLength(1)
+    expect(await holds('storage', rejected)).toBe(false)
+    expect((await Post.findOrFail(id)).title).toBe('A post with a cover')
+  })
+
+  it('removes the cover when the box is ticked', async () => {
+    const cover = png()
+    const id = await createPost({ cover })
+    const url = await coverUrlOf(id)
+
+    await http.put(`/posts/${id}`, form({ removeCover: '1' })).assertRedirect()
+
+    expect(await coverUrlOf(id)).toBeNull()
+    expect((await http.get(url as string)).status).toBe(404)
+    expect(await attachmentRows(id)).toHaveLength(0)
+    expect(await holds('storage', cover)).toBe(false)
+  })
+
+  it('deletes the cover with the post', async () => {
+    const cover = png()
+    const id = await createPost({ cover })
+    const url = await coverUrlOf(id)
+
+    await http.delete(`/posts/${id}`).assertRedirect()
+
+    expect(await Post.find(id)).toBeNull()
+    expect((await http.get(url as string)).status).toBe(404)
+    expect(await attachmentRows(id)).toHaveLength(0)
+    expect(await holds('storage', cover)).toBe(false)
+  })
+
+  it('does not serve a cover URL that was tampered with', async () => {
+    const id = await createPost({ cover: png() })
+    const url = new URL((await coverUrlOf(id)) as string, 'http://localhost')
+    url.searchParams.set('signature', 'forged')
+
+    expect((await http.get(`${url.pathname}${url.search}`)).status).toBe(404)
+  })
+})
