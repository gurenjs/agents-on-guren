@@ -0,0 +1,147 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let userCount = 0
+
+async function makeUser(): Promise<UserRecord> {
+  userCount += 1
+  return (await User.create({
+    name: `User ${userCount}`,
+    email: `user${userCount}@example.com`,
+    password: 'password123',
+  })) as UserRecord
+}
+
+async function makePost(author: UserRecord, title = 'First'): Promise<PostRecord> {
+  return (await Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })) as PostRecord
+}
+
+function postInput(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function revisionTitles(postId: number): Promise<string[]> {
+  const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+  return rows.map((row) => row.title)
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('keeps the previous version on each edit and none on create', async () => {
+    const author = await makeUser()
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post('/posts', postInput('First')).assertRedirect()
+    const post = (await Post.first({ authorId: author.id })) as PostRecord
+    expect(await revisionTitles(post.id)).toEqual([])
+
+    await csrf.put(`/posts/${post.id}`, postInput('Second')).assertRedirect(`/posts/${post.id}`)
+    await csrf.put(`/posts/${post.id}`, postInput('Third')).assertRedirect(`/posts/${post.id}`)
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+
+    const res = await csrf.get(`/posts/${post.id}/revisions`)
+    res.assertOk()
+  })
+
+  it('keeps nothing for a refused edit', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+
+    await (await http.actingAs(author).withCsrf()).json().put(`/posts/${post.id}`, { title: '' }).assertUnprocessable()
+    await (await http.actingAs(other).withCsrf()).put(`/posts/${post.id}`, postInput('Hacked')).assertForbidden()
+
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('lists revisions newest first in the page props', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, postInput('Second'))
+    await csrf.put(`/posts/${post.id}`, postInput('Third'))
+
+    const res = await http.actingAs(author).json().get(`/posts/${post.id}/revisions`).assertInertia('posts/Revisions')
+    const page = await res.json<{ props: { revisions: Array<{ id: number; title: string; createdAt: string }> } }>()
+    const revisions = page.props.revisions
+    expect(revisions.map((r) => r.title)).toEqual(['Second', 'First'])
+    expect(typeof revisions[0]?.createdAt).toBe('string')
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, postInput('Second'))
+    await csrf.put(`/posts/${post.id}`, postInput('Third'))
+
+    const first = (await PostRevision.first({ postId: post.id, title: 'First' }))!
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = (await Post.find(post.id)) as PostRecord
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and redirects guests', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+    await (await http.actingAs(author).withCsrf()).put(`/posts/${post.id}`, postInput('Second'))
+    const revision = (await PostRevision.first({ postId: post.id }))!
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await (await http.actingAs(other).withCsrf())
+      .post(`/posts/${post.id}/revisions/${revision.id}/restore`)
+      .assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await (await http.withCsrf()).post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect(((await Post.find(post.id)) as PostRecord).title).toBe('Second')
+    expect(await revisionTitles(post.id)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'Mine')
+    const otherPost = await makePost(author, 'Other')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${otherPost.id}`, postInput('Other 2'))
+    const foreign = (await PostRevision.first({ postId: otherPost.id }))!
+
+    await csrf.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+
+    expect(((await Post.find(post.id)) as PostRecord).title).toBe('Mine')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post history with the post and leaves others alone', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'Gone')
+    const kept = await makePost(author, 'Kept')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, postInput('Gone 2'))
+    await csrf.put(`/posts/${kept.id}`, postInput('Kept 2'))
+
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(kept.id)).toEqual(['Kept'])
+  })
+})
