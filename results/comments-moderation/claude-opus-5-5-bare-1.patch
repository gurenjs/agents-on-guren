diff --git a/app/Policies/CommentPolicy.ts b/app/Policies/CommentPolicy.ts
new file mode 100644
index 0000000..ab05c81
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,30 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+}
+
+interface PostLike {
+  authorId: number
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * Any signed-in user may comment and report; a comment can be deleted by the
+ * person who wrote it or by the author of the post it is on.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null, _comment: CommentLike): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike, post: PostLike): boolean {
+    if (user === null) return false
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === post.authorId
+  }
+}
