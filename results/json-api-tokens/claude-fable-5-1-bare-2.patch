+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { API_RATE_LIMIT, apiRateLimitStore } from '../app/Http/Middleware/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+import { script, secretOf, signedIn } from './support/clients.js'
+
+// The posts API as a script sees it: no cookies, only the bearer header.
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+const validPost = { title: 'Release 1.2', excerpt: 'What changed.', body: 'Everything.' }
+
+async function createPost(token: string, title: string): Promise<ApiPost> {
+  const response = await script('POST', '/api/posts', { token, body: { ...validPost, title } })
+  expect(response.status).toBe(201)
+  return ((await response.json()) as { data: ApiPost }).data
+}
+
+beforeAll(async () => {
+  await TestApp.fromApp(app)
+  await resetDatabase()
+})
+
+beforeEach(() => {
+  apiRateLimitStore.clear()
+})
+
+describe('GET /api/posts', () => {
+  it('lists every post by every author, newest first', async () => {
+    const ada = await (await signedIn('Ada')).createToken('CI')
+    const grace = await (await signedIn('Grace')).createToken('CI')
+    const first = await createPost(ada.token, 'First')
+    const second = await createPost(grace.token, 'Second')
+
+    const response = await script('GET', '/api/posts', { token: ada.token })
+
+    expect(response.status).toBe(200)
+    const { data } = (await response.json()) as { data: ApiPost[] }
+    expect(data.length).toBe(await Post.newQuery().count())
+    const ids = data.map((post) => post.id)
+    expect(ids.indexOf(second.id)).toBeLessThan(ids.indexOf(first.id))
+    const dates = data.map((post) => post.createdAt)
+    expect(dates).toEqual([...dates].sort().reverse())
+    for (const post of data) {
+      expect(typeof post.id).toBe('number')
+      expect(typeof post.title).toBe('string')
+      expect(typeof post.excerpt).toBe('string')
+      expect(typeof post.authorId).toBe('number')
+      expect(new Date(post.createdAt).toISOString()).toBe(post.createdAt)
+    }
+    expect(data.find((post) => post.id === first.id)?.authorId).toBe(first.authorId)
+    expect(data.find((post) => post.id === second.id)?.authorId).toBe(second.authorId)
+    expect(first.authorId).not.toBe(second.authorId)
+  })
+})
+
+describe('POST /api/posts', () => {
+  it("creates the post as the token's owner, whatever the body says", async () => {
+    const ada = await (await signedIn('Ada')).createToken('CI')
+    const grace = await (await signedIn('Grace')).createToken('CI')
+    const graceId = (await createPost(grace.token, 'By Grace')).authorId
+
+    const response = await script('POST', '/api/posts', {
+      token: ada.token,
+      body: { ...validPost, authorId: graceId, author_id: graceId },
+    })
+
+    expect(response.status).toBe(201)
+    const { data } = (await response.json()) as { data: ApiPost }
+    expect(data.title).toBe(validPost.title)
+    expect(data.excerpt).toBe(validPost.excerpt)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+    expect(data.authorId).not.toBe(graceId)
+    expect((await Post.findOrFail(data.id)).authorId).toBe(data.authorId)
+  })
+
+  it('answers 422 for input the web form would reject and creates nothing', async () => {
+    const { token } = await (await signedIn('Ada')).createToken('CI')
+    const before = await Post.newQuery().count()
+
+    for (const body of [{ ...validPost, title: '' }, { title: 'No body', excerpt: 'Still none.' }, {}]) {
+      const response = await script('POST', '/api/posts', { token, body })
+      expect(response.status).toBe(422)
+      expect(typeof (await response.json())).toBe('object')
+    }
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
+
+describe('unauthenticated API requests', () => {
