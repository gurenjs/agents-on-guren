diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..a31d2cb
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,59 @@
+import { mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Attachment } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPES = ['image/png', 'image/jpeg'] as const
+
+const STORAGE_DIR = join(process.cwd(), 'storage', 'attachments')
+
+const EXTENSIONS: Record<string, string> = { 'image/png': 'png', 'image/jpeg': 'jpg' }
+
+/** The content type the bytes actually are, whatever the client claimed. */
+export function sniffCoverType(bytes: Uint8Array): (typeof COVER_TYPES)[number] | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (bytes.length >= png.length && png.every((byte, i) => bytes[i] === byte)) return 'image/png'
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+export function coverUrl(coverId: number | null | undefined): string | null {
+  return coverId ? `/attachments/${coverId}` : null
+}
+
+/** Writes the file under storage/ and records it; returns the attachment id. */
+export async function storeCover(file: File, contentType: string, bytes: Uint8Array): Promise<number> {
+  await mkdir(STORAGE_DIR, { recursive: true })
+  const path = `${crypto.randomUUID()}.${EXTENSIONS[contentType]}`
+  await Bun.write(join(STORAGE_DIR, path), bytes)
+
+  try {
+    const attachment = await Attachment.forceCreate({
+      path,
+      filename: file.name || path,
+      contentType,
+      size: bytes.length,
+    })
+    return attachment.id
+  } catch (error) {
+    await rm(join(STORAGE_DIR, path), { force: true })
+    throw error
+  }
+}
+
+/** Deletes the attachment's row and its file. */
+export async function deleteCover(coverId: number | null | undefined): Promise<void> {
+  if (!coverId) return
+  const attachment = await Attachment.find(coverId)
+  if (!attachment) return
+  await Attachment.delete({ id: coverId })
+  await rm(join(STORAGE_DIR, attachment.path), { force: true })
+}
+
+export async function readCover(coverId: number): Promise<{ file: ReturnType<typeof Bun.file>; contentType: string } | null> {
+  const attachment = await Attachment.find(coverId)
+  if (!attachment) return null
+  const file = Bun.file(join(STORAGE_DIR, attachment.path))
+  if (!(await file.exists())) return null
+  return { file, contentType: attachment.contentType }
+}
