diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..498ff81
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,331 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import PostsScheduledCommand from '../app/Console/Commands/PostsScheduledCommand.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// These run against the test database (data/guren.test.db), which outlives a
+// run. Every row is tagged with a token unique to this run, looked up by it,
+// and deleted afterwards.
+const RUN = `sched${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`
+const HOUR = 60 * 60 * 1000
+
+interface PostProps {
+  id: number
+  title: string
+  publishedAt: string | null
+  scheduled: boolean
+}
+
+function isoFromNow(ms: number): string {
+  return new Date(Date.now() + ms).toISOString()
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  const createdPostIds: number[] = []
+
+  async function createPost(title: string, publishedAt: string | null, authorId = author.id): Promise<PostRecord> {
+    const post = await Post.forceCreate({
+      title: `${title} ${RUN}`,
+      excerpt: `Excerpt for ${title}`,
+      body: 'Body',
+      authorId,
+      publishedAt,
+    })
+    createdPostIds.push(post.id)
+    return post
+  }
+
+  async function inertiaProps<T>(client: TestApp, path: string): Promise<T> {
+    const response = await client.withHeader('X-Inertia', 'true').get(path).assertOk()
+    const page = (await response.json()) as { props: T }
+    return page.props
+  }
+
+  // Walks every page, so a post is not missed because older runs left rows.
+  async function listedIds(client: TestApp): Promise<Map<number, PostProps>> {
+    const found = new Map<number, PostProps>()
+    for (let page = 1; ; page++) {
+      const props = await inertiaProps<{ data: PostProps[] }>(client, `/posts?page=${page}`)
+      const before = found.size
+      for (const post of props.data) {
+        found.set(post.id, post)
+      }
+      // A page past the end brings nothing new, whether it is empty or a
+      // repeat of the last one.
+      if (found.size === before) {
+        return found
+      }
+    }
+  }
+
+  async function searchIds(client: TestApp): Promise<number[]> {
+    const response = await client.query('/posts/search', { keywords: [RUN], limit: 50 }).assertOk()
+    const payload = (await response.json()) as { data: PostProps[] }
+    return payload.data.map((post) => post.id)
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Author', email: `author-${RUN}@example.com`, password: 'secret-password' })
+    other = await User.create({ name: 'Other', email: `other-${RUN}@example.com`, password: 'secret-password' })
+  })
+
+  afterAll(async () => {
+    const written = await Post.where('title', 'like', `%${RUN}%`).get()
+    for (const id of new Set([...createdPostIds, ...written.map((post) => post.id)])) {
+      await Post.delete({ id })
+    }
+    await User.delete({ id: author.id })
+    await User.delete({ id: other.id })
+  })
+
+  describe('reading', () => {
+    let scheduled: PostRecord
+    let undated: PostRecord
+    let past: PostRecord
+
+    beforeAll(async () => {
+      scheduled = await createPost('Scheduled', isoFromNow(48 * HOUR))
+      undated = await createPost('Undated', null)
+      past = await createPost('Past', isoFromNow(-HOUR))
+    })
+
+    it('answers 404 for a scheduled post to guests and to other users', async () => {
+      await http.get(`/posts/${scheduled.id}`).assertNotFound()
+      await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('answers a guest exactly as it does for a post that does not exist', async () => {
+      const hidden = await http.withHeader('Accept', 'application/json').get(`/posts/${scheduled.id}`)
+      const missing = await http.withHeader('Accept', 'application/json').get('/posts/999999999')
+
+      expect(hidden.status).toBe(missing.status)
+      // Outside production the body also carries a stack trace, which differs.
+      const { message: hiddenMessage, exception: hiddenException } = (await hidden.json()) as Record<string, string>
+      const { message: missingMessage, exception: missingException } = (await missing.json()) as Record<string, string>
+      expect(hiddenException).toBe(missingException)
+      expect(hiddenMessage.replace(String(scheduled.id), ':id')).toBe(missingMessage.replace('999999999', ':id'))
+    })
+
+    it('shows a scheduled post to its author with the publish time', async () => {
+      const props = await inertiaProps<{ post: PostProps }>(http.actingAs(author), `/posts/${scheduled.id}`)
+
+      expect(props.post.id).toBe(scheduled.id)
+      expect(props.post.publishedAt).toBe(scheduled.publishedAt)
+      expect(props.post.scheduled).toBe(true)
+    })
+
+    it('shows posts with no date or a past date to everyone', async () => {
+      for (const client of [http, http.actingAs(other), http.actingAs(author)]) {
+        const undatedProps = await inertiaProps<{ post: PostProps }>(client, `/posts/${undated.id}`)
+        expect(undatedProps.post.publishedAt).toBeNull()
+        expect(undatedProps.post.scheduled).toBe(false)
+
+        const pastProps = await inertiaProps<{ post: PostProps }>(client, `/posts/${past.id}`)
+        expect(pastProps.post.publishedAt).toBe(past.publishedAt)
+        expect(pastProps.post.scheduled).toBe(false)
+      }
+    })
+
+    it('lists a scheduled post for its author only', async () => {
+      for (const client of [http, http.actingAs(other)]) {
+        const listed = await listedIds(client)
+        expect(listed.has(scheduled.id)).toBe(false)
+        expect(listed.has(undated.id)).toBe(true)
+        expect(listed.has(past.id)).toBe(true)
+      }
+
+      const listed = await listedIds(http.actingAs(author))
+      expect(listed.get(scheduled.id)?.publishedAt).toBe(scheduled.publishedAt)
+      expect(listed.get(scheduled.id)?.scheduled).toBe(true)
+      expect(listed.has(undated.id)).toBe(true)
+    })
+
+    it('counts only visible posts in the pagination', async () => {
+      const guest = await inertiaProps<{ pagination: { meta: { total: number } } }>(http, '/posts')
+      const owner = await inertiaProps<{ pagination: { meta: { total: number } } }>(http.actingAs(author), '/posts')
+
+      expect(owner.pagination.meta.total).toBe(guest.pagination.meta.total + 1)
+    })
+
+    it('keeps a scheduled post out of search for guests and other users', async () => {
+      for (const client of [http, http.actingAs(other)]) {
+        const ids = await searchIds(client)
+        expect(ids).not.toContain(scheduled.id)
+        expect(ids).toContain(undated.id)
+        expect(ids).toContain(past.id)
+      }
+    })
+
+    it('keeps a scheduled post off the home page, even for its author', async () => {
+      for (const client of [http, http.actingAs(author)]) {
+        const props = await inertiaProps<{ latest: PostProps[] }>(client, '/')
+        expect(props.latest.map((post) => post.id)).not.toContain(scheduled.id)
+      }
+    })
+
+    it('hides a scheduled post from other users on the routes that change it', async () => {
+      const client = await http.actingAs(other).withCsrf()
+      const payload = { title: 'Taken over', excerpt: 'x', body: 'x' }
+
+      await client.get(`/posts/${scheduled.id}/edit`).assertNotFound()
+      await client.put(`/posts/${scheduled.id}`, payload).assertNotFound()
+      await client.delete(`/posts/${scheduled.id}`).assertNotFound()
+      // A public post still answers 403, as before.
+      await client.put(`/posts/${undated.id}`, payload).assertForbidden()
+
+      expect((await Post.findOrFail(scheduled.id)).title).toBe(scheduled.title)
+    })
+
+    it('goes public once the time has passed, with nothing else run', async () => {
+      const post = await createPost('Goes live', isoFromNow(HOUR))
+      await http.get(`/posts/${post.id}`).assertNotFound()
+
+      const publishedAt = isoFromNow(-1000)
+      await Post.forceUpdate({ id: post.id }, { publishedAt })
+
+      for (const client of [http, http.actingAs(other)]) {
+        const props = await inertiaProps<{ post: PostProps }>(client, `/posts/${post.id}`)
+        expect(props.post.publishedAt).toBe(publishedAt)
+        expect((await listedIds(client)).has(post.id)).toBe(true)
+        expect(await searchIds(client)).toContain(post.id)
+      }
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    // Other rows in the database may be scheduled too; only this run's count.
+    async function report(): Promise<string[]> {
+      const output = new BufferedOutput()
+      const command = new PostsScheduledCommand()
+      command.setInput([])
+      command.setOutput(output)
+
+      expect(await command.run()).toBe(0)
+      return output.getLines().filter((line) => line.includes(RUN))
+    }
+
+    it('prints one tab-separated line per scheduled post, soonest first', async () => {
+      const later = await createPost('Report later', '2099-05-01T09:00:00.000Z')
+      const sooner = await createPost('Report sooner', '2098-01-01T00:00:00.000Z', other.id)
+      await createPost('Report past', isoFromNow(-HOUR))
+      await createPost('Report undated', null)
+
+      const lines = (await report()).filter((line) => line.includes('Report '))
+
+      expect(lines).toEqual([
+        `${sooner.id}\t${sooner.title}\t2098-01-01T00:00:00.000Z`,
+        `${later.id}\t${later.title}\t2099-05-01T09:00:00.000Z`,
+      ])
+    })
+
+    it('keeps a post on one line when its title holds a tab or a line break', async () => {
+      const post = await createPost('Split\ttitle\nhere', '2099-06-01T00:00:00.000Z')
+
+      const lines = (await report()).filter((line) => line.startsWith(`${post.id}\t`))
+
+      expect(lines).toEqual([`${post.id}\tSplit title here ${RUN}\t2099-06-01T00:00:00.000Z`])
+    })
+  })
+
+  describe('writing', () => {
+    let client: TestApp
+
+    async function findByTitle(title: string): Promise<PostRecord | null> {
+      return Post.first({ title: `${title} ${RUN}` })
+    }
+
+    function payload(title: string, extra: Record<string, unknown> = {}) {
+      return { title: `${title} ${RUN}`, excerpt: 'Excerpt', body: 'Body', ...extra }
+    }
+
+    beforeAll(async () => {
+      client = await http.actingAs(author).withCsrf()
+    })
+
+    it('stores the publish time from the create form', async () => {
+      await client.post('/posts', payload('Created scheduled', { publishAt: '2099-10-01T09:00:00.000Z' })).assertRedirect()
+
+      const post = await findByTitle('Created scheduled')
+      expect(post?.publishedAt).toBe('2099-10-01T09:00:00.000Z')
+      await http.get(`/posts/${post?.id}`).assertNotFound()
+    })
+
+    it('stores the same instant in UTC when the time carries an offset', async () => {
+      await client.post('/posts', payload('Created offset', { publishAt: '2099-10-01T18:00:00+09:00' })).assertRedirect()
+
+      expect((await findByTitle('Created offset'))?.publishedAt).toBe('2099-10-01T09:00:00.000Z')
+    })
+
+    it('publishes at once when the time is absent, null or empty', async () => {
+      await client.post('/posts', payload('Created absent')).assertRedirect()
+      await client.post('/posts', payload('Created null', { publishAt: null })).assertRedirect()
+      await client.post('/posts', payload('Created empty', { publishAt: '' })).assertRedirect()
+
+      for (const title of ['Created absent', 'Created null', 'Created empty']) {
+        const post = await findByTitle(title)
+        expect(post?.publishedAt).toBeNull()
+        await http.get(`/posts/${post?.id}`).assertOk()
+      }
+    })
+
+    it('rejects a time that is not a date and time, the way it rejects an empty title', async () => {
+      const emptyTitle = await client.post('/posts', { ...payload('x'), title: '' })
+      const notADate = await client.post('/posts', payload('Created invalid', { publishAt: 'next tuesday' }))
+
+      expect(notADate.status).toBe(emptyTitle.status)
+      expect(await findByTitle('Created invalid')).toBeNull()
+
+      for (const publishAt of ['2026-10-01', '2026-10-01T09:00', '2026-13-01T09:00:00.000Z', 1790845200000, true]) {
+        const response = await client.post('/posts', payload('Created invalid', { publishAt }))
+        expect(response.status).toBe(emptyTitle.status)
+      }
+      expect(await findByTitle('Created invalid')).toBeNull()
+    })
+
+    it('sets, changes and clears the time from the edit form', async () => {
+      const post = await createPost('Edited', null)
+      const body = { title: post.title, excerpt: post.excerpt, body: post.body }
+
+      await client.put(`/posts/${post.id}`, { ...body, publishAt: '2099-10-01T09:00:00.000Z' }).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBe('2099-10-01T09:00:00.000Z')
+      await http.get(`/posts/${post.id}`).assertNotFound()
+
