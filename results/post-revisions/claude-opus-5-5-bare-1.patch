diff --git a/tests/PostRevisions.test.ts b/tests/PostRevisions.test.ts
new file mode 100644
index 0000000..d1df702
--- /dev/null
+++ b/tests/PostRevisions.test.ts
@@ -0,0 +1,136 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test SQLite database (NODE_ENV=test). Every row is
+// created fresh per test with unique emails, so reruns never collide.
+describe('post revisions', () => {
+  let http: TestApp
+  let sequence = 0
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+    await migrateDatabase()
+  })
+
+  async function makeUser(): Promise<UserRecord> {
+    sequence += 1
+    return (await User.create({
+      name: `Author ${sequence}`,
+      email: `revisions-${Date.now()}-${sequence}@example.test`,
+      password: 'password123',
+    })) as UserRecord
+  }
+
+  async function makePost(author: UserRecord, title = 'First'): Promise<PostRecord> {
+    return (await Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })) as PostRecord
+  }
+
+  function edit(author: UserRecord, post: PostRecord, title: string) {
+    return http
+      .actingAs(author)
+      .put(`/posts/${post.id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+      .assertRedirect(`/posts/${post.id}`)
+  }
+
+  async function revisionTitles(post: PostRecord): Promise<string[]> {
+    const rows = await PostRevision.newQuery().where('postId', post.id).orderBy('id', 'desc').get()
+    return rows.map((row) => row.title)
+  }
+
+  it('keeps the previous version on each successful edit, and nothing on create', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    expect(await revisionTitles(post)).toEqual([])
+
+    await edit(author, post, 'Second')
+    await edit(author, post, 'Third')
+
+    const [first] = await PostRevision.newQuery().where('postId', post.id).orderBy('id', 'asc').get()
+    expect(first).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+    expect(await revisionTitles(post)).toEqual(['Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' })
+    await http.actingAs(other).put(`/posts/${post.id}`, { title: 'Hijack', excerpt: 'x', body: 'y' }).assertForbidden()
+
+    expect(await revisionTitles(post)).toEqual([])
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    await edit(author, post, 'Second')
+    await edit(author, post, 'Third')
+
+    const response = await http
+      .actingAs(author)
+      .withHeaders({ 'X-Inertia': 'true' })
+      .get(`/posts/${post.id}/revisions`)
+      .assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    const revisions = payload.props.revisions as { id: number; title: string; createdAt: string }[]
+
+    expect(payload.component).toBe('posts/Revisions')
+    expect(revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(typeof revisions[0]?.createdAt).toBe('string')
+  })
+
+  it('restores a revision, keeping the replaced version', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    await edit(author, post, 'Second')
+    await edit(author, post, 'Third')
+    const first = await PostRevision.newQuery().where('postId', post.id).where('title', 'First').firstOrFail()
+
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    expect(await Post.findOrFail(post.id)).toMatchObject({ title: 'First', excerpt: 'First excerpt', body: 'First body' })
+    expect(await revisionTitles(post)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users and guests, and revisions of another post', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author)
+    const otherPost = await makePost(author, 'Other')
+    await edit(author, post, 'Second')
+    await edit(author, otherPost, 'Other two')
+    const [revision] = await PostRevision.newQuery().where('postId', post.id).get()
+    const [foreign] = await PostRevision.newQuery().where('postId', otherPost.id).get()
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(other).post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/${foreign!.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect(await revisionTitles(post)).toEqual(['First'])
+  })
+
+  it('deletes a post together with its revisions only', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const kept = await makePost(author, 'Kept')
+    await edit(author, post, 'Second')
+    await edit(author, kept, 'Kept two')
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(post)).toEqual([])
+    expect(await revisionTitles(kept)).toEqual(['Kept'])
+  })
+})
