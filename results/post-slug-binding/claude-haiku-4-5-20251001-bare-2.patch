diff --git a/app/Utilities/SlugGenerator.ts b/app/Utilities/SlugGenerator.ts
new file mode 100644
index 0000000..dc240cd
--- /dev/null
+++ b/app/Utilities/SlugGenerator.ts
@@ -0,0 +1,33 @@
+const REMOVE_CHARS = /[^a-z0-9\s-]/g
+const COLLAPSE_SPACES = /\s+/g
+const COLLAPSE_DASHES = /-+/g
+
+export function generateSlug(title: string): string {
+  return title
+    .trim()
+    .toLowerCase()
+    .replace(REMOVE_CHARS, '')
+    .replace(COLLAPSE_SPACES, '-')
+    .replace(COLLAPSE_DASHES, '-')
+    .replace(/^-+|-+$/g, '')
+}
+
+export async function generateUniqueSlug(
+  baseSlug: string,
+  excludeSlug?: string,
+  findBySlug?: (slug: string) => Promise<{ slug: string } | undefined>,
+): Promise<string> {
+  if (!findBySlug) return baseSlug
+  if (excludeSlug && baseSlug === excludeSlug) return baseSlug
+
+  const existing = await findBySlug(baseSlug)
+  if (!existing) return baseSlug
+
+  for (let i = 2; i <= 1000; i++) {
+    const candidate = `${baseSlug}-${i}`
+    const conflict = await findBySlug(candidate)
+    if (!conflict) return candidate
+  }
+
+  throw new Error(`Could not generate unique slug for "${baseSlug}"`)
+}
