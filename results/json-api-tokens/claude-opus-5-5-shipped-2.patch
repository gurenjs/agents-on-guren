diff --git a/app/Http/Middleware/ApiTokenMiddleware.ts b/app/Http/Middleware/ApiTokenMiddleware.ts
new file mode 100644
index 0000000..d8be631
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenMiddleware.ts
@@ -0,0 +1,36 @@
+import {
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import { User } from '../../Models/User.js'
+
+export const API_REQUESTS_PER_MINUTE = 60
+
+/**
+ * Authenticates `Authorization: Bearer {id}|{secret}` against api_tokens and
+ * installs the token's owner as the request user. Every failure — missing,
+ * malformed, unknown, tampered or revoked — is the same JSON 401.
+ */
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+/**
+ * Per token, not per user or IP: two tokens of one account each get their own
+ * budget. Must run after `authenticateApiToken`, which puts the token on the context.
+ * The in-memory store is per process; a multi-instance deployment needs a shared one.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_REQUESTS_PER_MINUTE,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiToken(c)?.token.id ?? 'anonymous',
+  onRateLimited: (c, retryAfter) =>
+    c.json({ message: 'Too many requests.', retryAfter }, 429),
+})
