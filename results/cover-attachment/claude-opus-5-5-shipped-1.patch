+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  it('stores a PNG cover on create and serves it back byte for byte', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', postForm({}, new File([PNG], 'cover.png', { type: 'image/png' }))).assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    const url = await coverUrlOf(post!.id)
+    expect(url).not.toBeNull()
+
+    const res = await http.get(url!)
+    res.assertOk()
+    expect(res.headers.get('content-type')).toStartWith('image/png')
+    expect(new Uint8Array(await res.raw.arrayBuffer())).toEqual(PNG)
+  })
+
+  it('creates a post without a cover', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', postForm({})).assertRedirect()
+
+    const post = await Post.first({ title: 'Hello' })
+    expect(await coverUrlOf(post!.id)).toBeNull()
+  })
+
+  it('refuses a GIF and an oversized PNG without saving anything', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const gif = new File([GIF], 'cover.gif', { type: 'image/gif' })
+    await csrf.json().post('/posts', postForm({}, gif)).assertUnprocessable().assertJsonPath('errors.cover.0', 'The cover must be a PNG or JPEG image.')
+
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await csrf.json().post('/posts', postForm({}, new File([big], 'big.png', { type: 'image/png' }))).assertUnprocessable()
+
+    const disguised = new File([GIF], 'cover.png', { type: 'image/png' })
+    await csrf.json().post('/posts', postForm({}, disguised)).assertUnprocessable()
+
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+
+  it('replaces, keeps, removes, and deletes the cover', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', postForm({}, new File([PNG], 'a.png', { type: 'image/png' }))).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+    const firstUrl = (await coverUrlOf(post.id))!
+
+    await csrf.put(`/posts/${post.id}`, postForm({}, new File([JPEG], 'b.jpg', { type: 'image/jpeg' }))).assertRedirect()
+    const secondUrl = (await coverUrlOf(post.id))!
+    expect(secondUrl).not.toBe(firstUrl)
+    expect((await http.get(firstUrl)).status).not.toBe(200)
+    const jpeg = await http.get(secondUrl)
+    expect(jpeg.headers.get('content-type')).toStartWith('image/jpeg')
+    expect(await Attachment.newQuery().count()).toBe(1)
+
+    await csrf.json().put(`/posts/${post.id}`, postForm({}, new File([GIF], 'c.gif', { type: 'image/gif' }))).assertUnprocessable()
+    await csrf.put(`/posts/${post.id}`, postForm({ title: 'Renamed' })).assertRedirect()
+    expect(await coverUrlOf(post.id)).not.toBeNull()
+
+    await csrf.put(`/posts/${post.id}`, postForm({ removeCover: '1' })).assertRedirect()
+    expect(await coverUrlOf(post.id)).toBeNull()
+    expect(await Attachment.newQuery().count()).toBe(0)
+
+    await csrf.put(`/posts/${post.id}`, postForm({}, new File([PNG], 'd.png', { type: 'image/png' }))).assertRedirect()
+    const lastUrl = (await coverUrlOf(post.id))!
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect((await http.get(lastUrl)).status).not.toBe(200)
+    expect(await Attachment.newQuery().count()).toBe(0)
+  })
+})
