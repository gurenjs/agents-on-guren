 })
+
+// posts.archive lists posts created in a given year, or year+month, as JSON.
+// Fixtures use a title prefix so re-running the suite against a persisted
+// test database stays idempotent (old fixture rows are cleared first) and
+// years far from "today" so they never collide with other seeded posts.
+describe('posts.archive', () => {
+  let http: TestApp
+
+  const FIXTURE_PREFIX = 'Archive fixture:'
+  const augNew = `${FIXTURE_PREFIX} Aug new`
+  const augOld = `${FIXTURE_PREFIX} Aug old`
+  const feb = `${FIXTURE_PREFIX} Feb`
+  const prevYearAug = `${FIXTURE_PREFIX} prev year Aug`
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    await Post.newQuery().where('title', 'like', `${FIXTURE_PREFIX}%`).delete()
+
+    const author = await User.first({ email: DEMO_EMAIL })
+    if (!author) {
+      throw new Error(`Expected the demo user (${DEMO_EMAIL}) to be seeded before this test runs.`)
+    }
+
+    // Inserted oldest to newest so ascending id order matches ascending
+    // createdAt — the controller orders by id desc, so this keeps "newest
+    // first" assertions meaningful.
+    for (const [title, createdAt] of [
+      [prevYearAug, '2030-08-15T00:00:00.000Z'],
+      [feb, '2031-02-01T00:00:00.000Z'],
+      [augOld, '2031-08-05T10:00:00.000Z'],
+      [augNew, '2031-08-31T23:59:59.000Z'],
+    ] as const) {
+      await Post.forceCreate({
+        title,
+        excerpt: 'Archive fixture post.',
+        body: 'Archive fixture post.',
+        authorId: author.id,
+        createdAt,
+      })
+    }
+  })
+
+  it('lists posts created in a given month, zero-padded', async () => {
+    const response = await http.get('/posts/archive/2031/08').assertOk()
+    const body = await response.json<{ data: Array<{ title: string }> }>()
+    // Newest first.
+    expect(body.data.map((post) => post.title)).toEqual([augNew, augOld])
+  })
+
+  it('lists posts created in a given month, no leading zero', async () => {
+    const response = await http.get('/posts/archive/2031/8').assertOk()
+    const body = await response.json<{ data: Array<{ title: string }> }>()
+    expect(body.data.map((post) => post.title)).toEqual([augNew, augOld])
+  })
+
+  it('lists every post created in a given year', async () => {
+    const response = await http.get('/posts/archive/2031').assertOk()
+    const body = await response.json<{ data: Array<{ title: string }> }>()
+    expect(body.data.map((post) => post.title)).toEqual([augNew, augOld, feb])
+  })
+
+  it('does not leak posts from a different year sharing the same month', async () => {
+    const response = await http.get('/posts/archive/2030/08').assertOk()
+    const body = await response.json<{ data: Array<{ title: string }> }>()
+    expect(body.data.map((post) => post.title)).toEqual([prevYearAug])
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/2099').assertOk().assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2031/13').assertStatus(422)
+  })
+})
