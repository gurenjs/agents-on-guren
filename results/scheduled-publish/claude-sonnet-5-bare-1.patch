+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const future = () => new Date(Date.now() + 86_400_000).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let csrf: TestApp
+  let author: { id: number }
+  let other: { id: number }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const stamp = Date.now()
+    author = (await User.forceCreate({ name: 'A', email: `a${stamp}@x.test`, password: 'secret-pass-123' }))!
+    other = (await User.forceCreate({ name: 'B', email: `b${stamp}@x.test`, password: 'secret-pass-123' }))!
+    csrf = await http.actingAs(author).withCsrf()
+  })
+
+  it('hides a scheduled post from everyone but its author', async () => {
+    const post = (await Post.forceCreate({
+      title: 'Later zzsched',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: future(),
+    }))!
+
+    await http.get(`/posts/${post.id}`).assertStatus(404)
+    await http.actingAs(other).get(`/posts/${post.id}`).assertStatus(404)
+    await http.actingAs(author).get(`/posts/${post.id}`).assertStatus(200)
+
+    await http.query('/posts/search', { keywords: ['zzsched'] }).assertStatus(200).assertJsonCount(0, 'data')
+
+    await Post.update({ id: post.id }, { publishedAt: new Date(Date.now() - 1000).toISOString() })
+    await http.get(`/posts/${post.id}`).assertStatus(200)
+  })
+
+  it('rejects a publishAt that is not a date', async () => {
+    await csrf.post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' }).assertStatus(422)
+  })
+
+  it('stores a valid publishAt', async () => {
+    const at = future()
+    await csrf.post('/posts', { title: 'stored', excerpt: 'e', body: 'b', publishAt: at })
+    const post = await Post.newQuery().where('title', 'stored').first()
+    expect(post?.publishedAt).toBe(at)
+  })
+})
