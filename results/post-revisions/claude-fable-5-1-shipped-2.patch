+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostContent, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const content = (title: string): PostContent => ({
+  title,
+  excerpt: `${title} excerpt`,
+  body: `${title} body`,
+})
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    stranger = await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret-password' })
+  })
+
+  const createPost = (title: string, owner: UserRecord = author): Promise<PostRecord> =>
+    Post.forceCreate({ ...content(title), authorId: owner.id })
+
+  async function edit(post: PostRecord, title: string, as: UserRecord = author) {
+    const csrf = await http.actingAs(as).withCsrf()
+    return csrf.put(`/posts/${post.id}`, content(title))
+  }
+
+  async function restore(post: PostRecord, revisionId: number, as: UserRecord = author) {
+    const csrf = await http.actingAs(as).withCsrf()
+    return csrf.post(`/posts/${post.id}/revisions/${revisionId}/restore`)
+  }
+
+  const revisionsOf = (post: PostRecord) => PostRevision.where({ postId: post.id }).orderBy('id', 'asc').get()
+
+  async function listedTitles(post: PostRecord): Promise<string[]> {
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+    response.assertOk()
+    const page = await response.json<{ props: { revisions: Array<{ title: string }> } }>()
+    return page.props.revisions.map((revision) => revision.title)
+  }
+
+  describe('keeping revisions', () => {
+    it('keeps nothing when a post is created', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.post('/posts', content('First')).assertStatus(303)
+
+      expect(await PostRevision.all()).toHaveLength(0)
+    })
+
+    it('keeps the previous version on a successful edit', async () => {
+      const post = await createPost('First')
+
+      await (await edit(post, 'Second')).assertRedirect(`/posts/${post.id}`)
+
+      const revisions = await revisionsOf(post)
+      expect(revisions).toHaveLength(1)
+      expect(revisions[0]).toMatchObject({ postId: post.id, ...content('First') })
+      expect(new Date(revisions[0]!.createdAt).toISOString()).toBe(revisions[0]!.createdAt)
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('Second'))
+    })
+
+    it('keeps nothing when the edit is invalid', async () => {
+      const post = await createPost('First')
+
+      const csrf = await http.actingAs(author).json().withCsrf()
+      await csrf.put(`/posts/${post.id}`, { ...content('Second'), title: '' }).assertUnprocessable()
+
+      expect(await PostRevision.all()).toHaveLength(0)
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('First'))
+    })
+
+    it('keeps nothing when the edit is not allowed', async () => {
+      const post = await createPost('First')
+
+      await (await edit(post, 'Hijacked', stranger)).assertForbidden()
+
+      expect(await PostRevision.all()).toHaveLength(0)
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('First'))
+    })
+  })
+
+  describe('GET /posts/:id/revisions', () => {
+    it('lists revisions newest first', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+      await edit(post, 'Third')
+
+      const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+      response.assertOk()
+      const page = await response.json<{
+        component: string
+        props: { revisions: Array<{ id: number; title: string; createdAt: string }> }
+      }>()
+
+      expect(page.component).toBe('posts/Revisions')
+      expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+      const stored = await revisionsOf(post)
+      expect(page.props.revisions.map((revision) => revision.id)).toEqual(stored.map((row) => row.id).reverse())
+      for (const revision of page.props.revisions) {
+        expect(Number.isNaN(Date.parse(revision.createdAt))).toBe(false)
+      }
+    })
+
+    it('leaves out the revisions of other posts', async () => {
+      const post = await createPost('First')
+      const other = await createPost('Other')
+      await edit(post, 'Second')
+      await edit(other, 'Other again')
+
+      expect(await listedTitles(post)).toEqual(['First'])
+    })
+
+    it('refuses a signed-in user who is not the author', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+
+      await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    })
+
+    it('sends a guest to the login page', async () => {
+      const post = await createPost('First')
+
+      await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    })
+
+    it('answers 404 for a post that does not exist', async () => {
+      await http.actingAs(author).get('/posts/999/revisions').assertNotFound()
+    })
+  })
+
+  describe('POST /posts/:id/revisions/:revisionId/restore', () => {
+    it('restores the revision and keeps the version it replaced', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+      await edit(post, 'Third')
+      const [first] = await revisionsOf(post)
+
+      await (await restore(post, first!.id)).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('First'))
+      expect(await listedTitles(post)).toEqual(['Third', 'Second', 'First'])
+    })
+
+    it('refuses a signed-in user who is not the author', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+      const [first] = await revisionsOf(post)
+
+      await (await restore(post, first!.id, stranger)).assertForbidden()
+
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('Second'))
+      expect(await revisionsOf(post)).toHaveLength(1)
+    })
+
+    it('sends a guest to the login page', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+      const [first] = await revisionsOf(post)
+
+      const csrf = await http.withCsrf()
+      await csrf.post(`/posts/${post.id}/revisions/${first!.id}/restore`).assertRedirect('/login')
+
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('Second'))
+      expect(await revisionsOf(post)).toHaveLength(1)
+    })
+
+    it('answers 404 for a revision of another post by the same author', async () => {
+      const post = await createPost('First')
+      const other = await createPost('Other')
+      await edit(other, 'Other again')
+      const [foreign] = await revisionsOf(other)
+
+      await (await restore(post, foreign!.id)).assertNotFound()
+
+      expect(await Post.findOrFail(post.id)).toMatchObject(content('First'))
+      expect(await Post.findOrFail(other.id)).toMatchObject(content('Other again'))
+      expect(await PostRevision.all()).toHaveLength(1)
+    })
+
+    it('answers 404 for a revision that does not exist', async () => {
+      const post = await createPost('First')
+
+      await (await restore(post, 999)).assertNotFound()
+
+      expect(await PostRevision.all()).toHaveLength(0)
+    })
+  })
+
+  describe('DELETE /posts/:id', () => {
+    it('deletes the revisions of that post only', async () => {
+      const post = await createPost('First')
+      const other = await createPost('Other')
+      await edit(post, 'Second')
+      await edit(post, 'Third')
+      await edit(other, 'Other again')
+
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+      expect(await Post.find(post.id)).toBeNull()
+      expect(await revisionsOf(post)).toHaveLength(0)
+      expect(await revisionsOf(other)).toHaveLength(1)
+    })
+
+    it('keeps the revisions when the delete is refused', async () => {
+      const post = await createPost('First')
+      await edit(post, 'Second')
+
+      const csrf = await http.actingAs(stranger).withCsrf()
+      await csrf.delete(`/posts/${post.id}`).assertForbidden()
+
+      expect(await revisionsOf(post)).toHaveLength(1)
+    })
+  })
+})
