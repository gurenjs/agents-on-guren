@@ -6,8 +6,34 @@ export const PostIdParamSchema = z.object({
 
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().optional(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+/**
+ * Splits the comma-separated Tags field into trimmed, de-duplicated names.
+ * Names are case-sensitive; empty entries are dropped.
+ */
+export function parseTagNames(input: string | readonly string[] | undefined | null): string[] {
+  const raw = Array.isArray(input) ? input.join(',') : ((input as string | undefined | null) ?? '')
+  const names = raw.split(',').map((name) => name.trim()).filter((name) => name.length > 0)
+  return [...new Set(names)]
+}
+
+// Checks the parsed names but leaves the field as sent: the controller
+// parses it again with parseTagNames, so both agree on what a name is.
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .refine((value) => parseTagNames(value).every((name) => name.length <= MAX_TAG_LENGTH), {
+    message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.`,
+  })
+  .refine((value) => parseTagNames(value).length <= MAX_TAGS_PER_POST, {
+    message: `A post can have at most ${MAX_TAGS_PER_POST} tags.`,
+  })
+
 export const PostSearchSchema = z.object({
