+
+  // The owner's personal API tokens by name, newest first. Never the token
+  // itself: only its creation response carried that.
+  private async tokensFor(user: UserRecord): Promise<ApiTokenResourceData[]> {
+    const store = this.make('auth').getApiTokenStore()
+    if (!store) {
+      return []
+    }
+
+    const tokens = await getUserApiTokens(user.id, store)
+    tokens.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
+
+    return tokens.map((token) => new ApiTokenResource(token).toJSON())
+  }
 }
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
new file mode 100644
index 0000000..2fdd0bd
--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,25 @@
+import { Resource, type ApiToken } from '@guren/core'
+
+/**
+ * What the profile page sees of a token: never the hash, and never the plain
+ * token — that is returned once, by the response that creates it.
+ */
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+export class ApiTokenResource extends Resource<ApiToken, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: token.createdAt.toISOString(),
+      lastUsedAt: token.lastUsedAt ? token.lastUsedAt.toISOString() : null,
+    }
+  }
+}
