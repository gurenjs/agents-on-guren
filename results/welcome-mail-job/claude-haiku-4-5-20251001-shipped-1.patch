new file mode 100644
index 0000000..0ec98f3
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,59 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('RegisterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('shows register page', async () => {
+    await http.get('/register').assertOk()
+  })
+
+  it('validates required fields', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/register', {}).assertUnprocessable()
+  })
+
+  it('creates user and redirects to dashboard', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/register', {
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'password123456',
+        passwordConfirmation: 'password123456',
+      })
+      .assertRedirect('/dashboard')
+  })
+
+  it('prevents duplicate email registration', async () => {
+    await resetDatabase()
+    const csrf = await http.withCsrf()
+    await csrf.post('/register', {
+      name: 'First User',
+      email: 'duplicate@example.com',
+      password: 'password123456',
+      passwordConfirmation: 'password123456',
+    })
+
+    const csrf2 = await http.withCsrf()
+    await csrf2
+      .post('/register', {
+        name: 'Second User',
+        email: 'duplicate@example.com',
+        password: 'password123456',
+        passwordConfirmation: 'password123456',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'An account with this email already exists.')
+  })
+})
