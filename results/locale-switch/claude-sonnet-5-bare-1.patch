diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..23b7c2c
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+
+const COOKIE_MAX_AGE = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { body } = this.validated('locale.update')
+
+    return this.redirect(this.#returnPath(), {
+      headers: {
+        'Set-Cookie': `locale=${body.locale}; Path=/; Max-Age=${COOKIE_MAX_AGE}; SameSite=Lax`,
+      },
+    })
+  }
+
+  // Only the path and query of the Referer are used, so a foreign Referer
+  // can never turn this into an open redirect.
+  #returnPath(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) return '/'
+    try {
+      const url = new URL(referer)
+      // A ?locale= in the query outranks the cookie during detection.
+      url.searchParams.delete('locale')
+      return `${url.pathname}${url.search}` || '/'
+    } catch {
+      return '/'
+    }
+  }
+}
