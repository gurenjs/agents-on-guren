diff --git a/app/Http/Middleware/ApiToken.ts b/app/Http/Middleware/ApiToken.ts
new file mode 100644
index 0000000..462cb8c
--- /dev/null
+++ b/app/Http/Middleware/ApiToken.ts
@@ -0,0 +1,44 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiTokenOrFail } from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import { User } from '../../Models/User.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_WINDOW_MS = 60_000
+
+/**
+ * Authenticates a request as the owner of the personal API token in its
+ * `Authorization: Bearer` header. Mounted on the /api routes only: the token
+ * guard is deliberately not registered app-wide, so a token cannot reach the
+ * session routes and mint further tokens or change its owner's password.
+ */
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: async (userId) => {
+    const user = await User.find(Number(userId))
+    if (!user) {
+      return null
+    }
+
+    const { passwordHash: _passwordHash, rememberToken: _rememberToken, ...owner } = user
+    return owner
+  },
+  onUnauthorized: (ctx) => {
+    ctx.header('WWW-Authenticate', 'Bearer')
+    return ctx.json({ message: 'Unauthenticated.' }, 401)
+  },
+})
+
+/**
+ * Limits each token, not each account or address, to 60 requests a minute.
+ * Runs after authenticateApiToken, which is what puts the token on the
+ * request. Counts live in this process's memory; give the limiter a shared
+ * `store` before running more than one server process.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests, please try again later.', retryAfter }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
new file mode 100644
index 0000000..4763a02
--- /dev/null
+++ b/app/Http/Resources/ApiTokenResource.ts
@@ -0,0 +1,24 @@
+import { Resource } from '@guren/core'
+import type { ApiTokenRecord } from '../../Models/ApiToken.js'
+
+export interface ApiTokenResourceData extends Record<string, unknown> {
+  id: string
+  name: string
+  createdAt: string
+  lastUsedAt: string | null
+}
+
+// What the profile page lists. Neither the hash nor the token itself is here:
+// the plain text exists only in the response that creates the token.
+export class ApiTokenResource extends Resource<ApiTokenRecord, ApiTokenResourceData> {
+  toArray(): ApiTokenResourceData {
+    const token = this.resource
+
+    return {
+      id: token.id,
+      name: token.name,
+      createdAt: new Date(token.createdAt).toISOString(),
+      lastUsedAt: token.lastUsedAt ? new Date(token.lastUsedAt).toISOString() : null,
+    }
+  }
+}
