+import type { Router } from '@guren/core'
+import PostController from '../app/Http/Controllers/PostController.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+
+// Public JSON API. Nothing here is behind the 'auth' alias on purpose: these
+// routes answer external consumers that have no session and send no CSRF
+// token, so every one of them must stay a safe read.
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    // The `query` contract is validated before the controller runs (422 on a
+    // bad `page`/`author`) and is what publishes the accepted parameters to
+    // codegen. `resource` declares the response shape the controller builds
+    // from PostResource, so the generated client's json() comes back typed.
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+      summary: 'List published posts, newest first',
+      tags: ['posts'],
+    }, [PostController, 'apiIndex'])
+  })
+}
