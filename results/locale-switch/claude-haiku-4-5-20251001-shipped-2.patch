+import { usePage, router } from '@inertiajs/react'
+import type { FormEvent } from 'react'
+
+export default function LanguageSwitcher() {
+  const { props } = usePage<{ _i18n?: { locale: string } }>()
+  const locale = props._i18n?.locale ?? 'en'
+
+  function handleLocaleChange(event: FormEvent<HTMLSelectElement>) {
+    const newLocale = event.currentTarget.value
+    router.post('/locale', { locale: newLocale }, {
+      preserveUrl: false,
+      onSuccess: () => {
+        // The redirect from the server will handle navigation
+      },
+    })
+  }
+
+  return (
+    <select
+      value={locale}
+      onChange={handleLocaleChange}
+      className="rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-1 text-sm text-g-text transition hover:border-g-muted"
+    >
+      <option value="en">English</option>
+      <option value="ja">日本語</option>
+    </select>
+  )
+}
