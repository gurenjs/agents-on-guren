diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..3d02984
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,185 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+
+const RUN = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+const tagName = (name: string) => `${name}-${RUN}`
+
+async function pageProps<T>(response: { raw: Response }): Promise<T> {
+  const inertia = await readInertiaResponse(response.raw)
+  return inertia.payload.props as T
+}
+
+interface PostProps {
+  post: { id: number; tags: string[] }
+}
+
+interface IndexProps {
+  data: Array<{ id: number; tags: string[] }>
+  pagination: { links: { pages: Array<{ url: string | null }> } }
+}
+
+describe('parseTagNames', () => {
+  it('trims, drops empties and collapses duplicates case-sensitively', () => {
+    expect(parseTagNames(' bun ,bun')).toEqual(['bun'])
+    expect(parseTagNames('a,,b,')).toEqual(['a', 'b'])
+    expect(parseTagNames('Bun, bun')).toEqual(['Bun', 'bun'])
+    expect(parseTagNames(undefined)).toEqual([])
+    expect(parseTagNames('')).toEqual([])
+    expect(parseTagNames(['x', 'y, z'])).toEqual(['x', 'y', 'z'])
+  })
+})
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: TestApp
+  let user: UserRecord
+
+  const payload = (tags?: string | string[]) => ({
+    title: `Tagged post ${RUN}`,
+    excerpt: 'An excerpt.',
+    body: 'A body.',
+    ...(tags === undefined ? {} : { tags }),
+  })
+
+  async function createPost(tags?: string | string[]): Promise<number> {
+    const response = await author.post('/posts', payload(tags))
+    response.assertRedirect()
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.split('/').pop())
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  async function postTagsOf(postId: number) {
+    const rows = await PostTag.newQuery().where('postId', '=', postId).get()
+    return rows
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({ name: 'Tagger', email: `tagger-${RUN}@example.com`, password: 'secret' })
+    author = await http.actingAs(user).withCsrf('/posts')
+  })
+
+  it('creates tags, attaches them and shows them sorted on the post page', async () => {
+    const id = await createPost(`${tagName('webdev')}, ${tagName('bun')}`)
+
+    const bun = await Tag.first({ name: tagName('bun') })
+    const webdev = await Tag.first({ name: tagName('webdev') })
+    expect(bun).not.toBeNull()
+    expect(webdev).not.toBeNull()
+
+    const rows = await postTagsOf(id)
+    expect(rows.map((row) => row.tagId).sort()).toEqual([bun!.id, webdev!.id].sort())
+
+    const props = await pageProps<PostProps>(await http.get(`/posts/${id}`))
+    expect(props.post.tags).toEqual([tagName('bun'), tagName('webdev')])
+  })
+
+  it('detaches removed tags on update and keeps the orphaned tag row', async () => {
+    const id = await createPost(`${tagName('keep')}, ${tagName('drop')}`)
+
+    await author.put(`/posts/${id}`, payload(tagName('keep'))).assertRedirect(`/posts/${id}`)
+
+    const keep = await Tag.first({ name: tagName('keep') })
+    const rows = await postTagsOf(id)
+    expect(rows.map((row) => row.tagId)).toEqual([keep!.id])
+    expect(await Tag.first({ name: tagName('drop') })).not.toBeNull()
+
+    const props = await pageProps<PostProps>(await http.get(`/posts/${id}`))
+    expect(props.post.tags).toEqual([tagName('keep')])
+
+    const edit = await pageProps<PostProps>(await author.get(`/posts/${id}/edit`))
+    expect(edit.post.tags).toEqual([tagName('keep')])
+  })
+
+  it('treats a missing or empty field as no tags', async () => {
+    const withoutField = await createPost()
+    expect(await postTagsOf(withoutField)).toHaveLength(0)
+
+    const emptyField = await createPost('')
+    expect(await postTagsOf(emptyField)).toHaveLength(0)
+
+    const props = await pageProps<PostProps>(await http.get(`/posts/${emptyField}`))
+    expect(props.post.tags).toEqual([])
+  })
+
+  it('saves " bun ,bun" as one tag attached once', async () => {
+    const name = tagName('dup')
+    const id = await createPost(` ${name} ,${name}`)
+
+    const rows = await postTagsOf(id)
+    expect(rows).toHaveLength(1)
+    expect(await Tag.newQuery().where('name', '=', name).count()).toBe(1)
+  })
+
+  it('refuses six tags and a 31-character name like an empty title, writing nothing', async () => {
+    const emptyTitle = await author.json().post('/posts', { ...payload(), title: '' })
+    const postsBefore = await Post.newQuery().count()
+    const tagsBefore = await Tag.newQuery().count()
+    const linksBefore = await PostTag.newQuery().count()
+
+    const six = ['a', 'b', 'c', 'd', 'e', 'f'].map(tagName).join(', ')
+    const sixResponse = await author.json().post('/posts', payload(six))
+    expect(sixResponse.status).toBe(emptyTitle.status)
+    expect((await sixResponse.json<{ errors: Record<string, unknown> }>()).errors).toHaveProperty('tags')
+
+    const long = 'x'.repeat(31)
+    const longResponse = await author.json().post('/posts', payload(long))
+    expect(longResponse.status).toBe(emptyTitle.status)
+    expect((await longResponse.json<{ errors: Record<string, unknown> }>()).errors).toHaveProperty('tags')
+
+    expect(await Post.newQuery().count()).toBe(postsBefore)
+    expect(await Tag.newQuery().count()).toBe(tagsBefore)
+    expect(await PostTag.newQuery().count()).toBe(linksBefore)
+  })
+
+  it('accepts a 30-character name and exactly five tags', async () => {
+    const thirty = `${RUN}-`.padEnd(30, 'y').slice(0, 30)
+    const id = await createPost(thirty)
+    const props = await pageProps<PostProps>(await http.get(`/posts/${id}`))
+    expect(props.post.tags).toEqual([thirty])
+
+    const five = ['v', 'w', 'x', 'y', 'z'].map(tagName).join(', ')
+    expect(await postTagsOf(await createPost(five))).toHaveLength(5)
+  })
+
+  it('filters the list by tag, keeps the filter in page links and lists nothing for an unused tag', async () => {
+    const filter = tagName('filter')
+    const tagged = await createPost(filter)
+    const untagged = await createPost()
+
+    const filtered = await pageProps<IndexProps>(await http.get(`/posts?tag=${encodeURIComponent(filter)}`))
+    expect(filtered.data.map((post) => post.id)).toEqual([tagged])
+    expect(filtered.data[0]!.tags).toEqual([filter])
+    for (const page of filtered.pagination.links.pages) {
+      expect(page.url).toContain(`tag=${encodeURIComponent(filter)}`)
+    }
+
+    const unused = await pageProps<IndexProps>(await http.get(`/posts?tag=${encodeURIComponent(tagName('nobody'))}`))
+    expect(unused.data).toEqual([])
+
+    const all = await pageProps<IndexProps>(await http.get('/posts'))
+    const ids = all.data.map((post) => post.id)
+    expect(ids).toContain(untagged)
+    for (const post of all.data) {
+      expect(Array.isArray(post.tags)).toBe(true)
+    }
+    expect(all.data.find((post) => post.id === untagged)?.tags).toEqual([])
+  })
+
+  it('deletes a tagged post together with its links', async () => {
+    const id = await createPost(tagName('doomed'))
+    await author.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    expect(await Post.find(id)).toBeNull()
+    expect(await postTagsOf(id)).toHaveLength(0)
+    expect(await Tag.first({ name: tagName('doomed') })).not.toBeNull()
+  })
+})
