diff --git a/app/Providers/I18nProvider.ts b/app/Providers/I18nProvider.ts
new file mode 100644
index 0000000..7023f01
--- /dev/null
+++ b/app/Providers/I18nProvider.ts
@@ -0,0 +1,42 @@
+import { ServiceProvider, shareInertiaProps } from '@guren/core'
+import type { Context } from 'hono'
+
+export default class I18nProvider extends ServiceProvider {
+  register(): void {
+    // I18nProvider doesn't need to register anything
+  }
+
+  boot(): void {
+    shareInertiaProps(async (ctx) => {
+      try {
+        // Try different ways to access the Hono context from the container
+        let honoContext = (ctx as any).get?.('hono') as Context | undefined
+
+        if (!honoContext) {
+          honoContext = (ctx as any).get?.('http.context') as Context | undefined
+        }
+
+        if (!honoContext) {
+          honoContext = (ctx as any).get?.('request') as Context | undefined
+        }
+
+        if (!honoContext) {
+          return { _i18n: { locale: 'en', messages: {} } }
+        }
+
+        // The framework's i18n middleware sets the locale and translations in the Hono context state
+        const locale = (honoContext as any).state?.locale ?? (honoContext as any).locale?.() ?? 'en'
+        const messages = (honoContext as any).state?.messages ?? (honoContext as any).messages?.() ?? {}
+
+        return {
+          _i18n: {
+            locale,
+            messages,
+          },
+        }
+      } catch {
+        return { _i18n: { locale: 'en', messages: {} } }
+      }
+    }, this.container)
+  }
+}
