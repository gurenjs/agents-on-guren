diff --git a/tests/ApiToken.test.ts b/tests/ApiToken.test.ts
new file mode 100644
index 0000000..7a0cae6
--- /dev/null
+++ b/tests/ApiToken.test.ts
@@ -0,0 +1,79 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    user = await User.create({
+      name: 'Token Tester',
+      email: `token-${crypto.randomUUID()}@example.com`,
+      password: 'password-123',
+    })
+  })
+
+  const session = async () => (await http.withCsrf()).actingAs(user)
+
+  async function createToken(name = 'CI') {
+    const response = await (await session()).json().post('/profile/tokens', { name })
+    response.assertStatus(201)
+    return (await response.json()) as { id: number; name: string; token: string }
+  }
+
+  const bearer = (token: string) => ({ Authorization: `Bearer ${token}` })
+
+  it('creates a token, stores only a hash, and authenticates the API', async () => {
+    const created = await createToken()
+    expect(created.token.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.where({ userId: user.id as number })
+    expect(JSON.stringify(rows)).not.toContain(created.token)
+
+    await http.json().withHeaders(bearer(created.token)).get('/api/posts').assertStatus(200)
+    await http.json().withHeaders(bearer(`${created.token}x`)).get('/api/posts').assertStatus(401)
+    await http.json().get('/api/posts').assertStatus(401)
+  })
+
+  it('rejects invalid names', async () => {
+    await (await session()).json().post('/profile/tokens', {}).assertStatus(422)
+    await (await session()).json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+  })
+
+  it('creates posts owned by the token owner and revokes tokens', async () => {
+    const created = await createToken('poster')
+    const response = await http
+      .json()
+      .withHeaders(bearer(created.token))
+      .post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999999 })
+    response.assertStatus(201)
+    expect(((await response.json()) as { data: { authorId: number } }).data.authorId).toBe(user.id as number)
+
+    await http
+      .json()
+      .withHeaders(bearer(created.token))
+      .post('/api/posts', { title: '', excerpt: 'E', body: 'B' })
+      .assertStatus(422)
+
+    await (await session()).json().delete(`/profile/tokens/${created.id}`).assertStatus(204)
+    await http.json().withHeaders(bearer(created.token)).get('/api/posts').assertStatus(401)
+  })
+
+  it('rate limits per token', async () => {
+    const a = await createToken('a')
+    const b = await createToken('b')
+    for (let i = 0; i < 60; i++) {
+      await http.json().withHeaders(bearer(a.token)).get('/api/posts').assertStatus(200)
+    }
+    const limited = await http.json().withHeaders(bearer(a.token)).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.json().withHeaders(bearer(b.token)).get('/api/posts').assertStatus(200)
+  })
+})
