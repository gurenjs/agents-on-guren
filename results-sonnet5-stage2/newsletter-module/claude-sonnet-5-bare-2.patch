--- /dev/null
+++ b/modules/newsletter/NewsletterController.ts
@@ -0,0 +1,56 @@
+import { Controller, NotFoundHttpException, ValidationException } from '@guren/core'
+import { Subscription } from './Subscription.js'
+import { ConfirmParamSchema, EmailSchema } from './validators.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+
+    const existing = await Subscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    // 32 random bytes, hex encoded: unguessable and 64 characters long.
+    const token = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex')
+    await Subscription.create({ email, token })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmParamSchema)
+
+    const [subscription] = await Subscription.where({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException('Subscription not found.')
+    }
+
+    await Subscription.newQuery().where('token', token).update({
+      confirmedAt: new Date().toISOString(),
+    })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+
+    await Subscription.newQuery().where('email', email).delete()
+
+    return this.redirect(this.backUrl())
+  }
+
+  // Only same-site referers are honoured, so a forged header cannot bounce the visitor elsewhere.
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const target = new URL(referer)
+      if (target.host !== new URL(this.request.url).host) return '/'
+      return `${target.pathname}${target.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
