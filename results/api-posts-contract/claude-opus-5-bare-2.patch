diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..37250fa
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,76 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+interface ApiPostsResponse {
+  data: Array<{
+    id: number
+    title: string
+    excerpt: string
+    createdAt: string
+    author?: { id: number; name: string }
+  }>
+  meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+}
+
+// `api.posts.index` is public JSON — no session, no CSRF token. The route
+// declares its query contract (page, author) so codegen and `guren audit` can
+// see it, and the controller validates the same schema, which is what turns a
+// bad parameter into a 422 before the database is touched. The invalid cases
+// therefore need no fixtures; the reads below assert the envelope against
+// whatever the test database happens to hold.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects invalid query parameters with a 422', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+    await http.get('/api/posts?page=abc').assertStatus(422)
+    await http.get('/api/posts?author=abc').assertStatus(422)
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+
+  it('lists posts newest first, ten to a page, without signing in', async () => {
+    const response = await http.get('/api/posts').assertStatus(200)
+    expect(response.headers.get('content-type')).toContain('application/json')
+
+    const body = (await response.json()) as ApiPostsResponse
+    expect(body.meta.perPage).toBe(10)
+    expect(body.meta.currentPage).toBe(1)
+    expect(body.data.length).toBeLessThanOrEqual(10)
+
+    const ids = body.data.map((post) => post.id)
+    expect(ids).toEqual([...ids].sort((a, b) => b - a))
+
+    for (const post of body.data) {
+      expect(typeof post.title).toBe('string')
+      expect(typeof post.excerpt).toBe('string')
+      expect(new Date(post.createdAt).toISOString()).toBe(post.createdAt)
+      expect(typeof post.author?.id).toBe('number')
+      expect(typeof post.author?.name).toBe('string')
+    }
+  })
+
+  it('narrows the feed — and the total — to a single author', async () => {
+    const all = (await (await http.get('/api/posts').assertStatus(200)).json()) as ApiPostsResponse
+    const authorId = all.data[0]?.author?.id
+    if (authorId === undefined) return
+
+    const filtered = (await (await http.get(`/api/posts?author=${authorId}`).assertStatus(200)).json()) as ApiPostsResponse
+    expect(filtered.data.every((post) => post.author?.id === authorId)).toBe(true)
+    expect(filtered.meta.total).toBeGreaterThan(0)
+    expect(filtered.meta.total).toBeLessThanOrEqual(all.meta.total)
+  })
+
+  it('answers 200 with an empty page for an author who has no posts', async () => {
+    const response = await http.get('/api/posts?author=999999&page=2').assertStatus(200)
+
+    const body = (await response.json()) as ApiPostsResponse
+    expect(body.data).toEqual([])
+    expect(body.meta.total).toBe(0)
+    expect(body.meta.currentPage).toBe(2)
+  })
+})
