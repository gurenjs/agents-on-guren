@@ -0,0 +1,22 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class PostsScheduledCommand extends Command {
+  static override signature = 'posts:scheduled'
+  static override description = 'List all scheduled posts'
+
+  async handle(): Promise<number> {
+    const now = new Date().toISOString()
+    const posts = await Post.newQuery()
+      .whereNotNull('publishedAt')
+      .where('publishedAt', '>', now)
+      .orderBy('publishedAt', 'asc')
+      .get()
+
+    for (const post of posts) {
+      console.log(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
