diff --git a/app/Services/AttachmentService.ts b/app/Services/AttachmentService.ts
new file mode 100644
index 0000000..ba6c33a
--- /dev/null
+++ b/app/Services/AttachmentService.ts
@@ -0,0 +1,51 @@
+import { mkdir, readFile, unlink } from 'fs/promises'
+import { join } from 'path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+const STORAGE_DIR = join(process.cwd(), 'storage')
+
+export class AttachmentService {
+  static async saveFile(file: File): Promise<AttachmentRecord | null> {
+    try {
+      await mkdir(STORAGE_DIR, { recursive: true })
+
+      const buffer = await file.arrayBuffer()
+      const filename = `${Date.now()}-${file.name}`
+      const filepath = join(STORAGE_DIR, filename)
+
+      await Bun.write(filepath, buffer)
+
+      const attachment = await Attachment.create({
+        filename: file.name,
+        path: filename,
+        mimeType: file.type,
+        size: file.size,
+      })
+
+      return attachment
+    } catch {
+      return null
+    }
+  }
+
+  static async deleteFile(attachment: AttachmentRecord | null): Promise<void> {
+    if (!attachment) return
+
+    try {
+      const filepath = join(STORAGE_DIR, attachment.path)
+      await unlink(filepath)
+      await Attachment.delete({ id: attachment.id })
+    } catch {
+      // File may already be deleted, ignore the error
+    }
+  }
+
+  static async getFile(attachment: AttachmentRecord): Promise<Buffer | null> {
+    try {
+      const filepath = join(STORAGE_DIR, attachment.path)
+      return await readFile(filepath)
+    } catch {
+      return null
+    }
+  }
+}
