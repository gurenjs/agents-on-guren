diff --git a/app/Services/FileStorageService.ts b/app/Services/FileStorageService.ts
new file mode 100644
index 0000000..41fcab5
--- /dev/null
+++ b/app/Services/FileStorageService.ts
@@ -0,0 +1,54 @@
+import { join } from 'path'
+import { mkdir, unlink, writeFile } from 'fs/promises'
+import { existsSync } from 'fs'
+
+const STORAGE_DIR = join(process.cwd(), 'storage')
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024 // 2MB
+
+export class FileStorageService {
+  async ensureStorageDir(): Promise<void> {
+    if (!existsSync(STORAGE_DIR)) {
+      await mkdir(STORAGE_DIR, { recursive: true })
+    }
+  }
+
+  async validateAndStoreFile(file: File): Promise<{ fileName: string; mimeType: string; filePath: string }> {
+    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
+      throw new Error('File type not allowed. Use PNG or JPEG.')
+    }
+
+    if (file.size > MAX_FILE_SIZE) {
+      throw new Error('File size exceeds 2MB limit.')
+    }
+
+    await this.ensureStorageDir()
+
+    const fileName = file.name
+    const mimeType = file.type
+    const fileNameWithTimestamp = `${Date.now()}-${fileName}`
+    const filePath = join(STORAGE_DIR, fileNameWithTimestamp)
+
+    const buffer = await file.arrayBuffer()
+    await writeFile(filePath, Buffer.from(buffer))
+
+    return {
+      fileName,
+      mimeType,
+      filePath: fileNameWithTimestamp,
+    }
+  }
+
+  async deleteFile(filePath: string): Promise<void> {
+    const fullPath = join(STORAGE_DIR, filePath)
+    try {
+      await unlink(fullPath)
+    } catch {
+      // File may already be deleted, ignore
+    }
+  }
+
+  async getFilePath(filePath: string): Promise<string> {
+    return join(STORAGE_DIR, filePath)
+  }
+}
