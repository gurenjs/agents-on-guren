diff --git a/app/Http/Controllers/TokenController.ts b/app/Http/Controllers/TokenController.ts
new file mode 100644
index 0000000..c98266c
--- /dev/null
+++ b/app/Http/Controllers/TokenController.ts
@@ -0,0 +1,28 @@
+import { Controller, createApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokenStore.js'
+import type { UserRecord } from '../../Models/User.js'
+import { TokenIdParamSchema } from '../Validators/TokenValidator.js'
+
+export default class TokenController extends Controller {
+  // The plain token is in this response only; the database keeps a hash.
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name: body.name, userId: user.id })
+
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(TokenIdParamSchema)
+    const owned = (await apiTokenStore.findByUserId(user.id)).find((token) => token.id === id)
+    if (!owned) {
+      return this.json({ message: 'Token not found.' }, { status: 404 })
+    }
+
+    await apiTokenStore.delete(owned.id)
+
+    return new Response(null, { status: 204 })
+  }
+}
diff --git a/app/Http/Middleware/ApiMiddleware.ts b/app/Http/Middleware/ApiMiddleware.ts
new file mode 100644
index 0000000..cb5d615
--- /dev/null
+++ b/app/Http/Middleware/ApiMiddleware.ts
@@ -0,0 +1,21 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokenStore.js'
+
+// Answers 401 in JSON for a missing, malformed, unknown or revoked bearer token.
+export const bearerAuth = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// 60 requests a minute per token (not per user or IP). Runs after bearerAuth,
+// so only verified tokens get a counter and junk credentials cannot fill the store.
+export const tokenRateLimit = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiToken(c)?.token.id ?? 'unknown',
+  onRateLimited: (c, retryAfter) => {
+    c.header('Retry-After', String(Math.min(60, Math.max(1, Math.ceil(retryAfter)))))
+    return c.json({ message: 'Too many requests.' }, 429)
+  },
+})
