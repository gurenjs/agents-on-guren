diff --git a/app/Auth/apiTokenStore.ts b/app/Auth/apiTokenStore.ts
new file mode 100644
index 0000000..101324a
--- /dev/null
+++ b/app/Auth/apiTokenStore.ts
@@ -0,0 +1,9 @@
+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+// The one store tokens are issued to, verified against and revoked from. It is
+// deliberately not registered with `auth.useTokens()`: that would let a bearer
+// token answer for the session on every route, so a leaked token could change
+// its owner's password or mint more tokens. Only the routes in routes/api.ts
+// accept one.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
diff --git a/app/Http/Controllers/ApiPostController.ts b/app/Http/Controllers/ApiPostController.ts
new file mode 100644
index 0000000..01b5782
--- /dev/null
+++ b/app/Http/Controllers/ApiPostController.ts
@@ -0,0 +1,29 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import type { UserRecord } from '../../Models/User.js'
+import { PostResource } from '../Resources/PostResource.js'
+
+// The JSON API for scripts, authenticated by a personal API token (see
+// routes/api.ts). `this.auth` answers with the token's owner here.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    await this.authorize('create', Post)
+    const author = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('api.posts.store')
+    // forceCreate, because `authorId` is deliberately absent from Post.fillable:
+    // it comes from the token, and a request must never be able to set it.
+    const post = await Post.forceCreate({ ...data, authorId: author.id })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..b4530ff
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,36 @@
+import { Controller, NotFoundHttpException, createApiToken, getUserApiTokens, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokenStore.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, {
+      name: body.name,
+      userId: user.id,
+    })
+
+    // The only response that ever carries the plain token: the store keeps a
+    // hash of it, so it cannot be shown again.
+    return this.json(
+      { id: token.id, name: token.name, token: plainTextToken },
+      { status: 201, headers: { 'Cache-Control': 'no-store' } },
+    )
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const id = this.request.param('id')
+    // Looked up among the user's own tokens, so another user's id is a 404
+    // that does not reveal the token exists.
+    const token = (await getUserApiTokens(user.id, apiTokenStore)).find((candidate) => candidate.id === id)
+    if (!token) {
+      throw new NotFoundHttpException('Token not found.')
+    }
+
+    await revokeApiToken(token.id, apiTokenStore)
+
+    return new Response(null, { status: 204 })
+  }
+}
