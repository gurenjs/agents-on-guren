@@ -0,0 +1,104 @@
+import { describe, test, expect, beforeAll, afterEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { Subscription } from '../../../modules/newsletter/index.js'
+
+describe('Newsletter Subscriptions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  afterEach(async () => {
+    await Subscription.delete({})
+  })
+
+  test('subscribe creates a subscription with a token', async () => {
+    const csrf = await http.withCsrf()
+    const response = await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' })
+
+    expect(response.status).toBe(303)
+    const subscription = await Subscription.first({ email: 'test@example.com' })
+    expect(subscription).toBeDefined()
+    expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    expect(subscription?.confirmedAt).toBeNull()
+  })
+
+  test('subscribe fails with invalid email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: 'not-an-email' }).then((res) => {
+      expect(res.status).toBe(422)
+    })
+  })
+
+  test('subscribe fails with empty email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: '' }).then((res) => {
+      expect(res.status).toBe(422)
+    })
+  })
+
+  test('subscribe fails with already subscribed email', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).then((res) => {
+      expect(res.status).toBe(303)
+    })
+
+    const csrf2 = await http.withCsrf()
+    await csrf2.json().post('/newsletter/subscribe', { email: 'test@example.com' }).then((res) => {
+      expect(res.status).toBe(422)
+    })
+  })
+
+  test('confirm marks subscription as confirmed', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).then((res) => {
+      expect(res.status).toBe(303)
+    })
+
+    const subscription = await Subscription.first({ email: 'test@example.com' })
+    expect(subscription).toBeDefined()
+
+    if (subscription) {
+      const response = await http.get(`/newsletter/confirm/${subscription.token}`)
+      expect(response.status).toBe(302)
+
+      const confirmed = await Subscription.first({ email: 'test@example.com' })
+      expect(confirmed?.confirmedAt).toBeDefined()
+      expect(confirmed?.confirmedAt).not.toBeNull()
+    }
+  })
+
+  test('confirm returns 404 for invalid token', async () => {
+    const response = await http.get('/newsletter/confirm/invalid-token')
+    expect(response.status).toBe(404)
+  })
+
+  test('unsubscribe deletes subscription', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).then((res) => {
+      expect(res.status).toBe(303)
+    })
+
+    let subscription = await Subscription.first({ email: 'test@example.com' })
+    expect(subscription).toBeDefined()
+
+    const csrf2 = await http.withCsrf()
+    const response = await csrf2.json().post('/newsletter/unsubscribe', { email: 'test@example.com' })
+    expect(response.status).toBe(303)
+
+    subscription = await Subscription.first({ email: 'test@example.com' })
+    expect(subscription).toBeNull()
+  })
+
+  test('unsubscribe fails with invalid email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/unsubscribe', { email: 'not-an-email' }).then((res) => {
+      expect(res.status).toBe(422)
+    })
+  })
+})
