+++ b/tests/Newsletter.test.ts
@@ -0,0 +1,21 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// Validation failures answer before the database is touched, so these run
+// without migrations.
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/')
+  })
+
+  it('rejects an invalid email on subscribe', async () => {
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+  })
+
+  it('rejects an empty email on unsubscribe', async () => {
+    await http.post('/newsletter/unsubscribe', { email: '' }).assertStatus(422)
+  })
+})
