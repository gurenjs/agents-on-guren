@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'bun:test'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+describe('PostPayloadSchema', () => {
+  it('accepts a payload with no excerpt field at all', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', body: 'A post body.' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBe('')
+  })
+
+  it('accepts an empty string excerpt', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '', body: 'A post body.' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBe('')
+  })
+
+  it('treats a whitespace-only excerpt as blank', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '   \n\t  ', body: 'A post body.' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBe('')
+  })
+
+  it('trims a provided excerpt but keeps its content', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '  A teaser.  ', body: 'A post body.' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBe('A teaser.')
+  })
+
+  it('still rejects a blank title', () => {
+    const result = PostPayloadSchema.safeParse({ title: '   ', body: 'A post body.' })
+    expect(result.success).toBe(false)
+  })
+
+  it('still rejects a blank body', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', body: '   ' })
+    expect(result.success).toBe(false)
+  })
+})
diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..abd80ea
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body unchanged when it is 140 characters or fewer', () => {
+    const body = 'A short post body.'
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('returns the trimmed body unchanged when exactly 140 characters', () => {
+    const body = 'x'.repeat(140)
+    expect(deriveExcerpt(`  ${body}  `)).toBe(body)
+  })
+
+  it('backs up to the last whitespace when the cut lands inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const expected =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+    expect(deriveExcerpt(body)).toBe(expected)
+  })
+
+  it('keeps all 140 characters when the cut lands exactly on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const expected =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…'
+    expect(deriveExcerpt(body)).toBe(expected)
+  })
+
+  it('cuts at 140 characters when the opening has no whitespace at all', () => {
+    const body = 'a'.repeat(200)
+    const result = deriveExcerpt(body)
+    expect(result).toBe(`${'a'.repeat(140)}…`)
+  })
+
+  it('trims leading and trailing whitespace before deriving', () => {
+    const body = `   ${'word '.repeat(40)}  `
+    const result = deriveExcerpt(body)
+    expect(result.startsWith(' ')).toBe(false)
+    expect(result.endsWith('…')).toBe(true)
+  })
+
+  it('never produces an empty excerpt for a non-blank body', () => {
+    expect(deriveExcerpt('hi').length).toBeGreaterThan(0)
+  })
+})
