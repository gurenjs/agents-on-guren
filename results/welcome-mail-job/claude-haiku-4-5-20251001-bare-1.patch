diff --git a/app/Jobs/ProcessWelcomeSequenceJob.ts b/app/Jobs/ProcessWelcomeSequenceJob.ts
new file mode 100644
index 0000000..b64df1d
--- /dev/null
+++ b/app/Jobs/ProcessWelcomeSequenceJob.ts
@@ -0,0 +1,29 @@
+import { Job } from '@guren/core'
+import { WelcomeEmailMail } from '../Mail/WelcomeEmailMail.js'
+import type { MailManager } from '@guren/server/mail'
+
+export interface ProcessWelcomeSequenceJobPayload {
+  userId: number
+  userEmail: string
+  userName: string
+}
+
+export class ProcessWelcomeSequenceJob extends Job<ProcessWelcomeSequenceJobPayload> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: ProcessWelcomeSequenceJobPayload): Promise<void> {
+    const { userEmail, userName } = payload
+    const mailManager = this.make<MailManager>('mail')
+
+    await new WelcomeEmailMail(mailManager, {
+      name: userName,
+    })
+      .to(userEmail)
+      .send()
+  }
+
+  async failed(payload: ProcessWelcomeSequenceJobPayload, error: Error): Promise<void> {
+    console.error('ProcessWelcomeSequenceJob failed:', error.message, 'for user', payload.userEmail)
+  }
+}
