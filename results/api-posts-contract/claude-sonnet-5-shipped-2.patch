 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export const ApiPostsIndexQuerySchema = z.object({
+  page: z.coerce.number().int().min(1).default(1),
+  author: z.coerce.number().int().positive().optional(),
+})
+
+const ApiPostAuthorSchema = z.object({
+  id: z.number(),
+  name: z.string(),
+})
+
+export const ApiPostSchema = z.object({
+  id: z.number(),
+  title: z.string(),
+  excerpt: z.string(),
+  body: z.string(),
+  authorId: z.number(),
+  createdAt: z.string(),
+  author: ApiPostAuthorSchema,
+})
+
+export const ApiPostsIndexOutputSchema = z.object({
+  data: z.array(ApiPostSchema),
+  meta: z.object({
+    currentPage: z.number(),
+    lastPage: z.number(),
+    perPage: z.number(),
+    total: z.number(),
+  }),
+})
