@@ -0,0 +1,44 @@
+import { describe, it } from 'bun:test'
+import { isSafeRedirect } from '../app/Utils/validateRedirect.js'
+
+describe('isSafeRedirect', () => {
+  it('allows same-app paths starting with /', () => {
+    // Valid same-app paths should be allowed
+    if (!isSafeRedirect('/posts/3/edit')) throw new Error('Expected /posts/3/edit to be safe')
+    if (!isSafeRedirect('/dashboard')) throw new Error('Expected /dashboard to be safe')
+    if (!isSafeRedirect('/profile')) throw new Error('Expected /profile to be safe')
+    if (!isSafeRedirect('/')) throw new Error('Expected / to be safe')
+  })
+
+  it('blocks absolute URLs with schemes', () => {
+    // Absolute URLs should be blocked
+    if (isSafeRedirect('https://evil.example')) throw new Error('Expected https://evil.example to be blocked')
+    if (isSafeRedirect('http://evil.example')) throw new Error('Expected http://evil.example to be blocked')
+    if (isSafeRedirect('ftp://evil.example')) throw new Error('Expected ftp://evil.example to be blocked')
+    if (isSafeRedirect('javascript:alert("xss")')) throw new Error('Expected javascript: to be blocked')
+  })
+
+  it('blocks protocol-relative URLs', () => {
+    // Protocol-relative URLs should be blocked
+    if (isSafeRedirect('//evil.example')) throw new Error('Expected //evil.example to be blocked')
+    if (isSafeRedirect('//evil.example/path')) throw new Error('Expected //evil.example/path to be blocked')
+  })
+
+  it('blocks backslash variants', () => {
+    // Backslash variants should be blocked (browsers treat /\ as //)
+    if (isSafeRedirect('/\\evil.example')) throw new Error('Expected /\\\\evil.example to be blocked')
+    if (isSafeRedirect('/\\\\evil.example')) throw new Error('Expected /\\\\\\\\evil.example to be blocked')
+  })
+
+  it('blocks relative paths without leading slash', () => {
+    // Relative paths without leading slash should be blocked
+    if (isSafeRedirect('evil.example')) throw new Error('Expected evil.example to be blocked')
+    if (isSafeRedirect('posts/3/edit')) throw new Error('Expected posts/3/edit to be blocked')
+  })
+
+  it('allows empty or undefined values', () => {
+    // Empty/undefined values are safe (will use default)
+    if (!isSafeRedirect('')) throw new Error('Expected empty string to be safe')
+    if (!isSafeRedirect(undefined)) throw new Error('Expected undefined to be safe')
+  })
+})
