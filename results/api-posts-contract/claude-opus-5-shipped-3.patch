+// The public JSON feed. Unlike posts.search above these hit the database, so
+// the suite resets it first and builds its own fixtures — the seeded demo
+// content would otherwise make the totals depend on seeding order.
+describe('api.posts.index', () => {
+  let http: TestApp
+  let aliceId: number
+  let bobId: number
+  let carolId: number
+
+  const publishedAt = (day: number) => new Date(Date.UTC(2026, 0, day, 12)).toISOString()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    const alice = await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret' })
+    const bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret' })
+    const carol = await User.create({ name: 'Carol', email: 'carol@example.com', password: 'secret' })
+    aliceId = alice.id
+    bobId = bob.id
+    carolId = carol.id
+
+    // forceCreate, because authorId and createdAt are deliberately outside
+    // Post.fillable — here they are fixture values, not request input.
+    for (let index = 1; index <= 12; index += 1) {
+      await Post.forceCreate({
+        title: `Alice post ${index}`,
+        excerpt: `Excerpt ${index}`,
+        body: `Body ${index}`,
+        authorId: aliceId,
+        createdAt: publishedAt(index),
+      })
+    }
+
+    await Post.forceCreate({
+      title: 'Bob post',
+      excerpt: 'Bob excerpt',
+      body: 'Bob body',
+      authorId: bobId,
+      createdAt: publishedAt(20),
+    })
+  })
+
+  // The test database is shared with every other test file, so hand it back in
+  // the state booting the app leaves it in: migrated and seeded.
+  afterAll(async () => {
+    await resetDatabase()
+    await seedDatabase()
+  })
+
+  it('lists the newest posts as JSON without any authentication', async () => {
+    const response = await http.get('/api/posts')
+
+    response.assertOk()
+    expect(response.headers.get('content-type')).toContain('application/json')
+
+    const payload = await response.json<{
+      data: Array<{ id: number; title: string; excerpt: string; createdAt: string; author?: { id: number; name: string } }>
+      meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+    }>()
+
+    expect(payload.data).toHaveLength(10)
+    expect(payload.data[0]?.title).toBe('Bob post')
+    expect(payload.data[0]?.author).toEqual({ id: bobId, name: 'Bob' })
+    expect(payload.data[0]?.createdAt).toBe(publishedAt(20))
+    expect(payload.data[1]?.title).toBe('Alice post 12')
+    expect(payload.meta).toMatchObject({ currentPage: 1, lastPage: 2, perPage: 10, total: 13 })
+  })
+
+  it('serves the requested page', async () => {
+    await http
+      .get('/api/posts?page=2')
+      .assertOk()
+      .assertJsonCount(3, 'data')
+      .assertJsonPath('meta.currentPage', 2)
+      .assertJsonPath('meta.total', 13)
+      .assertJsonPath('data.0.title', 'Alice post 3')
+  })
+
+  it('narrows to a single author, page and filter combined', async () => {
+    await http
+      .get(`/api/posts?author=${bobId}`)
+      .assertOk()
+      .assertJsonCount(1, 'data')
+      .assertJsonPath('meta.total', 1)
+      .assertJsonPath('data.0.title', 'Bob post')
+
+    await http
+      .get(`/api/posts?author=${aliceId}&page=2`)
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('meta.total', 12)
+      .assertJsonPath('meta.currentPage', 2)
+      .assertJsonPath('data.0.title', 'Alice post 2')
+  })
+
+  it('returns an empty page for an author with no posts', async () => {
+    await http
+      .get(`/api/posts?author=${carolId}`)
+      .assertOk()
+      .assertJsonCount(0, 'data')
+      .assertJsonPath('meta.total', 0)
+  })
+
+  it('rejects invalid query parameters with a 422 JSON error body', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422).assertJsonPath('errors.page.0', 'Page must be a positive integer.')
+    await http.get('/api/posts?page=abc').assertStatus(422)
+    await http.get('/api/posts?author=abc').assertStatus(422)
+    await http.get('/api/posts?author=0').assertStatus(422).assertJsonPath('errors.author.0', 'Author must be a positive user id.')
+  })
