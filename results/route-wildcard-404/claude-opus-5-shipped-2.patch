diff --git a/tests/PostArchive.test.ts b/tests/PostArchive.test.ts
new file mode 100644
index 0000000..a0885bc
--- /dev/null
+++ b/tests/PostArchive.test.ts
@@ -0,0 +1,88 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+// The archive answers two URL shapes — /posts/archive/:year/:month and
+// /posts/archive/:year — with `{ data: [...] }`, newest first. `created_at` is
+// compared as stored (UTC), so the fixtures pin exact timestamps; they sit in
+// years the boot-time seeders never touch (those posts are stamped "now"), so
+// the assertions stay independent of the seed data.
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    const author = await User.create({
+      name: 'Archivist',
+      email: 'archivist@example.com',
+      password: 'secret1234',
+    })
+
+    const timestamps: Array<[string, string]> = [
+      ['February', '2019-02-28T23:59:59.999Z'],
+      ['Early March', '2019-03-01T00:00:00.000Z'],
+      ['Late March', '2019-03-31T23:59:59.999Z'],
+      ['April', '2019-04-01T00:00:00.000Z'],
+      ['Year before', '2018-03-15T12:00:00.000Z'],
+    ]
+
+    for (const [title, createdAt] of timestamps) {
+      // forceCreate: neither `authorId` nor `createdAt` is mass-assignable.
+      await Post.forceCreate({
+        title,
+        excerpt: 'Excerpt',
+        body: 'Body',
+        authorId: author?.id as number,
+        createdAt,
+      })
+    }
+  })
+
+  it('lists the posts of one month, newest first', async () => {
+    await http
+      .json()
+      .get('/posts/archive/2019/03')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Late March')
+      .assertJsonPath('data.1.title', 'Early March')
+  })
+
+  it('accepts a month without a leading zero', async () => {
+    await http
+      .json()
+      .get('/posts/archive/2019/3')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Late March')
+  })
+
+  it('lists every post of a year', async () => {
+    await http
+      .json()
+      .get('/posts/archive/2019')
+      .assertOk()
+      .assertJsonCount(4, 'data')
+      .assertJsonPath('data.0.title', 'April')
+      .assertJsonPath('data.3.title', 'February')
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.json().get('/posts/archive/2019/07').assertOk().assertJsonCount(0, 'data')
+    await http.json().get('/posts/archive/2017').assertOk().assertJsonCount(0, 'data')
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.json().get('/posts/archive/2019/13').assertUnprocessable()
+    await http.json().get('/posts/archive/2019/00').assertUnprocessable()
+  })
+
+  it('rejects a year that is not four digits', async () => {
+    await http.json().get('/posts/archive/19/03').assertUnprocessable()
+  })
+})
