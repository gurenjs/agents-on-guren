+/**
+ * True while a post's `published_at` lies in the future. NULL, or a time that
+ * has already passed, means the post is public — nothing has to run when the
+ * moment arrives.
+ */
+export function isScheduled(post: Pick<PostRecord, 'publishedAt'>, now: Date = new Date()): boolean {
+  if (post.publishedAt === null || post.publishedAt === undefined) return false
+  const time = Date.parse(post.publishedAt)
+  return !Number.isNaN(time) && time > now.getTime()
+}
+
+/**
+ * Restricts a post query to what `viewerId` may see: public posts, plus the
+ * viewer's own scheduled ones. `published_at` is stored as ISO 8601 UTC text,
+ * so comparing it with the current time as a string orders it correctly.
+ */
+export function visibleTo<Q extends QueryBuilder<PostRecord>>(
+  query: Q,
+  viewerId: number | null,
+  now: Date = new Date(),
+): Q {
+  return query.where((q) => {
+    q.whereNull('publishedAt').orWhere('publishedAt', '<=', now.toISOString())
+    if (viewerId !== null) q.orWhere('authorId', viewerId)
+  })
+}
