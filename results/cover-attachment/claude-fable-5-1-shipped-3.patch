 export const PostIdParamSchema = z.object({
@@ -23,3 +24,27 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+// A ticked checkbox arrives as the string '1' in multipart; Inertia sends a
+// JSON boolean when the form carries no file.
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  removeCover: z.union([z.boolean(), z.string()]).optional(),
+})
+
+export function wantsCoverRemoved(value: boolean | string | undefined): boolean {
+  return value === true || value === '1' || value === 'true' || value === 'on'
+}
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+const COVER_TYPES = new Set(['image/png', 'image/jpeg'])
+
+// `File.type` is what the browser claimed; the attachment engine re-checks the
+// bytes on attach, so a mislabelled GIF is still refused with the same 422.
+export function validateCoverUpload(file: File): void {
+  if (!COVER_TYPES.has(file.type)) {
+    throw ValidationException.withMessages({ cover: 'The cover must be a PNG or JPEG image.' })
+  }
+  if (file.size > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'The cover must be 2 MB or smaller.' })
+  }
+}
