+
+      const page = await inertiaProps<PostsIndexPage>('/posts?tag=bun')
+
+      expect(page.data.map((post) => post.id)).toEqual([third, first])
+      expect(page.data.map((post) => post.tags)).toEqual([['bun', 'webdev'], ['bun']])
+      expect(page.pagination.meta.total).toBe(2)
+      expect(page.tag).toBe('bun')
+    })
