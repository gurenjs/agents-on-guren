diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..be62100
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,133 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokenStore } from '../app/Auth/ApiTokens.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const email = `${label}-${crypto.randomUUID()}@example.test`
+  await User.create({ name: label, email, password: 'password123' })
+  const [user] = await User.where({ email })
+  return user as UserRecord
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let other: UserRecord
+  let session: TestApp
+  let otherSession: TestApp
+
+  async function issue(as: TestApp, name: string): Promise<CreatedToken> {
+    const response = await as.post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<CreatedToken>()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await makeUser('owner')
+    other = await makeUser('other')
+    session = (await http.actingAs(owner).withCsrf('/profile')).json()
+    otherSession = (await http.actingAs(other).withCsrf('/profile')).json()
+  })
+
+  it('creates a token shown once and stores only its hash', async () => {
+    const created = await issue(session, 'CI')
+    expect(created.name).toBe('CI')
+    const [, secret] = created.token.split('|')
+    expect(secret!.length).toBeGreaterThanOrEqual(16)
+
+    const stored = await apiTokenStore.findByUserId(owner.id)
+    const row = stored.find((token) => token.id === created.id)
+    expect(row).toBeDefined()
+    expect(JSON.stringify(row)).not.toContain(secret!)
+  })
+
+  it('rejects missing, empty and over-long names', async () => {
+    const before = (await apiTokenStore.findByUserId(owner.id)).length
+    await session.post('/profile/tokens', {}).assertStatus(422)
+    await session.post('/profile/tokens', { name: '' }).assertStatus(422)
+    await session.post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+    expect((await apiTokenStore.findByUserId(owner.id)).length).toBe(before)
+  })
+
+  it('gives a guest no token', async () => {
+    const guest = (await http.withCsrf('/login')).json()
+    const response = await guest.post('/profile/tokens', { name: 'sneaky' })
+    expect([302, 401]).toContain(response.status)
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await issue(session, 'script')
+
+    const created = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What shipped',
+      body: 'Everything.',
+      authorId: other.id,
+    })
+    created.assertCreated()
+    const { data } = await created.json<{ data: { id: number; authorId: number; createdAt: string } }>()
+    expect(data.authorId).toBe(owner.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const listed = await bearer(token).get('/api/posts')
+    listed.assertOk()
+    const list = await listed.json<{ data: { id: number }[] }>()
+    expect(list.data[0]!.id).toBe(data.id)
+  })
+
+  it('rejects invalid post input without creating anything', async () => {
+    const { token } = await issue(session, 'invalid')
+    const before = (await Post.where({ authorId: owner.id })).length
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertStatus(422)
+    expect((await Post.where({ authorId: owner.id })).length).toBe(before)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const { token } = await issue(session, 'tamper')
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('not-a-token').get('/api/posts').assertUnauthorized()
+    await bearer(`${'0'.repeat(32)}|${'a'.repeat(64)}`).get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertUnauthorized()
+  })
+
+  it('revokes only the owner’s own token', async () => {
+    const revoked = await issue(session, 'old laptop')
+    const kept = await issue(session, 'keep')
+    const foreign = await issue(otherSession, 'foreign')
+
+    await session.delete(`/profile/tokens/${foreign.id}`).assertNotFound()
+    await bearer(foreign.token).get('/api/posts').assertOk()
+
+    await session.delete(`/profile/tokens/${revoked.id}`).assertNoContent()
+    await bearer(revoked.token).get('/api/posts').assertUnauthorized()
+    await bearer(kept.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const first = await issue(session, 'busy')
+    const second = await issue(session, 'quiet')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
