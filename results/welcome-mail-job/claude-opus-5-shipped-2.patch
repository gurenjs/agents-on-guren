+import type { MailConfig } from '@guren/core'
+import { appName } from './app.js'
+
+/**
+ * Outgoing mail configuration, read from the environment.
+ *
+ * `MAIL_MAILER` picks the transport: `log` (the development default) prints
+ * the whole message to the server output instead of delivering it, `memory`
+ * keeps it in memory for tests to inspect, and `resend` delivers for real.
+ * Nothing in the app names a transport, so switching providers in production
+ * is an environment change, not a code change.
+ *
+ * Read lazily, like `config/database.ts` resolves its filename: the value is
+ * resolved when the mail manager is first built rather than when this module
+ * is imported, so a test or a worker can set the environment before booting.
+ */
+export function mailConfig(): MailConfig {
+  return {
+    default: process.env.MAIL_MAILER ?? 'log',
+    from: {
+      email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+      name: process.env.MAIL_FROM_NAME ?? appName(),
+    },
+    transports: {
+      log: { driver: 'log' },
+      memory: { driver: 'memory' },
+      resend: {
+        driver: 'resend',
+        apiKey: process.env.RESEND_API_KEY ?? '',
+      },
+    },
+  }
+}
