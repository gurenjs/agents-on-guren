diff --git a/app/Services/ApiAuthService.ts b/app/Services/ApiAuthService.ts
new file mode 100644
index 0000000..3b8f502
--- /dev/null
+++ b/app/Services/ApiAuthService.ts
@@ -0,0 +1,36 @@
+import { ApiToken } from '../Models/ApiToken.js'
+import { TokenService } from './TokenService.js'
+
+export interface AuthenticatedApiToken {
+  id: number
+  userId: number
+  name: string
+}
+
+export class ApiAuthService {
+  static async authenticateToken(token: string): Promise<AuthenticatedApiToken | null> {
+    const tokens = await ApiToken.newQuery()
+      .where('hashedToken', TokenService.hashToken(token))
+      .get()
+
+    if (tokens.length === 0) {
+      return null
+    }
+
+    const apiToken = tokens[0]
+    return {
+      id: apiToken.id,
+      userId: apiToken.userId,
+      name: apiToken.name,
+    }
+  }
+
+  static extractBearerToken(authHeader: string | undefined): string | null {
+    if (!authHeader) return null
+    const parts = authHeader.split(' ')
+    if (parts.length !== 2 || parts[0].toLowerCase() !== 'bearer') {
+      return null
+    }
+    return parts[1]
+  }
+}
diff --git a/app/Services/RateLimitService.ts b/app/Services/RateLimitService.ts
new file mode 100644
index 0000000..b41a839
--- /dev/null
+++ b/app/Services/RateLimitService.ts
@@ -0,0 +1,40 @@
+interface RateLimitBucket {
+  count: number
+  resetAt: number
+}
+
+const buckets: Map<number, RateLimitBucket> = new Map()
+
+const MAX_REQUESTS = 60
+const WINDOW_MS = 60 * 1000
+
+export class RateLimitService {
+  static checkAndIncrement(tokenId: number): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const bucket = buckets.get(tokenId)
+
+    if (!bucket || bucket.resetAt <= now) {
+      buckets.set(tokenId, { count: 1, resetAt: now + WINDOW_MS })
+      return { allowed: true }
+    }
+
+    if (bucket.count < MAX_REQUESTS) {
+      bucket.count++
+      return { allowed: true }
+    }
+
+    const retryAfter = Math.ceil((bucket.resetAt - now) / 1000)
+    return { allowed: false, retryAfter }
+  }
+
+  static cleanup(): void {
+    const now = Date.now()
+    for (const [key, bucket] of buckets.entries()) {
+      if (bucket.resetAt <= now) {
+        buckets.delete(key)
+      }
+    }
+  }
+}
+
+setInterval(() => RateLimitService.cleanup(), 30000)
