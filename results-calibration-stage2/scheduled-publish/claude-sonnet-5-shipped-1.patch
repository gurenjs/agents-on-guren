@@ -0,0 +1,52 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    other = await User.create({ name: 'B', email: 'b@example.com', password: 'secret-pass-1' })
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'x',
+      body: 'y',
+      authorId: Number(author!.id),
+      publishedAt: new Date(Date.now() + 86_400_000).toISOString(),
+    })
+    postId = post!.id
+  })
+
+  it('hides a scheduled post from everyone but its author', async () => {
+    await http.get(`/posts/${postId}`).assertNotFound()
+    await http.actingAs(other!).get(`/posts/${postId}`).assertNotFound()
+    await http.actingAs(author!).get(`/posts/${postId}`).assertOk()
+    await http.query('/posts/search', { keywords: ['Later'] }).assertJsonCount(0, 'data')
+  })
+
+  it('publishes once the time has passed', async () => {
+    await Post.forceUpdate({ id: postId }, { publishedAt: new Date(Date.now() - 1000).toISOString() })
+    await http.get(`/posts/${postId}`).assertOk()
+    await http.query('/posts/search', { keywords: ['Later'] }).assertJsonCount(1, 'data')
+  })
+
+  it('rejects a publishAt that is not a date', async () => {
+    const csrf = await http.actingAs(author!).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+  })
+})
