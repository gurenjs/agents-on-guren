+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { sql } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { CommentResourceData } from '../app/Http/Resources/CommentResource.js'
+
+// Feature tests against the real src/app.ts and the test database
+// (./data/guren.test.db), rebuilt from the migrations before every test.
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+  let post: PostRecord
+
+  async function createUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name.toLowerCase()}@example.com`, password: 'secret-password' })
+  }
+
+  async function createComment(user: UserRecord, body: string, createdAt?: string): Promise<number> {
+    const comment = await Comment.forceCreate({
+      postId: post.id,
+      userId: user.id,
+      body,
+      ...(createdAt ? { createdAt } : {}),
+    })
+    return comment.id
+  }
+
+  // Every mutating request needs a primed CSRF token, tied to that user's session.
+  async function as(user: UserRecord): Promise<TestApp> {
+    return http.actingAs(user).withCsrf()
+  }
+
+  async function commentsOnPage(client: TestApp = http): Promise<CommentResourceData[]> {
+    const response = await client.get(`/posts/${post.id}`)
+    response.assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    expect(payload.component).toBe('posts/Show')
+    return payload.props.comments as CommentResourceData[]
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await createUser('Author')
+    reader = await createUser('Reader')
+    stranger = await createUser('Stranger')
+    post = await Post.forceCreate({ title: 'A post', excerpt: 'An excerpt', body: 'A body', authorId: author.id })
+  })
+
+  describe('POST /posts/:id/comments', () => {
+    it('sends a guest to the login page and stores nothing', async () => {
+      const guest = await http.withCsrf()
+
+      await guest.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('stores the comment for the signed-in user and redirects to the post', async () => {
+      const client = await as(reader)
+
+      await client.post(`/posts/${post.id}/comments`, { body: 'Nice post' }).assertRedirect(`/posts/${post.id}`)
+
+      const stored = await Comment.all()
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ postId: post.id, userId: reader.id, body: 'Nice post' })
+    })
+
+    it('lets the author comment on their own post', async () => {
+      const client = await as(author)
+
+      await client.post(`/posts/${post.id}/comments`, { body: 'Thanks for reading' }).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.where({ userId: author.id }).count()).toBe(1)
+    })
+
+    it('ignores an author sent in the request', async () => {
+      const client = await as(reader)
+
+      await client.json().post(`/posts/${post.id}/comments`, { body: 'Mine', userId: stranger.id, postId: 999 })
+
+      const stored = await Comment.all()
+      for (const comment of stored) {
+        expect(comment).toMatchObject({ postId: post.id, userId: reader.id })
+      }
+    })
+
+    it('rejects an empty, blank or overlong body and stores nothing', async () => {
+      const client = (await as(reader)).json()
+
+      await client.post(`/posts/${post.id}/comments`, {}).assertUnprocessable()
+      await client.post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+      await client.post(`/posts/${post.id}/comments`, { body: '   ' }).assertUnprocessable()
+      await client.post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+
+    it('accepts a body of exactly 2000 characters', async () => {
+      const client = await as(reader)
+
+      await client.post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2000) }).assertRedirect(`/posts/${post.id}`)
+
+      expect(await Comment.all()).toHaveLength(1)
+    })
+
+    it('answers 404 for a post that does not exist', async () => {
+      const client = await as(reader)
+
+      await client.post('/posts/999/comments', { body: 'Hello' }).assertNotFound()
+
+      expect(await Comment.all()).toHaveLength(0)
+    })
+  })
+
+  describe('GET /posts/:id', () => {
+    it('lists the comments oldest first, each with its author', async () => {
+      await createComment(reader, 'Second', '2026-01-02T00:00:00.000Z')
+      const first = await createComment(stranger, 'First', '2026-01-01T00:00:00.000Z')
+
+      const comments = await commentsOnPage()
+
+      expect(comments.map((comment) => comment.body)).toEqual(['First', 'Second'])
+      expect(comments[0]).toEqual({
+        id: first,
+        body: 'First',
+        author: { id: stranger.id, name: 'Stranger' },
+        createdAt: '2026-01-01T00:00:00.000Z',
+      })
+    })
+
