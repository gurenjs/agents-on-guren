diff --git a/tests/McpTools.test.ts b/tests/McpTools.test.ts
new file mode 100644
index 0000000..9d962d7
--- /dev/null
+++ b/tests/McpTools.test.ts
@@ -0,0 +1,168 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface JsonRpcResult {
+  result?: {
+    tools?: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }>
+    content?: Array<{ type: string; text?: string }>
+    structuredContent?: unknown
+    isError?: boolean
+  }
+  error?: { code: number; message: string }
+}
+
+interface SearchBody {
+  data: Array<Record<string, unknown>>
+}
+
+// The plugin answers plain JSON or an SSE stream depending on the Accept
+// header; the JSON-RPC payload is the last `data:` line either way.
+function parseRpc(text: string): JsonRpcResult {
+  const dataLines = text.split('\n').filter((line) => line.startsWith('data:'))
+  const payload = dataLines.length > 0 ? dataLines[dataLines.length - 1]!.slice(5).trim() : text
+  return JSON.parse(payload) as JsonRpcResult
+}
+
+describe('MCP agent tools at /mcp', () => {
+  let http: TestApp
+  let author: UserRecord
+  let bearer: string
+  let nextId = 1
+
+  async function rpc(method: string, params: Record<string, unknown>, token?: string) {
+    let client = http.json().withHeader('Accept', 'application/json, text/event-stream')
+    if (token) client = client.withHeader('Authorization', `Bearer ${token}`)
+    const response = await client.post('/mcp', { jsonrpc: '2.0', id: nextId++, method, params })
+    return { status: response.status, body: parseRpc(await response.text()) }
+  }
+
+  function toolResultJson<T>(body: JsonRpcResult): T {
+    const result = body.result
+    if (!result) throw new Error(`no result in ${JSON.stringify(body)}`)
+    if (result.structuredContent !== undefined) return result.structuredContent as T
+    const text = result.content?.find((part) => part.type === 'text')?.text
+    if (!text) throw new Error(`no text content in ${JSON.stringify(body)}`)
+    return JSON.parse(text) as T
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'correct-horse-battery' })
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('AuthProvider did not configure an API token store')
+    const issued = await createApiToken(store, { name: 'assistant', userId: author.id, abilities: ['tools:*'] })
+    bearer = issued.plainTextToken
+  })
+
+  it('refuses a call without a bearer credential', async () => {
+    const { status } = await rpc('tools/list', {})
+    expect(status).toBe(401)
+  })
+
+  it('lists exactly posts_search (read-only) and posts_store (not read-only)', async () => {
+    const { status, body } = await rpc('tools/list', {}, bearer)
+    expect(status).toBe(200)
+    const tools = (body.result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+    const summary = tools
+      .map((tool) => ({ name: tool.name, readOnly: tool.annotations?.readOnlyHint === true }))
+      .sort((a, b) => a.name.localeCompare(b.name))
+    expect(summary).toEqual([
+      { name: 'posts_search', readOnly: true },
+      { name: 'posts_store', readOnly: false },
+    ])
+  })
+
+  it('the derived tool catalog agrees with the endpoint', async () => {
+    const tools = await http.agent().tools()
+    const summary = tools
+      .map((tool) => ({ name: tool.toolName, readOnly: tool.annotations.readOnlyHint }))
+      .sort((a, b) => a.name.localeCompare(b.name))
+    expect(summary).toEqual([
+      { name: 'posts_search', readOnly: true },
+      { name: 'posts_store', readOnly: false },
+    ])
+  })
+
+  it('posts_search answers the same JSON as QUERY /posts/search', async () => {
+    await Post.forceCreate({ title: 'Bun 2.0 released', excerpt: 'Fast', body: '...', authorId: author.id })
+    await Post.forceCreate({ title: 'Unrelated', excerpt: 'Nothing here', body: '...', authorId: author.id })
+    const input = { keywords: ['bun'], limit: 5 }
+
+    const expected = await (await http.query('/posts/search', input)).json<SearchBody>()
+    expect(expected.data).toHaveLength(1)
+
+    const { body } = await rpc('tools/call', { name: 'posts_search', arguments: input }, bearer)
+    expect(body.result?.isError ?? false).toBe(false)
+    expect(toolResultJson<SearchBody>(body)).toEqual(expected)
+  })
+
+  it('posts_store creates the post for the credential user and ignores authorId', async () => {
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'correct-horse-battery' })
+    const { body } = await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: 'Drafted by assistant', excerpt: 'Summary', body: 'Body text', authorId: other.id },
+    }, bearer)
+
+    expect(body.error).toBeUndefined()
+    expect(body.result?.isError ?? false).toBe(false)
+    const created = await Post.all()
+    expect(created).toHaveLength(1)
+    expect(created[0]!.title).toBe('Drafted by assistant')
+    expect(created[0]!.authorId).toBe(author.id)
+  })
+
+  it('posts_store rejects input the web form rejects with a 422 and creates nothing', async () => {
+    const { body } = await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'Summary', body: 'Body text' },
+    }, bearer)
+
+    expect(body.result?.isError).toBe(true)
+    const text = body.result?.content?.map((part) => part.text ?? '').join('\n') ?? ''
+    expect(text).toContain('Title is required.')
+    expect(await Post.all()).toHaveLength(0)
+
+    // An MCP error result carries no HTTP status; the endpoint's preflight
+    // companion tool and the in-process bridge both expose the 422.
+    const { body: preflight } = await rpc('tools/call', {
+      name: 'guren_preflight',
+      arguments: { tool: 'posts_store', input: { title: '', excerpt: 'Summary', body: 'Body text' } },
+    }, bearer)
+    expect(toolResultJson<{ allowed: boolean; status: number }>(preflight)).toMatchObject({ allowed: false, status: 422 })
+
+    const bridged = (await http.withCsrf('/posts')).agent()
+    await bridged
+      .call('posts_store', { title: '', excerpt: 'Summary', body: 'Body text' }, { as: author })
+      .assertStatus(422)
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('posts_store refuses a caller who is not signed in', async () => {
+    const result = await http.agent().call('posts_store', { title: 'Guest', excerpt: 'x', body: 'y' })
+    expect([302, 303, 401, 403]).toContain(result.status)
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('posts_search is callable without being signed in', async () => {
+    await Post.forceCreate({ title: 'Bun tips', excerpt: 'Fast', body: '...', authorId: author.id })
+    const result = await http.agent().call('posts_search', { keywords: ['bun'] }).assertOk()
+    expect(result.json<SearchBody>().data).toHaveLength(1)
+  })
+
+  it('the web form still redirects after creating a post', async () => {
+    const session = await http.actingAs(author).withCsrf('/posts')
+    await session
+      .post('/posts', { title: 'From the form', excerpt: 'Summary', body: 'Body text' })
+      .assertRedirect()
+    expect(await Post.all()).toHaveLength(1)
+  })
+})
