+  authorId: z.number(),
+  createdAt: z.string(),
+  author: ApiPostAuthorSchema,
+})
+
+// Bound to the api.posts.index route as `output:` — parsed and enforced
+// against the real response (not just a type-level hint), so a shape drift
+// in the controller fails loudly instead of silently reaching consumers.
+export const ApiPostsResponseSchema = z.object({
+  data: z.array(ApiPostSchema),
+  meta: z.object({
+    currentPage: z.number(),
+    lastPage: z.number(),
+    perPage: z.number(),
+    total: z.number(),
+  }),
+})
+
