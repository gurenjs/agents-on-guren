+import { DatabaseApiTokenStore, defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+// Reads and revocation only: rows are written by `createApiToken()` through
+// `apiTokenStore`, the one place a token's secret is generated and hashed.
+export class ApiToken extends defineModel(apiTokens, {
+  fillable: [],
+  hidden: ['hashedToken'],
+}) {}
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
