diff --git a/app/Http/Validators/PostValidator.ts b/app/Http/Validators/PostValidator.ts
index 804642a..b3b68cf 100644
--- a/app/Http/Validators/PostValidator.ts
+++ b/app/Http/Validators/PostValidator.ts
@@ -23,3 +23,61 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export type CoverContentType = 'image/png' | 'image/jpeg'
+
+/** 2 MB, counted in the decimal megabytes a file manager shows. */
+export const COVER_MAX_BYTES = 2_000_000
+export const COVER_TYPE_MESSAGE = 'Cover must be a PNG or JPEG image.'
+const COVER_SIZE_MESSAGE = 'Cover must be 2 MB or smaller.'
+
+// What a cover may call itself. The two generic types are what a client that
+// does not know the type sends; the file's own bytes settle it either way,
+// in coverContentType() below.
+const COVER_DECLARED_TYPES = ['image/png', 'image/jpeg', 'application/octet-stream', '']
+
+const CoverSchema = z
+  .union([
+    z
+      .file()
+      .max(COVER_MAX_BYTES, COVER_SIZE_MESSAGE)
+      .refine((file) => COVER_DECLARED_TYPES.includes(file.type.split(';')[0].trim().toLowerCase()), COVER_TYPE_MESSAGE),
+    // A form submitted without picking a file still sends the field: Inertia
+    // as null, browsers as an empty file — which the transform below drops.
+    z.null(),
+    z.literal(''),
+  ], COVER_TYPE_MESSAGE)
+  .optional()
+  .transform((value) => (value instanceof File && value.size > 0 ? value : undefined))
+  .pipe(z.file().optional())
+
+export const PostStoreSchema = PostPayloadSchema.extend({
+  cover: CoverSchema,
+})
+
+export const PostUpdateSchema = PostStoreSchema.extend({
+  // A ticked checkbox: `1` from a form, `true` from a JSON body.
+  removeCover: z
+    .union([z.boolean(), z.number(), z.string()])
+    .optional()
+    .transform((value) => value === true || value === 1 || ['1', 'true', 'on'].includes(value as string))
+    .pipe(z.boolean()),
+})
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+/**
+ * The image type a cover's bytes say it is, or null when they are neither PNG
+ * nor JPEG: a GIF renamed to cover.png is still a GIF. Reading a file is
+ * async, which a schema bound to a route cannot be, so the controller calls
+ * this and answers a null with the validation error the schema would raise.
+ */
+export async function coverContentType(file: File): Promise<CoverContentType | null> {
+  const head = new Uint8Array(await file.slice(0, PNG_SIGNATURE.length).arrayBuffer())
+  const startsWith = (signature: number[]) => signature.every((byte, index) => head[index] === byte)
+
+  if (startsWith(PNG_SIGNATURE)) return 'image/png'
+  if (startsWith(JPEG_SIGNATURE)) return 'image/jpeg'
+  return null
+}
