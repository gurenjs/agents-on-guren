diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..169ac76
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,90 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const payload = { title: 'Hello', excerpt: 'Short', body: 'Long body' }
+
+type PostProps = { title: string; tags: string[] }
+
+async function tagsOf(postId: number): Promise<string[]> {
+  const post = await Post.findWithOrFail(postId, 'tags')
+  return post.tags.map((tag) => tag.name).sort()
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  async function props<T>(path: string): Promise<T> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path)
+    return (await response.json<{ props: T }>()).props
+  }
+
+  async function author() {
+    return http.actingAs(user).withCsrf()
+  }
+
+  it('creates, edits and shows tags', async () => {
+    const csrf = await author()
+    await csrf.post('/posts', { ...payload, tags: 'webdev, bun' }).assertRedirect()
+    const [post] = await Post.all()
+    expect(await tagsOf(post!.id)).toEqual(['bun', 'webdev'])
+    expect((await props<{ post: PostProps }>(`/posts/${post!.id}`)).post.tags).toEqual(['bun', 'webdev'])
+
+    await csrf.put(`/posts/${post!.id}`, { ...payload, tags: 'bun' }).assertRedirect()
+    expect(await tagsOf(post!.id)).toEqual(['bun'])
+    expect((await PostTag.all()).length).toBe(1)
+  })
+
+  it('trims, skips empty entries and deduplicates', async () => {
+    const csrf = await author()
+    await csrf.post('/posts', { ...payload, tags: ' bun ,bun,, ' }).assertRedirect()
+    expect((await Tag.all()).map((tag) => tag.name)).toEqual(['bun'])
+    expect((await PostTag.all()).length).toBe(1)
+  })
+
+  it('refuses too many or too long tags without writing anything', async () => {
+    const csrf = await author()
+    await csrf.json().post('/posts', { ...payload, tags: 'a,b,c,d,e,f' }).assertUnprocessable().assertJsonPath('errors.tags.0', 'A post may have at most 5 tags.')
+    await csrf.json().post('/posts', { ...payload, tags: 'x'.repeat(31) }).assertUnprocessable()
+    expect((await Post.all()).length).toBe(0)
+    expect((await Tag.all()).length).toBe(0)
+
+    await csrf.post('/posts', { ...payload, tags: 'x'.repeat(30) }).assertRedirect()
+    expect((await Tag.all()).length).toBe(1)
+  })
+
+  it('filters the list by tag and deletes tagged posts', async () => {
+    const csrf = await author()
+    await csrf.post('/posts', { ...payload, title: 'Tagged', tags: 'bun' }).assertRedirect()
+    await csrf.post('/posts', { ...payload, title: 'Plain' }).assertRedirect()
+
+    const all = await props<{ data: PostProps[] }>('/posts')
+    expect(all.data.map((post) => post.tags)).toEqual([[], ['bun']])
+
+    const filtered = await props<{ data: PostProps[]; pagination: { links: { pages: Array<{ url: string | null }> } } }>(
+      '/posts?tag=bun',
+    )
+    expect(filtered.data.map((post) => post.title)).toEqual(['Tagged'])
+    expect(filtered.pagination.links.pages[0]?.url).toContain('tag=bun')
+    expect((await props<{ data: PostProps[] }>('/posts?tag=nope')).data).toEqual([])
+
+    const tagged = (await Post.first({ title: 'Tagged' }))!
+    await csrf.delete(`/posts/${tagged.id}`).assertRedirect('/posts')
+    expect((await PostTag.all()).length).toBe(0)
+  })
+})
