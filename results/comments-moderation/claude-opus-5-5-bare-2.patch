diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..02ac8f3
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,120 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { CommentResourceData } from '../app/Http/Resources/CommentResource.js'
+
+let http: TestApp
+let sequence = 0
+
+async function makeUser(): Promise<UserRecord> {
+  sequence += 1
+  const email = `commenter-${Date.now()}-${sequence}@example.test`
+  return (await User.create({ name: `Commenter ${sequence}`, email, password: 'password-123' })) as UserRecord
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({ title: 'Commented post', excerpt: 'Excerpt', body: 'Body', authorId: author.id })
+}
+
+function as(user: UserRecord): TestApp {
+  return http.actingAs(user)
+}
+
+async function pageComments(postId: number, viewer?: UserRecord): Promise<CommentResourceData[]> {
+  const client = viewer ? as(viewer) : http
+  const response = await client.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { comments: CommentResourceData[] }).comments
+}
+
+describe('comments', () => {
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+
+    await http.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+  })
+
+  it('stores a comment by the signed-in user and lists it oldest first', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const post = await makePost(author)
+
+    await as(reader).post(`/posts/${post.id}/comments`, { body: 'First' }).assertRedirect(`/posts/${post.id}`)
+    await as(author).post(`/posts/${post.id}/comments`, { body: 'Second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await pageComments(post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['First', 'Second'])
+    expect(comments[0]?.author).toEqual({ id: reader.id, name: reader.name })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects an empty or too long body and stores nothing', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+
+    for (const body of ['', 'x'.repeat(2001)]) {
+      const response = await as(author).post(`/posts/${post.id}/comments`, { body })
+      expect(response.headers.get('location')).not.toBe(`/posts/${post.id}`)
+    }
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const stranger = await makeUser()
+    const post = await makePost(author)
+
+    const first = await Comment.forceCreate({ body: 'One', postId: post.id, userId: reader.id })
+    const second = await Comment.forceCreate({ body: 'Two', postId: post.id, userId: reader.id })
+
+    await as(stranger).delete(`/comments/${first.id}`).assertForbidden()
+    expect(await Comment.where('id', first.id).exists()).toBe(true)
+
+    await as(reader).delete(`/comments/${first.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.where('id', first.id).exists()).toBe(false)
+
+    await as(author).delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.where('id', second.id).exists()).toBe(false)
+  })
+
+  it('counts one report per user and hides a comment after three reporters', async () => {
+    const author = await makeUser()
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ body: 'Spam', postId: post.id, userId: author.id })
+    const reporters = [await makeUser(), await makeUser(), await makeUser()]
+
+    await as(reporters[0]!).post(`/comments/${comment.id}/report`).assertNoContent()
+    await as(reporters[0]!).post(`/comments/${comment.id}/report`).assertNoContent()
+    await as(reporters[1]!).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where('commentId', comment.id).count()).toBe(2)
+    expect((await pageComments(post.id)).map((c) => c.id)).toContain(comment.id)
+
+    await as(reporters[2]!).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await pageComments(post.id)).map((c) => c.id)).not.toContain(comment.id)
+    expect((await pageComments(post.id, author)).map((c) => c.id)).not.toContain(comment.id)
+    expect(await Comment.where('id', comment.id).exists()).toBe(true)
+  })
+
+  it('removes a post’s comments with the post', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ body: 'Bye', postId: post.id, userId: reader.id })
+    await as(reader).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await as(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where('postId', post.id).count()).toBe(0)
+    expect(await CommentReport.where('commentId', comment.id).count()).toBe(0)
+  })
+})
