diff --git a/tests/ProfileController.test.ts b/tests/ProfileController.test.ts
new file mode 100644
index 0000000..283b254
--- /dev/null
+++ b/tests/ProfileController.test.ts
@@ -0,0 +1,184 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { User } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+describe('ProfileController', () => {
+  let http: TestApp
+  let testUser: typeof User.$inferSelect
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    // Reset database and create a test user
+    await User.delete({})
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  it('rejects invalid email format', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'not-an-email',
+        password: '',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.email.0', 'Enter a valid email address.')
+  })
+
+  it('rejects empty name', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: '',
+        email: 'test@example.com',
+        password: '',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.name.0', 'Name is required.')
+  })
+
+  it('rejects password shorter than 8 characters', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'short',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.password.0', 'Password must be at least 8 characters.')
+  })
+
+  it('successfully updates profile with valid data', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'newemail@example.com',
+        password: '',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    if (updated) {
+      const { name, email } = updated
+      if (name === 'Updated Name' && email === 'newemail@example.com') {
+        // Success!
+      } else {
+        throw new Error(`Profile not updated correctly: ${name}, ${email}`)
+      }
+    }
+  })
+
+  it('successfully updates password when provided', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'test@example.com',
+        password: 'newpassword123',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    if (updated) {
+      // The password should be hashed, so we can't compare directly
+      // Just check that the user was found successfully
+      if (updated.id === testUser.id) {
+        // Success!
+      } else {
+        throw new Error('User not found after update')
+      }
+    }
+  })
+
+  it('ignores extra fields not in the profile form', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'newemail@example.com',
+        password: '',
+        id: 9999,
+        passwordHash: 'should-be-ignored',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    if (updated) {
+      // The id should still be the original testUser.id, not 9999
+      if (updated.id === testUser.id && updated.name === 'Updated Name') {
+        // Success - extra fields were ignored
+      } else {
+        throw new Error(`Extra fields were not ignored: id=${updated.id}`)
+      }
+    }
+  })
+
+  it('normalizes email to lowercase', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'TEST@EXAMPLE.COM',
+        password: '',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    if (updated) {
+      if (updated.email === 'test@example.com') {
+        // Success - email was lowercased
+      } else {
+        throw new Error(`Email was not lowercased: ${updated.email}`)
+      }
+    }
+  })
+
+  it('rejects duplicate email', async () => {
+    // Create another user
+    await User.create({
+      name: 'Another User',
+      email: 'another@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'another@example.com',
+        password: '',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.email.0', 'Email is already in use.')
+  })
+
+  it('allows changing to a different email', async () => {
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Test User',
+        email: 'different@example.com',
+        password: '',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    if (updated) {
+      if (updated.email === 'different@example.com') {
+        // Success
+      } else {
+        throw new Error(`Email not updated: ${updated.email}`)
+      }
+    }
+  })
+})
