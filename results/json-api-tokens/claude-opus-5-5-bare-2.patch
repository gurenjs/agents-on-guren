@@ -0,0 +1,28 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+// Serves `/api/posts` to bearer-token clients. The 'api' middleware has already
+// verified the token, so apiTokenUserId() is the token's owner.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .orderBy('createdAt', 'desc')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    // Validated here rather than on the route, so an unauthenticated request
+    // gets its 401 before any 422.
+    const data = await this.validateBody(PostPayloadSchema)
+    // forceCreate, because `authorId` is deliberately absent from Post.fillable:
+    // it comes from the token, and the request body must never be able to set it.
+    const post = await Post.forceCreate({ ...data, authorId: Number(this.apiTokenUserId()) })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..cf30b08
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,32 @@
+import { Controller, createApiToken, revokeApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokens.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenCreateSchema, ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  // The plain-text token exists only in this response; the store keeps a hash.
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(ApiTokenCreateSchema)
+
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    // Looked up among the signed-in user's own tokens, so another user's id
+    // answers 404 exactly like an id that does not exist.
+    const owned = await apiTokenStore.findByUserId(user.id)
+    if (!owned.some((token) => token.id === id)) {
+      return this.json({ message: 'Token not found.' }, { status: 404 })
+    }
+
+    await revokeApiToken(id, apiTokenStore)
+
+    return this.noContent()
+  }
+}
