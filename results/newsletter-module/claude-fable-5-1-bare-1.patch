+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { SubscribeSchema, UnsubscribeSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+// Mounted under the module's `/newsletter` prefix. Open to guests and
+// signed-in visitors alike, so no auth middleware.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [NewsletterController, 'subscribe'])
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+}
