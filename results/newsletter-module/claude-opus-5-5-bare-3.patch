@@ -0,0 +1,20 @@
+import { z } from 'zod'
+
+// Lowercased so the same address in a different case is one subscription.
+const email = z
+  .string()
+  .trim()
+  .min(1, 'Email is required.')
+  .toLowerCase()
+  .pipe(z.email('The email address is badly formatted.'))
+
+export const SubscribePayloadSchema = z.object({ email })
+
+export const UnsubscribePayloadSchema = z.object({ email })
+
+export const ConfirmTokenParamSchema = z.object({
+  token: z.string().min(1),
+})
+
+export type SubscribePayload = z.infer<typeof SubscribePayloadSchema>
+export type UnsubscribePayload = z.infer<typeof UnsubscribePayloadSchema>
