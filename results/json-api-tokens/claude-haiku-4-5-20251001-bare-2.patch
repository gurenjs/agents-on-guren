diff --git a/app/Http/Controllers/Api/PostsController.ts b/app/Http/Controllers/Api/PostsController.ts
new file mode 100644
index 0000000..26a7b7d
--- /dev/null
+++ b/app/Http/Controllers/Api/PostsController.ts
@@ -0,0 +1,109 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { ApiToken } from '../../../Models/ApiToken.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { CreatePostSchema } from '../../Validators/TokenValidator.js'
+import { TokenUtils } from '../../../Utils/TokenUtils.js'
+import { RateLimiter } from '../../../Utils/RateLimiter.js'
+
+export default class ApiPostsController extends Controller {
+  private async authenticateToken(): Promise<{ tokenId: number; userId: number } | null> {
+    const authHeader = this.request.header('authorization')
+    if (!authHeader) {
+      return null
+    }
+
+    const match = authHeader.match(/^Bearer\s+(.+)$/i)
+    if (!match) {
+      return null
+    }
+
+    const token = match[1]
+    const tokenHash = TokenUtils.hashToken(token)
+
+    const apiToken = await ApiToken.newQuery()
+      .where({ tokenHash })
+      .first()
+
+    if (!apiToken) {
+      return null
+    }
+
+    return { tokenId: apiToken.id, userId: apiToken.userId }
+  }
+
+  async index(): Promise<Response> {
+    const auth = await this.authenticateToken()
+    if (!auth) {
+      return new Response(
+        JSON.stringify({ message: 'Unauthorized' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      )
+    }
+
+    const rateLimitCheck = RateLimiter.check(`token_${auth.tokenId}`)
+    if (!rateLimitCheck.allowed) {
+      return new Response(null, {
+        status: 429,
+        headers: { 'Retry-After': String(rateLimitCheck.retryAfter || 60) },
+      })
+    }
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return new Response(
+      JSON.stringify({ data: PostResource.collection(posts) }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    )
+  }
+
+  async store(): Promise<Response> {
+    const auth = await this.authenticateToken()
+    if (!auth) {
+      return new Response(
+        JSON.stringify({ message: 'Unauthorized' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      )
+    }
+
+    const rateLimitCheck = RateLimiter.check(`token_${auth.tokenId}`)
+    if (!rateLimitCheck.allowed) {
+      return new Response(null, {
+        status: 429,
+        headers: { 'Retry-After': String(rateLimitCheck.retryAfter || 60) },
+      })
+    }
+
+    let data
+    try {
+      data = await this.validateBody(CreatePostSchema)
+    } catch (error) {
+      return new Response(
+        JSON.stringify({ message: 'Validation failed' }),
+        { status: 422, headers: { 'Content-Type': 'application/json' } }
+      )
+    }
+
+    const post = await Post.forceCreate({
+      ...data,
+      authorId: auth.userId,
+    })
+
+    if (!post) {
+      return new Response(
+        JSON.stringify({ message: 'Failed to create post' }),
+        { status: 422, headers: { 'Content-Type': 'application/json' } }
+      )
+    }
+
+    const createdPost = await Post.findWithOrFail(post.id, 'author')
+
+    return new Response(
+      JSON.stringify({ data: new PostResource(createdPost).toJSON() }),
+      { status: 201, headers: { 'Content-Type': 'application/json' } }
+    )
+  }
+}
diff --git a/app/Http/Controllers/ProfileTokenController.ts b/app/Http/Controllers/ProfileTokenController.ts
new file mode 100644
index 0000000..23af1c4
--- /dev/null
+++ b/app/Http/Controllers/ProfileTokenController.ts
@@ -0,0 +1,51 @@
+import { Controller, ValidationException } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CreateTokenSchema } from '../Validators/TokenValidator.js'
+import { TokenUtils } from '../../Utils/TokenUtils.js'
+
+export default class ProfileTokenController extends Controller {
+  async create(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateTokenSchema)
+
+    const token = TokenUtils.generateToken()
+    const tokenHash = TokenUtils.hashToken(token)
+
+    const createdToken = await ApiToken.create({
+      userId: user.id,
+      name,
+      tokenHash,
+    })
+
+    const response = new Response(
+      JSON.stringify({
+        id: createdToken.id,
+        name: createdToken.name,
+        token,
+      }),
+      {
+        status: 201,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    )
+    return response
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const id = this.request.param('id') ? parseInt(this.request.param('id') as string) : null
+
+    if (!id) {
+      throw ValidationException.withMessages({ id: 'Invalid token ID.' })
+    }
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      return new Response(null, { status: 404 })
+    }
+
+    await ApiToken.delete({ id })
+    return new Response(null, { status: 204 })
+  }
+}
