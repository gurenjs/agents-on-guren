+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let web: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+  const suffix = Math.random().toString(36).slice(2)
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    web = (await http.withCsrf('/login')).json()
+    owner = await User.create({ name: 'Owner', email: `owner-${suffix}@example.com`, password: 'password123' })
+    other = await User.create({ name: 'Other', email: `other-${suffix}@example.com`, password: 'password123' })
+  })
+
+  async function createToken(user: unknown, name = 'CI') {
+    const response = await web.actingAs(user).post('/profile/tokens', { name })
+    response.assertStatus(201)
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+
+  const bearer = (token: string) => ({ Authorization: `Bearer ${token}` })
+
+  it('validates the token name', async () => {
+    for (const name of ['', 'x'.repeat(51)]) {
+      await web.actingAs(owner).post('/profile/tokens', { name }).assertStatus(422)
+    }
+  })
+
+  it('authenticates, scopes authors, revokes and rate limits per token', async () => {
+    const first = await createToken(owner)
+    const second = await createToken(owner, 'laptop')
+    expect(first.token.split('|')[1]!.length).toBeGreaterThanOrEqual(16)
+
+    const created = await http.json().withHeaders(bearer(first.token)).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: (other as { id: number }).id })
+    created.assertStatus(201)
+    expect(((await created.json()) as { data: { authorId: number } }).data.authorId).toBe((owner as { id: number }).id)
+
+    await http.json().withHeaders(bearer(first.token)).post('/api/posts', { title: '' }).assertStatus(422)
+
+    const list = await http.json().withHeaders(bearer(first.token)).get('/api/posts')
+    list.assertStatus(200)
+    expect(((await list.json()) as { data: unknown[] }).data.length).toBeGreaterThan(0)
+
+    await http.json().withHeaders(bearer(`${first.token}x`)).get('/api/posts').assertStatus(401)
+    await http.json().get('/api/posts').assertStatus(401)
+
+    await web.actingAs(other).delete(`/profile/tokens/${first.id}`).assertStatus(404)
+    await http.json().withHeaders(bearer(first.token)).get('/api/posts').assertStatus(200)
+
+    for (let i = 0; i < 56; i++) {
+      await http.json().withHeaders(bearer(first.token)).get('/api/posts')
+    }
+    const limited = await http.json().withHeaders(bearer(first.token)).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.json().withHeaders(bearer(second.token)).get('/api/posts').assertStatus(200)
+
+    await web.actingAs(owner).delete(`/profile/tokens/${first.id}`).assertStatus(204)
+    await http.json().withHeaders(bearer(first.token)).get('/api/posts').assertStatus(401)
+    await http.json().withHeaders(bearer(second.token)).get('/api/posts').assertStatus(200)
+  })
+})
