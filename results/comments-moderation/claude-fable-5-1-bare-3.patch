new file mode 100644
index 0000000..f0698b6
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,33 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+/**
+ * What the policy needs to decide: who wrote the comment and who owns the
+ * post it sits on. CommentController builds it from the two loaded rows.
+ */
+export interface CommentSubject {
+  userId: number
+  postAuthorId: number
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * Creating and reporting only need a session; deleting is reserved for the
+ * comment's author and the author of the post it is on.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentSubject): boolean {
+    if (user === null) {
+      return false
+    }
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === comment.postAuthorId
+  }
+
+  report(user: AuthUser | null): boolean {
+    return user !== null
+  }
+}
