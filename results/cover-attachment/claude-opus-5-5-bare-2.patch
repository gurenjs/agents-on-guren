diff --git a/app/Http/Controllers/AttachmentController.ts b/app/Http/Controllers/AttachmentController.ts
new file mode 100644
index 0000000..6cfb862
--- /dev/null
+++ b/app/Http/Controllers/AttachmentController.ts
@@ -0,0 +1,27 @@
+import { Controller, NotFoundHttpException } from '@guren/core'
+import { z } from 'zod'
+import { Attachment } from '../../Models/Attachment.js'
+import { readAttachment } from '../../Support/AttachmentStorage.js'
+
+const AttachmentKeyParamSchema = z.object({
+  key: z.string().min(1),
+})
+
+export default class AttachmentController extends Controller {
+  async show(): Promise<Response> {
+    const { key } = this.validateParams(AttachmentKeyParamSchema)
+    const attachment = await Attachment.where('key', key).first()
+    const bytes = attachment ? await readAttachment(attachment) : null
+    if (!attachment || !bytes) throw new NotFoundHttpException()
+
+    // Served byte-for-byte as uploaded, under the type sniffed at upload time.
+    return new Response(new Uint8Array(bytes), {
+      headers: {
+        'Content-Type': attachment.contentType,
+        'Content-Length': String(bytes.byteLength),
+        'X-Content-Type-Options': 'nosniff',
+        'Cache-Control': 'private, max-age=3600',
+      },
+    })
+  }
+}
