+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,31 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import type { UserRecord } from '../../../Models/User.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+function summary(post: Post | Awaited<ReturnType<typeof Post.find>>) {
+  const p = post as { id: number; title: string; excerpt: string; authorId: number; createdAt: string | Date }
+  return {
+    id: p.id,
+    title: p.title,
+    excerpt: p.excerpt,
+    authorId: p.authorId,
+    createdAt: new Date(p.createdAt).toISOString(),
+  }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+    return this.json({ data: posts.map((post) => summary(post)) })
+  }
+
+  async store(): Promise<Response> {
+    const owner = await this.auth.userOrFail<UserRecord>()
+    const data = await this.validateBody(PostPayloadSchema)
+    // authorId comes from the token's owner, never from the body.
+    const post = await Post.forceCreate({ ...data, authorId: owner.id })
+
+    return this.json({ data: summary(post) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..e657ec6
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,27 @@
+import { Controller, createApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenPayloadSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(ApiTokenPayloadSchema)
+    const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId: user.id })
+
+    // The only response that ever carries the plain token.
+    return this.json({ id: token.id, name: token.name, token: plainTextToken }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const id = String(this.ctx.req.param('id'))
+    const owned = (await apiTokenStore.findByUserId(user.id)).find((token) => token.id === id)
+    if (!owned) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await apiTokenStore.delete(owned.id)
+    return new Response(null, { status: 204 })
+  }
+}
