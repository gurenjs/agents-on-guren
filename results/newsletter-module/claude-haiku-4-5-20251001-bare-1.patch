+++ b/modules/newsletter/index.ts
@@ -0,0 +1,19 @@
+import type { Router } from '@guren/core'
+import NewsletterController from './http/controller.js'
+import { SubscribeEmailSchema, UnsubscribeEmailSchema } from './http/validators.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post(
+    '/newsletter/subscribe',
+    { name: 'newsletter.subscribe', body: SubscribeEmailSchema },
+    [NewsletterController, 'subscribe']
+  )
+
+  router.get('/newsletter/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+
+  router.post(
+    '/newsletter/unsubscribe',
+    { name: 'newsletter.unsubscribe', body: UnsubscribeEmailSchema },
+    [NewsletterController, 'unsubscribe']
+  )
+}
