@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'bun:test'
+import { checkDatabaseConnection } from '../app/Support/HealthCheck.js'
+
+describe('checkDatabaseConnection', () => {
+  it('reports ok when the round-trip query succeeds', async () => {
+    const result = await checkDatabaseConnection(async () => ({
+      run: async () => undefined,
+    }))
+
+    expect(result).toEqual({ status: 'ok' })
+  })
+
+  it('reports error when the query throws', async () => {
+    const result = await checkDatabaseConnection(async () => ({
+      run: async () => {
+        throw new Error('database is locked')
+      },
+    }))
+
+    expect(result.status).toBe('error')
+    expect(result.message).toBe('database is locked')
+  })
+
+  it('reports error when the connection cannot be opened', async () => {
+    const result = await checkDatabaseConnection(async () => {
+      throw new Error('connection refused')
+    })
+
+    expect(result.status).toBe('error')
+    expect(result.message).toBe('connection refused')
+  })
+})
