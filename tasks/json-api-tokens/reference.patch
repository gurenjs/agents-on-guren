diff --git a/routes/api.ts b/routes/api.ts
new file mode 100644
index 0000000..982db93
--- /dev/null
+++ b/routes/api.ts
@@ -0,0 +1,23 @@
+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Auth/api-tokens.js'
+import { ApiPostResource } from '../app/Http/Resources/ApiPostResource.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  // Order matters: the throttle keys its bucket by the token the guard verified.
+  const router = baseRouter
+    .aliasMiddleware('api.token', authenticateApiToken)
+    .aliasMiddleware('api.throttle', throttleApiToken)
+
+  router.middleware('api.token', 'api.throttle').group((api) => {
+    api.group('/api', (scoped) => {
+      scoped.get('/posts', { name: 'api.posts.index', resource: { data: [ApiPostResource] } }, [ApiPostController, 'index'])
+      scoped.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: ApiPostResource },
+      }, [ApiPostController, 'store'])
+    })
+  })
+}
