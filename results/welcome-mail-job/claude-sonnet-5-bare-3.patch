+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,23 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeMailData {
+  name: string
+}
+
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeMailData,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const appName = process.env.APP_NAME ?? 'Guren'
+    const { name } = this.data
+
+    return this
+      .subject(`Welcome to ${appName}, ${name}!`)
+      .text(`Hi ${name},\n\nWelcome to ${appName}! We're glad to have you with us.\n\n— The ${appName} team`)
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..ff81839
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,29 @@
+import { ServiceProvider, createMailManager, setMailManager, type MailManager } from '@guren/core'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    const manager = createMailManager({
+      // MAIL_MAILER=log (dev default) writes messages to the server output;
+      // MAIL_MAILER=resend sends through the Resend API in production.
+      default: process.env.MAIL_MAILER === 'resend' ? 'resend' : 'log',
+      from: {
+        email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+        name: process.env.MAIL_FROM_NAME ?? process.env.APP_NAME ?? 'Guren',
+      },
+      transports: {
+        log: { driver: 'log' },
+        resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+      },
+    })
+
+    this.container.instance('mail', manager)
+  }
+
+  boot(): void {
+    // Queued jobs run outside a request/controller context, so they read the
+    // mail manager off this global rather than resolving it from the
+    // container.
+    const manager = this.container.make<MailManager>('mail')
+    setMailManager(manager)
+  }
+}
diff --git a/app/Providers/QueueProvider.ts b/app/Providers/QueueProvider.ts
new file mode 100644
index 0000000..e76b384
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,29 @@
+import { ServiceProvider, SyncDriver, RedisDriver, createQueueManager, registerJob, type QueueManager } from '@guren/core'
+import { createRedisClient } from '@guren/core/redis'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    const queue = createQueueManager({
+      // QUEUE_CONNECTION=sync (dev default) runs jobs inline on dispatch, no
+      // worker needed; QUEUE_CONNECTION=redis queues them for a separate
+      // `queue:work` process in production.
+      default: process.env.QUEUE_CONNECTION === 'redis' ? 'redis' : 'sync',
+      drivers: {
+        sync: () => new SyncDriver(),
+        redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+      },
+    })
+
+    this.container.instance('queue', queue)
+  }
+
+  boot(): void {
+    // Register job classes before resolving the driver — a sync dispatch
+    // runs the job inline, and needs the class in the registry to do it.
+    registerJob(SendWelcomeEmailJob)
+
+    const queue = this.container.make<QueueManager>('queue')
+    queue.driver()
+  }
+}
