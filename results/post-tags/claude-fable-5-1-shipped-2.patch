+      }
+      await savePost('Untagged')
+
+      const filter = `tag=${encodeURIComponent(tag)}`
+      const first = await inertiaProps<PostsIndexPage>(`/posts?${filter}`)
+      expect(first.data).toHaveLength(10)
+      expect(first.data[0]?.title).toBe('Post 12')
