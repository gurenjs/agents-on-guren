diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..680a4d8
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,224 @@
+import { beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('Post Slugs', () => {
+  let http: TestApp
+  let user: any
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    user = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'secret',
+    })
+  })
+
+  describe('slug generation', () => {
+    it('generates slug from title', () => {
+      const slug = Post.generateSlug('Hello, World!')
+      expect(slug).toBe('hello-world')
+    })
+
+    it('converts to lowercase', () => {
+      const slug = Post.generateSlug('UPPERCASE')
+      expect(slug).toBe('uppercase')
+    })
+
+    it('removes special characters', () => {
+      const slug = Post.generateSlug('Guren & Bun: 2026 Edition!')
+      expect(slug).toBe('guren-bun-2026-edition')
+    })
+
+    it('handles leading and trailing whitespace', () => {
+      const slug = Post.generateSlug('  Guren  &  Bun: 2026 Edition!  ')
+      expect(slug).toBe('guren-bun-2026-edition')
+    })
+
+    it('joins words with single dashes', () => {
+      const slug = Post.generateSlug('My   Post   Title')
+      expect(slug).toBe('my-post-title')
+    })
+
+    it('removes leading and trailing dashes', () => {
+      const slug = Post.generateSlug('-Hello-World-')
+      expect(slug).toBe('hello-world')
+    })
+  })
+
+  describe('slug uniqueness', () => {
+    it('finds unique slug when none exist', async () => {
+      const slug = await Post.findUniqueSlug('hello-world')
+      expect(slug).toBe('hello-world')
+    })
+
+    it('appends -2 for second post with same base slug', async () => {
+      await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        authorId: user.id,
+      })
+
+      const slug = await Post.findUniqueSlug('hello-world')
+      expect(slug).toBe('hello-world-2')
+    })
+
+    it('appends -3 for third post with same base slug', async () => {
+      await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        authorId: user.id,
+      })
+      await Post.forceCreate({
+        title: 'Hello, World! (2)',
+        slug: 'hello-world-2',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        authorId: user.id,
+      })
+
+      const slug = await Post.findUniqueSlug('hello-world')
+      expect(slug).toBe('hello-world-3')
+    })
+  })
+
+  describe('creating posts with slugs', () => {
+    it('creates post with generated unique slug', async () => {
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf
+        .post('/posts', {
+          title: 'Hello, World!',
+          excerpt: 'My first post',
+          body: 'This is the body',
+        })
+        .assertRedirect('/posts/hello-world')
+
+      const post = await Post.first({ title: 'Hello, World!' })
+      expect(post).not.toBeNull()
+      expect(post?.slug).toBe('hello-world')
+    })
+
+    it('creates post with -2 suffix when slug already exists', async () => {
+      await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'First post',
+        body: 'Body',
+        authorId: user.id,
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      const response = await csrf.post('/posts', {
+        title: 'Hello, World!',
+        excerpt: 'Second post',
+        body: 'This is the body',
+      })
+
+      const secondPost = await Post.where({ title: 'Hello, World!' }).orderBy('id', 'desc').first()
+      expect(secondPost?.slug).toBe('hello-world-2')
+      await response.assertRedirect(`/posts/${secondPost?.slug}`)
+    })
+  })
+
+  describe('accessing posts by slug', () => {
+    it('serves post by slug', async () => {
+      const post = await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'My first post',
+        body: 'This is the body',
+        authorId: user.id,
+      })
+
+      await http.get('/posts/hello-world').assertOk()
+    })
+
+    it('returns 404 for unknown slug', async () => {
+      await http.get('/posts/non-existent-slug').assertNotFound()
+    })
+
+    it('includes slug in post data', async () => {
+      const post = await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'My first post',
+        body: 'This is the body',
+        authorId: user.id,
+      })
+
+      await http.get('/posts/hello-world').assertOk()
+      const fetched = await Post.findOrFail(post.id)
+      expect(fetched.slug).toBe('hello-world')
+    })
+  })
+
+  describe('numeric id redirect', () => {
+    it('redirects numeric id to slug with 301', async () => {
+      const post = await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'My first post',
+        body: 'This is the body',
+        authorId: user.id,
+      })
+
+      const res = await http.get(`/posts/${post.id}`)
+      await res.assertRedirect('/posts/hello-world')
+      expect(res.status).toBe(301)
+    })
+
+    it('returns 404 for non-existent numeric id', async () => {
+      await http.get('/posts/9999').assertNotFound()
+    })
+  })
+
+  describe('updating posts', () => {
+    it('redirects to slug URL after update', async () => {
+      const post = await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'My first post',
+        body: 'This is the body',
+        authorId: user.id,
+      })
+
+      const csrf = await http.actingAs(user).withCsrf()
+      await csrf
+        .put(`/posts/${post.id}`, {
+          title: 'Updated Title',
+          excerpt: 'Updated excerpt',
+          body: 'Updated body',
+        })
+        .assertRedirect('/posts/hello-world')
+    })
+
+    it('preserves slug on title change', async () => {
+      const post = await Post.forceCreate({
+        title: 'Hello, World!',
+        slug: 'hello-world',
+        excerpt: 'My first post',
+        body: 'This is the body',
+        authorId: user.id,
+      })
+
+      await Post.update({ id: post.id }, {
+        title: 'Completely Different Title',
+        excerpt: 'New excerpt',
+        body: 'New body',
+      })
+
+      const updated = await Post.findOrFail(post.id)
+      expect(updated.slug).toBe('hello-world')
+    })
+  })
+})
