new file mode 100644
index 0000000..d341acd
--- /dev/null
+++ b/app/Http/Health.ts
@@ -0,0 +1,61 @@
+import { sql } from 'drizzle-orm'
+
+export type HealthCheckStatus = 'ok' | 'error'
+
+export interface HealthCheckResult {
+  status: HealthCheckStatus
+  latencyMs: number
+  message?: string
+}
+
+/** Minimal shape `/health` needs from a drizzle database handle. */
+export interface HealthCheckConnection {
+  get(query: unknown): Promise<unknown>
+}
+
+const DEFAULT_TIMEOUT_MS = 5000
+
+/**
+ * Runs a cheap round trip against the database — not a cached flag — so a
+ * probe always reflects whether the database is reachable right now. Never
+ * throws: a failed query, a failed connection, or a hang past `timeoutMs`
+ * all resolve to `{ status: 'error' }` so the caller can turn that into a
+ * 503 instead of an unhandled 500.
+ */
+export async function checkDatabaseHealth(
+  connect: () => Promise<HealthCheckConnection>,
+  timeoutMs = DEFAULT_TIMEOUT_MS,
+): Promise<HealthCheckResult> {
+  const startedAt = performance.now()
+
+  try {
+    await withTimeout(connect().then((db) => db.get(sql`select 1`)), timeoutMs)
+    return { status: 'ok', latencyMs: elapsedMs(startedAt) }
+  } catch (error) {
+    return {
+      status: 'error',
+      latencyMs: elapsedMs(startedAt),
+      message: error instanceof Error ? error.message : String(error),
+    }
+  }
+}
+
+function elapsedMs(startedAt: number): number {
+  return Math.round(performance.now() - startedAt)
+}
+
+function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`database check timed out after ${ms}ms`)), ms)
+    promise.then(
+      (value) => {
+        clearTimeout(timer)
+        resolve(value)
+      },
+      (error) => {
+        clearTimeout(timer)
+        reject(error)
+      },
+    )
+  })
+}
