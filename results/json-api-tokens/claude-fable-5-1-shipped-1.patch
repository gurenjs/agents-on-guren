+  let http: TestApp
+  let user: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret' })
+    other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret' })
