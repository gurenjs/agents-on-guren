diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..75e2b62
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,71 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { apiTokenStore } from '../app/Support/ApiTokens.js'
+
+describe('api tokens', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+
+  async function issueToken(name = 'CI'): Promise<{ id: string; token: string }> {
+    const session = (await http.actingAs(owner).withCsrf()).json()
+    const res = await session.post('/profile/tokens', { name })
+    res.assertStatus(201)
+    return await res.json<{ id: string; token: string }>()
+  }
+
+  const bearer = (token: string) => ({ Accept: 'application/json', Authorization: `Bearer ${token}` })
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    owner = await User.create({ name: 'Tok', email: `tok-${Date.now()}@example.com`, password: 'password123' })
+  })
+
+  it('answers 401 without or with a bad bearer token', async () => {
+    await http.json().get('/api/posts').assertStatus(401)
+    await http.withHeaders(bearer('nope')).get('/api/posts').assertStatus(401)
+    await http.withHeaders(bearer('abc|def')).get('/api/posts').assertStatus(401)
+  })
+
+  it('stores only a hash, authenticates, and stops after revocation', async () => {
+    const { id, token } = await issueToken()
+    const secret = token.split('|')[1]
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+    const stored = JSON.stringify(await apiTokenStore.findByUserId(Number(owner.id)))
+    expect(stored).not.toContain(secret)
+
+    await http.withHeaders(bearer(token)).get('/api/posts').assertStatus(200)
+    await http.withHeaders(bearer(`${token}x`)).get('/api/posts').assertStatus(401)
+
+    const session = (await http.actingAs(owner).withCsrf()).json()
+    await session.delete(`/profile/tokens/${id}`).assertStatus(204)
+    await http.withHeaders(bearer(token)).get('/api/posts').assertStatus(401)
+  })
+
+  it('creates posts for the token owner and rejects invalid input', async () => {
+    const { token } = await issueToken()
+    const res = await http
+      .withHeaders(bearer(token))
+      .post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999999 })
+    res.assertStatus(201)
+    const created = await res.json<{ data: { authorId: number } }>()
+    expect(created.data.authorId).toBe(Number(owner.id))
+
+    await http.withHeaders(bearer(token)).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertStatus(422)
+  })
+
+  it('rate limits per token', async () => {
+    const first = await issueToken('a')
+    const second = await issueToken('b')
+    for (let i = 0; i < 60; i++) {
+      await http.withHeaders(bearer(first.token)).get('/api/posts').assertStatus(200)
+    }
+    const limited = await http.withHeaders(bearer(first.token)).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.withHeaders(bearer(second.token)).get('/api/posts').assertStatus(200)
+  })
+})
