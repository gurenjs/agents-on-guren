diff --git a/tests/ProfileController.test.ts b/tests/ProfileController.test.ts
new file mode 100644
index 0000000..332ed2b
--- /dev/null
+++ b/tests/ProfileController.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('profile.update', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Original Name', email: 'original@example.com', password: 'correct-password' })
+  })
+
+  it('rejects a malformed email and leaves the account unchanged', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.put('/profile', { name: 'Original Name', email: 'not-an-email' }).assertUnprocessable()
+
+    const stored = await User.findOrFail(user.id)
+    expect(stored.email).toBe('original@example.com')
+  })
+
+  it('rejects an empty name and leaves the account unchanged', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.put('/profile', { name: '', email: 'original@example.com' }).assertUnprocessable()
+
+    const stored = await User.findOrFail(user.id)
+    expect(stored.name).toBe('Original Name')
+  })
+
+  it('rejects a too-short password and leaves the account unchanged', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.put('/profile', { name: 'Original Name', email: 'original@example.com', password: 'short' }).assertUnprocessable()
+  })
+
+  it('ignores fields outside the profile form, such as id or passwordHash', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const originalHash = (await User.findOrFail(user.id)).passwordHash
+
+    await csrf.put('/profile', {
+      id: 999,
+      passwordHash: 'hijacked',
+      name: 'Updated Name',
+      email: 'updated@example.com',
+    }).assertOk()
+
+    const stored = await User.findOrFail(user.id)
+    expect(stored.id).toBe(user.id)
+    expect(stored.passwordHash).toBe(originalHash)
+    expect(stored.name).toBe('Updated Name')
+    expect(stored.email).toBe('updated@example.com')
+  })
+
+  it('saves a valid update, lowercasing the email', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.put('/profile', { name: '  New Name  ', email: 'NEW@Example.com' }).assertOk()
+
+    const stored = await User.findOrFail(user.id)
+    expect(stored.name).toBe('New Name')
+    expect(stored.email).toBe('new@example.com')
+  })
+})
