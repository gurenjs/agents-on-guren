+import { defineModel } from '@guren/core'
+import { newsletterSubscriptions } from '../../db/schema.js'
+
+export type SubscriptionRecord = typeof newsletterSubscriptions.$inferSelect
+export type NewSubscriptionRecord = typeof newsletterSubscriptions.$inferInsert
+
+export class Subscription extends defineModel(newsletterSubscriptions, {
+  // `token` and `confirmedAt` are set by the module itself, never from
+  // request input, so writes that touch them go through forceCreate/forceUpdate.
+  fillable: ['email'],
+}) {}
diff --git a/modules/newsletter/db/schema.ts b/modules/newsletter/db/schema.ts
new file mode 100644
index 0000000..d1d1b17
--- /dev/null
+++ b/modules/newsletter/db/schema.ts
@@ -0,0 +1,15 @@
+import { sqliteTable, integer, text } from '@guren/orm/drizzle/sqlite'
+
+// The newsletter module's only table. drizzle.config.ts reads this file
+// directly, so the root db/schema.ts never has to import it and the blog
+// stays unaware of the module.
+export const newsletterSubscriptions = sqliteTable('newsletter_subscriptions', {
+  id: integer('id').primaryKey({ autoIncrement: true }),
+  email: text('email').notNull().unique(),
+  // Random, unguessable confirmation token issued on subscribe; the
+  // confirmation link carries it.
+  token: text('token').notNull().unique(),
+  // Null until the visitor follows the confirmation link.
+  confirmedAt: text('confirmed_at'),
+  createdAt: text('created_at').notNull().$defaultFn(() => new Date().toISOString()),
+})
