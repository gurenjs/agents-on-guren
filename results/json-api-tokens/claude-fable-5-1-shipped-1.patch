+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { AuthenticateApiTokenMiddleware } from '../app/Http/Middleware/AuthenticateApiTokenMiddleware.js'
+import { ThrottleApiTokenMiddleware } from '../app/Http/Middleware/ThrottleApiTokenMiddleware.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+// Every /api route authenticates by bearer token and never by session cookie:
+// src/app.ts exempts the prefix from CSRF on that assumption.
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api.token', AuthenticateApiTokenMiddleware)
+    .aliasMiddleware('api.throttle', ThrottleApiTokenMiddleware)
+
+  router.group('/api', (api) => {
+    // In this order: the throttle keys on the token 'api.token' verified.
+    api.middleware('api.token', 'api.throttle').group((authed) => {
+      authed.get('/posts', {
+        name: 'api.posts.index',
+        resource: { data: [PostResource] },
+      }, [ApiPostController, 'index'])
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [ApiPostController, 'store'])
+    })
+  })
+}
