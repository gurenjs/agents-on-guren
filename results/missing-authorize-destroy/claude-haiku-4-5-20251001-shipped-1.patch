+
+describe('PostController.destroy', () => {
+  let http: TestApp
+  let authorUser: typeof User.$inferSelect
+  let otherUser: typeof User.$inferSelect
+  let authorPost: typeof Post.$inferSelect
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    // Create two users
+    authorUser = await User.create({
+      name: 'Author User',
+      email: 'author@example.com',
+      password: 'secret',
+    })
+
+    otherUser = await User.create({
+      name: 'Other User',
+      email: 'other@example.com',
+      password: 'secret',
+    })
+
+    // Create a post by the author using forceCreate (authorId is not fillable)
+    authorPost = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: authorUser.id,
+    })
+  })
+
+  it('author can delete their own post', async () => {
+    const csrf = await http.actingAs(authorUser).withCsrf()
+    await csrf.delete(`/posts/${authorPost.id}`).assertRedirect('/posts')
+
+    // Verify post is deleted
+    const deleted = await Post.find(authorPost.id)
+    if (deleted !== null) {
+      throw new Error('Post should be deleted')
+    }
+  })
+
+  it('other authenticated user cannot delete the post', async () => {
+    const csrf = await http.actingAs(otherUser).withCsrf()
+    await csrf.delete(`/posts/${authorPost.id}`).assertStatus(403)
+
+    // Verify post still exists
+    const exists = await Post.find(authorPost.id)
+    if (exists === null) {
+      throw new Error('Post should still exist')
+    }
+  })
+
+  it('unauthenticated user cannot delete the post', async () => {
+    const csrf = await http.withCsrf()
+    // Guest requests should be redirected to login
+    await csrf.delete(`/posts/${authorPost.id}`).assertRedirect()
+
+    // Verify post still exists
+    const exists = await Post.find(authorPost.id)
+    if (exists === null) {
+      throw new Error('Post should still exist')
+    }
+  })
+})
