diff --git a/modules/newsletter/Http/NewsletterController.ts b/modules/newsletter/Http/NewsletterController.ts
new file mode 100644
index 0000000..1d133ae
--- /dev/null
+++ b/modules/newsletter/Http/NewsletterController.ts
@@ -0,0 +1,61 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../Models/NewsletterSubscription.js'
+import { ConfirmParamSchema, EmailPayloadSchema } from './validators.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailPayloadSchema)
+
+    const existing = await NewsletterSubscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    // forceCreate: `token` is deliberately not fillable.
+    await NewsletterSubscription.forceCreate({ email, token: randomToken() })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmParamSchema)
+    const [subscription] = await NewsletterSubscription.where({ token })
+    if (!subscription) {
+      return new Response('Not Found', { status: 404 })
+    }
+
+    await NewsletterSubscription.update(
+      { id: subscription.id },
+      { confirmedAt: new Date().toISOString() },
+    )
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailPayloadSchema)
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  // The page the visitor came from, as a same-site path; anything else is
+  // ignored so the Referer header cannot turn this into an open redirect.
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const target = new URL(referer)
+      const self = new URL(this.request.url)
+      if (target.host === self.host) return `${target.pathname}${target.search}`
+    } catch {
+      // fall through
+    }
+    return '/'
+  }
+}
+
+function randomToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('')
+}
