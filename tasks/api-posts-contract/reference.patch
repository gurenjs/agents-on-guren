diff --git a/app/Http/Controllers/Api/PostController.ts b/app/Http/Controllers/Api/PostController.ts
new file mode 100644
index 0000000..9a84ccf
--- /dev/null
+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,37 @@
+import { Controller, paginate } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { ApiPostsQuerySchema } from '../../Validators/PostValidator.js'
+
+const PER_PAGE = 10
+
+// Public JSON listing for external consumers: `GET /api/posts?page=&author=`.
+// Serves the same PostResource shape the pages receive, paginated with the
+// standard `{ data, meta, links }` envelope.
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsQuerySchema)
+
+    const scoped = () => {
+      let query = Post.newQuery()
+      if (author !== undefined) {
+        query = query.where('authorId', author)
+      }
+      return query
+    }
+
+    const total = await scoped().count()
+    const posts = await scoped()
+      .with('author')
+      .orderBy('id', 'desc')
+      .limit(PER_PAGE)
+      .offset((page - 1) * PER_PAGE)
+      .get()
+
+    const paginator = paginate(posts, total, PER_PAGE, page, {
+      path: this.request.path ?? '/api/posts',
+    })
+
+    return this.json(paginator.toResource(PostResource))
+  }
+}
