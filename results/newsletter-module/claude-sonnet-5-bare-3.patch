+++ b/guren.arch.ts
@@ -0,0 +1,18 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module is self-contained and must stay liftable into another
+// app, so the blog (app/ and routes/) may never depend on it.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'app/ and routes/ must not import from modules/newsletter/. The module is loaded in src/app.ts.',
+    },
+  ],
+})
diff --git a/modules/newsletter/NewsletterController.ts b/modules/newsletter/NewsletterController.ts
new file mode 100644
index 0000000..01c3373
--- /dev/null
+++ b/modules/newsletter/NewsletterController.ts
@@ -0,0 +1,54 @@
+import { Controller, ValidationException } from '@guren/core'
+import { Subscription } from './Subscription.js'
+import { ConfirmParamSchema, EmailPayloadSchema } from './validators.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailPayloadSchema)
+
+    const existing = await Subscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable.
+    await Subscription.forceCreate({
+      email,
+      token: `${crypto.randomUUID()}${crypto.randomUUID()}`.replaceAll('-', ''),
+    })
+
+    return this.redirect(this.backPath())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmParamSchema)
+    const subscription = await Subscription.where({ token }).then((rows) => rows[0])
+    if (!subscription) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await Subscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailPayloadSchema)
+    await Subscription.delete({ email })
+
+    return this.redirect(this.backPath())
+  }
+
+  // The Referer's path only: redirecting to the full header value would let a
+  // forged Referer send the visitor to another site.
+  private backPath(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const url = new URL(referer)
+      return `${url.pathname}${url.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
