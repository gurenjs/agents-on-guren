new file mode 100644
index 0000000..b80c389
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,40 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+import { LOCALE_COOKIE } from '../../../config/locales.js'
+
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+
+    // The pick lives in the cookie locale detection already reads ahead of
+    // Accept-Language, so it needs no session and survives logging in and out.
+    return this.redirect(this.previousUrl(), {
+      headers: { 'Set-Cookie': this.localeCookie(locale) },
+    })
+  }
+
+  // Referer is a request header like any other, so it only names the way back
+  // when it points at this app; anything else lands on the home page.
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) return '/'
+
+    // The host is allowed by name as well, since behind a TLS-terminating proxy
+    // the request arrives as http while the Referer says https.
+    const { host } = new URL(this.request.url)
+    return isSafeRedirectUrl(referer, this.request.url, [host]) ? referer : '/'
+  }
+
+  private localeCookie(locale: string): string {
+    const attributes = [
+      `${LOCALE_COOKIE}=${encodeURIComponent(locale)}`,
+      'Path=/',
+      `Max-Age=${ONE_YEAR_IN_SECONDS}`,
+      'SameSite=Lax',
+      'HttpOnly',
+    ]
+    if (process.env.NODE_ENV === 'production') attributes.push('Secure')
+    return attributes.join('; ')
+  }
+}
