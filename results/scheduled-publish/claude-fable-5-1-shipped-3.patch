+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * Prints every post whose `published_at` is still in the future, soonest
+ * first, one `<id>\t<title>\t<published_at>` line each and nothing else on
+ * stdout, so the output pipes straight into other tools.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List the posts scheduled to publish later, soonest first (tab-separated).'
+
+  async handle(): Promise<void> {
+    const scheduled = await Post.where('publishedAt', '>', new Date().toISOString())
+      .orderBy('publishedAt', 'asc')
+      .orderBy('id', 'asc')
+      .get()
+
+    for (const post of scheduled) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
