+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+/**
+ * Splits the comma-separated tags field into names: trimmed, empty entries
+ * dropped, duplicates collapsed (case-sensitively), first occurrence first.
+ */
+export function parseTagNames(input: string | undefined): string[] {
+  const names = (input ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
+}
+
+// Validated but left a string, so the codegen'd body type matches what the
+// controller receives; the controller splits it with parseTagNames().
+const TagsFieldSchema = z
+  .string()
+  .optional()
+  .refine((input) => parseTagNames(input).length <= MAX_TAGS_PER_POST, `A post may have at most ${MAX_TAGS_PER_POST} tags.`)
+  .refine(
+    (input) => parseTagNames(input).every((name) => name.length <= MAX_TAG_LENGTH),
+    `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.`,
+  )
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  // Comma-separated names, e.g. "bun, webdev"; absent or empty means no tags.
+  tags: TagsFieldSchema,
 })
 
