@@ -0,0 +1,41 @@
+import { Controller, HttpException } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CreateTokenSchema, TokenIdParamSchema } from '../Validators/TokenValidator.js'
+import { createToken, hashToken } from '../../Services/TokenService.js'
+
+export default class ProfileTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateTokenSchema)
+
+    const plainToken = createToken()
+    const tokenHash = await hashToken(plainToken)
+
+    const token = await ApiToken.create({
+      userId: user.id,
+      name,
+      tokenHash,
+    })
+
+    return this.json({
+      id: token.id,
+      name: token.name,
+      token: plainToken,
+    }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(TokenIdParamSchema)
+
+    const token = await ApiToken.find(id)
+    if (!token || token.userId !== user.id) {
+      throw HttpException.notFound()
+    }
+
+    await ApiToken.delete({ id })
+
+    return this.json({}, { status: 204 })
+  }
+}
