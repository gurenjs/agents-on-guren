{
  "planVersion": 1,
  "title": "Comments and community moderation",
  "summary": "Signed-in readers comment on posts; the comment author or the post author can delete a comment; any signed-in user can report a comment once, and a comment reported by three different users is hidden from the post page but kept in the database.",
  "locale": "en",
  "scope": {
    "goals": [
      "Comment on a post as a signed-in user",
      "Delete a comment as its author or as the post's author",
      "Report a comment, once per user",
      "Hide a comment from the post page once three different users reported it"
    ],
    "nonGoals": [
      "Editing a comment",
      "Threaded replies",
      "A moderation screen for reviewing hidden comments",
      "Un-reporting a comment"
    ]
  },
  "assumptions": [
    "Deleting a comment removes the row (hard delete); its reports go with it.",
    "Deleting a post removes its comments through ON DELETE CASCADE on comments.post_id.",
    "A hidden comment is hidden from everyone, its author and the post's author included.",
    "The post page lists comments oldest first (by id, which follows creation order).",
    "A report by the comment's own author counts like any other report."
  ],
