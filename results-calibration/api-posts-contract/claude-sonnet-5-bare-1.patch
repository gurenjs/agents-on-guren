+  // relation. `withPaginate` loads it after slicing the page.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(PostApiIndexQuerySchema)
+
+    const result = await Post.withPaginate('author', {
+      page,
+      perPage: 10,
+      where: author !== undefined ? { authorId: author } : undefined,
+      orderBy: ['id', 'desc'],
+    })
+    const meta = paginate(result).meta()
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: new PostListMetaResource(meta).toJSON(),
+    })
+  }
