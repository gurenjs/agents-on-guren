+      })
+
+      const csrf = await http.actingAs(reporter1).withCsrf()
+
+      await csrf.post(`/comments/${comment.id}/report`)
+      const response = await csrf.post(`/comments/${comment.id}/report`)
+
+      expect(response.status).toBe(204)
+
+      const reports = await CommentReport.where({
+        commentId: comment.id,
+        userId: reporter1.id,
+      }).get()
+
+      expect(reports.length).toBe(1)
+    })
+
+    it('denies unauthenticated users with 403', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment for unauthenticated report',
+      })
+
+      await http.post(`/comments/${comment.id}/report`).assertForbidden()
+    })
+  })
+
