+import { describe, expect, it } from 'bun:test'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import type { PostRecord } from '../app/Models/Post.js'
+
+describe('PostResource', () => {
+  it('includes the excerpt in the serialized output', () => {
+    const post = {
+      id: 1,
+      title: 'Bees',
+      excerpt: 'Bees remember faces',
+      body: 'Bees are fascinating creatures.',
+      authorId: 1,
+      createdAt: new Date().toISOString(),
+    } as unknown as PostRecord
+
+    const json = new PostResource(post).toJSON()
+
+    expect(json.excerpt).toBe('Bees remember faces')
+  })
+})
