+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { apiAuth } from '../app/Http/Middleware/ApiAuth.js'
+
+// Bearer-token JSON API. Authentication and the per-token rate limit both
+// live in `apiAuth`.
+export function registerApiRoutes(router: Router<any>): void {
+  router.group('/api', (api) => {
+    api.middleware(...apiAuth).group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', [ApiPostController, 'store']).name('api.posts.store')
+    })
+  })
+}
