+  // Serves the public, unauthenticated `api.posts.index` route: a JSON feed
+  // for external consumers, newest first, paged at 10, optionally narrowed
+  // to one author. Unlike `index()` (the Inertia-paginated page), this is a
+  // plain JSON envelope so it stays consumable outside the browser.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsQuerySchema)
+
+    // withPaginate(), not paginate().with('author') — paginate() runs its
+    // own query independent of any prior with(), so eager loading has to go
+    // through the combined helper or `author` silently drops off each post.
+    const result = await Post.withPaginate('author', {
+      page,
+      perPage: 10,
+      where: author !== undefined ? { authorId: author } : undefined,
+      orderBy: ['id', 'desc'],
+    })
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: {
+        currentPage: result.meta.currentPage,
+        lastPage: result.meta.totalPages,
+        perPage: result.meta.perPage,
+        total: result.meta.total,
+      },
+    })
+  }
+
