+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,45 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+// A JSON body carries a checkbox as a boolean, a multipart one as '1' (Inertia)
+// or 'on' (a plain HTML form). Anything else reads as unticked.
+const TICKED_VALUES: ReadonlySet<unknown> = new Set([true, 1, '1', 'true', 'on'])
+
+const CheckboxSchema = z
+  .union([z.boolean(), z.number(), z.string()])
+  .transform((value) => TICKED_VALUES.has(value))
+
+export const UpdatePostPayloadSchema = PostPayloadSchema.extend({
+  removeCover: CheckboxSchema.default(false),
+})
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+const COVER_FORMATS = [
+  { contentType: 'image/png', signature: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a] },
+  { contentType: 'image/jpeg', signature: [0xff, 0xd8, 0xff] },
+] as const
+
+const SIGNATURE_BYTES = Math.max(...COVER_FORMATS.map((format) => format.signature.length))
+
+/**
+ * Rejects a cover upload that is not a PNG or JPEG of at most 2 MB with the
+ * same 422 a failed body schema answers, outside the route's body schema
+ * because those are parsed synchronously and reading bytes is not. The format
+ * comes from the file's leading bytes, and the returned file carries it as its
+ * type: the type the client declared is whatever it chose to send.
+ */
+export async function validateCoverUpload(file: File): Promise<File> {
+  if (file.size > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover must be 2 MB or smaller.' })
+  }
+
+  const head = new Uint8Array(await file.slice(0, SIGNATURE_BYTES).arrayBuffer())
+  const format = COVER_FORMATS.find(({ signature }) => signature.every((byte, index) => head[index] === byte))
+  if (!format) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image.' })
+  }
+
+  return new File([file], file.name, { type: format.contentType })
+}
