+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+}
+
+// Each tag links to the posts list filtered by it (always its first page).
+export default function TagList({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul className="mt-3 flex flex-wrap gap-2" aria-label="Tags">
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link
+            href={route('posts.index', { tag })}
+            className="rounded-g-ctl border border-g-line px-2 py-0.5 font-mono text-xs text-g-text-2 transition hover:border-g-line-strong hover:text-g-heading"
+          >
+            #{tag}
+          </Link>
+        </li>
+      ))}
+    </ul>
+  )
+}
