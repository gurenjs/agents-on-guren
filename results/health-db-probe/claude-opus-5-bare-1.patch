@@ -0,0 +1,110 @@
+import { sql } from 'drizzle-orm'
+import { getDatabase } from '../../config/database.js'
+
+/**
+ * One vocabulary for the top-level status and for every individual check, so a
+ * dashboard needs a single mapping to read either.
+ */
+export type HealthStatus = 'ok' | 'error'
+
+export interface CheckResult {
+  status: HealthStatus
+  /** Wall-clock time the check took — a database that answers slowly shows up here. */
+  durationMs: number
+  /** Present only on failure: the reason, for the deploy log. */
+  message?: string
+}
+
+export interface HealthReport {
+  status: HealthStatus
+  checkedAt: string
+  checks: {
+    db: CheckResult
+  }
+}
+
+/**
+ * A probe that hangs is a failed probe. Without this bound the request would
+ * stay open until the platform's own timeout, and the load balancer would keep
+ * sending traffic to the deploy the whole time — the exact failure this
+ * endpoint exists to catch.
+ */
+const DATABASE_TIMEOUT_MS = 2_000
+
+/** Resolves the Drizzle handle. Injectable so tests can simulate an unreachable database. */
+export type DatabaseResolver = () => Promise<unknown>
+
+/**
+ * The slice of a Drizzle handle a liveness probe needs. `getDatabase()` is
+ * typed as `unknown` because the handle differs per driver, and this keeps the
+ * check from committing to one of them.
+ */
+interface ProbeableDatabase {
+  get?: (query: unknown) => unknown
+  execute?: (query: unknown) => unknown
+}
+
+function withTimeout<T>(work: Promise<T>, ms: number, label: string): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const expiry = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(new Error(`${label} timed out after ${ms}ms`)), ms)
+  })
+
+  return Promise.race([work, expiry]).finally(() => clearTimeout(timer))
+}
+
+/**
+ * Runs a real round trip on every call — no cached verdict, so a database that
+ * goes away between probes is reported on the next one.
+ */
+async function probeDatabase(connect: DatabaseResolver): Promise<void> {
+  // Opening the connection is part of the check: a database that cannot be
+  // reached at all fails here rather than at the query.
+  const db = (await connect()) as ProbeableDatabase | null
+
+  const probe = sql`select 1`
+
+  // The SQLite handle runs raw SQL through get(), the Postgres/MySQL handles
+  // through execute(). Either way it is one round trip to the server.
+  if (typeof db?.get === 'function') {
+    await db.get(probe)
+    return
+  }
+  if (typeof db?.execute === 'function') {
+    await db.execute(probe)
+    return
+  }
+
+  throw new Error('The database handle exposes no way to run a query.')
+}
+
+export async function checkDatabase(connect: DatabaseResolver = getDatabase): Promise<CheckResult> {
+  const startedAt = Date.now()
+
+  try {
+    await withTimeout(probeDatabase(connect), DATABASE_TIMEOUT_MS, 'database check')
+    return { status: 'ok', durationMs: Date.now() - startedAt }
+  } catch (error) {
+    return {
+      status: 'error',
+      durationMs: Date.now() - startedAt,
+      message: error instanceof Error ? error.message : String(error),
+    }
+  }
+}
+
+export async function runHealthChecks(connect: DatabaseResolver = getDatabase): Promise<HealthReport> {
+  const checks = { db: await checkDatabase(connect) }
+  const passing = Object.values(checks).every((check) => check.status === 'ok')
+
+  return {
+    status: passing ? 'ok' : 'error',
+    checkedAt: new Date().toISOString(),
+    checks,
+  }
+}
+
+/** 200 keeps the deploy in the load-balancer pool; 503 drains traffic away from it. */
+export function healthStatusCode(report: HealthReport): number {
+  return report.status === 'ok' ? 200 : 503
+}
