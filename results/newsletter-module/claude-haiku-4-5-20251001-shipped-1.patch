@@ -0,0 +1,99 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { NewsletterSubscription } from '../modules/newsletter/index.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('Newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('subscribes to newsletter with valid email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .post('/newsletter/subscribe', { email: 'test@example.com' })
+      .assertRedirect()
+
+    const subscription = await NewsletterSubscription.first({ email: 'test@example.com' })
+    if (!subscription) throw new Error('Subscription not created')
+  })
+
+  it('rejects invalid email on subscribe', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .post('/newsletter/subscribe', { email: 'not-an-email' })
+      .assertUnprocessable()
+
+    const subscriptions = await NewsletterSubscription.all()
+    if (subscriptions.length !== 0) throw new Error('Subscription should not be created')
+  })
+
+  it('does not create duplicate subscription', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).assertRedirect()
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).assertRedirect()
+
+    const subscriptions = await NewsletterSubscription.all()
+    if (subscriptions.length !== 1) throw new Error('Should only have one subscription')
+  })
+
+  it('confirms subscription with valid token', async () => {
+    // First subscribe
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).assertRedirect()
+
+    // Get the token from the database
+    const subscription = await NewsletterSubscription.first({ email: 'test@example.com' })
+    if (!subscription || !subscription.token) throw new Error('Subscription not found')
+
+    // Confirm the subscription
+    await http.get(`/newsletter/confirm/${subscription.token}`).assertRedirect('/')
+
+    // Check that confirmed_at is set
+    const confirmed = await NewsletterSubscription.first({ email: 'test@example.com' })
+    if (!confirmed || !confirmed.confirmedAt) throw new Error('Subscription not confirmed')
+  })
+
+  it('returns 404 for invalid token', async () => {
+    await http.get('/newsletter/confirm/invalid-token').assertNotFound()
+  })
+
+  it('unsubscribes with valid email', async () => {
+    // First subscribe
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: 'test@example.com' }).assertRedirect()
+
+    // Unsubscribe
+    const csrf2 = await http.withCsrf()
+    await csrf2.json().post('/newsletter/unsubscribe', { email: 'test@example.com' }).assertRedirect()
+
+    // Check that subscription is deleted
+    const subscriptions = await NewsletterSubscription.all()
+    if (subscriptions.length !== 0) throw new Error('Subscription should be deleted')
+  })
+
+  it('unsubscribe does not fail for non-existent email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .post('/newsletter/unsubscribe', { email: 'nonexistent@example.com' })
+      .assertRedirect()
+  })
+
+  it('rejects invalid email on unsubscribe', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .post('/newsletter/unsubscribe', { email: 'not-an-email' })
+      .assertUnprocessable()
+  })
+})
