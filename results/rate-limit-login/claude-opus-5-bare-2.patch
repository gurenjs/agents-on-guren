diff --git a/tests/LoginThrottle.test.ts b/tests/LoginThrottle.test.ts
new file mode 100644
index 0000000..fc0bf6e
--- /dev/null
+++ b/tests/LoginThrottle.test.ts
@@ -0,0 +1,72 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import {
+  LOGIN_ATTEMPT_LIMIT,
+  LOGIN_ATTEMPT_WINDOW_MS,
+  loginAttemptStore,
+} from '../app/Http/Middleware/LoginThrottleMiddleware.js'
+
+// The throttle sits in front of the controller, so none of these cases need
+// the credentials to be real — a submission is counted before anything looks
+// at it. The counters are process-wide, so each case starts from a clear store.
+describe('login throttle', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(() => {
+    loginAttemptStore.clear()
+  })
+
+  function submitLogin(client: TestApp) {
+    return client.post('/login', { email: 'nobody@example.com', password: 'wrong' })
+  }
+
+  it('refuses the submission over the limit with 429 and Retry-After', async () => {
+    const client = await http.withCsrf('/login')
+
+    for (let attempt = 0; attempt < LOGIN_ATTEMPT_LIMIT; attempt++) {
+      const allowed = await submitLogin(client)
+      expect(allowed.status).not.toBe(429)
+    }
+
+    const throttled = await submitLogin(client)
+    throttled.assertStatus(429)
+    expect(throttled.headers.get('Retry-After')).toBeTruthy()
+  })
+
+  it('counts every submission against one bucket per client', async () => {
+    const client = await http.withCsrf('/login')
+
+    const first = await submitLogin(client)
+    expect(first.headers.get('X-RateLimit-Limit')).toBe(String(LOGIN_ATTEMPT_LIMIT))
+    expect(first.headers.get('X-RateLimit-Remaining')).toBe(String(LOGIN_ATTEMPT_LIMIT - 1))
+
+    await submitLogin(client)
+    const third = await submitLogin(client)
+    expect(third.headers.get('X-RateLimit-Remaining')).toBe(String(LOGIN_ATTEMPT_LIMIT - 3))
+
+    // One client, one window: the same key carried all three attempts, and it
+    // expires within the minute rather than being extended by each request.
+    // The reset header is whole seconds, rounded up, hence the second of slack.
+    expect(loginAttemptStore.size).toBe(1)
+    const resetAt = Number(third.headers.get('X-RateLimit-Reset')) * 1000
+    expect(resetAt).toBeGreaterThan(Date.now())
+    expect(resetAt).toBeLessThanOrEqual(Date.now() + LOGIN_ATTEMPT_WINDOW_MS + 1000)
+  })
+
+  it('leaves the rest of the app alone while a client is throttled', async () => {
+    const client = await http.withCsrf('/login')
+
+    for (let attempt = 0; attempt <= LOGIN_ATTEMPT_LIMIT; attempt++) {
+      await submitLogin(client)
+    }
+
+    await client.get('/login').assertOk()
+    await client.get('/health').assertOk()
+    await client.get('/').assertOk()
+  })
+})
