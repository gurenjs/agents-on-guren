+export const MAX_TAGS = 5
+export const MAX_TAG_LENGTH = 30
+
+/** Splits the comma-separated field: trims, drops empties, dedupes (case-sensitive). */
+export function parseTagNames(input: string | string[] | undefined | null): string[] {
+  const parts = Array.isArray(input) ? input : (input ?? '').split(',')
+  const names = parts.map((part) => String(part).trim()).filter((part) => part.length > 0)
+  return [...new Set(names)]
+}
+
+export const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+    if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS} tags.` })
+    }
+  })
