--- /dev/null
+++ b/resources/js/pages/posts/Revisions.tsx
@@ -0,0 +1,61 @@
+import { Head, Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  postId: number
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ postId, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title="Post Revisions" />
+      <section className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Revisions
+          </h1>
+        </header>
+
+        <div className="space-y-4">
+          {revisions.length === 0 ? (
+            <p className="text-sm text-g-text-2">No revisions available.</p>
+          ) : (
+            revisions.map((revision) => (
+              <article key={revision.id} className="rounded-g-card border border-g-line bg-g-panel p-5 shadow-g-card">
+                <div className="flex items-start justify-between gap-4">
+                  <div>
+                    <h2 className="font-bold text-g-heading">{revision.title}</h2>
+                    <p className="mt-1 text-sm text-g-text-2">{new Date(revision.createdAt).toLocaleString()}</p>
+                  </div>
+                  <form action={route('posts.restore', { id: postId, revisionId: revision.id })} method="POST" className="shrink-0">
+                    <button
+                      type="submit"
+                      className="rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-1 text-sm font-bold text-g-text transition hover:border-g-muted"
+                    >
+                      Restore
+                    </button>
+                  </form>
+                </div>
+              </article>
+            ))
+          )}
+        </div>
+
+        <footer className="border-t border-g-line pt-6">
+          <Link href={route('posts.show', { id: postId })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </section>
+    </Layout>
+  )
+}
