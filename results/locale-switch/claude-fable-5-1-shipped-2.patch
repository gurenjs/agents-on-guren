diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..a640a08
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,81 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// Every request goes to /login: it renders an Inertia page without reading
+// the database, so this suite needs no migrations or fixtures.
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  function localeCookie(response: { headers: Headers }): string | undefined {
+    return response.headers
+      .getSetCookie()
+      .map((cookie) => cookie.split(';')[0])
+      .find((pair) => pair.startsWith('locale='))
+  }
+
+  it('renders English by default', async () => {
+    await http.json().get('/login').assertOk().assertJsonPath('props._i18n.locale', 'en')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    await http
+      .json()
+      .withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8')
+      .get('/login')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.nav.posts', '記事')
+  })
+
+  it('remembers the pick and redirects back to the referring page', async () => {
+    const csrf = await http.withCsrf('/login')
+    const response = await csrf
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts')
+
+    expect(localeCookie(response)).toBe('locale=ja')
+  })
+
+  it('redirects home without a Referer, or with an off-site one', async () => {
+    const csrf = await http.withCsrf('/login')
+
+    await csrf.post('/locale', { locale: 'ja' }).assertRedirect('/')
+    await csrf
+      .withHeader('Referer', 'https://evil.example/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('lets the pick win over the browser setting', async () => {
+    await http
+      .json()
+      .withHeaders({ Cookie: 'locale=en', 'Accept-Language': 'ja' })
+      .get('/login')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'en')
+
+    await http
+      .json()
+      .withHeaders({ Cookie: 'locale=ja', 'Accept-Language': 'en' })
+      .get('/login')
+      .assertOk()
+      .assertJsonPath('props._i18n.locale', 'ja')
+      .assertJsonPath('props._i18n.messages.ja.auth.login', 'ログイン')
+  })
+
+  it('rejects an unsupported or missing locale and keeps the current pick', async () => {
+    const csrf = await http.withCsrf('/login')
+
+    const unsupported = await csrf.json().post('/locale', { locale: 'fr' }).assertUnprocessable()
+    expect(localeCookie(unsupported)).toBeUndefined()
+
+    const missing = await csrf.json().post('/locale', {}).assertUnprocessable()
+    expect(localeCookie(missing)).toBeUndefined()
+  })
+})
