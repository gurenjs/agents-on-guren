+import type { MailConfig } from '@guren/server/mail'
+
+export function resolveMailer(): string {
+  return process.env.MAIL_MAILER || 'log'
+}
+
+export function resolveMailFromAddress(): string {
+  return process.env.MAIL_FROM_ADDRESS || 'hello@example.com'
+}
+
+export function resolveMailFromName(): string {
+  return process.env.MAIL_FROM_NAME || process.env.APP_NAME || 'Guren'
+}
+
+export const mailConfig: MailConfig = {
+  default: resolveMailer(),
+  from: {
+    email: resolveMailFromAddress(),
+    name: resolveMailFromName(),
+  },
+  transports: {
+    log: {
+      driver: 'log',
+    },
+    resend: {
+      driver: 'resend',
+      apiKey: process.env.RESEND_API_KEY || '',
+    },
+  },
+}
