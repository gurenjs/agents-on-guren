+import type { CommentRecord } from '../Models/Comment.js'
+import type { UserRecord } from '../Models/User.js'
+
+export default class CommentPolicy {
+  async delete(user: UserRecord, comment: CommentRecord, _postAuthor: UserRecord): Promise<boolean> {
+    return user.id === comment.userId || user.id === _postAuthor.id
+  }
