diff --git a/app/Http/Support/safeRedirect.ts b/app/Http/Support/safeRedirect.ts
new file mode 100644
index 0000000..cf3d596
--- /dev/null
+++ b/app/Http/Support/safeRedirect.ts
@@ -0,0 +1,11 @@
+// A safe post-login redirect must be a plain same-app path: a single leading
+// slash, nothing that a browser would resolve into a different origin.
+// Rejects absolute URLs (`https://evil.example`), protocol-relative URLs
+// (`//evil.example`), and backslash variants (`/\evil.example`), which
+// browsers normalize to `//evil.example`.
+export function safeRedirectPath(value: string | null | undefined): string | null {
+  if (!value) return null
+  if (value.includes('\\')) return null
+  if (!/^\/(?!\/)/.test(value)) return null
+  return value
+}
