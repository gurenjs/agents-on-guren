@@ -0,0 +1,112 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import { defineModel } from '@guren/core'
+import app from '../src/app.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Raw row access, to assert what the table holds rather than what the store reports.
+class ApiTokenRow extends defineModel(apiTokens) {}
+
+interface IssuedToken {
+  id: string
+  name: string
+  token: string
+}
+
+async function makeUser(): Promise<UserRecord> {
+  const user = await User.create({
+    name: 'Token Owner',
+    email: `tokens-${crypto.randomUUID()}@example.com`,
+    password: 'secret-password',
+  })
+  return user as UserRecord
+}
+
+describe('profile.tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function session(user: UserRecord): Promise<TestApp> {
+    return (await http.actingAs(user).withCsrf()).json()
+  }
+
+  async function issue(user: UserRecord, name: string): Promise<IssuedToken> {
+    const response = await (await session(user)).post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<IssuedToken>()
+  }
+
+  it('creates a named token and shows the secret only once', async () => {
+    const user = await makeUser()
+    const issued = await issue(user, 'CI')
+
+    expect(issued.name).toBe('CI')
+    expect(typeof issued.id).toBe('string')
+    const secret = issued.token.split('|').pop() ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiTokenRow.where({ userId: user.id }).get()
+    expect(rows).toHaveLength(1)
+    for (const value of Object.values(rows[0]!)) {
+      const text = typeof value === 'string' ? value : JSON.stringify(value)
+      expect(text).not.toContain(secret)
+    }
+    expect(rows[0]!.name).toBe('CI')
+  })
+
+  it('rejects a missing, empty or over-long name with 422 and stores nothing', async () => {
+    const user = await makeUser()
+    const client = await session(user)
+
+    await client.post('/profile/tokens', {}).assertUnprocessable()
+    await client.post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await client.post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+
+    expect(await ApiTokenRow.where({ userId: user.id }).count()).toBe(0)
+  })
+
+  it('gives a guest no token', async () => {
+    const before = await ApiTokenRow.newQuery().count()
+    const response = await (await http.withCsrf()).json().post('/profile/tokens', { name: 'CI' })
+    expect([302, 303, 401]).toContain(response.status)
+    expect(await ApiTokenRow.newQuery().count()).toBe(before)
+  })
+
+  it('lists the tokens by name on the profile page', async () => {
+    const user = await makeUser()
+    await issue(user, 'CI')
+    await issue(user, 'old laptop')
+
+    const page = await http.actingAs(user).get('/profile')
+    page.assertOk()
+    const { payload } = await readInertiaResponse(page.raw)
+    const names = (payload.props as { tokens: { name: string }[] }).tokens.map((token) => token.name)
+    expect(names.sort()).toEqual(['CI', 'old laptop'])
+  })
+
+  it('revokes an owned token at once and leaves the others working', async () => {
+    const user = await makeUser()
+    const keep = await issue(user, 'keep')
+    const drop = await issue(user, 'drop')
+
+    await (await session(user)).delete(`/profile/tokens/${drop.id}`).assertNoContent()
+
+    await http.json().withHeader('Authorization', `Bearer ${drop.token}`).get('/api/posts').assertUnauthorized()
+    await http.json().withHeader('Authorization', `Bearer ${keep.token}`).get('/api/posts').assertOk()
+    expect(await ApiTokenRow.where({ userId: user.id }).count()).toBe(1)
+  })
+
+  it("answers 404 for another user's token and keeps it working", async () => {
+    const owner = await makeUser()
+    const other = await makeUser()
+    const token = await issue(owner, 'CI')
+
+    await (await session(other)).delete(`/profile/tokens/${token.id}`).assertNotFound()
+
+    await http.json().withHeader('Authorization', `Bearer ${token.token}`).get('/api/posts').assertOk()
+  })
+})
