--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,35 @@
+interface Props {
+  value: string | null | undefined
+  onChange: (value: string | null) => void
+  error?: string
+  className: string
+}
+
+// <input type="datetime-local"> works in the browser's local time with no zone;
+// the server receives and stores UTC ISO 8601.
+function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
+  return local.toISOString().slice(0, 16)
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">Publish at</label>
+      <input
+        type="datetime-local"
+        value={toLocalInput(value)}
+        onChange={(event) => {
+          const raw = event.target.value
+          onChange(raw === '' ? null : new Date(raw).toISOString())
+        }}
+        className={className}
+      />
+      <p className="mt-1 text-xs text-g-muted">Leave empty to publish as soon as you save.</p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
