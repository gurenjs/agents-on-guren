diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..e0bf277
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,37 @@
+import { Controller } from '@guren/core'
+
+// The cookie detectLocaleMiddleware reads; it outranks Accept-Language.
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+    const cookie = [
+      `${LOCALE_COOKIE}=${locale}`,
+      'Path=/',
+      `Max-Age=${ONE_YEAR_IN_SECONDS}`,
+      'SameSite=Lax',
+    ].join('; ')
+
+    return this.redirect(this.backUrl(), { headers: { 'Set-Cookie': cookie } })
+  }
+
+  // Sends the reader back to the page they switched from. A Referer on this
+  // host is followed as given; one on another host only lends its path, so the
+  // endpoint cannot be used as an open redirect.
+  private backUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) return '/'
+    if (referer.startsWith('/') && !referer.startsWith('//')) return referer
+
+    try {
+      const target = new URL(referer)
+      if (target.protocol !== 'http:' && target.protocol !== 'https:') return '/'
+      if (target.host === new URL(this.request.url).host) return referer
+      return target.pathname.startsWith('//') ? '/' : `${target.pathname}${target.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
