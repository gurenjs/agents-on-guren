 })
 
+function parseAndValidateTags(input: string | undefined | null): string[] {
+  if (!input) return []
+
+  const tags = input
+    .split(',')
+    .map((tag) => tag.trim())
+    .filter((tag) => tag.length > 0)
+
+  const uniqueTags = Array.from(new Set(tags))
+
+  if (uniqueTags.length > 5) {
+    throw new Error('A post may have at most 5 tags.')
+  }
+
+  for (const tag of uniqueTags) {
+    if (tag.length < 1 || tag.length > 30) {
+      throw new Error('Each tag name must be 1–30 characters.')
+    }
+  }
+
+  return uniqueTags
+}
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: z
+    .string()
+    .optional()
+    .nullable()
+    .transform((val) => {
+      try {
+        return parseAndValidateTags(val)
+      } catch (error) {
+        throw new Error(error instanceof Error ? error.message : 'Invalid tags.')
+      }
+    }),
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
