diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..80121e7 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,54 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// Deleting is author-only, same as editing: the controller runs the post
+// through PostPolicy.delete before touching the database.
+describe('posts.destroy', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })) as UserRecord
+    other = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })) as UserRecord
+
+    const post = await Post.forceCreate({
+      title: 'Author post',
+      excerpt: 'An excerpt',
+      body: 'The body',
+      authorId: author.id,
+    })
+    postId = post!.id
+  })
+
+  it('forbids a signed-in user from deleting someone else’s post', async () => {
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.delete(`/posts/${postId}`).assertForbidden()
+
+    expect(await Post.find(postId)).not.toBeNull()
+  })
+
+  it('refuses a guest and keeps the post', async () => {
+    const csrf = await http.withCsrf()
+    const response = await csrf.delete(`/posts/${postId}`)
+    expect(response.status).toBeGreaterThanOrEqual(300)
+    expect(response.status).not.toBe(204)
+
+    expect(await Post.find(postId)).not.toBeNull()
+  })
+
+  it('lets the author delete their own post', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    expect(await Post.find(postId)).toBeNull()
+  })
+})
