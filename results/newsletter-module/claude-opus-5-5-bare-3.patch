+++ b/modules/newsletter/db/schema.ts
@@ -0,0 +1,11 @@
+import { sqliteTable, integer, text } from '@guren/orm/drizzle/sqlite'
+
+// drizzle.config.ts lists this file alongside db/schema.ts, so the module's
+// table gets migrations without the application's schema importing it.
+export const newsletterSubscriptions = sqliteTable('newsletter_subscriptions', {
+  id: integer('id').primaryKey({ autoIncrement: true }),
+  email: text('email').notNull().unique(),
+  token: text('token').notNull().unique(),
+  confirmedAt: text('confirmed_at'),
+  createdAt: text('created_at').notNull().$defaultFn(() => new Date().toISOString()),
+})
