@@ -0,0 +1,33 @@
+import { createRateLimitMiddleware, MemoryRateLimitStore } from '@guren/core'
+
+/**
+ * Counters live in this process only — a single-process app has nothing to
+ * share them with, and a restart dropping them is acceptable for a limiter
+ * this short-lived. Swap in RedisRateLimitStore once the app runs on more
+ * than one instance.
+ *
+ * Exported so tests can `clear()` the counters between cases; nothing in the
+ * request path should touch it.
+ */
+export const loginRateLimitStore = new MemoryRateLimitStore()
+
+/**
+ * Throttles login submissions to 5 per minute per client IP.
+ *
+ * Every submission counts, successful ones included: an attacker who guesses
+ * right on the third try must not get a fresh budget for the next account.
+ *
+ * `trustProxy` stays off (the default), so the identity is the address the
+ * connection actually came from — `X-Forwarded-For` and friends are
+ * client-controlled and this app is not behind a proxy. When the address
+ * cannot be resolved at all the framework falls back to one shared bucket
+ * for the route, which fails closed: unidentified clients are throttled
+ * together rather than waved through.
+ */
+export const ThrottleLoginMiddleware = createRateLimitMiddleware({
+  limit: 5,
+  windowMs: 60_000,
+  store: loginRateLimitStore,
+  keyPrefix: 'login:',
+  message: 'Too many login attempts. Please try again later.',
+})
