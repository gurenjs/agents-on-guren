+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,70 @@
+import { Job, getContainer, getMailManager, type Container, type MailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailJobPayload {
+  /** The name the account was registered with. */
+  name: string
+  /** The address the account was registered with. */
+  email: string
+}
+
+/**
+ * Delivers the welcome email outside the registration request, so sign-up
+ * neither waits for the mail provider nor fails with it.
+ *
+ * The payload carries the name and address instead of a user id: the message
+ * greets the person who just registered, and nothing about it has to be
+ * re-read from the database when the worker gets to it.
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  // Queued messages record this name and the worker resolves the class back
+  // from it — pinned so a rename (or a bundler mangling identifiers) does not
+  // orphan work that is already in flight.
+  static override jobName = 'SendWelcomeEmailJob'
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ name, email }: SendWelcomeEmailJobPayload): Promise<void> {
+    const result = await new WelcomeMail(resolveMailManager(), { name }).to({ email, name }).send()
+
+    // Raising is what gets the attempt retried and, once the attempts are
+    // spent, recorded as a failed job — rather than dropping the message.
+    if (!result.success) {
+      throw new Error(result.error ?? `Failed to send the welcome email to ${email}.`)
+    }
+  }
+
+  async failed({ email }: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${email}:`, error.message)
+  }
+}
+
+/**
+ * Resolved when the job runs rather than when it is dispatched: the worker
+ * draining the queue can be a different process from the one that queued the
+ * work. `MailProvider` installs one manager in both places this looks, so they
+ * agree — unless a test has substituted one of them, hence the fake first.
+ */
+function resolveMailManager(): MailManager {
+  const container = appContainer()
+
+  if (container?.isFaked('mail')) {
+    return container.make('mail')
+  }
+
+  const manager = getMailManager() ?? (container?.has('mail') ? container.make('mail') : null)
+  if (!manager) {
+    throw new Error('No mail manager configured. Is MailProvider registered in src/app.ts?')
+  }
+
+  return manager
+}
+
+function appContainer(): Container | null {
+  try {
+    return getContainer()
+  } catch {
+    // Nothing has bootstrapped an application in this process.
+    return null
+  }
+}
