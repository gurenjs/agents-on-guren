+++ b/resources/js/pages/posts/Revisions.tsx
@@ -0,0 +1,65 @@
+import { Head, Link, useForm } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  revisions: Array<{
+    id: number
+    title: string
+    createdAt: string
+  }>
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  const restoreForm = useForm()
+
+  const handleRestore = (revisionId: number) => {
+    restoreForm.post(route('posts.restore-revision', { id: post.id, revisionId }), {
+      onBefore: () => window.confirm(`Restore this version of "${revisions.find(r => r.id === revisionId)?.title}"?`),
+    })
+  }
+
+  return (
+    <Layout>
+      <Head title={`Revisions: ${post.title}`} />
+      <article className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="text-3xl font-bold text-g-heading">Revision History</h1>
+          <p className="text-g-text-2">{post.title}</p>
+        </header>
+
+        <div className="space-y-4">
+          {revisions.length === 0 ? (
+            <p className="text-g-text-2">No revisions yet.</p>
+          ) : (
+            <ul className="space-y-2">
+              {revisions.map((revision) => (
+                <li key={revision.id} className="flex items-center justify-between rounded-g-ctl border border-g-line p-3">
+                  <div>
+                    <p className="font-semibold text-g-heading">{revision.title}</p>
+                    <p className="text-sm text-g-text-2">{new Date(revision.createdAt).toLocaleString()}</p>
+                  </div>
+                  <button
+                    onClick={() => handleRestore(revision.id)}
+                    disabled={restoreForm.processing}
+                    className="rounded-g-ctl border border-g-accent-chip px-3 py-1 text-sm font-semibold text-g-accent-text transition hover:bg-g-accent-tint disabled:opacity-50"
+                  >
+                    Restore
+                  </button>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+
+        <footer className="border-t border-g-line pt-6">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </article>
+    </Layout>
+  )
+}
