diff --git a/app/Http/Controllers/CommentController.ts b/app/Http/Controllers/CommentController.ts
new file mode 100644
index 0000000..d8b499c
--- /dev/null
+++ b/app/Http/Controllers/CommentController.ts
@@ -0,0 +1,49 @@
+import { AuthorizationException, Controller } from '@guren/core'
+import { Comment, CommentReport } from '../../Models/Comment.js'
+import { Post } from '../../Models/Post.js'
+import type { UserRecord } from '../../Models/User.js'
+import { PostIdParamSchema } from '../Validators/PostValidator.js'
+import { CommentIdParamSchema } from '../Validators/CommentValidator.js'
+
+export default class CommentController extends Controller {
+  async store(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body: data } = this.validated('comments.store')
+    await Comment.forceCreate({ body: data.body, postId: post.id, userId: user.id })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+
+  async destroy(): Promise<Response> {
+    const { id } = this.validateParams(CommentIdParamSchema)
+    const comment = await Comment.findOrFail(id)
+    const post = await Post.findOrFail(comment.postId)
+    const user = await this.auth.userOrFail<UserRecord>()
+    if (Number(user.id) !== comment.userId && Number(user.id) !== post.authorId) {
+      throw AuthorizationException.deny('Comment')
+    }
+
+    await CommentReport.delete({ commentId: comment.id })
+    await Comment.delete({ id: comment.id })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
+
+  async report(): Promise<Response> {
+    const { id } = this.validateParams(CommentIdParamSchema)
+    const comment = await Comment.findOrFail(id)
+    const user = await this.auth.userOrFail<UserRecord>()
+    const existing = await CommentReport.first({ commentId: comment.id, userId: user.id })
+    if (!existing) {
+      try {
+        await CommentReport.forceCreate({ commentId: comment.id, userId: user.id })
+      } catch {
+        // A concurrent duplicate report hit the unique (comment_id, user_id) index.
+      }
+    }
+
+    return new Response(null, { status: 204 })
+  }
+}
