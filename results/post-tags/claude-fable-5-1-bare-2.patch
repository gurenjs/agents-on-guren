 import { z } from 'zod'
 
+export const TAG_NAME_MAX_LENGTH = 30
+export const MAX_TAGS_PER_POST = 5
+
 export const PostIdParamSchema = z.object({
   id: z.coerce.number().int().positive(),
 })
 
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  // Filters the list to the posts carrying this tag; an unknown name lists nothing.
+  tag: z.string().trim().min(1).optional(),
 })
 
 export const PostSearchSchema = z.object({
@@ -16,10 +21,40 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+/**
+ * The names typed into the Tags field, comma-separated: each trimmed, empty
+ * entries dropped, duplicates (case-sensitive) collapsed to their first
+ * occurrence. An array of strings is accepted too, each entry split the same way.
+ */
+export function parseTagNames(input: string | string[] | undefined): string[] {
+  const parts = (Array.isArray(input) ? input : [input ?? '']).flatMap((entry) => entry.split(','))
+  const names: string[] = []
+  for (const part of parts) {
+    const name = part.trim()
+    if (name.length > 0 && !names.includes(name)) {
+      names.push(name)
+    }
+  }
+  return names
+}
+
+// Refinements run on the parsed list so every rule reports on `tags` itself,
+// the field the form renders errors for, rather than on `tags.0`.
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .transform(parseTagNames)
+  .refine((names) => names.length <= MAX_TAGS_PER_POST, `A post may have at most ${MAX_TAGS_PER_POST} tags.`)
+  .refine(
+    (names) => names.every((name) => name.length <= TAG_NAME_MAX_LENGTH),
+    `Each tag must be ${TAG_NAME_MAX_LENGTH} characters or fewer.`,
+  )
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: TagsFieldSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
