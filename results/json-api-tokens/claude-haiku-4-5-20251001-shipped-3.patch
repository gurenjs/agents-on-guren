@@ -0,0 +1,34 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { PostResource, type PostResourceData } from '../Resources/PostResource.js'
+import { ApiPostCreateSchema } from '../Validators/PostValidator.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    const data: PostResourceData[] = posts.map((post) => new PostResource(post).toJSON())
+
+    return this.json({ data })
+  }
+
+  async store(): Promise<Response> {
+    const userId = this.ctx.get('userId')
+    const { title, excerpt, body } = await this.validateBody(ApiPostCreateSchema)
+
+    const post = await Post.forceCreate({
+      title,
+      excerpt,
+      body,
+      authorId: userId,
+    })
+
+    const loaded = await Post.findWithOrFail(post.id, 'author')
+    const data = new PostResource(loaded).toJSON()
+
+    return this.json({ data }, { status: 201 })
+  }
+}
