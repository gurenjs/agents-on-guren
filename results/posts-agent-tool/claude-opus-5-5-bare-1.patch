+        "limit": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 50
+        }
+      },
+      "required": [
+        "keywords"
+      ]
+    },
+    inputSources: {
+      "keywords": "body",
+      "limit": "body"
+    },
+    inputBodyNested: false,
+    annotations: {
+      "readOnlyHint": true,
+      "destructiveHint": false,
+      "idempotentHint": true
+    },
+    expose: {
+      "mcp": true,
+      "webMcp": true
+    },
+  },
+  'posts_store': {
+    toolName: "posts_store",
+    routeName: "posts.store",
+    method: "POST",
+    path: "/posts",
+    description: "Create a blog post authored by the signed-in user.",
+    inputSchema: {
+      "type": "object",
+      "properties": {
+        "title": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 255
+        },
+        "excerpt": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 500
+        },
+        "body": {
+          "type": "string",
+          "minLength": 1
+        }
+      },
+      "required": [
+        "title",
+        "excerpt",
+        "body"
+      ]
+    },
+    inputSources: {
+      "title": "body",
+      "excerpt": "body",
+      "body": "body"
+    },
+    inputBodyNested: false,
+    annotations: {
+      "readOnlyHint": false,
+      "destructiveHint": false,
+      "idempotentHint": false
