diff --git a/tests/AuthLocalization.test.ts b/tests/AuthLocalization.test.ts
new file mode 100644
index 0000000..a7abfc5
--- /dev/null
+++ b/tests/AuthLocalization.test.ts
@@ -0,0 +1,226 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { readFileSync, readdirSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { TestApp } from '@guren/testing'
+import { renderInertiaServer } from '@guren/inertia-client/server'
+import type { Page } from '@inertiajs/core'
+import app from '../src/app.js'
+
+// The auth pages take their copy from lang/<locale>/auth.json through the
+// `_i18n` shared prop, so asserting on the JSON payload alone would pass on
+// the catalog being shipped rather than on the page using it. These tests
+// render the page component the way ssr.tsx does and assert on the markup.
+
+const LANG_DIR = fileURLToPath(new URL('../lang', import.meta.url))
+
+const JA_HEADER = 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7'
+
+const login = {
+  en: {
+    title: 'Sign in',
+    copy: [
+      'Sign in',
+      'Use your account credentials to continue.',
+      'Email',
+      'Password',
+      'Remember me',
+      "Don't have an account?",
+      'Sign up',
+    ],
+  },
+  ja: {
+    title: 'ログイン',
+    copy: [
+      'ログイン',
+      'アカウントの認証情報を入力して続行してください。',
+      'メールアドレス',
+      'パスワード',
+      'ログイン状態を保持する',
+      'アカウントをお持ちでないですか？',
+      'アカウント登録',
+    ],
+  },
+}
+
+const register = {
+  en: {
+    title: 'Sign up',
+    copy: [
+      'Create an account',
+      'Sign up to get started.',
+      'Name',
+      'Email',
+      'Password',
+      'Confirm password',
+      'Create account',
+      'Already have an account?',
+      'Sign in',
+    ],
+  },
+  ja: {
+    title: 'アカウント登録',
+    copy: [
+      'アカウント登録',
+      'アカウントを作成して始めましょう。',
+      '名前',
+      'メールアドレス',
+      'パスワード',
+      'パスワード（確認）',
+      '登録',
+      'すでにアカウントをお持ちですか？',
+      'ログイン',
+    ],
+  },
+}
+
+let http: TestApp
+
+const ENTITIES: Record<string, string> = {
+  '&#x27;': "'",
+  '&quot;': '"',
+  '&lt;': '<',
+  '&gt;': '>',
+  '&amp;': '&',
+}
+
+const decode = (markup: string): string =>
+  markup.replace(/&(?:#x27|quot|lt|gt|amp);/g, (entity) => ENTITIES[entity]!)
+
+/** Fetch a page and render its component, mirroring resources/js/ssr.tsx. */
+async function visit(
+  path: string,
+  acceptLanguage?: string,
+): Promise<{ locale: string; documentLang: string; title: string; markup: string }> {
+  const client = acceptLanguage ? http.withHeader('Accept-Language', acceptLanguage) : http
+  const response = await client.get(path)
+  const html = await response.text()
+
+  const page = JSON.parse(
+    /data-page="app" type="application\/json">(.*?)<\/script>/s.exec(html)![1]!,
+  ) as Page
+  const rendered = await renderInertiaServer({
+    page,
+    resolve: (name: string) => import(`../resources/js/pages/${name}.tsx`),
+  })
+
+  return {
+    locale: (page.props._i18n as { locale: string }).locale,
+    documentLang: /<html lang="(.*?)"/.exec(html)![1]!,
+    title: /<title[^>]*>(.*?)<\/title>/.exec(rendered.head.join(''))![1]!,
+    // The serialized page object carries every catalog, including the English
+    // fallback — drop it so "renders no English" assertions mean something.
+    // Entities are decoded so copy reads as authored (React escapes `'`).
+    markup: decode(rendered.body.replace(/<script data-page[\s\S]*?<\/script>/, '')),
+  }
+}
+
+describe('auth pages localization', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  describe('Japanese browsers', () => {
+    for (const header of ['ja', 'ja-JP', JA_HEADER]) {
+      it(`renders /login in Japanese for "${header}"`, async () => {
+        const page = await visit('/login', header)
+
+        expect(page.locale).toBe('ja')
+        expect(page.documentLang).toBe('ja')
+        expect(page.title).toBe(login.ja.title)
+        for (const text of login.ja.copy) {
+          expect(page.markup).toContain(text)
+        }
+        expect(page.markup).not.toContain(login.en.copy[1]!)
+      })
+
+      it(`renders /register in Japanese for "${header}"`, async () => {
+        const page = await visit('/register', header)
+
+        expect(page.locale).toBe('ja')
+        expect(page.title).toBe(register.ja.title)
+        for (const text of register.ja.copy) {
+          expect(page.markup).toContain(text)
+        }
+        expect(page.markup).not.toContain(register.en.copy[1]!)
+      })
+    }
+  })
+
+  describe('everyone else', () => {
+    for (const header of [undefined, 'en', 'en-US,en;q=0.9', 'en-US,en;q=0.9,ja;q=0.5', 'fr-FR,fr;q=0.9']) {
+      it(`renders /login in English for "${header ?? 'no Accept-Language'}"`, async () => {
+        const page = await visit('/login', header)
+
+        expect(page.locale).toBe('en')
+        expect(page.documentLang).toBe('en')
+        expect(page.title).toBe(login.en.title)
+        for (const text of login.en.copy) {
+          expect(page.markup).toContain(text)
+        }
+        expect(page.markup).not.toContain(login.ja.copy[1]!)
+      })
+
+      it(`renders /register in English for "${header ?? 'no Accept-Language'}"`, async () => {
+        const page = await visit('/register', header)
+
+        expect(page.locale).toBe('en')
+        expect(page.title).toBe(register.en.title)
+        for (const text of register.en.copy) {
+          expect(page.markup).toContain(text)
+        }
+        expect(page.markup).not.toContain(register.ja.copy[1]!)
+      })
+    }
+  })
+})
+
+describe('translation catalogs', () => {
+  type Messages = { [key: string]: string | Messages }
+
+  function loadCatalog(locale: string): Record<string, string> {
+    const flat: Record<string, string> = {}
+
+    const walk = (messages: Messages, prefix: string): void => {
+      for (const [key, value] of Object.entries(messages)) {
+        const path = prefix ? `${prefix}.${key}` : key
+        if (typeof value === 'string') {
+          flat[path] = value
+        } else {
+          walk(value, path)
+        }
+      }
+    }
+
+    for (const file of readdirSync(`${LANG_DIR}/${locale}`).sort()) {
+      if (!file.endsWith('.json')) continue
+      walk(JSON.parse(readFileSync(`${LANG_DIR}/${locale}/${file}`, 'utf8')) as Messages, file.replace(/\.json$/, ''))
+    }
+
+    return flat
+  }
+
+  const en = loadCatalog('en')
+  const ja = loadCatalog('ja')
+
+  it('translates every English key into Japanese and vice versa', () => {
+    expect(Object.keys(ja).sort()).toEqual(Object.keys(en).sort())
+  })
+
+  it('keeps every placeholder of an English string in its Japanese counterpart', () => {
+    const placeholders = (value: string): string[] =>
+      [...value.matchAll(/:([a-zA-Z_][a-zA-Z0-9_]*)|\{([a-zA-Z_][a-zA-Z0-9_]*)\}/g)]
+        .map((match) => match[1] ?? match[2]!)
+        .sort()
+
+    for (const [key, value] of Object.entries(en)) {
+      expect({ key, placeholders: placeholders(ja[key] ?? '') }).toEqual({
+        key,
+        placeholders: placeholders(value),
+      })
+    }
+  })
+
+  it('translates the welcome message with its interpolation intact', () => {
+    expect(ja['messages.welcome']).toBe(':nameへようこそ！')
+  })
+})
