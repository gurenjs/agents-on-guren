--- /dev/null
+++ b/app/Http/Utilities/RedirectValidator.ts
@@ -0,0 +1,42 @@
+/**
+ * Validates that a redirect URL is safe and points to an internal path.
+ * Only allows absolute paths within the same application.
+ * Rejects absolute URLs, protocol-relative URLs, and any variant that
+ * could redirect to another origin.
+ */
+export function isSafeRedirect(url: string | undefined | null): boolean {
+  if (!url || typeof url !== 'string') {
+    return false
+  }
+
+  // Trim whitespace
+  const trimmed = url.trim()
+
+  // Must not be empty
+  if (trimmed.length === 0) {
+    return false
+  }
+
+  // Reject absolute URLs (e.g. http://example.com, https://example.com)
+  if (/^[a-zA-Z][a-zA-Z\d+\-.]*:/.test(trimmed)) {
+    return false
+  }
+
+  // Reject protocol-relative URLs (e.g. //example.com, \\example.com)
+  if (/^[/\\]{2}/.test(trimmed)) {
+    return false
+  }
+
+  // Reject backslash variants that browsers treat as protocol-relative
+  // A single backslash followed by another slash: \/ or \\
+  if (/^\\/.test(trimmed)) {
+    return false
+  }
+
+  // Must start with / (absolute path within the app)
+  if (!trimmed.startsWith('/')) {
+    return false
+  }
+
+  return true
+}
