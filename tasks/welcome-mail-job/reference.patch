diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..146f9ae
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,39 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+import { User } from '../Models/User.js'
+
+export interface SendWelcomeEmailJobPayload {
+  userId: number
+}
+
+/**
+ * Sends the welcome mail to a freshly registered user.
+ *
+ * Dispatched from RegisterController.store so the HTTP response never waits
+ * on the mail transport; the queue worker (or the sync driver in
+ * development) runs handle() afterwards.
+ */
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ userId }: SendWelcomeEmailJobPayload): Promise<void> {
+    const user = await User.find(userId)
+    // The account may have been removed between dispatch and delivery; there
+    // is nobody left to welcome, and retrying would not change that.
+    if (!user) return
+
+    // MailProvider.boot() publishes the configured manager for queue jobs,
+    // which run outside a request and have no controller container.
+    const mail = getMailManager()
+    if (!mail) {
+      throw new Error('Mail manager is not configured — is MailProvider registered in src/app.ts?')
+    }
+
+    await new WelcomeMail(mail, { name: user.name, email: user.email }).send()
+  }
+
+  async failed({ userId }: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for user ${userId}:`, error.message)
+  }
+}
