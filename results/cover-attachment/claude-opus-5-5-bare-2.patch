diff --git a/app/Http/Validators/PostValidator.ts b/app/Http/Validators/PostValidator.ts
index 804642a..c50e134 100644
--- a/app/Http/Validators/PostValidator.ts
+++ b/app/Http/Validators/PostValidator.ts
@@ -16,10 +16,55 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPE_ERROR = 'Cover must be a PNG or JPEG image.'
+
+// A file input left empty still submits a zero-byte file with no name, so that
+// (and a blank or null value from non-multipart clients) means "no cover".
+// Only the size is checked here: the route schema runs synchronously, so the
+// file's bytes are sniffed by detectCoverType() in the controller instead.
+// Codegen types the field as `unknown`; read it through coverFile().
+const CoverSchema = z
+  .preprocess(
+    (value) => (value === '' || value === null || (value instanceof File && value.size === 0) ? undefined : value),
+    z
+      .instanceof(File, { message: COVER_TYPE_ERROR })
+      .refine((file) => file.size <= COVER_MAX_BYTES, 'Cover must be 2 MB or smaller.')
+      .optional(),
+  )
+  .optional()
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  cover: CoverSchema,
+})
+
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  // A ticked checkbox submits "1"; an unticked one submits nothing.
+  removeCover: z.union([z.boolean(), z.string()]).optional(),
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+/** The validated cover upload, or null when none was picked. */
+export function coverFile(value: unknown): File | null {
+  return value instanceof File && value.size > 0 ? value : null
+}
+
+export function isTicked(value: unknown): boolean {
+  return value === true || value === '1' || value === 'on' || value === 'true'
+}
+
+/**
+ * The cover's real type, read from its leading bytes rather than trusted from
+ * the client's declared content type. Null for anything but PNG or JPEG.
+ */
+export async function detectCoverType(file: File): Promise<'image/png' | 'image/jpeg' | null> {
+  const head = new Uint8Array(await file.slice(0, 8).arrayBuffer())
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (head.length === 8 && png.every((byte, index) => head[index] === byte)) return 'image/png'
+  if (head[0] === 0xff && head[1] === 0xd8 && head[2] === 0xff) return 'image/jpeg'
+  return null
+}
