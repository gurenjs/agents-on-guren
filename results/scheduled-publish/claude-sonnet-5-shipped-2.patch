@@ -0,0 +1,55 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: any
+  let other: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    other = await User.create({ name: 'B', email: 'b@example.com', password: 'secret-pass-1' })
+  })
+
+  const future = () => new Date(Date.now() + 86_400_000).toISOString()
+
+  it('hides a scheduled post from everyone but its author, until the time passes', async () => {
+    const post = await Post.forceCreate({
+      title: 'Later', excerpt: 'e', body: 'b', authorId: author.id, publishedAt: future(),
+    })
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+
+    const guestSearch = await http.query('/posts/search', { keywords: ['Later'] })
+    expect((await guestSearch.json<{ data: unknown[] }>()).data).toHaveLength(0)
+
+    await Post.forceUpdate({ id: post.id }, { publishedAt: new Date(Date.now() - 1000).toISOString() })
+    await http.get(`/posts/${post.id}`).assertOk()
+    const after = await http.query('/posts/search', { keywords: ['Later'] })
+    expect((await after.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+
+  it('rejects an invalid publishAt', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('stores publishAt from the create form', async () => {
