diff --git a/app/Services/SlugService.ts b/app/Services/SlugService.ts
new file mode 100644
index 0000000..8dc7cfb
--- /dev/null
+++ b/app/Services/SlugService.ts
@@ -0,0 +1,42 @@
+import { Post } from '../Models/Post.js'
+
+function sanitizeSlug(title: string): string {
+  return title
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9\s-]/g, '')
+    .replace(/\s+/g, '-')
+    .replace(/-+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
+
+export async function generateUniqueSlug(title: string, excludeId?: number): Promise<string> {
+  const baseSlug = sanitizeSlug(title)
+  if (!baseSlug) {
+    throw new Error('Title must contain at least one valid character')
+  }
+
+  const firstSlug = baseSlug
+  let query = Post.newQuery().where('slug', '=', firstSlug)
+  if (excludeId !== undefined) {
+    query = query.where('id', '!=', excludeId)
+  }
+  const existing = await query.count()
+  if (existing === 0) {
+    return firstSlug
+  }
+
+  let counter = 2
+  while (true) {
+    const candidateSlug = `${baseSlug}-${counter}`
+    let query = Post.newQuery().where('slug', '=', candidateSlug)
+    if (excludeId !== undefined) {
+      query = query.where('id', '!=', excludeId)
+    }
+    const existing = await query.count()
+    if (existing === 0) {
+      return candidateSlug
+    }
+    counter++
+  }
+}
