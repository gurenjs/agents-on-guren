diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..fdf5864
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,70 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Tag } from '../app/Models/Tag.js'
+import { PostTag } from '../app/Models/PostTag.js'
+
+const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  async function create(tags?: string) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return await csrf.json().post('/posts', payload(tags))
+  }
+
+  it('creates, syncs and lists tags', async () => {
+    const res = await create('bun, webdev')
+    res.assertRedirect()
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    const created = (await Post.all())[0]!
+    expect(await PostTag.where({ postId: created.id }).count()).toBe(2)
+
+    const csrf = await http.actingAs(author).withCsrf()
+    const updated = await csrf.json().put(`/posts/${created.id}`, payload('bun'))
+    updated.assertRedirect()
+    expect(await PostTag.where({ postId: created.id }).count()).toBe(1)
+
+    const inertia = http.withHeaders({ 'X-Inertia': 'true', 'X-Inertia-Version': '' })
+    const listed = await inertia.get('/posts?tag=bun')
+    const props = (await listed.json<{ props: { data: { tags: string[] }[] } }>()).props
+    expect(props.data.map((p) => p.tags)).toEqual([['bun']])
+    const none = await inertia.get('/posts?tag=none')
+    expect((await none.json<{ props: { data: unknown[] } }>()).props.data).toEqual([])
+  })
+
+  it('refuses invalid tag lists and collapses duplicates', async () => {
+    ;(await create('a,b,c,d,e,f')).assertStatus(422)
+    ;(await create('x'.repeat(31))).assertStatus(422)
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+
+    ;(await create('x'.repeat(30))).assertRedirect()
+    ;(await create(' bun ,bun')).assertRedirect()
+    expect(await Tag.where({ name: 'bun' }).count()).toBe(1)
+    expect(await PostTag.all()).toHaveLength(2)
+  })
+
+  it('deletes a tagged post', async () => {
+    ;(await create('bun')).assertRedirect()
+    const created = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    const res = await csrf.delete(`/posts/${created.id}`)
+    res.assertRedirect()
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})
