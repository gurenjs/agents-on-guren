+          <p className="text-g-text">Copy the token for {created.name} now. It is not shown again.</p>
+          <code className="block break-all font-mono text-xs text-g-heading">{created.token}</code>
+        </div>
+      ) : null}
+
+      <form className="flex gap-2" onSubmit={createToken}>
