diff --git a/tests/PostRevisions.test.ts b/tests/PostRevisions.test.ts
new file mode 100644
index 0000000..10bd435
--- /dev/null
+++ b/tests/PostRevisions.test.ts
@@ -0,0 +1,154 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the test database (`bun test` sets NODE_ENV=test, so
+// config/database.ts points at its own SQLite file). Nothing is truncated:
+// every test makes its own posts and asserts on those rows only.
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+
+  const content = (title: string) => ({ title, excerpt: `${title} excerpt`, body: `${title} body` })
+
+  async function makeUser(name: string): Promise<UserRecord> {
+    return User.create({ name, email: `${name}-${crypto.randomUUID()}@example.com`, password: 'secret-password' })
+  }
+
+  async function makePost(title: string, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ ...content(title), authorId: owner.id })
+  }
+
+  async function revisionsOf(post: PostRecord) {
+    return PostRevision.where({ postId: post.id }).orderBy('id', 'asc').get()
+  }
+
+  async function revisionProps(post: PostRecord): Promise<Array<{ id: number; title: string; createdAt: string }>> {
+    const response = await http
+      .actingAs(author)
+      .withHeaders({ 'X-Inertia': 'true' })
+      .get(`/posts/${post.id}/revisions`)
+      .assertOk()
+    const page = (await response.json()) as { component: string; props: { revisions: never } }
+    expect(page.component).toBe('posts/Revisions')
+    return page.props.revisions
+  }
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    await migrateDatabase()
+    // Without the CSRF token every write below is a 403 before any policy or
+    // validator runs, and the refusals asserted here would pass for that reason.
+    http = await booted.withCsrf()
+    author = await makeUser('author')
+    stranger = await makeUser('stranger')
+  })
+
+  it('keeps nothing when a post is created', async () => {
+    await http.actingAs(author).post('/posts', content('Created')).assertRedirect()
+
+    const post = await Post.where({ authorId: author.id, title: 'Created' }).firstOrFail()
+    expect(await revisionsOf(post)).toHaveLength(0)
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    const post = await makePost('First')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await revisionsOf(post)
+    expect(revisions.map(({ title, excerpt, body }) => ({ title, excerpt, body }))).toEqual([
+      content('First'),
+      content('Second'),
+    ])
+    expect(revisions[0]?.createdAt).toBe(new Date(revisions[0]?.createdAt ?? '').toISOString())
+    expect((await Post.findOrFail(post.id)).title).toBe('Third')
+  })
+
+  it('keeps nothing when an edit is refused', async () => {
+    const post = await makePost('Untouched')
+
+    await http.actingAs(author).put(`/posts/${post.id}`, { ...content('Invalid'), title: '' }).assertStatus(422)
+    await http.actingAs(stranger).put(`/posts/${post.id}`, content('Hijacked')).assertForbidden()
+    await http.put(`/posts/${post.id}`, content('Anonymous')).assertRedirect('/login')
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('Untouched')
+  })
+
+  it('lists revisions newest first', async () => {
+    const post = await makePost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third')).assertRedirect()
+
+    const listed = await revisionProps(post)
+    const stored = await revisionsOf(post)
+
+    expect(listed.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(listed.map((revision) => revision.id)).toEqual(stored.map((revision) => revision.id).reverse())
+    expect(typeof listed[0]?.createdAt).toBe('string')
+  })
+
+  it('restores a revision and keeps the version it replaces', async () => {
+    const post = await makePost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Third')).assertRedirect()
+    const [first] = await revisionsOf(post)
+
+    await http
+      .actingAs(author)
+      .post(`/posts/${post.id}/revisions/${first?.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect({ title: restored.title, excerpt: restored.excerpt, body: restored.body }).toEqual(content('First'))
+    expect((await revisionProps(post)).map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses everyone but the author', async () => {
+    const post = await makePost('First')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Second')).assertRedirect()
+    const [first] = await revisionsOf(post)
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    await http.actingAs(stranger).post(`/posts/${post.id}/revisions/${first?.id}/restore`).assertForbidden()
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await http.post(`/posts/${post.id}/revisions/${first?.id}/restore`).assertRedirect('/login')
+
+    expect(await revisionsOf(post)).toHaveLength(1)
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+  })
+
+  it('answers 404 for a revision of another post, even one by the same author', async () => {
+    const post = await makePost('Mine')
+    const other = await makePost('Other first')
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Other second')).assertRedirect()
+    const [foreign] = await revisionsOf(other)
+
+    await http.actingAs(author).post(`/posts/${post.id}/revisions/${foreign?.id}/restore`).assertNotFound()
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect((await Post.findOrFail(other.id)).title).toBe('Other second')
+  })
+
+  it('deletes the history with the post, and only that history', async () => {
+    const post = await makePost('Doomed')
+    const other = await makePost('Survivor')
+    await http.actingAs(author).put(`/posts/${post.id}`, content('Doomed again')).assertRedirect()
+    await http.actingAs(author).put(`/posts/${other.id}`, content('Survivor again')).assertRedirect()
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+})
