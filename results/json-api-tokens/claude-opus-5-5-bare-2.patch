+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+
+// Uses the 'api' and 'api.throttle' aliases routes/web.ts registers on this
+// router: bearer-token authentication first, then the per-token rate limit.
+export function registerApiRoutes(router: Router<'api' | 'api.throttle'>): void {
+  router.group('/api', (api) => {
+    api.middleware('api', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', [ApiPostController, 'store']).name('api.posts.store')
+    })
+  })
+}
