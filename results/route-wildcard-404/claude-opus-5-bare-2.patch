diff --git a/tests/PostArchiveController.test.ts b/tests/PostArchiveController.test.ts
new file mode 100644
index 0000000..0d6a589
--- /dev/null
+++ b/tests/PostArchiveController.test.ts
@@ -0,0 +1,98 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// The archive answers both documented URL shapes — /posts/archive/2026/08 and
+// /posts/archive/2026. Fixtures live in a year no seeder uses, so they can be
+// counted exactly without disturbing the rest of the test database.
+const FIXTURE_EMAIL = 'archive-fixture@example.com'
+const FIXTURE_YEAR = '2999'
+
+const FIXTURE_POSTS = [
+  { title: 'March, early', createdAt: '2999-03-04T10:00:00.000Z' },
+  { title: 'March, late', createdAt: '2999-03-28T23:59:59.000Z' },
+  { title: 'December', createdAt: '2999-12-01T00:00:00.000Z' },
+  { title: 'The year after', createdAt: '3000-03-04T10:00:00.000Z' },
+]
+
+async function titlesOf(response: { json<T>(): Promise<T> }): Promise<string[]> {
+  const body = await response.json<{ data: PostResourceData[] }>()
+  return body.data.map((post) => post.title)
+}
+
+describe('posts.archive', () => {
+  let http: TestApp
+  let authorId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    const existing = await User.newQuery().where('email', FIXTURE_EMAIL).first()
+    const author = existing ?? (await User.forceCreate({
+      name: 'Archive Fixture',
+      email: FIXTURE_EMAIL,
+      password: 'secret',
+    }))
+    authorId = author.id as number
+
+    // Clear anything a previous run left behind, so the counts stay exact.
+    await Post.delete({ authorId })
+    for (const post of FIXTURE_POSTS) {
+      await Post.forceCreate({
+        title: post.title,
+        excerpt: 'Archive fixture.',
+        body: 'Archive fixture.',
+        authorId,
+        createdAt: post.createdAt,
+      })
+    }
+  })
+
+  afterAll(async () => {
+    await Post.delete({ authorId })
+    await User.delete({ id: authorId })
+  })
+
+  it('lists the posts of a month, newest first', async () => {
+    const response = await http.get(`/posts/archive/${FIXTURE_YEAR}/03`).assertOk()
+
+    expect(await titlesOf(response)).toEqual(['March, late', 'March, early'])
+  })
+
+  it('accepts a month without its leading zero', async () => {
+    const response = await http.get(`/posts/archive/${FIXTURE_YEAR}/3`).assertOk()
+
+    expect(await titlesOf(response)).toEqual(['March, late', 'March, early'])
+  })
+
+  it('lists the posts of a whole year', async () => {
+    const response = await http.get(`/posts/archive/${FIXTURE_YEAR}`).assertOk()
+
+    expect(await titlesOf(response)).toEqual(['December', 'March, late', 'March, early'])
+  })
+
+  it('answers an empty period with an empty list', async () => {
+    const response = await http.get(`/posts/archive/${FIXTURE_YEAR}/07`).assertOk()
+
+    expect(await titlesOf(response)).toEqual([])
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    const response = await http.get(`/posts/archive/${FIXTURE_YEAR}/13`)
+
+    expect(response.status).toBeGreaterThanOrEqual(400)
+    expect(response.status).toBeLessThan(500)
+  })
+
+  it('rejects a year that is not four digits', async () => {
+    const response = await http.get('/posts/archive/20xx')
+
+    expect(response.status).toBeGreaterThanOrEqual(400)
+    expect(response.status).toBeLessThan(500)
+  })
+})
