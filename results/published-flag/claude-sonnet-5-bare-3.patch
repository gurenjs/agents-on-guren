diff --git a/tests/PostController.drafts.test.ts b/tests/PostController.drafts.test.ts
new file mode 100644
index 0000000..eef13d7
--- /dev/null
+++ b/tests/PostController.drafts.test.ts
@@ -0,0 +1,125 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// Exercises the draft/published switch end to end: creation defaults,
+// visibility on the list and search, and direct-URL access to a draft's
+// page. Uses real HTTP requests against the booted app and a real (test)
+// SQLite database rather than mocking the ORM, since the behaviour under
+// test spans the controller, policy, and query filters together.
+describe('post drafts', () => {
+  let guest: TestApp
+  let userA: { id: number; name: string; email: string }
+  let userB: { id: number; name: string; email: string }
+  let draftId: number
+  let publishedId: number
+
+  // Unique per run: the test database persists across `bun test` invocations,
+  // so a fixed keyword would eventually collide with a row a previous run
+  // left behind (e.g. the draft this file publishes partway through).
+  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+  const draftTitle = `Draft Post Alpha ${suffix}`
+  const draftKeyword = `zzyzxkeyword${suffix}`
+  const publishedTitle = `Published Post Beta ${suffix}`
+  const publishedKeyword = `qwzxcvtkeyword${suffix}`
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    guest = await TestApp.fromApp(app)
+
+    userA = await User.create({ name: 'Author A', email: `author-a-${suffix}@example.com`, password: 'secret1234' })
+    userB = await User.create({ name: 'Author B', email: `author-b-${suffix}@example.com`, password: 'secret1234' })
+
+    const asA = await guest.actingAs(userA).withCsrf()
+
+    const draftResponse = await asA.post('/posts', {
+      title: draftTitle,
+      excerpt: `A draft excerpt with keyword ${draftKeyword}`,
+      body: 'Body text.',
+    })
+    draftId = Number(draftResponse.headers.get('location')?.split('/').pop())
+
+    const publishedResponse = await asA.post('/posts', {
+      title: publishedTitle,
+      excerpt: `A published excerpt with keyword ${publishedKeyword}`,
+      body: 'Body text.',
+      published: true,
+    })
+    publishedId = Number(publishedResponse.headers.get('location')?.split('/').pop())
+  })
+
+  it('defaults a post created without `published` to a draft', async () => {
+    const asA = await guest.actingAs(userA).withCsrf()
+    await asA.withHeader('X-Inertia', 'true').get(`/posts/${draftId}`).assertJsonPath('props.post.published', false)
+  })
+
+  it('marks a post created with `published: true` as public immediately', async () => {
+    await guest.withHeader('X-Inertia', 'true').get(`/posts/${publishedId}`).assertJsonPath('props.post.published', true)
+  })
+
+  it('hides a draft from guests on the post page', async () => {
+    await guest.get(`/posts/${draftId}`).assertNotFound()
+  })
+
+  it('hides a draft from a signed-in user who is not the author', async () => {
+    const asB = await guest.actingAs(userB).withCsrf()
+    await asB.get(`/posts/${draftId}`).assertNotFound()
+  })
+
+  it('lets the author open their own draft', async () => {
+    const asA = await guest.actingAs(userA).withCsrf()
+    await asA.get(`/posts/${draftId}`).assertOk()
+    await asA.get(`/posts/${draftId}/edit`).assertOk()
+  })
+
+  it('excludes a draft from the post list, but includes a published post', async () => {
+    const response = await guest.withHeader('X-Inertia', 'true').get('/posts')
+    const json = await response.json()
+    const ids = (json.props.data as Array<{ id: number }>).map((post) => post.id)
+    expect(ids).not.toContain(draftId)
+    expect(ids).toContain(publishedId)
+  })
+
+  it('excludes a draft from search results even when the keyword matches', async () => {
+    const response = await guest.query('/posts/search', { keywords: [draftKeyword] })
+    const json = await response.json()
+    expect(json.data).toHaveLength(0)
+  })
+
+  it('includes a published post in search results', async () => {
+    const response = await guest.query('/posts/search', { keywords: [publishedKeyword] })
+    const json = await response.json()
+    const ids = (json.data as Array<{ id: number }>).map((post) => post.id)
+    expect(ids).toContain(publishedId)
+  })
+
+  it('publishes a draft when the edit form saves `published: true`', async () => {
+    const asA = await guest.actingAs(userA).withCsrf()
+    await asA
+      .put(`/posts/${draftId}`, {
+        title: draftTitle,
+        excerpt: `A draft excerpt with keyword ${draftKeyword}`,
+        body: 'Body text.',
+        published: true,
+      })
+      .assertRedirect()
+
+    await guest.get(`/posts/${draftId}`).assertOk()
+  })
+
+  it('turns a published post back into a draft when the edit form saves `published: false`', async () => {
+    const asA = await guest.actingAs(userA).withCsrf()
+    await asA
+      .put(`/posts/${publishedId}`, {
+        title: publishedTitle,
+        excerpt: `A published excerpt with keyword ${publishedKeyword}`,
+        body: 'Body text.',
+        published: false,
+      })
+      .assertRedirect()
+
+    await guest.get(`/posts/${publishedId}`).assertNotFound()
+  })
+})
