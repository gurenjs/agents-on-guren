new file mode 100644
index 0000000..c895731
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,78 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const MCP_HEADERS = { 'content-type': 'application/json', accept: 'application/json, text/event-stream' }
+
+// The endpoint answers as an SSE stream: the JSON-RPC message is the `data:` line.
+async function parse(res: Response): Promise<unknown> {
+  const text = await res.text()
+  const data = text.split('\n').find((line) => line.startsWith('data:'))
+  return JSON.parse(data ? data.slice(5) : text)
+}
+
+describe('POST /mcp', () => {
+  let bearer: string
+  let userId: number
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    await resetDatabase()
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass-123' })
+    userId = Number(user!.id)
+    const store = app.auth.getApiTokenStore()!
+    bearer = (await createApiToken(store, { name: 'test', userId, abilities: ['tools:*'] })).plainTextToken
+  })
+
+  const rpc = (method: string, params: unknown, token: string | null = bearer) =>
+    app.fetch(new Request('http://localhost/mcp', {
+      method: 'POST',
+      headers: { ...MCP_HEADERS, ...(token ? { authorization: `Bearer ${token}` } : {}) },
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+    }))
+
+  it('refuses a call without a credential', async () => {
+    expect((await rpc('tools/list', {}, null)).status).toBe(401)
+  })
+
+  it('lists the two tools with read-only flags', async () => {
+    const body = (await parse(await rpc('tools/list', {}))) as {
+      result: { tools: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }> }
+    }
+    const tools = body.result.tools.filter((t) => !t.name.startsWith('guren_'))
+    expect(tools.map((t) => t.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((t) => t.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((t) => t.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('stores a post as the calling user and finds it', async () => {
+    const stored = await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: 'Bun news', excerpt: 'Release', body: 'Text', authorId: 999 },
+    })
+    expect(stored.status).toBe(200)
+    await parse(stored.clone())
+    const created = (await Post.all()).filter((post) => post.title === 'Bun news')
+    expect(created).toHaveLength(1)
+    expect(created[0]?.authorId).toBe(userId)
+
+    const found = (await parse(await rpc('tools/call', { name: 'posts_search', arguments: { keywords: ['Bun'] } }))) as {
+      result: { isError?: boolean }
+    }
+    expect(found.result.isError).toBeFalsy()
+  })
+
+  it('rejects invalid input and creates nothing', async () => {
+    const before = (await Post.all()).length
+    const res = (await parse(await rpc('tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'x', body: 'y' },
+    }))) as { result: { isError?: boolean } }
+    expect(res.result.isError).toBe(true)
+    expect((await Post.all()).length).toBe(before)
+  })
+})
