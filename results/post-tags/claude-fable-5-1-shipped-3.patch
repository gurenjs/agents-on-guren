+/**
+ * Splits the form's comma-separated tag input into distinct names: trimmed,
+ * empties dropped, duplicates collapsed (case-sensitive), first spelling kept.
+ * Idempotent, so the controller re-runs it on the value `validated()` hands
+ * over — codegen types a transformed field by its input shape.
+ */
+export function parseTagNames(input: string | readonly string[] | undefined): string[] {
+  const pieces = typeof input === 'string' ? input.split(',') : (input ?? []).flatMap((piece) => piece.split(','))
+  const names: string[] = []
+  for (const piece of pieces) {
+    const name = piece.trim()
+    if (name.length > 0 && !names.includes(name)) {
+      names.push(name)
+    }
+  }
+  return names
+}
+
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+    if (names.some((name) => name.length > TAG_NAME_MAX_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${TAG_NAME_MAX_LENGTH} characters or fewer.` })
+    }
+  })
