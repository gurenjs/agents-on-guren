+import { useState, type FormEvent } from 'react'
+import type { ApiTokenResourceData } from '@/app/Http/Resources/ApiTokenResource'
+import { createApiClient, type ApiRoutes } from '@/.guren/api-client.gen'
+
+interface Props {
+  tokens: ApiTokenResourceData[]
+}
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+// The token routes answer JSON rather than an Inertia page: the new token has
+// to reach this component once, and must not travel through page props, which
+// the browser keeps in its history state.
+const api = createApiClient<ApiRoutes>({ baseUrl: '', headers: { Accept: 'application/json' } })
+
+export default function ApiTokens({ tokens: initialTokens }: Props) {
+  const [tokens, setTokens] = useState(initialTokens)
+  const [name, setName] = useState('')
+  const [created, setCreated] = useState<CreatedToken | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [busy, setBusy] = useState(false)
+
+  async function create(event: FormEvent) {
+    event.preventDefault()
+    setBusy(true)
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.store', { body: { name } })
+      if (response.status === 422) {
+        const payload = (await response.json()) as { errors?: { name?: string[] } }
+        setError(payload.errors?.name?.[0] ?? 'Enter a name of 1 to 50 characters.')
+        return
+      }
+      if (!response.ok) {
+        setError('The token could not be created. Reload the page and try again.')
+        return
+      }
+      const token = (await response.json()) as CreatedToken
+      setCreated(token)
+      setTokens((current) => [
+        { id: token.id, name: token.name, createdAt: new Date().toISOString(), lastUsedAt: null },
+        ...current,
+      ])
+      setName('')
+    } catch {
+      setError('The token could not be created. Check your connection and try again.')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  async function revoke(token: ApiTokenResourceData) {
+    if (!window.confirm(`Revoke "${token.name}"? Scripts using it stop working at once.`)) {
+      return
+    }
+
+    setBusy(true)
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.destroy', { params: { id: token.id } })
+      // 404: already revoked from another tab, which is what was asked for.
+      if (!response.ok && response.status !== 404) {
+        setError('The token could not be revoked. Reload the page and try again.')
+        return
+      }
+      setTokens((current) => current.filter((candidate) => candidate.id !== token.id))
+      setCreated((current) => (current?.id === token.id ? null : current))
+    } catch {
+      setError('The token could not be revoked. Check your connection and try again.')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <section className="space-y-6 rounded-g-card border border-g-line bg-g-panel p-8 shadow-g-card">
+      <header>
+        <h2 className="flex items-center gap-3 text-xl font-bold text-g-heading">
+          <span aria-hidden className="h-5 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+          API tokens
+        </h2>
+        <p className="mt-2 text-sm text-g-text-2">
+          Let a script read and publish posts as you. Send the token as{' '}
+          <code className="font-mono text-xs">Authorization: Bearer &lt;token&gt;</code>. Each token may make 60
+          requests a minute.
+        </p>
+      </header>
+
+      {created ? (
+        <div className="space-y-2 border-y border-g-line py-3 text-sm">
+          <p className="text-g-text">
+            Copy the token for <strong>{created.name}</strong> now. It is not stored and cannot be shown again.
+          </p>
+          <code className="block break-all rounded-g-ctl border border-g-line-strong px-3 py-2 font-mono text-xs text-g-heading">
+            {created.token}
+          </code>
+          <button
+            type="button"
+            onClick={() => setCreated(null)}
+            className="text-g-accent-text transition hover:underline"
+          >
+            Done
+          </button>
+        </div>
+      ) : null}
+
+      <form className="flex gap-2" onSubmit={create}>
+        <input
+          type="text"
+          value={name}
+          onChange={(event) => setName(event.target.value)}
+          maxLength={50}
+          placeholder="Token name, e.g. CI"
+          aria-label="Token name"
+          className="w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent"
+        />
+        <button
+          type="submit"
+          disabled={busy}
+          className="shrink-0 rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent transition hover:bg-g-accent-down disabled:cursor-not-allowed disabled:opacity-45"
+        >
+          Create token
+        </button>
+      </form>
+
+      {error !== null && <p className="text-sm text-g-danger">{error}</p>}
+
+      {tokens.length === 0 ? (
+        <p className="text-sm text-g-muted">No tokens yet.</p>
+      ) : (
+        <ul className="divide-y divide-g-line border-y border-g-line">
+          {tokens.map((token) => (
+            <li key={token.id} className="flex items-center justify-between gap-4 py-3">
+              <div>
+                <p className="font-bold text-g-heading">{token.name}</p>
+                <p className="font-mono text-xs text-g-muted">
+                  created {token.createdAt.slice(0, 10)}
+                  {' · '}
+                  {token.lastUsedAt ? `last used ${token.lastUsedAt.slice(0, 10)}` : 'never used'}
+                </p>
+              </div>
+              <button
+                type="button"
+                disabled={busy}
+                onClick={() => revoke(token)}
+                className="rounded-g-ctl border border-g-danger-chip px-3 py-1 text-sm font-bold text-g-danger transition hover:bg-g-danger-tint disabled:cursor-not-allowed disabled:opacity-45"
+              >
+                Revoke
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
