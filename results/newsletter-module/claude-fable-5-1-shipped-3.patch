@@ -0,0 +1,113 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts/1'
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await NewsletterSubscription.newQuery().delete()
+  })
+
+  async function guest(): Promise<TestApp> {
+    return (await http.withCsrf()).json().withHeader('Referer', REFERER)
+  }
+
+  describe('POST /newsletter/subscribe', () => {
+    it('stores a pending subscription with a token and redirects back', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows).toHaveLength(1)
+      expect(rows[0]?.email).toBe('reader@example.com')
+      expect(rows[0]?.confirmedAt).toBeNull()
+      expect(rows[0]?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to / without a Referer', async () => {
+      const client = (await http.withCsrf()).json()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('ignores a Referer on another site', async () => {
+      const client = (await http.withCsrf()).json().withHeader('Referer', 'https://evil.example/phish')
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect('/')
+    })
+
+    it('rejects an invalid email with a 422 under email', async () => {
+      const client = await guest()
+      await client
+        .post('/newsletter/subscribe', { email: 'not-an-email' })
+        .assertUnprocessable()
+        .assertJsonStructure(['message', 'errors'])
+      await client.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+      await client.post('/newsletter/subscribe', {}).assertUnprocessable()
+
+      const res = await client.post('/newsletter/subscribe', { email: 'not-an-email' })
+      const body = await res.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email).toBeDefined()
+      expect(await NewsletterSubscription.newQuery().count()).toBe(0)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+      await client
+        .post('/newsletter/subscribe', { email: 'reader@example.com' })
+        .assertUnprocessable()
+        .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+
+      expect(await NewsletterSubscription.newQuery().count()).toBe(1)
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('marks the subscription confirmed and redirects home', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' })
+      const before = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(before?.confirmedAt).toBeNull()
+
+      await http.get(`/newsletter/confirm/${before?.token}`).assertRedirect('/')
+
+      const after = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(after?.confirmedAt).toEqual(expect.any(String))
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'reader@example.com' })
+
+      await http.get('/newsletter/confirm/not-a-real-token').assertNotFound()
+
+      const row = await NewsletterSubscription.first({ email: 'reader@example.com' })
+      expect(row?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('deletes only that address and redirects back', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: 'leaving@example.com' })
+      await client.post('/newsletter/subscribe', { email: 'staying@example.com' })
+
+      await client.post('/newsletter/unsubscribe', { email: 'leaving@example.com' }).assertRedirect(REFERER)
+
+      const rows = await NewsletterSubscription.all()
+      expect(rows.map((row) => row.email)).toEqual(['staying@example.com'])
+    })
+
+    it('rejects an invalid email with a 422', async () => {
+      const client = await guest()
+      await client.post('/newsletter/unsubscribe', { email: 'nope' }).assertUnprocessable()
+    })
+  })
+})
