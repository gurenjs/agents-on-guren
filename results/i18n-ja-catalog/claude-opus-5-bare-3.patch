diff --git a/tests/AuthLocale.test.ts b/tests/AuthLocale.test.ts
new file mode 100644
index 0000000..6ed1b34
--- /dev/null
+++ b/tests/AuthLocale.test.ts
@@ -0,0 +1,85 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import enAuth from '../lang/en/auth.json'
+import jaAuth from '../lang/ja/auth.json'
+import enMessages from '../lang/en/messages.json'
+import jaMessages from '../lang/ja/messages.json'
+
+// The auth pages read every label through `useTranslation()`, so the strings
+// travel to the browser in the `_i18n` Inertia prop rather than in the
+// server-rendered markup — asserting on the document covers both the shared
+// catalog and the `<title>`/`<html lang>` the server picks per request.
+const JA_BROWSER = 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7'
+
+function flatten(value: unknown, prefix = ''): Record<string, string> {
+  if (typeof value === 'string') {
+    return { [prefix]: value }
+  }
+
+  return Object.entries(value as Record<string, unknown>).reduce<Record<string, string>>(
+    (acc, [key, child]) => Object.assign(acc, flatten(child, prefix ? `${prefix}.${key}` : key)),
+    {},
+  )
+}
+
+describe('auth pages i18n', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('renders the login page in Japanese for a Japanese browser', async () => {
+    const body = await http.withHeader('Accept-Language', JA_BROWSER).get('/login').then((r) => r.text())
+
+    expect(body).toContain('<html lang="ja">')
+    expect(body).toContain('<title>ログイン</title>')
+    expect(body).toContain('アカウントの認証情報を入力して続行してください。')
+    expect(body).toContain('ログイン状態を保持する')
+  })
+
+  it('renders the register page in Japanese for a Japanese browser', async () => {
+    const body = await http.withHeader('Accept-Language', JA_BROWSER).get('/register').then((r) => r.text())
+
+    expect(body).toContain('<html lang="ja">')
+    expect(body).toContain('<title>アカウント登録</title>')
+    expect(body).toContain('パスワード（確認）')
+  })
+
+  it('keeps English for browsers that do not prefer Japanese', async () => {
+    for (const header of ['en', 'en-US,en;q=0.9', 'en-US,en;q=0.9,ja;q=0.5', 'fr-FR,fr;q=0.9']) {
+      const body = await http.withHeader('Accept-Language', header).get('/login').then((r) => r.text())
+
+      expect(body).toContain('<html lang="en">')
+      expect(body).toContain('<title>Sign in</title>')
+      expect(body).not.toContain('ログイン')
+    }
+  })
+
+  it('keeps English when no Accept-Language header is sent', async () => {
+    const body = await http.get('/register').then((r) => r.text())
+
+    expect(body).toContain('<html lang="en">')
+    expect(body).toContain('<title>Sign up</title>')
+    expect(body).not.toContain('アカウント登録')
+  })
+})
+
+describe('translation catalogs', () => {
+  const en = { ...flatten(enAuth, 'auth'), ...flatten(enMessages, 'messages') }
+  const ja = { ...flatten(jaAuth, 'auth'), ...flatten(jaMessages, 'messages') }
+
+  it('translates every English key into Japanese and back', () => {
+    expect(Object.keys(ja).sort()).toEqual(Object.keys(en).sort())
+  })
+
+  it('carries every placeholder over to the Japanese string', () => {
+    for (const [key, value] of Object.entries(en)) {
+      const placeholders = value.match(/:[a-zA-Z_][a-zA-Z0-9_]*/g) ?? []
+      for (const placeholder of placeholders) {
+        expect(ja[key]).toContain(placeholder)
+      }
+    }
+  })
+})
