@@ -1,3 +1,4 @@
+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,45 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  // A checkbox: read it with isTicked(). Not a .transform() to a boolean,
+  // because codegen types the validated body from a transform's input.
+  removeCover: z.union([z.boolean(), z.string()]).optional(),
+})
+
+/**
+ * A ticked checkbox arrives as '1' in a multipart body and as `true` in a JSON
+ * one; Inertia sends whichever matches the rest of the form.
+ */
+export function isTicked(value: boolean | string | undefined): boolean {
+  return value === true || value === '1' || value === 'true' || value === 'on'
+}
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+const COVER_SIGNATURES = [
+  { contentType: 'image/png', bytes: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a] },
+  { contentType: 'image/jpeg', bytes: [0xff, 0xd8, 0xff] },
+] as const
+
+/**
+ * Accepts a PNG or JPEG of at most 2 MB, judged by the file's leading bytes:
+ * the name and the declared type are the client's claim, not evidence. The
+ * returned file carries the detected type, which is the one it is served with.
+ */
+export async function validateCover(file: File): Promise<File> {
+  if (file.size > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover must be 2 MB or smaller.' })
+  }
+
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const signature = COVER_SIGNATURES.find((candidate) =>
+    candidate.bytes.every((byte, index) => bytes[index] === byte),
+  )
+  if (!signature) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image.' })
+  }
+
+  return new File([bytes], file.name, { type: signature.contentType })
+}
