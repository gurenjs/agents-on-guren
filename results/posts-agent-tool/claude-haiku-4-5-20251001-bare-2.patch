new file mode 100644
index 0000000..08d9c4d
--- /dev/null
+++ b/app/Http/Controllers/McpController.ts
@@ -0,0 +1,283 @@
+import { Controller } from '@guren/core'
+import { readBearerToken, verifyApiToken } from '@guren/core'
+import type { ApiTokenStore } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { PostSearchSchema, PostPayloadSchema } from '../Validators/PostValidator.js'
+import type { UserRecord } from '../../Models/User.js'
+
+interface McpJsonRpcRequest {
+  jsonrpc: '2.0'
+  method: string
+  params?: Record<string, unknown>
+  id: string | number
+}
+
+interface McpJsonRpcResponse {
+  jsonrpc: '2.0'
+  result?: unknown
+  error?: McpJsonRpcError
+  id: string | number
+}
+
+interface McpJsonRpcError {
+  code: number
+  message: string
+  data?: unknown
+}
+
+interface McpTool {
+  name: string
+  description?: string
+  inputSchema: {
+    type: 'object'
+    properties: Record<string, unknown>
+    required?: string[]
+  }
+  _meta?: {
+    name?: string
+  }
+}
+
+export default class McpController extends Controller {
+  static readonly inject = ['api-token-store'] as const
+
+  constructor(private tokenStore: ApiTokenStore) {
+    super()
+  }
+  private readonly tools: McpTool[] = [
+    {
+      name: 'posts_search',
+      description: 'Search blog posts by keywords',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          keywords: {
+            type: 'array',
+            items: { type: 'string' },
+            description: 'Keywords to search for in post titles and excerpts',
+          },
+          limit: {
+            type: 'number',
+            description: 'Maximum number of results (default 10, max 50)',
+          },
+        },
+        required: ['keywords'],
+      },
+    },
+    {
+      name: 'posts_store',
+      description: 'Create a new blog post',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          title: {
+            type: 'string',
+            description: 'Post title (required, max 255 characters)',
+          },
+          excerpt: {
+            type: 'string',
+            description: 'Post excerpt (required, max 500 characters)',
+          },
+          body: {
+            type: 'string',
+            description: 'Post body content (required)',
+          },
+        },
+        required: ['title', 'excerpt', 'body'],
+      },
+    },
+  ]
+
+  async handle(): Promise<Response> {
+    // Get bearer token from Authorization header
+    const authHeader = this.request.header('Authorization')
+    const token = readBearerToken(authHeader)
+
+    if (!token) {
+      return this.mcpError(-32600, 'Unauthorized', null, {
+        status: 401,
+      })
+    }
+
+    // Verify token and get user
+    const verified = await verifyApiToken(token, this.tokenStore)
+
+    if (!verified) {
+      return this.mcpError(-32600, 'Unauthorized', null, {
+        status: 401,
+      })
+    }
+
+    // Parse the request body
+    let request: McpJsonRpcRequest
+    try {
+      const body = await this.request.json()
+      request = body as McpJsonRpcRequest
+    } catch {
+      return this.mcpError(-32700, 'Parse error', null)
+    }
+
+    // Validate JSON-RPC format
+    if (!request.jsonrpc || request.jsonrpc !== '2.0' || !request.method || request.id === undefined) {
+      return this.mcpError(-32600, 'Invalid Request', null)
+    }
+
+    // Route to appropriate handler
+    if (request.method === 'tools/list') {
+      return this.toolsList(request)
+    }
+
+    if (request.method === 'tools/call') {
+      return this.toolsCall(request, verified.userId)
+    }
+
+    return this.mcpError(-32601, 'Method not found', request.id)
+  }
+
+  private toolsList(request: McpJsonRpcRequest): Response {
+    const tools = this.tools.map((tool) => ({
+      name: tool.name,
+      description: tool.description,
+      inputSchema: tool.inputSchema,
+    }))
+
+    const response: McpJsonRpcResponse = {
+      jsonrpc: '2.0',
+      result: { tools },
+      id: request.id,
+    }
+
+    return this.json(response)
+  }
+
+  private async toolsCall(
+    request: McpJsonRpcRequest,
+    userId: string | number,
+  ): Promise<Response> {
+    const params = request.params as Record<string, unknown> | undefined
+
+    if (!params || typeof params !== 'object' || !('name' in params) || !('arguments' in params)) {
+      return this.mcpError(-32602, 'Invalid params', request.id)
+    }
+
+    const toolName = params.name as string
+    const toolArgs = params.arguments as Record<string, unknown>
+
+    try {
+      if (toolName === 'posts_search') {
+        return await this.callPostsSearch(request.id, toolArgs)
+      }
+
+      if (toolName === 'posts_store') {
+        return await this.callPostsStore(request.id, toolArgs, userId)
+      }
+
+      return this.mcpError(-32601, 'Tool not found', request.id)
+    } catch (error) {
+      const message = error instanceof Error ? error.message : 'Unknown error'
+      return this.mcpError(-32603, message, request.id)
+    }
+  }
+
+  private async callPostsSearch(id: string | number, args: Record<string, unknown>): Promise<Response> {
+    // Validate input against PostSearchSchema
+    const validation = await PostSearchSchema.safeParseAsync(args)
+
+    if (!validation.success) {
+      const errors = validation.error.issues
+        .map((issue) => `${issue.path.join('.')}: ${issue.message}`)
+        .join('; ')
+
+      return this.mcpError(
+        -32602,
+        `Validation failed: ${errors}`,
+        id,
+        { status: 422 },
+      )
+    }
+
+    const { keywords, limit } = validation.data
+
+    // Execute search
+    const posts = await Post.newQuery()
+      .with('author')
+      .where((q) => {
+        for (const keyword of keywords) {
+          const pattern = `%${keyword}%`
+          q.orWhere('title', 'like', pattern).orWhere('excerpt', 'like', pattern)
+        }
+      })
+      .orderBy('id', 'desc')
+      .limit(limit)
+      .get()
+
+    const result = {
+      data: PostResource.collection(posts),
+    }
+
+    return this.mcpSuccess(result, id)
+  }
+
+  private async callPostsStore(
+    id: string | number,
+    args: Record<string, unknown>,
+    userId: string | number,
+  ): Promise<Response> {
+    // Validate input against PostPayloadSchema
+    const validation = await PostPayloadSchema.safeParseAsync(args)
+
+    if (!validation.success) {
+      const errors = validation.error.issues
+        .map((issue) => `${issue.path.join('.')}: ${issue.message}`)
+        .join('; ')
+
+      return this.mcpError(
+        -32602,
+        `Validation failed: ${errors}`,
+        id,
+        { status: 422 },
+      )
+    }
+
+    const { title, excerpt, body } = validation.data
+
+    // Create post - ensure userId is a number
+    const numericUserId = typeof userId === 'string' ? parseInt(userId, 10) : userId
+    const post = await Post.forceCreate({
+      title,
+      excerpt,
+      body,
+      authorId: numericUserId,
+    })
+
+    const result = new PostResource(post).toJSON()
+
+    return this.mcpSuccess(result, id)
+  }
+
+  private mcpSuccess(result: unknown, id: string | number): Response {
+    const response: McpJsonRpcResponse = {
+      jsonrpc: '2.0',
+      result,
+      id,
+    }
+
+    return this.json(response)
+  }
+
+  private mcpError(
+    code: number,
+    message: string,
+    id: string | number | null,
+    options?: { status?: number },
+  ): Response {
+    const response: McpJsonRpcResponse = {
+      jsonrpc: '2.0',
+      error: { code, message },
+      id: id ?? 0,
+    }
+
+    return this.json(response, { status: options?.status ?? 200 })
+  }
+}
