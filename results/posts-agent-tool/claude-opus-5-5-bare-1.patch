diff --git a/tests/McpEndpoint.test.ts b/tests/McpEndpoint.test.ts
new file mode 100644
index 0000000..f229a14
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,131 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, DatabaseApiTokenStore } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokens } from '../db/schema.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The App MCP endpoint (@guren/plugin-mcp) serves the routes that declare
+// `.agent()` in routes/web.ts. These tests speak MCP over /mcp the way an
+// author's assistant would, with a bearer from the app's token store.
+
+interface ToolCallResult {
+  isError?: boolean
+  structuredContent?: unknown
+  content?: { type: string, text?: string }[]
+}
+
+async function rpc(token: string | null, method: string, params: Record<string, unknown> = {}): Promise<Response> {
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    Accept: 'application/json, text/event-stream',
+  }
+  if (token) headers.Authorization = `Bearer ${token}`
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers,
+    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+  }))
+}
+
+// A stateless streamable-HTTP answer is either plain JSON or one SSE event.
+async function rpcResult<T>(response: Response): Promise<T> {
+  const text = await response.text()
+  const json = response.headers.get('content-type')?.includes('text/event-stream')
+    ? text.split('\n').find((line) => line.startsWith('data:'))!.slice(5)
+    : text
+  return (JSON.parse(json) as { result: T }).result
+}
+
+describe('App MCP endpoint', () => {
+  let token: string
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    const email = `mcp-${crypto.randomUUID()}@example.com`
+    author = (await User.create({ name: 'MCP Author', email, password: 'password123' })) as UserRecord
+    const issued = await createApiToken(new DatabaseApiTokenStore(apiTokens), {
+      name: 'test assistant',
+      userId: author.id,
+      abilities: ['tools:*'],
+    })
+    token = issued.plainTextToken
+  })
+
+  it('refuses a request without a bearer', async () => {
+    const response = await rpc(null, 'tools/list')
+    expect(response.status).toBe(401)
+  })
+
+  it('lists exactly the two post tools with their read-only flags', async () => {
+    const { tools } = await rpcResult<{ tools: { name: string, annotations?: { readOnlyHint?: boolean } }[] }>(
+      await rpc(token, 'tools/list'),
+    )
+    const appTools = tools.filter((tool) => !tool.name.startsWith('guren_'))
+    expect(appTools.map((tool) => tool.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(appTools.find((tool) => tool.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(appTools.find((tool) => tool.name === 'posts_store')?.annotations?.readOnlyHint).toBe(false)
+  })
+
+  it('creates a post as the token user, ignoring authorId', async () => {
+    const title = `MCP post ${crypto.randomUUID()}`
+    const result = await rpcResult<ToolCallResult>(await rpc(token, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title, excerpt: 'From an assistant', body: 'Hello from MCP.', authorId: 999_999 },
+    }))
+    expect(result.isError).toBeFalsy()
+
+    const post = await Post.where({ title }).first()
+    expect(post?.authorId).toBe(author.id)
+  })
+
+  it('rejects invalid input as an error result and creates nothing', async () => {
+    const excerpt = `invalid-${crypto.randomUUID()}`
+    const result = await rpcResult<ToolCallResult>(await rpc(token, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt, body: 'Body' },
+    }))
+    expect(result.isError).toBe(true)
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+  })
+
+  // The MCP wire result carries no HTTP status, so the status the tool call
+  // resolved to is asserted through the framework's agent test surface.
+  it('answers invalid posts_store input with 422', async () => {
+    const excerpt = `invalid-${crypto.randomUUID()}`
+    const http = await (await TestApp.fromApp(app)).withCsrf()
+    await http.agent()
+      .call('posts_store', { title: '', excerpt, body: 'Body' }, { as: author })
+      .assertStatus(422)
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+  })
+
+  it('does not let a guest create a post', async () => {
+    const title = `Guest post ${crypto.randomUUID()}`
+    const http = await (await TestApp.fromApp(app)).withCsrf()
+    const result = await http.agent().call('posts_store', { title, excerpt: 'Guest', body: 'Guest' })
+    expect([302, 401, 403]).toContain(result.status)
+    expect(await Post.where({ title }).get()).toHaveLength(0)
+  })
+
+  it('lets a guest search, like the site does', async () => {
+    const http = await (await TestApp.fromApp(app)).withCsrf()
+    await http.agent().call('posts_search', { keywords: ['anything'] }).assertOk()
+  })
+
+  it('searches posts with the same answer as QUERY /posts/search', async () => {
+    const input = { keywords: ['MCP post'], limit: 5 }
+    const result = await rpcResult<ToolCallResult>(await rpc(token, 'tools/call', {
+      name: 'posts_search',
+      arguments: input,
+    }))
+    expect(result.isError).toBeFalsy()
+
+    const http = await TestApp.fromApp(app)
+    const expected = await (await http.query('/posts/search', input)).json()
+    const actual = result.structuredContent ?? JSON.parse(result.content?.[0]?.text ?? 'null')
+    expect(actual).toEqual(expected)
+  })
+})
