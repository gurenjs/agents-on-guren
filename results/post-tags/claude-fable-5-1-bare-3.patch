diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..26fca0b
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,271 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { readInertiaResponse, TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { getDatabase, type AppSeederContext } from '../config/database.js'
+import { posts, postTags, tags, users } from '../db/schema.js'
+import app from '../src/app.js'
+
+// Feature tests against the test database (./data/guren.test.db unless
+// TEST_DATABASE_URL says otherwise), which the app migrates on first use.
+
+const AUTHOR_EMAIL = 'tags-author@example.com'
+
+// getDatabase() is untyped; the seeders' context names the handle it returns.
+const database = async () => (await getDatabase()) as AppSeederContext['db']
+
+const payload = (overrides: Record<string, unknown> = {}) => ({
+  title: 'Tagged post',
+  excerpt: 'A post about tags.',
+  body: 'Tags make posts findable.',
+  ...overrides,
+})
+
+describe('post tags', () => {
+  let guest: TestApp
+  let author: TestApp
+  let user: UserRecord
+
+  async function createPost(overrides: Record<string, unknown> = {}): Promise<number> {
+    const response = await author.post('/posts', payload(overrides))
+    const location = response.headers.get('location') ?? ''
+    const id = Number(location.match(/\/posts\/(\d+)$/)?.[1])
+    expect(id).toBeGreaterThan(0)
+
+    return id
+  }
+
+  async function pageProps<TProps>(path: string): Promise<TProps> {
+    const response = await guest.get(path).assertOk()
+    const { payload: page } = await readInertiaResponse(response.raw)
+
+    return page.props as TProps
+  }
+
+  const showTags = async (id: number) => (await pageProps<{ post: PostResourceData }>(`/posts/${id}`)).post.tags
+
+  const listPosts = async (path: string) => (await pageProps<{ data: PostResourceData[] }>(path)).data
+
+  async function attachedNames(postId: number): Promise<string[]> {
+    const db = await database()
+    const rows = await db
+      .select({ name: tags.name })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(eq(postTags.postId, postId))
+
+    return rows.map((row) => row.name).sort()
+  }
+
+  async function counts() {
+    const db = await database()
+
+    return {
+      posts: await db.$count(posts),
+      tags: await db.$count(tags),
+      postTags: await db.$count(postTags),
+    }
+  }
+
+  beforeAll(async () => {
+    guest = await TestApp.fromApp(app)
+
+    const db = await database()
+    const [existing] = await db.select().from(users).where(eq(users.email, AUTHOR_EMAIL)).limit(1)
+    user = existing ?? (await User.create({ name: 'Tags Author', email: AUTHOR_EMAIL, password: 'secret-secret' }))
+    author = await guest.actingAs(user).withCsrf()
+  })
+
+  beforeEach(async () => {
+    const db = await database()
+    await db.delete(postTags)
+    await db.delete(tags)
+    await db.delete(posts).where(eq(posts.authorId, user.id))
+  })
+
+  it('stores and attaches the tags of a new post', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    const db = await database()
+    const names = (await db.select().from(tags)).map((tag) => tag.name).sort()
+    expect(names).toEqual(['bun', 'webdev'])
+    expect(await attachedNames(id)).toEqual(['bun', 'webdev'])
+    expect(await showTags(id)).toEqual(['bun', 'webdev'])
+  })
+
+  it('sorts the tags of a post alphabetically', async () => {
+    const id = await createPost({ tags: 'webdev, bun, agents' })
+
+    expect(await showTags(id)).toEqual(['agents', 'bun', 'webdev'])
+  })
+
+  it('gives a post without a tags field no tags', async () => {
+    const id = await createPost()
+    const blank = await createPost({ tags: ' , ' })
+
+    expect(await showTags(id)).toEqual([])
+    expect(await showTags(blank)).toEqual([])
+    expect((await counts()).tags).toBe(0)
+  })
+
+  it('detaches the tags an edit removed and keeps the tag itself', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    await author.put(`/posts/${id}`, payload({ tags: 'bun' })).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedNames(id)).toEqual(['bun'])
+    expect(await showTags(id)).toEqual(['bun'])
+    expect((await counts()).tags).toBe(2)
+  })
+
+  it('reuses a tag another post already carries', async () => {
+    const first = await createPost({ tags: 'bun' })
+    const second = await createPost({ tags: 'bun, webdev' })
+
+    expect(await attachedNames(first)).toEqual(['bun'])
+    expect(await attachedNames(second)).toEqual(['bun', 'webdev'])
+    expect(await counts()).toMatchObject({ tags: 2, postTags: 3 })
+  })
+
+  it('removes every tag when an edit leaves the field empty', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    await author.put(`/posts/${id}`, payload({ tags: '' })).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedNames(id)).toEqual([])
+  })
+
+  it('starts the edit form from the current tags', async () => {
+    const id = await createPost({ tags: 'webdev, bun' })
+
+    const response = await author.get(`/posts/${id}/edit`).assertOk()
+    const { payload: page } = await readInertiaResponse(response.raw)
+
+    expect((page.props as { post: PostResourceData }).post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('counts a trimmed, repeated name once', async () => {
+    const id = await createPost({ tags: ' bun ,bun' })
+
+    expect(await attachedNames(id)).toEqual(['bun'])
+    expect(await counts()).toMatchObject({ tags: 1, postTags: 1 })
+  })
+
+  it('treats names as case-sensitive', async () => {
+    const id = await createPost({ tags: 'Bun, bun' })
+
+    expect(await attachedNames(id)).toEqual(['Bun', 'bun'])
+  })
+
+  it('refuses six tags the way it refuses an empty title', async () => {
+    const before = await counts()
+    const emptyTitle = await author.post('/posts', payload({ title: '' }))
+
+    const response = await author.post('/posts', payload({ tags: 'a, b, c, d, e, f' }))
+
+    expect(response.status).toBe(emptyTitle.status)
+    expect(response.headers.get('location')).toBe(emptyTitle.headers.get('location'))
+    expect(await counts()).toEqual(before)
+  })
+
+  it('reports a broken rule on the tags field', async () => {
+    const response = await author.json().post('/posts', payload({ tags: 'a, b, c, d, e, f' })).assertUnprocessable()
+    const body = await response.json<{ errors: Record<string, unknown> }>()
+
+    expect(Object.keys(body.errors)).toEqual(['tags'])
+  })
+
+  it('accepts five tags', async () => {
+    const id = await createPost({ tags: 'a, b, c, d, e,' })
+
