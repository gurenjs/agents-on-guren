diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..9190f33
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,295 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import { resetDatabase } from '../config/database.js'
+
+interface InertiaPage<TProps> {
+  component: string
+  props: TProps
+}
+
+interface IndexProps {
+  data: PostResourceData[]
+  pagination: { meta: { total: number; currentPage: number }; links: { pages: { page: number; url: string }[] } }
+  tag: string | null
+}
+
+const payload = { title: 'Tagged', excerpt: 'About tags.', body: 'Tags on posts.' }
+
+describe('tags on posts', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+  })
+
+  async function visit<TProps>(path: string): Promise<InertiaPage<TProps>> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path).assertOk()
+    return response.json<InertiaPage<TProps>>()
+  }
+
+  async function createPost(fields: Record<string, unknown> = {}): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.json().post('/posts', { ...payload, ...fields })
+    const id = Number(response.headers.get('location')?.match(/^\/posts\/(\d+)$/)?.[1])
+    expect(id).toBeGreaterThan(0)
+    return id
+  }
+
+  async function tagNames(): Promise<string[]> {
+    const rows = await Tag.newQuery().orderBy('name').get()
+    return rows.map((row) => row.name)
+  }
+
+  async function attachedNames(postId: number): Promise<string[]> {
+    const attached = await PostTag.where({ postId }).get()
+    const rows = await Tag.newQuery()
+      .whereIn(
+        'id',
+        attached.map((row) => row.tagId),
+      )
+      .orderBy('name')
+      .get()
+    return rows.map((row) => row.name)
+  }
+
+  async function rowCounts(): Promise<{ posts: number; tags: number; postTags: number }> {
+    return {
+      posts: await Post.newQuery().count(),
+      tags: await Tag.newQuery().count(),
+      postTags: await PostTag.newQuery().count(),
+    }
+  }
+
+  it('stores and attaches the tags of a new post', async () => {
+    const id = await createPost({ tags: 'webdev, bun' })
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await attachedNames(id)).toEqual(['bun', 'webdev'])
+
+    const page = await visit<{ post: PostResourceData }>(`/posts/${id}`)
+    expect(page.component).toBe('posts/Show')
+    expect(page.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('creates a post without tags when the field is absent or empty', async () => {
+    const absent = await createPost()
+    const empty = await createPost({ tags: ' , ' })
+
+    expect(await rowCounts()).toEqual({ posts: 2, tags: 0, postTags: 0 })
+    expect((await visit<{ post: PostResourceData }>(`/posts/${absent}`)).props.post.tags).toEqual([])
+    expect((await visit<{ post: PostResourceData }>(`/posts/${empty}`)).props.post.tags).toEqual([])
+  })
+
+  it('trims names, ignores empty entries and counts a repeated name once', async () => {
+    const id = await createPost({ tags: ' bun ,bun,, ' })
+
+    expect(await tagNames()).toEqual(['bun'])
+    expect(await rowCounts()).toEqual({ posts: 1, tags: 1, postTags: 1 })
+    expect(await attachedNames(id)).toEqual(['bun'])
+  })
+
+  it('treats names that differ in case as different tags', async () => {
+    const id = await createPost({ tags: 'Bun, bun' })
+
+    expect(await attachedNames(id)).toEqual(['Bun', 'bun'])
+  })
+
+  it('reuses a tag another post already carries', async () => {
+    const first = await createPost({ tags: 'bun' })
+    const second = await createPost({ tags: 'bun, webdev' })
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await attachedNames(first)).toEqual(['bun'])
+    expect(await attachedNames(second)).toEqual(['bun', 'webdev'])
+  })
+
+  it('detaches a removed tag on update and keeps the tag row', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${id}`, { ...payload, tags: 'bun' }).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedNames(id)).toEqual(['bun'])
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect((await visit<{ post: PostResourceData }>(`/posts/${id}`)).props.post.tags).toEqual(['bun'])
+  })
+
+  it('removes every tag when an update leaves the field out', async () => {
+    const id = await createPost({ tags: 'bun, webdev' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${id}`, payload).assertRedirect(`/posts/${id}`)
+
+    expect(await attachedNames(id)).toEqual([])
+  })
+
+  it('hands the edit form the current tags', async () => {
+    const id = await createPost({ tags: 'webdev, bun' })
+
+    const response = await http
+      .actingAs(author)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${id}/edit`)
+      .assertOk()
+    const page = await response.json<InertiaPage<{ post: PostResourceData }>>()
+
+    expect(page.component).toBe('posts/Edit')
+    expect(page.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('refuses a sixth tag like an empty title, and saves nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const emptyTitle = await csrf.json().post('/posts', { ...payload, title: '' })
+    const response = await csrf.json().post('/posts', { ...payload, tags: 'a, b, c, d, e, f' })
+
+    expect(response.status).toBe(emptyTitle.status)
+    expect(response.status).toBe(422)
+    const body = await response.json<{ errors: Record<string, string[]> }>()
+    expect(Object.keys(body.errors)).toEqual(['tags'])
+    expect(await rowCounts()).toEqual({ posts: 0, tags: 0, postTags: 0 })
+  })
+
+  it('accepts five tags', async () => {
+    const id = await createPost({ tags: 'a, b, c, d, e' })
+
+    expect(await attachedNames(id)).toEqual(['a', 'b', 'c', 'd', 'e'])
+  })
+
+  it('refuses a 31-character name and saves a 30-character one', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const response = await csrf.json().post('/posts', { ...payload, tags: `bun, ${'x'.repeat(31)}` })
+
+    expect(response.status).toBe(422)
+    const body = await response.json<{ errors: Record<string, string[]> }>()
+    expect(Object.keys(body.errors)).toEqual(['tags'])
