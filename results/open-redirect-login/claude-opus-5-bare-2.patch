--- /dev/null
+++ b/tests/SafeRedirect.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'bun:test'
+import { DEFAULT_REDIRECT, safeRedirectPath } from '../app/Http/SafeRedirect.js'
+
+// The post-login destination comes from the client (?redirect=…), so it is the
+// open-redirect surface of the sign-in flow: keep same-app paths working, drop
+// everything that would leave the site.
+describe('safeRedirectPath', () => {
+  it('keeps a path inside the app', () => {
+    expect(safeRedirectPath('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(safeRedirectPath('/')).toBe('/')
+    expect(safeRedirectPath('/posts?page=2#top')).toBe('/posts?page=2#top')
+  })
+
+  it('rejects absolute URLs', () => {
+    expect(safeRedirectPath('https://evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('http://evil.example/path')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('HTTPS://evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('javascript:alert(1)')).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('rejects protocol-relative values', () => {
+    expect(safeRedirectPath('//evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('///evil.example')).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('rejects the backslash spellings browsers normalise into "//"', () => {
+    expect(safeRedirectPath('/\\evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('\\\\evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('/\\/evil.example')).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('rejects values browsers would rewrite into an off-site one', () => {
+    expect(safeRedirectPath(' //evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('/\t/evil.example')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('/\n/evil.example')).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('falls back when nothing usable was supplied', () => {
+    expect(safeRedirectPath(undefined)).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath('   ')).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath(42)).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('uses the caller-supplied fallback', () => {
+    expect(safeRedirectPath('https://evil.example', '')).toBe('')
+    expect(safeRedirectPath('/posts', '')).toBe('/posts')
+  })
+})
