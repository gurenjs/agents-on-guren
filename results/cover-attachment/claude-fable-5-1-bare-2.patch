+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,45 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+// The "remove cover" checkbox arrives as the string '1' in a multipart body
+// (the form carries a file) and as a JSON boolean when Inertia sends no file.
+// Both spellings normalize to one boolean here so the controller sees neither.
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  removeCover: z
+    .union([
+      z.boolean(),
+      z.string().transform((value) => ['1', 'true', 'on'].includes(value.toLowerCase())),
+    ])
+    .optional()
+    .transform((value) => Boolean(value)),
+})
+
+export type PostUpdatePayload = z.infer<typeof PostUpdatePayloadSchema>
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_SIGNATURE = [0xff, 0xd8, 0xff]
+
+function startsWith(bytes: Uint8Array, signature: readonly number[]): boolean {
+  return signature.every((byte, index) => bytes[index] === byte)
+}
+
+/**
+ * The app's rule for a cover upload: PNG or JPEG, at most 2 MB. Sniffed from
+ * the bytes rather than the client-declared type, which any request can fake.
+ * Throws the same 422 shape a route schema failure produces, keyed on `cover`,
+ * so the form shows it next to the file field. Call it before writing any
+ * post row: a refused cover must leave nothing behind.
+ */
+export async function validateCoverUpload(file: File): Promise<void> {
+  if (file.size > COVER_MAX_BYTES) {
+    throw ValidationException.withMessages({ cover: 'Cover image must be 2 MB or smaller.' })
+  }
+
+  const head = new Uint8Array(await file.slice(0, PNG_SIGNATURE.length).arrayBuffer())
+  if (!startsWith(head, PNG_SIGNATURE) && !startsWith(head, JPEG_SIGNATURE)) {
+    throw ValidationException.withMessages({ cover: 'Cover image must be a PNG or JPEG.' })
+  }
+}
