diff --git a/tests/controllers/CommentController.test.ts b/tests/controllers/CommentController.test.ts
new file mode 100644
index 0000000..b481f54
--- /dev/null
+++ b/tests/controllers/CommentController.test.ts
@@ -0,0 +1,156 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { User, type UserRecord } from '../../app/Models/User.js'
+import { Post, type PostRecord } from '../../app/Models/Post.js'
+import { Comment } from '../../app/Models/Comment.js'
+import { CommentReport } from '../../app/Models/CommentReport.js'
+
+describe('CommentController', () => {
+  let http: TestApp
+  let user1: UserRecord
+  let user2: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user1 = (await User.create({
+      name: 'User 1',
+      email: `user1-${Date.now()}@test.com`,
+      password: 'password',
+    })) as UserRecord
+    user2 = (await User.create({
+      name: 'User 2',
+      email: `user2-${Date.now()}@test.com`,
+      password: 'password',
+    })) as UserRecord
+    post = (await Post.forceCreate({
+      title: 'Test',
+      excerpt: 'Test',
+      body: 'Test',
+      authorId: user1.id,
+    })) as PostRecord
+  })
+
+  test('guest cannot post comment', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Test comment' }).assertRedirect('/login')
+  })
+
+  test('authenticated user can post comment', async () => {
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Test comment' }).assertRedirect(`/posts/${post.id}`)
+
+    const comment = await Comment.first({ postId: post.id })
+    expect(comment).toBeDefined()
+    expect(comment?.body).toBe('Test comment')
+    expect(comment?.userId).toBe(user2.id)
+  })
+
+  test('comment body validation', async () => {
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf
+      .post(`/posts/${post.id}/comments`, { body: 'a'.repeat(2001) })
+      .assertUnprocessable()
+  })
+
+  test('comment author can delete own comment', async () => {
+    const comment = await Comment.forceCreate({ body: 'Test', postId: post.id, userId: user2.id })
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    const deleted = await Comment.find(comment.id)
+    expect(deleted).toBeNull()
+  })
+
+  test('post author can delete any comment', async () => {
+    const comment = await Comment.forceCreate({ body: 'Test', postId: post.id, userId: user2.id })
+    const csrf = await http.actingAs(user1).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+
+    const deleted = await Comment.find(comment.id)
+    expect(deleted).toBeNull()
+  })
+
+  test('other user cannot delete comment', async () => {
+    const user3 = (await User.create({
+      name: 'User 3',
+      email: `user3-${Date.now()}-1@test.com`,
+      password: 'password',
+    })) as UserRecord
+    const comment = await Comment.forceCreate({ body: 'Test', postId: post.id, userId: user2.id })
+    const csrf = await http.actingAs(user3).withCsrf()
+    await csrf.delete(`/comments/${comment.id}`).assertForbidden()
+
+    const notDeleted = await Comment.find(comment.id)
+    expect(notDeleted).toBeDefined()
+  })
+
+  test('can report comment', async () => {
+    const comment = await Comment.forceCreate({ body: 'Test', postId: post.id, userId: user2.id })
+    const csrf = await http.actingAs(user1).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    const report = await CommentReport.first({ commentId: comment.id, userId: user1.id })
+    expect(report).toBeDefined()
+  })
+
+  test('reporting same comment twice counts once', async () => {
+    const comment = await Comment.forceCreate({ body: 'Test', postId: post.id, userId: user2.id })
+    const csrf = await http.actingAs(user1).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    const reports = await CommentReport.where({ commentId: comment.id, userId: user1.id }).get()
+    expect(reports.length).toBe(1)
+  })
+
+  test('comment hidden when 3+ users report it', async () => {
+    const comment = await Comment.forceCreate({ body: 'Spam', postId: post.id, userId: user2.id })
+    const user3 = (await User.create({
+      name: 'User 3',
+      email: `user3-${Date.now()}-2@test.com`,
+      password: 'password',
+    })) as UserRecord
+    const user4 = (await User.create({
+      name: 'User 4',
+      email: `user4-${Date.now()}@test.com`,
+      password: 'password',
+    })) as UserRecord
+
+    let csrf = await http.actingAs(user1).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    csrf = await http.actingAs(user3).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    csrf = await http.actingAs(user4).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+    const showPage = await http.get(`/posts/${post.id}`)
+    const body = await showPage.text()
+    expect(body).not.toContain('Spam')
+  })
+
+  test('post page shows comments', async () => {
+    const newPost = await Post.forceCreate({ title: 'New', excerpt: 'New', body: 'New', authorId: user1.id })
+    await Comment.forceCreate({ body: 'Great post!', postId: newPost.id, userId: user2.id })
+
+    const response = await http.get(`/posts/${newPost.id}`)
+    const body = await response.text()
+    expect(body).toContain('Great post!')
+    expect(body).toContain(user2.name)
+  })
+
+  test('deleting post deletes comments', async () => {
+    const newPost = await Post.forceCreate({ title: 'Delete me', excerpt: 'Delete me', body: 'Delete me', authorId: user1.id })
+    const comment = await Comment.forceCreate({ body: 'Comment on deletable post', postId: newPost.id, userId: user2.id })
+
+    const csrf = await http.actingAs(user1).withCsrf()
+    await csrf.delete(`/posts/${newPost.id}`).assertRedirect('/posts')
+
+    const deletedComment = await Comment.find(comment.id)
+    expect(deletedComment).toBeNull()
+  })
+})
