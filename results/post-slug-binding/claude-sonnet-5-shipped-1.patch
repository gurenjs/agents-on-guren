diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..1c5c56c
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,99 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('post slugs', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })
+  })
+
+  it('generates a slug from the title, stripping punctuation', async () => {
+    const post = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: user.id })
+    expect(post.slug).toBe('hello-world')
+  })
+
+  it('collapses whitespace and symbol runs into single hyphens', async () => {
+    const post = await Post.forceCreate({
+      title: '  Guren  &  Bun: 2026 Edition!  ',
+      excerpt: 'e',
+      body: 'b',
+      authorId: user.id,
+    })
+    expect(post.slug).toBe('guren-bun-2026-edition')
+  })
+
+  it('dedupes repeated titles with the next free numeric suffix', async () => {
+    const first = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: user.id })
+    const second = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: user.id })
+    const third = await Post.forceCreate({ title: 'Hello, World!', excerpt: 'e', body: 'b', authorId: user.id })
+
+    expect(first.slug).toBe('hello-world')
+    expect(second.slug).toBe('hello-world-2')
+    expect(third.slug).toBe('hello-world-3')
+  })
+
+  it('keeps the original slug after the title is edited', async () => {
+    const post = await Post.forceCreate({ title: 'Original Title', excerpt: 'e', body: 'b', authorId: user.id })
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'Brand New Title', excerpt: 'e', body: 'b' })
+      .assertRedirect(`/posts/${post.slug}`)
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.slug).toBe(post.slug)
+  })
+
+  it('redirects the author to the new post at its slug URL', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post('/posts', { title: 'Hello, World!', excerpt: 'e', body: 'b' }).assertRedirect('/posts/hello-world')
+  })
+
+  it('serves the post page at its slug', async () => {
+    const post = await Post.forceCreate({ title: 'A Readable Post', excerpt: 'e', body: 'b', authorId: user.id })
+    await http.get(`/posts/${post.slug}`).assertOk()
+  })
+
+  it('404s for an unknown slug', async () => {
+    await http.get('/posts/does-not-exist').assertNotFound()
+  })
+
+  it('redirects the legacy numeric address to the slug URL', async () => {
+    const post = await Post.forceCreate({ title: 'Legacy Post', excerpt: 'e', body: 'b', authorId: user.id })
+    await http.get(`/posts/${post.id}`).assertStatus(301).assertHeader('Location', `/posts/${post.slug}`)
+  })
+
+  it('404s for an unknown numeric id', async () => {
+    await http.get('/posts/999999').assertNotFound()
+  })
+
+  it('carries the slug field on resources served to the posts list', async () => {
+    const post = await Post.forceCreate({ title: 'Searchable Post', excerpt: 'e', body: 'b', authorId: user.id })
+    const response = await http.query('/posts/search', { keywords: ['Searchable'] })
+    const body = await response.json<{ data: Array<{ slug: string }> }>()
+
+    expect(body.data).toHaveLength(1)
+    expect(body.data[0]?.slug).toBe(post.slug)
+  })
