diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..f400fd7
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,74 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('DashboardController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows a zero post count and empty recent posts for a user with no posts', async () => {
+    const user = (await User.create({
+      name: 'No Posts',
+      email: 'no-posts@example.com',
+      password: 'secret123',
+    })) as UserRecord
+
+    await http.actingAs(user).json().get('/dashboard').assertInertia('dashboard/Index', {
+      postCount: 0,
+      recentPosts: [],
+    })
+  })
+
+  it('shows only the signed-in user\'s posts, newest first, capped at 5', async () => {
+    const user = (await User.create({
+      name: 'Writer',
+      email: 'writer@example.com',
+      password: 'secret123',
+    })) as UserRecord
+    const other = (await User.create({
+      name: 'Other',
+      email: 'other@example.com',
+      password: 'secret123',
+    })) as UserRecord
+
+    await Post.forceCreate({
+      title: 'Not mine',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: other.id,
+    })
+
+    for (let i = 1; i <= 6; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: user.id,
+      })
+    }
+
+    const res = await http.actingAs(user).json().get('/dashboard')
+    const body = await res.json()
+    const titles = body.props.recentPosts.map((post: { id: number; title: string }) => post.title)
+
+    if (body.props.postCount !== 6) throw new Error(`expected postCount 6, got ${body.props.postCount}`)
+
+    if (titles.length !== 5) throw new Error(`expected 5 recent posts, got ${titles.length}`)
+    if (titles[0] !== 'Post 6') throw new Error(`expected newest first, got ${JSON.stringify(titles)}`)
+    if (titles.includes('Not mine')) throw new Error('recent posts leaked another user\'s post')
+  })
+})
