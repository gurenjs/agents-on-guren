diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..0a991b5
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,119 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Boots the real src/app.ts, which migrates the test database on boot, so
+// these run against real tables. Fixtures carry a per-run suffix because the
+// test database persists between runs.
+const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+async function makeUser(label: string): Promise<UserRecord> {
+  return User.create({ name: label, email: `${label}-${runId}@example.com`, password: 'secret' })
+}
+
+async function makePost(author: UserRecord) {
+  return Post.forceCreate({ title: `Post ${runId}`, excerpt: 'excerpt', body: 'body', authorId: author.id })
+}
+
+async function pageComments(http: TestApp, postId: number) {
+  const response = await http.get(`/posts/${postId}`).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props.comments as Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }>
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+
+  beforeAll(async () => {
+    // Mutating requests pass CSRF like a browser: the session and XSRF cookies
+    // captured here ride along on every request below, whoever it acts as.
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+    author = await makeUser('author')
+    reader = await makeUser('reader')
+    stranger = await makeUser('stranger')
+  })
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const post = await makePost(author)
+    await http.post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('stores a signed-in user\'s comment and lists it oldest first with its author', async () => {
+    const post = await makePost(author)
+    await http.actingAs(reader).post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await http.actingAs(author).post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await pageComments(http, post.id)
+    expect(comments.map((comment) => comment.body)).toEqual(['first', 'second'])
+    expect(comments[0]?.author).toEqual({ id: reader.id, name: reader.name })
+    expect(new Date(comments[0]?.createdAt ?? '').toISOString()).toBe(comments[0]?.createdAt)
+
+    const stored = await Comment.where({ postId: post.id }).orderBy('id', 'asc').get()
+    expect(stored.map((comment) => comment.userId)).toEqual([reader.id, author.id])
+  })
+
+  it('rejects an empty or oversized body the way an invalid post does', async () => {
+    const post = await makePost(author)
+    await http.actingAs(reader).json().post(`/posts/${post.id}/comments`, { body: '' }).assertStatus(422)
+    await http.actingAs(reader).json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertStatus(422)
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('lets the comment author or the post author delete, and nobody else', async () => {
+    const post = await makePost(author)
+    const mine = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'mine' })
+    const theirs = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'theirs' })
+
+    await http.actingAs(stranger).delete(`/comments/${mine.id}`).assertStatus(403)
+    expect(await Comment.find(mine.id)).not.toBeNull()
+
+    await http.actingAs(reader).delete(`/comments/${mine.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(mine.id)).toBeNull()
+
+    await http.actingAs(author).delete(`/comments/${theirs.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(theirs.id)).toBeNull()
+  })
+
+  it('answers 204 to every report and counts each user once', async () => {
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'spam?' })
+
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+    await http.post(`/comments/${comment.id}/report`).assertRedirect('/login')
+  })
+
+  it('hides a comment from the page after three distinct reporters but keeps the row', async () => {
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'reported' })
+    const fourth = await makeUser('fourth')
+
+    await http.actingAs(author).post(`/comments/${comment.id}/report`).assertNoContent()
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect((await pageComments(http.actingAs(reader), post.id)).map((c) => c.id)).toEqual([comment.id])
+
+    await http.actingAs(fourth).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await pageComments(http.actingAs(reader), post.id)).toEqual([])
+    expect(await pageComments(http.actingAs(author), post.id)).toEqual([])
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes a post\'s comments and their reports with the post', async () => {
+    const post = await makePost(author)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'gone soon' })
+    await http.actingAs(stranger).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await http.actingAs(author).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(0)
+  })
+})
