diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..0430edd
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,20 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+import { z } from 'zod'
+
+const LocaleSchema = z.object({
+  locale: z.enum(['en', 'ja']),
+})
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const schema = await this.validateBody(LocaleSchema)
+    const locale = schema.locale
+
+    const referer = this.request.header('Referer')
+    const redirectUrl = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    const response = this.redirect(redirectUrl)
+    response.headers.set('Set-Cookie', `locale=${locale}; Path=/; Max-Age=31536000; SameSite=Lax`)
+    return response
+  }
+}
