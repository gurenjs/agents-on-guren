diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..363571b
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,32 @@
+const EXCERPT_LENGTH = 140
+const ELLIPSIS = '…'
+
+function lastWhitespaceIndex(value: string): number {
+  for (let i = value.length - 1; i >= 0; i--) {
+    if (/\s/.test(value[i]!)) return i
+  }
+  return -1
+}
+
+/**
+ * Derives a post excerpt from its body: the body trimmed and, if longer than
+ * 140 characters, cut to the last whitespace boundary before that limit (so
+ * words are never split) with a trailing ellipsis.
+ */
+export function deriveExcerptFromBody(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+  const head = trimmed.slice(0, EXCERPT_LENGTH)
+  const nextChar = trimmed[EXCERPT_LENGTH]
+  const lastHeadChar = head[EXCERPT_LENGTH - 1]!
+  const cutsWordInHalf = nextChar !== undefined && !/\s/.test(nextChar) && !/\s/.test(lastHeadChar)
+
+  let kept = head
+  if (cutsWordInHalf) {
+    const boundary = lastWhitespaceIndex(head)
+    if (boundary !== -1) kept = head.slice(0, boundary)
+  }
+
+  return `${kept.trimEnd()}${ELLIPSIS}`
+}
