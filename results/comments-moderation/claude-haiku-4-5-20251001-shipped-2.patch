+        userId: commenter.id,
+        body: 'Comment to delete',
+      })
+
+      const csrf = await http.actingAs(commenter).withCsrf()
+      const response = await csrf.delete(`/comments/${comment.id}`)
+
+      expect(response.status).toBe(303)
+
+      const deleted = await Comment.find(comment.id)
+      expect(deleted).toBeNull()
+    })
+
+    it('allows post author to delete a comment', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment to delete by post author',
+      })
+
+      const csrf = await http.actingAs(author).withCsrf()
+      const response = await csrf.delete(`/comments/${comment.id}`)
+
+      expect(response.status).toBe(303)
+
+      const deleted = await Comment.find(comment.id)
+      expect(deleted).toBeNull()
+    })
+
+    it('denies deletion by other users with 403', async () => {
+      const comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Protected comment',
+      })
+
+      const csrf = await http.actingAs(otherUser).withCsrf()
+      await csrf.delete(`/comments/${comment.id}`).assertForbidden()
+
+      const notDeleted = await Comment.find(comment.id)
+      expect(notDeleted).toBeDefined()
+    })
+  })
+
+  describe('POST /comments/:id/report', () => {
