new file mode 100644
index 0000000..5c58481
--- /dev/null
+++ b/app/Services/RateLimiter.ts
@@ -0,0 +1,39 @@
+interface RateLimitBucket {
+  count: number
+  resetAt: number
+}
+
+const buckets = new Map<number, RateLimitBucket>()
+
+export function checkRateLimit(tokenId: number, limit: number = 60, windowMs: number = 60000): { allowed: boolean; retryAfter?: number } {
+  const now = Date.now()
+  let bucket = buckets.get(tokenId)
+
+  if (!bucket || now >= bucket.resetAt) {
+    bucket = { count: 0, resetAt: now + windowMs }
+    buckets.set(tokenId, bucket)
+  }
+
+  if (bucket.count >= limit) {
+    const retryAfter = Math.ceil((bucket.resetAt - now) / 1000)
+    return { allowed: false, retryAfter }
+  }
+
+  bucket.count++
+  return { allowed: true }
+}
+
+export function getRateLimitRetryAfter(tokenId: number, _windowMs: number = 60000): number | null {
+  const now = Date.now()
+  const bucket = buckets.get(tokenId)
+
+  if (!bucket || now >= bucket.resetAt) {
+    return null
+  }
+
+  if (bucket.count < 60) {
+    return null
+  }
+
+  return Math.ceil((bucket.resetAt - now) / 1000)
+}
diff --git a/app/Services/TokenService.ts b/app/Services/TokenService.ts
