+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// POST /login is throttled to 5 attempts/minute per client so credential
+// stuffing can't run at scale. Wrong-password submissions already return 422,
+// so the 6th attempt is what proves throttling: it must come back 429 with a
+// Retry-After header instead of another 422.
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    http = await http.withCsrf('/login')
+  })
+
+  it('allows 5 attempts then refuses the 6th with 429 and Retry-After', async () => {
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      await http
+        .post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+        .assertUnprocessable()
+    }
+
+    await http
+      .post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+      .assertStatus(429)
+      .assertHeader('Retry-After')
+  })
+
+  it('still refuses a correct-looking submission once throttled', async () => {
+    await http
+      .post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+      .assertStatus(429)
+  })
+
+  it('leaves GET /login unaffected by the throttle', async () => {
+    await http.get('/login').assertOk()
+  })
+})
