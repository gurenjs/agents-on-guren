diff --git a/app/Http/Middleware/ApiTokens.ts b/app/Http/Middleware/ApiTokens.ts
new file mode 100644
index 0000000..4645ab1
--- /dev/null
+++ b/app/Http/Middleware/ApiTokens.ts
@@ -0,0 +1,26 @@
+import {
+  DatabaseApiTokenStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+  MemoryRateLimitStore,
+} from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+/** Authenticates `Authorization: Bearer <token>`; anything else is a JSON 401. */
+export const bearerAuth = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (ctx) => ctx.json({ error: 'Unauthenticated.' }, 401),
+})
+
+/** 60 requests per minute per token. Must run after `bearerAuth`. */
+export const tokenRateLimit = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  message: 'Too many requests.',
+})
