@@ -4,10 +4,47 @@ export const PostIdParamSchema = z.object({
   id: z.coerce.number().int().positive(),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  // Deliberately not held to the rules of the form field: a name no post
+  // carries — too long, or never saved — lists nothing rather than failing.
+  tag: z.string().trim().optional(),
 })
 
+/**
+ * The names in a comma-separated `tags` field: trimmed, blanks dropped, a
+ * repeated name kept once. Names are case-sensitive.
+ */
+export function parseTagNames(value: string | null | undefined): string[] {
+  const names = (value ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+
+  return [...new Set(names)]
+}
+
+// Stays the string the form sends rather than transforming into the names, so
+// the body type codegen extracts is the one the controller really receives;
+// the controller reads the names with parseTagNames(). Both rules are reported
+// on `tags` itself, the one input the author typed into.
+const TagsSchema = z
+  .string()
+  .nullish()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+
+    if (names.some((name) => Array.from(name).length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post may have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+  })
+
