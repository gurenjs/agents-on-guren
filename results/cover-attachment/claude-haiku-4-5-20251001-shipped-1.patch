diff --git a/tests/controllers/PostController.test.ts b/tests/controllers/PostController.test.ts
new file mode 100644
index 0000000..d091957
--- /dev/null
+++ b/tests/controllers/PostController.test.ts
@@ -0,0 +1,182 @@
+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { User } from '../../app/Models/User.js'
+import { Post } from '../../app/Models/Post.js'
+import { Attachment } from '../../app/Models/Attachment.js'
+import { resetDatabase } from '../../config/database.js'
+
+describe('PostController', () => {
+  let http: TestApp
+  let user: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({
+      name: 'Test User',
+      email: `test-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+  })
+
+  test('index displays posts', async () => {
+    await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: user.id,
+    })
+
+    await http.get('/posts').assertOk()
+  })
+
+  test('show displays post', async () => {
+    const post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: user.id,
+    })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  test('store creates post without cover', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.post('/posts', {
+      title: 'New Post',
+      excerpt: 'New excerpt',
+      body: 'New body',
+    })
+
+    await res.assertRedirect()
+    const post = await Post.first({ title: 'New Post' })
+    expect(post).not.toBeNull()
+    expect(post!.coverAttachmentId).toBeNull()
+  })
+
+  test('edit page shows post data', async () => {
+    const post = await Post.forceCreate({
+      title: 'Post to Edit',
+      excerpt: 'Edit excerpt',
+      body: 'Edit body',
+      authorId: user.id,
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.get(`/posts/${post.id}/edit`).assertOk()
+  })
+
+  test('can fetch post with cover attachment loaded', async () => {
+    const attachment = await Attachment.create({
+      path: 'test.png',
+      mimeType: 'image/png',
+    })
+
+    const post = await Post.forceCreate({
+      title: 'Original Title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: user.id,
+      coverAttachmentId: attachment.id,
+    })
+
+    const loaded = await Post.findWithOrFail(post.id, ['author', 'coverAttachment'])
+    expect(loaded.id).toBe(post.id)
+    expect((loaded as any).coverAttachment?.path).toBe('test.png')
+  })
+
+  test('destroy deletes post', async () => {
+    const post = await Post.forceCreate({
+      title: 'Post to Delete',
+      excerpt: 'Delete excerpt',
+      body: 'Delete body',
+      authorId: user.id,
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.delete(`/posts/${post.id}`)
+
+    await res.assertRedirect()
+
+    const deleted = await Post.find(post.id)
+    expect(deleted).toBeNull()
+  })
+
+  test('post resource includes coverUrl', async () => {
+    const post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: user.id,
+    })
+
+    const res = await http.get(`/posts/${post.id}`)
+    const text = await res.text()
+
+    // Check that coverUrl is in the Inertia props
+    expect(text).toContain('coverUrl')
+  })
+
+  test('attachment model works', async () => {
+    const attachment = await Attachment.create({
+      path: 'test.png',
+      mimeType: 'image/png',
+    })
+
+    expect(attachment).not.toBeNull()
+    expect(attachment.path).toBe('test.png')
+    expect(attachment.mimeType).toBe('image/png')
+
+    const found = await Attachment.find(attachment.id)
+    expect(found).not.toBeNull()
+    expect(found!.path).toBe('test.png')
+  })
+
+  test('post with cover attachment', async () => {
+    const attachment = await Attachment.create({
+      path: 'cover.png',
+      mimeType: 'image/png',
+    })
+
+    const post = await Post.forceCreate({
+      title: 'Post with Cover',
+      excerpt: 'Cover excerpt',
+      body: 'Cover body',
+      authorId: user.id,
+      coverAttachmentId: attachment.id,
+    })
+
+    const loaded = await Post.findWithOrFail(post.id, 'coverAttachment')
+    expect(loaded.coverAttachmentId).toBe(attachment.id)
+    expect((loaded as any).coverAttachment).not.toBeNull()
+    expect((loaded as any).coverAttachment.path).toBe('cover.png')
+  })
+
+  test('delete post with cover attachment', async () => {
+    const attachment = await Attachment.create({
+      path: 'delete.png',
+      mimeType: 'image/png',
+    })
+
+    const post = await Post.forceCreate({
+      title: 'Post to Delete with Cover',
+      excerpt: 'Delete cover',
+      body: 'Delete body',
+      authorId: user.id,
+      coverAttachmentId: attachment.id,
+    })
+
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.delete(`/posts/${post.id}`)
+
+    await res.assertRedirect()
+
+    const deletedPost = await Post.find(post.id)
+    expect(deletedPost).toBeNull()
+  })
+})
