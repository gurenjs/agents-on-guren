@@ -0,0 +1,20 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects an invalid email on subscribe', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+  })
+
+  it('answers 404 for an unknown confirmation token', async () => {
+    await http.get('/newsletter/confirm/nope').assertNotFound()
+  })
+})
