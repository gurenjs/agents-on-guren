@@ -1,11 +1,17 @@
 import { z } from 'zod'
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_NAME_LENGTH = 30
+
 export const PostIdParamSchema = z.object({
   id: z.coerce.number().int().positive(),
 })
 
 export const ListPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),
+  // Exact match on the tag name: names are case-sensitive, and a name no post
+  // carries simply lists nothing.
+  tag: z.string().optional(),
 })
 
 export const PostSearchSchema = z.object({
@@ -16,10 +22,41 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+/**
+ * The tag names in a `tags` field, as the form sends it: one string of
+ * comma-separated names (an array of names is accepted too). Each name is
+ * trimmed, empty entries (`a,,b`, a trailing comma) are dropped, and a name
+ * listed twice counts once, in first-seen order. Names are case-sensitive.
+ */
+export function parseTagNames(input: string | readonly string[] | undefined): string[] {
+  const entries = input === undefined ? [] : typeof input === 'string' ? input.split(',') : input
+  const names: string[] = []
+  for (const entry of entries) {
+    const name = entry.trim()
+    if (name.length > 0 && !names.includes(name)) {
+      names.push(name)
+    }
+  }
+  return names
+}
+
+// Checked with `refine` rather than transformed, so the field keeps its wire
+// type (what the form types) and the controller parses it with `parseTagNames`.
+// Both refinements are pure: `zod/compile` may run them twice on invalid input.
+const TagsFieldSchema = z
+  .union([z.string(), z.array(z.string())])
+  .optional()
+  .refine((value) => parseTagNames(value).length <= MAX_TAGS_PER_POST, `A post may have at most ${MAX_TAGS_PER_POST} tags.`)
+  .refine(
+    (value) => parseTagNames(value).every((name) => name.length <= MAX_TAG_NAME_LENGTH),
+    `Each tag must be ${MAX_TAG_NAME_LENGTH} characters or fewer.`,
+  )
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: TagsFieldSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
