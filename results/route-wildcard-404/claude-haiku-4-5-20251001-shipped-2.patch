+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns posts for a year', async () => {
+    const res = await http.get('/posts/archive/2026')
+    await res.assertOk()
+    const json = await res.json<{ data: unknown[] }>()
+    if (!Array.isArray(json.data) || json.data.length === 0) {
+      throw new Error('Expected posts to be returned for year 2026')
+    }
+  })
+
+  it('returns posts for a specific month with leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/08')
+    await res.assertOk()
+    const json = await res.json<{ data: unknown[] }>()
+    if (!Array.isArray(json.data) || json.data.length === 0) {
+      throw new Error('Expected posts to be returned for 2026/08')
+    }
+  })
+
+  it('returns posts for a specific month without leading zero', async () => {
+    const res = await http.get('/posts/archive/2026/8')
+    await res.assertOk()
+    const json = await res.json<{ data: unknown[] }>()
+    if (!Array.isArray(json.data) || json.data.length === 0) {
+      throw new Error('Expected posts to be returned for 2026/8')
+    }
+  })
+
+  it('returns empty array for a month with no posts', async () => {
+    const res = await http.get('/posts/archive/2026/01')
+    await res.assertOk()
+    await res.assertJsonPath('data', [])
+  })
+
+  it('returns empty array for a year with no posts', async () => {
+    const res = await http.get('/posts/archive/2025')
+    await res.assertOk()
+    await res.assertJsonPath('data', [])
+  })
+
+  it('rejects an invalid month (13)', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+  })
+
+  it('rejects an invalid month (0)', async () => {
+    await http.get('/posts/archive/2026/0').assertStatus(422)
+  })
+
+  it('rejects an invalid month format', async () => {
+    await http.get('/posts/archive/2026/001').assertStatus(422)
+  })
+
+  it('rejects a path that does not match the pattern', async () => {
+    await http.get('/posts/archive/notayear').assertStatus(422)
+  })
+
+  it('rejects a path with extra segments', async () => {
+    await http.get('/posts/archive/2026/08/01').assertStatus(422)
+  })
+
+  it('returns posts sorted newest first', async () => {
+    const res = await http.get('/posts/archive/2026')
+    await res.assertOk()
+    const json = await res.json<{ data: Array<{ id: number }> }>()
+    const ids = json.data.map((p) => p.id)
+    // Verify that ids are in descending order (newest first)
+    for (let i = 1; i < ids.length; i++) {
+      if (ids[i] >= ids[i - 1]) {
+        throw new Error(`Posts not sorted correctly: ${ids[i]} should be < ${ids[i - 1]}`)
+      }
+    }
+  })
+})
