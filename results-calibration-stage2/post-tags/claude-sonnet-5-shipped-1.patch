+const MAX_TAGS = 5
+const MAX_TAG_LENGTH = 30
+
+export function parseTagNames(raw: string): string[] {
+  const names = raw
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name !== '')
+  return [...new Set(names)]
+}
