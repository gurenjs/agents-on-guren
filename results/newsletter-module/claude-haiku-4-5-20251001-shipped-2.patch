+})
+
+export const ConfirmTokenParamSchema = z.object({
+  token: z.string().trim().min(1),
+})
+
+export type SubscribePayload = z.infer<typeof SubscribeSchema>
+export type UnsubscribePayload = z.infer<typeof UnsubscribeSchema>
