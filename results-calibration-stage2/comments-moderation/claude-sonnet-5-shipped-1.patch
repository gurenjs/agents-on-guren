diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..b66e34f
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,59 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+async function makeUser(name: string) {
+  return User.forceCreate({ name, email: `${name}@example.com`, password: 'secret-pass-1' })
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('sends a guest to login and stores nothing', async () => {
+    const author = await makeUser('ann')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('comments, rejects invalid bodies, reports, hides and deletes', async () => {
+    const [ann, bob, cy, di, ed] = await Promise.all(['ann', 'bob', 'cy', 'di', 'ed'].map(makeUser))
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: ann.id })
+
+    const asBob = await http.actingAs(bob).withCsrf()
+    await asBob.post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect(`/posts/${post.id}`)
+    await asBob.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await asBob.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    const [comment] = await Comment.all()
+    expect(await Comment.all()).toHaveLength(1)
+
+    for (const u of [cy, di, ed]) {
+      const c = await http.actingAs(u).withCsrf()
+      await c.post(`/comments/${comment.id}/report`).assertNoContent()
+      await c.post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+    expect(await CommentReport.all()).toHaveLength(3)
+    const page = await http.get(`/posts/${post.id}`)
+    expect(JSON.stringify(await page.text())).not.toContain('hello')
+    expect(await Comment.all()).toHaveLength(1)
+
+    const asCy = await http.actingAs(cy).withCsrf()
+    await asCy.delete(`/comments/${comment.id}`).assertForbidden()
+    const asAnn = await http.actingAs(ann).withCsrf()
+    await asAnn.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
