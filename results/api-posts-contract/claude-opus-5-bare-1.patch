diff --git a/tests/ApiPostController.test.ts b/tests/ApiPostController.test.ts
new file mode 100644
index 0000000..31d28cd
--- /dev/null
+++ b/tests/ApiPostController.test.ts
@@ -0,0 +1,33 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { routeManifest } from '../.guren/routes.gen.js'
+import app from '../src/app.js'
+
+// `api.posts.index` declares its `page`/`author` contract on the route, so the
+// router answers 422 before PostController.apiIndex runs — which is what lets
+// these cases assert the rejection without migrations or fixtures. The listing
+// itself reads the database; cover it with feature tests once your test
+// database is seeded.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('is registered as a public GET route', () => {
+    expect(routeManifest['api.posts.index']).toEqual({ method: 'GET', path: '/api/posts' })
+  })
+
+  it.each([
+    ['?page=0', 'page'],
+    ['?page=abc', 'page'],
+    ['?author=abc', 'author'],
+    ['?author=0', 'author'],
+  ])('rejects %s', async (queryString, field) => {
+    const response = await http.get(`/api/posts${queryString}`).assertStatus(422)
+
+    expect(response.headers.get('content-type')).toContain('application/json')
+    expect((await response.json()).errors).toHaveProperty(field)
+  })
+})
