diff --git a/app/Services/AttachmentService.ts b/app/Services/AttachmentService.ts
new file mode 100644
index 0000000..f2efbfe
--- /dev/null
+++ b/app/Services/AttachmentService.ts
@@ -0,0 +1,78 @@
+import { mkdir } from 'node:fs/promises'
+import { randomUUID } from 'node:crypto'
+import { eq } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+import { attachments as attachmentsTable } from '../../db/schema.js'
+
+const STORAGE_DIR = 'storage/attachments'
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024 // 2MB
+
+export type AttachmentData = typeof attachmentsTable.$inferSelect
+
+export class AttachmentService {
+  async validateAndStoreFile(file: File): Promise<{ path: string; mimeType: string; size: number } | null> {
+    // Validate file type
+    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
+      return null
+    }
+
+    // Validate file size
+    if (file.size > MAX_FILE_SIZE) {
+      return null
+    }
+
+    // Generate unique filename
+    const ext = file.type === 'image/png' ? 'png' : 'jpeg'
+    const filename = `${randomUUID()}.${ext}`
+    const filePath = `${STORAGE_DIR}/${filename}`
+
+    // Ensure storage directory exists
+    await mkdir(STORAGE_DIR, { recursive: true })
+
+    // Write file to disk
+    await Bun.write(filePath, file)
+
+    return {
+      path: filePath,
+      mimeType: file.type,
+      size: file.size,
+    }
+  }
+
+  async createAttachment(file: File): Promise<AttachmentData | null> {
+    const fileData = await this.validateAndStoreFile(file)
+    if (!fileData) {
+      return null
+    }
+
+    const db = (await getDatabase()) as SQLiteBunDatabase
+    const result = await db.insert(attachmentsTable).values(fileData).returning()
+    return result[0] || null
+  }
+
+  async deleteAttachment(attachmentId: number): Promise<void> {
+    const db = (await getDatabase()) as SQLiteBunDatabase
+    const attachment = await db.select().from(attachmentsTable).where(eq(attachmentsTable.id, attachmentId)).limit(1)
+
+    if (attachment.length > 0) {
+      const att = attachment[0]
+      try {
+        await Bun.file(att.path).delete()
+      } catch {
+        // File might not exist, but that's ok
+      }
+
+      await db.delete(attachmentsTable).where(eq(attachmentsTable.id, attachmentId))
+    }
+  }
+
+  async getAttachment(attachmentId: number): Promise<AttachmentData | null> {
+    const db = (await getDatabase()) as SQLiteBunDatabase
+    const result = await db.select().from(attachmentsTable).where(eq(attachmentsTable.id, attachmentId)).limit(1)
+    return result[0] || null
+  }
+}
+
+export const attachmentService = new AttachmentService()
