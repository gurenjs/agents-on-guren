+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/ApiPostController.js'
+import BearerTokenAuth from '../app/Http/Middleware/BearerTokenAuth.js'
+import RateLimit from '../app/Http/Middleware/RateLimit.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+export function registerApiRoutes(router: Router): void {
+  router.group('/api', (api) => {
+    api.middleware(BearerTokenAuth, RateLimit).group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}
