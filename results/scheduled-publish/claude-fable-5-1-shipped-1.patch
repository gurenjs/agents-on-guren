--- /dev/null
+++ b/resources/js/components/ScheduledNotice.tsx
@@ -0,0 +1,22 @@
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+
+interface Props {
+  post: Pick<PostResourceData, 'scheduled' | 'publishedAt'>
+  className?: string
+}
+
+export default function ScheduledNotice({ post, className = '' }: Props) {
+  if (!post.scheduled || !post.publishedAt) {
+    return null
+  }
+
+  return (
+    <p className={`text-sm text-g-accent-text ${className}`}>
+      Scheduled — only you can see this until{' '}
+      {/* Formatted in the viewer's time zone, which the server render cannot know. */}
+      <time dateTime={post.publishedAt} suppressHydrationWarning>
+        {new Date(post.publishedAt).toLocaleString()}
+      </time>
+    </p>
+  )
+}
