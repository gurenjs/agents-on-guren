+}
+
+// `datetime-local` reads and writes wall-clock time in the browser's zone,
+// with no offset. The server only accepts an instant, so convert both ways.
+function toLocalInput(iso: string): string {
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) {
+    return ''
+  }
+  const shifted = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
+  return shifted.toISOString().slice(0, 16)
+}
+
+function toInstant(local: string): string | null {
+  const date = new Date(local)
+  return Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  // Filled in after mount: the server renders in its own zone, and a value
+  // rendered there would not match the one the browser hydrates with.
+  const [local, setLocal] = useState('')
+
+  useEffect(() => {
+    setLocal(value === null ? '' : toLocalInput(value))
+  }, [value])
+
+  return (
+    <div>
+      <label htmlFor="publishAt" className="block text-sm font-bold text-g-heading">
+        Publish at
+      </label>
+      <input
+        id="publishAt"
+        type="datetime-local"
+        value={local}
+        onChange={(event) => {
+          setLocal(event.target.value)
+          onChange(event.target.value === '' ? null : toInstant(event.target.value))
+        }}
+        className={className}
+      />
+      <p className="mt-1 text-sm text-g-muted">
+        Optional, in your local time. Leave empty to publish as soon as you save. Until then, only you can see the post.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
