     .array(z.string().trim().min(1, 'Keywords must not be blank.'))
@@ -16,10 +12,43 @@ export const PostSearchSchema = z.object({
   limit: z.number().int().min(1).max(50).default(10),
 })
 
+export const MAX_TAGS_PER_POST = 5
+export const MAX_TAG_LENGTH = 30
+
+export const ListPostsQuerySchema = z.object({
+  page: z.coerce.number().int().min(1).default(1),
+  tag: z.string().optional(),
+})
+
+/**
+ * The form sends tags as one comma-separated string: names are trimmed, blank
+ * entries dropped and duplicates collapsed (case-sensitively).
+ */
+export function parseTagNames(value: string | undefined): string[] {
+  return [...new Set((value ?? '').split(',').map((name) => name.trim()).filter((name) => name.length > 0))]
+}
+
+// Refined rather than transformed, so the body type codegen derives stays the
+// string the form sends; every issue lands on `tags` itself, not an index.
+export const TagListSchema = z
+  .string()
+  .optional()
+  .superRefine((value, ctx) => {
+    const names = parseTagNames(value)
+
+    if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+    }
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: 'custom', message: `A post can have at most ${MAX_TAGS_PER_POST} tags.` })
+    }
+  })
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  tags: TagListSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
