@@ -0,0 +1,45 @@
+import { Controller } from '@guren/core'
+import { CreateTokenSchema, TokenIdParamSchema } from '../Validators/TokenValidator.js'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { TokenService } from '../../Services/TokenService.js'
+import type { UserRecord } from '../../Models/User.js'
+
+export default class TokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateTokenSchema)
+
+    const plainToken = TokenService.generateToken()
+    const tokenHash = TokenService.hashToken(plainToken)
+
+    const token = await ApiToken.create({
+      userId: user.id,
+      name,
+      tokenHash,
+    })
+
+    return this.json(
+      {
+        id: token.id,
+        name: token.name,
+        token: plainToken,
+      },
+      { status: 201 }
+    )
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = await this.validateParams(TokenIdParamSchema)
+
+    const token = await ApiToken.findOrFail(id)
+
+    if (token.userId !== user.id) {
+      return this.json({ message: 'Not found' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id })
+
+    return new Response(null, { status: 204 })
+  }
+}
