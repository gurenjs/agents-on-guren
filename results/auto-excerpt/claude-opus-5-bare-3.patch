diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..da69b6a
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,25 @@
+// Longest excerpt derived from a body, in `String.length` units.
+const EXCERPT_LENGTH = 140
+
+/**
+ * Builds an excerpt from a post body, for writers who leave the field blank.
+ *
+ * A body of `EXCERPT_LENGTH` characters or fewer is the excerpt as it stands.
+ * A longer one is cut at `EXCERPT_LENGTH`, backing up to the last whitespace
+ * when that cut would land inside a word, and gains a single `…`.
+ */
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+  let kept = trimmed.slice(0, EXCERPT_LENGTH)
+  const splitsAWord = !/\s/.test(kept[kept.length - 1] ?? '') && !/\s/.test(trimmed[EXCERPT_LENGTH] ?? '')
+  if (splitsAWord) {
+    // Index of the last whitespace in the kept part; -1 when the whole of it
+    // is one unbroken run, which is then cut at EXCERPT_LENGTH as it is.
+    const lastSpace = kept.search(/\s\S*$/)
+    if (lastSpace !== -1) kept = kept.slice(0, lastSpace)
+  }
+
+  return `${kept.replace(/\s+$/, '')}…`
+}
