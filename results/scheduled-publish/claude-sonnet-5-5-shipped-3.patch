@@ -0,0 +1,19 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { isScheduled } from '../../Models/Post.js'
+
+export default class ScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts scheduled for later, soonest first (id, title, published_at; tab-separated)'
+
+  async handle(): Promise<void> {
+    const now = new Date()
+    const scheduled = (await Post.whereNotNull('publishedAt').get())
+      .filter((post) => isScheduled(post, now))
+      .sort((a, b) => new Date(a.publishedAt!).getTime() - new Date(b.publishedAt!).getTime() || a.id - b.id)
+
+    for (const post of scheduled) {
+      process.stdout.write(`${post.id}\t${post.title.replace(/[\t\r\n]+/g, ' ')}\t${post.publishedAt}\n`)
+    }
+  }
+}
