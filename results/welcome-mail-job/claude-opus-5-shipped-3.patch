+import { ServiceProvider, setMailManager } from '@guren/core'
+import { createAppMailManager } from '../../config/mail.js'
+
+/**
+ * Binds the mailer configured by `MAIL_MAILER` (see config/mail.ts).
+ *
+ * The same manager is also installed globally: queued mail runs outside the
+ * request lifecycle, where there is no context to resolve services from.
+ */
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('mail', () => createAppMailManager())
+  }
+
+  boot(): void {
+    setMailManager(this.container.make('mail'))
+  }
+}
