+
+  it('adds a cover on edit to a post that had none', async () => {
+    const bytes = png()
+    const postId = await createPost()
+
+    await http.put(`/posts/${postId}`, postForm({ cover: pngCover(bytes) })).assertRedirect(`/posts/${postId}`)
+
+    const response = await http.get(await coverUrlOf(postId)).assertOk()
