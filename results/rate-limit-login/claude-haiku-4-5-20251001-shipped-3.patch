diff --git a/tests/controllers/LoginController.test.ts b/tests/controllers/LoginController.test.ts
new file mode 100644
index 0000000..ba27084
--- /dev/null
+++ b/tests/controllers/LoginController.test.ts
@@ -0,0 +1,155 @@
+import { describe, test, expect, beforeAll, beforeEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { User } from '../../app/Models/User.js'
+import { resetDatabase } from '../../config/database.js'
+import { attempts } from '../../app/Http/Middleware/ThrottleLoginAttempts.js'
+
+describe('LoginController', () => {
+  let http: TestApp
+  let testUser: User
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    attempts.clear()
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+  })
+
+  test('show renders login page', async () => {
+    const res = await http.get('/login')
+    expect(res.status).toEqual(200)
+  })
+
+  test('store with valid credentials logs in', async () => {
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/login', {
+        email: 'test@example.com',
+        password: 'password123',
+        remember: false,
+      })
+      .assertRedirect('/dashboard')
+  })
+
+  test('store with invalid credentials returns error', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'wrongpassword',
+      remember: false,
+    })
+
+    expect(res.status).toEqual(422)
+  })
+
+  test('rate limiting allows 5 attempts within window', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let i = 0; i < 5; i++) {
+      const res = await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrongpassword',
+        remember: false,
+      })
+
+      // Should not be throttled yet (attempts 1-5)
+      expect(res.status).not.toEqual(429)
+    }
+  })
+
+  test('rate limiting blocks 6th attempt', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrongpassword',
+        remember: false,
+      })
+    }
+
+    const res = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'wrongpassword',
+      remember: false,
+    })
+
+    expect(res.status).toEqual(429)
+  })
+
+  test('rate limiting includes Retry-After header', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrongpassword',
+        remember: false,
+      })
+    }
+
+    const res = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'wrongpassword',
+      remember: false,
+    })
+
+    expect(res.status).toEqual(429)
+    expect(res.headers.get('Retry-After')).toBeTruthy()
+  })
+
+  test('rate limiting does not affect GET /login', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let i = 0; i < 6; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrongpassword',
+        remember: false,
+      })
+    }
+
+    // GET /login should still work despite POST being throttled
+    const res = await http.get('/login')
+    expect(res.status).toEqual(200)
+  })
+
+  test('successful login still counts towards rate limit', async () => {
+    const csrf = await http.withCsrf()
+
+    // Make 4 failed attempts
+    for (let i = 0; i < 4; i++) {
+      await csrf.post('/login', {
+        email: 'test@example.com',
+        password: 'wrongpassword',
+        remember: false,
+      })
+    }
+
+    // 5th attempt with correct password - should succeed
+    const res5 = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'password123',
+      remember: false,
+    })
+
+    expect([302, 303]).toContain(res5.status)
+
+    // 6th attempt should be throttled
+    const res6 = await csrf.post('/login', {
+      email: 'test@example.com',
+      password: 'password123',
+      remember: false,
+    })
+
+    expect(res6.status).toEqual(429)
+  })
+})
