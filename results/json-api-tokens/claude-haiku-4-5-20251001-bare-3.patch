@@ -0,0 +1,25 @@
+import { ApiToken } from '../Models/ApiToken.js'
+import { User } from '../Models/User.js'
+import { ApiTokenService } from './ApiTokenService.js'
+import type { UserRecord } from '../Models/User.js'
+
+export class BearerTokenService {
+  static async authenticateFromBearerToken(token: string | undefined): Promise<UserRecord | null> {
+    if (!token) {
+      return null
+    }
+
+    const apiToken = await ApiToken.newQuery()
+      .with('user')
+      .get()
+
+    for (const record of apiToken) {
+      if (ApiTokenService.verifyToken(token, record.tokenHash)) {
+        const user = await User.find(record.userId)
+        return user ?? null
+      }
+    }
+
+    return null
+  }
+}
