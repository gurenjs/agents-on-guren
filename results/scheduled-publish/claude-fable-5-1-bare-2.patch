+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List the posts waiting for their publish time, soonest first'
+
+  // Stdout is the report and nothing else — one `<id>\t<title>\t<published_at>`
+  // line per post, no header, no summary — so it can be piped into other tools.
+  async handle(): Promise<void> {
+    const posts = await Post.scope('scheduled').orderBy('publishedAt', 'asc').orderBy('id', 'asc').get()
+
+    for (const post of posts) {
+      // A tab or line break inside a title would read as a field or record
+      // separator downstream.
+      const title = post.title.replace(/[\t\r\n]+/g, ' ')
+      this.line(`${post.id}\t${title}\t${post.publishedAt}`)
+    }
+  }
+}
