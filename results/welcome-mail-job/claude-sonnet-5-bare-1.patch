+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,28 @@
+import { Job, getMailManager } from '@guren/core'
+import { User } from '../Models/User.js'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailJobPayload {
+  userId: number
+}
+
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ userId }: SendWelcomeEmailJobPayload): Promise<void> {
+    const user = await User.find(userId)
+    if (!user) return
+
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured. Call setMailManager() before dispatching SendWelcomeEmailJob.')
+    }
+
+    await new WelcomeMail(manager, { name: user.name }).to(user.email).send()
+  }
+
+  async failed(payload: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for user ${payload.userId}:`, error.message)
+  }
+}
