+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import type { PaginatedPageProps } from '@guren/core'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +25,71 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// The list is newest first, ten to a page. `?page=1` (and no `page` at all)
+// must start at the newest post — an off-by-one in the page number silently
+// hides a whole page of posts from every page of the list.
+describe('posts.index pagination', () => {
+  let http: TestApp
+
+  async function props(path: string): Promise<PaginatedPageProps<PostResourceData>> {
+    const response = await http.withHeaders({ 'X-Inertia': 'true' }).get(path).assertOk()
+    const page = await response.json<{ props: PaginatedPageProps<PostResourceData> }>()
+
+    return page.props
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    const author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret123' })
+    for (let n = 1; n <= 25; n += 1) {
+      await Post.forceCreate({
+        title: `Post ${n}`,
+        excerpt: `Excerpt ${n}`,
+        body: `Body ${n}`,
+        authorId: author!.id,
+      })
+    }
+  })
+
+  it('starts at the newest post on the first page', async () => {
+    const first = await props('/posts')
+
+    expect(first.data.map((post) => post.title)).toEqual([
+      'Post 25',
+      'Post 24',
+      'Post 23',
+      'Post 22',
+      'Post 21',
+      'Post 20',
+      'Post 19',
+      'Post 18',
+      'Post 17',
+      'Post 16',
+    ])
+    expect(first.pagination.meta).toMatchObject({ currentPage: 1, lastPage: 3, total: 25, from: 1, to: 10 })
+    expect(first.pagination.links.prev).toBeNull()
+  })
+
+  it('treats ?page=1 the same as no page at all', async () => {
+    const [implicit, explicit] = await Promise.all([props('/posts'), props('/posts?page=1')])
+
+    expect(explicit.data.map((post) => post.id)).toEqual(implicit.data.map((post) => post.id))
+    expect(explicit.pagination.meta.currentPage).toBe(1)
+  })
+
+  it('walks every post exactly once across the pages', async () => {
+    const seen: number[] = []
+    for (const page of [1, 2, 3]) {
+      const { data, pagination } = await props(`/posts?page=${page}`)
+      expect(pagination.meta.currentPage).toBe(page)
+      seen.push(...data.map((post) => post.id))
+    }
+
+    expect(seen).toHaveLength(25)
+    expect(new Set(seen).size).toBe(25)
+    expect(seen[0]).toBeGreaterThan(seen[24]!)
+  })
+})
