diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..3f66abe
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,287 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import PostsScheduledCommand from '../app/Console/Commands/PostsScheduledCommand.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Runs against the test database (config/database.ts switches to it under
+// NODE_ENV=test), which other suites and tools share. Every row is created
+// under a unique tag and removed afterwards, and assertions look for these
+// rows only — never at totals.
+const TAG = `sched-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+const FUTURE = '2999-01-01T09:00:00.000Z'
+const LATER = '2999-06-01T09:00:00.000Z'
+const PAST = '2001-01-01T09:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let guest: TestApp
+  let asAuthor: TestApp
+  let asOther: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+  let live: PostRecord
+  let undated: PostRecord
+
+  async function makeUser(name: string): Promise<UserRecord> {
+    const user = await User.create({ name, email: `${name}-${TAG}@example.com`, password: 'secret-secret' })
+    return user as UserRecord
+  }
+
+  async function makePost(title: string, publishedAt: string | null, authorId = author.id): Promise<PostRecord> {
+    const post = await Post.forceCreate({ title: `${title} ${TAG}`, excerpt: 'Excerpt', body: 'Body', authorId, publishedAt })
+    return post as PostRecord
+  }
+
+  async function pageProps<T>(http: TestApp, path: string): Promise<T> {
+    const response = await http.get(path).assertOk()
+    const { payload } = await readInertiaResponse(response.raw)
+    return payload.props as T
+  }
+
+  async function listedIds(http: TestApp): Promise<number[]> {
+    // Newest first, ten a page: rows this suite just created are on page 1
+    // unless something else is writing a lot at the same moment.
+    const props = await pageProps<{ data: PostResourceData[] }>(http, '/posts')
+    return props.data.map((post) => post.id)
+  }
+
+  async function searchIds(http: TestApp): Promise<number[]> {
+    const response = await http.query('/posts/search', { keywords: [TAG], limit: 50 }).assertOk()
+    const body = await response.json<{ data: PostResourceData[] }>()
+    return body.data.map((post) => post.id)
+  }
+
+  beforeAll(async () => {
+    const http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    author = await makeUser('author')
+    other = await makeUser('other')
+    guest = await http.withCsrf('/health')
+    asAuthor = await http.actingAs(author).withCsrf('/health')
+    asOther = await http.actingAs(other).withCsrf('/health')
+
+    undated = await makePost('Undated', null)
+    live = await makePost('Live', PAST)
+    scheduled = await makePost('Scheduled', FUTURE)
+  })
+
+  afterAll(async () => {
+    await Post.newQuery().whereIn('authorId', [author.id, other.id]).delete()
+    await User.newQuery().whereIn('id', [author.id, other.id]).delete()
+  })
+
+  describe('the post page', () => {
+    it('does not exist for a guest', async () => {
+      await guest.get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('does not exist for another signed-in user', async () => {
+      await asOther.get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('opens for its author, with the date it goes live', async () => {
+      const { post } = await pageProps<{ post: PostResourceData }>(asAuthor, `/posts/${scheduled.id}`)
+
+      expect(post.id).toBe(scheduled.id)
+      expect(post.publishedAt).toBe(FUTURE)
+      expect(post.scheduled).toBe(true)
+    })
+
+    it('opens for everyone once the date has passed or when there is none', async () => {
+      await guest.get(`/posts/${live.id}`).assertOk()
+      await asOther.get(`/posts/${live.id}`).assertOk()
+      await guest.get(`/posts/${undated.id}`).assertOk()
+
+      const { post } = await pageProps<{ post: PostResourceData }>(guest, `/posts/${live.id}`)
+      expect(post.scheduled).toBe(false)
+    })
+
+    it('hides the edit, update and delete routes from another user too', async () => {
+      const payload = { title: 'Hijacked', excerpt: 'Excerpt', body: 'Body' }
+
+      await asOther.get(`/posts/${scheduled.id}/edit`).assertNotFound()
+      await asOther.put(`/posts/${scheduled.id}`, payload).assertNotFound()
+      await asOther.delete(`/posts/${scheduled.id}`).assertNotFound()
+      // A public post still answers 403: there is nothing left to hide.
+      await asOther.get(`/posts/${live.id}/edit`).assertForbidden()
+
+      expect((await Post.find(scheduled.id))?.title).toBe(scheduled.title)
+    })
+  })
+
+  describe('the posts list', () => {
+    it('leaves a scheduled post out for guests and other users', async () => {
+      for (const http of [guest, asOther]) {
+        const ids = await listedIds(http)
+
+        expect(ids).not.toContain(scheduled.id)
+        expect(ids).toContain(live.id)
+        expect(ids).toContain(undated.id)
+      }
+    })
+
+    it('keeps it in for its author', async () => {
+      const props = await pageProps<{ data: PostResourceData[] }>(asAuthor, '/posts')
+      const listed = props.data.find((post) => post.id === scheduled.id)
+
+      expect(listed?.publishedAt).toBe(FUTURE)
+      expect(listed?.scheduled).toBe(true)
+    })
+  })
+
+  describe('search', () => {
+    it('leaves a scheduled post out for guests and other users', async () => {
+      for (const http of [guest, asOther]) {
+        const ids = await searchIds(http)
+
+        expect(ids).not.toContain(scheduled.id)
+        expect(ids).toContain(live.id)
+        expect(ids).toContain(undated.id)
+      }
+    })
+
+    it('finds it for its author', async () => {
+      expect(await searchIds(asAuthor)).toContain(scheduled.id)
+    })
+  })
+
+  describe('the home page', () => {
+    it('never shows a scheduled post, even to its author', async () => {
+      const props = await pageProps<{ latest: PostResourceData[] }>(asAuthor, '/')
+
+      expect(props.latest.map((post) => post.id)).not.toContain(scheduled.id)
+    })
+  })
+
+  describe('time passing', () => {
+    it('makes the post public with nothing else run', async () => {
+      const post = await makePost('Turning', FUTURE)
+      await guest.get(`/posts/${post.id}`).assertNotFound()
+
+      await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+      await guest.get(`/posts/${post.id}`).assertOk()
+      await asOther.get(`/posts/${post.id}`).assertOk()
+      expect(await listedIds(guest)).toContain(post.id)
+      expect(await searchIds(guest)).toContain(post.id)
+
+      await Post.delete({ id: post.id })
+    })
+  })
+
+  describe('the publishAt field', () => {
+    const payload = { title: `Form ${TAG}`, excerpt: 'Excerpt', body: 'Body' }
+
+    async function latestByAuthor(): Promise<PostRecord | null> {
+      return Post.where('authorId', author.id).orderBy('id', 'desc').first()
+    }
+
+    it('schedules a new post', async () => {
+      await asAuthor.post('/posts', { ...payload, publishAt: FUTURE }).assertRedirect()
+
+      const created = await latestByAuthor()
+      expect(created?.title).toBe(payload.title)
+      expect(created?.publishedAt).toBe(FUTURE)
+      await guest.get(`/posts/${created?.id}`).assertNotFound()
+    })
+
+    it('stores any offset as the same instant in UTC', async () => {
+      await asAuthor.post('/posts', { ...payload, publishAt: '2999-01-01T18:00:00+09:00' }).assertRedirect()
+
+      expect((await latestByAuthor())?.publishedAt).toBe(FUTURE)
+    })
+
+    it('publishes at once when it is absent or null', async () => {
+      await asAuthor.post('/posts', payload).assertRedirect()
+      const absent = await latestByAuthor()
+      await asAuthor.post('/posts', { ...payload, publishAt: null }).assertRedirect()
+      const empty = await latestByAuthor()
+
+      expect(absent?.publishedAt).toBeNull()
+      expect(empty?.publishedAt).toBeNull()
+      expect(empty?.id).not.toBe(absent?.id)
+      await guest.get(`/posts/${empty?.id}`).assertOk()
+    })
+
+    it('rejects a value that is not a date and time, the way an empty title is', async () => {
+      const before = await Post.where('authorId', author.id).count()
+
+      const emptyTitle = await asAuthor.post('/posts', { ...payload, title: '' })
+      const badDate = await asAuthor.post('/posts', { ...payload, publishAt: 'next tuesday' })
+      const noZone = await asAuthor.post('/posts', { ...payload, publishAt: '2999-01-01T09:00' })
+
+      expect(badDate.status).toBe(emptyTitle.status)
+      expect(noZone.status).toBe(emptyTitle.status)
+      expect(badDate.status).toBeGreaterThanOrEqual(400)
+      expect(await Post.where('authorId', author.id).count()).toBe(before)
+    })
+
+    it('sets, changes and clears the date on edit', async () => {
+      const post = await makePost('Edited', null)
+      const body = { title: post.title, excerpt: post.excerpt, body: post.body }
+
+      await asAuthor.put(`/posts/${post.id}`, { ...body, publishAt: FUTURE }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBe(FUTURE)
+      await guest.get(`/posts/${post.id}`).assertNotFound()
+
+      await asAuthor.put(`/posts/${post.id}`, { ...body, publishAt: LATER }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBe(LATER)
+
+      await asAuthor.put(`/posts/${post.id}`, { ...body, publishAt: null }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBeNull()
+      await guest.get(`/posts/${post.id}`).assertOk()
+    })
+
+    it('saves nothing when the date on an edit is not one', async () => {
+      const response = await asAuthor.put(`/posts/${scheduled.id}`, {
+        title: 'Changed',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        publishAt: 'next tuesday',
+      })
+
+      expect(response.status).toBeGreaterThanOrEqual(400)
+      const stored = await Post.find(scheduled.id)
+      expect(stored?.title).toBe(scheduled.title)
+      expect(stored?.publishedAt).toBe(FUTURE)
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    async function report(): Promise<string[]> {
+      const output = new BufferedOutput()
+      const command = new PostsScheduledCommand(app.container)
+      command.setInput([])
+      command.setOutput(output)
+
+      expect(await command.run()).toBe(0)
+      return output.getLines()
+    }
+
+    it('prints scheduled posts only, soonest first, tab-separated', async () => {
+      const sooner = await makePost('Sooner', '2998-01-01T09:00:00.000Z', other.id)
+      const mine = (await report()).filter((line) => line.includes(TAG))
+      const own = mine.filter((line) => [`${sooner.id}`, `${scheduled.id}`].includes(line.split('\t')[0] ?? ''))
+
+      expect(own).toEqual([
+        `${sooner.id}\t${sooner.title}\t2998-01-01T09:00:00.000Z`,
+        `${scheduled.id}\t${scheduled.title}\t${FUTURE}`,
+      ])
+      for (const post of [live, undated]) {
+        expect(mine.some((line) => line.startsWith(`${post.id}\t`))).toBe(false)
+      }
+    })
+
+    it('prints nothing but rows', async () => {
+      for (const line of await report()) {
+        expect(line).toMatch(/^\d+\t[^\t\n]*\t[^\t\n]+$/)
+      }
+    })
+  })
+})
