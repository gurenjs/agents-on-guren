@@ -0,0 +1,164 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { API_RATE_LIMIT } from '../routes/api.js'
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+async function createUser(label: string): Promise<UserRecord> {
+  const stamp = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+  return (await User.create({
+    name: `${label} ${stamp}`,
+    email: `${label}-${stamp}@example.com`,
+    password: 'secret-password',
+  })) as UserRecord
+}
+
+async function issueToken(http: TestApp, user: UserRecord, name: string): Promise<string> {
+  const session = (await http.actingAs(user).withCsrf('/profile')).json()
+  const response = await session.post('/profile/tokens', { name }).assertCreated()
+  const { token } = await response.json<{ token: string }>()
+  return token
+}
+
+function bearer(http: TestApp, token: string): TestApp {
+  return http.json().withHeader('Authorization', `Bearer ${token}`)
+}
+
+describe('posts API', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let token: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await createUser('api-owner')
+    token = await issueToken(http, owner, 'CI')
+  })
+
+  it('lists every author’s posts, newest first', async () => {
+    const otherAuthor = await createUser('api-other')
+    const stamp = Date.now()
+    const older = await Post.forceCreate({
+      title: `Older ${stamp}`,
+      excerpt: 'older',
+      body: 'older body',
+      authorId: otherAuthor.id,
+      createdAt: new Date(Date.now() - 60_000).toISOString(),
+    })
+    const newer = await Post.forceCreate({
+      title: `Newer ${stamp}`,
+      excerpt: 'newer',
+      body: 'newer body',
+      authorId: owner.id,
+    })
+
+    const response = await bearer(http, token).get('/api/posts').assertOk()
+    const { data } = await response.json<{ data: ApiPost[] }>()
+
+    const ids = data.map((post) => post.id)
+    expect(ids).toContain(older!.id)
+    expect(ids).toContain(newer!.id)
+    expect(ids.indexOf(newer!.id)).toBeLessThan(ids.indexOf(older!.id))
+
+    const first = data[0]
+    expect(typeof first.id).toBe('number')
+    expect(typeof first.title).toBe('string')
+    expect(typeof first.excerpt).toBe('string')
+    expect(typeof first.authorId).toBe('number')
+    expect(new Date(first.createdAt).toISOString()).toBe(first.createdAt)
+
+    const listedOther = data.find((post) => post.id === older!.id)
+    expect(listedOther?.authorId).toBe(otherAuthor.id)
+  })
+
+  it('creates a post owned by the token holder, ignoring authorId in the body', async () => {
+    const someoneElse = await createUser('api-victim')
+    const title = `Release notes ${Date.now()}`
+
+    const response = await bearer(http, token)
+      .post('/api/posts', { title, excerpt: 'From CI', body: 'Shipped.', authorId: someoneElse.id })
+      .assertCreated()
+    const { data } = await response.json<{ data: ApiPost }>()
+
+    expect(data.title).toBe(title)
+    expect(data.excerpt).toBe('From CI')
+    expect(data.authorId).toBe(owner.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const stored = await Post.find(data.id)
+    expect(stored?.authorId).toBe(owner.id)
+    expect(stored?.body).toBe('Shipped.')
+  })
+
+  it('rejects input the web form would reject with a JSON 422 and creates nothing', async () => {
+    const before = (await Post.where({ authorId: owner.id })).length
+
+    const emptyTitle = await bearer(http, token)
+      .post('/api/posts', { title: '', excerpt: 'x', body: 'y' })
+      .assertStatus(422)
+    expect(emptyTitle.headers.get('content-type')).toContain('application/json')
+    const payload = await emptyTitle.json<{ errors?: Record<string, unknown> }>()
+    expect(payload.errors).toBeDefined()
+
+    await bearer(http, token).post('/api/posts', { title: 'No body', excerpt: 'x' }).assertStatus(422)
+
+    expect((await Post.where({ authorId: owner.id })).length).toBe(before)
+  })
+
+  it('answers 401 with JSON for a missing, malformed, unknown, tampered or revoked token', async () => {
+    const before = (await Post.where({ authorId: owner.id })).length
+    const body = { title: 'Sneaky', excerpt: 'x', body: 'y' }
+
+    const missing = await http.json().get('/api/posts').assertStatus(401)
+    expect(missing.headers.get('content-type')).toContain('application/json')
+
+    await http.json().withHeader('Authorization', 'Basic abc').get('/api/posts').assertStatus(401)
+    await bearer(http, 'not-a-token').get('/api/posts').assertStatus(401)
+    await bearer(http, 'not-a-token').post('/api/posts', body).assertStatus(401)
+
+    const unknown = `${'0'.repeat(32)}|${'a'.repeat(64)}`
+    await bearer(http, unknown).get('/api/posts').assertStatus(401)
+    await bearer(http, unknown).post('/api/posts', body).assertStatus(401)
+
+    const flipped = token.endsWith('a') ? 'b' : 'a'
+    const tampered = token.slice(0, -1) + flipped
+    await bearer(http, tampered).get('/api/posts').assertStatus(401)
+    await bearer(http, tampered).post('/api/posts', body).assertStatus(401)
+
+    const disposable = await issueToken(http, owner, 'disposable')
+    const [disposableId] = disposable.split('|')
+    const session = (await http.actingAs(owner).withCsrf('/profile')).json()
+    await session.delete(`/profile/tokens/${disposableId}`).assertNoContent()
+    const revoked = await bearer(http, disposable).post('/api/posts', body).assertStatus(401)
+    expect(revoked.headers.get('content-type')).toContain('application/json')
+
+    expect((await Post.where({ authorId: owner.id })).length).toBe(before)
+  })
+
+  it('limits each token to 60 requests a minute, independently of the owner’s other tokens', async () => {
+    const user = await createUser('api-throttled')
+    const busy = await issueToken(http, user, 'busy')
+    const spare = await issueToken(http, user, 'spare')
+
+    for (let i = 0; i < API_RATE_LIMIT; i += 1) {
+      await bearer(http, busy).get('/api/posts').assertOk()
+    }
+
+    const limited = await bearer(http, busy).get('/api/posts').assertStatus(429)
+    const retryAfter = Number(limited.headers.get('retry-after'))
+    expect(Number.isInteger(retryAfter)).toBe(true)
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(http, spare).get('/api/posts').assertOk()
+  })
+})
