+import type { Router } from '@guren/core'
+import SubscriptionController from './app/Http/Controllers/SubscriptionController.js'
+import { ConfirmParamsSchema, SubscribeSchema, UnsubscribeSchema } from './app/Http/Validators/SubscriptionValidator.js'
+
+// Mounted under the module's prefix (`/newsletter`, see index.ts). Open to
+// guests and signed-in visitors alike, so no auth middleware.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [SubscriptionController, 'subscribe'])
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [SubscriptionController, 'unsubscribe'])
+
+  // A GET that writes, because it is followed from an email link. Confirming
+  // is idempotent and the token is the authorization.
+  router.get('/confirm/:token', { name: 'newsletter.confirm', params: ConfirmParamsSchema }, [SubscriptionController, 'confirm'])
+}
