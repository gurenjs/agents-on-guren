index 0000000..f33ce5e
--- /dev/null
+++ b/tests/i18n.test.ts
@@ -0,0 +1,61 @@
+import { readdir, readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { describe, expect, it } from 'bun:test'
+
+type Messages = { [key: string]: string | Messages }
+
+const LANG_DIR = join(import.meta.dir, '..', 'lang')
+const PLACEHOLDER = /:[a-zA-Z_][a-zA-Z0-9_]*|\{[a-zA-Z_][a-zA-Z0-9_]*\}/g
+
+async function catalog(locale: string): Promise<Record<string, string>> {
+  const flat: Record<string, string> = {}
+
+  const walk = (messages: Messages, prefix: string) => {
+    for (const [key, value] of Object.entries(messages)) {
+      const path = prefix ? `${prefix}.${key}` : key
+      if (typeof value === 'string') {
+        flat[path] = value
+      } else {
+        walk(value, path)
+      }
+    }
+  }
+
+  const dir = join(LANG_DIR, locale)
+  for (const file of await readdir(dir)) {
+    if (!file.endsWith('.json')) continue
+    walk(JSON.parse(await readFile(join(dir, file), 'utf-8')) as Messages, file.replace(/\.json$/, ''))
+  }
+
+  return flat
+}
+
+// A key translated on one side only makes a page fall back to English for a
+// single label, which is worse than no translation at all — so the two
+// catalogs are checked against each other rather than against a fixed list.
+describe('translation catalogs', () => {
+  it('ships the same keys in every locale', async () => {
+    const [en, ja] = await Promise.all([catalog('en'), catalog('ja')])
+
+    expect(Object.keys(ja).sort()).toEqual(Object.keys(en).sort())
+  })
+
+  it('keeps every placeholder of the English string in its translation', async () => {
+    const [en, ja] = await Promise.all([catalog('en'), catalog('ja')])
+
+    for (const [key, english] of Object.entries(en)) {
+      expect([key, (ja[key] ?? '').match(PLACEHOLDER)?.sort() ?? []]).toEqual([
+        key,
+        english.match(PLACEHOLDER)?.sort() ?? [],
+      ])
+    }
+  })
+
+  it('translates every English string', async () => {
+    const [en, ja] = await Promise.all([catalog('en'), catalog('ja')])
+
+    for (const [key, english] of Object.entries(en)) {
+      expect([key, ja[key]]).not.toEqual([key, english])
+    }
+  })
+})
