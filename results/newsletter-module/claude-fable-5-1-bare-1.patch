diff --git a/guren.arch.ts b/guren.arch.ts
new file mode 100644
index 0000000..2909ee1
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,21 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Checked by `bunx guren check --arch`. Alongside these rules, the CLI's
+// zero-config module boundary keeps everything outside a module from reaching
+// past its index.ts and db/schema.ts.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      // Even a type import would make the blog depend on the module's shape.
+      includeTypeImports: true,
+      message:
+        'The newsletter module ships on its own to other apps, so the blog (app/ and routes/) must not import from modules/newsletter/. Keep newsletter code inside the module and register it through src/app.ts.',
+    },
+  ],
+})
