diff --git a/app/Models/PostTags.ts b/app/Models/PostTags.ts
new file mode 100644
index 0000000..9ac055e
--- /dev/null
+++ b/app/Models/PostTags.ts
@@ -0,0 +1,73 @@
+import { and, eq, inArray } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+const db = async () => (await getDatabase()) as SQLiteBunDatabase
+
+/** Tag names per post id, sorted alphabetically. Posts without tags map to `[]`. */
+export async function tagNamesFor(postIds: number[]): Promise<Map<number, string[]>> {
+  const result = new Map<number, string[]>(postIds.map((id) => [id, []]))
+  if (postIds.length === 0) {
+    return result
+  }
+
+  const rows = await (await db())
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const row of rows) {
+    result.get(row.postId)?.push(row.name)
+  }
+  for (const names of result.values()) {
+    names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  }
+
+  return result
+}
+
+/** Ids of the posts carrying the tag `name`. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const rows = await (await db())
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+
+  return rows.map((row) => row.postId)
+}
+
+/** Makes the post carry exactly `names`: creates unknown tags, attaches, detaches. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const conn = await db()
+
+  const existing = names.length > 0 ? await conn.select().from(tags).where(inArray(tags.name, names)) : []
+  const known = new Set(existing.map((tag) => tag.name))
+  const missing = names.filter((name) => !known.has(name))
+  if (missing.length > 0) {
+    await conn.insert(tags).values(missing.map((name) => ({ name })))
+  }
+
+  const wanted = names.length > 0 ? await conn.select().from(tags).where(inArray(tags.name, names)) : []
+  const wantedIds = new Set(wanted.map((tag) => tag.id))
+
+  const attached = await conn.select().from(postTags).where(eq(postTags.postId, postId))
+  const attachedIds = new Set(attached.map((row) => row.tagId))
+
+  for (const tagId of attachedIds) {
+    if (!wantedIds.has(tagId)) {
+      await conn.delete(postTags).where(and(eq(postTags.postId, postId), eq(postTags.tagId, tagId)))
+    }
+  }
+
+  const toAttach = [...wantedIds].filter((tagId) => !attachedIds.has(tagId))
+  if (toAttach.length > 0) {
+    await conn.insert(postTags).values(toAttach.map((tagId) => ({ postId, tagId })))
+  }
+}
+
+export async function detachAllTags(postId: number): Promise<void> {
+  await (await db()).delete(postTags).where(eq(postTags.postId, postId))
+}
