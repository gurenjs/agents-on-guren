+import { defineMiddleware } from '@guren/core'
+import { RateLimiter } from '../../Lib/RateLimiter.js'
+
+export const throttleLoginAttempts = defineMiddleware(async (c, next) => {
+  // Extract client IP from the request
+  const clientIp = getClientIp(c)
+
+  // Check rate limit (5 attempts per 60 seconds)
+  const result = RateLimiter.check(clientIp, 5, 60)
+
+  if (!result.allowed) {
+    // Return 429 Too Many Requests with Retry-After header
+    return c.json(
+      { message: 'Too many login attempts. Please try again later.' },
+      {
+        status: 429,
+        headers: {
+          'Retry-After': result.retryAfterSeconds.toString(),
+        },
+      }
+    )
+  }
+
+  // Increment the attempt counter
+  RateLimiter.increment(clientIp)
+
+  // Continue to the next middleware/handler
+  return next()
+})
+
+function getClientIp(c: any): string {
+  // Try to get IP from the raw request socket
+  const socket = c.req.raw.socket
+  if (socket?.remoteAddress) {
+    return socket.remoteAddress
+  }
+
+  // Fallback: try to get from request headers (though we don't trust forwarded headers per spec)
+  // This is just a safety net
+  const addr = c.req.header('x-forwarded-for') || c.req.header('x-real-ip')
+  if (addr) {
+    // Take the first IP if it's a list
+    return addr.split(',')[0].trim()
+  }
+
+  // Last resort: use a placeholder that ensures all requests from unknown IPs
+  // are counted together (fail closed - don't let unknown clients through unthrottled)
+  return 'unknown'
+}
diff --git a/app/Lib/RateLimiter.ts b/app/Lib/RateLimiter.ts
new file mode 100644
index 0000000..adfc9ac
--- /dev/null
+++ b/app/Lib/RateLimiter.ts
@@ -0,0 +1,56 @@
+interface AttemptRecord {
+  count: number
+  windowStart: number
+}
+
+export class RateLimiter {
+  private static attempts = new Map<string, AttemptRecord>()
+  private static readonly CLEANUP_INTERVAL = 60_000 // Clean up every 60 seconds
+
+  static {
+    // Periodically clean up expired entries
+    setInterval(() => {
+      const now = Date.now()
+      for (const [key, record] of this.attempts.entries()) {
+        if (now - record.windowStart > 60_000) {
+          this.attempts.delete(key)
+        }
+      }
+    }, this.CLEANUP_INTERVAL)
+  }
+
+  static check(identifier: string, limit: number = 5, windowSeconds: number = 60): {
+    allowed: boolean
+    remaining: number
+    retryAfterSeconds: number
+  } {
+    const now = Date.now()
+    const windowMs = windowSeconds * 1000
+
+    let record = this.attempts.get(identifier)
+
+    // If no record exists or the window has expired, create a new one
+    if (!record || now - record.windowStart > windowMs) {
+      record = { count: 0, windowStart: now }
+      this.attempts.set(identifier, record)
+    }
+
+    const allowed = record.count < limit
+    const remaining = Math.max(0, limit - record.count - 1)
+    const timeSinceStart = now - record.windowStart
+    const retryAfterSeconds = Math.ceil((windowMs - timeSinceStart) / 1000)
+
+    return {
+      allowed,
+      remaining,
+      retryAfterSeconds,
+    }
+  }
+
+  static increment(identifier: string): void {
+    const record = this.attempts.get(identifier)
+    if (record) {
+      record.count++
+    }
+  }
+}
