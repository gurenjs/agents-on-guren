@@ -0,0 +1,36 @@
+import { Controller, readBearerToken, verifyApiToken, HttpException, getRequestContainer } from '@guren/core'
+import { McpHandler } from '../../Mcp/McpHandler.js'
+
+export default class McpController extends Controller {
+  async handle(): Promise<Response> {
+    // Get authorization header
+    const authHeader = this.request.header('authorization')
+    const token = readBearerToken(authHeader)
+    if (!token) {
+      throw HttpException.unauthorized('Missing bearer token')
+    }
+
+    // Get container from context
+    const container = getRequestContainer(this.ctx)
+    if (!container) {
+      throw HttpException.internal('Container not available')
+    }
+
+    // Verify API token with configured store
+    try {
+      const store = container.make('api-token-store') as any
+      await verifyApiToken(token, store)
+    } catch {
+      throw HttpException.unauthorized('Invalid bearer token')
+    }
+
+    // Request body is already validated by route contract
+    const { body } = this.validated('mcp.handle')
+
+    // Handle MCP request
+    const handler = new McpHandler(container)
+    const response = await handler.handle(body as any, this.ctx)
+
+    return this.json(response)
+  }
+}
