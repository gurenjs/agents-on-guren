+
+  it('slugifies the title when the post is created', () => {
+    expect(post.slug).toBe('hello-world')
+  })
+
+  it('hands a repeated title the next free number', async () => {
+    expect((await makePost('Hello, World!')).slug).toBe('hello-world-2')
+    expect((await makePost('Hello, World!')).slug).toBe('hello-world-3')
+  })
+
+  it('serves the post at its slug', async () => {
+    await http.get(`/posts/${post.slug}`).assertOk()
+  })
+
+  it('answers an unknown slug with a 404', async () => {
+    await http.get('/posts/no-such-post').assertNotFound()
+  })
+
+  it('permanently redirects the old id address to the slug', async () => {
+    const response = await http.get(`/posts/${post.id}`)
+    response.assertStatus(301).assertHeader('location', `/posts/${post.slug}`)
+  })
+
+  it('answers an unknown id with a 404', async () => {
+    await http.get('/posts/99999999').assertNotFound()
+  })
+
+  it('keeps the slug when the title changes', async () => {
+    await Post.update({ id: post.id }, { title: 'Something Else Entirely' })
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.slug).toBe('hello-world')
+    await http.get('/posts/something-else-entirely').assertNotFound()
+  })
+})
