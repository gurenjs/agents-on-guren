@@ -0,0 +1,22 @@
+import { Resource } from '@guren/core'
+import type { PostRevisionRecord } from '../../Models/PostRevision.js'
+
+export interface PostRevisionResourceData extends Record<string, unknown> {
+  id: number
+  title: string
+  // Serialized here for the same reason as PostResource.createdAt: the column
+  // is a string on SQLite and a Date on PostgreSQL and MySQL.
+  createdAt: string
+}
+
+export class PostRevisionResource extends Resource<PostRevisionRecord, PostRevisionResourceData> {
+  toArray(): PostRevisionResourceData {
+    const revision = this.resource
+
+    return {
+      id: revision.id,
+      title: revision.title,
+      createdAt: new Date(revision.createdAt).toISOString(),
+    }
+  }
+}
