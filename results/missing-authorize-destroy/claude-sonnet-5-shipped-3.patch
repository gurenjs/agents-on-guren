+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('posts.destroy', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('refuses a signed-in user who does not own the post, and keeps it', async () => {
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'password' })
+    const other = await User.create({ name: 'Other', email: 'other@example.com', password: 'password' })
+    const post = await Post.forceCreate({
+      title: 'Title',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertForbidden()
+
+    expect(await Post.find(post.id)).not.toBeNull()
+  })
+
+  it('refuses a guest', async () => {
+    const author = await User.create({ name: 'Author', email: 'author2@example.com', password: 'password' })
+    const post = await Post.forceCreate({
+      title: 'Title',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.withCsrf()
+    const res = await csrf.delete(`/posts/${post.id}`)
+    expect(res.status === 401 || res.status === 302).toBe(true)
+
+    expect(await Post.find(post.id)).not.toBeNull()
+  })
+
+  it('allows the author to delete their own post', async () => {
+    const author = await User.create({ name: 'Author', email: 'author3@example.com', password: 'password' })
+    const post = await Post.forceCreate({
+      title: 'Title',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author.id,
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+  })
+})
