--- /dev/null
+++ b/config/i18n.ts
@@ -0,0 +1,25 @@
+import type { I18nPluginOptions } from '@guren/core'
+
+/**
+ * Locales the app serves, first one the default. Translations live in
+ * lang/<locale>/*.json (namespace = file name); keep every locale directory
+ * carrying the same keys — `bunx guren check --i18n` reports any drift.
+ */
+export const supportedLocales = ['en', 'ja'] as const
+
+export type SupportedLocale = (typeof supportedLocales)[number]
+
+/** Name of the cookie the locale middleware reads (its default), set by `POST /locale`. */
+export const LOCALE_COOKIE_NAME = 'locale'
+
+/** A year: the switcher's pick outlives the session it was made in. */
+export const LOCALE_COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 365
+
+// Detection order stays the framework default (?locale=, the cookie, then
+// Accept-Language), so an explicit pick beats the browser's preference.
+const i18n: I18nPluginOptions = {
+  supported: [...supportedLocales],
+  fallback: supportedLocales[0],
+}
+
+export default i18n
