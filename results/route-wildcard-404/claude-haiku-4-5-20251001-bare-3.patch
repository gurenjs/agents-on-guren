+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('handles yearly archive requests', async () => {
+    const response = await http.get('/posts/archive/2026')
+    response.assertStatus(200)
+    const body = await response.json()
+    if (typeof body !== 'object' || body === null || !('data' in body)) {
+      throw new Error(`Expected { data: [...] }, got ${JSON.stringify(body)}`)
+    }
+  })
+
+  it('handles monthly archive requests', async () => {
+    const response = await http.get('/posts/archive/2026/08')
+    response.assertStatus(200)
+    const body = await response.json()
+    if (typeof body !== 'object' || body === null || !('data' in body)) {
+      throw new Error(`Expected { data: [...] }, got ${JSON.stringify(body)}`)
+    }
+  })
+
+  it('handles monthly archive with single digit month', async () => {
+    const response = await http.get('/posts/archive/2026/8')
+    response.assertStatus(200)
+    const body = await response.json()
+    if (typeof body !== 'object' || body === null || !('data' in body)) {
+      throw new Error(`Expected { data: [...] }, got ${JSON.stringify(body)}`)
+    }
+  })
+
+  it('rejects invalid month numbers', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
