diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..94ff56d
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,59 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// register.store carries its schema on the route so codegen can type the
+// sign-up form against it (resources/js/pages/auth/Register.tsx). Body parsing
+// still happens in the controller, so these assertions cover the shape the
+// page actually consumes: a 422 keyed by field, or a redirect to /dashboard.
+describe('register', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('renders the sign-up page', async () => {
+    await http.withHeader('X-Inertia', 'true').get('/register').assertInertia('auth/Register')
+  })
+
+  it('rejects a mismatched password confirmation', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: 'Ada',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'not-the-same',
+      })
+      .assertStatus(422)
+      .assertJsonPath('errors.passwordConfirmation.0', 'Passwords do not match.')
+  })
+
+  it('creates the account and redirects to the dashboard', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .json()
+      .post('/register', {
+        name: 'Ada',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertRedirect('/dashboard')
+
+    const user = await User.first({ email: 'ada@example.com' })
+    if (!user) {
+      throw new Error('Expected the sign-up to create a user.')
+    }
+  })
+})
