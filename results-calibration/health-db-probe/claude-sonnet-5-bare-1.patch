+import { describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { runHealthChecks } from '../app/Http/Controllers/HealthController.js'
+
+describe('/health', () => {
+  it('reports 200 and an ok db check when the database answers', async () => {
+    const http = await TestApp.fromApp(app)
+
+    await http.get('/health').assertOk().assertJsonPath('status', 'ok').assertJsonPath('checks.db.status', 'ok')
+  })
+})
+
+describe('runHealthChecks', () => {
+  it('marks the report ok when the probe query succeeds', async () => {
+    const report = await runHealthChecks(async () => ({ get: async () => ({ 1: 1 }) }))
+
+    expect(report).toEqual({ status: 'ok', checks: { db: { status: 'ok' } } })
+  })
+
+  it('marks the report as an error when the database query throws', async () => {
+    const report = await runHealthChecks(async () => ({
+      get: async () => {
+        throw new Error('connection refused')
+      },
+    }))
+
+    expect(report.status).toBe('error')
+    expect(report.checks.db.status).toBe('error')
+    expect(report.checks.db.message).toBe('connection refused')
+  })
+
+  it('marks the report as an error when the connection cannot be opened at all', async () => {
+    const report = await runHealthChecks(async () => {
+      throw new Error('ECONNREFUSED')
+    })
+
+    expect(report.status).toBe('error')
+    expect(report.checks.db.status).toBe('error')
+  })
+})
