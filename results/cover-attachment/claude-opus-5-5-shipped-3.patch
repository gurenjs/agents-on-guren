--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,135 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { readdir } from 'node:fs/promises'
+import app from '../src/app.js'
+import { Attachment } from '../config/attachments.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 5, 6, 7, 8])
+const GIF = new TextEncoder().encode('GIF89a-not-allowed')
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  return data
+}
+
+function postForm(extra: Record<string, string | File> = {}): FormData {
+  return form({ title: 'Covered', excerpt: 'An excerpt', body: 'A body', ...extra })
+}
+
+function coverRows(): Promise<number> {
+  return Attachment.newQuery().count()
+}
+
+async function storedFiles(root: string): Promise<string[]> {
+  return readdir(root, { recursive: true }).catch(() => [])
+}
+
+async function showProps(http: TestApp, id: number): Promise<{ coverUrl: string | null }> {
+  const res = await http.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${id}`)
+  const page = await res.json<{ props: { post: { coverUrl: string | null } } }>()
+  return page.props.post
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' }) as UserRecord
+  })
+
+  async function authed(): Promise<TestApp> {
+    return (await http.actingAs(author).withCsrf()).json()
+  }
+
+  it('stores a PNG cover on create and serves it back unchanged', async () => {
+    const client = await authed()
+    await client.post('/posts', postForm({ cover: new File([PNG], 'cover.png', { type: 'image/png' }) })).assertRedirect()
+
