diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..71d5686
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,49 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+import { User } from '../Models/User.js'
+
+/**
+ * The one store personal API tokens are issued from and verified against.
+ * Tokens are `{id}|{secret}`; the table keeps the id and a SHA-256 of the
+ * secret, never the secret itself.
+ */
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const API_RATE_LIMIT = 60
+const API_RATE_WINDOW_MS = 60_000
+
+/**
+ * Authenticates `Authorization: Bearer <token>` and makes the token's owner
+ * the request's user, so `this.auth.user()` and policies see them. A missing,
+ * malformed, unknown or revoked token answers 401 with a JSON body.
+ */
+export const requireApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+/**
+ * 60 requests a minute per token, not per user: the key is the token id, so a
+ * user's tokens each get their own budget. Runs after `requireApiToken`, which
+ * put the verified token on the context. In-memory, so the budget is per
+ * process — swap in RedisRateLimitStore when running more than one.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiTokenOrFail(c).token.id,
+  onRateLimited: (c, retryAfter) => {
+    // Rounded up to at least 1: "retry after 0 seconds" invites a tight loop.
+    c.header('Retry-After', String(Math.max(1, retryAfter)))
+    return c.json({ message: 'Too many requests, please try again later.' }, 429)
+  },
+})
diff --git a/app/Http/Controllers/Api/ApiPostController.ts b/app/Http/Controllers/Api/ApiPostController.ts
new file mode 100644
index 0000000..76ce993
