diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..075e7f4
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,93 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase, resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { apiTokens } from '../db/schema.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' })
+  })
+
+  async function issue(name = 'CI') {
+    const session = await http.actingAs(user).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: string; name: string; token: string }>()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('creates a token and stores only a hash', async () => {
+    const created = await issue()
+    const secret = created.token.split('|')[1]
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const db = (await getDatabase()) as { select(): { from(table: unknown): Promise<unknown[]> } }
+    const rows = await db.select().from(apiTokens)
+    expect(rows).toHaveLength(1)
+    expect(JSON.stringify(rows)).not.toContain(secret)
+  })
+
+  it('rejects bad names', async () => {
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    await session.json().post('/profile/tokens', {}).assertUnprocessable()
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await issue()
+    const res = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    res.assertCreated()
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(Number(user.id))
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(1)
+
+    const list = await bearer(token).get('/api/posts').assertOk()
+    expect((await list.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+
+  it('answers 401 for bad tokens and stops revoked ones', async () => {
+    const { id, token } = await issue()
+    await bearer('nope').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+    await http.json().get('/api/posts').assertUnauthorized()
+
+    const other = await issue('other')
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await bearer(token).get('/api/posts').assertUnauthorized()
+    await bearer(other.token).get('/api/posts').assertOk()
+    await session.json().delete('/profile/tokens/unknown').assertNotFound()
+  })
+
+  it('does not let another user revoke a token', async () => {
+    const { id, token } = await issue()
+    const mallory = await User.create({ name: 'Mal', email: 'mal@example.com', password: 'secret-pass-2' })
+    const session = await http.actingAs(mallory).withCsrf()
+    await session.json().delete(`/profile/tokens/${id}`).assertNotFound()
+    await bearer(token).get('/api/posts').assertOk()
+  })
+
+  it('rate limits per token', async () => {
+    const first = await issue('a')
+    const second = await issue('b')
+    for (let i = 0; i < 60; i++) await bearer(first.token).get('/api/posts').assertOk()
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
