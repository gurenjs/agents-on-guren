diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..c5fab14
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,28 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+import { User } from '../../Models/User.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(Number(userId)),
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed by token id, so each token of one user gets its own budget. Must run
+// after authenticateApiToken, which puts the verified token on the context.
+// A per-process memory store: several server processes each count separately.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+})
