diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..ad14abe
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,51 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_LIMIT = 60
+const WINDOW_MS = 60_000
+
+export interface ApiTokenAuth {
+  tokenId: number
+  userId: number
+}
+
+export const API_AUTH_KEY = 'apiTokenAuth'
+
+// Per-process sliding window of request times, keyed by token hash.
+const hits = new Map<string, number[]>()
+
+function unauthorized(): Response {
+  return Response.json({ message: 'Unauthenticated.' }, { status: 401, headers: { 'WWW-Authenticate': 'Bearer' } })
+}
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]{16,200})$/i.exec(header.trim())
+  if (!match) return unauthorized()
+
+  const tokenHash = ApiToken.hash(match[1]!)
+  const token = await ApiToken.first({ tokenHash })
+  if (!token) return unauthorized()
+
+  const now = Date.now()
+  const recent = (hits.get(tokenHash) ?? []).filter((at) => now - at < WINDOW_MS)
+  if (recent.length >= API_TOKEN_LIMIT) {
+    hits.set(tokenHash, recent)
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((recent[0]! + WINDOW_MS - now) / 1000)))
+    return Response.json(
+      { message: 'Too many requests.' },
+      { status: 429, headers: { 'Retry-After': String(retryAfter) } },
+    )
+  }
+  recent.push(now)
+  hits.set(tokenHash, recent)
+
+  if (hits.size > 10_000) {
+    for (const [id, times] of hits) {
+      if (times.every((at) => now - at >= WINDOW_MS)) hits.delete(id)
+    }
+  }
+
+  c.set(API_AUTH_KEY, { tokenId: token.id, userId: token.userId } satisfies ApiTokenAuth)
+  return next()
+})
