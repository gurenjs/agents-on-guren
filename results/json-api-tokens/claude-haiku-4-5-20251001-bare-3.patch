@@ -0,0 +1,41 @@
+import { Controller } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { ApiTokenService } from '../../Services/ApiTokenService.js'
+import { ApiTokenResource } from '../Resources/ApiTokenResource.js'
+import type { UserRecord } from '../../Models/User.js'
+import { CreateApiTokenSchema, ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class TokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(CreateApiTokenSchema)
+
+    const plainToken = ApiTokenService.generateToken()
+    const tokenHash = ApiTokenService.hashToken(plainToken)
+
+    const token = await ApiToken.create({
+      userId: user.id,
+      name,
+      tokenHash,
+    })
+
+    return this.json(
+      { data: new ApiTokenResource(token, plainToken).toJSON() },
+      { status: 201 }
+    )
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+
+    const token = await ApiToken.where({ id, userId: user.id }).first()
+    if (!token) {
+      return this.json({ error: 'Not found' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id })
+
+    return new Response(null, { status: 204 })
+  }
+}
