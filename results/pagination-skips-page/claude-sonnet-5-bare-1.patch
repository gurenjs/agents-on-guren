+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
 import app from '../src/app.js'
+import { getDatabase, resetDatabase } from '../config/database.js'
+import { posts, users } from '../db/schema.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,94 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.index pagination', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    const db = await getDatabase()
+
+    await db.insert(users).values({
+      name: 'Author',
+      email: 'author@example.com',
+      passwordHash: 'hash',
+    })
+    const [author] = await db.select().from(users).where(eq(users.email, 'author@example.com')).limit(1)
+
+    await db.insert(posts).values(
+      Array.from({ length: 25 }, (_, index) => ({
+        title: `Post ${index + 1}`,
+        excerpt: `Excerpt ${index + 1}`,
+        body: `Body ${index + 1}`,
+        authorId: author.id,
+      })),
+    )
+
+    http = (await TestApp.fromApp(app)).withHeader('X-Inertia', 'true')
+  })
+
+  it('shows the 10 newest posts on page 1 by default', async () => {
+    const res = await http.get('/posts').assertOk()
+    const json = await res.json<{ props: Record<string, any> }>()
+
+    expect(json.props.data.map((post: { title: string }) => post.title)).toEqual(
+      Array.from({ length: 10 }, (_, index) => `Post ${25 - index}`),
+    )
+    expect(json.props.pagination.meta).toEqual({
+      currentPage: 1,
+      lastPage: 3,
+      perPage: 10,
+      total: 25,
+      from: 1,
+      to: 10,
+    })
+    expect(json.props.pagination.links.prev).toBeNull()
+    expect(json.props.pagination.links.next).not.toBeNull()
+  })
+
+  it('shows the same page 1 when ?page=1 is explicit', async () => {
+    const res = await http.get('/posts?page=1').assertOk()
+    const json = await res.json<{ props: Record<string, any> }>()
+
+    expect(json.props.data.map((post: { title: string }) => post.title)).toEqual(
+      Array.from({ length: 10 }, (_, index) => `Post ${25 - index}`),
+    )
+    expect(json.props.pagination.meta.currentPage).toBe(1)
+  })
+
+  it('shows the next 10 posts on page 2', async () => {
+    const res = await http.get('/posts?page=2').assertOk()
+    const json = await res.json<{ props: Record<string, any> }>()
+
+    expect(json.props.data.map((post: { title: string }) => post.title)).toEqual(
+      Array.from({ length: 10 }, (_, index) => `Post ${15 - index}`),
+    )
+    expect(json.props.pagination.meta).toEqual({
+      currentPage: 2,
+      lastPage: 3,
+      perPage: 10,
+      total: 25,
+      from: 11,
+      to: 20,
+    })
+  })
+
+  it('shows the last 5 posts on page 3, with no further page', async () => {
+    const res = await http.get('/posts?page=3').assertOk()
+    const json = await res.json<{ props: Record<string, any> }>()
+
+    expect(json.props.data.map((post: { title: string }) => post.title)).toEqual(
+      Array.from({ length: 5 }, (_, index) => `Post ${5 - index}`),
+    )
+    expect(json.props.pagination.meta).toEqual({
+      currentPage: 3,
+      lastPage: 3,
+      perPage: 10,
+      total: 25,
+      from: 21,
+      to: 25,
+    })
+    expect(json.props.pagination.links.next).toBeNull()
+  })
+})
