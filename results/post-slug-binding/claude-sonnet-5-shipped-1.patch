+
+// Slugs are assigned once, on create, and never recomputed — editing a
+// post's title later must not change the address it was published at.
+class PostSlugObserver implements ModelObserver {
+  async creating(data: PlainObject): Promise<void> {
+    const base = slugify(String(data.title ?? '')) || 'post'
+    let candidate = base
+    let attempt = 2
+    while (await Post.first({ slug: candidate })) {
+      candidate = `${base}-${attempt}`
+      attempt++
+    }
+    data.slug = candidate
+  }
+}
+
+Post.observe(PostSlugObserver)
diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..4fa0532
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,10 @@
+/**
+ * Lowercase, ASCII letters/digits only, words joined by a single `-`, no
+ * leading/trailing `-`. `"Hello, World!"` → `"hello-world"`.
+ */
+export function slugify(input: string): string {
+  return input
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
