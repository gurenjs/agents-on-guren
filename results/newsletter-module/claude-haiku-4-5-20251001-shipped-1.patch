@@ -0,0 +1,17 @@
+import { Controller, HttpException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class ConfirmController extends Controller {
+  async confirm(): Promise<Response> {
+    const token = this.ctx.req.param('token')
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw HttpException.notFound()
+    }
+
+    await NewsletterSubscription.update({ token }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+}
