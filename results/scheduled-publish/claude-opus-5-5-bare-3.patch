--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,156 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse, type TestResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+const HOUR = 60 * 60 * 1000
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const email = `${label}-${crypto.randomUUID()}@example.com`
+  return (await User.create({ name: label, email, password: 'secret-password' })) as UserRecord
+}
+
+async function makePost(author: UserRecord, publishedAt: string | null): Promise<PostRecord> {
+  const marker = crypto.randomUUID()
+  return (await Post.forceCreate({
+    title: `Scheduled ${marker}`,
+    excerpt: `Excerpt ${marker}`,
+    body: 'Body',
+    authorId: author.id,
+    publishedAt,
+  })) as PostRecord
+}
+
+interface SearchResult {
+  data: PostRecord[]
+}
+
+async function inertiaProps(response: TestResponse): Promise<Record<string, any>> {
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as Record<string, any>
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    author = await makeUser('author')
+    other = await makeUser('other')
+  })
+
+  // `bun run console posts:scheduled` reads this same database, so leave no
+  // scheduled rows behind.
+  afterAll(async () => {
+    for (const user of [author, other]) {
+      await Post.delete({ authorId: user.id })
+      await User.delete({ id: user.id })
+    }
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    const post = await makePost(author, new Date(Date.now() + HOUR).toISOString())
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+
+    const response = await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+    const props = await inertiaProps(response)
+    expect(Date.parse(props.post.publishedAt)).toBe(Date.parse(post.publishedAt!))
+    expect(props.post.scheduled).toBe(true)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const post = await makePost(author, new Date(Date.now() + HOUR).toISOString())
+
+    const guestIds = (await inertiaProps(await http.get('/posts'))).data.map((p: PostRecord) => p.id)
+    expect(guestIds).not.toContain(post.id)
+
+    const otherIds = (await inertiaProps(await http.actingAs(other).get('/posts'))).data.map((p: PostRecord) => p.id)
+    expect(otherIds).not.toContain(post.id)
+
+    const own = (await inertiaProps(await http.actingAs(author).get('/posts'))).data.find(
+      (p: PostRecord) => p.id === post.id,
+    )
+    expect(own?.publishedAt).toBeString()
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    const post = await makePost(author, new Date(Date.now() + HOUR).toISOString())
+    const keywords = [post.title.split(' ')[1]]
+
+    const guest = await (await http.query('/posts/search', { keywords })).json<SearchResult>()
+    expect(guest.data.map((p: PostRecord) => p.id)).not.toContain(post.id)
+
+    const signedIn = await (await http.actingAs(other).query('/posts/search', { keywords })).json<SearchResult>()
+    expect(signedIn.data.map((p: PostRecord) => p.id)).not.toContain(post.id)
+  })
+
+  it('shows the post to everyone once its time has passed', async () => {
+    const post = await makePost(author, new Date(Date.now() + HOUR).toISOString())
+    await Post.update({ id: post.id }, { publishedAt: new Date(Date.now() - HOUR).toISOString() })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    const ids = (await inertiaProps(await http.get('/posts'))).data.map((p: PostRecord) => p.id)
+    expect(ids).toContain(post.id)
+    const found = await (await http.query('/posts/search', { keywords: [post.title.split(' ')[1]] })).json<SearchResult>()
+    expect(found.data.map((p: PostRecord) => p.id)).toContain(post.id)
+  })
+
+  it('stores publishAt from the create and edit requests', async () => {
+    const title = `Created ${crypto.randomUUID()}`
+    const client = await http.actingAs(author).withCsrf()
+    await client
+      .post('/posts', { title, excerpt: 'E', body: 'B', publishAt: '2099-10-01T09:00:00.000Z' })
+      .assertRedirect()
+    const created = (await Post.where('title', title))[0] as PostRecord
+    expect(created.publishedAt).toBe('2099-10-01T09:00:00.000Z')
+
+    await client
+      .put(`/posts/${created.id}`, { title, excerpt: 'E', body: 'B', publishAt: null })
+      .assertRedirect()
+    expect(((await Post.find(created.id)) as PostRecord).publishedAt).toBeNull()
+  })
+
+  it('rejects a publishAt that is not a date and time like an empty title', async () => {
+    const title = `Rejected ${crypto.randomUUID()}`
+    const client = await http.actingAs(author).withCsrf()
+    const emptyTitle = await client.post('/posts', { title: '', excerpt: 'E', body: 'B' })
+    const badDate = await client
+      .post('/posts', { title, excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+    expect(badDate.status).toBe(emptyTitle.status)
+    expect(await Post.where('title', title)).toHaveLength(0)
+  })
+
+  it('treats a post without a date as public', async () => {
+    const post = await makePost(author, null)
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+})
+
+describe('publishAt validation', () => {
+  const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+  it('normalizes a date and time to ISO 8601 UTC', () => {
+    const parsed = PostPayloadSchema.parse({ ...base, publishAt: '2026-10-01T11:00:00+02:00' })
+    expect(parsed.publishAt).toBe('2026-10-01T09:00:00.000Z')
+  })
+
+  it('treats absent, null and blank as publish now', () => {
+    expect(PostPayloadSchema.parse(base).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: null }).publishAt).toBeNull()
+    expect(PostPayloadSchema.parse({ ...base, publishAt: '' }).publishAt).toBeNull()
+  })
+
+  it('rejects a value that is not a date and time', () => {
+    const result = PostPayloadSchema.safeParse({ ...base, publishAt: 'next tuesday' })
+    expect(result.success).toBe(false)
+    expect(result.error?.issues[0]?.path).toEqual(['publishAt'])
+  })
+})
