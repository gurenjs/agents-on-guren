@@ -0,0 +1,52 @@
+import { describe, expect, it } from 'bun:test'
+import { ProfileUpdateSchema } from '../app/Http/Validators/ProfileValidator.js'
+
+describe('ProfileUpdateSchema', () => {
+  it('rejects a badly formatted email', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: 'Jane', email: 'not-an-email' })
+    expect(result.success).toBe(false)
+  })
+
+  it('rejects an empty name', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: '', email: 'jane@example.com' })
+    expect(result.success).toBe(false)
+  })
+
+  it('rejects a name over 120 characters', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: 'a'.repeat(121), email: 'jane@example.com' })
+    expect(result.success).toBe(false)
+  })
+
+  it('rejects a password shorter than 8 characters when provided', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: 'Jane', email: 'jane@example.com', password: 'short' })
+    expect(result.success).toBe(false)
+  })
+
+  it('accepts a missing password, meaning "keep the current password"', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: 'Jane', email: 'jane@example.com' })
+    expect(result.success).toBe(true)
+  })
+
+  it('trims the name and lowercases the email', () => {
+    const result = ProfileUpdateSchema.safeParse({ name: '  Jane  ', email: 'Jane@Example.com' })
+    expect(result.success).toBe(true)
+    if (result.success) {
+      expect(result.data.name).toBe('Jane')
+      expect(result.data.email).toBe('jane@example.com')
+    }
+  })
+
+  it('strips fields outside the profile form, such as id or passwordHash', () => {
+    const result = ProfileUpdateSchema.safeParse({
+      name: 'Jane',
+      email: 'jane@example.com',
+      id: 999,
+      passwordHash: 'attacker-controlled',
+    })
+    expect(result.success).toBe(true)
+    if (result.success) {
+      expect(result.data).not.toHaveProperty('id')
+      expect(result.data).not.toHaveProperty('passwordHash')
+    }
+  })
+})
