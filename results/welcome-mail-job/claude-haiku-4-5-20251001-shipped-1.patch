+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,25 @@
+import { Mail, getMailManager } from '@guren/server/mail'
+import type { UserRecord } from '../Models/User.js'
+
+export class WelcomeMail extends Mail {
+  constructor(private user: UserRecord) {
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('MailManager is not initialized')
+    }
+    super(manager)
+  }
+
+  protected build(): this {
+    const appName = process.env.APP_NAME || 'Guren'
+    const fromAddress = process.env.MAIL_FROM_ADDRESS || 'hello@example.com'
+    const fromName = process.env.MAIL_FROM_NAME || appName
+
+    return this.from({ email: fromAddress, name: fromName })
+      .to(this.user.email)
+      .subject(`Welcome to ${appName}, ${this.user.name}!`)
+      .text(
+        `Hi ${this.user.name},\n\nWelcome to ${appName}! We're excited to have you on board.\n\nBest regards,\n${appName}`,
+      )
+  }
+}
