@@ -0,0 +1,58 @@
+import { Controller, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.subscribe')
+
+    if (await NewsletterSubscription.first({ email: body.email })) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    try {
+      await NewsletterSubscription.create({ email: body.email, token: generateToken() })
+    } catch (error) {
+      // A concurrent request can win the race past the lookup above.
+      if (await NewsletterSubscription.first({ email: body.email })) {
+        throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+      }
+      throw error
+    }
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    if (subscription.confirmedAt === null) {
+      await NewsletterSubscription.update(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { body } = this.validated('newsletter.unsubscribe')
+
+    await NewsletterSubscription.delete({ email: body.email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (referer && isSafeRedirectUrl(referer, this.request.url)) {
+      return referer
+    }
+    return '/'
+  }
+}
