+  /**
+   * Makes `names` exactly the post's tag set: unknown names become new tags,
+   * listed ones are attached, and any others are detached. Tags left without
+   * posts are kept.
+   */
+  static async syncTags(postId: number, names: string[], trx: TransactionHandle): Promise<void> {
+    const tagScope = Tag.inTransaction(trx)
+    const pivotScope = PostTag.inTransaction(trx)
+
+    const tagIds: number[] = []
+    for (const name of names) {
+      const tag = (await tagScope.first({ name })) ?? (await tagScope.create({ name }))
+      tagIds.push(tag.id)
+    }
+
+    await pivotScope.delete({ postId })
+    for (const tagId of tagIds) {
+      await pivotScope.create({ postId, tagId })
+    }
   }
