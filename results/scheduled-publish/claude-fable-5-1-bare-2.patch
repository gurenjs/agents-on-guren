+// Booting src/app.ts migrates the test database, and every test below creates
+// the users and posts it reads, so rows left behind by earlier runs never
+// matter: assertions are about specific ids, never counts.
+const FUTURE = '2036-01-01T09:00:00.000Z'
+const PAST = '2020-01-01T09:00:00.000Z'
+
+let sequence = 0
+
+function stamp(): string {
+  sequence += 1
+  return `${Date.now()}-${sequence}`
+}
+
+async function createUser(label: string): Promise<UserRecord> {
+  return User.create({ name: label, email: `${label}-${stamp()}@example.com`, password: 'secret-password' })
+}
+
+async function createPost(author: UserRecord, publishedAt: string | null): Promise<PostRecord> {
+  const suffix = stamp()
+  const post = await Post.forceCreate({
+    title: `Launch ${suffix}`,
+    excerpt: `Excerpt ${suffix}`,
+    body: 'Written ahead of time.',
+    authorId: author.id,
+    publishedAt,
+  })
+  if (!post) {
+    throw new Error('Post.forceCreate returned nothing')
+  }
+  return post
+}
+
+async function pageProps<T>(client: TestApp, path: string): Promise<T> {
+  const response = await client.get(path).assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as T
+}
+
+async function listedPosts(client: TestApp): Promise<PostResourceData[]> {
+  const props = await pageProps<{ data: PostResourceData[] }>(client, '/posts')
+  return props.data
+}
+
+async function searchedPosts(client: TestApp, keyword: string): Promise<PostResourceData[]> {
+  const response = await client.query('/posts/search', { keywords: [keyword] }).assertOk()
+  const body = await response.json<{ data: PostResourceData[] }>()
+  return body.data
+}
+
+function ids(posts: PostResourceData[]): number[] {
+  return posts.map((post) => post.id)
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await createUser('author')
+    other = await createUser('reader')
+  })
+
+  it('answers 404 for everyone but the author until the publish time', async () => {
+    const post = await createPost(author, FUTURE)
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+
+    const props = await pageProps<{ post: PostResourceData }>(http.actingAs(author), `/posts/${post.id}`)
+    expect(props.post.id).toBe(post.id)
+    expect(new Date(props.post.publishedAt as string).toISOString()).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const post = await createPost(author, FUTURE)
+
+    expect(ids(await listedPosts(http))).not.toContain(post.id)
+    expect(ids(await listedPosts(http.actingAs(other)))).not.toContain(post.id)
+
+    const own = (await listedPosts(http.actingAs(author))).find((entry) => entry.id === post.id)
+    expect(own).toBeDefined()
+    expect(new Date(own?.publishedAt as string).toISOString()).toBe(FUTURE)
+  })
+
+  it('keeps a scheduled post out of search for guests and other users', async () => {
+    const post = await createPost(author, FUTURE)
+
+    expect(ids(await searchedPosts(http, post.title))).not.toContain(post.id)
+    expect(ids(await searchedPosts(http.actingAs(other), post.title))).not.toContain(post.id)
+    expect(ids(await searchedPosts(http.actingAs(author), post.title))).toContain(post.id)
+  })
+
+  it('lists posts with no date and posts whose date has passed for everyone', async () => {
+    const immediate = await createPost(author, null)
+    const live = await createPost(author, PAST)
+
+    for (const post of [immediate, live]) {
+      await http.get(`/posts/${post.id}`).assertOk()
+      expect(ids(await listedPosts(http))).toContain(post.id)
+      expect(ids(await searchedPosts(http.actingAs(other), post.title))).toContain(post.id)
+    }
+  })
+
+  it('goes public on its own once the stored time has passed', async () => {
+    const post = await createPost(author, FUTURE)
+    await http.get(`/posts/${post.id}`).assertNotFound()
+
+    // Moved in the database, the way a clock ticking past it would look.
+    await Post.update({ id: post.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    expect(ids(await listedPosts(http))).toContain(post.id)
+    expect(ids(await searchedPosts(http, post.title))).toContain(post.id)
+  })
+
+  describe('forms', () => {
+    let client: TestApp
+
+    beforeAll(async () => {
+      client = (await http.withCsrf()).actingAs(author)
+    })
+
+    it('stores the publish date from the create form', async () => {
+      const title = `Create ${stamp()}`
+      await client
+        .post('/posts', { title, excerpt: 'Soon', body: 'Body', publishAt: FUTURE })
+        .assertRedirect()
+
+      const saved = await Post.first({ title })
+      expect(saved?.publishedAt).toBe(FUTURE)
+    })
+
+    it('publishes immediately when the date is left out or null', async () => {
+      const omitted = `Create ${stamp()}`
+      await client.post('/posts', { title: omitted, excerpt: 'Now', body: 'Body' }).assertRedirect()
+      expect((await Post.first({ title: omitted }))?.publishedAt).toBeNull()
+
+      const explicit = `Create ${stamp()}`
+      await client.post('/posts', { title: explicit, excerpt: 'Now', body: 'Body', publishAt: null }).assertRedirect()
+      expect((await Post.first({ title: explicit }))?.publishedAt).toBeNull()
+    })
+
+    it('rejects a publish date that is not a date and time, like an empty title', async () => {
+      const title = `Rejected ${stamp()}`
+      const invalidDate = await client
+        .json()
+        .post('/posts', { title, excerpt: 'Soon', body: 'Body', publishAt: 'next tuesday' })
+      const emptyTitle = await client.json().post('/posts', { title: '', excerpt: 'Soon', body: 'Body' })
+
+      expect(invalidDate.status).toBe(422)
+      expect(invalidDate.status).toBe(emptyTitle.status)
+      expect(await Post.first({ title })).toBeNull()
+    })
+
+    it('sets, changes and clears the date from the edit form', async () => {
+      const post = await createPost(author, null)
+      const fields = { title: post.title, excerpt: post.excerpt, body: post.body }
+
+      await client.put(`/posts/${post.id}`, { ...fields, publishAt: FUTURE }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBe(FUTURE)
+
+      const later = '2036-02-01T09:00:00.000Z'
+      await client.put(`/posts/${post.id}`, { ...fields, publishAt: later }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBe(later)
+
+      await client.put(`/posts/${post.id}`, { ...fields, publishAt: null }).assertRedirect()
+      expect((await Post.find(post.id))?.publishedAt).toBeNull()
+    })
+
+    it('stores an offset time as the same UTC instant', async () => {
+      const title = `Offset ${stamp()}`
+      await client
+        .post('/posts', { title, excerpt: 'Soon', body: 'Body', publishAt: '2036-01-01T18:00:00+09:00' })
+        .assertRedirect()
+
+      expect((await Post.first({ title }))?.publishedAt).toBe(FUTURE)
+    })
+  })
