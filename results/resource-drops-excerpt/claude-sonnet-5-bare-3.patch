+import { describe, expect, it } from 'bun:test'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+
+describe('PostResource', () => {
+  it('includes the excerpt in the serialized output', () => {
+    const post = {
+      id: 1,
+      title: 'A post',
+      excerpt: 'Bees remember faces',
+      body: 'The full body.',
+      authorId: 2,
+      createdAt: '2026-08-18T00:00:00.000Z',
+    }
+
+    const data = new PostResource(post).toJSON()
+
+    expect(data.excerpt).toBe('Bees remember faces')
+  })
+})
