diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..6e62991
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+import { postTags, posts, tags } from '../db/schema.js'
+
+describe('parseTagNames', () => {
+  it('trims, drops empties and dedupes', () => {
+    expect(parseTagNames(' bun ,bun,, webdev,')).toEqual(['bun', 'webdev'])
+    expect(parseTagNames(undefined)).toEqual([])
+  })
+})
+
+describe('post tags', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  async function author() {
+    return User.forceCreate({
+      name: 'Tagger',
+      email: `tagger-${crypto.randomUUID()}@example.com`,
+      password: 'secret123',
+    })
+  }
+
+  const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+  it('creates, filters, edits and deletes a tagged post', async () => {
+    const db = (await getDatabase()) as any
+    const user = await author()
+    const name = `t${crypto.randomUUID().slice(0, 8)}`
+
+    await http.actingAs(user).post('/posts', { ...base, tags: `${name}, ${name}x` }).assertRedirect()
+    const [post] = await db.select().from(posts).where(eq(posts.authorId, user.id))
+    const attached = await db.select().from(postTags).where(eq(postTags.postId, post.id))
+    expect(attached.length).toBe(2)
+
+    await http.actingAs(user).put(`/posts/${post.id}`, { ...base, tags: name }).assertRedirect()
+    expect((await db.select().from(postTags).where(eq(postTags.postId, post.id))).length).toBe(1)
+
+    await http.get(`/posts?tag=${name}`).assertOk()
+    await http.get('/posts?tag=nobody-uses-this').assertOk()
+
+    await http.actingAs(user).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect((await db.select().from(postTags).where(eq(postTags.postId, post.id))).length).toBe(0)
+  })
+
+  it('refuses invalid tag input and writes nothing', async () => {
+    const db = (await getDatabase()) as any
+    const user = await author()
+    const before = (await db.select().from(tags)).length
+
+    await http.actingAs(user).post('/posts', { ...base, tags: 'a,b,c,d,e,f' }).assertStatus(422)
+    await http.actingAs(user).post('/posts', { ...base, tags: 'x'.repeat(31) }).assertStatus(422)
+    expect((await db.select().from(posts).where(eq(posts.authorId, user.id))).length).toBe(0)
+    expect((await db.select().from(tags)).length).toBe(before)
+
+    await http.actingAs(user).post('/posts', { ...base, tags: 'x'.repeat(30) }).assertRedirect()
+  })
+})
