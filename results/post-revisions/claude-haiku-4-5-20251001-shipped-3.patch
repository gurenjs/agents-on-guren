+      postId: post.id,
+      title: 'First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+
+    // Guests and non-auth users are redirected by middleware or return 401/403
+    const res = await http.post(`/posts/${post.id}/revisions/${revision.id}/restore`)
+    expect([301, 302, 303, 307, 308, 401, 403]).toContain(res.status)
+  })
+
+  it('returns 404 for revision from different post', async () => {
+    const otherPost = await Post.forceCreate({
+      title: 'Other',
+      excerpt: 'Other excerpt',
+      body: 'Other body',
+      authorId: author.id,
+    })
+    const revision = await PostRevision.create({
+      postId: otherPost.id,
+      title: 'Other First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertNotFound()
+  })
+
+  it('deletes revisions when post is deleted', async () => {
+    await PostRevision.create({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'excerpt1',
+      body: 'body1',
+    })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    const revisions = await PostRevision.where({ postId: post.id }).get()
+    expect(revisions.length).toBe(0)
+  })
