diff --git a/app/Support/AttachmentStorage.ts b/app/Support/AttachmentStorage.ts
new file mode 100644
index 0000000..e41d049
--- /dev/null
+++ b/app/Support/AttachmentStorage.ts
@@ -0,0 +1,48 @@
+import { resolve } from 'node:path'
+import { LocalStorageDriver } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+// Under storage/, never public/: public/ is served as-is to anyone, while these
+// files only leave the server through AttachmentController. Resolved from the
+// working directory, like the SQLite file in config/database.ts.
+const disk = new LocalStorageDriver({ root: resolve(process.cwd(), 'storage/app/attachments') })
+
+const EXTENSIONS: Record<string, string> = {
+  'image/png': 'png',
+  'image/jpeg': 'jpg',
+}
+
+/** Writes the upload to disk and records it; the file is removed again if the row cannot be. */
+export async function storeAttachment(file: File, contentType: string): Promise<AttachmentRecord> {
+  const key = crypto.randomUUID()
+  const path = `${key}.${EXTENSIONS[contentType] ?? 'bin'}`
+  const bytes = Buffer.from(await file.arrayBuffer())
+  await disk.put(path, bytes)
+
+  try {
+    return await Attachment.forceCreate({
+      key,
+      path,
+      filename: file.name || path,
+      contentType,
+      byteSize: bytes.byteLength,
+    })
+  } catch (error) {
+    await disk.delete(path)
+    throw error
+  }
+}
+
+/** Removes the row and its file. A missing row or file is not an error. */
+export async function deleteAttachment(id: number | null | undefined): Promise<void> {
+  if (id == null) return
+  const attachment = await Attachment.find(id)
+  if (!attachment) return
+
+  await Attachment.delete({ id: attachment.id })
+  await disk.delete(attachment.path)
+}
+
+export async function readAttachment(attachment: AttachmentRecord): Promise<Buffer | null> {
+  return disk.get(attachment.path)
+}
