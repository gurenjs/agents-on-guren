@@ -0,0 +1,221 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import type { UserRecord } from '../app/Models/User.js'
+import type { PostRecord } from '../app/Models/Post.js'
+import type { CommentRecord as CommentRecordType } from '../app/Models/Comment.js'
+
+type CommentRecord = CommentRecordType
+
+describe('CommentController', () => {
+  let http: TestApp
+  let author: UserRecord
+  let commenter: UserRecord
+  let reporter1: UserRecord
+  let reporter2: UserRecord
+  let reporter3: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    author = await User.create({
+      name: 'Post Author',
+      email: 'author@example.com',
+      password: 'password',
+    })
+    commenter = await User.create({
+      name: 'Commenter',
+      email: 'commenter@example.com',
+      password: 'password',
+    })
+    reporter1 = await User.create({
+      name: 'Reporter 1',
+      email: 'reporter1@example.com',
+      password: 'password',
+    })
+    reporter2 = await User.create({
+      name: 'Reporter 2',
+      email: 'reporter2@example.com',
+      password: 'password',
+    })
+    reporter3 = await User.create({
+      name: 'Reporter 3',
+      email: 'reporter3@example.com',
+      password: 'password',
+    })
+
+    post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'An excerpt',
+      body: 'Post body',
+      authorId: author.id,
+    })
+  })
+
+  describe('store', () => {
+    it('guest is redirected to login', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('Comment should not be created')
+    })
+
+    it('authenticated user can create a comment', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: 'Great post!' }).assertRedirect(`/posts/${post.id}`)
+
+      const comment = await Comment.first()
+      if (!comment || comment.body !== 'Great post!') throw new Error('Comment not created correctly')
+    })
+
+    it('rejects empty body', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('Comment should not be created')
+    })
+
+    it('rejects body over 2000 characters', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      const longBody = 'a'.repeat(2001)
+      await csrf.post(`/posts/${post.id}/comments`, { body: longBody }).assertUnprocessable()
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('Comment should not be created')
+    })
+  })
+
+  describe('destroy', () => {
+    beforeEach(async () => {
+      await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'A comment',
+      })
+    })
+
+    it('comment author can delete', async () => {
+      const comment = await Comment.first()
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.delete(`/comments/${comment?.id}`).assertRedirect(`/posts/${post.id}`)
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('Comment should be deleted')
+    })
+
+    it('post author can delete', async () => {
+      const comment = await Comment.first()
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf.delete(`/comments/${comment?.id}`).assertRedirect(`/posts/${post.id}`)
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('Comment should be deleted')
+    })
+
+    it('other user gets 403', async () => {
+      const comment = await Comment.first()
+      const csrf = await http.actingAs(reporter1).withCsrf()
+      await csrf.delete(`/comments/${comment?.id}`).assertForbidden()
+
+      const count = await Comment.newQuery().count()
+      if (count !== 1) throw new Error('Comment should not be deleted')
+    })
+  })
+
+  describe('report', () => {
+    let comment: CommentRecord
+
+    beforeEach(async () => {
+      comment = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'A comment',
+      })
+    })
+
+    it('authenticated user can report', async () => {
+      const csrf = await http.actingAs(reporter1).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+      const count = await CommentReport.newQuery().count()
+      if (count !== 1) throw new Error('Report should be created')
+    })
+
+    it('second report by same user returns 204 but creates no new row', async () => {
+      const csrf = await http.actingAs(reporter1).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+      await csrf.post(`/comments/${comment.id}/report`).assertStatus(204)
+
+      const count = await CommentReport.newQuery().count()
+      if (count !== 1) throw new Error('Only one report should be created')
+    })
+
+    it('guest cannot report (redirects to login)', async () => {
+      const csrf = await http.withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertRedirect('/login')
+
+      const count = await CommentReport.newQuery().count()
+      if (count !== 0) throw new Error('No report should be created')
+    })
+  })
+
+  describe('post page visibility', () => {
+    let comment1: CommentRecord
+
+    beforeEach(async () => {
+      comment1 = await Comment.forceCreate({
+        postId: post.id,
+        userId: commenter.id,
+        body: 'Comment 1',
+      })
+      await Comment.forceCreate({
+        postId: post.id,
+        userId: author.id,
+        body: 'Comment 2',
+      })
+    })
+
+    it('shows comments with less than 3 reports', async () => {
+      await http.get(`/posts/${post.id}`).assertOk()
+      // Props would need to be extracted to verify the exact comment count
+      // For now we just verify the page loads
+    })
+
+    it('hides comments with 3 or more reports', async () => {
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter1.id })
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter2.id })
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter3.id })
+
+      await http.get(`/posts/${post.id}`).assertOk()
+      // Comment should be hidden in the props
+    })
+
+    it('keeps reported comments in database', async () => {
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter1.id })
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter2.id })
+      await CommentReport.forceCreate({ commentId: comment1.id, userId: reporter3.id })
+
+      const comment = await Comment.findOrFail(comment1.id)
+      if (comment.body !== 'Comment 1') throw new Error('Comment should still exist in database')
+    })
+
+    it('deletes comments when post is deleted', async () => {
+      await Post.delete({ id: post.id })
+
+      const count = await Comment.newQuery().count()
+      if (count !== 0) throw new Error('All comments should be deleted when post is deleted')
+    })
+  })
+})
