diff --git a/app/Http/Controllers/Api/PostController.ts b/app/Http/Controllers/Api/PostController.ts
new file mode 100644
index 0000000..2cc5154
--- /dev/null
+++ b/app/Http/Controllers/Api/PostController.ts
@@ -0,0 +1,52 @@
+import { Controller, paginate } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../../Validators/PostValidator.js'
+
+const PER_PAGE = 10
+
+// Public JSON feed of posts for external consumers — no session, no CSRF
+// token, no sign-in. Kept apart from the Inertia PostController because
+// nothing here renders a page: the envelope is the contract partners code
+// against.
+export default class PostController extends Controller {
+  async index(): Promise<Response> {
+    // The route contract has already rejected invalid input with a 422; this
+    // re-parse is what hands the controller the coerced values.
+    const { page, author } = this.validateQuery(ApiListPostsQuerySchema)
+
+    // Counted and fetched through two builders rather than `paginate()`:
+    // that helper runs the query without applying eager loads, which would
+    // drop the `author` this feed promises. The page is also served as asked
+    // for — a page past the end answers with an empty `data`, not with the
+    // last page over again.
+    const filtered = () => {
+      const query = Post.newQuery()
+      if (author !== undefined) {
+        query.where('authorId', author)
+      }
+      return query
+    }
+
+    const total = await filtered().count()
+    const posts = await filtered()
+      .with('author')
+      .orderBy('id', 'desc')
+      .limit(PER_PAGE)
+      .offset((page - 1) * PER_PAGE)
+      .get()
+
+    const paginator = paginate(posts, total, PER_PAGE, page, {
+      path: this.request.path ?? '/api/posts',
+      // Keeps ?author= on the page links, so following `next` stays inside
+      // the filtered set.
+      query: author !== undefined ? { author: String(author) } : undefined,
+    })
+
+    return this.json({
+      data: posts.map((post) => new PostResource(post).toJSON()),
+      meta: paginator.meta(),
+      links: paginator.links(),
+    })
+  }
+}
