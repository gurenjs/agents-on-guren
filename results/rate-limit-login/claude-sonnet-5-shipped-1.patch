@@ -0,0 +1,42 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// All requests in this suite share one client identity (TestApp's in-process
+// fetch has no real socket, so the rate limiter falls back to its shared
+// bucket) and the limiter's counters are in-memory and never reset between
+// cases, so the whole scenario runs as one ordered sequence rather than
+// independent `it` blocks.
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const base = await TestApp.fromApp(app)
+    await resetDatabase()
+    await User.create({ name: 'Jane', email: 'jane@example.com', password: 'correct-password' })
+    http = await base.withCsrf()
+  })
+
+  it('processes attempts under the limit normally, then throttles the rest of the window', async () => {
+    // Attempts 1-4: wrong password, refused the normal way (not throttled).
+    for (let attempt = 0; attempt < 4; attempt++) {
+      await http.json().post('/login', { email: 'jane@example.com', password: 'wrong' }).assertUnprocessable()
+    }
+
+    // Attempt 5: correct credentials, still within the limit — login succeeds.
+    await http.json().post('/login', { email: 'jane@example.com', password: 'correct-password' }).assertRedirect('/dashboard')
+
+    // Attempt 6: over the limit within the same window — throttled even
+    // though the credentials are correct.
+    const throttled = await http.json().post('/login', { email: 'jane@example.com', password: 'correct-password' })
+    throttled.assertStatus(429)
+    expect(throttled.headers.get('Retry-After')).toBeTruthy()
+
+    // A throttled client can still load other pages — only the login
+    // submission itself is rate limited.
+    await http.get('/login').assertOk()
+    await http.get('/').assertOk()
+  })
+})
