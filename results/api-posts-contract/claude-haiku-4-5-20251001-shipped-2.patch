+
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects page=0', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+  })
+
+  it('rejects page=abc', async () => {
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects author=0', async () => {
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+
+  it('rejects author=abc', async () => {
+    await http.get('/api/posts?author=abc').assertStatus(422)
+  })
+
+  it('accepts valid page parameter', async () => {
+    await http.get('/api/posts?page=1').assertStatus(200)
+  })
+
+  it('accepts valid author parameter', async () => {
+    await http.get('/api/posts?author=1').assertStatus(200)
+  })
+
+  it('returns JSON with correct structure', async () => {
+    await http.get('/api/posts')
+      .assertStatus(200)
+      .assertJsonStructure(['data', 'meta'])
+  })
+
+  it('meta has required fields', async () => {
+    await http.get('/api/posts')
+      .assertStatus(200)
+      .assertJsonPath('meta.currentPage', 1)
+      .assertJsonPath('meta.perPage', 10)
+  })
+})
