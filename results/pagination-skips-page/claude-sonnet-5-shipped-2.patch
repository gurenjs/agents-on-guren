-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, describe, expect, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+interface PostsIndexBody {
+  component: string
+  props: {
+    data: { title: string }[]
+    pagination: { meta: Record<string, unknown> }
+  }
+}
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +31,57 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+
+    const author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })
+
+    // Newest post has the highest id — 25 posts so the newest 10 span page 1.
+    for (let i = 1; i <= 25; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: author.id,
+      })
+    }
+
+    http = (await TestApp.fromApp(app)).json()
+  })
+
+  it('shows the newest 10 posts on page 1 by default', async () => {
+    const res = await http.get('/posts')
+    res.assertOk()
+    const body = await res.json<PostsIndexBody>()
+
+    expect(body.component).toBe('posts/Index')
+    expect(body.props.data.map((post) => post.title)).toEqual([
+      'Post 25', 'Post 24', 'Post 23', 'Post 22', 'Post 21', 'Post 20', 'Post 19', 'Post 18', 'Post 17', 'Post 16',
+    ])
+    expect(body.props.pagination.meta).toMatchObject({ currentPage: 1, total: 25, from: 1, to: 10 })
+  })
+
+  it('shows page 1 explicitly via ?page=1, matching the default', async () => {
+    const body = await (await http.get('/posts?page=1')).json<PostsIndexBody>()
+    expect(body.props.data.map((post) => post.title)).toEqual([
+      'Post 25', 'Post 24', 'Post 23', 'Post 22', 'Post 21', 'Post 20', 'Post 19', 'Post 18', 'Post 17', 'Post 16',
+    ])
+    expect(body.props.pagination.meta).toMatchObject({ currentPage: 1, from: 1, to: 10 })
+  })
+
+  it('shows the next 10 posts on page 2 and the last 5 on page 3', async () => {
+    const page2 = await (await http.get('/posts?page=2')).json<PostsIndexBody>()
+    expect(page2.props.data.map((post) => post.title)).toEqual([
+      'Post 15', 'Post 14', 'Post 13', 'Post 12', 'Post 11', 'Post 10', 'Post 9', 'Post 8', 'Post 7', 'Post 6',
+    ])
+    expect(page2.props.pagination.meta).toMatchObject({ currentPage: 2, from: 11, to: 20 })
+
+    const page3 = await (await http.get('/posts?page=3')).json<PostsIndexBody>()
+    expect(page3.props.data.map((post) => post.title)).toEqual(['Post 5', 'Post 4', 'Post 3', 'Post 2', 'Post 1'])
+    expect(page3.props.pagination.meta).toMatchObject({ currentPage: 3, from: 21, to: 25 })
+  })
+})
