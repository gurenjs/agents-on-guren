new file mode 100644
index 0000000..dbaf4ca
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,20 @@
+import { defineModel } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+type TransactionHandle = Parameters<Parameters<typeof PostRevision.transaction>[0]>[0]
+
+export class PostRevision extends defineModel(postRevisions, {
+  fillable: ['title', 'excerpt', 'body'],
+}) {}
+
+/** Snapshots the post's current content; call before overwriting it. */
+export async function keepRevision(post: PostRecord, trx?: TransactionHandle): Promise<void> {
+  // forceCreate because `postId` comes from the loaded post, never from input.
+  await PostRevision.forceCreate(
+    { postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body },
+    { trx },
+  )
+}
