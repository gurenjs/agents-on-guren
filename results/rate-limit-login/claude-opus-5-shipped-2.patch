diff --git a/tests/LoginThrottle.test.ts b/tests/LoginThrottle.test.ts
new file mode 100644
index 0000000..603e5bc
--- /dev/null
+++ b/tests/LoginThrottle.test.ts
@@ -0,0 +1,86 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { loginRateLimitStore } from '../app/Http/Middleware/ThrottleLoginMiddleware.js'
+
+const CREDENTIALS = { email: 'nobody@example.com', password: 'wrong-password' }
+const GOOD = { email: 'throttle-fixture@example.com', password: 'correct-horse-battery' }
+
+// The limiter counts submissions, not failures, so these cases never need a
+// user row: a wrong-credentials POST is a submission like any other. Counters
+// live in one process-wide store, so each case starts by clearing it.
+describe('login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await User.delete({ email: GOOD.email })
+    await User.create({ name: 'Throttle Fixture', email: GOOD.email, password: GOOD.password })
+  })
+
+  afterAll(async () => {
+    await User.delete({ email: GOOD.email })
+  })
+
+  beforeEach(() => {
+    loginRateLimitStore.clear()
+  })
+
+  it('refuses the sixth submission in a minute with 429 and a Retry-After', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let attempt = 1; attempt <= 5; attempt += 1) {
+      const allowed = await csrf.post('/login', CREDENTIALS)
+      expect(allowed.status).not.toBe(429)
+    }
+
+    const throttled = await csrf.post('/login', CREDENTIALS)
+    throttled.assertStatus(429)
+    expect(throttled.headers.get('Retry-After')).toBeTruthy()
+  })
+
+  it('still signs a client in on a correct submission within the limit', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let attempt = 1; attempt <= 4; attempt += 1) {
+      await csrf.post('/login', CREDENTIALS)
+    }
+
+    await csrf.post('/login', GOOD).assertRedirect('/dashboard')
+  })
+
+  it('refuses a correct submission once the client is throttled', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let attempt = 1; attempt <= 5; attempt += 1) {
+      await csrf.post('/login', CREDENTIALS)
+    }
+
+    await csrf.post('/login', GOOD).assertStatus(429)
+  })
+
+  it('ignores forwarded-for headers when identifying the client', async () => {
+    const csrf = await http.withCsrf()
+
+    // A spoofed address per request must not buy a fresh budget — the app is
+    // not behind a proxy, so only the connection's own address counts.
+    for (let attempt = 1; attempt <= 5; attempt += 1) {
+      const allowed = await csrf.withHeader('X-Forwarded-For', `203.0.113.${attempt}`).post('/login', CREDENTIALS)
+      expect(allowed.status).not.toBe(429)
+    }
+
+    await csrf.withHeader('X-Forwarded-For', '203.0.113.99').post('/login', CREDENTIALS).assertStatus(429)
+  })
+
+  it('leaves the login form and other pages reachable while throttled', async () => {
+    const csrf = await http.withCsrf()
+
+    for (let attempt = 1; attempt <= 6; attempt += 1) {
+      await csrf.post('/login', CREDENTIALS)
+    }
+
+    await csrf.get('/login').assertOk()
+    await csrf.get('/').assertOk()
+  })
+})
