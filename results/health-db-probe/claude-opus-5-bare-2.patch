+++ b/app/Health/index.ts
@@ -0,0 +1,30 @@
+import { createHealthManager, type HealthManager, type HealthStatus } from '@guren/core'
+import { DatabaseHealthCheck } from './DatabaseHealthCheck.js'
+
+/**
+ * A probe answers a load balancer, so it must not hang on a database that
+ * accepts connections but never replies — shorter than the 5s default.
+ */
+const DATABASE_TIMEOUT_MS = 2_000
+
+/**
+ * The checks `GET /health` reports on. The database is the only dependency the
+ * app cannot serve a page without, so it is `critical`: its failure drops the
+ * whole report to `unhealthy` (a non-critical failure would only downgrade it
+ * to `degraded`, which still answers 200 and keeps traffic coming).
+ */
+export function createAppHealthManager(): HealthManager {
+  return createHealthManager().register(new DatabaseHealthCheck(), {
+    critical: true,
+    timeout: DATABASE_TIMEOUT_MS,
+  })
+}
+
+/**
+ * Maps a report to the status code the platform routes on: only `unhealthy`
+ * drains this instance from the pool. `degraded` — a future non-critical check
+ * failing — still serves traffic.
+ */
+export function healthStatusCode(status: HealthStatus): number {
+  return status === 'unhealthy' ? 503 : 200
+}
