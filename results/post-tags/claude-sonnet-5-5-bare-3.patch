diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..ca1f561
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { configureOrm, getDatabase, migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { parseTagNames } from '../app/Http/Validators/PostValidator.js'
+import { postTags, posts, tags } from '../db/schema.js'
+
+const post = (tagsField?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tagsField === undefined ? {} : { tags: tagsField }) })
+
+describe('post tags', () => {
+  let http: TestApp
+  let db: any
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    await configureOrm()
+    db = await getDatabase()
+    const user = await User.create({ name: 'Tagger', email: `tagger-${Date.now()}@example.com`, password: 'secret-password' })
+    http = (await (await TestApp.fromApp(app)).actingAs(user).withCsrf('/login'))
+  })
+
+  const tagNames = async (postId: number) =>
+    (
+      await db
+        .select({ name: tags.name })
+        .from(postTags)
+        .innerJoin(tags, eq(tags.id, postTags.tagId))
+        .where(eq(postTags.postId, postId))
+    )
+      .map((row: { name: string }) => row.name)
+      .sort()
+
+  it('normalizes the field', () => {
+    expect(parseTagNames(' bun ,bun')).toEqual(['bun'])
+    expect(parseTagNames('a,,b,')).toEqual(['a', 'b'])
+    expect(parseTagNames(undefined)).toEqual([])
+  })
+
+  it('creates, edits and filters', async () => {
+    await http.post('/posts', post('bun, webdev')).assertStatus(303)
+    const [created] = (await db.select().from(posts).orderBy(posts.id)).slice(-1)
+    expect(await tagNames(created.id)).toEqual(['bun', 'webdev'])
+
+    await http.put(`/posts/${created.id}`, post('bun')).assertStatus(303)
+    expect(await tagNames(created.id)).toEqual(['bun'])
+
+    const index = await http.get('/posts?tag=bun').assertOk()
+    const listed = (await index.text()).match(/"tags":\[[^\]]*\]/g) ?? []
+    expect(listed.length).toBeGreaterThan(0)
+    expect(listed.every((t) => t.includes('"bun"'))).toBe(true)
+    const none = await http.get('/posts?tag=nobody-uses-this').assertOk()
+    expect(await none.text()).not.toContain('"tags"')
+
+    await http.delete(`/posts/${created.id}`).assertStatus(303)
+  })
+
+  it('refuses invalid tags without writing', async () => {
+    await http.post('/posts', { ...post(), title: '' }).assertStatus(422)
+    const before = (await db.select().from(posts)).length
+    await http.post('/posts', post('a,b,c,d,e,f')).assertStatus(422)
+    await http.post('/posts', post('x'.repeat(31))).assertStatus(422)
+    expect((await db.select().from(posts)).length).toBe(before)
+    await http.post('/posts', post('x'.repeat(30))).assertStatus(303)
+  })
+})
