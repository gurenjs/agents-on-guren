+import { Head, Link } from '@inertiajs/react'
+import type { PostRevisionSummary } from '@/app/Http/Controllers/PostRevisionController'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  revisions: PostRevisionSummary[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`Revisions of ${post.title}`} />
+      <section className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Revisions
+          </h1>
+          <p className="text-sm text-g-muted">
+            Earlier versions of{' '}
+            <Link href={route('posts.show', { id: post.id })} className="text-g-accent-text transition hover:underline">
+              {post.title}
+            </Link>
+            , newest first. Restoring keeps the current version as a new revision.
+          </p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No revisions yet. Each saved edit keeps the version it replaced.</p>
+        ) : (
+          <ul className="space-y-3">
+            {revisions.map((revision) => (
+              <li
+                key={revision.id}
+                className="flex items-center justify-between gap-4 rounded-g-card border border-g-line bg-g-panel p-4 shadow-g-card"
+              >
+                <div>
+                  <p className="font-bold text-g-heading">{revision.title}</p>
+                  <p className="font-mono text-xs text-g-muted">{new Date(revision.createdAt).toLocaleString()}</p>
+                </div>
+                <Link
+                  href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm(`Restore "${revision.title}"?`)}
+                  className="rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-1 text-sm font-bold text-g-text transition hover:border-g-muted"
+                >
+                  Restore
+                </Link>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        <footer className="border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </section>
+    </Layout>
+  )
+}
