new file mode 100644
index 0000000..e2fd199
--- /dev/null
+++ b/modules/newsletter/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,51 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { SubscribeSchema, UnsubscribeSchema, ConfirmTokenSchema } from '../Validators/NewsletterValidator.js'
+
+function generateToken(): string {
+  const array = new Uint8Array(16)
+  crypto.getRandomValues(array)
+  return Array.from(array, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+
+    const existing = await NewsletterSubscription.newQuery().where('email', '=', email).first()
+
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    const token = generateToken()
+
+    await NewsletterSubscription.create({ email, token })
+
+    const referer = this.request.header('Referer') || '/'
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenSchema)
+
+    const subscription = await NewsletterSubscription.newQuery().where('token', '=', token).first()
+
+    if (!subscription) {
+      return new Response(null, { status: 404 })
+    }
+
+    await NewsletterSubscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    const referer = this.request.header('Referer') || '/'
+    return this.redirect(referer)
+  }
+}
diff --git a/modules/newsletter/Http/Validators/NewsletterValidator.ts b/modules/newsletter/Http/Validators/NewsletterValidator.ts
new file mode 100644
index 0000000..959721e
--- /dev/null
+++ b/modules/newsletter/Http/Validators/NewsletterValidator.ts
@@ -0,0 +1,27 @@
+import { z } from 'zod'
+
+export const SubscribeSchema = z.object({
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const UnsubscribeSchema = z.object({
+  email: z
+    .string()
+    .trim()
+    .min(1, 'Email is required.')
+    .toLowerCase()
+    .pipe(z.email('The email address is badly formatted.')),
+})
+
+export const ConfirmTokenSchema = z.object({
+  token: z.string().trim().min(1, 'Token is required.'),
+})
+
+export type SubscribeInput = z.infer<typeof SubscribeSchema>
+export type UnsubscribeInput = z.infer<typeof UnsubscribeSchema>
+export type ConfirmTokenInput = z.infer<typeof ConfirmTokenSchema>
