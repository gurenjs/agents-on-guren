diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..ddd5c25
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,65 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeQueue, fakeMail } from '@guren/testing'
+import { setQueueDriver, setMailManager, createMailManager, processJob, getMailManager } from '@guren/core'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+const validPayload = {
+  name: 'Ada Lovelace',
+  email: 'ada@example.com',
+  password: 'password123',
+  passwordConfirmation: 'password123',
+}
+
+describe('RegisterController', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+  })
+
+  it('queues the welcome email instead of sending it inline, then sends it once the queue runs', async () => {
+    const queue = fakeQueue()
+    const mail = fakeMail()
+    setQueueDriver(queue.getDriver())
+
+    // Swap in a manager whose default transport is backed by the fake, but
+    // keep the same transport name the real config uses — that's the name
+    // WelcomeMail.queue() records in the job payload for the worker to look up.
+    const transportName = getMailManager()?.getDefaultTransportName() ?? 'log'
+    const fakeManager = createMailManager({ default: transportName })
+    fakeManager.registerTransport(transportName, () => mail.getTransport())
+    setMailManager(fakeManager)
+
+    const csrf = await http.withCsrf()
+    await csrf.post('/register', validPayload).assertRedirect('/dashboard')
+
+    // Registration itself must not have sent anything — only queued it.
+    mail.assertNothingSent()
+    expect(queue.getDriver().getJobs()).toHaveLength(1)
+
+    const processed = await processJob(queue.getDriver())
+    expect(processed).toBe(true)
+
+    mail.assertSentTimes(1)
+    mail.assertSentTo(validPayload.email)
+    mail.assertSentWithSubject(`Welcome to Guren, ${validPayload.name}!`)
+    mail.assertSentWithBodyContaining(validPayload.name)
+  })
+
+  it('queues and sends nothing when registration is refused', async () => {
+    const queue = fakeQueue()
+    const mail = fakeMail()
+    setQueueDriver(queue.getDriver())
+    setMailManager(createMailManager())
+
+    const csrf = await http.withCsrf()
+    await csrf
+      .post('/register', { ...validPayload, email: 'not-an-email' })
+      .assertUnprocessable()
+
+    queue.assertNothingPushed()
+    mail.assertNothingSent()
+  })
+})
