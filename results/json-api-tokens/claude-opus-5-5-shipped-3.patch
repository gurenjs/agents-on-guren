+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken, type Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/ApiPostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { apiTokenStore } from '../app/Auth/apiTokenStore.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api.token', createBearerTokenMiddleware({ store: apiTokenStore }))
+    // Keyed by token id, not user: each of a user's tokens gets its own budget.
+    // Runs after api.token, so only verified tokens reach it.
+    .aliasMiddleware('api.throttle', createRateLimitMiddleware({
+      limit: 60,
+      windowMs: 60_000,
+      keyPrefix: 'api-token:',
+      keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+      onRateLimited: (ctx, retryAfter) =>
+        ctx.json({ message: `Too many requests. Retry after ${retryAfter} seconds.` }, 429),
+    }))
+
+  router.group('/api', (api) => {
+    api.middleware('api.token', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}
