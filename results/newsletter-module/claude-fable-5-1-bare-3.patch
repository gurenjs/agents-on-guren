@@ -0,0 +1,21 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Checked by `guren check --arch` (and so `guren gate`). The zero-config
+// module boundary only guards a module's internals; these rules keep the
+// blog itself from depending on modules at all, so a module can be lifted
+// into another app as is.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message:
+        'The blog must not know the newsletter module exists. Wire modules only through src/app.ts.',
+    },
+  ],
+})
