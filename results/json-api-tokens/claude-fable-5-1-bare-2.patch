+    const before = await Post.newQuery().count()
+
+    expect((await browser.request('GET', '/api/posts')).status).toBe(401)
+    expect((await browser.request('POST', '/api/posts', validPost)).status).toBe(401)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
+
+describe('rate limit', () => {
+  it('answers the 61st request in a minute with 429, per token', async () => {
+    const browser = await signedIn('Ada')
+    const busy = await browser.createToken('cron')
+    const other = await browser.createToken('CI')
+
+    for (let count = 1; count <= API_RATE_LIMIT; count++) {
+      expect((await script('GET', '/api/posts', { token: busy.token })).status).toBe(200)
+    }
+
+    const limited = await script('GET', '/api/posts', { token: busy.token })
+    expect(limited.status).toBe(429)
+    expect(typeof (await limited.json())).toBe('object')
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(Number.isInteger(retryAfter)).toBe(true)
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    const before = await Post.newQuery().count()
+    expect((await script('POST', '/api/posts', { token: busy.token, body: validPost })).status).toBe(429)
+    expect(await Post.newQuery().count()).toBe(before)
+
+    expect((await script('GET', '/api/posts', { token: other.token })).status).toBe(200)
+  })
+
+  it('does not charge a token for requests that failed to authenticate', async () => {
+    const { id, token } = await (await signedIn('Ada')).createToken('CI')
+
+    for (let count = 0; count <= API_RATE_LIMIT; count++) {
+      const response = await script('GET', '/api/posts', { authorization: `Bearer ${id}|${'0'.repeat(64)}` })
+      expect(response.status).toBe(401)
+    }
+
+    expect((await script('GET', '/api/posts', { token })).status).toBe(200)
+  })
+})
