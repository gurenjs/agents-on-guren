+
+  describe('published-only filtering', () => {
+    let published: PostRecord
+    let unpublished: PostRecord
+    let decoy: PostRecord
+
+    beforeAll(async () => {
+      const author = await User.newQuery().where('email', DEMO_EMAIL).firstOrFail()
+
+      published = await Post.forceCreate({
+        title: 'zephyrquill marmalade launch notes',
