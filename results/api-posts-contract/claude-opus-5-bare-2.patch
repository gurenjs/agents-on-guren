@@ -0,0 +1,21 @@
+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { ApiListPostsQuerySchema } from '../app/Http/Validators/PostValidator.js'
+
+// Public, unauthenticated JSON for external consumers. Registered outside the
+// 'auth' scopes routes/web.ts opens on purpose — a partner has no session, and
+// a GET carries no CSRF token either way.
+export function registerApiRoutes(router: Router<'auth' | 'guest'>): void {
+  router.group('/api', (api) => {
+    // `query` declares the accepted parameters on the route itself, so the
+    // contract is visible to codegen and `guren audit` instead of living only
+    // in the controller; `resource` declares the response shape the controller
+    // builds with PostResource, which is what types the client's json().
+    api.get('/posts', {
+      name: 'api.posts.index',
+      query: ApiListPostsQuerySchema,
+      resource: { data: [PostResource] },
+    }, [ApiPostController, 'index'])
+  })
+}
