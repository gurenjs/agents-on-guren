diff --git a/app/Http/Middleware/ApiMiddleware.ts b/app/Http/Middleware/ApiMiddleware.ts
new file mode 100644
index 0000000..a8bc329
--- /dev/null
+++ b/app/Http/Middleware/ApiMiddleware.ts
@@ -0,0 +1,52 @@
+import {
+  AUTH_CONTEXT_KEY,
+  createRateLimitMiddleware,
+  MemoryRateLimitStore,
+  parseApiToken,
+  readBearerToken,
+  type AuthContext,
+  type requireAuthenticated,
+} from '@guren/core'
+
+type Middleware = ReturnType<typeof requireAuthenticated>
+
+/** Requests per minute each personal API token may make. */
+export const API_RATE_LIMIT = 60
+
+/**
+ * Authenticates an API request by its bearer token alone. A session cookie is
+ * not enough here, and a missing, malformed, unknown or revoked token answers
+ * 401 as JSON rather than redirecting to /login.
+ */
+export const requireApiToken: Middleware = async (ctx, next) => {
+  const auth = ctx.get(AUTH_CONTEXT_KEY) as AuthContext | undefined
+  const bearer = readBearerToken(ctx.req.header('Authorization'))
+
+  if (!auth || !bearer || !(await auth.guard('token').check())) {
+    return ctx.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  await next()
+}
+
+// One process-wide store, so every request with the same token counts against
+// the same window. Swap for RedisRateLimitStore when running several processes.
+const store = new MemoryRateLimitStore()
+
+/**
+ * Limits each token, not each user or IP, to API_RATE_LIMIT requests a minute.
+ * Runs after requireApiToken, so the id before the `|` belongs to a token that
+ * has already been verified. Over the limit it answers 429 with Retry-After.
+ */
+export const apiTokenRateLimit: Middleware = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: 60_000,
+  store,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => {
+    const bearer = readBearerToken(ctx.req.header('Authorization')) ?? ''
+    return parseApiToken(bearer)?.id ?? bearer
+  },
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests.', retryAfter }, 429),
+})
