+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface RevisionsPage {
+  component: string
+  props: { revisions: Array<{ id: number; title: string; createdAt: string }> }
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    stranger = await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret-password' })
+    post = await Post.forceCreate({ title: 'First', excerpt: 'First excerpt', body: 'First body', authorId: author.id })
+  })
+
+  async function edit(user: UserRecord, id: number, title: string) {
+    const csrf = await http.actingAs(user).withCsrf()
+    return csrf.put(`/posts/${id}`, { title, excerpt: `${title} excerpt`, body: `${title} body` })
+  }
+
+  async function restore(user: UserRecord, id: number, revisionId: number) {
+    const csrf = await http.actingAs(user).withCsrf()
+    return csrf.post(`/posts/${id}/revisions/${revisionId}/restore`)
+  }
+
+  async function revisionsPage(user: UserRecord, id: number): Promise<RevisionsPage> {
+    const response = await http.actingAs(user).withHeader('X-Inertia', 'true').get(`/posts/${id}/revisions`)
+    response.assertOk()
+    return response.json<RevisionsPage>()
+  }
+
+  function storedRevisions(postId: number) {
+    return PostRevision.where({ postId }).orderBy('id', 'asc').get()
+  }
+
+  it('keeps nothing when a post is created', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'New', excerpt: 'New excerpt', body: 'New body' }).assertRedirect()
+
+    expect(await PostRevision.all()).toHaveLength(0)
+  })
+
+  it('keeps the previous version on every successful edit', async () => {
+    const response = await edit(author, post.id, 'Second')
+    response.assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await storedRevisions(post.id)
+    expect(revisions).toHaveLength(1)
+    expect(revisions[0]).toMatchObject({
+      postId: post.id,
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+    })
+    expect(new Date(revisions[0].createdAt).toISOString()).toBe(revisions[0].createdAt)
+    expect(await Post.findOrFail(post.id)).toMatchObject({ title: 'Second', body: 'Second body' })
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const invalid = await http.actingAs(author).withCsrf()
+    await invalid.json().put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+
+    const forbidden = await edit(stranger, post.id, 'Hijacked')
+    forbidden.assertForbidden()
+
+    expect(await PostRevision.all()).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('keeps nothing when the save itself fails', async () => {
+    // A null title violates NOT NULL after the revision row is written.
+    const content = { title: null as unknown as string, excerpt: 'x', body: 'y' }
+
+    await expect(Post.revise(post.id, content)).rejects.toThrow()
+
+    expect(await PostRevision.all()).toHaveLength(0)
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    await edit(author, post.id, 'Second')
+    await edit(author, post.id, 'Third')
+
+    const page = await revisionsPage(author, post.id)
+
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    const stored = await storedRevisions(post.id)
+    expect(page.props.revisions.map((revision) => revision.id)).toEqual(stored.map((revision) => revision.id).reverse())
+    for (const revision of page.props.revisions) {
+      expect(Number.isNaN(Date.parse(revision.createdAt))).toBe(false)
+    }
+  })
+
+  it('restores a revision and keeps the version it replaces', async () => {
+    await edit(author, post.id, 'Second')
+    await edit(author, post.id, 'Third')
+    const [first] = await storedRevisions(post.id)
+
+    const response = await restore(author, post.id, first.id)
+    response.assertRedirect(`/posts/${post.id}`)
+
+    expect(await Post.findOrFail(post.id)).toMatchObject({
+      title: 'First',
+      excerpt: 'First excerpt',
+      body: 'First body',
+    })
+    const page = await revisionsPage(author, post.id)
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses everyone but the author', async () => {
+    await edit(author, post.id, 'Second')
+    const [revision] = await storedRevisions(post.id)
+
+    await http.actingAs(stranger).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const response = await restore(stranger, post.id, revision.id)
+    response.assertForbidden()
+
+    expect(await storedRevisions(post.id)).toHaveLength(1)
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+  })
+
+  it('sends guests to the login page', async () => {
+    await edit(author, post.id, 'Second')
+    const [revision] = await storedRevisions(post.id)
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect(await storedRevisions(post.id)).toHaveLength(1)
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+  })
+
+  it('answers 404 for a revision of another post by the same author', async () => {
+    const other = await Post.forceCreate({ title: 'Other', excerpt: 'Other excerpt', body: 'Other body', authorId: author.id })
+    await edit(author, other.id, 'Other, edited')
+    const [foreign] = await storedRevisions(other.id)
+
+    const response = await restore(author, post.id, foreign.id)
+    response.assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect(await storedRevisions(post.id)).toHaveLength(0)
+    expect(await storedRevisions(other.id)).toHaveLength(1)
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const other = await Post.forceCreate({ title: 'Other', excerpt: 'Other excerpt', body: 'Other body', authorId: author.id })
+    await edit(author, post.id, 'Second')
+    await edit(author, other.id, 'Other, edited')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await storedRevisions(post.id)).toHaveLength(0)
+    expect(await storedRevisions(other.id)).toHaveLength(1)
+  })
+})
