diff --git a/tests/McpEndpoint.test.ts b/tests/McpEndpoint.test.ts
new file mode 100644
index 0000000..8851b03
--- /dev/null
+++ b/tests/McpEndpoint.test.ts
@@ -0,0 +1,140 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface JsonRpcResponse {
+  result?: {
+    tools?: Array<{ name: string; annotations?: { readOnlyHint?: boolean } }>
+    content?: Array<{ type: string; text?: string }>
+    structuredContent?: unknown
+    isError?: boolean
+  }
+  error?: { code: number; message: string }
+}
+
+// The endpoint may answer JSON or an SSE stream; either way the JSON-RPC
+// response is the last `data:` payload (or the whole body).
+async function rpc(client: TestApp, method: string, params: unknown = {}): Promise<{ status: number; body: JsonRpcResponse | null }> {
+  const res = await client
+    .json()
+    .withHeader('Accept', 'application/json, text/event-stream')
+    .post('/mcp', { jsonrpc: '2.0', id: 1, method, params })
+  const text = await res.text()
+  const dataLines = text.split('\n').filter((line) => line.startsWith('data:'))
+  const payload = dataLines.length > 0 ? dataLines[dataLines.length - 1]!.slice(5).trim() : text
+  let body: JsonRpcResponse | null = null
+  try {
+    body = JSON.parse(payload) as JsonRpcResponse
+  } catch {
+    body = null
+  }
+  return { status: res.status, body }
+}
+
+function toolResultJson(body: JsonRpcResponse | null): Record<string, unknown> {
+  const result = body?.result
+  if (result?.structuredContent && typeof result.structuredContent === 'object') {
+    return result.structuredContent as Record<string, unknown>
+  }
+  const text = result?.content?.find((c) => c.type === 'text')?.text ?? '{}'
+  return JSON.parse(text) as Record<string, unknown>
+}
+
+describe('MCP endpoint', () => {
+  let http: TestApp
+  let bearer: TestApp
+  let user: UserRecord
+  const stamp = Date.now()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = (await User.create({
+      name: 'Agent Owner',
+      email: `agent-owner-${stamp}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('api token store not configured')
+    const { plainTextToken } = await createApiToken(store, {
+      name: 'assistant',
+      userId: user.id,
+      abilities: ['tools:*'],
+    })
+    bearer = http.withHeader('Authorization', `Bearer ${plainTextToken}`)
+  })
+
+  it('refuses a call without a credential', async () => {
+    const { status } = await rpc(http, 'tools/list')
+    expect(status).toBe(401)
+  })
+
+  it('lists posts_search as read-only and posts_store as not', async () => {
+    const { status, body } = await rpc(bearer, 'tools/list')
+    expect(status).toBe(200)
+    const tools = (body?.result?.tools ?? []).filter((t) => !t.name.startsWith('guren_'))
+    const names = tools.map((t) => t.name).sort()
+    expect(names).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((t) => t.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((t) => t.name === 'posts_store')?.annotations?.readOnlyHint ?? false).toBe(false)
+  })
+
+  it('posts_store creates the post as the token user and ignores authorId', async () => {
+    const other = (await User.create({
+      name: 'Someone Else',
+      email: `someone-else-${stamp}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+    const title = `MCP post ${stamp}`
+    const { status, body } = await rpc(bearer, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title, excerpt: 'From an assistant', body: 'Hello from MCP', authorId: other.id },
+    })
+    expect(status).toBe(200)
+    expect(body?.result?.isError ?? false).toBe(false)
+
+    const post = await Post.first({ title })
+    expect(post).not.toBeNull()
+    expect(post?.authorId).toBe(user.id)
+    expect(toolResultJson(body)).toMatchObject({ data: { id: post?.id, title } })
+  })
+
+  it('posts_store rejects an empty title as an error result and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+    const { body } = await rpc(bearer, 'tools/call', {
+      name: 'posts_store',
+      arguments: { title: '', excerpt: 'x', body: 'y' },
+    })
+    expect(body?.result?.isError).toBe(true)
+    expect(toolResultJson(body)).toMatchObject({ errors: { title: expect.any(Array) } })
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  // The wire result carries no HTTP status; the testing bridge does.
+  it('posts_store answers 422 for invalid input and refuses a guest', async () => {
+    const before = await Post.newQuery().count()
+    const signedIn = (await http.actingAs(user).withCsrf('/posts')).agent()
+    await signedIn.call('posts_store', { title: '', excerpt: 'x', body: 'y' }).assertStatus(422)
+
+    const guest = await http.agent().call('posts_store', { title: 'Guest', excerpt: 'x', body: 'y' })
+    expect([302, 303, 401, 403]).toContain(guest.status)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('posts_search returns the same JSON as QUERY /posts/search', async () => {
+    const keyword = `mcp-search-${stamp}`
+    await Post.forceCreate({ title: `Bun and ${keyword}`, excerpt: 'e', body: 'b', authorId: user.id })
+
+    const direct = await http.query('/posts/search', { keywords: [keyword] }).assertOk()
+    const expected = await direct.json<Record<string, unknown>>()
+
+    const { body } = await rpc(bearer, 'tools/call', {
+      name: 'posts_search',
+      arguments: { keywords: [keyword] },
+    })
+    expect(body?.result?.isError ?? false).toBe(false)
+    expect(toolResultJson(body)).toEqual(expected)
+  })
+})
