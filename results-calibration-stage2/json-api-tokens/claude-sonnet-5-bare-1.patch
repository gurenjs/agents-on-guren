+            {tokens.map((token) => (
+              <li key={token.id} className="flex items-center justify-between text-sm text-g-text">
+                <span>{token.name}</span>
+                <button type="button" onClick={() => revokeToken(token.id)} className="text-g-danger">
+                  Revoke
+                </button>
+              </li>
+            ))}
+          </ul>
+          <form className="flex gap-2" onSubmit={createToken}>
+            <input
+              type="text"
+              value={tokenName}
+              onChange={(event) => setTokenName(event.target.value)}
+              placeholder="Token name"
+              className="w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text outline-none"
+            />
+            <button type="submit" className="rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent">
+              Create
+            </button>
+          </form>
+          {tokenError ? <p className="text-sm text-g-danger">{tokenError}</p> : null}
+        </div>
       </section>
     </Layout>
   )
