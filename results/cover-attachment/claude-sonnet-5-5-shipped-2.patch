diff --git a/app/Support/CoverStorage.ts b/app/Support/CoverStorage.ts
new file mode 100644
index 0000000..fd9913d
--- /dev/null
+++ b/app/Support/CoverStorage.ts
@@ -0,0 +1,45 @@
+import { mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPES: Record<string, string> = { 'image/png': 'png', 'image/jpeg': 'jpg' }
+
+// Outside `public/`, which is served as-is; the app streams these back itself.
+const COVER_DIR = join(process.cwd(), 'storage', 'covers')
+
+export function coverUrl(cover: Pick<AttachmentRecord, 'id'> | null | undefined): string | null {
+  return cover ? `/attachments/${cover.id}` : null
+}
+
+export function coverFile(cover: Pick<AttachmentRecord, 'path'>): string {
+  return join(COVER_DIR, cover.path)
+}
+
+/** Replaces the post's cover with `file`: the old row and its file are gone afterwards. */
+export async function replaceCover(postId: number, file: File): Promise<void> {
+  await mkdir(COVER_DIR, { recursive: true })
+  const path = `${crypto.randomUUID()}.${COVER_TYPES[file.type]}`
+  await Bun.write(join(COVER_DIR, path), file)
+
+  try {
+    await removeCover(postId)
+    await Attachment.create({
+      postId,
+      path,
+      mime: file.type,
+      originalName: file.name,
+      size: file.size,
+    })
+  } catch (error) {
+    await rm(join(COVER_DIR, path), { force: true })
+    throw error
+  }
+}
+
+export async function removeCover(postId: number): Promise<void> {
+  const existing = await Attachment.first({ postId })
+  if (!existing) return
+  await Attachment.delete({ id: existing.id })
+  await rm(coverFile(existing), { force: true })
+}
