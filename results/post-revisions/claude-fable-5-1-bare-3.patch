diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..90867fe
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,37 @@
+import { defineModel, type BelongsToRecord, type TransactionHandle } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+export type NewPostRevisionRecord = typeof postRevisions.$inferInsert
+
+/** The columns a revision snapshots; the rest of a post is out of scope. */
+export type PostRevisionSnapshot = Pick<PostRecord, 'id' | 'title' | 'excerpt' | 'body'>
+
+export class PostRevision extends defineModel(postRevisions, {
+  // Revisions are only ever written by the app from an existing post, never
+  // from request input, so nothing is mass-assignable.
+  fillable: [],
+}) {
+  static override relationTypes: { post: BelongsToRecord<PostRecord> } = {
+    post: null,
+  }
+
+  /**
+   * Keeps the version `post` has right now, so it can be restored later.
+   * Call it before overwriting the post, inside the same transaction.
+   */
+  static keep(post: PostRevisionSnapshot, options?: { trx?: TransactionHandle }): Promise<PostRevisionRecord> {
+    return PostRevision.forceCreate(
+      {
+        postId: post.id,
+        title: post.title,
+        excerpt: post.excerpt,
+        body: post.body,
+      },
+      options,
+    )
+  }
+}
+
+PostRevision.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
diff --git a/app/Policies/PostPolicy.ts b/app/Policies/PostPolicy.ts
