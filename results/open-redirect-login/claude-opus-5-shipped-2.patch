@@ -0,0 +1,89 @@
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
+import { TestApp, type TestResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+const CREDENTIALS = { email: 'ada@example.com', password: 'correct-horse' }
+
+/** Replays the cookies a response set, so a later request keeps the session. */
+function cookieHeader(response: TestResponse): string {
+  return response.headers
+    .getSetCookie()
+    .map((cookie) => cookie.split(';')[0])
+    .join('; ')
+}
+
+describe('LoginController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await User.create({ name: 'Ada', ...CREDENTIALS })
+  })
+
+  async function signIn(body: Record<string, unknown> = {}): Promise<TestResponse> {
+    const csrf = await http.withCsrf()
+    return csrf.post('/login', { ...CREDENTIALS, ...body })
+  }
+
+  describe('post-login destination', () => {
+    it('uses the default destination when no redirect is given', async () => {
+      const response = await signIn()
+      response.assertRedirect('/dashboard')
+    })
+
+    it('returns the user to the in-app page they came from', async () => {
+      const response = await signIn({ redirect: '/posts/3/edit' })
+      response.assertRedirect('/posts/3/edit')
+    })
+
+    it('ignores a redirect pointing at another site', async () => {
+      for (const redirect of [
+        'https://evil.example',
+        '//evil.example',
+        '/\\evil.example',
+        '\\\\evil.example',
+        'http://evil.example/login',
+      ]) {
+        const response = await signIn({ redirect })
+        response.assertRedirect('/dashboard')
+      }
+    })
+
+    it('ignores an off-site redirect passed in the query string', async () => {
+      const csrf = await http.withCsrf()
+      const response = await csrf.post('/login?redirect=https://evil.example', CREDENTIALS)
+      response.assertRedirect('/dashboard')
+    })
+
+    it('drops an off-site redirect from the login page props', async () => {
+      await http
+        .withHeaders({ 'X-Inertia': 'true', 'X-Requested-With': 'XMLHttpRequest' })
+        .get('/login?redirect=https://evil.example')
+        .assertInertia('auth/Login', { redirect: '' })
+    })
+  })
+
+  describe('authentication itself', () => {
+    it('signs the user in even when the redirect was rejected', async () => {
+      const response = await signIn({ redirect: 'https://evil.example' })
+      response.assertRedirect('/dashboard')
+      // Authenticated for real: /dashboard sits behind the auth middleware.
+      await http.withHeader('Cookie', cookieHeader(response)).get('/dashboard').assertOk()
+    })
+
+    it('rejects a wrong password without creating a session', async () => {
+      const response = await signIn({ password: 'nope' })
+      response.assertStatus(422)
+      await http
+        .withHeader('Cookie', cookieHeader(response))
+        .get('/dashboard')
+        .assertRedirect('/login')
+    })
+  })
+})
diff --git a/tests/SafeRedirect.test.ts b/tests/SafeRedirect.test.ts
new file mode 100644
