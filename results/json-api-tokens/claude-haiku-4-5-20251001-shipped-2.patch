new file mode 100644
index 0000000..1bf59d8
--- /dev/null
+++ b/app/Http/Middleware/BearerTokenAuth.ts
@@ -0,0 +1,33 @@
+import { defineMiddleware, HttpException } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { User, type UserRecord } from '../../Models/User.js'
+
+async function hashToken(token: string): Promise<string> {
+  const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(token))
+  return Array.from(new Uint8Array(buffer), (b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+export async function authenticateBearer(token: string): Promise<UserRecord | null> {
+  const tokenHash = await hashToken(token)
+  const bearerToken = await ApiToken.where({ tokenHash }).first()
+  if (!bearerToken) return null
+
+  return await User.find(bearerToken.userId)
+}
+
+export const bearerTokenAuth = defineMiddleware(async (c, next) => {
+  const authHeader = c.req.header('Authorization')
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    return await next()
+  }
+
+  const token = authHeader.slice(7)
+  const user = await authenticateBearer(token)
+  if (!user) {
+    throw HttpException.unauthorized('Invalid or revoked token')
+  }
+
+  c.set('apiTokenUser', user)
+  c.set('apiToken', token)
+  return await next()
+})
