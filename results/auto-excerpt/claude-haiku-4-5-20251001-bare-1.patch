+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+
+  if (trimmed.length <= 140) {
+    return trimmed
+  }
+
+  const first140 = trimmed.slice(0, 140)
+  const char141 = trimmed[140]
+
+  let excerpt: string
+
+  // If character 141 is whitespace, keep all 140 characters
+  if (char141 && /\s/.test(char141)) {
+    excerpt = first140
+  } else {
+    // Character 141 is non-whitespace, need to find last whitespace before it
+    let lastWhitespaceIndex = -1
+    for (let i = first140.length - 1; i >= 0; i--) {
+      if (/\s/.test(first140[i])) {
+        lastWhitespaceIndex = i
+        break
+      }
+    }
+
+    if (lastWhitespaceIndex === -1) {
+      // No whitespace found in first 140 characters, cut at 140
+      excerpt = first140
+    } else {
+      // Cut at the last whitespace
+      excerpt = first140.slice(0, lastWhitespaceIndex)
+    }
+  }
+
+  // Trim trailing whitespace and add ellipsis
+  return excerpt.trimEnd() + '…'
+}
