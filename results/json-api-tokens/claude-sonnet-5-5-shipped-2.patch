diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..2c93873
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,45 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const RATE_LIMIT = 60
+const WINDOW_MS = 60_000
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+// Per process and keyed by token id, so each token gets its own budget.
+const windows = new Map<number, { start: number; count: number }>()
+
+function hit(tokenId: number, now: number): number | null {
+  let entry = windows.get(tokenId)
+  if (!entry || now - entry.start >= WINDOW_MS) {
+    entry = { start: now, count: 0 }
+    windows.set(tokenId, entry)
+  }
+  entry.count += 1
+  if (entry.count <= RATE_LIMIT) return null
+  return Math.min(60, Math.max(1, Math.ceil((entry.start + WINDOW_MS - now) / 1000)))
+}
+
+export function forgetRateLimit(tokenId: number): void {
+  windows.delete(tokenId)
+}
+
+export const apiTokenAuth = defineMiddleware(async (c, next) => {
+  const header = c.req.header('authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]{16,256})$/.exec(header)
+  const record = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]!) }) : null
+  if (!record) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const retryAfter = hit(record.id, Date.now())
+  if (retryAfter !== null) {
+    return c.json({ message: 'Too many requests.' }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  c.set('apiTokenUserId', record.userId)
+  await next()
+})
