+export function parseTagNames(input: string | string[] | null | undefined): string[] {
+  const entries = Array.isArray(input) ? input : (input ?? '').split(',')
+  const names = entries.map((entry) => entry.trim()).filter((entry) => entry.length > 0)
+  return [...new Set(names)]
