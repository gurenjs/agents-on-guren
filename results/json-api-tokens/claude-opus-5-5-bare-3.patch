diff --git a/app/Auth/DatabaseApiTokenStore.ts b/app/Auth/DatabaseApiTokenStore.ts
new file mode 100644
index 0000000..7dd7e9d
--- /dev/null
+++ b/app/Auth/DatabaseApiTokenStore.ts
@@ -0,0 +1,57 @@
+import type { ApiToken as ApiTokenData, ApiTokenStore } from '@guren/core'
+import { ApiToken, type ApiTokenRecord } from '../Models/ApiToken.js'
+
+function toTokenData(record: ApiTokenRecord): ApiTokenData {
+  return {
+    id: record.id,
+    name: record.name,
+    hashedToken: record.tokenHash,
+    userId: record.userId,
+    abilities: JSON.parse(record.abilities) as string[],
+    lastUsedAt: record.lastUsedAt ? new Date(record.lastUsedAt) : null,
+    expiresAt: record.expiresAt ? new Date(record.expiresAt) : null,
+    createdAt: new Date(record.createdAt),
+  }
+}
+
+/**
+ * Keeps personal API tokens in the `api_tokens` table. The framework hands
+ * this store only the SHA-256 of a token's secret, so the plain token never
+ * reaches the database.
+ */
+export class DatabaseApiTokenStore implements ApiTokenStore {
+  async store(token: ApiTokenData): Promise<void> {
+    await ApiToken.forceCreate({
+      id: token.id,
+      name: token.name,
+      tokenHash: token.hashedToken,
+      userId: Number(token.userId),
+      abilities: JSON.stringify(token.abilities),
+      lastUsedAt: token.lastUsedAt?.toISOString() ?? null,
+      expiresAt: token.expiresAt?.toISOString() ?? null,
+      createdAt: token.createdAt.toISOString(),
+    })
+  }
+
+  async findByHashedToken(hashedToken: string): Promise<ApiTokenData | null> {
+    const record = await ApiToken.first({ tokenHash: hashedToken })
+    return record ? toTokenData(record) : null
+  }
+
+  async findByUserId(userId: string | number): Promise<ApiTokenData[]> {
+    const records = await ApiToken.where({ userId: Number(userId) }).orderBy('createdAt', 'desc').get()
+    return records.map(toTokenData)
+  }
+
+  async delete(id: string): Promise<void> {
+    await ApiToken.delete({ id })
+  }
+
+  async deleteForUser(userId: string | number): Promise<void> {
+    await ApiToken.delete({ userId: Number(userId) })
+  }
+
+  async updateLastUsed(id: string, timestamp: Date): Promise<void> {
+    await ApiToken.forceUpdate({ id }, { lastUsedAt: timestamp.toISOString() })
+  }
+}
