+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+async function createUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: `Api ${label}`,
+    email: `api-${label}-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+    password: 'secret123',
+  })
+  if (!user) throw new Error('user not created')
+  return user as UserRecord
+}
+
+describe('JSON posts API', () => {
+  let http: TestApp
+  let user: UserRecord
+  let token: string
+
+  async function issueToken(who: UserRecord, name: string): Promise<string> {
+    const session = await http.actingAs(who).withCsrf('/profile')
+    const response = await session.json().post('/profile/tokens', { name })
+    expect(response.status).toBe(201)
+    return ((await response.json()) as { token: string }).token
+  }
+
+  function bearer(value: string) {
+    return http.json().withHeader('Authorization', `Bearer ${value}`)
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await createUser('author')
+    token = await issueToken(user, 'CI')
+  })
+
+  it('lists every post newest first for a valid token', async () => {
+    const other = await createUser('colleague')
+    const older = await Post.forceCreate({ title: 'Older api post', excerpt: 'e', body: 'b', authorId: other.id })
+    const newer = await Post.forceCreate({ title: 'Newer api post', excerpt: 'e', body: 'b', authorId: user.id })
+
+    const response = await bearer(token).get('/api/posts')
+    expect(response.status).toBe(200)
+    const payload = (await response.json()) as { data: ApiPost[] }
+
+    const ids = payload.data.map((post) => post.id)
+    expect(ids.indexOf(newer!.id)).toBeLessThan(ids.indexOf(older!.id))
+    expect(ids).toContain(older!.id)
+
+    const first = payload.data[0]!
+    for (const key of ['id', 'title', 'excerpt', 'authorId', 'createdAt']) {
+      expect(first).toHaveProperty(key)
+    }
+    expect(new Date(first.createdAt).toISOString()).toBe(first.createdAt)
+  })
+
+  it("creates a post owned by the token's owner, ignoring authorId in the body", async () => {
+    const impostor = await createUser('impostor')
+    const response = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'Posted from CI',
+      body: 'All green.',
+      authorId: impostor.id,
+    })
+    expect(response.status).toBe(201)
+
+    const { data } = (await response.json()) as { data: ApiPost }
+    expect(data.title).toBe('Release notes')
+    expect(data.authorId).toBe(user.id)
+    expect(typeof data.createdAt).toBe('string')
+
+    const stored = await Post.find(data.id)
+    expect(stored?.authorId).toBe(user.id)
+  })
+
+  it('answers 422 with JSON for input the web form would reject', async () => {
+    const before = (await Post.all()).length
+
+    const empty = await bearer(token).post('/api/posts', { title: '', excerpt: 'x', body: 'y' })
+    expect(empty.status).toBe(422)
+    expect(empty.headers.get('content-type')).toContain('application/json')
+
+    await bearer(token).post('/api/posts', { title: 'No body', excerpt: 'x' }).assertStatus(422)
+
+    expect((await Post.all()).length).toBe(before)
+  })
+
+  it('answers 401 JSON for missing, malformed, unknown, tampered and revoked tokens', async () => {
+    const missing = await http.json().get('/api/posts')
+    expect(missing.status).toBe(401)
+    expect(missing.headers.get('content-type')).toContain('application/json')
+
+    await http.json().withHeader('Authorization', 'Bearer').get('/api/posts').assertStatus(401)
+    await http.json().withHeader('Authorization', 'Basic abc').get('/api/posts').assertStatus(401)
+    await bearer('not-a-token').get('/api/posts').assertStatus(401)
+    await bearer('unknownid|' + 'a'.repeat(43)).get('/api/posts').assertStatus(401)
+
+    const [id, secret] = token.split('|')
+    const flipped = secret!.at(-1) === 'a' ? 'b' : 'a'
+    await bearer(`${id}|${secret!.slice(0, -1)}${flipped}`).get('/api/posts').assertStatus(401)
+
+    const before = (await Post.all()).length
+    const write = await bearer('not-a-token').post('/api/posts', { title: 't', excerpt: 'e', body: 'b' })
+    expect(write.status).toBe(401)
+    expect((await Post.all()).length).toBe(before)
+  })
+
+  it('limits each token to 60 requests a minute, independently of sibling tokens', async () => {
+    const limited = await issueToken(user, 'busy script')
+    const sibling = await issueToken(user, 'quiet script')
+
+    for (let i = 0; i < 60; i += 1) {
+      await bearer(limited).get('/api/posts').assertStatus(200)
+    }
+
+    const throttled = await bearer(limited).get('/api/posts')
+    expect(throttled.status).toBe(429)
+    const retryAfter = Number(throttled.headers.get('retry-after'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(sibling).get('/api/posts').assertStatus(200)
+  })
+})
