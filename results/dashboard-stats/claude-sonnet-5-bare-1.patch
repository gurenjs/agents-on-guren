diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..fd13434
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,72 @@
+import { beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('dashboard', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects a guest to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it("reports the signed-in user's post count and 5 most recent posts, newest first", async () => {
+    const owner = await User.forceCreate({ name: 'Owner', email: 'owner@example.com', password: 'password' })
+    const other = await User.forceCreate({ name: 'Other', email: 'other@example.com', password: 'password' })
+
+    await Post.forceCreate({
+      title: 'Someone else post',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: other.id,
+      createdAt: '2024-01-10T00:00:00.000Z',
+    })
+
+    const ownPosts = []
+    for (let i = 1; i <= 6; i++) {
+      ownPosts.push(
+        await Post.forceCreate({
+          title: `Post ${i}`,
+          excerpt: 'excerpt',
+          body: 'body',
+          authorId: owner.id,
+          createdAt: `2024-01-0${i}T00:00:00.000Z`,
+        }),
+      )
+    }
+
+    await http
+      .actingAs(owner)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', {
+        postCount: 6,
+        recentPosts: [
+          { id: ownPosts[5].id, title: 'Post 6' },
+          { id: ownPosts[4].id, title: 'Post 5' },
+          { id: ownPosts[3].id, title: 'Post 4' },
+          { id: ownPosts[2].id, title: 'Post 3' },
+          { id: ownPosts[1].id, title: 'Post 2' },
+        ],
+      })
+  })
+
+  it('shows an empty state for a user with no posts', async () => {
+    const user = await User.forceCreate({ name: 'Empty', email: 'empty@example.com', password: 'password' })
+
+    await http
+      .actingAs(user)
+      .json()
+      .get('/dashboard')
+      .assertOk()
+      .assertInertia('dashboard/Index', { postCount: 0, recentPosts: [] })
+  })
+})
