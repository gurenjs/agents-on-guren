@@ -0,0 +1,22 @@
+import { createMailManager, type MailConfig } from '@guren/core'
+
+// MAIL_MAILER=log writes messages to the server console instead of
+// delivering them — the default for development. Production switches this
+// to a real provider (e.g. resend) with no code change.
+function resolveMailer(): string {
+  return process.env.MAIL_MAILER ?? 'log'
+}
+
+const config: MailConfig = {
+  default: resolveMailer(),
+  from: {
+    email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME,
+  },
+  transports: {
+    log: { driver: 'log' },
+    resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+  },
+}
+
+export const mailManager = createMailManager(config)
