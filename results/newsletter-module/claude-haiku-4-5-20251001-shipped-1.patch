@@ -0,0 +1,48 @@
+import { Controller, HttpException } from '@guren/core'
+import { randomBytes } from 'node:crypto'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { SubscribeSchema, UnsubscribeSchema } from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const email = await this.validateBody(SubscribeSchema)
+
+    const existing = await NewsletterSubscription.first({ email: email.email })
+    if (!existing) {
+      const token = randomBytes(32).toString('hex')
+      await NewsletterSubscription.create({
+        email: email.email,
+        token,
+      })
+    }
+
+    const referer = this.ctx.req.header('Referer') || '/'
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { params } = this.validated('newsletter.confirm')
+    const { token } = params
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw HttpException.notFound()
+    }
+
+    await NewsletterSubscription.update(
+      { token },
+      { confirmedAt: new Date().toISOString() }
+    )
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const data = await this.validateBody(UnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email: data.email })
+
+    const referer = this.ctx.req.header('Referer') || '/'
+    return this.redirect(referer)
+  }
+}
