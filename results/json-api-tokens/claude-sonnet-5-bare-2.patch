diff --git a/app/Http/Middleware/ApiAuth.ts b/app/Http/Middleware/ApiAuth.ts
new file mode 100644
index 0000000..5b452fd
--- /dev/null
+++ b/app/Http/Middleware/ApiAuth.ts
@@ -0,0 +1,43 @@
+import { createBearerTokenMiddleware, getApiToken } from '@guren/core'
+import type { MiddlewareHandler } from 'hono'
+import { apiTokenStore } from '../../Models/ApiToken.js'
+import { User } from '../../Models/User.js'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Sliding window of request times per token id. Per process, like the rest of
+// the starter's in-memory defaults.
+const hits = new Map<string, number[]>()
+
+const unauthorized = (ctx: Parameters<MiddlewareHandler>[0]) =>
+  ctx.json({ message: 'Unauthenticated.' }, 401)
+
+const authenticate = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: (userId) => User.find(userId as number),
+  onUnauthorized: unauthorized,
+})
+
+// Counts against the token, not the account, so one user's tokens are
+// limited independently.
+const throttle: MiddlewareHandler = async (ctx, next) => {
+  const tokenId = getApiToken(ctx)?.token.id
+  if (!tokenId) return unauthorized(ctx)
+
+  const now = Date.now()
+  const recent = (hits.get(tokenId) ?? []).filter((at) => now - at < WINDOW_MS)
+
+  if (recent.length >= LIMIT) {
+    hits.set(tokenId, recent)
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((recent[0]! + WINDOW_MS - now) / 1000)))
+    ctx.header('Retry-After', String(retryAfter))
+    return ctx.json({ message: 'Too many requests.' }, 429)
+  }
+
+  recent.push(now)
+  hits.set(tokenId, recent)
+  return next()
+}
+
+export const apiAuth: MiddlewareHandler[] = [authenticate, throttle]
