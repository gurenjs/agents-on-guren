diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..3609137
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+const GIF = new TextEncoder().encode('GIF89a-not-an-image')
+
+function form(fields: Record<string, string>, cover?: [Uint8Array, string, string]): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', new File([cover[0] as BlobPart], cover[1], { type: cover[2] }))
+  return data
+}
+
+const fields = { title: 'Hello', excerpt: 'Short', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function author() {
+    const user = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    return http.actingAs(user as never).withCsrf()
+  }
+
+  it('stores, serves, replaces and removes a cover', async () => {
+    const client = await author()
+    await client.post('/posts', form(fields, [PNG, 'c.png', 'image/png'])).assertRedirect()
+
+    const post = (await Post.all())[0]!
+    const [row] = await Attachment.all()
+    expect(row).toBeDefined()
+    const served = await http.get(`/attachments/${row!.id}`)
+    expect(served.status).toBe(200)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(Number(served.headers.get('content-length'))).toBe(PNG.length)
+
+    await client.put(`/posts/${post.id}`, form(fields, [PNG, 'd.png', 'image/png'])).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+    expect((await http.get(`/attachments/${row!.id}`)).status).toBe(404)
+
+    await client.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+  })
+
+  it('refuses a GIF and saves nothing', async () => {
+    const client = await author()
+    const res = await client.json().post('/posts', form(fields, [GIF, 'c.gif', 'image/gif']))
+    expect(res.status).toBe(422)
+    expect((await Post.all()).length).toBe(0)
+    expect((await Attachment.all()).length).toBe(0)
+  })
+})
