diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..f6c3927
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,67 @@
+import { defineModel, type ModelQueryOptions } from '@guren/core'
+import { postTags, tags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+export type PostTagRecord = typeof postTags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {
+  /** Tag names per post id, sorted alphabetically; posts without tags map to `[]`. */
+  static async namesForPosts(postIds: readonly number[]): Promise<Map<number, string[]>> {
+    const names = new Map<number, string[]>(postIds.map((id) => [id, []]))
+    if (postIds.length === 0) {
+      return names
+    }
+
+    const links = await PostTag.whereIn('postId', postIds).get()
+    const tagIds = [...new Set(links.map((link) => link.tagId))]
+    const tagRows = tagIds.length > 0 ? await Tag.whereIn('id', tagIds).get() : []
+    const nameById = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+
+    for (const link of links) {
+      const name = nameById.get(link.tagId)
+      if (name !== undefined) {
+        names.get(link.postId)?.push(name)
+      }
+    }
+    for (const list of names.values()) {
+      list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+    }
+    return names
+  }
+
+  /**
+   * Makes `names` exactly the post's tags: unknown names become new tags,
+   * listed ones are attached, and the rest are detached from the post.
+   */
+  static async syncForPost(postId: number, names: readonly string[], writeOptions?: ModelQueryOptions): Promise<void> {
+    const existing = names.length > 0 ? await Tag.newQuery(writeOptions).whereIn('name', names).get() : []
+    const idByName = new Map(existing.map((tag) => [tag.name, tag.id]))
+    for (const name of names) {
+      if (!idByName.has(name)) {
+        const created = await Tag.create({ name }, writeOptions)
+        idByName.set(name, created.id)
+      }
+    }
+
+    const wanted = new Set(idByName.values())
+    const current = await PostTag.newQuery(writeOptions).where('postId', postId).get()
+    const currentIds = new Set(current.map((link) => link.tagId))
+
+    const stale = [...currentIds].filter((tagId) => !wanted.has(tagId))
+    if (stale.length > 0) {
+      await PostTag.newQuery(writeOptions).where('postId', postId).whereIn('tagId', stale).delete()
+    }
+    for (const tagId of wanted) {
+      if (!currentIds.has(tagId)) {
+        await PostTag.create({ postId, tagId }, writeOptions)
+      }
+    }
+  }
+}
+
+/** One row per tag attached to a post. */
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
