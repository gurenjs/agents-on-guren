new file mode 100644
index 0000000..2ce2c7c
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,21 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Checked by `bunx guren check --arch` (and the full `guren check`). Modules
+// under modules/<name>/ are self-contained so they can be lifted into another
+// app as is; the blog registers them in src/app.ts and never depends on them.
+export default defineArchRules({
+  layers: {
+    app: ['app/**', 'routes/**'],
+    modules: 'modules/**',
+  },
+  rules: [
+    {
+      from: 'app',
+      disallow: 'modules',
+      // A type-only import is a dependency too: the module must stay liftable.
+      includeTypeImports: true,
+      message:
+        'app/ and routes/ must not import from modules/. A module is registered once in src/app.ts and is otherwise invisible to the application.',
+    },
+  ],
+})
