diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..1e0d9d1
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,66 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync, readdirSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+const GIF = new Uint8Array([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 2])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.set(key, value)
+  if (cover) data.set('cover', cover)
+  return data
+}
+
+const base = { title: 'Hello', excerpt: 'Ex', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function author() {
+    const user = await User.create({ name: 'A', email: `a${Date.now()}@x.test`, password: 'secret-pass' })
+    return http.actingAs(user).withCsrf()
+  }
+
+  it('stores, serves, replaces and deletes a cover', async () => {
+    const authed = await author()
+    await authed.post('/posts', form(base, new File([PNG], 'c.png', { type: 'image/png' }))).assertRedirect()
+    const post = (await Post.all())[0]!
+    const first = (await Attachment.all())[0]!
+    const res = await http.get(`/attachments/${first.id}`)
+    expect(res.status).toBe(200)
+    expect(res.headers.get('content-type')).toBe('image/png')
+    expect(new Uint8Array(await res.raw.arrayBuffer())).toEqual(PNG)
+
+    await authed.put(`/posts/${post.id}`, form(base, new File([PNG], 'd.png', { type: 'image/png' }))).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+    expect((await http.get(`/attachments/${first.id}`)).status).toBe(404)
+
+    await authed.put(`/posts/${post.id}`, form(base)).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+
+    await authed.put(`/posts/${post.id}`, form({ ...base, removeCover: '1' })).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+  })
+
+  it('refuses a GIF and keeps nothing', async () => {
+    const authed = await author()
+    await authed.post('/posts', form(base, new File([GIF], 'c.gif', { type: 'image/gif' }))).assertUnprocessable()
+    expect((await Post.all()).length).toBe(0)
+    expect((await Attachment.all()).length).toBe(0)
+    expect(existsSync('storage/covers') ? readdirSync('storage/covers').length : 0).toBe(0)
+  })
+})
