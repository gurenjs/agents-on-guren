diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..544b87c
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,70 @@
+import { and, eq, inArray } from 'drizzle-orm'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import { getDatabase } from '../../config/database.js'
+import { postTags, tags } from '../../db/schema.js'
+
+async function db(): Promise<SQLiteBunDatabase> {
+  return (await getDatabase()) as SQLiteBunDatabase
+}
+
+/** Tag names per post id, sorted alphabetically. Posts without tags are absent. */
+export async function tagNamesForPosts(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>()
+  if (postIds.length === 0) return byPost
+
+  const rows = await (await db())
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+
+  for (const row of rows) {
+    const names = byPost.get(row.postId) ?? []
+    names.push(row.name)
+    byPost.set(row.postId, names)
+  }
+  for (const names of byPost.values()) names.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+
+  return byPost
+}
+
+/** Ids of the posts carrying the tag `name`. */
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const rows = await (await db())
+    .select({ postId: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name))
+
+  return rows.map((row) => row.postId)
+}
+
+/** Makes the post's tags exactly `names`, creating unseen tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const database = await db()
+
+  const existing = names.length > 0 ? await database.select().from(tags).where(inArray(tags.name, names)) : []
+  const ids = new Map(existing.map((tag) => [tag.name, tag.id]))
+  for (const name of names) {
+    if (ids.has(name)) continue
+    const [created] = await database.insert(tags).values({ name }).returning({ id: tags.id })
+    ids.set(name, created.id)
+  }
+
+  const wanted = new Set(names.map((name) => ids.get(name) as number))
+  const current = await database.select({ tagId: postTags.tagId }).from(postTags).where(eq(postTags.postId, postId))
+  const currentIds = new Set(current.map((row) => row.tagId))
+
+  for (const tagId of currentIds) {
+    if (!wanted.has(tagId)) {
+      await database.delete(postTags).where(and(eq(postTags.postId, postId), eq(postTags.tagId, tagId)))
+    }
+  }
+  for (const tagId of wanted) {
+    if (!currentIds.has(tagId)) await database.insert(postTags).values({ postId, tagId })
+  }
+}
+
+export async function detachPostTags(postId: number): Promise<void> {
+  await (await db()).delete(postTags).where(eq(postTags.postId, postId))
+}
