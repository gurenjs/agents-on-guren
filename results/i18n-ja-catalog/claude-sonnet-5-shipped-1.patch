diff --git a/tests/AuthI18n.test.ts b/tests/AuthI18n.test.ts
new file mode 100644
index 0000000..ef6f0e7
--- /dev/null
+++ b/tests/AuthI18n.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('login/register locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = (await TestApp.fromApp(app)).json()
+  })
+
+  it('renders English by default (no Accept-Language header)', async () => {
+    const res = await http.get('/login')
+    const { props } = await res.json()
+    expect(props._i18n.locale).toBe('en')
+    expect(props._i18n.messages.en.auth.login.heading).toBe('Sign in')
+  })
+
+  it('renders Japanese for a typical Japanese browser header', async () => {
+    const ja = http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7')
+
+    const login = await (await ja.get('/login')).json()
+    expect(login.props._i18n.locale).toBe('ja')
+    expect(login.props._i18n.messages.ja.auth.login.heading).toBe('ログイン')
+    expect(login.props._i18n.messages.ja.auth.login.subtitle).toBe(
+      'アカウントの認証情報を入力して続行してください。',
+    )
+    expect(login.props._i18n.messages.ja.auth.login.email).toBe('メールアドレス')
+    expect(login.props._i18n.messages.ja.auth.login.password).toBe('パスワード')
+    expect(login.props._i18n.messages.ja.auth.login.remember).toBe('ログイン状態を保持する')
+    expect(login.props._i18n.messages.ja.auth.login.submit).toBe('ログイン')
+    expect(login.props._i18n.messages.ja.auth.login.noAccount).toBe('アカウントをお持ちでないですか？')
+    expect(login.props._i18n.messages.ja.auth.login.signUp).toBe('アカウント登録')
+
+    const register = await (await ja.get('/register')).json()
+    expect(register.props._i18n.locale).toBe('ja')
+    expect(register.props._i18n.messages.ja.auth.register.heading).toBe('アカウント登録')
+    expect(register.props._i18n.messages.ja.auth.register.subtitle).toBe(
+      'アカウントを作成して始めましょう。',
+    )
+    expect(register.props._i18n.messages.ja.auth.register.name).toBe('名前')
+    expect(register.props._i18n.messages.ja.auth.register.confirmPassword).toBe('パスワード（確認）')
+    expect(register.props._i18n.messages.ja.auth.register.submit).toBe('登録')
+    expect(register.props._i18n.messages.ja.auth.register.hasAccount).toBe('すでにアカウントをお持ちですか？')
+    expect(register.props._i18n.messages.ja.auth.register.signIn).toBe('ログイン')
+  })
+
+  it('renders English when English outranks Japanese', async () => {
+    const res = await http.withHeader('Accept-Language', 'en-US,en;q=0.9,ja;q=0.5').get('/register')
+    const { props } = await res.json()
+    expect(props._i18n.locale).toBe('en')
+    expect(props._i18n.messages.en.auth.register.heading).toBe('Create an account')
+  })
+
+  it('falls back to English when only unsupported languages are named', async () => {
+    const res = await http.withHeader('Accept-Language', 'fr-FR,fr;q=0.9').get('/login')
+    const { props } = await res.json()
+    expect(props._i18n.locale).toBe('en')
+    expect(props._i18n.messages.en.auth.login.heading).toBe('Sign in')
+  })
+
+  it('translates the welcome message with its placeholder intact', async () => {
+    const res = await http.withHeader('Accept-Language', 'ja').get('/login')
+    const { props } = await res.json()
+    expect(props._i18n.messages.ja.messages.welcome).toBe(':nameへようこそ！')
+  })
+})
