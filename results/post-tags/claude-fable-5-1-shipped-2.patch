diff --git a/app/Models/PostTag.ts b/app/Models/PostTag.ts
new file mode 100644
index 0000000..3a817f5
--- /dev/null
+++ b/app/Models/PostTag.ts
@@ -0,0 +1,45 @@
+import { defineModel, type TransactionHandle } from '@guren/core'
+import { postTags } from '../../db/schema.js'
+import { Tag } from './Tag.js'
+
+export type PostTagRecord = typeof postTags.$inferSelect
+
+// Pivot between posts and tags. The ORM has no attach/detach/sync helpers, so
+// syncPostTags below writes and deletes these rows directly.
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+/**
+ * Makes `names` the post's exact tag set: unknown names become new tags,
+ * missing ones are attached, and names not listed are detached. Tags left
+ * unused stay in the table. Runs on the caller's transaction so a failure
+ * midway leaves neither a half-attached post nor orphan tag rows.
+ */
+export async function syncPostTags(postId: number, names: readonly string[], trx: TransactionHandle): Promise<void> {
+  const tags = Tag.inTransaction(trx)
+  const pivot = PostTag.inTransaction(trx)
+
+  const existing = await tags.newQuery().whereIn('name', names).get()
+  const idByName = new Map(existing.map((tag) => [tag.name, tag.id]))
+  for (const name of names) {
+    if (!idByName.has(name)) {
+      const tag = await tags.create({ name })
+      idByName.set(name, tag.id)
+    }
+  }
+  const wanted = new Set(idByName.values())
+
+  const current = await pivot.where({ postId }).get()
+  const attached = new Set(current.map((row) => row.tagId))
+  for (const row of current) {
+    if (!wanted.has(row.tagId)) {
+      await pivot.delete({ postId, tagId: row.tagId })
+    }
+  }
+  for (const tagId of wanted) {
+    if (!attached.has(tagId)) {
+      await pivot.create({ postId, tagId })
+    }
+  }
+}
