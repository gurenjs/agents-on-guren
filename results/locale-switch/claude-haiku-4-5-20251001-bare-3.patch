--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,24 @@
+import { Controller } from '@guren/core'
+import { LocaleSchema } from '../Validators/LocaleValidator.js'
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    let data
+    const contentType = this.request.header('content-type')
+
+    if (contentType?.includes('application/json')) {
+      data = await this.validateBody(LocaleSchema)
+    } else {
+      const body = new URLSearchParams(await this.request.text())
+      data = LocaleSchema.parse({ locale: body.get('locale') })
+    }
+
+    const referer = this.request.header('referer') ?? '/'
+    const redirectUrl = new URL(referer, this.request.url).pathname
+
+    const response = this.redirect(redirectUrl)
+    response.headers.set('Set-Cookie', `locale=${data.locale}; Path=/; Max-Age=31536000; SameSite=Lax`)
+
+    return response
+  }
+}
