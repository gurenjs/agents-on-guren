diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..830ec4e
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,146 @@
+import { describe, test, expect, beforeAll } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('Scheduled Posts', () => {
+  let http: TestApp
+  let author: any
+  let otherUser: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    author = await User.create({
+      name: 'Author',
+      email: `author-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+
+    otherUser = await User.create({
+      name: 'Other User',
+      email: `other-${Date.now()}-2@example.com`,
+      password: 'password123',
+    })
+  })
+
+  test('creates a scheduled post', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    const futureDate = new Date(Date.now() + 3600000).toISOString()
+
+    await csrf.post('/posts', {
+      title: 'Future Post',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      publishAt: futureDate,
+    }).assertRedirect()
+
+    const post = await Post.first({ title: 'Future Post' })
+    expect(post).toBeDefined()
+    expect(post?.publishedAt).toBeDefined()
+  })
+
+  test('scheduled post is hidden from other users', async () => {
+    const futureDate = new Date(Date.now() + 3600000).toISOString()
+    await Post.forceCreate({
+      title: 'Scheduled By Author',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: futureDate,
+    })
+
+    await http.actingAs(otherUser).get('/posts').assertOk()
+  })
+
+  test('scheduled post is visible to author', async () => {
+    const futureDate = new Date(Date.now() + 3600000).toISOString()
+    await Post.forceCreate({
+      title: 'Scheduled By Author 2',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt: futureDate,
+    })
+
+    await http.actingAs(author).get('/posts').assertOk()
+  })
