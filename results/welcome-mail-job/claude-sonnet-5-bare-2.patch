@@ -0,0 +1,24 @@
+import type { MailConfig } from '@guren/core'
+
+// MAIL_MAILER=log (default) writes outgoing mail to the server console —
+// nothing to configure for local development. MAIL_MAILER=resend sends for
+// real through RESEND_API_KEY. MAIL_MAILER=memory keeps messages in memory
+// instead of sending them, for tests that assert on what was sent.
+function resolveDefaultTransport(): string {
+  if (process.env.MAIL_MAILER === 'resend') return 'resend'
+  if (process.env.MAIL_MAILER === 'memory') return 'memory'
+  return 'log'
+}
+
+export const mailConfig: MailConfig = {
+  default: resolveDefaultTransport(),
+  from: {
+    email: process.env.MAIL_FROM_ADDRESS ?? 'noreply@example.com',
+    name: process.env.MAIL_FROM_NAME ?? process.env.APP_NAME ?? 'Guren',
+  },
+  transports: {
+    log: { driver: 'log' },
+    memory: { driver: 'memory' },
+    resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+  },
+}
diff --git a/config/queue.ts b/config/queue.ts
new file mode 100644
index 0000000..8b26b1d
--- /dev/null
+++ b/config/queue.ts
@@ -0,0 +1,22 @@
+import { MemoryDriver, SyncDriver, RedisDriver, createRedisClient, type QueueConfig } from '@guren/core'
+
+// QUEUE_CONNECTION=sync (default) runs queued work inline, in the same
+// process that dispatched it — nothing else to run locally, and failures
+// surface immediately. QUEUE_CONNECTION=redis defers work to REDIS_URL for a
+// separate worker process to pick up. QUEUE_CONNECTION=memory holds
+// dispatched work without running it, for tests that assert on what got
+// queued before running it themselves.
+function resolveDefaultDriver(): string {
+  if (process.env.QUEUE_CONNECTION === 'redis') return 'redis'
+  if (process.env.QUEUE_CONNECTION === 'memory') return 'memory'
+  return 'sync'
+}
+
+export const queueConfig: QueueConfig = {
+  default: resolveDefaultDriver(),
+  drivers: {
+    sync: () => new SyncDriver(),
+    memory: () => new MemoryDriver(),
+    redis: () => new RedisDriver(createRedisClient({ url: process.env.REDIS_URL })),
+  },
+}
