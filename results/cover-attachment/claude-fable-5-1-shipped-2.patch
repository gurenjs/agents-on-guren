diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..967a45c
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,256 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { readdir, rm } from 'node:fs/promises'
+import { TestApp } from '@guren/testing'
+import { Attachment } from '../config/attachments.js'
+import { resetDatabase } from '../config/database.js'
+import { COVER_MAX_BYTES } from '../app/Http/Validators/PostValidator.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+import app from '../src/app.js'
+
+// config/storage.ts roots the `local` disk here under NODE_ENV=test.
+const STORAGE_ROOT = './storage/app/testing'
+
+const PNG = Buffer.from(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==',
+  'base64',
+)
+const JPEG = Buffer.from(
+  '/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=',
+  'base64',
+)
+const GIF = Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', 'base64')
+
+function postForm(fields: Record<string, string | File> = {}): FormData {
+  const form = new FormData()
+  const values = { title: 'Hello', excerpt: 'An excerpt', body: 'A body', ...fields }
+  for (const [name, value] of Object.entries(values)) form.append(name, value)
+  return form
+}
+
+function file(bytes: Uint8Array<ArrayBuffer>, name: string, type: string): File {
+  return new File([bytes], name, { type })
+}
+
+async function storedFiles(): Promise<string[]> {
+  const entries = await readdir(STORAGE_ROOT, { recursive: true, withFileTypes: true }).catch(() => [])
+  return entries.filter((entry) => entry.isFile()).map((entry) => `${entry.parentPath}/${entry.name}`)
+}
+
+describe('post covers', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  // resetDatabase() forgets the rows but not the files they pointed at, and the
+  // assertions below count every file under the disk's root.
+  async function resetEverything(): Promise<void> {
+    await rm(STORAGE_ROOT, { recursive: true, force: true })
+    await resetDatabase()
+  }
+
+  beforeEach(async () => {
+    await resetEverything()
+    author = (await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  afterAll(resetEverything)
+
+  async function asAuthor(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function createPost(cover?: File): Promise<number> {
+    const client = await asAuthor()
+    const response = await client.post('/posts', postForm(cover ? { cover } : {}))
+    response.assertRedirect()
+    return Number(response.headers.get('location')?.split('/').pop())
+  }
+
+  async function showPost(id: number): Promise<PostResourceData> {
+    const response = await http.withHeader('X-Inertia', 'true').get(`/posts/${id}`)
+    response.assertOk()
+    const page = await response.json<{ component: string; props: { post: PostResourceData } }>()
+    expect(page.component).toBe('posts/Show')
+    return page.props.post
+  }
+
+  it('creates a post without a cover', async () => {
+    const id = await createPost()
+
+    expect((await showPost(id)).coverUrl).toBeNull()
+    expect(await Attachment.all()).toHaveLength(0)
+  })
+
+  it('stores a PNG cover under storage/ and serves it back unchanged', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+
+    const { coverUrl } = await showPost(id)
+    expect(coverUrl).toBeString()
+    const served = await http.get(coverUrl as string)
+    served.assertOk()
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(PNG)).toBe(true)
+
+    expect(await Attachment.all()).toHaveLength(1)
+    expect(await storedFiles()).toHaveLength(1)
+  })
+
+  it('serves a JPEG cover with its own content type, whatever the upload declared', async () => {
+    const id = await createPost(file(JPEG, 'cover.bin', 'application/octet-stream'))
+
+    const served = await http.get((await showPost(id)).coverUrl as string)
+    served.assertOk()
+    expect(served.headers.get('content-type')).toBe('image/jpeg')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(JPEG)).toBe(true)
+  })
+
+  it('stores a PNG the runtime cannot decode, byte for byte', async () => {
+    const undecodable = new Uint8Array(64)
+    undecodable.set(PNG.subarray(0, 8))
+    const id = await createPost(file(undecodable, 'cover.png', 'image/png'))
+
+    const served = await http.get((await showPost(id)).coverUrl as string)
+    served.assertOk()
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(Buffer.from(undecodable))).toBe(true)
+  })
+
+  it('lists each post with its coverUrl', async () => {
+    const withCover = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const without = await createPost()
+
+    const response = await http.withHeader('X-Inertia', 'true').get('/posts')
+    response.assertOk()
+    const page = await response.json<{ props: { data: PostResourceData[] } }>()
+    const byId = new Map(page.props.data.map((post) => [post.id, post]))
+
+    expect(byId.get(withCover)?.coverUrl).toBeString()
+    expect(byId.get(without)?.coverUrl).toBeNull()
+  })
+
+  it('refuses a GIF like an empty title, and saves nothing', async () => {
+    const client = await asAuthor()
+
+    const emptyTitle = await client.json().post('/posts', postForm({ title: '' }))
+    const gif = await client.json().post('/posts', postForm({ cover: file(GIF, 'cover.gif', 'image/gif') }))
+
+    expect(gif.status).toBe(emptyTitle.status)
+    gif.assertUnprocessable()
+    const body = await gif.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.cover).toEqual(['Cover must be a PNG or JPEG image.'])
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('refuses a GIF that claims to be a PNG', async () => {
+    const client = await asAuthor()
+
+    await client.json().post('/posts', postForm({ cover: file(GIF, 'cover.png', 'image/png') })).assertUnprocessable()
+
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('refuses a cover over 2 MB', async () => {
+    const oversized = new Uint8Array(COVER_MAX_BYTES + 1)
+    oversized.set(PNG)
+    const client = await asAuthor()
+
+    const response = await client.json().post('/posts', postForm({ cover: file(oversized, 'cover.png', 'image/png') }))
+
+    response.assertUnprocessable()
+    const body = await response.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.cover).toEqual(['Cover must be 2 MB or smaller.'])
+    expect(await Post.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('replaces the cover on edit and deletes the old file', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const oldUrl = (await showPost(id)).coverUrl as string
+    const client = await asAuthor()
+
+    await client
+      .put(`/posts/${id}`, postForm({ title: 'Edited', cover: file(JPEG, 'cover.jpg', 'image/jpeg') }))
+      .assertRedirect(`/posts/${id}`)
+
+    const post = await showPost(id)
+    expect(post.title).toBe('Edited')
+    expect(post.coverUrl).not.toBe(oldUrl)
+    const served = await http.get(post.coverUrl as string)
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(JPEG)).toBe(true)
+    await http.get(oldUrl).assertNotFound()
+
+    expect(await Attachment.all()).toHaveLength(1)
+    expect(await storedFiles()).toHaveLength(1)
+  })
+
+  it('keeps the cover when an edit neither uploads nor removes', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const client = await asAuthor()
+
+    await client.put(`/posts/${id}`, postForm({ title: 'Edited', removeCover: '0' })).assertRedirect()
+    await client.json().put(`/posts/${id}`, { title: 'Edited again', excerpt: 'An excerpt', body: 'A body' }).assertRedirect()
+
+    const post = await showPost(id)
+    expect(post.title).toBe('Edited again')
+    const served = await http.get(post.coverUrl as string)
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(PNG)).toBe(true)
+  })
+
+  it('keeps the post and its cover when the new cover is refused', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const client = await asAuthor()
+
+    await client
+      .json()
+      .put(`/posts/${id}`, postForm({ title: 'Edited', cover: file(GIF, 'cover.gif', 'image/gif') }))
+      .assertUnprocessable()
+
+    const post = await showPost(id)
+    expect(post.title).toBe('Hello')
+    const served = await http.get(post.coverUrl as string)
+    expect(Buffer.from(await served.raw.arrayBuffer()).equals(PNG)).toBe(true)
+    expect(await storedFiles()).toHaveLength(1)
+  })
+
+  it('removes the cover when removeCover is ticked', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const oldUrl = (await showPost(id)).coverUrl as string
+    const client = await asAuthor()
+
+    await client.put(`/posts/${id}`, postForm({ removeCover: '1' })).assertRedirect()
+
+    expect((await showPost(id)).coverUrl).toBeNull()
+    await http.get(oldUrl).assertNotFound()
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('deletes the cover with the post', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const oldUrl = (await showPost(id)).coverUrl as string
+    const client = await asAuthor()
+
+    await client.delete(`/posts/${id}`).assertRedirect('/posts')
+
+    await http.get(oldUrl).assertNotFound()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Attachment.all()).toHaveLength(0)
+    expect(await storedFiles()).toHaveLength(0)
+  })
+
+  it('does not serve a cover URL whose signature was altered', async () => {
+    const id = await createPost(file(PNG, 'cover.png', 'image/png'))
+    const { coverUrl } = await showPost(id)
+
+    await http.get(`${coverUrl}x`).assertNotFound()
+    await http.get((coverUrl as string).split('?')[0]).assertNotFound()
+  })
+})
