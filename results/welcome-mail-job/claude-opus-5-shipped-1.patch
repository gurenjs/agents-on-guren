new file mode 100644
index 0000000..6184f70
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,28 @@
+import { getQueueDriver, registerJob, ServiceProvider } from '@guren/core'
+import { appQueueManager } from '../../config/queue.js'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+/**
+ * Binds the queue manager configured in config/queue.ts and installs its
+ * default driver as the one `Job.dispatch()` pushes to.
+ *
+ * Every job class is registered here as well: a worker receives only the job's
+ * name over the queue and resolves the class back from this registry, so a job
+ * that is never registered can be dispatched but never run.
+ */
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('queue', () => appQueueManager())
+  }
+
+  boot(): void {
+    registerJob(SendWelcomeEmailJob)
+
+    // Resolving the default driver installs it globally. A worker process — or
+    // a test holding dispatched jobs instead of running them — may have
+    // installed its own driver already; leave it alone.
+    if (!getQueueDriver()) {
+      appQueueManager().driver()
+    }
+  }
+}
