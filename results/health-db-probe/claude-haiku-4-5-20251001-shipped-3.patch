--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,26 @@
+import { Controller } from '@guren/core'
+import { User } from '../../Models/User.js'
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    try {
+      await User.newQuery().count()
+      return this.json({
+        status: 'ok',
+        checks: {
+          db: { status: 'ok' },
+        },
+      })
+    } catch (error) {
+      return this.json(
+        {
+          status: 'error',
+          checks: {
+            db: { status: 'error' },
+          },
+        },
+        { status: 503 },
+      )
+    }
+  }
+}
