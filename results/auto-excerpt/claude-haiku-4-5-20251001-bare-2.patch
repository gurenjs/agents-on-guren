diff --git a/tests/ExcerptService.test.ts b/tests/ExcerptService.test.ts
new file mode 100644
index 0000000..5a646dd
--- /dev/null
+++ b/tests/ExcerptService.test.ts
@@ -0,0 +1,87 @@
+import { describe, it } from 'bun:test'
+import { expect } from 'bun:test'
+import { ExcerptService } from '../app/Services/ExcerptService.js'
+
+describe('ExcerptService.derive', () => {
+  it('returns the whole body if 140 characters or fewer', () => {
+    const body = 'Short body'
+    const result = ExcerptService.derive(body)
+    expect(result).toBe('Short body')
+  })
+
+  it('returns the whole body without ellipsis if exactly 140 characters', () => {
+    const body = 'a'.repeat(140)
+    const result = ExcerptService.derive(body)
+    expect(result).toBe('a'.repeat(140))
+  })
+
+  it('trims leading and trailing whitespace from body', () => {
+    const body = '   Short body   '
+    const result = ExcerptService.derive(body)
+    expect(result).toBe('Short body')
+  })
+
+  it('works example 1: cut lands inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown'
+    const result = ExcerptService.derive(body)
+    expect(result).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…'
+    )
+    expect(result.length).toBe(139)
+  })
+
+  it('works example 2: cut lands exactly on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    const result = ExcerptService.derive(body)
+    expect(result).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…'
+    )
+    expect(result.length).toBe(141)
+  })
+
+  it('handles body with no whitespace in first 140 chars', () => {
+    const body = 'a'.repeat(140) + 'b more text'
+    const result = ExcerptService.derive(body)
+    expect(result).toBe('a'.repeat(140) + '…')
+  })
+
+  it('appends ellipsis when truncating a sentence', () => {
+    const body =
+      'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.'
+    const result = ExcerptService.derive(body)
+    expect(result.length).toBeLessThanOrEqual(141)
+    expect(result.endsWith('…')).toBe(true)
+  })
+
+  it('does not append ellipsis when body fits in 140 chars', () => {
+    const body = 'Short body here.'
+    const result = ExcerptService.derive(body)
+    expect(result.endsWith('…')).toBe(false)
+  })
+
+  it('handles long text with tabs as whitespace', () => {
+    const body =
+      'The quick brown fox\tjumps over the lazy dog and continues for much longer with tabs and more text and even more material here for sure now going on.'
+    const result = ExcerptService.derive(body)
+    expect(result).toContain('fox')
+    expect(result.endsWith('…')).toBe(true)
+  })
+
+  it('handles long text with newlines as whitespace', () => {
+    const body =
+      'The quick brown fox\njumps over the lazy dog and continues for much longer with newlines and additional text to exceed limit and more text still.'
+    const result = ExcerptService.derive(body)
+    expect(result).toContain('fox')
+    expect(result.endsWith('…')).toBe(true)
+  })
+
+  it('trims trailing whitespace before appending ellipsis', () => {
+    const body =
+      'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam   '
+    const result = ExcerptService.derive(body)
+    expect(result.endsWith('…')).toBe(true)
+    expect(/\s…/.test(result)).toBe(false)
+  })
+})
