+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_CONTENT_TYPES = ['image/png', 'image/jpeg'] as const
+export type CoverContentType = (typeof COVER_CONTENT_TYPES)[number]
+
+export const COVER_TYPE_MESSAGE = 'Cover must be a PNG or JPEG image.'
+export const COVER_SIZE_MESSAGE = 'Cover must be 2 MB or smaller.'
+
+// A file input left empty still travels: a browser form sends a nameless
+// zero-byte file, and Inertia sends `null` as JSON or '' as multipart. All of
+// them mean "no cover picked", which is not an error.
+function isBlankUpload(value: unknown): boolean {
+  // `!name`, because Bun reads the empty filename back as undefined, not ''.
+  return value === null || value === '' || (value instanceof File && value.size === 0 && !value.name)
+}
+
+// Checks what the request declares about the file, which is all a synchronous
+// schema can see. The bytes themselves are checked by sniffCoverType() in the
+// controller, before anything is written.
+const CoverSchema = z.preprocess(
+  (value) => (isBlankUpload(value) ? undefined : value),
+  z
+    .instanceof(File, { message: COVER_TYPE_MESSAGE })
+    .refine((file) => file.size <= COVER_MAX_BYTES, COVER_SIZE_MESSAGE)
+    // The declared type may be absent or generic (a non-browser client); the
+    // signature check decides then. One that names another format is refused.
+    .refine(
+      (file) =>
+        file.type === '' ||
+        file.type === 'application/octet-stream' ||
+        (COVER_CONTENT_TYPES as readonly string[]).includes(file.type),
+      COVER_TYPE_MESSAGE,
+    )
+    .optional(),
+)
+
+// A ticked checkbox arrives as '1' (or 'on') from a multipart form and as
+// `true` from Inertia's JSON; anything else, absence included, is unticked.
+const CheckboxSchema = z
+  .union([z.boolean(), z.string(), z.number()])
+  .nullish()
+  .transform((value) => value === true || value === 1 || value === '1' || value === 'on' || value === 'true')
+  // Restates the transform's result, so codegen can type the validated body.
+  .pipe(z.boolean())
+
 export const PostPayloadSchema = z.object({
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),
   excerpt: z.string().trim().min(1, 'Excerpt is required.').max(500, 'Excerpt must be 500 characters or fewer.'),
   body: z.string().trim().min(1, 'Body is required.'),
+  cover: CoverSchema,
+})
+
+export const PostUpdatePayloadSchema = PostPayloadSchema.extend({
+  removeCover: CheckboxSchema,
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+export type PostUpdatePayload = z.infer<typeof PostUpdatePayloadSchema>
+
+/**
+ * The format the file's leading bytes announce, or null when they are neither
+ * PNG nor JPEG. The declared content type and the filename are whatever the
+ * client says; the signature is what a browser will decode.
+ */
+export async function sniffCoverType(file: File): Promise<CoverContentType | null> {
+  const head = new Uint8Array(await file.slice(0, 8).arrayBuffer())
+  const startsWith = (signature: number[]) => signature.every((byte, index) => head[index] === byte)
+
+  if (startsWith([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])) {
+    return 'image/png'
+  }
+  if (startsWith([0xff, 0xd8, 0xff])) {
+    return 'image/jpeg'
+  }
+  return null
+}
