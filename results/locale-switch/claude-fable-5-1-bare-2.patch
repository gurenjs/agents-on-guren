diff --git a/resources/js/components/LocaleSwitcher.tsx b/resources/js/components/LocaleSwitcher.tsx
new file mode 100644
index 0000000..c3bc167
--- /dev/null
+++ b/resources/js/components/LocaleSwitcher.tsx
@@ -0,0 +1,42 @@
+import { useEffect } from 'react'
+import { Link } from '@inertiajs/react'
+import { useTranslation } from '@guren/inertia-client'
+import { SUPPORTED_LOCALES } from '@/config/locales'
+import { route } from '@/.guren/routes.gen'
+
+export default function LocaleSwitcher() {
+  const { t, locale } = useTranslation()
+
+  // The server writes <html lang> on a full page load only; an Inertia visit
+  // swaps the page in place, so the attribute has to follow the switch here.
+  useEffect(() => {
+    document.documentElement.lang = locale
+  }, [locale])
+
+  return (
+    <div role="group" aria-label={t('locale.label')} className="flex items-center gap-1">
+      {SUPPORTED_LOCALES.map((code) => (
+        // Posted through Inertia's Link for the same reason as the log-out
+        // button in Layout: it carries the CSRF header a native form would not.
+        // The server redirects back to this page, now in the chosen language.
+        <Link
+          key={code}
+          href={route('locale.update')}
+          method="post"
+          data={{ locale: code }}
+          as="button"
+          preserveScroll
+          lang={code}
+          aria-current={code === locale ? 'true' : undefined}
+          className={
+            code === locale
+              ? 'rounded-g-ctl px-2 py-1 font-bold text-g-heading'
+              : 'rounded-g-ctl px-2 py-1 transition hover:text-g-heading'
+          }
+        >
+          {t(`locale.${code}`)}
+        </Link>
+      ))}
+    </div>
+  )
+}
