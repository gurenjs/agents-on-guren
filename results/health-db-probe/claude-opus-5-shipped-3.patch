diff --git a/tests/HealthController.test.ts b/tests/HealthController.test.ts
new file mode 100644
index 0000000..b55c7a2
--- /dev/null
+++ b/tests/HealthController.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, describe, expect, it, mock } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import * as database from '../config/database.js'
+import app from '../src/app.js'
+
+// The probe has to fail when the database is unreachable, so one test needs a
+// database that refuses to open. The module is patched once, in front of the
+// real implementation, and stays transparent until a test flips the flag —
+// mocks registered here apply process-wide, and the other suites still need a
+// working connection.
+let databaseIsDown = false
+
+// Captured before the patch lands: the namespace object is rewired to the mock
+// too, so calling through it here would recurse forever.
+const openDatabase = database.getDatabase
+
+mock.module('../config/database.js', () => ({
+  ...database,
+  getDatabase: async () => {
+    if (databaseIsDown) {
+      throw new Error('unable to open database file')
+    }
+    return openDatabase()
+  },
+}))
+
+interface HealthBody {
+  status: string
+  checks: Array<{ name: string; status: string }>
+}
+
+describe('GET /health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('reports healthy while the database answers', async () => {
+    const response = await http.get('/health').assertOk()
+    const body = await response.json<HealthBody>()
+
+    expect(body.status).toBe('healthy')
+    expect(body.checks.find((check) => check.name === 'db')?.status).toBe('healthy')
+  })
+
+  it('answers 503 when the database check fails', async () => {
+    databaseIsDown = true
+
+    try {
+      const response = await http.get('/health').assertStatus(503)
+      const body = await response.json<HealthBody>()
+
+      expect(body.status).toBe('unhealthy')
+      expect(body.checks.find((check) => check.name === 'db')?.status).toBe('unhealthy')
+    } finally {
+      databaseIsDown = false
+    }
+  })
+
+  it('recovers once the database answers again', async () => {
+    await http.get('/health').assertOk()
+  })
+})
