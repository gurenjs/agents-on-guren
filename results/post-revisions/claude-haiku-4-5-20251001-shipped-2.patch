@@ -0,0 +1,63 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: PostResourceData
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`Revisions: ${post.title}`} />
+      <div className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="text-3xl font-bold text-g-heading">Revisions</h1>
+          <p className="text-g-text-2">{post.title}</p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <div className="rounded-g-card border border-g-line bg-g-card-bg p-6 text-center text-g-text-2">
+            No revisions yet. Start editing to create revision history.
+          </div>
+        ) : (
+          <div className="space-y-3">
+            {revisions.map((revision) => (
+              <div key={revision.id} className="flex items-center justify-between rounded-g-card border border-g-line bg-g-card-bg p-4">
+                <div>
+                  <p className="font-semibold text-g-heading">{revision.title}</p>
+                  <p className="text-sm text-g-text-2">
+                    {new Date(revision.createdAt).toLocaleDateString()} {new Date(revision.createdAt).toLocaleTimeString()}
+                  </p>
+                </div>
+                <Link
+                  href={route('posts.restore-revision', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm('Restore this revision?')}
+                  className="rounded-g-ctl border border-g-accent-chip bg-g-accent-bg px-3 py-1 font-bold text-g-accent-text transition hover:bg-g-accent-chip"
+                >
+                  Restore
+                </Link>
+              </div>
+            ))}
+          </div>
+        )}
+
+        <footer className="flex items-center gap-4 border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </div>
+    </Layout>
+  )
+}
