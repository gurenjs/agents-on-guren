@@ -0,0 +1,68 @@
+import { Head, Link, useForm } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  revisions: Revision[]
+  postId: number
+}
+
+export default function PostRevisions({ revisions, postId }: Props) {
+  return (
+    <Layout>
+      <Head title="Post revisions" />
+      <article className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            Revisions
+          </h1>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No revisions yet.</p>
+        ) : (
+          <ul className="divide-y divide-g-line border border-g-line rounded-g-ctl">
+            {revisions.map((revision) => (
+              <li key={revision.id} className="flex items-center justify-between gap-4 px-4 py-3">
+                <div>
+                  <p className="font-semibold text-g-heading">{revision.title}</p>
+                  <p className="text-sm text-g-muted">
+                    {new Date(revision.createdAt).toLocaleDateString()} at {new Date(revision.createdAt).toLocaleTimeString()}
+                  </p>
+                </div>
+                <form
+                  method="POST"
+                  action={route('posts.revisions.restore', {
+                    id: postId,
+                    revisionId: revision.id,
+                  })}
+                  className="flex-shrink-0"
+                >
+                  <button
+                    type="submit"
+                    className="rounded-g-ctl bg-g-accent px-3 py-1 text-sm font-bold text-g-on-accent transition hover:bg-g-accent-down"
+                  >
+                    Restore
+                  </button>
+                </form>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        <footer className="flex items-center gap-4 border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: postId })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+        </footer>
+      </article>
+    </Layout>
+  )
+}
