new file mode 100644
index 0000000..6c5bfec
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,61 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const FUTURE = '2099-01-01T09:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+  let scheduledId: number
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret123' })
+    other = await User.create({ name: 'B', email: 'b@example.com', password: 'secret123' })
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id as number,
+      publishedAt: FUTURE,
+    })
+    scheduledId = post.id as number
+    await Post.forceCreate({ title: 'Now', excerpt: 'e', body: 'b', authorId: author.id as number })
+  })
+
+  it('hides a scheduled post from guests and other users', async () => {
+    await http.get(`/posts/${scheduledId}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduledId}`).assertNotFound()
+    const list = await http.json().get('/posts')
