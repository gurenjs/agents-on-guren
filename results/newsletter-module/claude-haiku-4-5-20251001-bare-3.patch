@@ -0,0 +1,64 @@
+import { Controller, isSafeRedirectUrl, NotFoundHttpException, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { SubscribeSchema, UnsubscribeSchema, ConfirmTokenSchema } from '../../Validators/NewsletterValidator.js'
+
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(16))
+  return Array.from(bytes).map((b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeSchema)
+
+    const existing = await NewsletterSubscription.newQuery()
+      .where('email', email)
+      .first()
+
+    if (existing) {
+      throw ValidationException.withMessages({
+        email: 'This email address is already subscribed.',
+      })
+    }
+
+    await NewsletterSubscription.forceCreate({
+      email,
+      token: generateToken(),
+    })
+
+    const referer = this.request.header('referer')
+    const redirectUrl =
+      referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+    return this.redirect(redirectUrl)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenSchema)
+
+    const subscription = await NewsletterSubscription.newQuery()
+      .where('token', token)
+      .first()
+
+    if (!subscription) {
+      throw new NotFoundHttpException()
+    }
+
+    await NewsletterSubscription.update(
+      { id: subscription.id },
+      { confirmedAt: new Date().toISOString() },
+    )
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    const referer = this.request.header('referer')
+    const redirectUrl =
+      referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+    return this.redirect(redirectUrl)
+  }
+}
