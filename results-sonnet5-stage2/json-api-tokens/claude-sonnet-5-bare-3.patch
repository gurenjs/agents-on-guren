@@ -0,0 +1,32 @@
+import { Controller } from '@guren/core'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiToken, generateApiTokenSecret, hashApiToken } from '../../Models/ApiToken.js'
+import { ApiTokenPayloadSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = await this.validateBody(ApiTokenPayloadSchema)
+    const token = generateApiTokenSecret()
+    const record = await ApiToken.forceCreate({
+      userId: user.id,
+      name,
+      tokenHash: hashApiToken(token),
+    })
+
+    return this.json({ id: record!.id, name, token }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const id = Number(this.ctx.req.param('id'))
+    const [token] = Number.isInteger(id) ? await ApiToken.where({ id, userId: user.id }) : []
+    if (!token) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id: token.id })
+
+    return new Response(null, { status: 204 })
+  }
+}
