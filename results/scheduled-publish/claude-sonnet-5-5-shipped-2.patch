+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,36 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('hides a scheduled post from guests but not from its author', async () => {
+    const author = await User.create({ name: 'A', email: `a${Date.now()}@example.com`, password: 'secret123' })
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'x',
+      body: 'y',
+      authorId: author.id,
+      publishedAt: new Date(Date.now() + 86_400_000).toISOString(),
+    })
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+
+    await Post.update({ id: post.id }, { publishedAt: new Date(Date.now() - 1000).toISOString() })
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('rejects an unparseable publishAt', async () => {
+    const author = await User.create({ name: 'B', email: `b${Date.now()}@example.com`, password: 'secret123' })
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' }).assertUnprocessable()
+  })
+})
