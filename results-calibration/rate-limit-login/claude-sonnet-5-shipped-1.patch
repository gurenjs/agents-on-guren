@@ -0,0 +1,39 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('POST /login throttling', () => {
+  let csrf: TestApp
+
+  beforeAll(async () => {
+    await resetDatabase()
+    await User.create({
+      name: 'Throttle Test',
+      email: 'throttle@example.com',
+      password: 'correct-password',
+    })
+
+    const http = await TestApp.fromApp(app)
+    csrf = await http.json().withCsrf()
+  })
+
+  it('allows 5 submissions per minute, then throttles further ones with 429 + Retry-After — even a correct one — without affecting other routes', async () => {
+    // Every submission counts toward the limit, whether or not the
+    // credentials were right.
+    for (let i = 0; i < 5; i++) {
+      await csrf.post('/login', { email: 'throttle@example.com', password: 'wrong-password' }).assertStatus(422)
+    }
+
+    // 6th submission is over the limit, even with the correct password.
+    const throttled = await csrf.post('/login', { email: 'throttle@example.com', password: 'correct-password' })
+    throttled.assertStatus(429)
+    expect(throttled.headers.get('Retry-After')).toBeTruthy()
+
+    // Only the login submission is throttled — the form itself and other
+    // pages stay reachable for the same client.
+    await csrf.get('/login').assertOk()
+    await csrf.get('/').assertOk()
+  })
+})
