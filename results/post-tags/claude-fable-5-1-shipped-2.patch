+      const id = await savePost('Tagged', ' bun ,bun')
+
+      expect(await tagNames()).toEqual(['bun'])
+      expect(await PostTag.where({ postId: id }).count()).toBe(1)
+
+      const other = await savePost('Other', 'a,,b,')
+      expect(await attachedTo(other)).toEqual(['a', 'b'])
+    })
+
+    it('treats names as case-sensitive', async () => {
+      const id = await savePost('Tagged', 'Bun, bun')
+
+      expect(await tagNames()).toEqual(['Bun', 'bun'])
+      expect(await PostTag.where({ postId: id }).count()).toBe(2)
+    })
+
+    it('counts the limit after repeated names are folded', async () => {
+      const id = await savePost('Tagged', 'a, b, c, d, e, a, e')
+
+      expect(await attachedTo(id)).toEqual(['a', 'b', 'c', 'd', 'e'])
+    })
+
+    it('refuses six tags like an empty title and saves nothing', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      const emptyTitle = await csrf.post('/posts', { title: '', excerpt: 'Excerpt', body: 'Body' })
+
+      const refused = await csrf.post('/posts', {
+        title: 'Tagged',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        tags: 'a, b, c, d, e, f',
+      })
+
+      expect(refused.status).toBe(emptyTitle.status)
+      const payload = await refused.json<{ errors: Record<string, string[]> }>()
+      expect(Object.keys(payload.errors)).toEqual(['tags'])
+      expect(await Post.newQuery().count()).toBe(0)
+      expect(await Tag.newQuery().count()).toBe(0)
+      expect(await PostTag.newQuery().count()).toBe(0)
+    })
+
+    it('refuses a 31-character name and saves a 30-character one', async () => {
+      const csrf = await http.actingAs(author).withCsrf()
+      await csrf
+        .post('/posts', { title: 'Tagged', excerpt: 'Excerpt', body: 'Body', tags: `bun, ${'x'.repeat(31)}` })
+        .assertUnprocessable()
+        .assertJsonPath('errors.tags.0', 'Each tag must be 30 characters or fewer.')
+
+      expect(await Post.newQuery().count()).toBe(0)
+      expect(await Tag.newQuery().count()).toBe(0)
+
+      const id = await savePost('Tagged', 'x'.repeat(30))
+      expect(await attachedTo(id)).toEqual(['x'.repeat(30)])
+    })
+
+    it('keeps the current tags when an edit is refused', async () => {
