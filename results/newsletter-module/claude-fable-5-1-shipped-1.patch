new file mode 100644
index 0000000..4a012bb
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/SubscriptionController.ts
@@ -0,0 +1,68 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, ValidationException, isSafeRedirectUrl } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+
+export default class SubscriptionController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    if (await NewsletterSubscription.first({ email })) {
+      throw alreadySubscribed()
+    }
+
+    try {
+      // forceCreate, because `token` is deliberately absent from the model's
+      // fillable: it is generated here and a request must never be able to set it.
+      await NewsletterSubscription.forceCreate({ email, token: generateToken() })
+    } catch (error) {
+      // Two concurrent sign-ups both pass the check above; the unique index
+      // rejects the second one, which is the same outcome for the visitor.
+      if (await NewsletterSubscription.first({ email })) {
+        throw alreadySubscribed()
+      }
+      throw error
+    }
+
+    return this.back()
+  }
+
+  async confirm(): Promise<Response> {
+    const subscription = this.model(NewsletterSubscription)
+
+    // Following the link again keeps the original confirmation time.
+    if (subscription.confirmedAt === null) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    await NewsletterSubscription.delete({ email })
+
+    return this.back()
+  }
+
+  // Only a same-origin Referer is followed: the header is request input, and
+  // echoing it unchecked would make these routes an open redirect.
+  private back(): Response {
+    const referer = this.request.header('referer')
+    const target = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    return this.redirect(target)
+  }
+}
+
+// 32 random bytes, base64url-encoded: 43 URL-safe characters.
+function generateToken(): string {
+  return randomBytes(32).toString('base64url')
+}
+
+function alreadySubscribed(): ValidationException {
+  return ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+}
diff --git a/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
