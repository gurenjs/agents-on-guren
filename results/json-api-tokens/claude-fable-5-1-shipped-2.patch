+import type { Router } from '@guren/core'
+import PostApiController from '../app/Http/Controllers/Api/PostApiController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Http/Middleware/ApiTokenMiddleware.js'
+import { PostResource } from '../app/Http/Resources/PostResource.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  // Bearer tokens authenticate these routes and no others: a leaked token
+  // cannot reach the session routes that mint tokens or change the password.
+  const router = baseRouter
+    .aliasMiddleware('auth.token', authenticateApiToken)
+    .aliasMiddleware('throttle.token', throttleApiToken)
+
+  router.group('/api', (api) => {
+    // Order matters: the throttle reads the token 'auth.token' verified.
+    api.middleware('auth.token', 'throttle.token').group((authed) => {
+      authed.get('/posts', {
+        name: 'api.posts.index',
+        resource: { data: [PostResource] },
+      }, [PostApiController, 'index'])
+      authed.post('/posts', {
+        name: 'api.posts.store',
+        body: PostPayloadSchema,
+        resource: { data: PostResource },
+      }, [PostApiController, 'store'])
+    })
+  })
+}
