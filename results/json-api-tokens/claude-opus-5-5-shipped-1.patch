diff --git a/tests/ApiTokenController.test.ts b/tests/ApiTokenController.test.ts
new file mode 100644
index 0000000..fc34ee1
--- /dev/null
+++ b/tests/ApiTokenController.test.ts
@@ -0,0 +1,124 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { rateLimitStore } from '../app/Http/Middleware/ApiTokenMiddleware.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    rateLimitStore.clear()
+    alice = await User.create({ name: 'Alice', email: 'alice@example.com', password: 'password123' })
+    bob = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'password123' })
+  })
+
+  async function createToken(user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name }).assertCreated()
+    return res.json<CreatedToken>()
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('creates a token and stores only its hash', async () => {
+    const created = await createToken(alice)
+    expect(created.name).toBe('CI')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.all()
+    expect(rows).toHaveLength(1)
+    for (const value of Object.values(rows[0] as Record<string, unknown>)) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('rejects an empty or over-long name', async () => {
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('lists posts newest first for a valid token', async () => {
+    const { token } = await createToken(alice)
+    await Post.forceCreate({ title: 'First', excerpt: 'e', body: 'b', authorId: bob.id })
+    await Post.forceCreate({ title: 'Second', excerpt: 'e', body: 'b', authorId: alice.id })
+
+    await bearer(token).get('/api/posts')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Second')
+      .assertJsonPath('data.1.authorId', bob.id)
+  })
+
+  it('creates a post owned by the token owner', async () => {
+    const { token } = await createToken(alice)
+    await bearer(token)
+      .post('/api/posts', { title: 'Hello', excerpt: 'Short', body: 'Long', authorId: bob.id })
+      .assertCreated()
+      .assertJsonPath('data.authorId', alice.id)
+      .assertJsonPath('data.title', 'Hello')
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'Short' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(1)
+  })
+
+  it('answers 401 without a valid token', async () => {
+    const { token } = await createToken(alice)
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('garbage').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+    await bearer('nope').post('/api/posts', { title: 'T', excerpt: 'E', body: 'B' }).assertUnauthorized()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('revokes only the owner’s token', async () => {
+    const first = await createToken(alice, 'first')
+    const second = await createToken(alice, 'second')
+    const bobs = await createToken(bob)
+
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${bobs.id}`).assertNotFound()
+    await bearer(bobs.token).get('/api/posts').assertOk()
+
+    await csrf.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const first = await createToken(alice, 'first')
+    const second = await createToken(alice, 'second')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts').assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThanOrEqual(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
