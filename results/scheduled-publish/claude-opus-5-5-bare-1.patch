diff --git a/resources/js/components/PublishAtField.tsx b/resources/js/components/PublishAtField.tsx
new file mode 100644
index 0000000..66201eb
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,38 @@
+interface Props {
+  /** The `datetime-local` value, in the browser's time zone; '' for "publish now". */
+  value: string
+  onChange: (value: string) => void
+  error?: string
+  className: string
+}
+
+/** An ISO timestamp as a `datetime-local` value in the browser's time zone. */
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  const offset = date.getTimezoneOffset() * 60_000
+  return new Date(date.getTime() - offset).toISOString().slice(0, 16)
+}
+
+/** A `datetime-local` value as the ISO UTC timestamp the server expects; null for "publish now". */
+export function toIsoOrNull(local: string | null | undefined): string | null {
+  if (!local) return null
+  const date = new Date(local)
+  return Number.isNaN(date.getTime()) ? local : date.toISOString()
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">Publish at</label>
+      <input
+        type="datetime-local"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        className={className}
+      />
+      <p className="mt-1 text-xs text-g-muted">Leave empty to publish as soon as you save.</p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
