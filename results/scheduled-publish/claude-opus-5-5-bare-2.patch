diff --git a/resources/js/components/PublishAtField.tsx b/resources/js/components/PublishAtField.tsx
new file mode 100644
index 0000000..6f4c249
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,38 @@
+// `<input type="datetime-local">` speaks the browser's local wall-clock time
+// without a zone ("2026-10-01T11:00"); the server takes an ISO 8601 instant.
+// These convert at the form boundary so the rest of the app only sees UTC.
+
+/** Local "YYYY-MM-DDTHH:mm" for the input, from a stored ISO instant. */
+export function toLocalInputValue(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+/** The ISO instant to submit; an empty input means "publish now". */
+export function toPublishAt(value: string | null | undefined): string | null {
+  if (!value) return null
+  const date = new Date(value)
+  // Left as typed so the server rejects it with a field error.
+  return Number.isNaN(date.getTime()) ? value : date.toISOString()
+}
+
+interface Props {
+  value: string
+  onChange: (value: string) => void
+  error?: string
+  className: string
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">Publish at</label>
+      <input type="datetime-local" value={value} onChange={(event) => onChange(event.target.value)} className={className} />
+      <p className="mt-1 text-sm text-g-muted">Leave empty to publish as soon as you save.</p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
