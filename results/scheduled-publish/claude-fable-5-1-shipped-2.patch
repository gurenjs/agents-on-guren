diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..d5b8ea4
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,173 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+const FUTURE = '2099-10-01T09:00:00.000Z'
+const PAST = '2001-01-01T00:00:00.000Z'
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: label,
+    email: `${label}-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+    password: 'password-1234',
+  })
+  return user as UserRecord
+}
+
+async function makePost(author: UserRecord, title: string, publishedAt: string | null): Promise<PostRecord> {
+  const post = await Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id, publishedAt })
+  return post as PostRecord
+}
+
+async function indexData(client: TestApp): Promise<PostResourceData[]> {
+  const response = await client.get('/posts')
+  response.assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return (payload.props as { data: PostResourceData[] }).data
+}
+
+async function searchData(client: TestApp, keyword: string): Promise<PostResourceData[]> {
+  const response = await client.query('/posts/search', { keywords: [keyword] })
+  response.assertOk()
+  return (await response.json<{ data: PostResourceData[] }>()).data
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('author')
+    other = await makeUser('other')
+  })
+
+  it('stores publishAt on create and reads it back on the post page', async () => {
+    const client = await http.actingAs(author).withCsrf()
+    const created = await client.post('/posts', {
+      title: 'Launch day',
+      excerpt: 'Soon',
+      body: 'Body',
+      publishAt: FUTURE,
+    })
+    created.assertRedirect()
+    const id = Number(created.headers.get('location')?.split('/').pop())
+    const stored = await Post.findOrFail(id)
+    expect(stored.publishedAt).toBe(FUTURE)
+
+    const page = await http.actingAs(author).get(`/posts/${id}`)
+    page.assertOk()
+    const { payload } = await readInertiaResponse(page.raw)
+    expect((payload.props as { post: PostResourceData }).post.publishedAt).toBe(FUTURE)
+  })
+
+  it('publishes immediately when publishAt is absent or null', async () => {
+    const client = await http.actingAs(author).withCsrf()
+    const absent = await client.post('/posts', { title: 'Now A', excerpt: 'x', body: 'y' })
+    absent.assertRedirect()
+    const withNull = await client.post('/posts', { title: 'Now B', excerpt: 'x', body: 'y', publishAt: null })
+    withNull.assertRedirect()
+
+    const guestTitles = (await indexData(http)).map((post) => post.title)
+    expect(guestTitles).toContain('Now A')
+    expect(guestTitles).toContain('Now B')
+  })
+
+  it('rejects a publishAt that is not a date and time without saving', async () => {
+    const before = await Post.newQuery().count()
+    const client = await http.actingAs(author).withCsrf()
+    await client.json().post('/posts', { title: 'Bad', excerpt: 'x', body: 'y', publishAt: 'next tuesday' }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('hides a scheduled post from guests and other users, but not from its author', async () => {
+    const post = await makePost(author, 'Secret launch', FUTURE)
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+
+    expect((await indexData(http)).map((p) => p.id)).not.toContain(post.id)
+    expect((await indexData(http.actingAs(other))).map((p) => p.id)).not.toContain(post.id)
+    const mine = (await indexData(http.actingAs(author))).find((p) => p.id === post.id)
+    expect(mine?.publishedAt).toBe(FUTURE)
+
+    expect((await searchData(http, 'Secret')).map((p) => p.id)).not.toContain(post.id)
+    expect((await searchData(http.actingAs(other), 'Secret')).map((p) => p.id)).not.toContain(post.id)
+  })
+
+  it('becomes public once published_at is in the past, with no further action', async () => {
+    const post = await makePost(author, 'Timed reveal', FUTURE)
+    await http.get(`/posts/${post.id}`).assertNotFound()
+
+    await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    expect((await indexData(http)).map((p) => p.id)).toContain(post.id)
+    expect((await searchData(http.actingAs(other), 'Timed')).map((p) => p.id)).toContain(post.id)
+  })
+
+  it('lets the author set, change and clear the date on edit', async () => {
+    const post = await makePost(author, 'Editable', null)
+    const client = await http.actingAs(author).withCsrf()
+    const base = { title: 'Editable', excerpt: 'x', body: 'y' }
+
+    ;(await client.put(`/posts/${post.id}`, { ...base, publishAt: FUTURE })).assertRedirect()
+    expect((await Post.findOrFail(post.id)).publishedAt).toBe(FUTURE)
+    await http.get(`/posts/${post.id}`).assertNotFound()
+
+    ;(await client.put(`/posts/${post.id}`, { ...base, publishAt: '2099-12-24T18:30:00+01:00' })).assertRedirect()
+    expect((await Post.findOrFail(post.id)).publishedAt).toBe('2099-12-24T17:30:00.000Z')
+
+    ;(await client.put(`/posts/${post.id}`, { ...base })).assertRedirect()
+    expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+})
+
+describe('posts:scheduled command', () => {
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    author = await makeUser('ops')
+  })
+
+  async function run(): Promise<{ stdout: string; code: number }> {
+    const proc = Bun.spawn(['bun', 'bin/console.ts', 'posts:scheduled'], {
+      cwd: process.cwd(),
+      env: { ...process.env, NODE_ENV: 'test' },
+      stdout: 'pipe',
+      stderr: 'pipe',
+    })
+    const stdout = await new Response(proc.stdout).text()
+    return { stdout, code: await proc.exited }
+  }
+
+  it('prints one tab-separated line per scheduled post, soonest first, and nothing else', async () => {
+    await Post.newQuery().delete()
+    await makePost(author, 'Live already', null)
+    await makePost(author, 'Went live', PAST)
+    const later = await makePost(author, 'Later', '2099-06-01T12:00:00.000Z')
+    const sooner = await makePost(author, 'Sooner', '2099-05-01T12:00:00.000Z')
+
+    const { stdout, code } = await run()
+    expect(code).toBe(0)
+    expect(stdout).toBe(
+      `${sooner.id}\tSooner\t2099-05-01T12:00:00.000Z\n${later.id}\tLater\t2099-06-01T12:00:00.000Z\n`,
+    )
+  })
+
+  it('prints nothing when nothing is scheduled', async () => {
+    await Post.newQuery().delete()
+    await makePost(author, 'Only live', null)
+
+    const { stdout, code } = await run()
+    expect(code).toBe(0)
+    expect(stdout).toBe('')
+  })
+})
