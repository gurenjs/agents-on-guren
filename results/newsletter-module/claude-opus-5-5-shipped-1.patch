+import type { Router } from '@guren/core'
+import NewsletterSubscriptionController from './app/Http/Controllers/NewsletterSubscriptionController.js'
+import { NewsletterEmailSchema } from './app/Http/Validators/NewsletterValidator.js'
+import { NewsletterSubscription } from './app/Models/NewsletterSubscription.js'
+
+// Paths are relative to the module prefix, `/newsletter`.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post(
+    '/subscribe',
+    { name: 'newsletter.subscribe', body: NewsletterEmailSchema },
+    [NewsletterSubscriptionController, 'subscribe'],
+  )
+  router.get(
+    '/confirm/:token',
+    { name: 'newsletter.confirm', bind: { token: [NewsletterSubscription, 'token'] } },
+    [NewsletterSubscriptionController, 'confirm'],
+  )
+  router.post(
+    '/unsubscribe',
+    { name: 'newsletter.unsubscribe', body: NewsletterEmailSchema },
+    [NewsletterSubscriptionController, 'unsubscribe'],
+  )
+}
