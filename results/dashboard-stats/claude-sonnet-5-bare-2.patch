diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..4ff0677
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,74 @@
+import { beforeAll, describe, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('dashboard', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects a guest to login', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('shows the signed-in user post count and recent posts, newest first, capped at 5', async () => {
+    const owner = await User.create({ name: 'Dashboard Owner', email: `owner-${Date.now()}@example.com`, password: 'password123' })
+    const other = await User.create({ name: 'Someone Else', email: `other-${Date.now()}@example.com`, password: 'password123' })
+
+    // Six posts by the owner, in creation order — the newest five should show up, newest first.
+    const ownerPosts = []
+    for (let i = 0; i < 6; i++) {
+      ownerPosts.push(
+        await Post.forceCreate({
+          title: `Owner Post ${i}`,
+          excerpt: 'excerpt',
+          body: 'body',
+          authorId: owner.id,
+        }),
+      )
+    }
+
+    // A post by another user must never show up on the owner's dashboard.
+    await Post.forceCreate({ title: 'Not Mine', excerpt: 'excerpt', body: 'body', authorId: other.id })
+
+    const response = await http.actingAs(owner).get('/dashboard')
+    const { payload } = await readInertiaResponse(response.raw)
+
+    const props = payload.props as { postCount: number; recentPosts: Array<{ id: number; title: string }> }
+
+    if (props.postCount !== 6) {
+      throw new Error(`expected postCount to be 6, got ${props.postCount}`)
+    }
+    if (props.recentPosts.length !== 5) {
+      throw new Error(`expected 5 recent posts, got ${props.recentPosts.length}`)
+    }
+
+    const expectedTitles = [ownerPosts[5], ownerPosts[4], ownerPosts[3], ownerPosts[2], ownerPosts[1]].map((post) => post.title)
+    const actualTitles = props.recentPosts.map((post) => post.title)
+    if (JSON.stringify(actualTitles) !== JSON.stringify(expectedTitles)) {
+      throw new Error(`expected recent posts ${JSON.stringify(expectedTitles)}, got ${JSON.stringify(actualTitles)}`)
+    }
+    if (actualTitles.includes('Not Mine')) {
+      throw new Error('recent posts leaked another user\'s post')
+    }
+  })
+
+  it('shows a zero count and empty list for a user with no posts', async () => {
+    const user = await User.create({ name: 'No Posts', email: `noposts-${Date.now()}@example.com`, password: 'password123' })
+
+    const response = await http.actingAs(user).get('/dashboard')
+    const { payload } = await readInertiaResponse(response.raw)
+    const props = payload.props as { postCount: number; recentPosts: Array<{ id: number; title: string }> }
+
+    if (props.postCount !== 0) {
+      throw new Error(`expected postCount to be 0, got ${props.postCount}`)
+    }
+    if (props.recentPosts.length !== 0) {
+      throw new Error(`expected 0 recent posts, got ${props.recentPosts.length}`)
+    }
+  })
+})
