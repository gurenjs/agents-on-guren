+
+// posts.index paginates newest-first. Extra posts are seeded directly
+// through the Post model (bypassing HTTP) so the page math below is checked
+// against a known, real set of rows rather than mocked data.
+describe('posts.index', () => {
+  let http: TestApp
+  let newestIds: number[]
+  let total: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    const author = await User.first()
+    if (!author) {
+      throw new Error('expected the demo user seeder to have run')
+    }
+
+    for (let i = 0; i < 25; i++) {
+      await Post.forceCreate({
+        title: `Pagination test post ${i}`,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: author.id,
+      })
+    }
+
+    const all = await Post.newQuery().orderBy('id', 'desc').get()
+    total = all.length
+    newestIds = all.slice(0, 10).map((post) => post.id)
+  })
+
+  async function fetchIndex(path: string) {
+    const response = await http.withHeader('X-Inertia', 'true').get(path)
+    return response.json<{ props: PaginatedPageProps<PostResourceData> }>()
+  }
+
+  it('shows the newest posts on the first page by default', async () => {
+    const { props } = await fetchIndex('/posts')
+
+    expect(props.data.map((post) => post.id)).toEqual(newestIds)
+    expect(props.pagination.meta.currentPage).toBe(1)
+    expect(props.pagination.meta.from).toBe(1)
+    expect(props.pagination.meta.to).toBe(10)
+    expect(props.pagination.meta.total).toBe(total)
+  })
+
+  it('treats ?page=1 the same as the default page', async () => {
+    const { props } = await fetchIndex('/posts?page=1')
+
+    expect(props.data.map((post) => post.id)).toEqual(newestIds)
+    expect(props.pagination.meta.currentPage).toBe(1)
+    expect(props.pagination.links.prev).toBeNull()
+  })
+
+  it('advances to the next 10 posts on page 2', async () => {
+    const all = await Post.newQuery().orderBy('id', 'desc').get()
+    const expectedIds = all.slice(10, 20).map((post) => post.id)
+
+    const { props } = await fetchIndex('/posts?page=2')
+
+    expect(props.data.map((post) => post.id)).toEqual(expectedIds)
+    expect(props.pagination.meta.currentPage).toBe(2)
+    expect(props.pagination.meta.from).toBe(11)
+    expect(props.pagination.meta.to).toBe(20)
+  })
+})
