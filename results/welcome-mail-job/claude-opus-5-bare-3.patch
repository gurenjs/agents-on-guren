index 0000000..d193818
--- /dev/null
+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,40 @@
+import { mail, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+import { mailFrom } from '../../config/mail.js'
+
+export interface WelcomeMailRecipient {
+  name: string
+  email: string
+}
+
+/**
+ * The greeting every newly registered account receives. Sent from
+ * `SendWelcomeEmailJob`, never from the registration request itself.
+ *
+ * The sender is set explicitly rather than left to the manager's default, so
+ * the message carries it whichever manager ends up delivering it — the one in
+ * this process, or the one a worker booted.
+ */
+export async function sendWelcomeMail(manager: MailManager, recipient: WelcomeMailRecipient): Promise<void> {
+  const app = appName()
+
+  const result = await mail(manager)
+    .from(mailFrom())
+    .to(recipient.email)
+    .subject(`Welcome to ${app}, ${recipient.name}!`)
+    .text(
+      [
+        `Hi ${recipient.name},`,
+        '',
+        `Welcome to ${app}! Your account is ready — sign in any time to read the latest posts or write your own.`,
+        '',
+        `— The ${app} team`,
+      ].join('\n'),
+    )
+    .send()
+
+  // Thrown rather than swallowed so the queue retries the delivery.
+  if (!result.success) {
+    throw new Error(result.error ?? `Sending the welcome email to ${recipient.email} failed.`)
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..7cbae62
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,19 @@
+import { ServiceProvider, createMailManager, getMailManager, setMailManager, type MailManager } from '@guren/core'
+import { mailConfig } from '../../config/mail.js'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    this.container.instance('mail', createMailManager(mailConfig()))
+  }
+
+  boot(): void {
+    // Queued mail is sent from a job, which runs without a request and — in
+    // production — in a worker process of its own, so the manager is published
+    // globally for jobs to reach. It is the same instance the container hands
+    // out. A manager installed before boot, such as a test recording what gets
+    // sent, is left alone.
+    if (!getMailManager()) {
+      setMailManager(this.container.make<MailManager>('mail'))
+    }
+  }
+}
