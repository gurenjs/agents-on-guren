diff --git a/app/Utils/StorageHelper.ts b/app/Utils/StorageHelper.ts
new file mode 100644
index 0000000..fa5e290
--- /dev/null
+++ b/app/Utils/StorageHelper.ts
@@ -0,0 +1,51 @@
+import { readdir, mkdir, rm } from 'fs/promises'
+import { createWriteStream, existsSync } from 'fs'
+import { dirname, join } from 'path'
+import { fileURLToPath } from 'url'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const storageDir = join(__dirname, '../../storage')
+
+export async function ensureStorageDir(): Promise<void> {
+  if (!existsSync(storageDir)) {
+    await mkdir(storageDir, { recursive: true })
+  }
+}
+
+export async function saveAttachmentFile(file: File): Promise<string> {
+  await ensureStorageDir()
+
+  const buffer = await file.arrayBuffer()
+  const filename = `${Date.now()}-${Math.random().toString(36).substring(7)}`
+  const filePath = join(storageDir, filename)
+
+  const stream = createWriteStream(filePath)
+  const uint8Array = new Uint8Array(buffer)
+
+  await new Promise((resolve, reject) => {
+    stream.write(Buffer.from(uint8Array), (err) => {
+      if (err) reject(err)
+      else {
+        stream.end(resolve as () => void)
+      }
+    })
+    stream.on('error', reject)
+  })
+
+  return filename
+}
+
+export async function deleteAttachmentFile(filename: string): Promise<void> {
+  const filePath = join(storageDir, filename)
+  if (existsSync(filePath)) {
+    await rm(filePath)
+  }
+}
+
+export async function getAttachmentPath(filename: string): Promise<string> {
+  return join(storageDir, filename)
+}
+
+export function getStorageDir(): string {
+  return storageDir
+}
