diff --git a/tests/PostScheduling.test.ts b/tests/PostScheduling.test.ts
new file mode 100644
index 0000000..beb8d62
--- /dev/null
+++ b/tests/PostScheduling.test.ts
@@ -0,0 +1,178 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { BufferedOutput } from '@guren/core'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { kernel } from '../src/console.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const HOUR = 60 * 60 * 1000
+const FUTURE = new Date(Date.now() + 24 * HOUR).toISOString()
+const PAST = new Date(Date.now() - 24 * HOUR).toISOString()
+
+// The test database persists between runs, so every fixture carries a unique
+// suffix and assertions look for their own rows rather than exact counts.
+const run = Date.now().toString(36)
+
+async function listIds(response: Response): Promise<number[]> {
+  const { payload } = await readInertiaResponse(response)
+  const data = payload.props.data as Array<{ id: number }>
+  return data.map((post) => post.id)
+}
+
+describe('scheduled publishing', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: PostRecord
+  let live: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({ name: 'Author', email: `author-${run}@example.com`, password: 'secret' }))!
+    other = (await User.create({ name: 'Other', email: `other-${run}@example.com`, password: 'secret' }))!
+    scheduled = (await Post.forceCreate({
+      title: `Scheduled ${run}`,
+      excerpt: `scheduled-${run}`,
+      body: 'Not yet.',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    }))!
+    live = (await Post.forceCreate({
+      title: `Live ${run}`,
+      excerpt: `live-${run}`,
+      body: 'Already out.',
+      authorId: author.id,
+      publishedAt: null,
+    }))!
+  })
+
+  describe('store and update', () => {
+    it('rejects a publishAt that is not a date and time, saving nothing', async () => {
+      const csrf = await http.actingAs(author).withCsrf('/posts')
+      await csrf
+        .json()
+        .post('/posts', { title: `Bad ${run}`, excerpt: 'x', body: 'y', publishAt: 'next tuesday' })
+        .assertUnprocessable()
+      expect(await Post.first({ title: `Bad ${run}` })).toBeNull()
+    })
+
+    it('stores the schedule as an ISO 8601 UTC timestamp', async () => {
+      const csrf = await http.actingAs(author).withCsrf('/posts')
+      const response = await csrf.post('/posts', { title: `Later ${run}`, excerpt: 'x', body: 'y', publishAt: FUTURE })
+      response.assertRedirect()
+      const post = await Post.first({ title: `Later ${run}` })
+      expect(post?.publishedAt).toBe(FUTURE)
+    })
+
+    it('publishes on save when publishAt is absent or null', async () => {
+      const csrf = await http.actingAs(author).withCsrf('/posts')
+      await csrf.post('/posts', { title: `Now ${run}`, excerpt: 'x', body: 'y' }).assertRedirect()
+      await csrf.post('/posts', { title: `Now null ${run}`, excerpt: 'x', body: 'y', publishAt: null }).assertRedirect()
+      expect((await Post.first({ title: `Now ${run}` }))?.publishedAt).toBeNull()
+      expect((await Post.first({ title: `Now null ${run}` }))?.publishedAt).toBeNull()
+    })
+
+    it('lets the author set and clear the date on an existing post', async () => {
+      const csrf = await http.actingAs(author).withCsrf('/posts')
+      const body = { title: live.title, excerpt: live.excerpt, body: live.body }
+      await csrf.put(`/posts/${live.id}`, { ...body, publishAt: FUTURE }).assertRedirect()
+      expect((await Post.find(live.id))?.publishedAt).toBe(FUTURE)
+      await csrf.put(`/posts/${live.id}`, { ...body, publishAt: null }).assertRedirect()
+      expect((await Post.find(live.id))?.publishedAt).toBeNull()
+    })
+  })
+
+  describe('a scheduled post page', () => {
+    it('is 404 for guests and for other users', async () => {
+      await http.get(`/posts/${scheduled.id}`).assertNotFound()
+      await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+    })
+
+    it('opens for its author with publishedAt on the post prop', async () => {
+      const response = await http.actingAs(author).get(`/posts/${scheduled.id}`)
+      response.assertOk()
+      const { payload } = await readInertiaResponse(response.raw)
+      const post = payload.props.post as { id: number; publishedAt: string | null }
+      expect(post.id).toBe(scheduled.id)
+      expect(post.publishedAt).toBe(FUTURE)
+    })
+  })
+
+  describe('the posts list', () => {
+    it('hides a scheduled post from guests and other users, keeps public posts', async () => {
+      const guest = await listIds((await http.get('/posts')).raw)
+      expect(guest).not.toContain(scheduled.id)
+      expect(guest).toContain(live.id)
+
+      const asOther = await listIds((await http.actingAs(other).get('/posts')).raw)
+      expect(asOther).not.toContain(scheduled.id)
+    })
+
+    it('shows the author their scheduled post with its date', async () => {
+      const response = await http.actingAs(author).get('/posts')
+      const { payload } = await readInertiaResponse(response.raw)
+      const data = payload.props.data as Array<{ id: number; publishedAt: string | null }>
+      expect(data.find((post) => post.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+    })
+  })
+
+  describe('search', () => {
+    it('never returns a scheduled post to guests or other users', async () => {
+      const keywords = [`scheduled-${run}`]
+      const guest = await (await http.query('/posts/search', { keywords })).json<{ data: Array<{ id: number }> }>()
+      expect(guest.data.map((post) => post.id)).not.toContain(scheduled.id)
+
+      const asOther = await (await http.actingAs(other).query('/posts/search', { keywords })).json<{ data: Array<{ id: number }> }>()
+      expect(asOther.data.map((post) => post.id)).not.toContain(scheduled.id)
+    })
+  })
+
+  describe('once the time has passed', () => {
+    it('becomes public everywhere with no further action', async () => {
+      const post = (await Post.forceCreate({
+        title: `Past ${run}`,
+        excerpt: `past-${run}`,
+        body: 'Was scheduled.',
+        authorId: author.id,
+        publishedAt: FUTURE,
+      }))!
+      await http.get(`/posts/${post.id}`).assertNotFound()
+
+      await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+      await http.get(`/posts/${post.id}`).assertOk()
+      expect(await listIds((await http.actingAs(other).get('/posts')).raw)).toContain(post.id)
+      const search = await (await http.query('/posts/search', { keywords: [`past-${run}`] })).json<{ data: Array<{ id: number }> }>()
+      expect(search.data.map((entry) => entry.id)).toContain(post.id)
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    it('prints only scheduled posts, tab-separated, soonest first', async () => {
+      const sooner = (await Post.forceCreate({
+        title: `Sooner ${run}`,
+        excerpt: 'x',
+        body: 'y',
+        authorId: author.id,
+        publishedAt: new Date(Date.now() + HOUR).toISOString(),
+      }))!
+      const output = new BufferedOutput()
+      kernel.setOutput(output)
+
+      const exitCode = await kernel.handle(['posts:scheduled'])
+
+      expect(exitCode).toBe(0)
+      const lines = output.getLines()
+      for (const line of lines) {
+        const [, , publishedAt] = line.split('\t')
+        expect(new Date(publishedAt!).getTime()).toBeGreaterThan(Date.now())
+      }
+      const soonerIndex = lines.indexOf(`${sooner.id}\t${sooner.title}\t${sooner.publishedAt}`)
+      const laterIndex = lines.indexOf(`${scheduled.id}\t${scheduled.title}\t${FUTURE}`)
+      expect(soonerIndex).toBeGreaterThanOrEqual(0)
+      expect(laterIndex).toBeGreaterThan(soonerIndex)
+      expect(lines.some((line) => line.startsWith(`${live.id}\t`))).toBe(false)
+    })
+  })
+})
