index 0000000..f42ac42
--- /dev/null
+++ b/app/Http/Middleware/ThrottleLoginAttempts.ts
@@ -0,0 +1,86 @@
+import { defineMiddleware, HttpException } from '@guren/core'
+
+const LIMIT = 5
+const WINDOW_MS = 60 * 1000 // 1 minute
+
+interface Attempt {
+  timestamp: number
+}
+
+export const attempts = new Map<string, Attempt[]>()
+
+function getClientIp(honoRequest: any): string {
+  // Per spec: do not trust forwarded-for headers
+  // Try to get the actual connection IP from the request info
+  // Hono request object may have connectionRequestInfo with remoteAddress in Bun
+  const info = honoRequest.connectionRequestInfo
+  if (info?.remoteAddress) {
+    const addr = info.remoteAddress
+    // Extract the IP without port if present
+    if (addr.includes(':')) {
+      return addr.split(':')[0]
+    }
+    return addr
+  }
+
+  // Fallback: use a shared identifier that throttles all unknown requests together
+  // This ensures we "fail closed" rather than letting unknown clients through unthrottled
+  return 'unknown-client'
+}
+
+function cleanOldAttempts(clientIp: string): void {
+  const now = Date.now()
+  const clientAttempts = attempts.get(clientIp)
+
+  if (!clientAttempts) return
+
+  const validAttempts = clientAttempts.filter((a) => now - a.timestamp < WINDOW_MS)
+  if (validAttempts.length === 0) {
+    attempts.delete(clientIp)
+  } else {
+    attempts.set(clientIp, validAttempts)
+  }
+}
+
+function recordAttempt(clientIp: string): void {
+  cleanOldAttempts(clientIp)
+  const clientAttempts = attempts.get(clientIp) ?? []
+  clientAttempts.push({ timestamp: Date.now() })
+  attempts.set(clientIp, clientAttempts)
+}
+
+function getAttemptCount(clientIp: string): number {
+  cleanOldAttempts(clientIp)
+  return attempts.get(clientIp)?.length ?? 0
+}
+
+function getRetryAfterSeconds(clientIp: string): number {
+  const clientAttempts = attempts.get(clientIp)
+  if (!clientAttempts || clientAttempts.length === 0) return 0
+
+  const oldestAttempt = clientAttempts[0].timestamp
+  const now = Date.now()
+  const elapsedMs = now - oldestAttempt
+  const remainingMs = WINDOW_MS - elapsedMs
+
+  return Math.ceil(remainingMs / 1000)
+}
+
+export default defineMiddleware(async (c, next) => {
+  const clientIp = getClientIp(c.req)
+  const attemptCount = getAttemptCount(clientIp)
+
+  if (attemptCount >= LIMIT) {
+    const retryAfter = getRetryAfterSeconds(clientIp)
+    return c.json(
+      { message: 'Too many login attempts. Please try again later.' },
+      {
+        status: 429,
+        headers: { 'Retry-After': retryAfter.toString() },
+      },
+    )
+  }
+
+  recordAttempt(clientIp)
+  return next()
+})
