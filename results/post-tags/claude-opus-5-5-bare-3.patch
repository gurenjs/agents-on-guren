+
+  /**
+   * Makes `names` exactly the post's tags: unseen names become new tags, and
+   * names not listed are detached. Tags left unused stay.
+   */
+  static async syncTags(postId: number, names: readonly string[], trx?: TransactionHandle): Promise<void> {
+    const existing = names.length > 0 ? await Tag.newQuery({ trx }).whereIn('name', names).get() : []
+    const idsByName = new Map(existing.map((tag) => [tag.name, tag.id]))
+    for (const name of names) {
+      if (!idsByName.has(name)) {
+        const tag = await Tag.create({ name }, { trx })
+        idsByName.set(name, tag.id)
+      }
+    }
+
+    await PostTag.delete({ postId }, { trx })
+    for (const name of names) {
+      await PostTag.create({ postId, tagId: idsByName.get(name)! }, { trx })
+    }
   }
 }
 
