diff --git a/app/Models/PostTag.ts b/app/Models/PostTag.ts
new file mode 100644
index 0000000..e31ee42
--- /dev/null
+++ b/app/Models/PostTag.ts
@@ -0,0 +1,30 @@
+import { defineModel } from '@guren/core'
+import { postTags } from '../../db/schema.js'
+import { Tag } from './Tag.js'
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {
+  /** Make `names` exactly the post's tags: unknown names are created, unlisted ones disassociated. */
+  static async syncPost(postId: number, names: readonly string[]): Promise<void> {
+    const tags = await Tag.findOrCreateMany(names)
+    const wanted = new Set(tags.map((tag) => tag.id))
+    const current = await PostTag.where({ postId }).get()
+    const have = new Set(current.map((row) => row.tagId))
+
+    for (const row of current) {
+      if (!wanted.has(row.tagId)) await PostTag.delete({ id: row.id })
+    }
+    for (const tag of tags) {
+      if (!have.has(tag.id)) await PostTag.create({ postId, tagId: tag.id })
+    }
+  }
+
+  /** Ids of the posts carrying the tag named `name`; empty for an unknown tag. */
+  static async postIdsTagged(name: string): Promise<number[]> {
+    const tag = await Tag.where({ name }).first()
+    if (!tag) return []
+    const rows = await PostTag.where({ tagId: tag.id }).get()
+    return rows.map((row) => row.postId)
+  }
+}
diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..a5633a6
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,27 @@
+import { defineModel } from '@guren/core'
+import { tags } from '../../db/schema.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {
+  /** The tags named, in the order given, creating the ones that do not exist yet. */
+  static async findOrCreateMany(names: readonly string[]): Promise<TagRecord[]> {
+    if (names.length === 0) return []
+    const existing = await Tag.whereIn('name', names).get()
+    const byName = new Map(existing.map((tag) => [tag.name, tag]))
+    const result: TagRecord[] = []
+    for (const name of names) {
+      let tag = byName.get(name)
+      if (!tag) {
+        const created = await Tag.create({ name })
+        if (!created) throw new Error(`Tag "${name}" could not be created`)
+        tag = created
+        byName.set(name, tag)
+      }
+      result.push(tag)
+    }
+    return result
+  }
+}
