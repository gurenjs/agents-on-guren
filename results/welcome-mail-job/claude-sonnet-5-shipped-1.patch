diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..c7bf2d6
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,71 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeQueue, fakeMail } from '@guren/testing'
+import { createMailManager, setMailManager, setQueueDriver, processJob } from '@guren/core'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('register.store', () => {
+  let http: TestApp
+  let queue: ReturnType<typeof fakeQueue>
+  let mail: ReturnType<typeof fakeMail>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    // Point the app's queue at a holding queue and its mailer at a
+    // recording transport, so registration never actually sends mail —
+    // it only has to leave exactly one job waiting.
+    queue = fakeQueue()
+    setQueueDriver(queue.getDriver())
+
+    mail = fakeMail()
+    const testMailManager = createMailManager({ default: 'fake' })
+    testMailManager.registerTransport('fake', () => mail.getTransport())
+    setMailManager(testMailManager)
+  })
+
+  it('queues a welcome email and redirects, without sending anything yet', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertRedirect('/dashboard')
+
+    expect(queue.getDriver().getJobs().length).toBe(1)
+    expect(mail.getTransport().getMails().length).toBe(0)
+
+    const processed = await processJob(queue.getDriver(), 'default')
+    expect(processed).toBe(true)
+
+    const sent = mail.getTransport().getMails()
+    expect(sent.length).toBe(1)
+    expect(sent[0]!.message.to[0]!.email).toBe('ada@example.com')
+    expect(sent[0]!.message.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(sent[0]!.message.text).toContain('Ada Lovelace')
+  })
+
+  it('queues and sends nothing when registration is refused', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Bad Signup',
+        email: 'not-an-email',
+        password: 'password123',
+        passwordConfirmation: 'password123',
+      })
+      .assertUnprocessable()
+
+    expect(queue.getDriver().getJobs().length).toBe(0)
+    expect(mail.getTransport().getMails().length).toBe(0)
+  })
+})
