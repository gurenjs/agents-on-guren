diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..d591603
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,49 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+    author = (await User.forceCreate({ name: 'A', email: 'a@x.test', password: 'secret-pass-123' })) as { id: number }
+    other = (await User.forceCreate({ name: 'B', email: 'b@x.test', password: 'secret-pass-123' })) as { id: number }
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: '2999-01-01T00:00:00.000Z',
+    })
+    postId = post!.id
+  })
+
+  it('hides a scheduled post from guests and other users', async () => {
+    await http.get(`/posts/${postId}`).assertNotFound()
+    await http.actingAs(other as never).get(`/posts/${postId}`).assertNotFound()
+    await http.query('/posts/search', { keywords: ['Later'] }).assertJsonCount(0, 'data')
+  })
+
+  it('shows it to its author', async () => {
+    await http.actingAs(author as never).get(`/posts/${postId}`).assertOk()
+  })
+
+  it('shows it to everyone once the time has passed', async () => {
+    await Post.forceUpdate({ id: postId }, { publishedAt: '2000-01-01T00:00:00.000Z' })
+    await http.get(`/posts/${postId}`).assertOk()
+    expect(await Post.newQuery().count()).toBe(1)
+  })
+
+  it('rejects an invalid publishAt', async () => {
+    const csrf = await http.actingAs(author as never).withCsrf()
+    await csrf.json().post('/posts', { title: 't', excerpt: 'e', body: 'b', publishAt: 'next tuesday' }).assertUnprocessable()
+  })
+})
