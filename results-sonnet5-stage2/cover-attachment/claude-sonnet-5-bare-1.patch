diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..9b0817e
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,90 @@
+import { mkdir, unlink } from 'node:fs/promises'
+import { join } from 'node:path'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+// Private to the app: never under public/, served back by the cover route.
+const COVER_DIR = new URL('../../storage/covers/', import.meta.url).pathname
+
+export interface CoverImage {
+  bytes: Uint8Array
+  contentType: 'image/png' | 'image/jpeg'
+}
+
+function sniff(bytes: Uint8Array): CoverImage['contentType'] | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (bytes.length >= png.length && png.every((b, i) => bytes[i] === b)) return 'image/png'
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+/** Reads an upload and accepts it only if its bytes are really a PNG or JPEG. */
+export async function readCover(file: File): Promise<CoverImage> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const contentType = sniff(bytes)
+  if (!contentType) {
+    throw ValidationException.withMessages({ cover: 'Cover must be a PNG or JPEG image.' })
+  }
+  return { bytes, contentType }
+}
+
+function pathFor(key: string): string {
+  return join(COVER_DIR, key)
+}
+
+async function removeFile(key: string): Promise<void> {
+  await unlink(pathFor(key)).catch(() => {})
+}
+
+export async function findCover(postId: number): Promise<AttachmentRecord | null> {
+  return (await Attachment.newQuery().where('postId', postId).first()) ?? null
+}
+
+export async function findCovers(postIds: number[]): Promise<Map<number, AttachmentRecord>> {
+  if (postIds.length === 0) return new Map()
+  const rows = await Attachment.newQuery().whereIn('postId', postIds).get()
+  return new Map(rows.map((row) => [row.postId, row]))
+}
+
+/** Removes a post's cover row and file, if it has one. */
+export async function removeCover(postId: number): Promise<void> {
+  const existing = await findCover(postId)
+  if (!existing) return
+  await Attachment.delete({ id: existing.id })
+  await removeFile(existing.key)
+}
+
+/** Stores `image` as the post's cover, replacing (and deleting) any previous one. */
+export async function replaceCover(postId: number, image: CoverImage): Promise<void> {
+  const key = `${crypto.randomUUID()}${image.contentType === 'image/png' ? '.png' : '.jpg'}`
+  await mkdir(COVER_DIR, { recursive: true })
+  await Bun.write(pathFor(key), image.bytes)
+
+  try {
+    await removeCover(postId)
+    await Attachment.forceCreate({
+      postId,
+      key,
+      contentType: image.contentType,
+      size: image.bytes.length,
+    })
+  } catch (error) {
+    await removeFile(key)
+    throw error
+  }
+}
+
+export async function readStoredCover(key: string): Promise<{ file: ReturnType<typeof Bun.file> } | null> {
+  const file = Bun.file(pathFor(key))
+  return (await file.exists()) ? { file } : null
+}
+
+export function coverUrl(cover: AttachmentRecord | null | undefined): string | null {
+  return cover ? `/covers/${cover.key}` : null
+}
+
+/** Attaches each post's cover record (or null) so PostResource can build `coverUrl`. */
+export async function withCovers<T extends { id: number }>(posts: T[]): Promise<Array<T & { cover: AttachmentRecord | null }>> {
+  const covers = await findCovers(posts.map((post) => post.id))
+  return posts.map((post) => Object.assign(post, { cover: covers.get(post.id) ?? null }))
+}
