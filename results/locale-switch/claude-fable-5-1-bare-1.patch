diff --git a/resources/js/components/LocaleSwitcher.tsx b/resources/js/components/LocaleSwitcher.tsx
new file mode 100644
index 0000000..adde43b
--- /dev/null
+++ b/resources/js/components/LocaleSwitcher.tsx
@@ -0,0 +1,41 @@
+import { Link } from '@inertiajs/react'
+import { useTranslation } from '@guren/inertia-client'
+import { route } from '@/.guren/routes.gen'
+
+// Mirrors SUPPORTED_LOCALES in app/Http/Validators/LocaleValidator.ts; the
+// server rejects anything else, this only decides which buttons to draw.
+const LOCALES = ['en', 'ja'] as const
+
+// Each language is a POST to locale.update through Inertia's Link, so the
+// request carries the XSRF header like the log-out button, and the browser's
+// Referer brings the reader back to the page they were on.
+export default function LocaleSwitcher() {
+  const { locale, t } = useTranslation()
+
+  return (
+    <div
+      role="group"
+      aria-label={t('locale.label')}
+      className="flex items-center gap-1 font-mono text-xs uppercase tracking-wide"
+    >
+      {LOCALES.map((candidate) =>
+        candidate === locale ? (
+          <span key={candidate} aria-current="true" className="px-2 py-1 font-bold text-g-heading">
+            {t(`locale.${candidate}`)}
+          </span>
+        ) : (
+          <Link
+            key={candidate}
+            href={route('locale.update')}
+            method="post"
+            as="button"
+            data={{ locale: candidate }}
+            className="px-2 py-1 text-g-text-2 transition hover:text-g-heading"
+          >
+            {t(`locale.${candidate}`)}
+          </Link>
+        ),
+      )}
+    </div>
+  )
+}
