diff --git a/tests/PostAgentTools.test.ts b/tests/PostAgentTools.test.ts
new file mode 100644
index 0000000..8701457
--- /dev/null
+++ b/tests/PostAgentTools.test.ts
@@ -0,0 +1,200 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken, revokeAllApiTokens } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The posts routes that declare `agent` in routes/web.ts, called the way an
+// assistant calls them: as tools, in process through app.agent(), and over the
+// /mcp endpoint with a bearer token. Unlike the starter tests these read and
+// write the test database, so the suite migrates it first and removes what it
+// created afterwards.
+
+// Marks every row this file creates, so the cleanup cannot touch anything else.
+const MARKER = `agent-tools-${Date.now()}`
+
+interface ToolDescription {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolCallResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+interface SearchResult {
+  data: Array<{ id: number; title: string; authorId: number }>
+}
+
+const payload = (title: string) => ({
+  title,
+  excerpt: 'Written by an assistant.',
+  body: 'Drafted over MCP.',
+})
+
+const postsTitled = (title: string) => Post.where({ title })
+
+describe('posts agent tools', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    // A tool call in process is an ordinary request, so posts_store needs the
+    // CSRF token a browser would send. Over /mcp the bearer stands in for it.
+    http = await (await TestApp.fromApp(app)).withCsrf('/health')
+    author = (await User.create({
+      name: 'Agent Tools Author',
+      email: `${MARKER}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+  })
+
+  afterAll(async () => {
+    const store = app.auth.getApiTokenStore()
+    if (store) {
+      await revokeAllApiTokens(author.id, store)
+    }
+    await Post.delete({ authorId: author.id })
+    await User.delete({ id: author.id })
+  })
+
+  describe('as tools', () => {
+    it('exposes exactly posts_search and posts_store, only the search read-only', async () => {
+      const tools = await http.agent().tools()
+      const readOnly = Object.fromEntries(tools.map((tool) => [tool.toolName, tool.annotations.readOnlyHint]))
+
+      expect(readOnly).toEqual({ posts_search: true, posts_store: false })
+    })
+
+    it('searches without a signed-in user and answers what QUERY /posts/search answers', async () => {
+      const title = `${MARKER} searchable`
+      await Post.forceCreate({ ...payload(title), authorId: author.id })
+      const input = { keywords: [title], limit: 5 }
+
+      const result = await http.agent().call('posts_search', input).assertOk()
+      const response = await http.query('/posts/search', input).assertOk()
+
+      expect(result.json<SearchResult>()).toEqual(await response.json<SearchResult>())
+      expect(result.json<SearchResult>().data.map((post) => post.title)).toEqual([title])
+    })
+
+    it('creates a post for the calling user, whatever authorId says', async () => {
+      const title = `${MARKER} created`
+
+      const result = await http.agent().call('posts_store', { ...payload(title), authorId: author.id + 1 }, { as: author })
+
+      expect(result.isError).toBe(false)
+      const created = await postsTitled(title)
+      expect(created.map((post) => post.authorId)).toEqual([author.id])
+    })
+
+    it('rejects what the form rejects with a 422 and creates nothing', async () => {
+      const excerpt = `${MARKER} invalid`
+
+      const result = await http.agent()
+        .call('posts_store', { ...payload(''), excerpt }, { as: author })
+        .assertStatus(422)
+
+      expect(result.isError).toBe(true)
+      expect(await Post.where({ excerpt })).toEqual([])
+    })
+
+    it('sends a guest to the login page and creates nothing', async () => {
+      const title = `${MARKER} guest`
+
+      const result = await http.agent().call('posts_store', payload(title)).assertStatus(302)
+
+      expect(result.response.headers.get('Location')).toBe('/login')
+      expect(await postsTitled(title)).toEqual([])
+    })
+  })
+
+  describe('POST /mcp', () => {
+    let bearer: string
+
+    // One JSON-RPC request. The endpoint is stateless, so no session precedes
+    // it; the answer arrives as JSON or as a single server-sent event.
+    async function rpc<T>(method: string, params?: Record<string, unknown>): Promise<T> {
+      const response = await http
+        .withHeaders({ Authorization: `Bearer ${bearer}`, Accept: 'application/json, text/event-stream' })
+        .post('/mcp', { jsonrpc: '2.0', id: 1, method, ...(params ? { params } : {}) })
+        .assertOk()
+      const text = await response.text()
+      const data = text.split('\n').find((line) => line.startsWith('data:'))?.slice('data:'.length) ?? text
+      const message = JSON.parse(data) as { result?: T; error?: { message: string } }
+      if (!message.result) {
+        throw new Error(`${method} failed: ${message.error?.message ?? text}`)
+      }
+
+      return message.result
+    }
+
+    beforeAll(async () => {
+      const store = app.auth.getApiTokenStore()
+      if (!store) {
+        throw new Error('The app configures no API token store.')
+      }
+      const issued = await createApiToken(store, {
+        name: MARKER,
+        userId: author.id,
+        abilities: ['tools:*'],
+      })
+      bearer = issued.plainTextToken
+    })
+
+    it('refuses a call without a credential', async () => {
+      await http.post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list' }).assertUnauthorized()
+    })
+
+    it('refuses a credential it never issued', async () => {
+      await http
+        .withHeaders({ Authorization: 'Bearer not-a-token' })
+        .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list' })
+        .assertUnauthorized()
+    })
+
+    it('lists the two tools with their read-only flags', async () => {
+      const { tools } = await rpc<{ tools: ToolDescription[] }>('tools/list')
+      // The server adds its own helpers, guren_preflight among them.
+      const own = tools.filter((tool) => !tool.name.startsWith('guren_'))
+      const readOnly = Object.fromEntries(own.map((tool) => [tool.name, tool.annotations?.readOnlyHint]))
+
+      expect(readOnly).toEqual({ posts_search: true, posts_store: false })
+    })
+
+    it('creates a post as the credential\'s user and finds it again', async () => {
+      const title = `${MARKER} over mcp`
+
+      const stored = await rpc<ToolCallResult>('tools/call', {
+        name: 'posts_store',
+        arguments: { ...payload(title), authorId: author.id + 1 },
+      })
+      const found = await rpc<ToolCallResult>('tools/call', {
+        name: 'posts_search',
+        arguments: { keywords: [title] },
+      })
+
+      expect(stored.isError).toBeUndefined()
+      const { data } = JSON.parse(found.content[0]?.text ?? '') as SearchResult
+      expect(data.map((post) => [post.title, post.authorId])).toEqual([[title, author.id]])
+    })
+
+    it('answers invalid input with the 422 body as an error result', async () => {
+      const excerpt = `${MARKER} invalid over mcp`
+
+      const result = await rpc<ToolCallResult>('tools/call', {
+        name: 'posts_store',
+        arguments: { ...payload(''), excerpt },
+      })
+
+      expect(result.isError).toBe(true)
+      expect(result.content[0]?.text).toContain('Title is required.')
+      expect(await Post.where({ excerpt })).toEqual([])
+    })
+  })
+})
