+import { Router } from '@guren/core'
+import SubscriptionController from './app/Http/Controllers/SubscriptionController.js'
+import { SubscribeSchema, UnsubscribeSchema } from './app/Http/Validators/SubscriptionValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/newsletter/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [
+    SubscriptionController,
+    'subscribe',
+  ])
+
+  router.get('/newsletter/confirm/:token', { name: 'newsletter.confirm' }, [SubscriptionController, 'confirm'])
+
+  router.post('/newsletter/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [
+    SubscriptionController,
+    'unsubscribe',
+  ])
+}
