diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..bbde8dd
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,98 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// Feature tests against the SQLite test database (NODE_ENV=test under bun test).
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  const payload = (tags?: string) => ({ title: 'Tagged', excerpt: 'An excerpt', body: 'A body', tags })
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const rows = await PostTag.where({ postId }).get()
+    const tags = await Tag.all()
+    return rows.map((row) => tags.find((tag) => tag.id === row.tagId)!.name).sort()
+  }
+
+  async function inertiaProps(path: string): Promise<Record<string, any>> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path).assertOk()
+    const page = (await response.json()) as { props: Record<string, any> }
+    return page.props
+  }
+
+  async function createPost(tags?: string): Promise<number> {
+    await http.actingAs(author).post('/posts', payload(tags)).assertRedirect()
+    const [latest] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+    return latest!.id
+  }
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  beforeEach(async () => {
+    await PostTag.newQuery().delete()
+    await Tag.newQuery().delete()
+    await Post.newQuery().delete()
+    author =
+      (await User.first({ email: 'tags-author@example.com' })) ??
+      (await User.forceCreate({ name: 'Tags Author', email: 'tags-author@example.com', password: 'secret' }))
+  })
+
+  it('stores, shows and replaces tags', async () => {
+    const id = await createPost('bun, webdev')
+    expect(await tagNamesOf(id)).toEqual(['bun', 'webdev'])
+    expect((await inertiaProps(`/posts/${id}`)).post.tags).toEqual(['bun', 'webdev'])
+
+    await http.actingAs(author).put(`/posts/${id}`, payload('bun')).assertRedirect()
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+    expect((await inertiaProps(`/posts/${id}`)).post.tags).toEqual(['bun'])
+  })
+
+  it('filters the list by tag', async () => {
+    const tagged = await createPost('bun')
+    await createPost('')
+
+    const all = await inertiaProps('/posts')
+    expect(all.data.map((post: { tags: string[] }) => post.tags)).toEqual([[], ['bun']])
+
+    const filtered = await inertiaProps('/posts?tag=bun')
+    expect(filtered.data.map((post: { id: number }) => post.id)).toEqual([tagged])
+    expect(filtered.pagination.links.pages[0].url).toContain('tag=bun')
+
+    expect((await inertiaProps('/posts?tag=nobody')).data).toEqual([])
+  })
+
+  it('normalizes names and refuses broken input', async () => {
+    const id = await createPost(' bun ,bun,,')
+    expect(await tagNamesOf(id)).toEqual(['bun'])
+
+    const thirty = 'x'.repeat(30)
+    expect(await tagNamesOf(await createPost(thirty))).toEqual([thirty])
+
+    const before = (await Post.all()).length
+    const tagsBefore = (await Tag.all()).length
+    const emptyTitle = await http.actingAs(author).post('/posts', { ...payload(), title: '' })
+    for (const tags of ['a,b,c,d,e,f', 'y'.repeat(31)]) {
+      const refused = await http.actingAs(author).json().post('/posts', payload(tags)).assertStatus(emptyTitle.status)
+      const body = (await refused.json()) as { errors?: Record<string, unknown> }
+      expect(Object.keys(body.errors ?? {})).toEqual(['tags'])
+    }
+    expect((await Post.all()).length).toBe(before)
+    expect((await Tag.all()).length).toBe(tagsBefore)
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('bun')
+    await http.actingAs(author).delete(`/posts/${id}`).assertRedirect()
+    expect(await Post.find(id)).toBeNull()
+    expect(await PostTag.where({ postId: id }).get()).toEqual([])
+  })
+})
