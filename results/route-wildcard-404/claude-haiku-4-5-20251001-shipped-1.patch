+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns 200 for year archive', async () => {
+    await http.get('/posts/archive/2026').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns 200 for month archive with leading zero', async () => {
+    await http.get('/posts/archive/2026/08').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns 200 for month archive without leading zero', async () => {
+    await http.get('/posts/archive/2026/8').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns 422 for invalid month', async () => {
+    await http.get('/posts/archive/2026/13').assertUnprocessable()
+  })
+
+  it('returns 422 for month zero', async () => {
+    await http.get('/posts/archive/2026/0').assertUnprocessable()
+  })
+
+  it('returns 422 for non-numeric year', async () => {
+    await http.get('/posts/archive/abc').assertUnprocessable()
+  })
+})
