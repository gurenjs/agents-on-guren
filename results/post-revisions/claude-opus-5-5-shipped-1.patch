+
+async function makeUser(): Promise<UserRecord> {
+  userCount += 1
+  return (await User.create({
+    name: `Author ${userCount}`,
+    email: `author${userCount}@example.com`,
+    password: 'password123',
+  })) as UserRecord
+}
+
+async function makePost(author: UserRecord, title: string): Promise<PostRecord> {
+  return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: author.id })
+}
+
+function payload(title: string) {
+  return { title, excerpt: `${title} excerpt`, body: `${title} body` }
+}
+
+async function revisionTitles(postId: number): Promise<string[]> {
+  const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+  return rows.map((row) => row.title)
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('keeps the previous version on each edit and restores any of them', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'First')
+    expect(await revisionTitles(post.id)).toEqual([])
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, payload('Second')).assertRedirect(`/posts/${post.id}`)
+    await csrf.put(`/posts/${post.id}`, payload('Third')).assertRedirect(`/posts/${post.id}`)
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+
+    const res = await csrf.get(`/posts/${post.id}/revisions`)
+    res.assertOk()
+    const html = await res.text()
+    expect(html).toContain('posts/Revisions')
+
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+    await csrf
+      .post(`/posts/${post.id}/revisions/${first.id}/restore`)
+      .assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing when an edit is invalid', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'First')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.json().put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('refuses other users and redirects guests', async () => {
+    const author = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author, 'First')
+    const revision = await PostRevision.create({ postId: post.id, ...payload('Zero') })
+
+    const otherCsrf = await http.actingAs(other).withCsrf()
+    await otherCsrf.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await otherCsrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+    await otherCsrf.put(`/posts/${post.id}`, payload('Hijack')).assertForbidden()
+
+    const guestCsrf = await http.withCsrf()
+    await guestCsrf.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await guestCsrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect(await revisionTitles(post.id)).toEqual(['Zero'])
+  })
+
+  it('answers 404 for a revision of another post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'Mine')
+    const otherPost = await makePost(author, 'Also mine')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${otherPost.id}`, payload('Edited')).assertRedirect()
+    const foreign = await PostRevision.where({ postId: otherPost.id }).firstOrFail()
+
+    await csrf.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+    expect((await Post.findOrFail(post.id)).title).toBe('Mine')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post together with its history only', async () => {
+    const author = await makeUser()
+    const post = await makePost(author, 'Doomed')
+    const kept = await makePost(author, 'Kept')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, payload('Doomed 2')).assertRedirect()
+    await csrf.put(`/posts/${kept.id}`, payload('Kept 2')).assertRedirect()
+
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(kept.id)).toEqual(['Kept'])
+  })
+})
