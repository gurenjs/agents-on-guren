diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..e9a33df
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,77 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass' })
+  })
+
+  async function createToken(name = 'CI'): Promise<{ id: string; token: string }> {
+    const session = await http.actingAs(user).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json()
+  }
+
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('validates the token name', async () => {
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().post('/profile/tokens', {}).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+  })
+
+  it('authenticates as the owner and ignores a body authorId', async () => {
+    const { token } = await createToken()
+    const res = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    res.assertCreated()
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(Number(user.id))
+    await bearer(token).get('/api/posts').assertOk().assertJsonCount(1, 'data')
+  })
+
+  it('rejects unknown tokens and invalid input', async () => {
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('nope|nope').get('/api/posts').assertUnauthorized()
+    const { token } = await createToken()
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+  })
+
+  it('revokes one token without affecting others, and hides other users', async () => {
+    const first = await createToken('one')
+    const second = await createToken('two')
+    const other = await User.create({ name: 'Bo', email: 'bo@example.com', password: 'secret-pass' })
+    const otherSession = await http.actingAs(other).withCsrf()
+    await otherSession.json().delete(`/profile/tokens/${first.id}`).assertNotFound()
+    await bearer(first.token).get('/api/posts').assertOk()
+
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('rate limits per token', async () => {
+    const first = await createToken('one')
+    const second = await createToken('two')
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
