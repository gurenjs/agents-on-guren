+import { User } from '../app/Models/User.js'
+
+const tomorrow = () => new Date(Date.now() + 86_400_000).toISOString()
+const hourAgo = () => new Date(Date.now() - 3_600_000).toISOString()
+const payload = { title: 'Later', excerpt: 'An excerpt', body: 'A body' }
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+  let other: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'a@example.com', password: 'secret-pass-1' })
+    other = await User.create({ name: 'Other', email: 'o@example.com', password: 'secret-pass-2' })
+  })
+
+  const makePost = (publishedAt: string | null, title = 'match') =>
+    Post.forceCreate({ title, excerpt: 'x', body: 'x', authorId: Number(author.id), publishedAt })
+
+  it('[AC-scheduled-publish-1] stores a future publishAt and redirects', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { ...payload, publishAt: '2099-01-01T09:00:00.000Z' }).assertStatus(303)
+    const post = await Post.first({ title: 'Later' })
+    expect(post?.publishedAt).toBe('2099-01-01T09:00:00.000Z')
+  })
+
+  it('[AC-scheduled-publish-2] rejects an unparsable publishAt and saves nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/posts', { ...payload, publishAt: 'next tuesday' }).assertUnprocessable()
+    expect(await Post.first({ title: 'Later' })).toBeNull()
+  })
+
+  it('[AC-scheduled-publish-3] sends a guest creating a post to login', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post('/posts', payload).assertRedirect('/login')
+  })
+
+  it('[AC-scheduled-publish-4] hides a scheduled post from a guest', async () => {
+    const post = await makePost(tomorrow())
+    await http.get(`/posts/${post!.id}`).assertNotFound()
+  })
+
+  it('[AC-scheduled-publish-5] hides a scheduled post from another user', async () => {
+    const post = await makePost(tomorrow())
+    await http.actingAs(other).get(`/posts/${post!.id}`).assertNotFound()
+  })
+
+  it('[AC-scheduled-publish-6] shows a scheduled post to its author', async () => {
+    const at = tomorrow()
+    const post = await makePost(at)
+    await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post!.id}`).assertInertia('posts/Show')
+  })
+
+  it('[AC-scheduled-publish-7] lists a scheduled post only for its author', async () => {
+    await makePost(tomorrow(), 'hidden')
+    await makePost(null, 'public')
+    const titles = async (client: TestApp) => {
+      const res = await client.json().get('/posts')
+      const body = await res.json<{ props?: { data: { title: string }[] }; data?: { title: string }[] }>()
+      return (body.props?.data ?? body.data ?? []).map((p) => p.title)
+    }
+    expect(await titles(http)).toEqual(['public'])
+    expect(await titles(http.actingAs(other))).toEqual(['public'])
+    expect((await titles(http.actingAs(author))).sort()).toEqual(['hidden', 'public'])
+  })
+
+  it('[AC-scheduled-publish-8] leaves a scheduled post out of search for a guest', async () => {
+    await makePost(tomorrow(), 'match later')
+    await makePost(null, 'match now')
+    const res = await http.query('/posts/search', { keywords: ['match'] })
+    const body = await res.json<{ data: { title: string }[] }>()
+    expect(body.data.map((p) => p.title)).toEqual(['match now'])
+  })
+
+  it('[AC-scheduled-publish-9] shows a post whose time has passed to a guest', async () => {
+    const post = await makePost(hourAgo())
+    await http.withHeader('X-Inertia', 'true').get(`/posts/${post!.id}`).assertInertia('posts/Show')
+  })
+
+  it('[AC-scheduled-publish-10] reschedules from the edit form', async () => {
+    const post = await makePost(null)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post!.id}`, { ...payload, publishAt: '2099-01-01T09:00:00.000Z' }).assertRedirect(`/posts/${post!.id}`)
+    expect((await Post.find(post!.id))?.publishedAt).toBe('2099-01-01T09:00:00.000Z')
+  })
+
+  it('[AC-scheduled-publish-11] rejects an unparsable publishAt on update', async () => {
+    const post = await makePost(null)
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().put(`/posts/${post!.id}`, { ...payload, publishAt: 'next tuesday' }).assertUnprocessable()
+  })
+
+  it('[AC-scheduled-publish-12] opens the create form', async () => {
+    await http.actingAs(author).withHeader('X-Inertia', 'true').get('/posts/create').assertInertia('posts/New')
+  })
+
+  it('[AC-scheduled-publish-13] opens the edit form of a scheduled post', async () => {
+    const post = await makePost(tomorrow())
+    await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post!.id}/edit`).assertInertia('posts/Edit')
+  })
+})
