+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { slugify } from '../app/Support/slug.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+import app from '../src/app.js'
+
+// Every fixture title slugifies to something under this prefix, so the suite
+// can clear its own rows out of the test database before and after a run —
+// the file is reused between runs, and slugs are unique.
+const FIXTURE_TITLE = 'Slug Fixture'
+const FIXTURE_SLUG = 'slug-fixture'
+
+async function clearFixtures(): Promise<void> {
+  const rows = await Post.newQuery().where('slug', 'like', `${FIXTURE_SLUG}%`).get()
+  for (const row of rows) {
+    await Post.delete({ id: row.id })
+  }
+}
+
+describe('post slugs', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    // Boots the real app, which configures the ORM the fixtures below use.
+    http = await TestApp.fromApp(app)
+    author = await User.findOrFail(DEMO_EMAIL, 'email')
+    await clearFixtures()
+  })
+
+  afterAll(async () => {
+    await clearFixtures()
+  })
+
+  async function createPost(title: string): Promise<PostRecord> {
+    return Post.forceCreate({
+      title,
+      slug: await Post.uniqueSlug(title),
+      excerpt: 'An excerpt.',
+      body: 'A body.',
+      authorId: author.id,
+    })
+  }
+
+  it('slugifies a title down to lowercase words joined by a dash', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world')
+    expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+  })
+
+  it('numbers a slug that is already taken', async () => {
+    const first = await createPost(FIXTURE_TITLE)
+    const second = await createPost(FIXTURE_TITLE)
+    const third = await createPost(FIXTURE_TITLE)
+
+    expect(first.slug).toBe(FIXTURE_SLUG)
+    expect(second.slug).toBe(`${FIXTURE_SLUG}-2`)
+    expect(third.slug).toBe(`${FIXTURE_SLUG}-3`)
+  })
+
+  it('serves the post page at its slug', async () => {
+    const post = await createPost(`${FIXTURE_TITLE} Served`)
+
+    await http.get(`/posts/${post.slug}`).assertOk()
+  })
+
+  // The pages build their links with route('posts.show', { slug }), so what
+  // they need from the server is the slug itself — assert it reaches both of
+  // the pages that list posts. (Only the Inertia page payload is asserted on:
+  // the SSR bundle is not built during tests, so no markup is rendered here.)
+  it('sends the slug to the post list and the home page', async () => {
+    const post = await createPost(`${FIXTURE_TITLE} Linked`)
+
+    for (const path of ['/posts', '/']) {
+      const response = await http.get(path).assertOk()
+      expect(await response.text()).toContain(post.slug)
+    }
+  })
+
+  it('404s an unknown slug', async () => {
+    await http.get(`/posts/${FIXTURE_SLUG}-nobody-published-this`).assertStatus(404)
+  })
+
+  it('permanently redirects the old numeric address to the slug', async () => {
+    const post = await createPost(`${FIXTURE_TITLE} Redirected`)
+
+    const response = await http.get(`/posts/${post.id}`).assertStatus(301)
+    expect(response.headers.get('location')).toBe(`/posts/${post.slug}`)
+  })
+
+  it('404s an unknown id', async () => {
+    await http.get('/posts/99999999').assertStatus(404)
+  })
+
+  // '/posts/:id' is read first, so a post whose title is only digits would
+  // otherwise be unreachable at the address it was published under.
+  it('serves an all-digit slug that matches no id', async () => {
+    const post = await createPost('20260818')
+    try {
+      expect(post.slug).toBe('20260818')
+      await http.get(`/posts/${post.slug}`).assertOk()
+    } finally {
+      await Post.delete({ id: post.id })
+    }
+  })
+
+  it('sends the author to the slug of the post just written', async () => {
+    const authed = await http.actingAs(author).withCsrf('/posts/create')
+    const payload = { title: `${FIXTURE_TITLE} Written`, excerpt: 'An excerpt.', body: 'A body.' }
+
+    await authed.post('/posts', payload).assertRedirect(`/posts/${FIXTURE_SLUG}-written`)
+    // A second post under the same title takes the next free number.
+    await authed.post('/posts', payload).assertRedirect(`/posts/${FIXTURE_SLUG}-written-2`)
+  })
+
+  it('sends the author back to the original slug after an update', async () => {
+    const post = await createPost(`${FIXTURE_TITLE} Updated`)
+    const authed = await http.actingAs(author).withCsrf('/posts/create')
+
+    await authed
+      .put(`/posts/${post.id}`, {
+        title: `${FIXTURE_TITLE} Updated Under A New Title`,
+        excerpt: 'An excerpt.',
+        body: 'A body.',
+      })
+      .assertRedirect(`/posts/${post.slug}`)
+  })
+
+  it('keeps the slug when the title changes', async () => {
+    const post = await createPost(`${FIXTURE_TITLE} Renamed`)
+
+    await Post.update({ id: post.id }, { title: `${FIXTURE_TITLE} Renamed Again` })
+
+    const renamed = await Post.findOrFail(post.id)
+    expect(renamed.slug).toBe(post.slug)
+    // The slug the new title would have produced stays free for someone else.
+    expect(await Post.uniqueSlug(`${FIXTURE_TITLE} Renamed Again`)).toBe(`${FIXTURE_SLUG}-renamed-again`)
+  })
+})
