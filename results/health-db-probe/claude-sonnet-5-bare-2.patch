diff --git a/tests/Health.test.ts b/tests/Health.test.ts
new file mode 100644
index 0000000..95a0e38
--- /dev/null
+++ b/tests/Health.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'bun:test'
+import { checkDatabaseHealth } from '../app/Http/Health.js'
+
+describe('checkDatabaseHealth', () => {
+  it('reports ok when the round trip succeeds', async () => {
+    const result = await checkDatabaseHealth(async () => ({ get: async () => ({ 1: 1 }) }))
+
+    expect(result.status).toBe('ok')
+    expect(result.message).toBeUndefined()
+  })
+
+  it('reports error when the query throws', async () => {
+    const result = await checkDatabaseHealth(async () => ({
+      get: async () => {
+        throw new Error('connection refused')
+      },
+    }))
+
+    expect(result.status).toBe('error')
+    expect(result.message).toContain('connection refused')
+  })
+
+  it('reports error when the connection cannot be opened', async () => {
+    const result = await checkDatabaseHealth(async () => {
+      throw new Error('ECONNREFUSED')
+    })
+
+    expect(result.status).toBe('error')
+  })
+
+  it('reports error when the query hangs past the timeout', async () => {
+    const result = await checkDatabaseHealth(
+      async () => ({ get: () => new Promise<unknown>(() => {}) }),
+      20,
+    )
+
+    expect(result.status).toBe('error')
+    expect(result.message).toContain('timed out')
+  })
+})
