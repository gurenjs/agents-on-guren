diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..b30ed94
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,135 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let reader: UserRecord
+  let stranger: UserRecord
+  let postId: number
+
+  const as = async (user: UserRecord) => (await http.actingAs(user).withCsrf()).json()
+  const guest = async () => (await http.withCsrf()).json()
+
+  const pageComments = async (): Promise<Array<Record<string, any>>> => {
+    const res = await http.actingAs(owner).withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+    return ((await res.json()) as any).props.comments
+  }
+
+  const addComment = async (user: UserRecord, body = 'Nice post') => {
+    await (await as(user)).post(`/posts/${postId}/comments`, { body }).assertRedirect(`/posts/${postId}`)
+    const rows = await Comment.where({ postId }).orderBy('id', 'desc').get()
+    return rows[0]!
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = (await User.create({ name: 'Owner', email: 'o@x.test', password: 'password123' })) as UserRecord
+    reader = (await User.create({ name: 'Reader', email: 'r@x.test', password: 'password123' })) as UserRecord
+    stranger = (await User.create({ name: 'Stranger', email: 's@x.test', password: 'password123' })) as UserRecord
+    const post = await Post.forceCreate({ title: 'T', excerpt: 'E', body: 'B', authorId: owner.id })
+    postId = post!.id
+  })
+
+  it('[AC-comments-1] a signed-in user can comment on someone else\'s post', async () => {
+    const comment = await addComment(reader)
+    expect(comment.userId).toBe(reader.id)
+    expect((await pageComments())[0]!.author).toEqual({ id: reader.id, name: 'Reader' })
+  })
+
+  it('[AC-comments-2] an empty comment is rejected', async () => {
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: '' }).assertUnprocessable()
+    expect(await Comment.where({ postId }).count()).toBe(0)
+  })
+
+  it('[AC-comments-3] a comment longer than 2000 characters is rejected', async () => {
+    await (await as(reader)).post(`/posts/${postId}/comments`, { body: 'a'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.where({ postId }).count()).toBe(0)
+  })
+
+  it('[AC-comments-4] a guest who tries to comment is sent to login', async () => {
+    await (await guest()).post(`/posts/${postId}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.where({ postId }).count()).toBe(0)
+  })
+
+  it('[AC-comments-5] the post page lists comments oldest first', async () => {
+    await addComment(reader, 'first')
+    await addComment(stranger, 'second')
+    const listed = await pageComments()
+    expect(listed.map((c) => c.body)).toEqual(['first', 'second'])
+    expect(Object.keys(listed[0]!).sort()).toEqual(['author', 'body', 'createdAt', 'id'])
+    expect(new Date(listed[0]!.createdAt).toISOString()).toBe(listed[0]!.createdAt)
+  })
+
+  it('[AC-comments-6] the author of a comment can delete it', async () => {
+    const comment = await addComment(reader)
+    await (await as(reader)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.find(comment.id)).toBeNull()
+  })
+
+  it('[AC-comments-7] the author of the post can delete a comment on it', async () => {
+    const comment = await addComment(reader)
+    await (await as(owner)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${postId}`)
+    expect(await Comment.find(comment.id)).toBeNull()
+  })
+
+  it('[AC-comments-8] someone else cannot delete a comment', async () => {
+    const comment = await addComment(reader)
+    await (await as(stranger)).delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('[AC-comments-9] a guest cannot delete a comment', async () => {
+    const comment = await addComment(reader)
+    await (await guest()).delete(`/comments/${comment.id}`).assertRedirect('/login')
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('[AC-comments-10] deleting a post removes its comments', async () => {
+    const comment = await addComment(reader)
+    await (await as(owner)).delete(`/posts/${postId}`).assertRedirect('/posts')
+    expect(await Comment.find(comment.id)).toBeNull()
+  })
+
+  it('[AC-reports-1] a signed-in user can report a comment', async () => {
+    const comment = await addComment(reader)
+    await (await as(stranger)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+  })
+
+  it('[AC-reports-2] reporting twice keeps one report and answers 204 both times', async () => {
+    const comment = await addComment(reader)
+    const client = await as(stranger)
+    await client.post(`/comments/${comment.id}/report`).assertNoContent()
+    await client.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(1)
+  })
+
+  it('[AC-reports-3] a guest cannot report a comment', async () => {
+    const comment = await addComment(reader)
+    await (await guest()).post(`/comments/${comment.id}/report`).assertRedirect('/login')
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(0)
+  })
+
+  it('[AC-reports-4] three different reporters hide a comment but keep it stored', async () => {
+    const comment = await addComment(reader)
+    const fourth = (await User.create({ name: 'Four', email: 'f@x.test', password: 'password123' })) as UserRecord
+    for (const user of [owner, stranger]) {
+      await (await as(user)).post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+    expect(await pageComments()).toHaveLength(1)
+    await (await as(fourth)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await pageComments()).toHaveLength(0)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+})
