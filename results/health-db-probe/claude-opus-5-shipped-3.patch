diff --git a/app/Http/Controllers/HealthController.ts b/app/Http/Controllers/HealthController.ts
new file mode 100644
index 0000000..a395156
--- /dev/null
+++ b/app/Http/Controllers/HealthController.ts
@@ -0,0 +1,69 @@
+import { Controller, DatabaseCheck, createHealthManager, type DatabaseConnection } from '@guren/core'
+import { getDatabase } from '../../../config/database.js'
+
+/**
+ * The probe answers within this budget even when the database has stopped
+ * responding: a hung connection is a failed dependency, not a slow page, and
+ * the load balancer needs the 503 while the request would still be pending.
+ */
+const DATABASE_TIMEOUT_MS = 2000
+
+/**
+ * Drizzle spells raw SQL differently per driver — `all()` on SQLite, `execute()`
+ * on Postgres/MySQL — so the adapter takes whichever the configured handle has
+ * rather than pinning the probe to today's database.
+ */
+type RawQueryRunner = Partial<Record<'all' | 'execute' | 'run', (query: string) => unknown>>
+
+/**
+ * `DatabaseCheck` speaks a minimal `query(sql)` connection; the ORM hands out a
+ * Drizzle handle instead. Resolving it per call is deliberate — opening the
+ * connection is part of what the probe verifies, so a database that cannot be
+ * opened at all fails the check rather than throwing before it runs.
+ */
+const connection: DatabaseConnection = {
+  async query(statement: string): Promise<unknown> {
+    const db = (await getDatabase()) as RawQueryRunner
+    const run = db.all ?? db.execute ?? db.run
+
+    if (typeof run !== 'function') {
+      throw new Error('The configured database handle cannot run raw SQL.')
+    }
+
+    return await run.call(db, statement)
+  },
+}
+
+/**
+ * Registered once, but every `check()` runs the query again — the deploy that
+ * loses its database mid-life has to start failing the probe, so nothing here
+ * may cache a previous result.
+ */
+const health = createHealthManager().register(new DatabaseCheck(connection, { name: 'db' }), {
+  // Without this the manager downgrades a failed check to "degraded", which
+  // still answers 200 and would keep a broken deploy in the pool.
+  critical: true,
+  timeout: DATABASE_TIMEOUT_MS,
+})
+
+export default class HealthController extends Controller {
+  async index(): Promise<Response> {
+    const report = await health.check()
+
+    return this.json(
+      {
+        status: report.status,
+        timestamp: report.timestamp.toISOString(),
+        checks: report.checks.map((check) => ({
+          name: check.name,
+          status: check.status,
+          message: check.message,
+          duration: check.duration,
+        })),
+      },
+      // 503 rather than 500: the app is up and answering, the dependency is
+      // not — the platform drains traffic on any non-2xx here.
+      { status: report.status === 'healthy' ? 200 : 503 },
+    )
+  }
+}
