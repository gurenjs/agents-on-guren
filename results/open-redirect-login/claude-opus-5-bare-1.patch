@@ -0,0 +1,69 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { DEFAULT_LOGIN_REDIRECT, sameAppPath } from '../app/Support/redirects.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+
+// The `redirect` value arrives from a link an attacker can mail out, so the
+// only values worth following are paths inside this app.
+describe('sameAppPath', () => {
+  it('keeps a path inside the app', () => {
+    expect(sameAppPath('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(sameAppPath('/')).toBe('/')
+    expect(sameAppPath('/posts?page=2#top')).toBe('/posts?page=2#top')
+  })
+
+  it('rejects anything that could leave the origin', () => {
+    for (const value of [
+      'https://evil.example',
+      'http://evil.example',
+      'javascript:alert(1)',
+      '//evil.example',
+      '/\\evil.example',
+      '\\\\evil.example',
+      '/\t/evil.example',
+      '/\n/evil.example',
+      ' //evil.example',
+      'evil.example',
+      '',
+      undefined,
+      null,
+    ]) {
+      expect(sameAppPath(value)).toBeNull()
+    }
+  })
+})
+
+describe('login.store', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    // Priming CSRF from the login page mirrors how a browser reaches this
+    // route: the sign-in form carries the token /login handed out.
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  const credentials = { email: DEMO_EMAIL, password: 'secret' }
+
+  it('returns the user to the page they came from', async () => {
+    await http
+      .post('/login', { ...credentials, redirect: '/posts/3/edit' })
+      .assertRedirect('/posts/3/edit')
+  })
+
+  it('falls back to the default destination without a redirect', async () => {
+    await http.post('/login', credentials).assertRedirect(DEFAULT_LOGIN_REDIRECT)
+  })
+
+  it('ignores a redirect pointing at another site', async () => {
+    for (const redirect of ['https://evil.example', '//evil.example', '/\\evil.example']) {
+      await http.post('/login', { ...credentials, redirect }).assertRedirect(DEFAULT_LOGIN_REDIRECT)
+    }
+  })
+
+  it('still rejects a wrong password, redirect or not', async () => {
+    await http
+      .post('/login', { email: DEMO_EMAIL, password: 'wrong', redirect: '/posts/3/edit' })
+      .assertStatus(422)
+  })
+})
