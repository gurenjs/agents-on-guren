diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..e39bfe6
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,30 @@
+const EXCERPT_LENGTH = 140
+const ELLIPSIS = '…'
+
+function lastWhitespaceIndex(text: string): number {
+  for (let i = text.length - 1; i >= 0; i--) {
+    if (/\s/.test(text[i])) return i
+  }
+  return -1
+}
+
+// Derives a post excerpt from its body when the author leaves the excerpt
+// field blank. Never cuts a word in half: if the 140-character window ends
+// mid-word, it backs up to the last whitespace before the cut.
+export function deriveExcerpt(rawBody: string): string {
+  const body = rawBody.trim()
+  if (body.length <= EXCERPT_LENGTH) return body
+
+  const window = body.slice(0, EXCERPT_LENGTH)
+  const lastWindowChar = window[EXCERPT_LENGTH - 1]
+  const nextChar = body[EXCERPT_LENGTH]
+  const cutsMidWord = !/\s/.test(lastWindowChar) && !/\s/.test(nextChar)
+
+  let kept = window
+  if (cutsMidWord) {
+    const wsIndex = lastWhitespaceIndex(window)
+    if (wsIndex !== -1) kept = window.slice(0, wsIndex)
+  }
+
+  return kept.replace(/\s+$/, '') + ELLIPSIS
+}
