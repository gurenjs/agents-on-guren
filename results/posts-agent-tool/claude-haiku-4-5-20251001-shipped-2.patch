@@ -0,0 +1,64 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { createApiToken, MemoryApiTokenStore } from '@guren/core'
+import app from '../src/app.js'
+
+describe('MCP endpoint', () => {
+  let http: TestApp
+  let bearerToken: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    // Create a test API token
+    const tokenStore = app.container.make('api-token-store') as MemoryApiTokenStore
+    const result = await createApiToken(tokenStore, {
+      name: 'test-mcp-token',
+      userId: 1,
+      abilities: ['*'],
+    })
+    bearerToken = result.plainTextToken
+  })
+
+  it('lists available tools with valid bearer token', async () => {
+    const response = await http.withHeader('Authorization', `Bearer ${bearerToken}`)
+      .json()
+      .post('/mcp', {
+        jsonrpc: '2.0',
+        id: 1,
+        method: 'tools/list',
+      })
+
+    const data = (await response.json()) as any
+    expect(data.result.tools).toHaveLength(2)
+
+    const toolNames = data.result.tools.map((t: any) => t.name)
+    expect(toolNames).toContain('posts_search')
+    expect(toolNames).toContain('posts_store')
+
+    // Check annotations
+    const searchTool = data.result.tools.find((t: any) => t.name === 'posts_search')
+    expect(searchTool.annotations.readOnly).toBe(true)
+
+    const storeTool = data.result.tools.find((t: any) => t.name === 'posts_store')
+    expect(storeTool.annotations.readOnly).toBe(false)
+  })
+
+  it('returns error for unknown tool', async () => {
+    const response = await http.withHeader('Authorization', `Bearer ${bearerToken}`)
+      .json()
+      .post('/mcp', {
+        jsonrpc: '2.0',
+        id: 1,
+        method: 'tools/call',
+        params: {
+          name: 'unknown_tool',
+          arguments: {},
+        },
+      })
+
+    const data = (await response.json()) as any
+    expect(data.error).toBeDefined()
+    expect(data.error.code).toBe(-32602)
+  })
+})
