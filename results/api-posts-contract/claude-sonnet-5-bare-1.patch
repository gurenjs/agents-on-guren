diff --git a/tests/ApiPosts.test.ts b/tests/ApiPosts.test.ts
new file mode 100644
index 0000000..0131d4a
--- /dev/null
+++ b/tests/ApiPosts.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+interface ApiPost {
+  id: number
+  title: string
+  excerpt: string
+  createdAt: string
+  author: { id: number; name: string }
+}
+
+interface ApiPostsResponse {
+  data: ApiPost[]
+  meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+}
+
+// api.posts.index is a public, unauthenticated JSON feed for partner
+// integrations — no session, no CSRF token. `query:` on the route declares
+// its contract (page/author), but validateQuery() in the controller is what
+// actually rejects bad input, so these 422 cases exercise the real handler.
+describe('api.posts.index', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects an invalid page', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+    await http.get('/api/posts?page=abc').assertStatus(422)
+  })
+
+  it('rejects an invalid author', async () => {
+    await http.get('/api/posts?author=abc').assertStatus(422)
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+
+  it('lists posts newest first with pagination meta', async () => {
+    const response = await http.get('/api/posts').assertOk()
+    const body = await response.json<ApiPostsResponse>()
+
+    expect(body.meta).toMatchObject({ currentPage: 1, perPage: 10 })
+    expect(body.data.length).toBeGreaterThan(0)
+    expect(body.data.length).toBeLessThanOrEqual(10)
+
+    const ids = body.data.map((post) => post.id)
+    expect(ids).toEqual([...ids].sort((a, b) => b - a))
+  })
+
+  it('combines page and author filters, and returns an empty page for an author with no posts', async () => {
+    const all = await (await http.get('/api/posts').assertOk()).json<ApiPostsResponse>()
+    const authorId = all.data[0]?.author.id
+    expect(authorId).toBeDefined()
+
+    const filtered = await (await http.get(`/api/posts?author=${authorId}&page=1`).assertOk()).json<ApiPostsResponse>()
+    expect(filtered.meta.total).toBeGreaterThan(0)
+    expect(filtered.data.every((post) => post.author.id === authorId)).toBe(true)
+
+    const empty = await (await http.get('/api/posts?author=999999').assertOk()).json<ApiPostsResponse>()
+    expect(empty.data).toEqual([])
+    expect(empty.meta.total).toBe(0)
+  })
+})
