diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..be8cd37
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,125 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import type { SQLiteBunDatabase } from 'drizzle-orm/bun-sqlite'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { posts, postTags, tags, users } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+interface InertiaPage<TProps> {
+  component: string
+  props: TProps
+}
+
+// The SQLite config types its connection as `unknown`; this suite knows it is bun:sqlite.
+async function db(): Promise<SQLiteBunDatabase> {
+  return (await getDatabase()) as SQLiteBunDatabase
+}
+
+const INERTIA_HEADERS = { 'X-Inertia': 'true', Accept: 'text/html, application/json' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  beforeEach(async () => {
+    const conn = await db()
+    await conn.delete(postTags)
+    await conn.delete(tags)
+    await conn.delete(posts)
+    await conn.delete(users)
+    author = (await User.create({
+      name: 'Tag Author',
+      email: `tags-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })) as UserRecord
+  })
+
+  async function page<TProps>(path: string): Promise<InertiaPage<TProps>> {
+    const response = await http.withHeaders(INERTIA_HEADERS).get(path).assertOk()
+    return response.json<InertiaPage<TProps>>()
+  }
+
+  async function createPost(title: string, tagInput?: string): Promise<number> {
+    const response = await http
+      .actingAs(author)
+      .post('/posts', { title, excerpt: 'An excerpt', body: 'A body', tags: tagInput })
+      .assertRedirect()
+    const location = response.headers.get('location') ?? ''
+    return Number(location.split('/').pop())
+  }
+
+  async function tagNames(): Promise<string[]> {
+    const rows = await (await db()).select().from(tags)
+    return rows.map((row) => row.name).sort()
+  }
+
+  it('attaches tags on create and syncs them on update', async () => {
+    const id = await createPost('Tagged', 'webdev, bun')
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await (await db()).select().from(postTags)).toHaveLength(2)
+
+    const shown = await page<{ post: PostResourceData }>(`/posts/${id}`)
+    expect(shown.props.post.tags).toEqual(['bun', 'webdev'])
+
+    await http
+      .actingAs(author)
+      .put(`/posts/${id}`, { title: 'Tagged', excerpt: 'An excerpt', body: 'A body', tags: 'bun' })
+      .assertRedirect()
+    const updated = await page<{ post: PostResourceData }>(`/posts/${id}`)
+    expect(updated.props.post.tags).toEqual(['bun'])
+    expect(await (await db()).select().from(postTags)).toHaveLength(1)
+  })
+
+  it('filters the list by tag and keeps the filter in page links', async () => {
+    const tagged = await createPost('With bun', 'bun')
+    await createPost('Without tags')
+
+    const all = await page<{ data: PostResourceData[] }>('/posts')
+    expect(all.props.data.map((post) => post.tags)).toEqual([[], ['bun']])
+
+    const filtered = await page<{ data: PostResourceData[]; pagination: { links: { pages: { url: string | null }[] } } }>(
+      '/posts?tag=bun',
+    )
+    expect(filtered.props.data.map((post) => post.id)).toEqual([tagged])
+    expect(filtered.props.pagination.links.pages[0]?.url).toContain('tag=bun')
+
+    const none = await page<{ data: PostResourceData[] }>('/posts?tag=nobody')
+    expect(none.props.data).toEqual([])
+  })
+
+  it('collapses duplicate names after trimming', async () => {
+    await createPost('Dupes', ' bun ,bun,,')
+    expect(await tagNames()).toEqual(['bun'])
+    expect(await (await db()).select().from(postTags)).toHaveLength(1)
+  })
+
+  it('refuses too many or too long tags the way an empty title is refused', async () => {
+    const payload = { title: 'T', excerpt: 'E', body: 'B' }
+    const emptyTitle = await http.actingAs(author).post('/posts', { ...payload, title: '' })
+    const tooMany = await http.actingAs(author).post('/posts', { ...payload, tags: 'a,b,c,d,e,f' })
+    const tooLong = await http.actingAs(author).post('/posts', { ...payload, tags: 'x'.repeat(31) })
+
+    expect(tooMany.status).toBe(emptyTitle.status)
+    expect(tooLong.status).toBe(emptyTitle.status)
+    expect(await (await db()).select().from(posts)).toHaveLength(0)
+    expect(await tagNames()).toEqual([])
+
+    await createPost('Long tag', 'x'.repeat(30))
+    expect(await tagNames()).toEqual(['x'.repeat(30)])
+  })
+
+  it('deletes a tagged post', async () => {
+    const id = await createPost('Doomed', 'bun')
+    await http.actingAs(author).delete(`/posts/${id}`).assertRedirect()
+    const conn = await db()
+    expect(await conn.select().from(posts)).toHaveLength(0)
+    expect(await conn.select().from(postTags)).toHaveLength(0)
+  })
+})
