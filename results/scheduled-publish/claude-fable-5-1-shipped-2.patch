diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..6b819f7
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,296 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2099-10-01T09:00:00.000Z'
+const LATER = '2099-12-24T18:30:00.000Z'
+const PAST = '2020-01-01T00:00:00.000Z'
+
+interface PostProps {
+  id: number
+  title: string
+  publishedAt: string | null
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-password' })
+  })
+
+  async function createPost(title: string, publishedAt: string | null, owner = author): Promise<PostRecord> {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId: owner.id, publishedAt })
+  }
+
+  // X-Inertia makes the page routes answer with the page object as JSON.
+  function page(client: TestApp): TestApp {
+    return client.withHeader('X-Inertia', 'true')
+  }
+
+  async function listed(client: TestApp): Promise<PostProps[]> {
+    const response = await page(client).get('/posts').assertOk()
+    return (await response.json<{ props: { data: PostProps[] } }>()).props.data
+  }
+
+  async function found(client: TestApp, keyword: string): Promise<PostProps[]> {
+    const response = await client.query('/posts/search', { keywords: [keyword] }).assertOk()
+    return (await response.json<{ data: PostProps[] }>()).data
+  }
+
+  function payload(overrides: Record<string, unknown> = {}) {
+    return { title: 'Launch', excerpt: 'Launch excerpt', body: 'Launch body', ...overrides }
+  }
+
+  describe('GET /posts/:id', () => {
+    it('answers 404 for guests and other users while the post is scheduled', async () => {
+      const post = await createPost('Launch', FUTURE)
+
+      await page(http).get(`/posts/${post.id}`).assertNotFound()
+      await page(http.actingAs(other)).get(`/posts/${post.id}`).assertNotFound()
+    })
+
+    it('opens for the author, with the date it goes live', async () => {
+      const post = await createPost('Launch', FUTURE)
+
+      const response = await page(http.actingAs(author)).get(`/posts/${post.id}`).assertOk()
+      const { props } = await response.json<{ props: { post: PostProps } }>()
+
+      expect(props.post.publishedAt).toBe(FUTURE)
+    })
+
+    it('opens for everyone once the time has passed', async () => {
+      const post = await createPost('Launch', FUTURE)
+      await Post.update({ id: post.id }, { publishedAt: PAST })
+
+      await page(http).get(`/posts/${post.id}`).assertOk()
+      await page(http.actingAs(other)).get(`/posts/${post.id}`).assertOk()
+    })
+
+    it('opens for everyone when the post has no date', async () => {
+      const post = await createPost('Plain', null)
+
+      const response = await page(http).get(`/posts/${post.id}`).assertOk()
+      const { props } = await response.json<{ props: { post: PostProps } }>()
+
+      expect(props.post.publishedAt).toBeNull()
+    })
+  })
+
+  describe('GET /posts', () => {
+    it('lists a scheduled post for its author only', async () => {
+      await createPost('Plain', null)
+      await createPost('Launch', FUTURE)
+
+      expect((await listed(http)).map((post) => post.title)).toEqual(['Plain'])
+      expect((await listed(http.actingAs(other))).map((post) => post.title)).toEqual(['Plain'])
+
+      const own = await listed(http.actingAs(author))
+      expect(own.map((post) => post.title)).toEqual(['Launch', 'Plain'])
+      expect(own[0]?.publishedAt).toBe(FUTURE)
+    })
+
+    it('does not count hidden posts towards the pages', async () => {
+      await createPost('Plain', null)
+      await createPost('Launch', FUTURE)
+
+      const response = await page(http).get('/posts').assertOk()
+      const { props } = await response.json<{ props: { pagination: { meta: { total: number } } } }>()
+
+      expect(props.pagination.meta.total).toBe(1)
+    })
+
+    it('lists the post for everyone once the time has passed', async () => {
+      await createPost('Launch', PAST)
+
+      expect((await listed(http)).map((post) => post.title)).toEqual(['Launch'])
+    })
+  })
+
+  describe('QUERY /posts/search', () => {
+    it('leaves a scheduled post out for guests and other users', async () => {
+      await createPost('Launch plain', null)
+      await createPost('Launch scheduled', FUTURE)
+
+      expect((await found(http, 'Launch')).map((post) => post.title)).toEqual(['Launch plain'])
+      expect((await found(http.actingAs(other), 'Launch')).map((post) => post.title)).toEqual(['Launch plain'])
+    })
+
+    it('finds the post once the time has passed', async () => {
+      await createPost('Launch', PAST)
+
+      expect((await found(http, 'Launch')).map((post) => post.title)).toEqual(['Launch'])
+    })
+  })
+
+  describe('GET /', () => {
+    it('keeps a scheduled post off the home page, its author included', async () => {
+      await createPost('Plain', null)
+      await createPost('Launch', FUTURE)
+
+      const response = await page(http.actingAs(author)).get('/').assertOk()
+      const { props } = await response.json<{ props: { latest: PostProps[] } }>()
+
+      expect(props.latest.map((post) => post.title)).toEqual(['Plain'])
+    })
+  })
+
+  describe('POST /posts', () => {
+    it('stores the publish date', async () => {
+      const client = await http.actingAs(author).withCsrf()
+
+      await client.post('/posts', payload({ publishAt: FUTURE })).assertRedirect()
+
+      expect((await Post.first({ title: 'Launch' }))?.publishedAt).toBe(FUTURE)
+    })
+
+    it('stores an offset as the same instant in UTC', async () => {
+      const client = await http.actingAs(author).withCsrf()
+
+      await client.post('/posts', payload({ publishAt: '2099-10-01T18:00:00+09:00' })).assertRedirect()
+
+      expect((await Post.first({ title: 'Launch' }))?.publishedAt).toBe(FUTURE)
+    })
+
+    it('publishes now when the date is absent or null', async () => {
+      const client = await http.actingAs(author).withCsrf()
+
+      await client.post('/posts', payload({ title: 'Absent' })).assertRedirect()
+      await client.post('/posts', payload({ title: 'Null', publishAt: null })).assertRedirect()
+
+      expect((await Post.first({ title: 'Absent' }))?.publishedAt).toBeNull()
+      expect((await Post.first({ title: 'Null' }))?.publishedAt).toBeNull()
+      expect((await listed(http)).map((post) => post.title)).toEqual(['Null', 'Absent'])
+    })
+
+    it.each(['next tuesday', '2099-10-01', '2099-10-01T09:00', '2099-02-30T09:00:00.000Z', ''])(
+      'rejects %p and saves nothing',
+      async (publishAt) => {
+        const client = await http.actingAs(author).withCsrf()
+
+        const rejected = await client.json().post('/posts', payload({ publishAt })).assertUnprocessable()
+        const { errors } = await rejected.json<{ errors: Record<string, string[]> }>()
+
+        expect(Object.keys(errors)).toEqual(['publishAt'])
+        expect(await Post.newQuery().count()).toBe(0)
+      },
+    )
+
+    it('rejects a bad date the way it rejects an empty title', async () => {
+      const client = (await http.actingAs(author).withCsrf()).json()
+
+      const title = await client.post('/posts', payload({ title: '' }))
+      const date = await client.post('/posts', payload({ publishAt: 'next tuesday' }))
+
+      expect(date.status).toBe(title.status)
+      expect(Object.keys(await date.json<object>())).toEqual(Object.keys(await title.json<object>()))
+    })
+  })
+
+  describe('PUT /posts/:id', () => {
+    it('sets, changes and clears the date', async () => {
+      const post = await createPost('Launch', null)
+      const client = await http.actingAs(author).withCsrf()
+
+      await client.put(`/posts/${post.id}`, payload({ publishAt: FUTURE })).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBe(FUTURE)
+
+      await client.put(`/posts/${post.id}`, payload({ publishAt: LATER })).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBe(LATER)
+
+      await client.put(`/posts/${post.id}`, payload({ publishAt: null })).assertRedirect()
+      expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+    })
+
+    it('publishes now when the date is absent', async () => {
+      const post = await createPost('Launch', FUTURE)
+      const client = await http.actingAs(author).withCsrf()
+
+      await client.put(`/posts/${post.id}`, payload()).assertRedirect()
+
+      expect((await Post.findOrFail(post.id)).publishedAt).toBeNull()
+    })
+
+    it('rejects a value that is not a date and time and keeps the post as it was', async () => {
+      const post = await createPost('Launch', FUTURE)
+      const client = await http.actingAs(author).withCsrf()
+
+      await client
+        .json()
+        .put(`/posts/${post.id}`, payload({ title: 'Changed', publishAt: 'next tuesday' }))
+        .assertUnprocessable()
+
+      const kept = await Post.findOrFail(post.id)
+      expect(kept.title).toBe('Launch')
+      expect(kept.publishedAt).toBe(FUTURE)
+    })
+  })
+
+  describe('someone else\'s post', () => {
+    it('answers 404 to edit, update and delete while it is scheduled', async () => {
+      const post = await createPost('Launch', FUTURE)
+      const client = await http.actingAs(other).withCsrf()
+
+      await page(client).get(`/posts/${post.id}/edit`).assertNotFound()
+      await client.json().put(`/posts/${post.id}`, payload({ title: 'Taken' })).assertNotFound()
+      await client.json().delete(`/posts/${post.id}`).assertNotFound()
+
+      expect((await Post.findOrFail(post.id)).title).toBe('Launch')
+    })
+
+    it('still answers 403 once it is public', async () => {
+      const post = await createPost('Launch', PAST)
+      const client = await http.actingAs(other).withCsrf()
+
+      await client.json().put(`/posts/${post.id}`, payload({ title: 'Taken' })).assertForbidden()
+      await client.json().delete(`/posts/${post.id}`).assertForbidden()
+
+      expect((await Post.findOrFail(post.id)).title).toBe('Launch')
+    })
+  })
+
+  describe('posts:scheduled', () => {
+    async function report(): Promise<{ stdout: string; exitCode: number }> {
+      const child = Bun.spawn(['bun', 'run', 'console', 'posts:scheduled'], {
+        cwd: new URL('..', import.meta.url).pathname,
+        stdout: 'pipe',
+        stderr: 'ignore',
+      })
+      const stdout = await new Response(child.stdout).text()
+      return { stdout, exitCode: await child.exited }
+    }
+
+    it('prints the scheduled posts, soonest first, and nothing else', async () => {
+      await createPost('Plain', null)
+      const later = await createPost('Later', LATER)
+      await createPost('Live', PAST)
+      const sooner = await createPost('Sooner', FUTURE, other)
+
+      const { stdout, exitCode } = await report()
+
+      expect(stdout).toBe(`${sooner.id}\tSooner\t${FUTURE}\n${later.id}\tLater\t${LATER}\n`)
+      expect(exitCode).toBe(0)
+    })
+
+    it('prints nothing when nothing is scheduled', async () => {
+      await createPost('Plain', null)
+      await createPost('Live', PAST)
+
+      const { stdout, exitCode } = await report()
+
+      expect(stdout).toBe('')
+      expect(exitCode).toBe(0)
+    })
+  })
+})
