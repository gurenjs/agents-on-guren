@@ -0,0 +1,79 @@
+import { Head, Link, useForm } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: PostResourceData
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`${post.title} - Revisions`} />
+      <section className="space-y-6">
+        <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+          <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+          Post revisions
+        </h1>
+
+        <div className="space-y-4">
+          {revisions.length === 0 ? (
+            <p className="text-g-text-2">No revisions available.</p>
+          ) : (
+            <ul className="space-y-2">
+              {revisions.map((revision) => (
+                <li key={revision.id} className="flex items-center justify-between border-b border-g-line py-3">
+                  <div>
+                    <p className="font-bold text-g-heading">{revision.title}</p>
+                    <p className="text-sm text-g-muted">{new Date(revision.createdAt).toLocaleString()}</p>
+                  </div>
+                  <RestoreButton postId={post.id} revisionId={revision.id} />
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+
+        <div className="flex gap-4">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+          <Link href={route('posts.edit', { id: post.id })} className="text-g-accent-text transition hover:underline">
+            Edit current
+          </Link>
+        </div>
+      </section>
+    </Layout>
+  )
+}
+
+function RestoreButton({ postId, revisionId }: { postId: number; revisionId: number }) {
+  const form = useForm({})
+
+  return (
+    <form
+      onSubmit={(event) => {
+        event.preventDefault()
+        if (window.confirm('Restore this revision? The current version will be saved first.')) {
+          form.post(route('posts.revisions.restore', { id: postId, revisionId }))
+        }
+      }}
+    >
+      <button
+        type="submit"
+        disabled={form.processing}
