diff --git a/app/Services/AttachmentService.ts b/app/Services/AttachmentService.ts
new file mode 100644
index 0000000..7ed24c7
--- /dev/null
+++ b/app/Services/AttachmentService.ts
@@ -0,0 +1,72 @@
+import { promises as fs } from 'fs'
+import path from 'path'
+import { fileURLToPath } from 'url'
+import { Attachment } from '../Models/Attachment.js'
+import type { NewAttachmentRecord } from '../Models/Attachment.js'
+
+const currentDir = path.dirname(fileURLToPath(import.meta.url))
+const STORAGE_DIR = path.join(currentDir, '../../storage')
+
+const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg']
+const MAX_FILE_SIZE = 2 * 1024 * 1024 // 2 MB
+
+export class AttachmentService {
+  static async validateFile(file: File): Promise<{ valid: boolean; error?: string }> {
+    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
+      return { valid: false, error: 'Only PNG and JPEG images are allowed.' }
+    }
+
+    if (file.size > MAX_FILE_SIZE) {
+      return { valid: false, error: 'File size must not exceed 2 MB.' }
+    }
+
+    return { valid: true }
+  }
+
+  static async createAttachment(file: File): Promise<NewAttachmentRecord> {
+    const buffer = await file.arrayBuffer()
+    const fileName = `${Date.now()}-${file.name}`
+    const filePath = path.join(STORAGE_DIR, fileName)
+
+    // Ensure storage directory exists
+    await fs.mkdir(STORAGE_DIR, { recursive: true })
+
+    // Write file to storage
+    await fs.writeFile(filePath, Buffer.from(buffer))
+
+    return {
+      fileName,
+      mimeType: file.type,
+      size: file.size,
+      filePath,
+    }
+  }
+
+  static async deleteAttachment(attachmentId: number): Promise<void> {
+    const attachment = await Attachment.find(attachmentId)
+    if (!attachment) return
+
+    try {
+      await fs.unlink(attachment.filePath)
+    } catch (error) {
+      // File might already be deleted, that's okay
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
+        throw error
+      }
+    }
+
+    await Attachment.delete({ id: attachmentId })
+  }
+
+  static getAttachmentUrl(attachment: { id: number; mimeType: string }): string {
+    return `/attachments/${attachment.id}`
+  }
+
+  static async serveAttachment(attachmentId: number): Promise<{ buffer: Buffer; mimeType: string } | null> {
+    const attachment = await Attachment.find(attachmentId)
+    if (!attachment) return null
+
+    const buffer = await fs.readFile(attachment.filePath)
+    return { buffer, mimeType: attachment.mimeType }
+  }
+}
