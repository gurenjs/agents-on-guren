+import { ValidationException } from '@guren/core'
 import { z } from 'zod'
 
 export const PostIdParamSchema = z.object({
@@ -23,3 +24,55 @@ export const PostPayloadSchema = z.object({
 })
 
 export type PostPayload = z.infer<typeof PostPayloadSchema>
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+
+// A file input left empty still arrives: as an empty string from Inertia, or
+// as a nameless zero-byte part from a plain browser form. Both mean no cover.
+// The PNG/JPEG check reads the file's bytes, which a route schema (parsed
+// synchronously) cannot await, so it lives in readCoverImage() below.
+const CoverSchema = z.preprocess(
+  (value) => (value === '' || value === null || (value instanceof File && value.size === 0) ? undefined : value),
+  z
+    .file('The cover must be a file.')
+    .max(COVER_MAX_BYTES, 'The cover must be 2 MB or smaller.')
+    .optional(),
+)
+
+// A ticked checkbox posts `1` (or `on`); Inertia's JSON body sends a boolean.
+const CheckboxSchema = z.preprocess(
+  (value) => value === true || value === 'true' || value === '1' || value === 1 || value === 'on',
+  z.boolean(),
+)
+
+export const PostStoreSchema = PostPayloadSchema.extend({
+  cover: CoverSchema,
+})
+
+export const PostUpdateSchema = PostPayloadSchema.extend({
+  cover: CoverSchema,
+  removeCover: CheckboxSchema.optional(),
+})
+
+/** The content type a cover's leading bytes identify, or null for anything but PNG and JPEG. */
+function sniffCoverType(bytes: Uint8Array): 'image/png' | 'image/jpeg' | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (png.every((byte, index) => bytes[index] === byte)) return 'image/png'
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+/**
+ * Checks a schema-validated cover is really a PNG or JPEG — by its bytes, not
+ * the client-declared type — and returns it typed from them. Throws the same
+ * 422 a schema failure does, with the error on `cover`.
+ */
+export async function readCoverImage(file: File): Promise<File> {
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const type = sniffCoverType(bytes)
+  if (!type) {
+    throw ValidationException.withMessages({ cover: 'The cover must be a PNG or JPEG image.' })
+  }
+  const name = file.name || `cover.${type === 'image/png' ? 'png' : 'jpg'}`
+  return new File([bytes], name, { type })
+}
