diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..aa93781
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,81 @@
+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+async function createUser(email: string): Promise<UserRecord> {
+  const user = await User.create({ name: email.split('@')[0]!, email, password: 'password123' })
+  return user as UserRecord
+}
+
+// createdAt is an ISO string with second-or-better resolution; stamping it
+// explicitly keeps "newest first" deterministic regardless of insert speed.
+async function createPost(authorId: number, title: string, createdAt: string) {
+  return Post.forceCreate({ title, excerpt: title, body: title, authorId, createdAt })
+}
+
+// The X-Inertia header makes the page respond with its JSON payload instead
+// of the HTML shell, so the props the component receives can be asserted directly.
+async function inertiaProps<T>(client: TestApp): Promise<T> {
+  const response = await client.withHeader('X-Inertia', 'true').get('/dashboard')
+  response.assertOk()
+  const payload = await response.json<{ component: string; props: T }>()
+  expect(payload.component).toBe('dashboard/Index')
+  return payload.props
+}
+
+describe('dashboard', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('redirects guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('reports the signed-in user post count and their 5 newest posts', async () => {
+    const author = await createUser('author@example.com')
+    const other = await createUser('other@example.com')
+
+    for (let index = 1; index <= 7; index += 1) {
+      await createPost(author.id, `Mine ${index}`, `2026-01-0${index}T00:00:00.000Z`)
+    }
+    await createPost(other.id, 'Theirs', '2026-02-01T00:00:00.000Z')
+
+    const props = await inertiaProps<{
+      postCount: number
+      recentPosts: Array<{ id: number; title: string }>
+    }>(http.actingAs(author))
+
+    expect(props.postCount).toBe(7)
+    expect(props.recentPosts.map((post) => post.title)).toEqual([
+      'Mine 7',
+      'Mine 6',
+      'Mine 5',
+      'Mine 4',
+      'Mine 3',
+    ])
+    expect(props.recentPosts.every((post) => typeof post.id === 'number')).toBe(true)
+  })
+
+  it('shows an empty list for a user without posts', async () => {
+    const author = await createUser('empty@example.com')
+    await createPost((await createUser('busy@example.com')).id, 'Not mine', '2026-03-01T00:00:00.000Z')
+
+    const props = await inertiaProps<{ postCount: number; recentPosts: unknown[] }>(
+      http.actingAs(author),
+    )
+
+    expect(props.postCount).toBe(0)
+    expect(props.recentPosts).toEqual([])
+  })
+})
