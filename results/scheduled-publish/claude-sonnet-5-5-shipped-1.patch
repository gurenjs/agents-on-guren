@@ -0,0 +1,58 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const future = '2999-01-01T09:00:00.000Z'
+
+describe('scheduled posts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeUser(email: string) {
+    return User.create({ name: email, email, password: 'password123' })
+  }
+
+  it('hides a scheduled post from everyone but its author', async () => {
+    const author = await makeUser('a@example.com')
+    const other = await makeUser('b@example.com')
+    const post = await Post.forceCreate({
+      title: 'Later',
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: future,
+    })
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+
+    const guestList = await http.get('/posts')
+    expect(await guestList.text()).not.toContain('Later')
+    const authorList = await http.actingAs(author).get('/posts')
+    expect(await authorList.text()).toContain('Later')
+
+    await Post.update({ id: post.id }, { publishedAt: '2000-01-01T00:00:00.000Z' })
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('rejects an invalid publishAt', async () => {
+    const author = await makeUser('c@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
