diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..4b593ec
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,122 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let other: UserRecord
+
+  const makeUser = async (label: string): Promise<UserRecord> => {
+    const email = `${label}-${crypto.randomUUID()}@example.test`
+    await User.create({ name: label, email, password: 'password123' })
+    const [user] = await User.where({ email })
+    return user as UserRecord
+  }
+
+  const createToken = async (user: UserRecord, name: string): Promise<CreatedToken> => {
+    const session = await http.actingAs(user).json().withCsrf('/profile')
+    const response = await session.post('/profile/tokens', { name })
+    response.assertStatus(201)
+    return response.json<CreatedToken>()
+  }
+
+  const bearer = (token: string) =>
+    http.json().withHeaders({ Authorization: `Bearer ${token}` })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await makeUser('owner')
+    other = await makeUser('other')
+  })
+
+  it('creates a token that is shown once and stored only as a hash', async () => {
+    const created = await createToken(owner, 'CI')
+    expect(created.name).toBe('CI')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const db = (await getDatabase()) as { select(): { from(table: typeof apiTokens): Promise<unknown[]> } }
+    const rows = await db.select().from(apiTokens)
+    expect(rows.length).toBeGreaterThan(0)
+    const dump = JSON.stringify(rows)
+    expect(dump).not.toContain(created.token)
+    expect(dump).not.toContain(secret)
+  })
+
+  it('rejects an invalid token name with 422', async () => {
+    const session = await http.actingAs(owner).json().withCsrf('/profile')
+    ;(await session.post('/profile/tokens', { name: '' })).assertStatus(422)
+    ;(await session.post('/profile/tokens', { name: 'x'.repeat(51) })).assertStatus(422)
+    ;(await session.post('/profile/tokens', {})).assertStatus(422)
+  })
+
+  it('authenticates the posts API as the token owner', async () => {
+    const { token } = await createToken(owner, 'script')
+
+    const created = await bearer(token).post('/api/posts', {
+      title: 'Release notes',
+      excerpt: 'What changed',
+      body: 'Everything.',
+      authorId: other.id,
+    })
+    created.assertStatus(201)
+    const { data } = await created.json<{ data: { id: number; authorId: number; createdAt: string } }>()
+    expect(data.authorId).toBe(owner.id)
+    expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+
+    const listed = await bearer(token).get('/api/posts')
+    listed.assertStatus(200)
+    const list = await listed.json<{ data: Array<{ id: number }> }>()
+    expect(list.data[0]?.id).toBe(data.id)
+
+    ;(await bearer(token).post('/api/posts', { title: '', excerpt: 'x' })).assertStatus(422)
+  })
+
+  it('answers 401 for missing, tampered and unknown tokens', async () => {
+    const { token } = await createToken(owner, 'tamper')
+    ;(await http.json().get('/api/posts')).assertStatus(401)
+    ;(await bearer(`${token}x`).get('/api/posts')).assertStatus(401)
+    ;(await bearer('not-a-token').get('/api/posts')).assertStatus(401)
+    ;(await bearer(`${token}x`).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' })).assertStatus(401)
+  })
+
+  it('revokes only the owner\'s own tokens', async () => {
+    const mine = await createToken(owner, 'old laptop')
+    const kept = await createToken(owner, 'kept')
+    const theirs = await createToken(other, 'theirs')
+
+    const session = await http.actingAs(owner).json().withCsrf('/profile')
+    ;(await session.delete(`/profile/tokens/${theirs.id}`)).assertStatus(404)
+    ;(await bearer(theirs.token).get('/api/posts')).assertStatus(200)
+
+    ;(await session.delete(`/profile/tokens/${mine.id}`)).assertStatus(204)
+    ;(await bearer(mine.token).get('/api/posts')).assertStatus(401)
+    ;(await bearer(kept.token).get('/api/posts')).assertStatus(200)
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const first = await createToken(owner, 'busy')
+    const second = await createToken(owner, 'quiet')
+
+    for (let i = 0; i < 60; i++) {
+      ;(await bearer(first.token).get('/api/posts')).assertStatus(200)
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    ;(await bearer(second.token).get('/api/posts')).assertStatus(200)
+  })
+})
