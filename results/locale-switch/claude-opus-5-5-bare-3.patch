diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..8e54be5
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,25 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+// The locale middleware createApp({ i18n }) installs reads this cookie before
+// Accept-Language, so a reader's pick wins over their browser's setting.
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+
+    // Only same-origin Referers are followed, so the switcher cannot be used
+    // as an open redirect.
+    const referer = this.request.header('Referer')
+    const target = referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+
+    const response = this.redirect(target)
+    const secure = new URL(this.request.url).protocol === 'https:' ? '; Secure' : ''
+    response.headers.append(
+      'Set-Cookie',
+      `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${ONE_YEAR_IN_SECONDS}; SameSite=Lax; HttpOnly${secure}`,
+    )
+    return response
+  }
+}
