+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { SubscribeSchema, ConfirmTokenSchema, UnsubscribeSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+export function registerNewsletterRoutes(router: Router): void {
+  router.group('/newsletter', (newsletter) => {
+    newsletter.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribeSchema }, [NewsletterController, 'subscribe'])
+    newsletter.get('/confirm/:token', { name: 'newsletter.confirm', params: ConfirmTokenSchema }, [NewsletterController, 'confirm'])
+    newsletter.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribeSchema }, [NewsletterController, 'unsubscribe'])
+  })
+}
