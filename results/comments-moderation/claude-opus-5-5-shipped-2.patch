diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..66efa0c
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,111 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+
+interface ShownComment {
+  id: number
+  body: string
+  author: { id: number; name: string }
+  createdAt: string
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+  let carol: UserRecord
+  let dave: UserRecord
+  let post: PostRecord
+
+  const makeUser = async (name: string) =>
+    (await User.create({ name, email: `${name}@example.com`, password: 'password123' })) as UserRecord
+
+  const shownComments = async (as?: UserRecord): Promise<ShownComment[]> => {
+    const client = as ? http.actingAs(as) : http
+    const res = await client.withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${post.id}`)
+    const page = await res.json<{ props: { comments: ShownComment[] } }>()
+    return page.props.comments
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = await makeUser('alice')
+    bob = await makeUser('bob')
+    carol = await makeUser('carol')
+    dave = await makeUser('dave')
+    post = (await Post.forceCreate({ title: 'T', excerpt: 'E', body: 'B', authorId: alice.id })) as PostRecord
+  })
+
+  it('redirects a guest to login and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('stores a comment and lists it oldest first with its author', async () => {
+    const csrf = await http.actingAs(bob).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'first' }).assertRedirect(`/posts/${post.id}`)
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'second' }).assertRedirect(`/posts/${post.id}`)
+
+    const comments = await shownComments()
+    expect(comments.map((c) => c.body)).toEqual(['first', 'second'])
+    expect(comments[0]!.author).toEqual({ id: bob.id, name: 'bob' })
+    expect(new Date(comments[0]!.createdAt).toISOString()).toBe(comments[0]!.createdAt)
+  })
+
+  it('rejects an empty or too long body', async () => {
+    const csrf = await http.actingAs(bob).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const first = await Comment.forceCreate({ body: 'a', postId: post.id, userId: bob.id })
+    const second = await Comment.forceCreate({ body: 'b', postId: post.id, userId: bob.id })
+
+    await (await http.actingAs(carol).withCsrf()).delete(`/comments/${first!.id}`).assertForbidden()
+    expect(await Comment.find(first!.id)).not.toBeNull()
+
+    await (await http.actingAs(bob).withCsrf()).delete(`/comments/${first!.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(first!.id)).toBeNull()
+
+    await (await http.actingAs(alice).withCsrf()).delete(`/comments/${second!.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second!.id)).toBeNull()
+  })
+
+  it('counts a repeated report once and hides after three reporters', async () => {
+    const comment = await Comment.forceCreate({ body: 'spam', postId: post.id, userId: bob.id })
+
+    const carolCsrf = await http.actingAs(carol).withCsrf()
+    await carolCsrf.post(`/comments/${comment!.id}/report`).assertNoContent()
+    await carolCsrf.post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment!.id }).count()).toBe(1)
+
+    await (await http.actingAs(dave).withCsrf()).post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await shownComments(bob)).toHaveLength(1)
+
+    await (await http.actingAs(alice).withCsrf()).post(`/comments/${comment!.id}/report`).assertNoContent()
+    expect(await shownComments(bob)).toHaveLength(0)
+    expect(await shownComments(alice)).toHaveLength(0)
+    expect(await Comment.find(comment!.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    const comment = await Comment.forceCreate({ body: 'a', postId: post.id, userId: bob.id })
+    await CommentReport.forceCreate({ commentId: comment!.id, userId: carol.id })
+
+    await (await http.actingAs(alice).withCsrf()).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+    expect(await CommentReport.where({ commentId: comment!.id }).count()).toBe(0)
+  })
+})
