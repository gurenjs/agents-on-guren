+const DEFAULT_REDIRECT = '/dashboard'
+
+// Only accept a same-app absolute path as a post-login destination. Resolves
+// the value against a throwaway base with the WHATWG URL parser — the same
+// normalization browsers apply — so absolute URLs with a scheme,
+// protocol-relative values ("//evil.example"), and backslash variants
+// ("/\evil.example", browsers treat "\" like "/") all resolve to a
+// different origin and get rejected, instead of trying to out-guess every
+// bypass with string checks.
+function safeRedirectPath(value: string | undefined): string | null {
+  if (!value || !value.startsWith('/')) return null
+
+  const base = 'http://redirect.invalid'
+  try {
+    return new URL(value, base).origin === base ? value : null
+  } catch {
+    return null
+  }
+}
