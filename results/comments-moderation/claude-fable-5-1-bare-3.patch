+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import type { CommentResourceData } from '../app/Http/Resources/CommentResource.js'
+import { getDrizzle, resetDatabase } from '../config/database.js'
+import { commentReports, comments, posts, users } from '../db/schema.js'
+import app from '../src/app.js'
+
+type UserRow = typeof users.$inferSelect
+type PostRow = typeof posts.$inferSelect
+type CommentRow = typeof comments.$inferSelect
+
+async function createUser(name: string): Promise<UserRow> {
+  const db = await getDrizzle()
+  // Nobody signs in with a password here (actingAs injects the user), so the
+  // row skips the hashing User.create() would do.
+  const [user] = await db
+    .insert(users)
+    .values({ name, email: `${name.toLowerCase()}@example.com`, passwordHash: 'not-a-hash' })
+    .returning()
+  return user!
+}
+
+async function createPost(author: UserRow): Promise<PostRow> {
+  const db = await getDrizzle()
+  const [post] = await db
+    .insert(posts)
+    .values({ title: 'A post', excerpt: 'About something.', body: 'Body.', authorId: author.id })
+    .returning()
+  return post!
+}
+
+async function createComment(post: PostRow, author: UserRow, values: Partial<CommentRow> = {}): Promise<CommentRow> {
+  const db = await getDrizzle()
+  const [comment] = await db
+    .insert(comments)
+    .values({ body: 'A comment', ...values, postId: post.id, userId: author.id })
+    .returning()
+  return comment!
+}
+
+async function storedComments(): Promise<CommentRow[]> {
+  const db = await getDrizzle()
+  return db.select().from(comments)
+}
+
+async function storedReports(commentId: number) {
+  const db = await getDrizzle()
+  return db.select().from(commentReports).where(eq(commentReports.commentId, commentId))
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRow
+  let reader: UserRow
+  let stranger: UserRow
+  let post: PostRow
+
+  // Every mutating request needs the CSRF token of the session it is sent in.
+  const as = (user: UserRow) => http.actingAs(user).withCsrf()
+
+  async function listedComments(client: TestApp = http): Promise<CommentResourceData[]> {
+    const response = await client.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`)
+    response.assertOk()
+    const page = await response.json<{ component: string; props: { comments: CommentResourceData[] } }>()
+    expect(page.component).toBe('posts/Show')
+    return page.props.comments
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await createUser('Author')
+    reader = await createUser('Reader')
+    stranger = await createUser('Stranger')
+    post = await createPost(author)
+  })
+
+  describe('posts.comments.store', () => {
+    it('sends a guest to the login page and stores nothing', async () => {
+      const guest = await http.withCsrf()
+      await guest.post(`/posts/${post.id}/comments`, { body: 'Hello' }).assertRedirect('/login')
+
+      expect(await storedComments()).toHaveLength(0)
+    })
+
+    it('stores the comment under the signed-in user and redirects to the post', async () => {
+      const client = await as(reader)
+      await client.post(`/posts/${post.id}/comments`, { body: 'Nice post' }).assertRedirect(`/posts/${post.id}`)
+
+      const stored = await storedComments()
+      expect(stored).toHaveLength(1)
+      expect(stored[0]).toMatchObject({ postId: post.id, userId: reader.id, body: 'Nice post' })
+    })
+
+    it('ignores an author or post id sent in the body', async () => {
+      const other = await createPost(author)
+      const client = await as(reader)
+      await client
+        .post(`/posts/${post.id}/comments`, { body: 'Mine', userId: stranger.id, postId: other.id })
+        .assertRedirect(`/posts/${post.id}`)
+
+      expect(await storedComments()).toMatchObject([{ postId: post.id, userId: reader.id }])
+    })
+
