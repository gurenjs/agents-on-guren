diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..f67d80d
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,43 @@
+/**
+ * URL slug helpers.
+ *
+ * A slug is lowercase ASCII letters and digits with words joined by a single
+ * `-`, and no leading or trailing `-`: `"  Guren  &  Bun: 2026 Edition!  "`
+ * becomes `guren-bun-2026-edition`.
+ */
+
+/** Slug used when a title has no sluggable characters at all (e.g. "…" or "日本語"). */
+export const FALLBACK_SLUG = 'post'
+
+const COMBINING_MARKS = /[̀-ͯ]/g
+
+export function slugify(value: string): string {
+  const slug = value
+    // Decompose accents so they can be dropped rather than replaced by a dash:
+    // "Café" → "cafe", not "caf-".
+    .normalize('NFKD')
+    .replace(COMBINING_MARKS, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+
+  return slug.length > 0 ? slug : FALLBACK_SLUG
+}
+
+/**
+ * First of `base`, `base-2`, `base-3`, … that `isTaken` reports as free.
+ * `isTaken` is synchronous so the caller decides how the taken set is loaded
+ * (one query up front, rather than one round trip per candidate).
+ */
+export function nextAvailableSlug(base: string, isTaken: (candidate: string) => boolean): string {
+  if (!isTaken(base)) {
+    return base
+  }
+
+  let suffix = 2
+  while (isTaken(`${base}-${suffix}`)) {
+    suffix += 1
+  }
+
+  return `${base}-${suffix}`
+}
