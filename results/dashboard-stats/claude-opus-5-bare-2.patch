diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..5a4ce79
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,101 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const WRITER_EMAIL = 'dashboard-writer@example.com'
+const OTHER_EMAIL = 'dashboard-other@example.com'
+
+interface DashboardProps {
+  user?: { id: number; name: string; email: string } | null
+  postCount: number
+  recentPosts: Array<{ id: number; title: string }>
+}
+
+async function dashboardProps(http: TestApp): Promise<DashboardProps> {
+  const response = await http.get('/dashboard').assertOk()
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as unknown as DashboardProps
+}
+
+// Recreates its own two authors on every run, so the assertions never depend
+// on whatever else the shared test database happens to hold.
+async function freshUser(name: string, email: string): Promise<UserRecord> {
+  const existing = await User.newQuery().where('email', email).first()
+  if (existing) {
+    await Post.delete({ authorId: existing.id })
+    await User.delete({ id: existing.id })
+  }
+  return User.forceCreate({ name, email, password: 'secret123' })
+}
+
+describe('dashboard', () => {
+  let http: TestApp
+  let writer: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+
+    writer = await freshUser('Dashboard Writer', WRITER_EMAIL)
+    other = await freshUser('Dashboard Other', OTHER_EMAIL)
+
+    // Seven posts for the writer, oldest first — only the newest five belong
+    // on the dashboard.
+    for (let index = 1; index <= 7; index += 1) {
+      await Post.forceCreate({
+        title: `Writer post ${index}`,
+        excerpt: 'excerpt',
+        body: 'body',
+        authorId: writer.id,
+        createdAt: `2026-01-0${index}T00:00:00.000Z`,
+      })
+    }
+
+    // Newer than everything above, but written by somebody else.
+    await Post.forceCreate({
+      title: 'Not yours',
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: other.id,
+      createdAt: '2026-02-01T00:00:00.000Z',
+    })
+  })
+
+  it('sends guests to the login page', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+
+  it('counts only the signed-in user’s posts', async () => {
+    const props = await dashboardProps(http.actingAs(writer))
+    expect(props.postCount).toBe(7)
+  })
+
+  it('lists the five newest posts, newest first, and nobody else’s', async () => {
+    const props = await dashboardProps(http.actingAs(writer))
+    expect(props.recentPosts.map((post) => post.title)).toEqual([
+      'Writer post 7',
+      'Writer post 6',
+      'Writer post 5',
+      'Writer post 4',
+      'Writer post 3',
+    ])
+    expect(props.recentPosts.every((post) => typeof post.id === 'number')).toBe(true)
+  })
+
+  it('shows another author only their own single post', async () => {
+    const props = await dashboardProps(http.actingAs(other))
+    expect(props.postCount).toBe(1)
+    expect(props.recentPosts.map((post) => post.title)).toEqual(['Not yours'])
+  })
+
+  it('reports an empty state for a user without posts', async () => {
+    const empty = await freshUser('Dashboard Empty', 'dashboard-empty@example.com')
+    const props = await dashboardProps(http.actingAs(empty))
+    expect(props.postCount).toBe(0)
+    expect(props.recentPosts).toEqual([])
+  })
+})
