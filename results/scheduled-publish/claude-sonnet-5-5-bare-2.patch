+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const HOUR = 3_600_000
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: { id: number }
+  let other: { id: number }
+  let scheduledId: number
+  const tag = `sched${Date.now()}`
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const make = (name: string) =>
+      User.forceCreate({ name, email: `${tag}-${name}@example.com`, passwordHash: 'x' } as never) as Promise<{ id: number }>
+    author = await make('author')
+    other = await make('other')
+    const post = await Post.forceCreate({
+      title: `${tag} later`,
+      excerpt: 'e',
+      body: 'b',
+      authorId: author.id,
+      publishedAt: new Date(Date.now() + HOUR).toISOString(),
+    })
+    scheduledId = post!.id
+  })
+
+  const search = (client: TestApp) => client.query('/posts/search', { keywords: [tag] })
+
+  it('hides a scheduled post from guests and other users', async () => {
