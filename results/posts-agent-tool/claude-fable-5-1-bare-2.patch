+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { migrateDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+// The production MCP endpoint, exercised the way an assistant reaches it: a
+// bearer credential issued through the app's own token store, JSON-RPC over
+// POST /mcp. Unlike the starter tests this one needs the schema, so it
+// migrates the test database (NODE_ENV=test points at its own SQLite file).
+
+interface ToolDescription {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: Record<string, unknown>
+  isError?: boolean
+}
+
+describe('POST /mcp', () => {
+  let http: TestApp
+  let author: { id: number }
+  let bearer: string
+  // Unique per run: the test database file outlives the run.
+  const marker = `mcp-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+  async function issueToken(abilities: string[]): Promise<string> {
+    const store = app.auth.getApiTokenStore()
+    if (!store) throw new Error('The app configures no API token store.')
+    const { plainTextToken } = await createApiToken(store, { name: marker, userId: author.id, abilities })
+    return plainTextToken
+  }
+
+  function rpc(method: string, params: Record<string, unknown>, token?: string): Promise<Response> {
+    return app.fetch(new Request('http://localhost/mcp', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Accept: 'application/json, text/event-stream',
+        ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      },
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+    }))
+  }
+
+  // Streamable HTTP may answer as a single JSON document or as one SSE event.
+  async function result<T>(response: Response): Promise<T> {
+    expect(response.status).toBe(200)
+    const text = await response.text()
+    const json = response.headers.get('Content-Type')?.includes('text/event-stream')
+      ? text.split('\n').find((line) => line.startsWith('data:'))?.slice('data:'.length) ?? ''
+      : text
+    const message = JSON.parse(json) as { result?: T; error?: unknown }
+    if (!message.result) throw new Error(`MCP error: ${JSON.stringify(message.error)}`)
+    return message.result
+  }
+
+  function call(name: string, args: Record<string, unknown>, token = bearer): Promise<ToolResult> {
+    return rpc('tools/call', { name, arguments: args }, token).then((response) => result<ToolResult>(response))
+  }
+
+  function payload(outcome: ToolResult): unknown {
+    return outcome.structuredContent ?? JSON.parse(outcome.content[0]?.text ?? 'null')
+  }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    author = await User.create({ name: 'MCP Author', email: `${marker}@example.com`, password: 'secret-password' })
+    bearer = await issueToken(['tools:*'])
+  })
+
+  it('refuses a call without a credential', async () => {
+    const response = await rpc('tools/list', {})
+    expect(response.status).toBe(401)
+  })
+
+  it('refuses a credential it did not issue', async () => {
+    const response = await rpc('tools/list', {}, 'unknown|credential')
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two tools and says which one only reads', async () => {
+    const { tools } = await result<{ tools: ToolDescription[] }>(await rpc('tools/list', {}, bearer))
+    const own = tools.filter((tool) => !tool.name.startsWith('guren_'))
+
+    expect(own.map((tool) => [tool.name, tool.annotations?.readOnlyHint === true]).sort()).toEqual([
+      ['posts_search', true],
+      ['posts_store', false],
+    ])
+  })
+
+  it('agrees with the tools the app derives for the CLI and the test agent', async () => {
+    const tools = await http.agent().tools()
+
+    expect(tools.map((tool) => [tool.toolName, tool.annotations.readOnlyHint]).sort()).toEqual([
+      ['posts_search', true],
+      ['posts_store', false],
+    ])
+  })
+
+  it('creates a post as the credential\'s user, whatever authorId says', async () => {
+    const title = `${marker} created`
+    const outcome = await call('posts_store', { title, excerpt: 'An excerpt', body: 'A body', authorId: author.id + 1000 })
+
+    expect(outcome.isError).toBeFalsy()
+    const created = await Post.where({ title }).get()
+    expect(created).toHaveLength(1)
+    expect(created[0]?.authorId).toBe(author.id)
+    expect(payload(outcome)).toMatchObject({ data: { id: created[0]?.id, title, authorId: author.id } })
+  })
+
+  it('answers posts_search with what QUERY /posts/search answers', async () => {
+    const title = `${marker} searchable`
+    await Post.forceCreate({ title, excerpt: 'An excerpt', body: 'A body', authorId: author.id })
+    const input = { keywords: [title], limit: 5 }
+
+    const outcome = await call('posts_search', input)
+    const direct = await app.fetch(new Request('http://localhost/posts/search', {
+      method: 'QUERY',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(input),
+    }))
+
+    expect(outcome.isError).toBeFalsy()
+    const found = payload(outcome) as { data: Array<{ title: string }> }
+    expect(found).toEqual(await direct.json())
+    expect(found.data.map((post) => post.title)).toEqual([title])
+  })
+
+  it('rejects input the form would reject with a 422, and creates nothing', async () => {
+    const excerpt = `${marker} rejected`
+    const outcome = await call('posts_store', { title: '', excerpt, body: 'A body' })
+
+    expect(outcome.isError).toBe(true)
+    expect(JSON.stringify(outcome.content)).toContain('Title is required.')
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+  })
+
+  it('lets a read-only credential search but not create', async () => {
+    const reader = await issueToken(['tools:read'])
+    const excerpt = `${marker} read-only`
+
+    const { tools } = await result<{ tools: ToolDescription[] }>(await rpc('tools/list', {}, reader))
+    expect(tools.map((tool) => tool.name).filter((name) => !name.startsWith('guren_'))).toEqual(['posts_search'])
+
+    const outcome = await call('posts_store', { title: 'Denied', excerpt, body: 'A body' }, reader)
+    expect(outcome.isError).toBe(true)
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+  })
+
+  // Sent straight to the routes, past the endpoint and its scope check.
+  function direct(method: string, path: string, token: string, body?: Record<string, unknown>): Promise<Response> {
+    return app.fetch(new Request(`http://localhost${path}`, {
+      method,
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json', Authorization: `Bearer ${token}` },
+      body: body ? JSON.stringify(body) : undefined,
+    }))
+  }
+
+  it('does not let a credential past its scopes on the routes themselves', async () => {
+    const reader = await issueToken(['tools:read'])
+    const excerpt = `${marker} direct`
+
+    expect((await direct('POST', '/posts', reader, { title: 'Direct', excerpt, body: 'A body' })).status).toBe(403)
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+    expect((await direct('QUERY', '/posts/search', reader, { keywords: [marker] })).status).toBe(200)
+  })
+
+  it('does not let a credential reach a route that is not a tool', async () => {
+    const email = `${marker}-changed@example.com`
+
+    expect((await direct('PUT', '/profile', bearer, { name: 'Changed', email })).status).toBe(403)
+    expect((await direct('GET', '/dashboard', bearer)).status).toBe(403)
+    expect((await direct('POST', '/logout', bearer)).status).toBe(403)
+    expect(await User.where({ email }).get()).toHaveLength(0)
+    // Still valid: the logout above revoked nothing.
+    expect((await rpc('tools/list', {}, bearer)).status).toBe(200)
+  })
+})
+
+// The same two tools through the framework's dispatch contract and the
+// session guard, so without a bearer: a guest, and a user signed in the way a
+// browser is. The CSRF token is primed because without it every POST is a 403
+// that says nothing about who may create a post.
+describe('agent tools', () => {
+  let http: TestApp
+  let author: { id: number }
+  const marker = `agent-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    await migrateDatabase()
+    http = await booted.withCsrf('/login')
+    author = await User.create({ name: 'Agent Author', email: `${marker}@example.com`, password: 'secret-password' })
+  })
+
+  it('lets a guest search, like the search on the site', async () => {
+    await http.agent().call('posts_search', { keywords: [marker] }).assertOk().assertStatus(200)
+  })
+
+  it('validates the search input', async () => {
+    await http.agent().call('posts_search', { keywords: [] }).assertStatus(422)
+  })
+
+  it('refuses a guest who creates a post', async () => {
+    const excerpt = `${marker} guest`
+    const result = await http.agent().call('posts_store', { title: 'Guest', excerpt, body: 'A body' })
+
+    // Either spelling of "sign in first": the form's redirect, or a 401/403.
+    if (result.status >= 300 && result.status < 400) {
+      expect(result.response.headers.get('Location')).toContain('/login')
+    } else {
+      expect([401, 403]).toContain(result.status)
+    }
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
+  })
+
+  it('creates a post for a signed-in user', async () => {
+    const title = `${marker} created`
+    const result = await http.agent()
+      .call('posts_store', { title, excerpt: 'An excerpt', body: 'A body', authorId: author.id + 1000 }, { as: author })
+
+    result.assertOk().assertStatus(201)
+    expect(result.json()).toMatchObject({ data: { title, authorId: author.id } })
+    expect((await Post.where({ title }).get()).map((post) => post.authorId)).toEqual([author.id])
+  })
+
+  it('answers invalid input with a 422', async () => {
+    const excerpt = `${marker} rejected`
+    await http.agent().call('posts_store', { title: ' ', excerpt, body: 'A body' }, { as: author }).assertStatus(422)
+
+    expect(await Post.where({ excerpt }).get()).toHaveLength(0)
