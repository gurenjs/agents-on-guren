@@ -20,3 +22,99 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.update', () => {
+  let http: TestApp
+  const suffix = `${Math.floor(Math.random() * 1e9)}`
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function makeAuthorAndPost() {
+    const author = await User.create({
+      name: 'Author',
+      email: `author-${suffix}-${Math.floor(Math.random() * 1e9)}@example.com`,
+      password: 'secret1234',
+    })
+    const other = await User.create({
+      name: 'Other',
+      email: `other-${suffix}-${Math.floor(Math.random() * 1e9)}@example.com`,
+      password: 'secret1234',
+    })
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+    return { author, other, post }
+  }
+
+  it('ignores an authorId sent in the request body', async () => {
+    const { author, other, post } = await makeAuthorAndPost()
+    const client = await http.actingAs(author).withCsrf()
+
+    await client
+      .put(`/posts/${post.id}`, {
+        title: 'Renamed',
+        excerpt: 'Still mine?',
+        body: 'Updated body',
+        authorId: other.id,
+      })
+      .assertRedirect(`/posts/${post.id}`)
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.authorId).toBe(author.id)
+    expect(updated.title).toBe('Renamed')
+  })
+
+  it('ignores fields outside the edit form', async () => {
+    const { author, post } = await makeAuthorAndPost()
+    const client = await http.actingAs(author).withCsrf()
+
+    await client
+      .put(`/posts/${post.id}`, {
+        title: 'Renamed again',
+        excerpt: 'Excerpt',
+        body: 'Body',
+        createdAt: '1999-01-01T00:00:00.000Z',
+      })
+      .assertRedirect(`/posts/${post.id}`)
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.createdAt).not.toBe('1999-01-01T00:00:00.000Z')
+  })
+
+  it('rejects an empty title with a 422 and leaves the post unchanged', async () => {
+    const { author, post } = await makeAuthorAndPost()
+    const client = await http.actingAs(author).withCsrf()
+
+    await client
+      .put(`/posts/${post.id}`, {
+        title: '',
+        excerpt: 'Excerpt',
+        body: 'Body',
+      })
+      .assertStatus(422)
+
+    const unchanged = await Post.findOrFail(post.id)
+    expect(unchanged.title).toBe('Original title')
+  })
+
+  it('refuses an edit from a non-author', async () => {
+    const { other, post } = await makeAuthorAndPost()
+    const client = await http.actingAs(other).withCsrf()
+
+    await client
+      .put(`/posts/${post.id}`, {
+        title: 'Hijacked',
+        excerpt: 'Excerpt',
+        body: 'Body',
+      })
+      .assertStatus(403)
+
+    const unchanged = await Post.findOrFail(post.id)
+    expect(unchanged.title).toBe('Original title')
+  })
+})
