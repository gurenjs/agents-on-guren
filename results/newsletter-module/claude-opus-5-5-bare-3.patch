+import type { Router } from '@guren/core'
+import NewsletterController from './app/Http/Controllers/NewsletterController.js'
+import { SubscribePayloadSchema, UnsubscribePayloadSchema } from './app/Http/Validators/NewsletterValidator.js'
+
+// Mounted under the module's '/newsletter' prefix (see index.ts). Open to
+// guests and signed-in visitors alike.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: SubscribePayloadSchema }, [NewsletterController, 'subscribe'])
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: UnsubscribePayloadSchema }, [NewsletterController, 'unsubscribe'])
+}
