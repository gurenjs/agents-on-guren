diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..4aa7553
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { apiTokenStore } from '../app/Models/ApiToken.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let session: TestApp
+  let userId: number
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+  const mint = async (name = 'CI') => {
+    const res = await session.post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return (await res.json()) as { id: string; name: string; token: string }
+  }
+  const list = (token: string) => bearer(token).get('/api/posts')
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const user = await User.create({ name: 'Tok', email: `tok${Date.now()}@example.com`, password: 'password123' })
+    userId = user.id as number
+    session = (await http.withCsrf('/login')).json().actingAs(user)
+  })
+
+  it('validates the name', async () => {
+    for (const name of ['', 'x'.repeat(51)]) {
+      expect((await session.post('/profile/tokens', { name })).status).toBe(422)
+    }
+    expect((await session.post('/profile/tokens', {})).status).toBe(422)
+  })
+
+  it('stores only a hash, authenticates, and revokes', async () => {
+    const { id, token } = await mint()
+    const secret = token.split('|')[1]!
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+    expect(JSON.stringify(await apiTokenStore.findByUserId(userId))).not.toContain(secret)
+
+    expect((await list(token)).status).toBe(200)
+    expect((await list(`${token}x`)).status).toBe(401)
+    expect((await http.json().get('/api/posts')).status).toBe(401)
+
+    const created = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(created.status).toBe(201)
+    expect(((await created.json()) as { data: { authorId: number } }).data.authorId).toBe(userId)
+
+    expect((await bearer(token).post('/api/posts', { title: '', excerpt: 'E' })).status).toBe(422)
+
+    expect((await session.delete(`/profile/tokens/${id}`)).status).toBe(204)
+    expect((await list(token)).status).toBe(401)
+  })
+
+  it('404s on a token that is not the caller\'s', async () => {
+    expect((await session.delete('/profile/tokens/nope')).status).toBe(404)
+  })
+
+  it('rate limits per token', async () => {
+    const a = await mint('a')
+    const b = await mint('b')
+    for (let i = 0; i < 60; i++) expect((await list(a.token)).status).toBe(200)
+    const limited = await list(a.token)
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    expect((await list(b.token)).status).toBe(200)
+  })
+})
