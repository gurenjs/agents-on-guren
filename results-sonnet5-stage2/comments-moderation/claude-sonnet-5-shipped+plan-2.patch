+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+let userSeq = 0
+
+async function makeUser(name: string) {
+  userSeq += 1
+  return User.create({ name, email: `${name.toLowerCase()}${userSeq}@example.com`, password: 'password123' })
+}
+
+async function setup() {
+  const writer = await makeUser('Writer')
+  const post = await Post.forceCreate({ title: 'A post', excerpt: 'Excerpt', body: 'Body', authorId: writer.id })
+  const comment = await Comment.forceCreate({ postId: post.id, userId: writer.id, body: 'Reportable' })
+  return { writer, post, comment }
+}
+
+describe('comment reports', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('[AC-reports-1] A signed-in user can report a comment.', async () => {
+    const { comment } = await setup()
+    const reporter = await makeUser('Reporter')
+
+    const csrf = await http.actingAs(reporter).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).get()).toHaveLength(1)
+  })
+
+  it('[AC-reports-2] Reporting the same comment again answers 204 and counts once.', async () => {
+    const { comment } = await setup()
+    const reporter = await makeUser('Reporter')
+
+    const csrf = await http.actingAs(reporter).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).get()).toHaveLength(1)
+  })
+
+  it('[AC-reports-3] A guest cannot report a comment.', async () => {
+    const { comment } = await setup()
+
+    const csrf = await http.withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertRedirect('/login')
+    expect(await CommentReport.all()).toHaveLength(0)
+  })
+
+  it('[AC-reports-4] Three different reporters hide a comment from the post page but not from the database.', async () => {
