+  .default('')
+  .superRefine((raw, ctx) => {
+    const names = parseTagNames(raw)
+    if (names.some((name) => Array.from(name).length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be 1-${MAX_TAG_LENGTH} characters.` })
+    }
+    if (names.length > MAX_TAGS) {
+      ctx.addIssue({ code: 'custom', message: `Use at most ${MAX_TAGS} tags.` })
