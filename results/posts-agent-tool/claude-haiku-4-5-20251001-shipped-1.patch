+++ b/app/Providers/ApiTokenProvider.ts
@@ -0,0 +1,15 @@
+import { ServiceProvider, DatabaseApiTokenStore } from '@guren/core'
+import type { AuthManager } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export default class ApiTokenProvider extends ServiceProvider {
+  register(): void {
+    this.container.singleton('apiTokens', () => new DatabaseApiTokenStore(apiTokens, { abilitiesMode: 'text' }))
+  }
+
+  boot(): void {
+    const auth = this.container.make<AuthManager>('auth')
+    const tokenStore = this.container.make<DatabaseApiTokenStore>('apiTokens')
+    auth.useTokens(tokenStore)
+  }
+}
