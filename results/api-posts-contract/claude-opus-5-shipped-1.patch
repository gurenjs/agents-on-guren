diff --git a/tests/ApiPostsFeed.test.ts b/tests/ApiPostsFeed.test.ts
new file mode 100644
index 0000000..9fa9930
--- /dev/null
+++ b/tests/ApiPostsFeed.test.ts
@@ -0,0 +1,112 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+
+// api.posts.index is the public feed: no session, no CSRF, plain JSON.
+async function makeAuthor(name: string, email: string): Promise<UserRecord> {
+  const user = await User.create({ name, email, password: 'secret123' })
+  return user as UserRecord
+}
+
+async function makePost(author: UserRecord, title: string, createdAt: string): Promise<void> {
+  // forceCreate, because `authorId` and `createdAt` are outside Post.fillable.
+  await Post.forceCreate({
+    title,
+    excerpt: `${title} excerpt`,
+    body: `${title} body`,
+    authorId: author.id,
+    createdAt,
+  })
+}
+
+describe('api.posts.index', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = await makeAuthor('Alice', 'alice@example.com')
+    bob = await makeAuthor('Bob', 'bob@example.com')
+
+    // 12 posts by Alice (two pages worth) and 3 by Bob, oldest first so the
+    // newest post is also the last one written.
+    for (let i = 1; i <= 12; i += 1) {
+      await makePost(alice, `Alice ${i}`, `2026-01-${String(i).padStart(2, '0')}T00:00:00.000Z`)
+    }
+    for (let i = 1; i <= 3; i += 1) {
+      await makePost(bob, `Bob ${i}`, `2026-02-${String(i).padStart(2, '0')}T00:00:00.000Z`)
+    }
+  })
+
+  it('lists the newest posts as JSON without a session', async () => {
+    const response = await http.get('/api/posts')
+    response.assertOk()
+    expect(response.headers.get('content-type')).toContain('application/json')
+
+    const body = await response.json<{
+      data: Array<{ id: number; title: string; excerpt: string; createdAt: string; author?: { id: number; name: string } }>
+      meta: { currentPage: number; lastPage: number; perPage: number; total: number }
+    }>()
+
+    expect(body.data).toHaveLength(10)
+    expect(body.data[0]?.title).toBe('Bob 3')
+    expect(body.data[0]?.author).toEqual({ id: bob.id, name: 'Bob' })
+    expect(body.data[0]?.createdAt).toBe('2026-02-03T00:00:00.000Z')
+    expect(body.meta).toMatchObject({ currentPage: 1, lastPage: 2, perPage: 10, total: 15 })
+  })
+
+  it('serves the remainder on page 2', async () => {
+    const body = await (await http.get('/api/posts?page=2')).json<{
+      data: Array<{ title: string }>
+      meta: { currentPage: number; total: number }
+    }>()
+
+    expect(body.data).toHaveLength(5)
+    expect(body.meta).toMatchObject({ currentPage: 2, total: 15 })
+  })
+
+  it('narrows to one author, counting only that author in meta', async () => {
+    await http
+      .get(`/api/posts?author=${bob.id}`)
+      .assertOk()
+      .assertJsonCount(3, 'data')
+      .assertJsonPath('meta.total', 3)
+      .assertJsonPath('meta.lastPage', 1)
+      .assertJsonPath('data.0.title', 'Bob 3')
+  })
+
+  it('combines author and page', async () => {
+    await http
+      .get(`/api/posts?author=${alice.id}&page=2`)
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('meta.currentPage', 2)
+      .assertJsonPath('meta.total', 12)
+  })
+
+  it('returns an empty page for an author without posts', async () => {
+    const orphan = await makeAuthor('Carol', 'carol@example.com')
+
+    await http
+      .get(`/api/posts?author=${orphan.id}`)
+      .assertOk()
+      .assertJsonCount(0, 'data')
+      .assertJsonPath('meta.total', 0)
+  })
+
+  it('rejects invalid query parameters with 422', async () => {
+    await http.get('/api/posts?page=0').assertStatus(422)
+    await http.get('/api/posts?page=abc').assertStatus(422)
+    await http.get('/api/posts?author=abc').assertStatus(422)
+    await http.get('/api/posts?author=0').assertStatus(422)
+  })
+})
