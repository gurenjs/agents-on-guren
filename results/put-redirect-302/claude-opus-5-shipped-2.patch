+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// A PUT answered with 302 makes the browser (and Inertia's fetch client)
+// repeat the PUT against the Location header, which loops back into this same
+// route — the "ERR_TOO_MANY_REDIRECTS on save" bug. 303 is what turns the
+// redirect into a plain GET of the post page.
+describe('posts.update', () => {
+  let http: TestApp
+  let author: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+
+    author = (await User.create({
+      name: 'Edit Author',
+      email: 'edit-author@example.com',
+      password: 'secret',
+    })) as UserRecord
+
+    post = (await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })) as PostRecord
+  })
+
+  it('redirects to the post page with 303 after a successful save', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${post.id}`, {
+        title: 'Updated title',
+        excerpt: 'Updated excerpt',
+        body: 'Updated body',
+      })
+      .assertStatus(303)
+      .assertHeader('location', `/posts/${post.id}`)
+
+    const updated = await Post.findOrFail(post.id)
+    expect(updated.title).toBe('Updated title')
+  })
+
+  it('still returns 422 for an invalid payload', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.put(`/posts/${post.id}`, { title: '', excerpt: '', body: '' }).assertStatus(422)
+  })
+})
