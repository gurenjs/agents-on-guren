+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+type CreatedToken = { id: string; name: string; token: string }
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: label,
+    email: `${label}-${Date.now()}-${Math.random().toString(36).slice(2)}@example.com`,
+    password: 'secret-password',
+  })
+  if (!user) throw new Error('user not created')
+  return user
+}
+
+describe('profile.tokens', () => {
+  let http: TestApp
+  let owner: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    owner = await makeUser('owner')
+  })
+
+  async function createToken(user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+    const client = await http.actingAs(user).withCsrf()
+    const response = await client.json().post('/profile/tokens', { name })
+    response.assertCreated()
+    return response.json<CreatedToken>()
+  }
+
+  it('creates a named token, shown once, and stores only a hash', async () => {
+    const created = await createToken(owner, 'CI')
+
+    expect(created.name).toBe('CI')
+    expect(typeof created.id).toBe('string')
+    const secret = created.token.split('|').pop() ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const row = await ApiToken.first({ id: created.id })
+    expect(row?.userId).toBe(owner.id)
+    for (const value of Object.values(row ?? {})) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name', async () => {
+    const client = await http.actingAs(owner).withCsrf()
+    const before = await ApiToken.newQuery().where({ userId: owner.id }).count()
+
+    await client.json().post('/profile/tokens', {}).assertUnprocessable()
+    await client.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await client.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+
+    expect(await ApiToken.newQuery().where({ userId: owner.id }).count()).toBe(before)
+  })
+
+  it('gives a guest no token', async () => {
+    const client = await http.withCsrf()
+    const response = await client.json().post('/profile/tokens', { name: 'CI' })
+    expect([302, 303, 401]).toContain(response.status)
+  })
+
+  it('lists the tokens on the profile page', async () => {
+    const created = await createToken(owner, 'old laptop')
+    const response = await http.actingAs(owner).withHeader('X-Inertia', 'true').get('/profile')
+    response.assertOk()
+    const page = await response.json<{ props: { tokens: Array<{ id: string; name: string }> } }>()
+    expect(page.props.tokens.some((token) => token.id === created.id && token.name === 'old laptop')).toBe(true)
+    expect(JSON.stringify(page.props.tokens)).not.toContain(created.token.split('|').pop())
+  })
+
+  it('revokes the owner token and answers 404 for another user token', async () => {
+    const mine = await createToken(owner, 'mine')
+    const other = await makeUser('other')
+    const theirs = await createToken(other, 'theirs')
+
+    const client = await http.actingAs(owner).withCsrf()
+    await client.json().delete(`/profile/tokens/${theirs.id}`).assertNotFound()
+    await http.json().withHeader('Authorization', `Bearer ${theirs.token}`).get('/api/posts').assertOk()
+
+    await client.json().delete(`/profile/tokens/${mine.id}`).assertNoContent()
+    await http.json().withHeader('Authorization', `Bearer ${mine.token}`).get('/api/posts').assertUnauthorized()
+    expect(await ApiToken.first({ id: mine.id })).toBeNull()
+  })
+})
