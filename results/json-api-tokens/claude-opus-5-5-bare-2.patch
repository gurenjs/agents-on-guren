diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..620e63f
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,43 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+// Rows hold the token's public id and the SHA-256 of its secret part, never
+// the plain text: `createApiToken()` hands that out once, as `{id}|{secret}`.
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const API_RATE_LIMIT = 60
+const API_RATE_WINDOW_MS = 60_000
+
+/**
+ * Authenticates `/api/*` requests by bearer token only — a session cookie is
+ * not enough. Missing, malformed, unknown and revoked tokens all answer 401.
+ */
+export const requireApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+})
+
+/**
+ * 60 requests a minute per token, not per user or IP: each of a user's tokens
+ * gets its own budget. Runs after `requireApiToken`, which verified the token
+ * this keys on. The in-memory store suits one process; swap in
+ * RedisRateLimitStore from '@guren/core/redis' when running several.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) => {
+    const seconds = Math.min(Math.max(Math.ceil(retryAfter), 1), API_RATE_WINDOW_MS / 1000)
+    ctx.header('Retry-After', String(seconds))
+    return ctx.json({ message: 'Too many requests.', retryAfter: seconds }, 429)
+  },
+})
