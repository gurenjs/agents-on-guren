diff --git a/app/Http/Middleware/ApiToken.ts b/app/Http/Middleware/ApiToken.ts
new file mode 100644
index 0000000..5274b62
--- /dev/null
+++ b/app/Http/Middleware/ApiToken.ts
@@ -0,0 +1,48 @@
+import {
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokenStore.js'
+import { User } from '../../Models/User.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_WINDOW_MS = 60_000
+
+// Counters live in this process's memory: right for the single server this app
+// runs as, and reset by a restart. Behind several processes, swap in a shared
+// store (RedisRateLimitStore from '@guren/core/redis') or each one grants its
+// own 60.
+export const apiRateLimitStore = new MemoryRateLimitStore()
+
+/**
+ * Authenticates a request by `Authorization: Bearer <token>` and nothing else —
+ * a session cookie is never consulted, which is what lets src/app.ts leave
+ * these routes out of CSRF protection.
+ */
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  // Serialized so the hidden credential columns never reach `auth.user()`.
+  loadUser: async (userId) => {
+    const user = await User.find(Number(userId))
+    return user ? User.serialize(user) : null
+  },
+  onUnauthorized: (ctx) =>
+    ctx.json({ message: 'Unauthenticated.' }, 401, { 'WWW-Authenticate': 'Bearer' }),
+})
+
+/**
+ * 60 requests a minute per token, not per account or address. Mount it after
+ * `authenticateApiToken`: the key is the verified token's id, so a request
+ * that fails authentication spends nobody's allowance.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_WINDOW_MS,
+  store: apiRateLimitStore,
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests, please try again later.', retryAfter }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
