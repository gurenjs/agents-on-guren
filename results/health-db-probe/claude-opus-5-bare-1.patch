--- /dev/null
+++ b/tests/HealthController.test.ts
@@ -0,0 +1,66 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { checkDatabase, healthStatusCode, runHealthChecks, type HealthReport } from '../app/Health/HealthCheck.js'
+
+describe('GET /health', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('answers 200 with a passing database check when the database is reachable', async () => {
+    const response = await http.get('/health').assertOk()
+    const body = await response.json<HealthReport>()
+
+    expect(body.status).toBe('ok')
+    expect(body.checks.db.status).toBe('ok')
+  })
+})
+
+describe('health checks', () => {
+  it('reports the database as healthy when the probe query runs', async () => {
+    const result = await checkDatabase()
+
+    expect(result.status).toBe('ok')
+    expect(result.message).toBeUndefined()
+  })
+
+  it('reports an error when the connection cannot be opened', async () => {
+    const result = await checkDatabase(() => Promise.reject(new Error('connection refused')))
+
+    expect(result.status).toBe('error')
+    expect(result.message).toBe('connection refused')
+  })
+
+  it('reports an error when the probe query throws', async () => {
+    const result = await checkDatabase(async () => ({
+      get() {
+        throw new Error('no such table')
+      },
+    }))
+
+    expect(result.status).toBe('error')
+    expect(result.message).toBe('no such table')
+  })
+
+  it('reports an error when the probe query never settles', async () => {
+    const result = await checkDatabase(async () => ({
+      get: () => new Promise(() => {}),
+    }))
+
+    expect(result.status).toBe('error')
+    expect(result.message).toContain('timed out')
+  }, 10_000)
+
+  it('maps a failing database check to 503 and a passing one to 200', async () => {
+    const failing = await runHealthChecks(() => Promise.reject(new Error('down')))
+    const passing = await runHealthChecks()
+
+    expect(failing.status).toBe('error')
+    expect(failing.checks.db.status).toBe('error')
+    expect(healthStatusCode(failing)).toBe(503)
+    expect(healthStatusCode(passing)).toBe(200)
+  })
+})
