new file mode 100644
index 0000000..5bbed93
--- /dev/null
+++ b/modules/newsletter/tests/SubscriptionController.test.ts
@@ -0,0 +1,62 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { migrateDatabase } from '../../../config/database.js'
+import { Subscription } from '../app/Models/Subscription.js'
+
+// Each test uses its own address, so the tests share one table without clearing it.
+function uniqueEmail(): string {
+  return `reader-${crypto.randomUUID()}@example.com`
+}
+
+describe('newsletter', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = (await (await TestApp.fromApp(app)).withCsrf('/health'))
+      .withHeader('Referer', 'http://localhost/posts')
+  })
+
+  it('stores a pending subscription and redirects back', async () => {
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+
+    const subscription = await Subscription.first({ email })
+    expect(subscription?.confirmedAt).toBeNull()
+    expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects an invalid or duplicate address', async () => {
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email: 'not-an-email' }).assertStatus(422)
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+    await http.post('/newsletter/subscribe', { email }).assertStatus(422)
+
+    expect(await Subscription.where({ email }).get()).toHaveLength(1)
+  })
+
+  it('confirms a subscription by its token', async () => {
+    const email = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email }).assertRedirect('/posts')
+    const subscription = await Subscription.first({ email })
+
+    await http.get(`/newsletter/confirm/${subscription?.token}`).assertRedirect('/')
+    expect((await Subscription.first({ email }))?.confirmedAt).not.toBeNull()
+  })
+
+  it('answers 404 for an unknown token', async () => {
+    await http.get('/newsletter/confirm/never-issued-token-0000').assertStatus(404)
+  })
+
+  it('deletes only the unsubscribed address', async () => {
+    const leaving = uniqueEmail()
+    const staying = uniqueEmail()
+    await http.post('/newsletter/subscribe', { email: leaving }).assertRedirect('/posts')
+    await http.post('/newsletter/subscribe', { email: staying }).assertRedirect('/posts')
+
+    await http.post('/newsletter/unsubscribe', { email: leaving }).assertRedirect('/posts')
+    expect(await Subscription.first({ email: leaving })).toBeNull()
+    expect(await Subscription.first({ email: staying })).not.toBeNull()
+  })
+})
