diff --git a/resources/js/components/publish-at.ts b/resources/js/components/publish-at.ts
new file mode 100644
index 0000000..b3ee827
--- /dev/null
+++ b/resources/js/components/publish-at.ts
@@ -0,0 +1,18 @@
+// A datetime-local input holds local wall time with no zone; the server takes ISO 8601 UTC.
+
+/** ISO timestamp → the `YYYY-MM-DDTHH:mm` value a datetime-local input shows, in the browser's zone. */
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
+  return local.toISOString().slice(0, 16)
+}
+
+/** The datetime-local value → ISO 8601 UTC, or null (publish now) when the field is empty. */
+export function toIsoOrNull(local: string | null | undefined): string | null {
+  return local ? new Date(local).toISOString() : null
+}
+
+export function isScheduled(publishedAt: string | null | undefined): boolean {
+  return publishedAt ? new Date(publishedAt).getTime() > Date.now() : false
+}
