diff --git a/resources/js/components/PublishAtField.tsx b/resources/js/components/PublishAtField.tsx
new file mode 100644
index 0000000..d95e1ce
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,48 @@
+interface Props {
+  /** The UTC ISO 8601 instant the form will send, or null to publish on save. */
+  value: string | null | undefined
+  onChange: (value: string | null) => void
+  error?: string
+}
+
+const fieldClass =
+  'mt-1 w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent'
+
+// `<input type="datetime-local">` speaks the browser's local time with no zone,
+// while the server stores and compares UTC. These two convert at the edge so
+// the form shows "9:00 on the 1st" wherever the author sits, and sends the
+// instant that means.
+function toLocalInputValue(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+function fromLocalInputValue(local: string): string | null {
+  if (local === '') return null
+  const date = new Date(local)
+  return Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+/** Optional publish date and time on the post forms. Empty means "public as soon as it is saved". */
+export default function PublishAtField({ value, onChange, error }: Props) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-g-heading">
+        Publish at <span className="font-normal text-g-muted">(optional)</span>
+      </label>
+      <input
+        type="datetime-local"
+        value={toLocalInputValue(value)}
+        onChange={(event) => onChange(fromLocalInputValue(event.target.value))}
+        className={fieldClass}
+      />
+      <p className="mt-1 text-xs text-g-muted">
+        Leave empty to publish now. Until this time only you can see the post.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
