diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..b39ee31
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,16 @@
+/**
+ * Lowercases `title`, keeps only ASCII letters and digits, and joins the
+ * remaining words with single hyphens. Falls back to `'post'` when nothing
+ * slug-worthy is left (e.g. a title made entirely of punctuation).
+ */
+export function slugify(title: string): string {
+  const slug = title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean)
+    .join('-')
+
+  return slug || 'post'
+}
