diff --git a/tests/Tags.test.ts b/tests/Tags.test.ts
new file mode 100644
index 0000000..bd585ef
--- /dev/null
+++ b/tests/Tags.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'bun:test'
+import { PostPayloadSchema, parseTagNames } from '../app/Http/Validators/PostValidator.js'
+
+const base = { title: 't', excerpt: 'e', body: 'b' }
+
+describe('tags field', () => {
+  it('trims, drops blanks and de-duplicates', () => {
+    expect(parseTagNames(' bun ,bun,, webdev,')).toEqual(['bun', 'webdev'])
+    expect(parseTagNames(undefined)).toEqual([])
+  })
+
+  it('enforces the count and length limits', () => {
+    expect(PostPayloadSchema.safeParse({ ...base, tags: 'a,b,c,d,e' }).success).toBe(true)
+    expect(PostPayloadSchema.safeParse({ ...base, tags: 'a,b,c,d,e,f' }).success).toBe(false)
+    expect(PostPayloadSchema.safeParse({ ...base, tags: 'x'.repeat(30) }).success).toBe(true)
+    expect(PostPayloadSchema.safeParse({ ...base, tags: 'x'.repeat(31) }).success).toBe(false)
+    expect(PostPayloadSchema.safeParse({ ...base, tags: ' bun ,bun' }).success).toBe(true)
+  })
+})
