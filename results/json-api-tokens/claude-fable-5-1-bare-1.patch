diff --git a/app/Http/Middleware/apiToken.ts b/app/Http/Middleware/apiToken.ts
new file mode 100644
index 0000000..5cff8d1
--- /dev/null
+++ b/app/Http/Middleware/apiToken.ts
@@ -0,0 +1,49 @@
+import {
+  AuthenticationException,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiTokenOrFail,
+} from '@guren/core'
+import { apiTokenStore } from '../../Auth/apiTokens.js'
+import { User } from '../../Models/User.js'
+import { DatabaseRateLimitStore } from '../../Support/DatabaseRateLimitStore.js'
+
+export const API_RATE_LIMIT = 60
+export const API_RATE_LIMIT_WINDOW_MS = 60_000
+export const API_RATE_LIMIT_KEY_PREFIX = 'api-token:'
+
+export const apiRateLimitStore = new DatabaseRateLimitStore()
+
+/**
+ * Signs the request in as the owner of its `Authorization: Bearer` token.
+ * The session is never consulted, so a browser cookie cannot reach the API.
+ * Every failure — no header, a malformed, unknown, tampered or revoked token —
+ * gets the same answer, which tells a guesser nothing about which part was wrong.
+ */
+export const authenticateApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  loadUser: async (userId) => {
+    const user = await User.find(userId)
+    if (!user) {
+      throw new AuthenticationException('Unauthenticated.')
+    }
+    return user
+  },
+  onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401, { 'WWW-Authenticate': 'Bearer' }),
+})
+
+/**
+ * 60 requests a minute per token, not per user or address: each of a user's
+ * tokens has its own budget. Runs after authenticateApiToken, which is what
+ * puts the token on the request.
+ */
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: API_RATE_LIMIT,
+  windowMs: API_RATE_LIMIT_WINDOW_MS,
+  store: apiRateLimitStore,
+  keyPrefix: API_RATE_LIMIT_KEY_PREFIX,
+  keyGenerator: (ctx) => getApiTokenOrFail(ctx).token.id,
+  // The middleware has set Retry-After by the time this builds the body.
+  onRateLimited: (ctx, retryAfter) =>
+    ctx.json({ message: 'Too many requests, please try again later.', retryAfter }, 429),
+})
diff --git a/app/Http/Resources/ApiTokenResource.ts b/app/Http/Resources/ApiTokenResource.ts
