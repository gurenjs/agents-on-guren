+import { Controller } from '@guren/core'
+import crypto from 'crypto'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import {
+  NewsletterSubscribeSchema,
+  NewsletterConfirmSchema,
+  NewsletterUnsubscribeSchema,
+} from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  private generateToken(): string {
+    return crypto.randomBytes(32).toString('hex')
+  }
+
+  private getReferer(): string {
+    const referer = this.request.header('referer')
+    if (referer) {
+      try {
+        const refererUrl = new URL(referer)
+        const requestUrl = new URL(this.request.url ?? 'http://localhost/')
+        if (refererUrl.origin === requestUrl.origin) {
+          return referer
+        }
+      } catch {
+        // Invalid URL, fall back to /
+      }
+    }
+    return '/'
+  }
+
+  async subscribe(): Promise<Response> {
+    const data = await this.validateBody(NewsletterSubscribeSchema)
+
+    const existing = await NewsletterSubscription.first({ email: data.email })
+    if (existing) {
+      return this.redirect(this.getReferer(), { status: 303 })
+    }
+
+    const token = this.generateToken()
+    await NewsletterSubscription.create({
+      email: data.email,
+      token,
+      confirmedAt: null,
+    })
+
+    return this.redirect(this.getReferer(), { status: 303 })
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = await this.validateParams(NewsletterConfirmSchema)
+
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      return this.json({ message: 'Not found' }, { status: 404 })
+    }
+
+    await NewsletterSubscription.update(
+      { token },
+      { confirmedAt: new Date().toISOString() },
+    )
+
+    return this.redirect('/', { status: 303 })
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const data = await this.validateBody(NewsletterUnsubscribeSchema)
+
+    await NewsletterSubscription.delete({ email: data.email })
+
+    return this.redirect(this.getReferer(), { status: 303 })
+  }
+}
