@@ -6,13 +6,42 @@ export type PostRecord = typeof posts.$inferSelect
 export type NewPostRecord = typeof posts.$inferInsert
 export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
+// Lowercase ASCII letters/digits only, words joined by a single `-`, no
+// leading/trailing `-`. Anything else (accents, punctuation, emoji) collapses
+// to a word boundary.
+export function slugify(title: string): string {
+  const slug = title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean)
+    .join('-')
+  return slug.length > 0 ? slug : 'post'
+}
+
 export class Post extends defineModel(posts) {
-  // `authorId` is set from the signed-in user, never from request input.
+  // `authorId` and `slug` are set from the server, never from request input.
   static fillable = ['title', 'excerpt', 'body']
 
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
+
+  // Slugs are assigned once at creation and never change when the title is
+  // edited later, so a fresh, unused slug is generated up front: the base
+  // slugified title, or `${base}-2`, `${base}-3`, … — the next free number —
+  // if that base is already taken.
+  static async uniqueSlug(title: string): Promise<string> {
+    const base = slugify(title)
+    let candidate = base
+    let suffix = 2
+    while (await Post.first({ slug: candidate })) {
+      candidate = `${base}-${suffix}`
+      suffix += 1
+    }
+    return candidate
+  }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
