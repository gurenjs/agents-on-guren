+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List scheduled posts, soonest first, as <id>\\t<title>\\t<published_at>'
+
+  // The report is piped into other tools: stdout carries the rows and nothing
+  // else, so only line() is used. It writes the text as given, unlike info().
+  async handle(): Promise<number> {
+    const posts = await Post.scheduled().get()
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+
+    return 0
+  }
+}
