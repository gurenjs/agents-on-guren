+describe('Comments', () => {
+  let http: TestApp
+  let author: any
+  let commenter: any
+  let reporter1: any
+  let reporter2: any
+  let reporter3: any
+  let otherUser: any
+  let post: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await resetDatabase()
+
+    author = await User.create({
+      name: 'Post Author',
+      email: 'author@example.com',
+      password: 'password123',
+    })
+
+    commenter = await User.create({
+      name: 'Commenter',
+      email: 'commenter@example.com',
+      password: 'password123',
+    })
+
+    reporter1 = await User.create({
+      name: 'Reporter1',
+      email: 'reporter1@example.com',
+      password: 'password123',
+    })
+
+    reporter2 = await User.create({
+      name: 'Reporter2',
+      email: 'reporter2@example.com',
+      password: 'password123',
+    })
+
+    reporter3 = await User.create({
+      name: 'Reporter3',
+      email: 'reporter3@example.com',
+      password: 'password123',
+    })
+
+    otherUser = await User.create({
+      name: 'Other User',
+      email: 'other@example.com',
+      password: 'password123',
+    })
+
+    post = await Post.forceCreate({
+      title: 'Test Post',
+      excerpt: 'Test excerpt',
+      body: 'Test body',
+      authorId: author.id,
+    })
+  })
+
+  describe('POST /posts/:id/comments', () => {
+    it('creates a comment for authenticated user', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      const response = await csrf.post(`/posts/${post.id}/comments`, {
+        body: 'Great post!',
+      })
+
+      expect(response.status).toBe(303)
+
+      const comment = await Comment.where({ postId: post.id }).first()
+      expect(comment).toBeDefined()
+      expect(comment?.body).toBe('Great post!')
+      expect(comment?.userId).toBe(commenter.id)
+    })
+
+    it('denies unauthenticated users with 403', async () => {
+      await http.post(`/posts/${post.id}/comments`, {
+        body: 'Another comment',
+      }).assertForbidden()
+    })
+
+    it('rejects empty comment body', async () => {
+      const csrf = await http.actingAs(commenter).withCsrf()
+      await csrf.post(`/posts/${post.id}/comments`, {
+        body: '',
+      }).assertUnprocessable()
+    })
+
+    it('rejects comment body exceeding 2000 characters', async () => {
