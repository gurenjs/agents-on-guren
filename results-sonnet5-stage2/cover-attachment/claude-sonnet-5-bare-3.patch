diff --git a/app/Support/Covers.ts b/app/Support/Covers.ts
new file mode 100644
index 0000000..0278681
--- /dev/null
+++ b/app/Support/Covers.ts
@@ -0,0 +1,71 @@
+import { mkdir, unlink } from 'node:fs/promises'
+import { randomUUID } from 'node:crypto'
+import { join } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_TYPES = { 'image/png': 'png', 'image/jpeg': 'jpg' } as const
+export type CoverMime = keyof typeof COVER_TYPES
+
+// Private to the app: outside public/, so it is only reachable through
+// GET /attachments/:id.
+const storageRoot = () => join(process.cwd(), 'storage')
+
+/** Identifies PNG/JPEG by magic bytes, whatever the client claimed. */
+export function sniffCoverMime(bytes: Uint8Array): CoverMime | null {
+  if (bytes.length >= 8 && [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].every((b, i) => bytes[i] === b)) {
+    return 'image/png'
+  }
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+export function coverUrl(attachment: Pick<AttachmentRecord, 'id'> | undefined | null): string | null {
+  return attachment ? `/attachments/${attachment.id}` : null
+}
+
+export async function coversFor(postIds: number[]): Promise<Map<number, AttachmentRecord>> {
+  if (postIds.length === 0) return new Map()
+  const rows = await Attachment.newQuery().whereIn('postId', postIds).get()
+  return new Map(rows.map((row) => [row.postId, row]))
+}
+
+export async function withCovers<T extends { id: number }>(
+  posts: T[],
+): Promise<Array<T & { coverUrl: string | null }>> {
+  const covers = await coversFor(posts.map((post) => post.id))
+  return posts.map((post) => ({ ...post, coverUrl: coverUrl(covers.get(post.id)) }))
+}
+
+async function removeFile(path: string): Promise<void> {
+  await unlink(join(storageRoot(), path)).catch(() => {})
+}
+
+/** Deletes the post's cover row and its file, if it has one. */
+export async function removeCover(postId: number): Promise<void> {
+  const existing = (await coversFor([postId])).get(postId)
+  if (!existing) return
+  await Attachment.delete({ id: existing.id })
+  await removeFile(existing.path)
+}
+
+/** Stores `file` as the post's cover, replacing (and deleting) any previous one. */
+export async function replaceCover(postId: number, file: File, mime: CoverMime): Promise<void> {
+  await mkdir(join(storageRoot(), 'covers'), { recursive: true })
+  const path = `covers/${randomUUID()}.${COVER_TYPES[mime]}`
+  await Bun.write(join(storageRoot(), path), file)
+  try {
+    await removeCover(postId)
+    await Attachment.forceCreate({ postId, path, mimeType: mime, size: file.size })
+  } catch (error) {
+    await removeFile(path)
+    throw error
+  }
+}
+
+export async function readCover(id: number): Promise<{ file: ReturnType<typeof Bun.file>; mimeType: string } | null> {
+  const row = await Attachment.find(id)
+  if (!row) return null
+  const file = Bun.file(join(storageRoot(), row.path))
+  return (await file.exists()) ? { file, mimeType: row.mimeType } : null
+}
