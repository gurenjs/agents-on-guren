@@ -0,0 +1,135 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import type { UserRecord } from '../app/Models/User.js'
+import { slugify, nextAvailableSlug } from '../app/Support/slug.js'
+
+describe('slugify', () => {
+  it('lowercases and joins words with a single dash', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world')
+    expect(slugify('  Guren  &  Bun: 2026 Edition!  ')).toBe('guren-bun-2026-edition')
+  })
+
+  it('strips accents rather than turning them into separators', () => {
+    expect(slugify('Café au lait')).toBe('cafe-au-lait')
+  })
+
+  it('falls back when a title has nothing sluggable', () => {
+    expect(slugify('—…—')).toBe('post')
+  })
+})
+
+describe('nextAvailableSlug', () => {
+  it('numbers from 2 upwards, skipping taken suffixes', () => {
+    const taken = new Set(['a', 'a-2', 'a-3'])
+    expect(nextAvailableSlug('a', (candidate) => taken.has(candidate))).toBe('a-4')
+    expect(nextAvailableSlug('b', (candidate) => taken.has(candidate))).toBe('b')
+  })
+})
+
+describe('post slugs', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({
+      name: 'Slug Author',
+      email: 'slugs@example.com',
+      password: 'secret',
+    })) as UserRecord
+  })
+
+  async function createPost(title: string) {
+    return Post.forceCreate({
+      title,
+      slug: await Post.uniqueSlug(title),
+      excerpt: 'An excerpt.',
+      body: 'A body.',
+      authorId: author.id,
+    })
+  }
+
+  it('derives the slug from the title and numbers duplicates', async () => {
+    expect((await createPost('Hello, World!'))?.slug).toBe('hello-world')
+    expect((await createPost('Hello, World!'))?.slug).toBe('hello-world-2')
+    expect((await createPost('hello world'))?.slug).toBe('hello-world-3')
+  })
+
+  it('serves the post page at its slug and 404s an unknown one', async () => {
+    await createPost('Hello, World!')
+
+    await http.get('/posts/hello-world').assertOk()
+    await http.get('/posts/no-such-post').assertNotFound()
+  })
+
+  it('sends the slug to the page as a `slug` prop', async () => {
+    await createPost('Hello, World!')
+
+    // X-Inertia asks for the JSON page object rather than the HTML document.
+    const inertia = http.withHeader('X-Inertia', 'true').withHeader('X-Inertia-Version', '')
+    await inertia.get('/posts/hello-world').assertInertia('posts/Show')
+
+    const page = await (await inertia.get('/posts/hello-world')).json<{
+      props: { post: { slug: string; author?: { name: string } } }
+    }>()
+    expect(page.props.post.slug).toBe('hello-world')
+    // The author relation is still eager-loaded, as the page renders its name.
+    expect(page.props.post.author?.name).toBe('Slug Author')
+  })
+
+  it('lists posts with their slug', async () => {
+    await createPost('Hello, World!')
+
+    const inertia = http.withHeader('X-Inertia', 'true').withHeader('X-Inertia-Version', '')
+    const list = await (await inertia.get('/posts')).json<{
+      props: { data: Array<{ slug: string }> }
+    }>()
+    expect(list.props.data.map((post) => post.slug)).toEqual(['hello-world'])
+
+    const home = await (await inertia.get('/')).json<{
+      props: { latest: Array<{ slug: string }> }
+    }>()
+    expect(home.props.latest.map((post) => post.slug)).toEqual(['hello-world'])
+  })
+
+  it('permanently redirects the legacy numeric address, and 404s an unknown id', async () => {
+    const post = await createPost('Hello, World!')
+
+    const response = await http.get(`/posts/${post?.id}`)
+    response.assertStatus(301)
+    expect(response.headers.get('location')).toBe('/posts/hello-world')
+
+    await http.get('/posts/999999').assertNotFound()
+  })
+
+  it('keeps the slug when the title changes', async () => {
+    const post = await createPost('Hello, World!')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .put(`/posts/${post?.id}`, { title: 'Something Else', excerpt: 'New.', body: 'New body.' })
+      .assertRedirect('/posts/hello-world')
+
+    const updated = await Post.findOrFail(post?.id as number)
+    expect(updated.slug).toBe('hello-world')
+    expect(updated.title).toBe('Something Else')
+    // The slug the new title would have produced stays free.
+    expect(await Post.findBySlug('something-else')).toBeNull()
+  })
+
+  it('redirects a newly created post to its slug URL', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'Hello, World!', excerpt: 'An excerpt.', body: 'A body.' })
+      .assertRedirect('/posts/hello-world')
+  })
+})
