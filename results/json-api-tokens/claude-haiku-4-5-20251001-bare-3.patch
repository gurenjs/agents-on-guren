new file mode 100644
index 0000000..bfed8fa
--- /dev/null
+++ b/app/Services/RateLimiter.ts
@@ -0,0 +1,35 @@
+interface RateLimitEntry {
+  count: number
+  windowStart: number
+}
+
+const RATE_LIMIT_WINDOW = 60000
+const RATE_LIMIT_MAX = 60
+
+export class RateLimiter {
+  private static store: Map<string, RateLimitEntry> = new Map()
+
+  static checkLimit(tokenId: string): { allowed: boolean; retryAfter?: number } {
+    const now = Date.now()
+    const entry = this.store.get(tokenId)
+
+    if (!entry) {
+      this.store.set(tokenId, { count: 1, windowStart: now })
+      return { allowed: true }
+    }
+
+    const windowAge = now - entry.windowStart
+    if (windowAge > RATE_LIMIT_WINDOW) {
+      this.store.set(tokenId, { count: 1, windowStart: now })
+      return { allowed: true }
+    }
+
+    if (entry.count >= RATE_LIMIT_MAX) {
+      const retryAfter = Math.ceil((RATE_LIMIT_WINDOW - windowAge) / 1000)
+      return { allowed: false, retryAfter: Math.min(retryAfter, 60) }
+    }
+
+    entry.count++
+    return { allowed: true }
+  }
+}
