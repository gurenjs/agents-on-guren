+import { defineModel, type BelongsToRecord, type HasManyRecord } from '@guren/core'
+import { comments } from '../../db/schema.js'
+import type { PostAuthorSummary, PostRecord } from './Post.js'
+import type { CommentReportRecord } from './CommentReport.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type NewCommentRecord = typeof comments.$inferInsert
+export type CommentAuthorSummary = PostAuthorSummary
+
+/** Reports by this many distinct users hide a comment from the post page. */
+export const HIDE_COMMENT_REPORT_THRESHOLD = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` comes from the route and `userId` from the session, never from input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    post: BelongsToRecord<PostRecord>
+    reports: HasManyRecord<CommentReportRecord>
+  } = {
+    author: null,
+    post: null,
+    reports: [],
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+Comment.belongsTo('post', () => import('./Post.js').then((module) => module.Post), 'postId', 'id')
+Comment.hasMany(
+  'reports',
+  () => import('./CommentReport.js').then((module) => module.CommentReport),
+  'commentId',
+  'id',
+)
