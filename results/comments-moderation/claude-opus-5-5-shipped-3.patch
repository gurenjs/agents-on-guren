diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..7a2fc62
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,124 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+let userCounter = 0
+
+async function makeUser(): Promise<UserRecord> {
+  userCounter += 1
+  return (await User.create({
+    name: `User ${userCounter}`,
+    email: `user${userCounter}@example.test`,
+    password: 'secret-password',
+  })) as UserRecord
+}
+
+async function makePost(author: UserRecord): Promise<PostRecord> {
+  return (await Post.forceCreate({ title: 'Hello', excerpt: 'Short', body: 'Long', authorId: author.id })) as PostRecord
+}
+
+async function showProps(http: TestApp, postId: number) {
+  const res = await http.withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+  res.assertOk()
+  const payload = await res.json<{ props: { comments: Array<{ id: number; body: string; author: { id: number; name: string }; createdAt: string }> } }>()
+  return payload.props
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let stranger: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    postAuthor = await makeUser()
+    commenter = await makeUser()
+    stranger = await makeUser()
+    post = await makePost(postAuthor)
+  })
+
+  async function comment(user: UserRecord, body: string) {
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body }).assertRedirect(`/posts/${post.id}`)
+  }
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('rejects an empty or oversized body', async () => {
+    const csrf = await http.actingAs(commenter).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('lists comments oldest first with their author', async () => {
+    await comment(commenter, 'First')
+    await comment(postAuthor, 'Second')
+
+    const { comments } = await showProps(http, post.id)
+    expect(comments.map((c) => c.body)).toEqual(['First', 'Second'])
+    expect(comments[0].author).toEqual({ id: commenter.id, name: commenter.name })
+    expect(new Date(comments[0].createdAt).toISOString()).toBe(comments[0].createdAt)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    await comment(commenter, 'One')
+    await comment(commenter, 'Two')
+    const [first, second] = await Comment.all()
+
+    const strangerCsrf = await http.actingAs(stranger).withCsrf()
+    await strangerCsrf.delete(`/comments/${first.id}`).assertForbidden()
+    expect(await Comment.find(first.id)).not.toBeNull()
+
+    const ownerCsrf = await http.actingAs(commenter).withCsrf()
+    await ownerCsrf.delete(`/comments/${first.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(first.id)).toBeNull()
+
+    const postAuthorCsrf = await http.actingAs(postAuthor).withCsrf()
+    await postAuthorCsrf.delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second.id)).toBeNull()
+  })
+
+  it('hides a comment reported by three different users, counting repeats once', async () => {
+    await comment(commenter, 'Spam')
+    const [target] = await Comment.all()
+
+    const reporters = [stranger, postAuthor]
+    for (const reporter of reporters) {
+      const csrf = await http.actingAs(reporter).withCsrf()
+      await csrf.post(`/comments/${target.id}/report`).assertNoContent()
+      await csrf.post(`/comments/${target.id}/report`).assertNoContent()
+    }
+    expect(await CommentReport.where({ commentId: target.id }).count()).toBe(2)
+    expect((await showProps(http, post.id)).comments).toHaveLength(1)
+
+    const third = await makeUser()
+    const csrf = await http.actingAs(third).withCsrf()
+    await csrf.post(`/comments/${target.id}/report`).assertNoContent()
+
+    expect((await showProps(http.actingAs(commenter), post.id)).comments).toHaveLength(0)
+    expect(await Comment.find(target.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    await comment(commenter, 'Bye')
+    const csrf = await http.actingAs(postAuthor).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})
