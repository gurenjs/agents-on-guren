diff --git a/tests/PostController.test.ts b/tests/PostController.test.ts
index 519f090..d9c48ca 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -1,6 +1,8 @@
 import { beforeAll, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +22,43 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+// posts.update previously replied with a bare 302, which XHR/fetch redirects
+// follow by re-sending the same method — an Inertia PUT to /posts/:id would
+// loop back onto that same update route forever (ERR_TOO_MANY_REDIRECTS).
+// A 303 tells the browser to follow up with a GET, landing on the post page
+// exactly like a fresh publish already does via store()'s this.redirect().
+describe('posts.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('redirects to the post with a 303 See Other', async () => {
+    const author =
+      (await User.first({ email: 'post-update-test@example.com' })) ??
+      (await User.create({
+        name: 'Post Update Test Author',
+        email: 'post-update-test@example.com',
+        password: 'a-strong-test-password',
+      }))
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+
+    const authed = await http.actingAs({ id: author.id }).withCsrf()
+
+    await authed
+      .put(`/posts/${post.id}`, {
+        title: 'Updated title',
+        excerpt: 'Updated excerpt',
+        body: 'Updated body',
+      })
+      .assertStatus(303)
+      .assertHeader('Location', `/posts/${post.id}`)
+  })
+})
