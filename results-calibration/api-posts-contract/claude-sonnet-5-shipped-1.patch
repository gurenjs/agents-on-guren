+  // Serves the public, unauthenticated `api.posts.index` route. Read-only
+  // and open to external consumers, so it lives outside the 'auth' group
+  // above and never touches `this.auth`.
+  async apiIndex(): Promise<Response> {
+    const { page, author } = this.validateQuery(ApiPostsIndexQuerySchema)
+
+    // withPaginate(), not .with().paginate() — chaining .with() onto a
+    // QueryBuilder that terminates in .paginate() silently drops the eager
+    // load, so `author` would come back undefined on every row.
+    const result = await Post.withPaginate('author', {
+      page,
+      perPage: 10,
+      where: author !== undefined ? { authorId: author } : undefined,
+      orderBy: ['id', 'desc'],
+    })
+
+    return this.json({
+      data: result.data.map((post) => new PostResource(post).toJSON()),
+      meta: {
+        currentPage: result.meta.currentPage,
+        lastPage: result.meta.totalPages,
+        perPage: result.meta.perPage,
+        total: result.meta.total,
+      },
+    })
+  }
