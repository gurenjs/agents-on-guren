-  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    tags: BelongsToManyRecord<TagRecord>
+  } = {
     author: null,
+    tags: [],
+  }
+
+  /**
+   * Makes `names` the post's exact tag set: unseen names become tags, listed
+   * ones are attached, the rest are detached. A tag left without posts stays.
+   */
+  static async syncTags(postId: number, names: readonly string[], trx: TransactionHandle): Promise<void> {
+    const tags = Tag.inTransaction(trx)
+    const pivot = PostTag.inTransaction(trx)
+
+    const known = await tags.where({ name: [...names] }).get()
+    const idByName = new Map(known.map((tag) => [tag.name, tag.id]))
+    const wanted: number[] = []
+    for (const name of names) {
+      wanted.push(idByName.get(name) ?? (await tags.create({ name })).id)
+    }
+
+    const attached = (await pivot.where({ postId }).get()).map((row) => row.tagId)
+    const removed = attached.filter((tagId) => !wanted.includes(tagId))
+    if (removed.length > 0) {
+      await pivot.where({ postId, tagId: removed }).delete()
+    }
+    for (const tagId of wanted) {
+      if (!attached.includes(tagId)) {
+        await pivot.create({ postId, tagId })
+      }
+    }
+  }
+
+  /**
+   * Posts carrying the tag `name`, newest first, with author and tags loaded.
+   * Pages over the pivot rows, so the posts query never sees more than one
+   * page of ids however many posts carry the tag.
+   */
+  static async paginateByTag(
+    name: string,
+    options: { page: number; perPage: number },
+  ): Promise<PaginatedResult<PostRecord>> {
+    const tag = await Tag.first({ name })
+    const attached = await PostTag.newQuery()
+      // An empty list matches nothing: an unknown tag is an empty page, not an error.
+      .whereIn('tagId', tag ? [tag.id] : [])
+      .orderBy('postId', 'desc')
+      .paginate(options)
+
+    const data = await Post.newQuery()
+      .with('author', 'tags')
+      .whereIn(
+        'id',
+        attached.data.map((row) => row.postId),
+      )
+      .orderBy('id', 'desc')
+      .get()
+
+    return { data, meta: attached.meta }
   }
 }
 
