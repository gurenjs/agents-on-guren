+++ b/modules/newsletter/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,58 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../NewsletterSubscription.js'
+import {
+  NewsletterSubscribeSchema,
+  NewsletterUnsubscribeSchema,
+  NewsletterConfirmParamSchema,
+} from '../../Validators/NewsletterValidator.js'
+import { randomBytes } from 'crypto'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterSubscribeSchema)
+
+    const existing = await NewsletterSubscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'Email is already subscribed.' })
+    }
+
+    const token = randomBytes(32).toString('hex')
+
+    await NewsletterSubscription.create({
+      email,
+      token,
+      confirmedAt: null,
+    })
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(NewsletterConfirmParamSchema)
+
+    const subscription = await NewsletterSubscription.where({ token }).first()
+    if (!subscription) {
+      return this.text('Not Found', { status: 404 })
+    }
+
+    await NewsletterSubscription.update(
+      { id: subscription.id },
+      { confirmedAt: new Date().toISOString() },
+    )
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterUnsubscribeSchema)
+
+    const subscription = await NewsletterSubscription.where({ email }).first()
+    if (subscription) {
+      await NewsletterSubscription.delete({ id: subscription.id })
+    }
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+}
