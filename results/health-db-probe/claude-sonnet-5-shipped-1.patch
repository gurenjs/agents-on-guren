+  // Health check endpoint for load balancers and uptime monitors — actually
+  // probes the database on every request so a deploy with a broken DB
+  // connection reports unhealthy (503) instead of a static 200.
+  router.get('/health', async (c) => {
+    const report = await healthManager.check()
+    return c.json(
+      {
+        status: report.status,
+        checks: Object.fromEntries(
+          report.checks.map((check) => [
+            check.name,
+            { status: check.status, message: check.message, duration: check.duration },
+          ]),
+        ),
+      },
+      report.status === 'unhealthy' ? 503 : 200,
+    )
+  })
 
   registerAuthRoutes(router)
 
