new file mode 100644
index 0000000..4b10912
--- /dev/null
+++ b/resources/js/components/PublishAtField.tsx
@@ -0,0 +1,67 @@
+import { useEffect, useState } from 'react'
+
+interface Props {
+  /** UTC ISO 8601, as the posts routes take it; null publishes on save. */
+  value: string | null
+  onChange: (value: string | null) => void
+  error?: string
+  className?: string
+}
+
+// `datetime-local` speaks wall-clock time with no zone: "2026-10-01T09:00".
+function toLocalInput(iso: string): string {
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) {
+    return ''
+  }
+  const pad = (part: number) => String(part).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+function fromLocalInput(local: string): string | null {
+  const date = new Date(local)
+  return local === '' || Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+export default function PublishAtField({ value, onChange, error, className }: Props) {
+  // Filled after mount: the server would render its own zone's wall-clock
+  // time, and hydration keeps the text an input already shows.
+  const [local, setLocal] = useState('')
+
+  useEffect(() => {
+    setLocal(value ? toLocalInput(value) : '')
+  }, [value])
+
+  return (
+    <div>
+      <label htmlFor="publish-at" className="block text-sm font-bold text-g-heading">
+        Publish at
+      </label>
+      <div className="flex items-center gap-2">
+        <input
+          id="publish-at"
+          type="datetime-local"
+          value={local}
+          onChange={(event) => {
+            setLocal(event.target.value)
+            onChange(fromLocalInput(event.target.value))
+          }}
+          className={className}
+        />
+        {value ? (
+          <button
+            type="button"
+            onClick={() => onChange(null)}
+            className="mt-1 shrink-0 text-sm text-g-accent-text transition hover:underline"
+          >
+            Clear
+          </button>
+        ) : null}
+      </div>
+      <p className="mt-1 text-sm text-g-muted">
+        In your local time. Leave empty to publish as soon as you save; until a later time, only you can see the post.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
