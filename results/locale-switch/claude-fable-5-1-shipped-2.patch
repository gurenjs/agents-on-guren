diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..9ea8c1a
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,26 @@
+import { Controller, isSafeRedirectUrl } from '@guren/core'
+
+// Must match the cookie detectLocaleMiddleware reads (its `cookieName` default).
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+
+    const secure = new URL(this.request.url).protocol === 'https:' ? '; Secure' : ''
+
+    return this.redirect(this.previousUrl(), {
+      headers: {
+        'Set-Cookie': `${LOCALE_COOKIE}=${locale}; Max-Age=${ONE_YEAR_IN_SECONDS}; Path=/; HttpOnly; SameSite=Lax${secure}`,
+      },
+    })
+  }
+
+  // Referer is client-controlled: an off-site value would turn this route into
+  // an open redirect, so only same-origin targets are followed.
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    return referer && isSafeRedirectUrl(referer, this.request.url) ? referer : '/'
+  }
+}
