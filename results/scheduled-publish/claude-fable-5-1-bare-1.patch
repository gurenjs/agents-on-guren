+
+// The test database persists between runs, so every fixture carries a unique
+// marker: emails must be unique, and list/search assertions look for titles
+// that no earlier run could have left behind.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+async function createUser(label: string): Promise<UserRecord> {
+  return User.create({ name: `${label} ${run}`, email: `${label}-${run}@example.com`, password: 'secret' })
+}
+
+/** What the ops check does: moves the instant directly in the database, no app code involved. */
+async function setPublishedAtInDatabase(id: number, publishedAt: string | null): Promise<void> {
+  const db = (await getDatabase()) as SQLiteBunDatabase
+  await db.update(posts).set({ publishedAt }).where(eq(posts.id, id))
+}
+
+async function inertiaProps<T = Record<string, unknown>>(response: Response): Promise<T> {
+  const { payload } = await readInertiaResponse(response)
+  return payload.props as T
+}
+
+type ListedPost = { id: number; title: string; publishedAt: string | null }
+
+async function listedIds(http: TestApp): Promise<Map<number, ListedPost>> {
+  const response = await http.get('/posts')
+  response.assertOk()
+  const { data } = await inertiaProps<{ data: ListedPost[] }>(response.raw)
+  return new Map(data.map((post) => [post.id, post]))
+}
+
+async function searchedIds(http: TestApp, keyword: string): Promise<number[]> {
+  const response = await http.query('/posts/search', { keywords: [keyword] })
+  response.assertOk()
+  const { data } = await response.json<{ data: ListedPost[] }>()
+  return data.map((post) => post.id)
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  const future = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+  const past = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await createUser('author')
+    other = await createUser('other')
+  })
+
+  async function createPost(publishedAt: string | null, title = `Post ${run} ${Math.random().toString(36).slice(2, 8)}`) {
+    return Post.forceCreate({ title, excerpt: `excerpt ${run}`, body: 'body', authorId: author.id, publishedAt })
+  }
+
+  it('shows a scheduled post to its author only, and to everyone once the time has passed', async () => {
+    const post = await createPost(future)
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+
+    const asAuthor = await http.actingAs(author).get(`/posts/${post.id}`)
+    asAuthor.assertOk()
+    const props = await inertiaProps<{ post: ListedPost }>(asAuthor.raw)
+    expect(props.post.id).toBe(post.id)
+    expect(new Date(props.post.publishedAt as string).getTime()).toBe(new Date(future).getTime())
+
+    await setPublishedAtInDatabase(post.id, past)
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('lists a scheduled post for its author only, with the date it goes live', async () => {
+    const scheduled = await createPost(future)
+    const live = await createPost(null)
+    const alreadyPassed = await createPost(past)
+
+    const guest = await listedIds(http)
+    expect(guest.has(scheduled.id)).toBe(false)
+    expect(guest.has(live.id)).toBe(true)
+    expect(guest.get(live.id)?.publishedAt).toBeNull()
+    expect(guest.has(alreadyPassed.id)).toBe(true)
+
+    const stranger = await listedIds(http.actingAs(other))
+    expect(stranger.has(scheduled.id)).toBe(false)
+    expect(stranger.has(live.id)).toBe(true)
+
+    const own = await listedIds(http.actingAs(author))
+    expect(own.has(scheduled.id)).toBe(true)
+    expect(new Date(own.get(scheduled.id)?.publishedAt as string).getTime()).toBe(new Date(future).getTime())
+
+    // The home page's "latest" strip follows the same rule; `scheduled` is
+    // among the three newest posts right now, so it would show if unscoped.
+    const homeForGuest = await inertiaProps<{ latest: ListedPost[] }>((await http.get('/')).raw)
+    expect(homeForGuest.latest.map((post) => post.id)).not.toContain(scheduled.id)
+    const homeForAuthor = await inertiaProps<{ latest: ListedPost[] }>((await http.actingAs(author).get('/')).raw)
+    expect(homeForAuthor.latest.map((post) => post.id)).toContain(scheduled.id)
+
+    await setPublishedAtInDatabase(scheduled.id, past)
+    expect((await listedIds(http)).has(scheduled.id)).toBe(true)
+  })
+
+  it('keeps a scheduled post out of search for guests and other users', async () => {
+    const keyword = `needle${run.replace(/[^a-z0-9]/gi, '')}`
+    const scheduled = await createPost(future, `${keyword} scheduled`)
+    const live = await createPost(null, `${keyword} live`)
+
+    // Search lists newest first, and `live` was created after `scheduled`.
+    expect(await searchedIds(http, keyword)).toEqual([live.id])
+    expect(await searchedIds(http.actingAs(other), keyword)).toEqual([live.id])
+    expect(await searchedIds(http.actingAs(author), keyword)).toEqual([live.id, scheduled.id])
+
+    await setPublishedAtInDatabase(scheduled.id, past)
+    expect(await searchedIds(http, keyword)).toEqual([live.id, scheduled.id])
+  })
+
+  it('stores publishAt from the create form and clears it from the edit form', async () => {
+    // Mutating routes sit behind CSRF like a browser form; withCsrf primes the cookie.
+    const asAuthor = await http.actingAs(author).withCsrf('/posts')
+    const title = `Form ${run} ${Math.random().toString(36).slice(2, 8)}`
+    const created = await asAuthor.post('/posts', { title, excerpt: 'soon', body: 'later', publishAt: future })
+    created.assertRedirect()
+    const [row] = await Post.where('title', title).get()
+    expect(row?.publishedAt).toBe(future)
+
+    const noDate = await asAuthor.post('/posts', { title: `${title} now`, excerpt: 'now', body: 'now' })
+    noDate.assertRedirect()
+    const [nowRow] = await Post.where('title', `${title} now`).get()
+    expect(nowRow?.publishedAt).toBeNull()
+
+    const cleared = await asAuthor.put(`/posts/${row!.id}`, { title, excerpt: 'soon', body: 'later', publishAt: null })
+    cleared.assertRedirect()
+    expect((await Post.findOrFail(row!.id)).publishedAt).toBeNull()
+
+    const rescheduled = await asAuthor.put(`/posts/${row!.id}`, {
+      title,
+      excerpt: 'soon',
+      body: 'later',
+      publishAt: '2030-01-01T09:00:00+02:00',
+    })
+    rescheduled.assertRedirect()
+    expect((await Post.findOrFail(row!.id)).publishedAt).toBe('2030-01-01T07:00:00.000Z')
+  })
+
+  it('rejects a publishAt that is not a date and time, saving nothing', async () => {
+    const asAuthor = (await http.actingAs(author).withCsrf('/posts')).json()
+    const title = `Rejected ${run} ${Math.random().toString(36).slice(2, 8)}`
+    await asAuthor.post('/posts', { title, excerpt: 'x', body: 'y', publishAt: 'next tuesday' }).assertStatus(422)
+    expect(await Post.where('title', title).exists()).toBe(false)
+
+    const post = await createPost(null, title)
+    await asAuthor
+      .put(`/posts/${post.id}`, { title: `${title} edited`, excerpt: 'x', body: 'y', publishAt: 'next tuesday' })
+      .assertStatus(422)
+    expect((await Post.findOrFail(post.id)).title).toBe(title)
+  })
+})
+
+describe('posts:scheduled', () => {
+  it('prints scheduled posts soonest first as tab-separated lines and nothing else', async () => {
+    await TestApp.fromApp(app)
+    const author = await createUser('ops')
+    const marker = `Report ${run}`
+    const later = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString()
+    const sooner = new Date(Date.now() + 1 * 24 * 60 * 60 * 1000).toISOString()
+    const past = new Date(Date.now() - 60 * 60 * 1000).toISOString()
+
+    const late = await Post.forceCreate({ title: `${marker} later`, excerpt: 'e', body: 'b', authorId: author.id, publishedAt: later })
+    const soon = await Post.forceCreate({ title: `${marker} sooner`, excerpt: 'e', body: 'b', authorId: author.id, publishedAt: sooner })
+    await Post.forceCreate({ title: `${marker} public`, excerpt: 'e', body: 'b', authorId: author.id, publishedAt: null })
+    await Post.forceCreate({ title: `${marker} passed`, excerpt: 'e', body: 'b', authorId: author.id, publishedAt: past })
+
+    const output = new BufferedOutput()
+    kernel.setOutput(output)
+    const exitCode = await kernel.handle(['posts:scheduled'])
+
+    expect(exitCode).toBe(0)
+    const lines = output.getLines()
+    for (const line of lines) {
+      expect(line).toMatch(/^\d+\t[^\t]*\t\d{4}-\d{2}-\d{2}T[^\t]+$/)
+    }
+    const ours = lines.filter((line) => line.includes(marker))
+    expect(ours).toEqual([`${soon.id}\t${marker} sooner\t${sooner}`, `${late.id}\t${marker} later\t${later}`])
+
+    const timestamps = lines.map((line) => line.split('\t')[2] as string)
+    expect([...timestamps].sort()).toEqual(timestamps)
+  })
+})
