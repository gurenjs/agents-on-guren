index 0000000..697a352
--- /dev/null
+++ b/modules/newsletter/app/Http/Controllers/NewsletterController.ts
@@ -0,0 +1,63 @@
+import { Controller, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { ConfirmTokenParamSchema } from '../Validators/NewsletterValidator.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.subscribe').body
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from
+    // NewsletterSubscription.fillable: a request must never be able to set it.
+    await NewsletterSubscription.forceCreate({ email, token: generateToken() })
+
+    return this.back()
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenParamSchema)
+    const subscription = await NewsletterSubscription.findOrFail(token, 'token')
+
+    // Following the link a second time keeps the original confirmation time.
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate(
+        { id: subscription.id },
+        { confirmedAt: new Date().toISOString() },
+      )
+    }
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = this.validated('newsletter.unsubscribe').body
+
+    // An address we do not have redirects the same way, so the response does
+    // not reveal who is subscribed.
+    await NewsletterSubscription.delete({ email })
+
+    return this.back()
+  }
+
+  // Sends the visitor back to the page they came from. Only a Referer on this
+  // site is followed — anything else would make these routes an open redirect.
+  private back(): Response {
+    const referer = this.request.header('Referer')
+    if (!referer || !URL.canParse(referer)) {
+      return this.redirect('/')
+    }
+
+    const sameSite = new URL(referer).host === new URL(this.request.url).host
+    return this.redirect(sameSite ? referer : '/')
+  }
+}
+
+// 32 random bytes, hex encoded: 64 characters that cannot be guessed.
+function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
