+++ b/app/Support/Redirects.ts
@@ -0,0 +1,46 @@
+/**
+ * Guards against open redirects.
+ *
+ * User-supplied "send me back here" values (the `redirect` field on the login
+ * form, the matching query parameter) may only ever point at a path inside
+ * this app. Anything that could take the browser to another origin — an
+ * absolute URL with a scheme, a protocol-relative `//host`, a backslash
+ * variant browsers normalise to `//host`, or a value carrying control
+ * characters they strip before parsing — is rejected so the caller can fall
+ * back to its default destination.
+ */
+
+// Any base works: the check is only that a relative path stays on it.
+const RESOLUTION_BASE = 'http://redirect-guard.invalid'
+
+/**
+ * Returns the value when it is a plain same-app path, otherwise `null`.
+ */
+export function sanitizeRedirectPath(value: unknown): string | null {
+  if (typeof value !== 'string' || value === '') return null
+
+  if (hasUnsafeCharacters(value)) return null
+
+  // Must be app-absolute: rules out "https://evil.example", "javascript:…"
+  // and bare hosts. A second slash makes it protocol-relative.
+  if (!value.startsWith('/') || value.startsWith('//')) return null
+
+  try {
+    if (new URL(value, RESOLUTION_BASE).origin !== RESOLUTION_BASE) return null
+  } catch {
+    return null
+  }
+
+  return value
+}
+
+// Backslashes are read as forward slashes by browsers ("/\evil.example" turns
+// into "//evil.example"), and whitespace or control characters are stripped
+// before the URL is parsed — neither belongs in a path we hand back untouched.
+function hasUnsafeCharacters(value: string): boolean {
+  for (const character of value) {
+    const code = character.codePointAt(0) ?? 0
+    if (code <= 0x20 || code === 0x7f || character === '\\') return true
+  }
+  return false
+}
