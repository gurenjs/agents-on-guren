+++ b/tests/HealthCheck.test.ts
@@ -0,0 +1,48 @@
+import { describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import type { Router } from '@guren/core'
+import app from '../src/app.js'
+import { createHealthCheckHandler } from '../app/Http/HealthCheck.js'
+
+describe('GET /health', () => {
+  it('reports healthy with a 200 and a database check when the database is reachable', async () => {
+    const http = await TestApp.fromApp(app)
+
+    await http
+      .get('/health')
+      .assertOk()
+      .assertJsonPath('status', 'healthy')
+      .assertJsonPath('checks.0.name', 'database')
+      .assertJsonPath('checks.0.status', 'healthy')
+  })
+
+  it('queries the database on every probe, not a cached flag', async () => {
+    let calls = 0
+    const handler = createHealthCheckHandler({
+      async query() {
+        calls++
+        if (calls > 1) {
+          throw new Error('connection lost')
+        }
+      },
+    })
+    const http = await TestApp.create({
+      routes: (router: Router) => {
+        router.get('/health', handler)
+      },
+    })
+
+    // First probe: the database answers, so the endpoint is healthy.
+    await http.get('/health').assertOk().assertJsonPath('status', 'healthy')
+
+    // Second probe on the same handler instance: the database now fails —
+    // this only flips if the check re-queries every time rather than
+    // remembering the first result.
+    await http
+      .get('/health')
+      .assertStatus(503)
+      .assertJsonPath('status', 'unhealthy')
+      .assertJsonPath('checks.0.name', 'database')
+      .assertJsonPath('checks.0.status', 'unhealthy')
+  })
+})
