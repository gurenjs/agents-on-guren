diff --git a/tests/LoginThrottle.test.ts b/tests/LoginThrottle.test.ts
new file mode 100644
index 0000000..99e2723
--- /dev/null
+++ b/tests/LoginThrottle.test.ts
@@ -0,0 +1,59 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApp } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { LOGIN_MAX_ATTEMPTS, LOGIN_WINDOW_MS, throttleLogin } from '../app/Http/Middleware/ThrottleLogin.js'
+
+const CREDENTIALS = { email: 'nobody@example.com', password: 'wrong-password' }
+
+// TestApp reaches the app through fetch() rather than a socket, so no client
+// address is available and every request lands in the limiter's shared
+// fail-closed bucket — which is the behaviour being asserted here: the count
+// is per client, and an unidentifiable client is still counted.
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  it('refuses the sixth submission in a minute with 429 and Retry-After', async () => {
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt++) {
+      const allowed = await http.post('/login', CREDENTIALS)
+      expect(allowed.status).not.toBe(429)
+    }
+
+    const throttled = await http.post('/login', CREDENTIALS)
+    expect(throttled.status).toBe(429)
+    expect(throttled.headers.get('retry-after')).toBeTruthy()
+  })
+
+  // Runs with the budget above already spent, so this is a throttled client.
+  it('leaves the rest of the app reachable', async () => {
+    await http.get('/login').assertOk()
+    await http.get('/health').assertOk()
+    expect((await http.post('/register', CREDENTIALS)).status).not.toBe(429)
+  })
+})
+
+describe('the login throttle window', () => {
+  it('lets a client submit again once the window has passed', async () => {
+    let clock = LOGIN_WINDOW_MS
+    // Its own app, so the counters are this test's alone and the injected
+    // clock can jump the window instead of the test sleeping through it.
+    const isolated = createApp({
+      routes: (router) => {
+        router.post('/login', () => ({ ok: true }), throttleLogin({ now: () => clock }))
+      },
+    })
+    const http = await TestApp.fromApp(isolated)
+
+    for (let attempt = 1; attempt <= LOGIN_MAX_ATTEMPTS; attempt++) {
+      await http.post('/login').assertOk()
+    }
+    expect((await http.post('/login')).status).toBe(429)
+
+    clock += LOGIN_WINDOW_MS
+    await http.post('/login').assertOk()
+  })
+})
