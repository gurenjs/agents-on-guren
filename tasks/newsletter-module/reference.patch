+import { defineArchRules } from '@guren/cli/arch'
+
+// The newsletter module is meant to be lifted into the next product as is, so
+// the blog's own code must not depend on it; src/app.ts only lists it.
+export default defineArchRules({
+  layers: {
+    blog: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'blog',
+      disallow: ['newsletter'],
+      message: 'The blog must not import the newsletter module; it is wired in src/app.ts only.',
+    },
+  ],
+})
