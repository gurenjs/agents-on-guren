index 0000000..62851dd
--- /dev/null
+++ b/app/Mail/WelcomeMail.ts
@@ -0,0 +1,35 @@
+import { Mail, type MailManager } from '@guren/core'
+
+/**
+ * The greeting a freshly registered account receives. Sent from
+ * SendWelcomeEmailJob, never from the request itself.
+ *
+ * The sender is the manager's configured `from` (MAIL_FROM_ADDRESS /
+ * MAIL_FROM_NAME), which the Mail constructor applies.
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly name: string,
+  ) {
+    super(manager)
+  }
+
+  // Runs automatically before the message is sent — no manual call needed.
+  override build(): this {
+    // The product name belongs to the deployment, not to this file: a
+    // white-labelled install changes APP_NAME and the subject follows.
+    const appName = process.env.APP_NAME ?? 'Guren'
+
+    return this.subject(`Welcome to ${appName}, ${this.name}!`).text(
+      [
+        `Hi ${this.name},`,
+        '',
+        `Welcome to ${appName}! Your account is ready — sign in whenever you like`,
+        'and publish your first post.',
+        '',
+        `— The ${appName} team`,
+      ].join('\n'),
+    )
+  }
+}
diff --git a/app/Providers/MailProvider.ts b/app/Providers/MailProvider.ts
new file mode 100644
index 0000000..5457c26
--- /dev/null
+++ b/app/Providers/MailProvider.ts
@@ -0,0 +1,39 @@
+import { ServiceProvider, createMailManager, setMailManager, type MailConfig, type MailManager } from '@guren/core'
+
+/**
+ * MAIL_MAILER names the transport every message goes through:
+ *
+ * - `log` (development default) writes the message to the server output
+ * - `memory` keeps messages in memory, where tests can read them back
+ * - `resend` delivers for real, with RESEND_API_KEY
+ *
+ * Read when the provider registers rather than at import time, so a test that
+ * sets the variable before booting the app gets the transport it asked for.
+ */
+function mailConfig(): MailConfig {
+  return {
+    default: process.env.MAIL_MAILER ?? 'log',
+    from: {
+      email: process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com',
+      name: process.env.MAIL_FROM_NAME ?? process.env.APP_NAME ?? 'Guren',
+    },
+    transports: {
+      log: { driver: 'log' },
+      memory: { driver: 'memory' },
+      resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+    },
+  }
+}
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {
+    // Replaces the framework default bound by MailServiceProvider.
+    this.container.instance('mail', createMailManager(mailConfig()))
+  }
+
+  boot(): void {
+    // Queued mail is sent outside a request, where there is no container to
+    // resolve from — jobs reach the manager through getMailManager().
+    setMailManager(this.container.make<MailManager>('mail'))
+  }
+}
diff --git a/app/Providers/QueueProvider.ts b/app/Providers/QueueProvider.ts
new file mode 100644
index 0000000..eaac44e
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,44 @@
+import {
+  ServiceProvider,
+  MemoryDriver,
+  SyncDriver,
+  createQueueManager,
+  getQueueDriver,
+  registerJob,
+  type QueueManager,
+} from '@guren/core'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    const queue = createQueueManager({
+      // QUEUE_CONNECTION picks the connection dispatched work lands on:
+      // `sync` (development default) runs it inline, no worker process
+      // needed; `memory` holds it for a Worker to pick up, which is what
+      // tests drive. Point it at Redis in production by adding a `redis`
+      // driver here (see @guren/core/redis) — dispatching code is unaffected
+      // either way. An unknown name fails loudly on boot rather than
+      // quietly running production work inside the request.
+      default: process.env.QUEUE_CONNECTION ?? 'sync',
+      drivers: {
+        sync: () => new SyncDriver(),
+        memory: () => new MemoryDriver(),
+      },
+    })
+
+    // Replaces the framework default bound by QueueServiceProvider.
+    this.container.instance('queue', queue)
+  }
+
+  boot(): void {
+    // Register job classes before the driver so sync dispatches can resolve them.
+    registerJob(SendWelcomeEmailJob)
+
+    // Resolving the default connection publishes it as the driver
+    // Job.dispatch() pushes to. A driver already installed — a worker process,
+    // or a test harness holding jobs instead of running them — keeps its place.
+    if (!getQueueDriver()) {
+      this.container.make<QueueManager>('queue').driver()
+    }
+  }
+}
