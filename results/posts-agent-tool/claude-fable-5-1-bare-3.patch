diff --git a/tests/PostAgentTools.test.ts b/tests/PostAgentTools.test.ts
new file mode 100644
index 0000000..16df5e8
--- /dev/null
+++ b/tests/PostAgentTools.test.ts
@@ -0,0 +1,219 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import { apiTokenStore } from '../app/Auth/ApiTokenStore.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import app from '../src/app.js'
+
+// The two blog tools an author's assistant can call: `posts_search` and
+// `posts_store`, derived from the `.agent()` metadata on the existing routes
+// and served over MCP at /mcp. The suite covers both the in-process agent
+// bridge (status codes visible) and the real JSON-RPC endpoint (bearer auth).
+
+const MCP_HEADERS = { Accept: 'application/json, text/event-stream' }
+
+interface JsonRpcResponse {
+  result?: Record<string, unknown>
+  error?: { code: number; message: string }
+}
+
+interface ListedTool {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface CallToolResult {
+  isError?: boolean
+  content: Array<{ type: string; text?: string }>
+  structuredContent?: Record<string, unknown>
+}
+
+// Stateless streamable HTTP may answer as JSON or as an SSE stream; take the
+// last `data:` line either way.
+async function readJsonRpc(response: Response): Promise<JsonRpcResponse> {
+  const text = await response.text()
+  const dataLines = text
+    .split('\n')
+    .filter((line) => line.startsWith('data:'))
+    .map((line) => line.slice('data:'.length).trim())
+  const payload = dataLines.length > 0 ? dataLines[dataLines.length - 1] : text
+  return JSON.parse(payload) as JsonRpcResponse
+}
+
+function toolResultJson(result: CallToolResult): unknown {
+  if (result.structuredContent) return result.structuredContent
+  const text = result.content.find((item) => item.type === 'text')?.text ?? ''
+  return JSON.parse(text)
+}
+
+function appTools(tools: ListedTool[]): ListedTool[] {
+  return tools.filter((tool) => !tool.name.startsWith('guren_'))
+}
+
+const run = Date.now()
+
+describe('posts agent tools', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = (await User.create({
+      name: 'Agent Author',
+      email: `agent-author-${run}@example.com`,
+      password: 'secret',
+    })) as UserRecord
+  })
+
+  it('exposes exactly posts_search (read-only) and posts_store (not read-only)', async () => {
+    const tools = await http.agent().tools()
+    const byName = new Map(tools.map((tool) => [tool.toolName, tool]))
+
+    expect(appTools(tools.map((t) => ({ name: t.toolName }))).map((t) => t.name).sort()).toEqual([
+      'posts_search',
+      'posts_store',
+    ])
+    expect(byName.get('posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(byName.get('posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('posts_search answers with the same JSON as QUERY /posts/search, without signing in', async () => {
+    const title = `Bun runtime notes ${run}`
+    await Post.forceCreate({ title, excerpt: 'About Bun.', body: 'Body.', authorId: author.id })
+
+    const input = { keywords: [`runtime notes ${run}`] }
+    const viaHttp = await http.json().query('/posts/search', input).assertOk()
+    const viaTool = await http.agent().call('posts_search', input).assertStatus(200)
+
+    const expected = (await viaHttp.json()) as { data: Array<{ title: string }> }
+    expect(viaTool.json<typeof expected>()).toEqual(expected)
+    expect(expected.data.map((p) => p.title)).toEqual([title])
+  })
+
+  it('posts_store creates the post as the calling user and ignores a sent authorId', async () => {
+    const title = `Drafted by assistant ${run}`
+    const client = (await http.withCsrf('/posts')).agent()
+
+    const result = await client
+      .call('posts_store', { title, excerpt: 'Excerpt.', body: 'Body.', authorId: 999_999 }, { as: author })
+      .assertStatus(201)
+
+    const created = result.json<{ data: { id: number; authorId: number; title: string } }>().data
+    expect(created.title).toBe(title)
+    expect(created.authorId).toBe(author.id)
+
+    const row = await Post.findOrFail(created.id)
+    expect(row.authorId).toBe(author.id)
+  })
+
+  it('posts_store rejects input the form would reject with 422 and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+    const client = (await http.withCsrf('/posts')).agent()
+
+    await client.call('posts_store', { title: '', excerpt: 'Excerpt.', body: 'Body.' }, { as: author }).assertStatus(422)
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+
+  it('posts_store refuses a guest and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+    const title = `Guest attempt ${run}`
+
+    const result = await http.agent().call('posts_store', { title, excerpt: 'Excerpt.', body: 'Body.' })
+    expect([302, 303, 401, 403]).toContain(result.status)
+
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
+
+describe('POST /mcp', () => {
+  let http: TestApp
+  let tokenUser: UserRecord
+  let bearer: string
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    tokenUser = (await User.create({
+      name: 'Token User',
+      email: `token-user-${run}@example.com`,
+      password: 'secret',
+    })) as UserRecord
+    const { plainTextToken } = await createApiToken(apiTokenStore, {
+      name: 'test assistant',
+      userId: tokenUser.id,
+      abilities: ['tools:*'],
+    })
+    bearer = plainTextToken
+  })
+
+  function rpc(method: string, params: Record<string, unknown> = {}, id = 1) {
+    return http
+      .json()
+      .withHeaders({ ...MCP_HEADERS, Authorization: `Bearer ${bearer}` })
+      .post('/mcp', { jsonrpc: '2.0', id, method, params })
+  }
+
+  it('refuses a call without a credential', async () => {
+    await http
+      .json()
+      .withHeaders(MCP_HEADERS)
+      .post('/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} })
+      .assertStatus(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
+    const response = await rpc('tools/list')
+    expect(response.status).toBe(200)
+    const { result, error } = await readJsonRpc(response.raw)
+    expect(error).toBeUndefined()
+
+    const tools = appTools((result as { tools: ListedTool[] }).tools)
+    expect(tools.map((t) => t.name).sort()).toEqual(['posts_search', 'posts_store'])
+    expect(tools.find((t) => t.name === 'posts_search')?.annotations?.readOnlyHint).toBe(true)
+    expect(tools.find((t) => t.name === 'posts_store')?.annotations?.readOnlyHint).not.toBe(true)
+  })
+
+  it('calls posts_search and answers the search JSON', async () => {
+    const title = `MCP search hit ${run}`
+    await Post.forceCreate({ title, excerpt: 'Excerpt.', body: 'Body.', authorId: tokenUser.id })
+
+    const input = { keywords: [`search hit ${run}`], limit: 5 }
+    const expected = await (await http.json().query('/posts/search', input).assertOk()).json()
+
+    const { result, error } = await readJsonRpc(
+      (await rpc('tools/call', { name: 'posts_search', arguments: input })).raw,
+    )
+    expect(error).toBeUndefined()
+    const call = result as unknown as CallToolResult
+    expect(call.isError).not.toBe(true)
+    expect(toolResultJson(call)).toEqual(expected)
+  })
+
+  it('calls posts_store as the credential owner', async () => {
+    const title = `MCP created post ${run}`
+    const { result, error } = await readJsonRpc(
+      (await rpc('tools/call', {
+        name: 'posts_store',
+        arguments: { title, excerpt: 'Excerpt.', body: 'Body.', authorId: 999_999 },
+      })).raw,
+    )
+    expect(error).toBeUndefined()
+    const call = result as unknown as CallToolResult
+    expect(call.isError).not.toBe(true)
+
+    const rows = await Post.newQuery().where('title', title).get()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.authorId).toBe(tokenUser.id)
+  })
+
+  it('answers a validation failure as an error result and creates nothing', async () => {
+    const before = await Post.newQuery().count()
+    const { result, error } = await readJsonRpc(
+      (await rpc('tools/call', { name: 'posts_store', arguments: { title: '', excerpt: 'x', body: 'y' } })).raw,
+    )
+    expect(error).toBeUndefined()
+    expect((result as unknown as CallToolResult).isError).toBe(true)
+    expect(await Post.newQuery().count()).toBe(before)
+  })
+})
