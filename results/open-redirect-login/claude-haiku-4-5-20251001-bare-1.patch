new file mode 100644
index 0000000..13a5503
--- /dev/null
+++ b/app/Utils/UrlValidation.ts
@@ -0,0 +1,23 @@
+// Validates that a redirect URL is safe (same-origin only).
+// Returns the URL if safe, empty string otherwise.
+export function validateSafeRedirectUrl(url: string | undefined | null): string {
+  if (!url) return ''
+
+  // Only allow relative paths starting with / but not // or \/
+  // Reject absolute URLs (with scheme), protocol-relative URLs (//), and backslash variants
+  if (url.startsWith('//') || url.startsWith('/\\')) {
+    return ''
+  }
+
+  // Check for URL schemes (http://, https://, etc.)
+  if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(url)) {
+    return ''
+  }
+
+  // Only allow paths starting with /
+  if (!url.startsWith('/')) {
+    return ''
+  }
+
+  return url
+}
