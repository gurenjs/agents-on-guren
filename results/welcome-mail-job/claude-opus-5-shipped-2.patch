@@ -0,0 +1,50 @@
+import { Mail, type MailManager } from '@guren/core'
+import { appName } from '../../config/app.js'
+
+export interface WelcomeMailRecipient {
+  name: string
+  email: string
+}
+
+/** The name is whatever the user typed at sign-up, so it cannot go into markup raw. */
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+}
+
+/**
+ * The first thing a new account hears from us, sent from the queue right
+ * after registration — see app/Jobs/SendWelcomeEmailJob.ts.
+ *
+ * The sender is left to the mail manager, which applies the configured
+ * MAIL_FROM_ADDRESS / MAIL_FROM_NAME (config/mail.ts).
+ */
+export class WelcomeMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly recipient: WelcomeMailRecipient,
+  ) {
+    super(manager)
+  }
+
+  override build(): this {
+    const app = appName()
+    const { name, email } = this.recipient
+
+    return this.to(email)
+      .subject(`Welcome to ${app}, ${name}!`)
+      .text(
+        `Hi ${name},\n\n` +
+          `Welcome to ${app}! Your account is ready — sign in any time to start writing.\n\n` +
+          `— The ${app} team\n`,
+      )
+      .html(
+        `<p>Hi ${escapeHtml(name)},</p>` +
+          `<p>Welcome to ${escapeHtml(app)}! Your account is ready — sign in any time to start writing.</p>` +
+          `<p>— The ${escapeHtml(app)} team</p>`,
+      )
+  }
+}
