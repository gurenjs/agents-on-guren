diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..45d5511
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,72 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+import { coverFile } from '../app/Support/CoverStorage.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])
+
+function form(fields: Record<string, string>, cover?: File): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  if (cover) data.append('cover', cover)
+  return data
+}
+
+const fields = { title: 'T', excerpt: 'E', body: 'B' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const user = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+    http = await (await TestApp.fromApp(app)).actingAs(user).withCsrf()
+  })
+
+  it('stores, serves, replaces, removes and deletes a cover', async () => {
+    const png = new File([PNG], 'c.png', { type: 'image/png' })
+    await http.post('/posts', form(fields, png)).assertRedirect()
+    const post = (await Post.first({ title: 'T' }))!
+    const first = (await Attachment.first({ postId: post.id }))!
+    expect(existsSync(coverFile(first))).toBe(true)
+
+    const served = await http.get(`/attachments/${first.id}`)
+    expect(served.headers.get('content-type')).toBe('image/png')
+    expect(await served.text()).toBe(new TextDecoder().decode(PNG))
+
+    const jpg = new File([PNG], 'c.jpg', { type: 'image/jpeg' })
+    await http.put(`/posts/${post.id}`, form(fields, jpg)).assertRedirect()
+    expect(existsSync(coverFile(first))).toBe(false)
+    await http.get(`/attachments/${first.id}`).assertNotFound()
+    const second = (await Attachment.first({ postId: post.id }))!
+
+    await http.put(`/posts/${post.id}`, form(fields)).assertRedirect()
+    expect((await Attachment.all()).length).toBe(1)
+
+    await http.put(`/posts/${post.id}`, form({ ...fields, removeCover: '1' })).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+    expect(existsSync(coverFile(second))).toBe(false)
+
+    await http.put(`/posts/${post.id}`, form(fields, png)).assertRedirect()
+    const third = (await Attachment.first({ postId: post.id }))!
+    await http.delete(`/posts/${post.id}`).assertRedirect()
+    expect((await Attachment.all()).length).toBe(0)
+    expect(existsSync(coverFile(third))).toBe(false)
+  })
+
+  it('refuses a GIF and an oversized PNG without saving anything', async () => {
+    const gif = new File([PNG], 'c.gif', { type: 'image/gif' })
+    await http.json().post('/posts', form(fields, gif)).assertUnprocessable()
+    const big = new File([new Uint8Array(2 * 1024 * 1024 + 1)], 'b.png', { type: 'image/png' })
+    await http
+      .json()
+      .post('/posts', form(fields, big))
+      .assertJsonPath('errors.cover.0', 'Cover must be 2 MB or smaller.')
+    expect((await Post.all()).length).toBe(0)
+  })
+})
