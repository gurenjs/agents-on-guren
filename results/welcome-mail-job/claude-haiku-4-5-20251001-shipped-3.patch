@@ -0,0 +1,33 @@
+import { ServiceProvider } from '@guren/core'
+import { createMailManager, setMailManager } from '@guren/server/mail'
+
+export default class MailProvider extends ServiceProvider {
+  register(): void {}
+
+  async boot(): Promise<void> {
+    const mailer = process.env.MAIL_MAILER || 'log'
+
+    const transports: Record<string, any> = {
+      log: { driver: 'log' },
+      memory: { driver: 'memory' },
+    }
+
+    if (process.env.RESEND_API_KEY) {
+      transports.resend = {
+        driver: 'resend',
+        apiKey: process.env.RESEND_API_KEY,
+      }
+    }
+
+    const mailManager = createMailManager({
+      default: mailer,
+      from: {
+        email: process.env.MAIL_FROM_ADDRESS || 'hello@example.com',
+        name: process.env.MAIL_FROM_NAME || process.env.APP_NAME || 'App',
+      },
+      transports,
+    })
+
+    setMailManager(mailManager)
+  }
+}
diff --git a/app/Providers/QueueProvider.ts b/app/Providers/QueueProvider.ts
new file mode 100644
index 0000000..41705f6
--- /dev/null
+++ b/app/Providers/QueueProvider.ts
@@ -0,0 +1,33 @@
+import { ServiceProvider } from '@guren/core'
+import { createQueueManager, setQueueDriver, MemoryDriver, SyncDriver, RedisDriver, registerJob } from '@guren/server/queue'
+import { createRedisClient } from '@guren/server/redis'
+import { SendWelcomeEmailJob } from '../Jobs/SendWelcomeEmailJob.js'
+
+export default class QueueProvider extends ServiceProvider {
+  register(): void {
+    registerJob(SendWelcomeEmailJob)
+  }
+
+  async boot(): Promise<void> {
+    const connection = process.env.QUEUE_CONNECTION || 'sync'
+    const drivers: Record<string, () => any> = {
+      sync: () => new SyncDriver(),
+      memory: () => new MemoryDriver(),
+    }
+
+    if (connection === 'redis' || process.env.REDIS_URL) {
+      drivers.redis = () => {
+        const redis = createRedisClient({ url: process.env.REDIS_URL })
+        return new RedisDriver(redis)
+      }
+    }
+
+    const queueManager = createQueueManager({
+      default: connection,
+      drivers,
+    })
+
+    const driver = queueManager.driver(connection)
+    setQueueDriver(driver)
+  }
+}
