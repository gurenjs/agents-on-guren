diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..fc5ecb2
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,69 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { eq } from 'drizzle-orm'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { posts, postTags, tags } from '../db/schema.js'
+
+const payload = (tagsField?: string) => ({
+  title: 'T',
+  excerpt: 'E',
+  body: 'B',
+  ...(tagsField === undefined ? {} : { tags: tagsField }),
+})
+
+describe('post tags', () => {
+  let http: TestApp
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  let db: any
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    db = await getDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  async function author() {
+    const email = `a${Math.random()}@example.com`
+    return User.forceCreate({ name: 'A', email, password: 'secret-pass' })
+  }
+
+  it('creates, edits, filters and deletes', async () => {
+    const user = await author()
+    const me = await http.actingAs(user).withCsrf()
+    const res = await me.post('/posts', payload(' bun ,bun, webdev,'))
+    res.assertStatus(303)
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const [post] = await db.select().from(posts).where(eq(posts.authorId, (user as any).id))
+    const attached = await db.select().from(postTags).where(eq(postTags.postId, post.id))
+    expect(attached.length).toBe(2)
+
+    const show = await http.get(`/posts/${post.id}`)
+    expect(await show.text()).toContain('webdev')
+
+    await me.put(`/posts/${post.id}`, payload('bun')).assertStatus(303)
+    expect((await db.select().from(postTags).where(eq(postTags.postId, post.id))).length).toBe(1)
+
+    const list = await (await http.get('/posts?tag=bun')).text()
+    expect(list).toContain(`"id":${post.id}`)
+    const none = await (await http.get('/posts?tag=nope')).text()
+    expect(none).not.toContain(`"id":${post.id}`)
+
+    await me.delete(`/posts/${post.id}`).assertStatus(303)
+    expect((await db.select().from(postTags).where(eq(postTags.postId, post.id))).length).toBe(0)
+  })
+
+  it('refuses invalid tags', async () => {
+    const me = await http.actingAs(await author()).withCsrf()
+    const before = (await db.select().from(posts)).length
+    const empty = await me.post('/posts', { ...payload('a'), title: '' })
+    const six = await me.post('/posts', payload('a,b,c,d,e,f'))
+    const long = await me.post('/posts', payload('x'.repeat(31)))
+    expect(six.status).toBe(empty.status)
+    expect(long.status).toBe(empty.status)
+    expect((await db.select().from(posts)).length).toBe(before)
+    await me.post('/posts', payload('x'.repeat(30))).assertStatus(303)
+    expect((await db.select().from(tags).where(eq(tags.name, 'x'.repeat(30)))).length).toBe(1)
+  })
+})
