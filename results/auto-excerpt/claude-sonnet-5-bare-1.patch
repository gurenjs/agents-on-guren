+++ b/tests/PostValidator.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'bun:test'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+describe('PostPayloadSchema', () => {
+  it('accepts a payload with no excerpt and normalizes it to undefined', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', body: 'World' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBeUndefined()
+  })
+
+  it('normalizes an empty-string excerpt to undefined', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '', body: 'World' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBeUndefined()
+  })
+
+  it('normalizes a whitespace-only excerpt to undefined', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '   \n\t  ', body: 'World' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBeUndefined()
+  })
+
+  it('keeps a provided excerpt trimmed', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '  A teaser.  ', body: 'World' })
+    expect(result.success).toBe(true)
+    expect(result.success && result.data.excerpt).toBe('A teaser.')
+  })
+
+  it('still rejects a blank title', () => {
+    const result = PostPayloadSchema.safeParse({ title: '  ', body: 'World' })
+    expect(result.success).toBe(false)
+  })
+
+  it('still rejects a blank body', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', body: '   ' })
+    expect(result.success).toBe(false)
+  })
+})
diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..6da140d
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body unchanged when it is 140 characters or fewer', () => {
+    const body = 'Short and sweet.'
+    expect(deriveExcerpt(body)).toBe(body)
+  })
+
+  it('trims surrounding whitespace before measuring length', () => {
+    expect(deriveExcerpt('  Short and sweet.  ')).toBe('Short and sweet.')
+  })
+
+  it('cuts back to the last whitespace when character 141 falls inside a word', () => {
+    const body =
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ' +
+      'The quick brown fox jumps over the lazy dog. The quick brown'
+    expect(body.length).toBe(150)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+    expect(excerpt.length).toBe(139)
+  })
+
+  it('keeps all 140 characters when character 141 is whitespace', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and ' +
+      'stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt.length).toBe(141)
+  })
+
+  it('cuts at exactly 140 characters when the run has no whitespace', () => {
+    const body = 'a'.repeat(200)
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(`${'a'.repeat(140)}…`)
+  })
+
+  it('appends a single ellipsis character, not three periods', () => {
+    const excerpt = deriveExcerpt('a'.repeat(200))
+    expect(excerpt.endsWith('…')).toBe(true)
+    expect(excerpt.endsWith('...')).toBe(false)
+  })
+})
