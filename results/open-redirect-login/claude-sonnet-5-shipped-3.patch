+// Only a same-app path is a safe post-login destination. Reject anything
+// with a scheme (https://evil.example), protocol-relative URLs
+// (//evil.example), and backslash variants that browsers normalize into
+// protocol-relative URLs (/\evil.example, \/evil.example) — all of those
+// would otherwise send an authenticated user off our origin.
+function safeRedirectPath(value: string | null | undefined): string | null {
+  if (!value) return null
+  const normalized = value.replace(/\\/g, '/')
+  if (!normalized.startsWith('/') || normalized.startsWith('//')) return null
+  return value
+}
