+++ b/resources/js/components/TagList.tsx
@@ -0,0 +1,29 @@
+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+  className?: string
+}
+
+export default function TagList({ tags, className = '' }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul aria-label="Tags" className={`flex flex-wrap gap-2 ${className}`}>
+      {tags.map((tag) => (
+        <li key={tag}>
+          {/* No `page` in the link: a tag always opens on its first page. */}
+          <Link
+            href={route('posts.index', { tag })}
+            className="rounded-full border border-g-line px-2.5 py-0.5 font-mono text-xs text-g-text-2 transition hover:border-g-line-strong hover:text-g-heading"
+          >
+            #{tag}
+          </Link>
+        </li>
+      ))}
+    </ul>
+  )
+}
