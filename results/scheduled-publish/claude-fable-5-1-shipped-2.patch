+
+const fieldClass =
+  'mt-1 w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent'
+
+// The server renders in its own time zone and hydration keeps what it wrote,
+// so a local time is only put on screen once the browser has taken over.
+function useBrowserClock(): boolean {
+  const [ready, setReady] = useState(false)
+  useEffect(() => setReady(true), [])
+  return ready
+}
+
+// datetime-local takes a wall-clock time with no zone: shift the instant by
+// its own offset (DST included), then borrow toISOString()'s formatting.
+function toLocalInputValue(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  if (Number.isNaN(date.getTime())) return ''
+  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16)
+}
+
+function toUtcIso(local: string): string | null {
+  const date = new Date(local)
+  return local === '' || Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
+
+export function isScheduled(publishedAt: string | null | undefined): publishedAt is string {
+  return Boolean(publishedAt) && new Date(publishedAt as string).getTime() > Date.now()
+}
+
+interface PublishAtFieldProps {
+  /** ISO 8601 UTC, the form the `publishAt` request field takes; null publishes on save. */
+  value: string | null | undefined
+  onChange: (value: string | null) => void
+  error?: string
+}
+
+export function PublishAtField({ value, onChange, error }: PublishAtFieldProps) {
+  const ready = useBrowserClock()
+
+  return (
+    <div>
+      <label htmlFor="publish-at" className="block text-sm font-bold text-g-heading">
+        Publish at
+      </label>
+      <input
+        id="publish-at"
+        type="datetime-local"
+        value={ready ? toLocalInputValue(value) : ''}
+        onChange={(event) => onChange(toUtcIso(event.target.value))}
+        className={fieldClass}
+      />
+      <p className="mt-1 text-sm text-g-muted">
+        In your local time. Until then only you can see the post. Leave empty to publish on save.
+      </p>
+      {error ? <p className="mt-1 text-sm text-g-danger">{error}</p> : null}
+    </div>
+  )
+}
+
+export function ScheduledNotice({ publishedAt }: { publishedAt: string | null | undefined }) {
+  const ready = useBrowserClock()
+  if (!ready || !isScheduled(publishedAt)) return null
+
+  return (
+    <p className="inline-block rounded-g-ctl bg-g-warn-tint px-2 py-1 font-mono text-xs uppercase tracking-wide text-g-warn">
+      Scheduled · goes live {new Date(publishedAt).toLocaleString()}
+    </p>
+  )
+}
