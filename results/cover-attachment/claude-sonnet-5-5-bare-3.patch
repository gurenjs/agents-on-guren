diff --git a/tests/PostCover.test.ts b/tests/PostCover.test.ts
new file mode 100644
index 0000000..f4edd2b
--- /dev/null
+++ b/tests/PostCover.test.ts
@@ -0,0 +1,80 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { existsSync } from 'node:fs'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Attachment } from '../app/Models/Attachment.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4])
+const GIF = new TextEncoder().encode('GIF89a-not-an-allowed-image')
+
+function form(fields: Record<string, string | File>): FormData {
+  const data = new FormData()
+  for (const [key, value] of Object.entries(fields)) data.append(key, value)
+  return data
+}
+
+const base = { title: 'Cover post', excerpt: 'Excerpt', body: 'Body' }
+
+describe('post covers', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    const booted = await TestApp.fromApp(app)
+    const user = await User.forceCreate({
+      name: 'Cover Author',
+      email: `cover-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    http = await booted.actingAs(user).withCsrf('/posts')
+  })
+
+  it('stores, serves, replaces and deletes a cover', async () => {
+    const before = (await Post.newQuery().get()).length
+    await http.post('/posts', form({ ...base, cover: new File([PNG], 'a.png', { type: 'image/png' }) }))
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+    expect(posts.length).toBe(before + 1)
+    const post = posts[0]!
+    const first = (await Attachment.first({ postId: post.id }))!
+    expect(first.contentType).toBe('image/png')
+
+    const served = await http.get(`/attachments/${first.id}`)
+    expect(served.status).toBe(200)
+    expect(new Uint8Array(await served.raw.arrayBuffer())).toEqual(PNG)
+
+    // A refused replacement keeps the old cover.
+    await http.put(`/posts/${post.id}`, form({ ...base, cover: new File([GIF], 'a.gif', { type: 'image/gif' }) }))
+    expect((await Attachment.first({ postId: post.id }))!.id).toBe(first.id)
+
+    await http.put(`/posts/${post.id}`, form({ ...base, cover: new File([PNG], 'b.png', { type: 'image/png' }) }))
+    const second = (await Attachment.first({ postId: post.id }))!
+    expect(second.id).not.toBe(first.id)
+    expect(existsSync(`storage/covers/${first.path}`)).toBe(false)
+    expect((await http.get(`/attachments/${first.id}`)).status).toBe(404)
+
+    await http.put(`/posts/${post.id}`, form(base))
+    expect((await Attachment.first({ postId: post.id }))!.id).toBe(second.id)
+
+    await http.put(`/posts/${post.id}`, form({ ...base, removeCover: '1' }))
+    expect(await Attachment.first({ postId: post.id })).toBeNull()
+    expect(existsSync(`storage/covers/${second.path}`)).toBe(false)
+  })
+
+  it('refuses oversized covers and deletes the cover with the post', async () => {
+    const before = (await Post.newQuery().get()).length
+    const big = new Uint8Array(2 * 1024 * 1024 + 1)
+    big.set(PNG)
+    await http.post('/posts', form({ ...base, cover: new File([big], 'big.png', { type: 'image/png' }) }))
+    expect((await Post.newQuery().get()).length).toBe(before)
+
+    await http.post('/posts', form({ ...base, cover: new File([PNG], 'a.png', { type: 'image/png' }) }))
+    const post = (await Post.newQuery().orderBy('id', 'desc').get())[0]!
+    const attachment = (await Attachment.first({ postId: post.id }))!
+    expect(existsSync(`storage/covers/${attachment.path}`)).toBe(true)
+
+    await http.delete(`/posts/${post.id}`)
+    expect(await Attachment.first({ postId: post.id })).toBeNull()
+    expect(existsSync(`storage/covers/${attachment.path}`)).toBe(false)
+  })
+})
