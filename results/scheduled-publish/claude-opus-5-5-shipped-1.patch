@@ -0,0 +1,15 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+export default class ListScheduledPostsCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List scheduled posts as <id>\\t<title>\\t<published_at>, soonest first'
+
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled()
+    // Written straight to stdout: ops pipes this into other tools, so no colour or decoration.
+    for (const post of posts) {
+      process.stdout.write(`${post.id}\t${post.title}\t${post.publishedAt}\n`)
+    }
+  }
+}
