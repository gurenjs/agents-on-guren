@@ -0,0 +1,136 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import {
+  MemoryDriver,
+  MemoryTransport,
+  createMailManager,
+  getMailManager,
+  getQueueDriver,
+  processJob,
+  setMailManager,
+  setQueueDriver,
+  type MailMessage,
+} from '@guren/core'
+import app from '../src/app.js'
+import { mailConfig } from '../config/mail.js'
+import { resetDatabase } from '../config/database.js'
+
+// Registration hands the welcome email to the queue and returns, so the two
+// halves are asserted separately: what the request leaves behind, and what a
+// worker does with it. The memory driver holds dispatched jobs instead of
+// running them (`QUEUE_CONNECTION=memory`), and the memory transport records
+// messages instead of delivering them (`MAIL_MAILER=memory`) — both are
+// installed here directly so the test does not depend on which environment
+// booted the app first.
+describe('register.store', () => {
+  let http: TestApp
+  let queue: MemoryDriver
+  let mailbox: MemoryTransport
+
+  const previousDriver = getQueueDriver()
+  const previousMailManager = getMailManager()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    queue = new MemoryDriver()
+    setQueueDriver(queue)
+
+    const manager = createMailManager({ ...mailConfig(), default: 'memory' })
+    setMailManager(manager)
+    mailbox = manager.transport() as MemoryTransport
+  })
+
+  afterAll(() => {
+    if (previousDriver) setQueueDriver(previousDriver)
+    if (previousMailManager) setMailManager(previousMailManager)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    await queue.clear()
+    mailbox.clear()
+  })
+
+  it('queues the welcome email instead of sending it during the request', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertRedirect('/dashboard')
+
+    expect(mailbox.count()).toBe(0)
+    expect(await queue.size('default')).toBe(1)
+  })
+
+  it('sends the welcome email when the queued work runs', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertRedirect('/dashboard')
+
+    expect(await processJob(queue, 'default')).toBe(true)
+
+    expect(mailbox.count()).toBe(1)
+    const message = mailbox.getLastMessage() as MailMessage
+    expect(message.to.map((address) => address.email)).toEqual(['ada@example.com'])
+    expect(message.from?.email).toBe(process.env.MAIL_FROM_ADDRESS ?? 'hello@example.com')
+    expect(message.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(message.text ?? message.html).toContain('Ada Lovelace')
+    expect(await queue.size('default')).toBe(0)
+  })
+
+  it('queues nothing when the registration is rejected', async () => {
+    const csrf = await http.withCsrf()
+
+    await csrf
+      .post('/register', {
+        name: '',
+        email: 'not-an-email',
+        password: 'short',
+        passwordConfirmation: 'nope',
+      })
+      .assertUnprocessable()
+
+    expect(await queue.size('default')).toBe(0)
+    expect(mailbox.count()).toBe(0)
+  })
+
+  it('queues nothing when the email is already registered', async () => {
+    const first = await http.withCsrf()
+    await first
+      .post('/register', {
+        name: 'Ada Lovelace',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertRedirect('/dashboard')
+
+    await queue.clear()
+
+    const second = await http.withCsrf()
+    await second
+      .post('/register', {
+        name: 'Ada Again',
+        email: 'ada@example.com',
+        password: 'supersecret',
+        passwordConfirmation: 'supersecret',
+      })
+      .assertUnprocessable()
+
+    expect(await queue.size('default')).toBe(0)
+    expect(mailbox.count()).toBe(0)
+  })
+})
