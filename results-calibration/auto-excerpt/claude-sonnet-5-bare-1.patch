diff --git a/app/Support/excerpt.ts b/app/Support/excerpt.ts
new file mode 100644
index 0000000..81f20c8
--- /dev/null
+++ b/app/Support/excerpt.ts
@@ -0,0 +1,31 @@
+const EXCERPT_LENGTH = 140
+const ELLIPSIS = '…'
+
+function lastWhitespaceIndex(text: string): number {
+  for (let i = text.length - 1; i >= 0; i--) {
+    if (/\s/.test(text[i]!)) return i
+  }
+  return -1
+}
+
+// Derives a post excerpt from its body when no excerpt was supplied. Keeps
+// the opening `EXCERPT_LENGTH` characters, but never cuts a word in half:
+// when the cut would land inside a word, it backs up to the last whitespace
+// before it instead.
+export function deriveExcerpt(body: string): string {
+  const trimmed = body.trim()
+  if (trimmed.length <= EXCERPT_LENGTH) return trimmed
+
+  const candidate = trimmed.slice(0, EXCERPT_LENGTH)
+  const cutsMidWord = /\S/.test(candidate[EXCERPT_LENGTH - 1]!) && /\S/.test(trimmed[EXCERPT_LENGTH]!)
+
+  let kept = candidate
+  if (cutsMidWord) {
+    const breakIndex = lastWhitespaceIndex(candidate)
+    if (breakIndex !== -1) {
+      kept = candidate.slice(0, breakIndex)
+    }
+  }
+
+  return kept.trimEnd() + ELLIPSIS
+}
