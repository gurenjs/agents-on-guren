@@ -1,6 +1,9 @@
-import { beforeAll, describe, it } from 'bun:test'
+import { beforeAll, beforeEach, describe, it } from 'bun:test'
 import { TestApp } from '@guren/testing'
 import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
 
 // posts.search is an HTTP QUERY route (RFC 10008). Its controller validates
 // the body with validateBody() before building any query — the schema bound
@@ -20,3 +23,59 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.destroy', () => {
+  let http: TestApp
+  let author: UserRecord
+  let otherUser: UserRecord
+  let postId: number
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret123' })) as UserRecord
+    otherUser = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret123' })) as UserRecord
+
+    const post = await Post.forceCreate({
+      title: 'Original title',
+      excerpt: 'Original excerpt',
+      body: 'Original body',
+      authorId: author.id,
+    })
+    postId = post!.id
+  })
+
+  it('deletes the post when the author requests it', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    const post = await Post.find(postId)
+    if (post !== null) {
+      throw new Error('expected post to be deleted')
+    }
+  })
+
+  it('forbids a signed-in non-author from deleting the post', async () => {
+    const csrf = await http.actingAs(otherUser).withCsrf()
+    await csrf.delete(`/posts/${postId}`).assertForbidden()
+
+    const post = await Post.find(postId)
+    if (post === null) {
+      throw new Error('expected post to still exist')
+    }
+  })
+
+  it('rejects an unauthenticated delete request', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.delete(`/posts/${postId}`).assertRedirect('/login')
+
+    const post = await Post.find(postId)
+    if (post === null) {
+      throw new Error('expected post to still exist')
+    }
+  })
+})
