+import { useState, type FormEvent } from 'react'
+import type { ApiTokenResourceData } from '@/app/Http/Resources/ApiTokenResource'
+import { createApiClient, type ApiRoutes } from '@/.guren/api-client.gen'
+
+interface Props {
+  tokens: ApiTokenResourceData[]
+}
+
+// The token routes answer JSON rather than an Inertia page: the plain-text
+// token exists only in the response that creates it, so it is read from there
+// and held in component state until the page is left.
+const api = createApiClient<ApiRoutes>({ baseUrl: '' })
+
+export default function ApiTokens({ tokens: initialTokens }: Props) {
+  const [tokens, setTokens] = useState(initialTokens)
+  const [name, setName] = useState('')
+  const [issued, setIssued] = useState<{ name: string; token: string } | null>(null)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  async function create(event: FormEvent) {
+    event.preventDefault()
+    setBusy(true)
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.store', { body: { name } })
+      if (response.status === 422) {
+        const payload = (await response.json()) as { errors?: { name?: string[] } }
+        setError(payload.errors?.name?.[0] ?? 'Enter a name of 1 to 50 characters.')
+        return
+      }
+      if (!response.ok) {
+        setError('Could not create the token — reload the page and try again.')
+        return
+      }
+      const created = await response.json()
+      setIssued({ name: created.name, token: created.token })
+      setTokens((current) => [
+        { id: created.id, name: created.name, createdAt: new Date().toISOString(), lastUsedAt: null },
+        ...current,
+      ])
+      setName('')
+    } catch {
+      setError('Could not create the token — check your connection and try again.')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  async function revoke(token: ApiTokenResourceData) {
+    setBusy(true)
+    setError(null)
+    try {
+      const response = await api.request('profile.tokens.destroy', { params: { id: token.id } })
+      // 404 means it is already gone, which is what the click asked for.
+      if (!response.ok && response.status !== 404) {
+        setError(`Could not revoke "${token.name}" — reload the page and try again.`)
+        return
+      }
+      setTokens((current) => current.filter((candidate) => candidate.id !== token.id))
+    } catch {
+      setError(`Could not revoke "${token.name}" — check your connection and try again.`)
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <section className="mt-6 space-y-6 rounded-g-card border border-g-line bg-g-panel p-8 shadow-g-card">
+      <header>
+        <h2 className="flex items-center gap-3 text-2xl font-bold text-g-heading">
+          <span aria-hidden className="h-6 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+          API tokens
+        </h2>
+        <p className="mt-2 text-sm text-g-text-2">
+          Tokens let scripts read and publish posts as you. Send one as{' '}
+          <code className="font-mono text-xs">Authorization: Bearer &lt;token&gt;</code>; each token may make 60
+          requests per minute.
+        </p>
+      </header>
+
+      {issued ? (
+        <div className="space-y-2 border-y border-g-line py-3 text-sm">
+          <p className="text-g-text">
+            Token <span className="font-bold text-g-heading">{issued.name}</span> created. Copy it now — it will not
+            be shown again.
+          </p>
+          <code className="block break-all rounded-g-ctl border border-g-line-strong bg-g-page px-3 py-2 font-mono text-xs text-g-heading">
+            {issued.token}
+          </code>
+        </div>
+      ) : null}
+
+      <form className="flex gap-2" onSubmit={create}>
+        <input
+          type="text"
+          value={name}
+          maxLength={50}
+          onChange={(event) => setName(event.target.value)}
+          placeholder="Token name, e.g. CI"
+          aria-label="Token name"
+          className="w-full rounded-g-ctl border border-g-line-strong bg-g-panel px-3 py-2 text-g-text transition outline-none placeholder:text-g-muted focus:border-transparent focus:outline-2 focus:-outline-offset-1 focus:outline-g-accent"
+        />
+        <button
+          type="submit"
+          disabled={busy}
+          className="shrink-0 rounded-g-ctl bg-g-accent px-4 py-2 text-sm font-bold text-g-on-accent transition hover:bg-g-accent-down disabled:cursor-not-allowed disabled:opacity-45"
+        >
+          Create token
+        </button>
+      </form>
+
+      {error !== null && <p className="text-sm text-g-danger">{error}</p>}
+
+      {tokens.length === 0 ? (
+        <p className="text-sm text-g-text-2">You have no API tokens.</p>
+      ) : (
+        <ul className="divide-y divide-g-line border-y border-g-line">
+          {tokens.map((token) => (
+            <li key={token.id} className="flex items-center justify-between gap-4 py-3">
+              <div>
+                <p className="text-sm font-bold text-g-heading">{token.name}</p>
+                <p className="mt-1 font-mono text-xs text-g-muted">
+                  created {token.createdAt.slice(0, 10)} ·{' '}
+                  {token.lastUsedAt ? `last used ${token.lastUsedAt.slice(0, 10)}` : 'never used'}
+                </p>
+              </div>
+              <button
+                type="button"
+                disabled={busy}
+                onClick={() => revoke(token)}
+                className="shrink-0 rounded-g-ctl border border-g-line-strong px-3 py-1 text-sm text-g-danger transition hover:border-g-muted disabled:cursor-not-allowed disabled:opacity-45"
+              >
+                Revoke
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
