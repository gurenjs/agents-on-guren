+import { beforeEach, describe, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { loginRateLimitStore } from '../routes/auth.js'
+
+// Login submissions are throttled to 5 per minute per client (see
+// routes/auth.ts). The store is cleared before each test so ordering
+// against other tests in this file doesn't matter.
+describe('POST /login throttling', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    loginRateLimitStore.clear()
+    http = (await TestApp.fromApp(app)).json()
+  })
+
+  it('allows 5 attempts per minute and rejects the 6th with 429 + Retry-After', async () => {
+    const csrf = await http.withCsrf('/login')
+    const credentials = { email: 'nobody@example.com', password: 'wrong-password' }
+
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      const response = await csrf.post('/login', credentials)
+      response.assertHeader('X-RateLimit-Remaining', String(5 - attempt))
+    }
+
+    await csrf
+      .post('/login', credentials)
+      .assertStatus(429)
+      .assertHeader('Retry-After')
+  })
+
+  it('still throttles a submission with the correct password', async () => {
+    const csrf = await http.withCsrf('/login')
+
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      await csrf.post('/login', { email: 'nobody@example.com', password: 'wrong-password' })
+    }
+
+    // A correct login attempt made while throttled is refused just like any other.
+    await csrf.post('/login', { email: 'nobody@example.com', password: 'correct-password' }).assertStatus(429)
+  })
+
+  it('does not throttle GET /login', async () => {
+    for (let i = 0; i < 10; i++) {
+      await http.get('/login').assertOk()
+    }
+  })
+})
