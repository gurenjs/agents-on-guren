diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..886882e
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,115 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse, type TestResponse } from '@guren/testing'
+import app from '../src/app.js'
+
+interface I18nProps {
+  locale: string
+  fallbackLocale: string
+  messages: Record<string, Record<string, unknown>>
+}
+
+// The `_i18n` shared prop createApp({ i18n }) attaches to every Inertia page.
+async function i18nOf(response: TestResponse): Promise<I18nProps> {
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props._i18n as I18nProps
+}
+
+// The `locale` cookie the switcher sets, as `name=value`, or null when the
+// response set no such cookie.
+function localeCookie(response: TestResponse): string | null {
+  const pair = response.headers
+    .getSetCookie()
+    .map((cookie) => cookie.split(';')[0]?.trim() ?? '')
+    .find((cookie) => cookie.startsWith('locale='))
+  return pair ?? null
+}
+
+describe('locale detection', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('defaults to English', async () => {
+    const i18n = await i18nOf(await http.get('/').assertOk())
+    expect(i18n.locale).toBe('en')
+    expect(i18n.messages.en?.nav).toMatchObject({ posts: 'Posts' })
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    const plain = await i18nOf(await http.withHeader('Accept-Language', 'ja').get('/').assertOk())
+    expect(plain.locale).toBe('ja')
+
+    const weighted = await i18nOf(
+      await http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8').get('/').assertOk(),
+    )
+    expect(weighted.locale).toBe('ja')
+    expect(weighted.messages.ja?.nav).toMatchObject({ posts: '記事' })
+  })
+
+  it('lets a remembered pick win over the browser', async () => {
+    const i18n = await i18nOf(
+      await http
+        .withHeaders({ 'Accept-Language': 'ja', Cookie: 'locale=en' })
+        .get('/')
+        .assertOk(),
+    )
+    expect(i18n.locale).toBe('en')
+  })
+})
+
+describe('POST /locale', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf()
+  })
+
+  it('remembers the pick and sends the reader back to the Referer', async () => {
+    const response = await http
+      .withHeader('Referer', 'http://localhost/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts')
+
+    const cookie = localeCookie(response)
+    expect(cookie).toBe('locale=ja')
+
+    const i18n = await i18nOf(await http.withHeader('Cookie', cookie!).get('/').assertOk())
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja).toMatchObject({
+      nav: { home: 'ホーム', posts: '記事', dashboard: 'ダッシュボード' },
+      posts: { new: '新規投稿', edit: '編集', delete: '削除', search: '検索' },
+      auth: { login: 'ログイン', logout: 'ログアウト' },
+    })
+  })
+
+  it('switches back to English the same way', async () => {
+    const response = await http
+      .withHeader('Referer', 'http://localhost/posts/1')
+      .post('/locale', { locale: 'en' })
+      .assertRedirect('http://localhost/posts/1')
+    expect(localeCookie(response)).toBe('locale=en')
+  })
+
+  it('falls back to the home page without a Referer', async () => {
+    await http.post('/locale', { locale: 'ja' }).assertRedirect('/')
+  })
+
+  it('does not follow a Referer off the site', async () => {
+    await http
+      .withHeader('Referer', 'https://evil.example/phish')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('rejects a language the app does not serve', async () => {
+    const response = await http.post('/locale', { locale: 'fr' }).assertStatus(422)
+    expect(localeCookie(response)).toBeNull()
+  })
+
+  it('rejects a missing locale', async () => {
+    const response = await http.post('/locale', {}).assertStatus(422)
+    expect(localeCookie(response)).toBeNull()
+  })
+})
diff --git a/tests/translations.test.ts b/tests/translations.test.ts
new file mode 100644
index 0000000..c452064
--- /dev/null
+++ b/tests/translations.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'bun:test'
+import { readdir } from 'node:fs/promises'
+import { join } from 'node:path'
+import { supportedLocales } from '../config/i18n.js'
+
+const langDir = new URL('../lang', import.meta.url).pathname
+
+// Flattens lang/<locale>/*.json the way the JsonLoader and `guren check --i18n`
+// read it: the file name is the namespace, nested objects join with dots.
+async function catalogKeys(locale: string): Promise<Map<string, string>> {
+  const entries = new Map<string, string>()
+  const walk = (value: unknown, prefix: string) => {
+    if (typeof value === 'string') {
+      entries.set(prefix, value)
+      return
+    }
+    for (const [key, nested] of Object.entries(value as Record<string, unknown>)) {
+      walk(nested, `${prefix}.${key}`)
+    }
+  }
+  for (const file of await readdir(join(langDir, locale))) {
+    if (!file.endsWith('.json')) continue
+    const parsed = await Bun.file(join(langDir, locale, file)).json()
+    walk(parsed, file.slice(0, -'.json'.length))
+  }
+  return entries
+}
+
+describe('translation catalogs', () => {
+  it('ship every supported locale', async () => {
+    const present = (await readdir(langDir, { withFileTypes: true }))
+      .filter((entry) => entry.isDirectory())
+      .map((entry) => entry.name)
+      .sort()
+    expect(present).toEqual([...supportedLocales].sort())
+  })
+
+  it('keep the same keys in every locale', async () => {
+    const [reference, ...others] = await Promise.all(supportedLocales.map((locale) => catalogKeys(locale)))
+    const referenceKeys = [...reference!.keys()].sort()
+    expect(referenceKeys.length).toBeGreaterThan(0)
+    for (const other of others) {
+      expect([...other.keys()].sort()).toEqual(referenceKeys)
+    }
+  })
+
+  it('carry the labels the pages read, in both languages', async () => {
+    const en = await catalogKeys('en')
+    const ja = await catalogKeys('ja')
+    const expected: Record<string, string> = {
+      'nav.home': 'ホーム',
+      'nav.posts': '記事',
+      'nav.dashboard': 'ダッシュボード',
+      'posts.new': '新規投稿',
+      'posts.edit': '編集',
+      'posts.delete': '削除',
+      'posts.search': '検索',
+      'auth.login': 'ログイン',
+      'auth.logout': 'ログアウト',
+      'messages.welcome': ':nameへようこそ！',
+    }
+    for (const [key, japanese] of Object.entries(expected)) {
+      expect(ja.get(key)).toBe(japanese)
+      expect(en.get(key)).toBeString()
+      expect(en.get(key)).not.toBe(japanese)
+    }
+  })
+})
