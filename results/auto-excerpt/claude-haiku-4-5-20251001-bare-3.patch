@@ -0,0 +1,83 @@
+import { describe, it } from 'bun:test'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+describe('PostPayloadSchema', () => {
+  it('accepts a complete post with excerpt', async () => {
+    const data = {
+      title: 'My Post',
+      excerpt: 'This is an excerpt',
+      body: 'This is the body',
+    }
+    const result = PostPayloadSchema.parse(data)
+    if (result.excerpt === 'This is an excerpt') {
+      console.log('✓ Accepts post with excerpt')
+    }
+  })
+
+  it('accepts a post without excerpt', async () => {
+    const data = {
+      title: 'My Post',
+      excerpt: '',
+      body: 'This is the body',
+    }
+    const result = PostPayloadSchema.parse(data)
+    if (result.excerpt === '') {
+      console.log('✓ Accepts post with empty excerpt')
+    }
+  })
+
+  it('accepts a post with undefined excerpt', async () => {
+    const data = {
+      title: 'My Post',
+      body: 'This is the body',
+    }
+    const result = PostPayloadSchema.parse(data)
+    if (result.excerpt === '') {
+      console.log('✓ Accepts post with undefined excerpt, transforms to empty string')
+    }
+  })
+
+  it('rejects a post without title', async () => {
+    const data = {
+      title: '',
+      excerpt: 'An excerpt',
+      body: 'This is the body',
+    }
+    try {
+      PostPayloadSchema.parse(data)
+      console.log('✗ Should reject empty title')
+    } catch (error: any) {
+      if (error.errors && error.errors[0]?.message?.includes('Title is required')) {
+        console.log('✓ Rejects empty title')
+      }
+    }
+  })
+
+  it('rejects a post without body', async () => {
+    const data = {
+      title: 'My Post',
+      excerpt: 'An excerpt',
+      body: '',
+    }
+    try {
+      PostPayloadSchema.parse(data)
+      console.log('✗ Should reject empty body')
+    } catch (error: any) {
+      if (error.errors && error.errors[0]?.message?.includes('Body is required')) {
+        console.log('✓ Rejects empty body')
+      }
+    }
+  })
+
+  it('trims whitespace from title, excerpt, and body', async () => {
+    const data = {
+      title: '  My Post  ',
+      excerpt: '  An excerpt  ',
+      body: '  This is the body  ',
+    }
+    const result = PostPayloadSchema.parse(data)
+    if (result.title === 'My Post' && result.excerpt === 'An excerpt' && result.body === 'This is the body') {
+      console.log('✓ Trims whitespace from all fields')
+    }
+  })
+})
