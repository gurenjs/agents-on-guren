index 0000000..07221d3
--- /dev/null
+++ b/config/health.ts
@@ -0,0 +1,43 @@
+import { DatabaseCheck, createHealthManager, type DatabaseConnection, type HealthManager } from '@guren/core'
+import { sql } from 'drizzle-orm'
+import { getDatabase } from './database.js'
+
+/** A probe that hangs is as bad as one that throws — fail it instead of holding the request open. */
+const CHECK_TIMEOUT_MS = 3000
+
+/**
+ * `DatabaseCheck` wants a minimal `{ query(sql) }` connection while
+ * `getDatabase()` hands back the raw Drizzle handle, so bridge the two here.
+ * The handle is resolved on every call rather than captured once, so a
+ * connection that cannot be opened at all fails the check too — the whole
+ * point of the probe is that it never reports from a cached flag.
+ */
+const databaseConnection: DatabaseConnection = {
+  async query(statement: string): Promise<unknown> {
+    const db = (await getDatabase()) as { get(query: unknown): unknown }
+    return await db.get(sql.raw(statement))
+  },
+}
+
+/**
+ * The checks behind `GET /health`. `critical: true` makes a database failure
+ * turn the whole report unhealthy, which the endpoint answers with a 503 so
+ * the load balancer drains the instance instead of keeping a broken deploy in
+ * rotation. Pass a connection to exercise the failure path in tests.
+ */
+export function createAppHealthManager(
+  connection: DatabaseConnection = databaseConnection,
+  timeout: number = CHECK_TIMEOUT_MS,
+): HealthManager {
+  return createHealthManager().register(new DatabaseCheck(connection, { name: 'database' }), {
+    critical: true,
+    timeout,
+  })
+}
+
+const manager = createAppHealthManager()
+
+/** The application-wide manager — registering checks does not touch the database. */
+export function healthManager(): HealthManager {
+  return manager
+}
