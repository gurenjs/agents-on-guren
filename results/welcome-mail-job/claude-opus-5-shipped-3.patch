@@ -0,0 +1,36 @@
+import { createMailManager, type MailAddress, type MailManager } from '@guren/core'
+
+/**
+ * Which transport `MAIL_MAILER` selects:
+ *
+ * - `log` (development default) writes the whole message to the server output
+ *   instead of delivering it.
+ * - `memory` keeps messages in memory for inspection — what tests read back.
+ * - `resend` is the production transport, driven by `RESEND_API_KEY`.
+ *
+ * Transports are resolved lazily, so a missing API key only matters once
+ * `MAIL_MAILER=resend` actually selects it.
+ */
+function resolveMailer(): string {
+  return process.env.MAIL_MAILER?.trim() || 'log'
+}
+
+/** Sender every message goes out as, from `MAIL_FROM_ADDRESS` / `MAIL_FROM_NAME`. */
+function resolveFromAddress(): MailAddress {
+  return {
+    email: process.env.MAIL_FROM_ADDRESS?.trim() || 'hello@example.com',
+    name: process.env.MAIL_FROM_NAME?.trim() || undefined,
+  }
+}
+
+export function createAppMailManager(): MailManager {
+  return createMailManager({
+    default: resolveMailer(),
+    from: resolveFromAddress(),
+    transports: {
+      log: { driver: 'log' },
+      memory: { driver: 'memory' },
+      resend: { driver: 'resend', apiKey: process.env.RESEND_API_KEY ?? '' },
+    },
+  })
+}
diff --git a/config/queue.ts b/config/queue.ts
