+  private getPostIdsWithTag(tagId: number): number[] {
+    const databaseUrl = process.env.DATABASE_URL || './data/guren.db'
+    const db = new Database(databaseUrl)
+    try {
+      const rows = db.prepare(`
+        SELECT DISTINCT post_id
+        FROM post_tags
+        WHERE tag_id = ?
+        ORDER BY post_id DESC
+      `).all(tagId) as Array<{ post_id: number }>
+      return rows.map((r) => r.post_id)
+    } finally {
+      db.close()
+    }
+  }
+
+  private async getPostTags(postId: number): Promise<Array<{ name: string }>> {
+    const databaseUrl = process.env.DATABASE_URL || './data/guren.db'
+    const db = new Database(databaseUrl)
+    try {
+      const tags = db.prepare(`
+        SELECT DISTINCT tags.name
+        FROM post_tags
+        JOIN tags ON post_tags.tag_id = tags.id
+        WHERE post_tags.post_id = ?
+        ORDER BY tags.name ASC
+      `).all(postId) as Array<{ name: string }>
+      return tags
+    } finally {
+      db.close()
+    }
+  }
+
+  private async detachAllTags(postId: number): Promise<void> {
+    const databaseUrl = process.env.DATABASE_URL || './data/guren.db'
+    const db = new Database(databaseUrl)
+    try {
+      db.prepare('DELETE FROM post_tags WHERE post_id = ?').run(postId)
+    } finally {
+      db.close()
+    }
+  }
+
+  private async attachTags(postId: number, tagNames: string[]): Promise<void> {
+    const databaseUrl = process.env.DATABASE_URL || './data/guren.db'
+    const db = new Database(databaseUrl)
+    try {
+      const insertTag = db.prepare('INSERT OR IGNORE INTO tags (name) VALUES (?)')
+      const getTagId = db.prepare('SELECT id FROM tags WHERE name = ?')
+      const insertPostTag = db.prepare('INSERT INTO post_tags (post_id, tag_id) VALUES (?, ?)')
+
+      for (const name of tagNames) {
+        insertTag.run(name)
+        const tag = getTagId.get(name) as { id: number } | undefined
+        if (tag) {
+          insertPostTag.run(postId, tag.id)
+        }
+      }
+    } finally {
+      db.close()
+    }
+  }
