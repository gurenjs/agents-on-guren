@@ -0,0 +1,37 @@
+import { describe, expect, it } from 'bun:test'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+describe('PostPayloadSchema', () => {
+  it('accepts a payload with a missing excerpt', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', body: 'World' })
+    expect(result.success).toBe(true)
+  })
+
+  it('accepts a payload with an empty excerpt', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '', body: 'World' })
+    expect(result.success).toBe(true)
+    if (result.success) expect(result.data.excerpt).toBe('')
+  })
+
+  it('accepts a payload with a whitespace-only excerpt, trimmed to empty', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '   \t  ', body: 'World' })
+    expect(result.success).toBe(true)
+    if (result.success) expect(result.data.excerpt).toBe('')
+  })
+
+  it('trims and keeps a provided excerpt', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: '  A teaser.  ', body: 'World' })
+    expect(result.success).toBe(true)
+    if (result.success) expect(result.data.excerpt).toBe('A teaser.')
+  })
+
+  it('still rejects a blank title', () => {
+    const result = PostPayloadSchema.safeParse({ title: '  ', excerpt: 'x', body: 'World' })
+    expect(result.success).toBe(false)
+  })
+
+  it('still rejects a blank body', () => {
+    const result = PostPayloadSchema.safeParse({ title: 'Hello', excerpt: 'x', body: '   ' })
+    expect(result.success).toBe(false)
+  })
+})
diff --git a/tests/excerpt.test.ts b/tests/excerpt.test.ts
new file mode 100644
index 0000000..a3af076
--- /dev/null
+++ b/tests/excerpt.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'bun:test'
+import { deriveExcerpt } from '../app/Support/excerpt.js'
+
+describe('deriveExcerpt', () => {
+  it('returns the whole body unchanged when it is 140 characters or fewer', () => {
+    expect(deriveExcerpt('Short body.')).toBe('Short body.')
+    expect(deriveExcerpt('a'.repeat(140))).toBe('a'.repeat(140))
+  })
+
+  it('trims leading and trailing whitespace before measuring length', () => {
+    expect(deriveExcerpt('  Short body.  ')).toBe('Short body.')
+  })
+
+  it('backs up to the last whitespace when the 140th character cuts a word in half', () => {
+    const sentence = 'The quick brown fox jumps over the lazy dog. '
+    const body = sentence.repeat(3) + 'The quick brown'
+    expect(body.length).toBe(150)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The…',
+    )
+    expect(excerpt.length).toBe(139)
+  })
+
+  it('keeps all 140 characters when the cut lands exactly on a word boundary', () => {
+    const body =
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right at a space, then adds a mark.'
+    expect(body.length).toBe(170)
+
+    const excerpt = deriveExcerpt(body)
+    expect(excerpt).toBe(
+      'When a post is saved without an excerpt, the site now writes one for the author by keeping the opening of the body intact and stopping right…',
+    )
+    expect(excerpt.length).toBe(141)
+  })
+
+  it('cuts at 140 when the first 140 characters contain no whitespace at all', () => {
+    const body = 'a'.repeat(160)
+    expect(deriveExcerpt(body)).toBe('a'.repeat(140) + '…')
+  })
+
+  it('never leaves the stored excerpt empty', () => {
+    expect(deriveExcerpt('x'.repeat(200)).length).toBeGreaterThan(0)
+  })
+})
