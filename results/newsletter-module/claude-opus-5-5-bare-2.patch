+++ b/modules/newsletter/app/Http/Controllers/NewsletterSubscriptionController.ts
@@ -0,0 +1,59 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, NotFoundHttpException, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from '../../Models/NewsletterSubscription.js'
+import { NewsletterEmailSchema, NewsletterTokenParamSchema } from '../Validators/NewsletterSubscriptionValidator.js'
+
+export default class NewsletterSubscriptionController extends Controller {
+  async store(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // forceCreate, because `token` is deliberately absent from fillable: the
+    // server issues it, and a request must never be able to choose it.
+    await NewsletterSubscription.forceCreate({ email, token: randomBytes(32).toString('hex') })
+
+    return this.redirect(this.previousPath())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(NewsletterTokenParamSchema)
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException()
+    }
+
+    if (!subscription.confirmedAt) {
+      await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+    }
+
+    return this.redirect('/')
+  }
+
+  async destroy(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.previousPath())
+  }
+
+  // The page named by Referer when it belongs to this site, otherwise home.
+  // Only the path is kept, so a forged Referer cannot redirect off-site.
+  private previousPath(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+
+    try {
+      const current = new URL(this.request.url)
+      const previous = new URL(referer, current)
+      const host = this.request.header('host') ?? current.host
+      if (previous.host !== host && previous.host !== current.host) return '/'
+      return `${previous.pathname}${previous.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
