diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..10e3c40
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,27 @@
+import { Controller } from '@guren/core'
+import { z } from 'zod'
+
+const SetLocaleSchema = z.object({
+  locale: z.enum(['en', 'ja']),
+})
+
+export default class LocaleController extends Controller {
+  async store(): Promise<Response> {
+    const { locale } = await this.validateBody(SetLocaleSchema)
+
+    const referer = this.request.header('referer') ?? '/'
+    const url = new URL(referer)
+
+    const response = this.redirect(url.pathname + url.search)
+
+    // Set the locale cookie for 1 year
+    const expires = new Date()
+    expires.setFullYear(expires.getFullYear() + 1)
+    response.headers.append(
+      'Set-Cookie',
+      `locale=${encodeURIComponent(locale)}; Path=/; Max-Age=${60 * 60 * 24 * 365}; Expires=${expires.toUTCString()}`,
+    )
+
+    return response
+  }
+}
diff --git a/app/Providers/I18nProvider.ts b/app/Providers/I18nProvider.ts
new file mode 100644
index 0000000..c9a1990
--- /dev/null
+++ b/app/Providers/I18nProvider.ts
@@ -0,0 +1,20 @@
+import { ServiceProvider, shareInertiaProps, type Context } from '@guren/core'
+
+export default class I18nProvider extends ServiceProvider {
+  register(): void {
+    // No-op
+  }
+
+  boot(): void {
+    shareInertiaProps(async (ctx: Context) => {
+      const i18n = ctx.get('i18n')
+      const messages = i18n.getMessages()
+      return {
+        _i18n: {
+          locale: i18n.getLocale(),
+          ...messages,
+        },
+      }
+    }, this.container)
+  }
+}
