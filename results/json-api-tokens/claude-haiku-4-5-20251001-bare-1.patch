@@ -0,0 +1,80 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { ApiToken, type ApiTokenRecord } from '../../Models/ApiToken.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { ApiPostPayloadSchema } from '../Validators/ApiTokenValidator.js'
+import { RateLimiter } from '../../Services/RateLimiter.js'
+import { TokenService } from '../../Services/TokenService.js'
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const token = await this.getAuthenticatedToken()
+    if (!token) {
+      return this.json({ errors: { message: 'Unauthenticated' } }, { status: 401 })
+    }
+
+    const rateLimitResult = RateLimiter.checkRateLimit(`token:${token.id}`)
+    if (!rateLimitResult.allowed) {
+      return new Response(
+        JSON.stringify({ errors: { message: 'Too many requests' } }),
+        {
+          status: 429,
+          headers: {
+            'Content-Type': 'application/json',
+            'Retry-After': String(rateLimitResult.retryAfter),
+          },
+        }
+      )
+    }
+
+    const posts = await Post.newQuery()
+      .with('author')
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.json({ data: PostResource.collection(posts) })
+  }
+
+  async store(): Promise<Response> {
+    const token = await this.getAuthenticatedToken()
+    if (!token) {
+      return this.json({ errors: { message: 'Unauthenticated' } }, { status: 401 })
+    }
+
+    const rateLimitResult = RateLimiter.checkRateLimit(`token:${token.id}`)
+    if (!rateLimitResult.allowed) {
+      return new Response(
+        JSON.stringify({ errors: { message: 'Too many requests' } }),
+        {
+          status: 429,
+          headers: {
+            'Content-Type': 'application/json',
+            'Retry-After': String(rateLimitResult.retryAfter),
+          },
+        }
+      )
+    }
+
+    const data = await this.validateBody(ApiPostPayloadSchema)
+
+    const post = await Post.forceCreate({
+      ...data,
+      authorId: token.userId,
+    })
+
+    return this.json({ data: new PostResource(post).toJSON() }, { status: 201 })
+  }
+
+  private async getAuthenticatedToken(): Promise<ApiTokenRecord | null> {
+    const authHeader = this.request.header('authorization')
+    if (!authHeader?.startsWith('Bearer ')) {
+      return null
+    }
+
+    const bearerToken = authHeader.slice(7)
+    const tokenHash = TokenService.hashToken(bearerToken)
+
+    const apiToken = await ApiToken.where({ tokenHash }).first()
+    return apiToken ?? null
+  }
+}
