--- /dev/null
+++ b/app/Http/Support/safeRedirectPath.ts
@@ -0,0 +1,33 @@
+const TAB_OR_NEWLINE = /[\t\n\r]/g
+
+/**
+ * Resolve a user-supplied redirect value into a same-app path, or fall back
+ * to `fallback` for anything that could send the browser to another origin.
+ *
+ * Browsers strip tabs/newlines and treat backslashes like forward slashes
+ * when parsing a URL, so `/\evil.example` and `/\n/evil.example` behave the
+ * same as `//evil.example`. Normalizing before the same-origin check closes
+ * those bypasses; without it a value that "looks" like a path can still
+ * resolve to a protocol-relative URL once the browser parses it.
+ */
+export function safeRedirectPath(value: string | null | undefined, fallback: string): string {
+  if (!value) return fallback
+
+  const normalized = value
+    .replace(TAB_OR_NEWLINE, '')
+    .trim()
+    .replace(/\\/g, '/')
+
+  if (!normalized.startsWith('/') || normalized.startsWith('//')) {
+    return fallback
+  }
+
+  try {
+    // A same-app path never parses as a standalone absolute URL. If it
+    // does, it smuggled a scheme in and must be rejected.
+    new URL(normalized)
+    return fallback
+  } catch {
+    return value
+  }
+}
