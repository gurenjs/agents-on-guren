+
+      await csrf1.post(`/comments/${comment.id}/report`)
+      await csrf2.post(`/comments/${comment.id}/report`)
+      await csrf3.post(`/comments/${comment.id}/report`)
+
+      const response = await http.json().get(`/posts/${post.id}`)
