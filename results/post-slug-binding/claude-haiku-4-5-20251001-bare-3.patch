diff --git a/tests/PostSlug.test.ts b/tests/PostSlug.test.ts
new file mode 100644
index 0000000..00d80e8
--- /dev/null
+++ b/tests/PostSlug.test.ts
@@ -0,0 +1,53 @@
+import { describe, it } from 'bun:test'
+import { generateSlug, getUniqueSlug } from '../app/Helpers/slug.js'
+
+describe('Slug Generation', () => {
+  it('generates slugs from simple titles', () => {
+    if (generateSlug('Hello World') !== 'hello-world') {
+      throw new Error('Failed to generate slug from "Hello World"')
+    }
+  })
+
+  it('handles titles with special characters', () => {
+    const slug = generateSlug('Hello, World! & Friends: 2026 Edition')
+    if (slug !== 'hello-world-friends-2026-edition') {
+      throw new Error(`Expected 'hello-world-friends-2026-edition', got '${slug}'`)
+    }
+  })
+
+  it('trims whitespace and handles multiple spaces', () => {
+    const slug = generateSlug('  Guren  &  Bun: 2026 Edition!  ')
+    if (slug !== 'guren-bun-2026-edition') {
+      throw new Error(`Expected 'guren-bun-2026-edition', got '${slug}'`)
+    }
+  })
+
+  it('removes consecutive dashes', () => {
+    const slug = generateSlug('Test---Post')
+    if (slug !== 'test-post') {
+      throw new Error(`Expected 'test-post', got '${slug}'`)
+    }
+  })
+
+  it('handles numbers in titles', () => {
+    const slug = generateSlug('2024 Year in Review')
+    if (slug !== '2024-year-in-review') {
+      throw new Error(`Expected '2024-year-in-review', got '${slug}'`)
+    }
+  })
+
+  it('generates unique slugs with numbering', async () => {
+    const slugs = new Set<string>()
+
+    const slug1 = await getUniqueSlug('test', async (s) => slugs.has(s))
+    if (slug1 !== 'test') throw new Error(`Expected 'test', got '${slug1}'`)
+    slugs.add(slug1)
+
+    const slug2 = await getUniqueSlug('test', async (s) => slugs.has(s))
+    if (slug2 !== 'test-2') throw new Error(`Expected 'test-2', got '${slug2}'`)
+    slugs.add(slug2)
+
+    const slug3 = await getUniqueSlug('test', async (s) => slugs.has(s))
+    if (slug3 !== 'test-3') throw new Error(`Expected 'test-3', got '${slug3}'`)
+  })
+})
