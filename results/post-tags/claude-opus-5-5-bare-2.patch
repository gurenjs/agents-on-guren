@@ -10,9 +12,44 @@ export class Post extends defineModel(posts, {
   // `authorId` is set from the signed-in user, never from request input.
   fillable: ['title', 'excerpt', 'body'],
 }) {
-  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    tags: BelongsToManyRecord<TagRecord>
+  } = {
     author: null,
+    tags: [],
+  }
+
+  /**
+   * Makes `names` exactly the post's tags: unseen names become new tags, and
+   * tags missing from the list are detached. Tags left unused are kept.
+   */
+  static async syncTags(postId: number, names: readonly string[], options: { trx?: TransactionHandle } = {}): Promise<void> {
+    const existing = names.length > 0 ? await Tag.newQuery(options).whereIn('name', [...names]).get() : []
+    const idsByName = new Map(existing.map((tag) => [tag.name, tag.id]))
+
+    for (const name of names) {
+      if (!idsByName.has(name)) {
+        const tag = await Tag.create({ name }, options)
+        idsByName.set(name, tag.id)
+      }
+    }
+
+    await PostTag.delete({ postId }, options)
+    for (const tagId of idsByName.values()) {
+      await PostTag.create({ postId, tagId }, options)
+    }
+  }
+
+  /** Ids of the posts carrying the tag named `name`; `[]` for an unknown tag. */
+  static async idsTaggedWith(name: string): Promise<number[]> {
+    const tag = await Tag.first({ name })
+    if (!tag) return []
+
+    const rows = await PostTag.where({ tagId: tag.id }).get()
+    return rows.map((row) => row.postId)
   }
 }
 
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')
+Post.belongsToMany('tags', Tag, postTags, 'postId', 'tagId', 'id', 'id')
