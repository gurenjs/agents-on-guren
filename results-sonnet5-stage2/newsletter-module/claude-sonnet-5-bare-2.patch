+++ b/modules/newsletter/routes.ts
@@ -0,0 +1,10 @@
+import type { Router } from '@guren/core'
+import NewsletterController from './NewsletterController.js'
+import { EmailSchema } from './validators.js'
+
+// The module's `/newsletter` prefix is applied by defineModule.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post('/subscribe', { name: 'newsletter.subscribe', body: EmailSchema }, [NewsletterController, 'subscribe'])
+  router.get('/confirm/:token', [NewsletterController, 'confirm']).name('newsletter.confirm')
+  router.post('/unsubscribe', { name: 'newsletter.unsubscribe', body: EmailSchema }, [NewsletterController, 'unsubscribe'])
+}
