diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..4677c21
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,23 @@
+import { Job } from '@guren/core'
+import { WelcomeEmailMail } from '../Mail/WelcomeEmailMail.js'
+
+export interface SendWelcomeEmailJobPayload {
+  name: string
+  email: string
+}
+
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailJobPayload> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle(payload: SendWelcomeEmailJobPayload): Promise<void> {
+    const mailManager = this.make('mail')
+    const mail = new WelcomeEmailMail(mailManager, payload)
+    await mail.send()
+  }
+
+  async failed(payload: SendWelcomeEmailJobPayload, error: Error): Promise<void> {
+    void payload
+    console.error('SendWelcomeEmailJob failed:', error.message)
+  }
+}
diff --git a/app/Mail/WelcomeEmailMail.ts b/app/Mail/WelcomeEmailMail.ts
new file mode 100644
index 0000000..60782ad
--- /dev/null
+++ b/app/Mail/WelcomeEmailMail.ts
@@ -0,0 +1,27 @@
+import { Mail, type MailManager } from '@guren/core'
+
+export interface WelcomeEmailData {
+  name: string
+  email: string
+}
+
+export class WelcomeEmailMail extends Mail {
+  constructor(
+    manager: MailManager,
+    public readonly data: WelcomeEmailData = {} as WelcomeEmailData,
+  ) {
+    super(manager)
+  }
+
+  build(): this {
+    const appName = process.env.APP_NAME || 'Guren'
+    const fromAddress = process.env.MAIL_FROM_ADDRESS || 'hello@example.com'
+    const fromName = process.env.MAIL_FROM_NAME || appName
+
+    return this
+      .to(this.data.email)
+      .from({ email: fromAddress, name: fromName })
+      .subject(`Welcome to ${appName}, ${this.data.name}!`)
+      .text(`Hello ${this.data.name},\n\nWelcome to ${appName}! We're excited to have you on board.\n\nBest regards,\n${appName}`)
+  }
+}
