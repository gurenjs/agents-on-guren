+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createPost(title: string, createdAt: string) {
+    const author = await User.forceCreate({
+      name: 'Author',
+      email: `${crypto.randomUUID()}@example.com`,
+      password: 'password',
+    })
+    return Post.forceCreate({
+      title,
+      excerpt: 'excerpt',
+      body: 'body',
+      authorId: author!.id,
+      createdAt,
+    })
+  }
+
+  it('lists posts created in a given month, zero-padded', async () => {
+    await createPost('August old', '2026-08-01T00:00:00.000Z')
+    await createPost('August new', '2026-08-15T00:00:00.000Z')
+    await createPost('July', '2026-07-31T23:59:59.000Z')
+    await createPost('Next year', '2027-08-01T00:00:00.000Z')
+
+    await http
+      .get('/posts/archive/2026/08')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'August new')
+      .assertJsonPath('data.1.title', 'August old')
+  })
+
+  it('lists posts created in a given month, no leading zero', async () => {
+    await createPost('August old', '2026-08-01T00:00:00.000Z')
+    await createPost('July', '2026-07-01T00:00:00.000Z')
+
+    await http.get('/posts/archive/2026/8').assertOk().assertJsonCount(1, 'data')
+  })
+
+  it('lists every post created in a given year', async () => {
+    await createPost('January', '2026-01-01T00:00:00.000Z')
+    await createPost('December', '2026-12-31T00:00:00.000Z')
+    await createPost('Other year', '2027-01-01T00:00:00.000Z')
+
+    await http.get('/posts/archive/2026').assertOk().assertJsonCount(2, 'data')
+  })
+
+  it('returns an empty list for a period with no posts', async () => {
+    await http.get('/posts/archive/1999').assertOk()
+    const res = await http.get('/posts/archive/1999')
+    await res.assertJson({ data: [] })
+  })
+
+  it('rejects a month outside 1-12', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+    await http.get('/posts/archive/2026/00').assertStatus(422)
+  })
+})
