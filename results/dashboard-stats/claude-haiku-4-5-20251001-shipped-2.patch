diff --git a/tests/DashboardController.test.ts b/tests/DashboardController.test.ts
new file mode 100644
index 0000000..7e756fa
--- /dev/null
+++ b/tests/DashboardController.test.ts
@@ -0,0 +1,156 @@
+import { beforeAll, beforeEach, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+function extractInertiaProps(html: string): any {
+  const match = html.match(/window\.__INERTIA_PAGE__\s*=\s*({.*?});</s)
+  if (!match) {
+    throw new Error('Could not extract Inertia props from HTML')
+  }
+  const pageData = JSON.parse(match[1])
+  return pageData.props
+}
+
+describe('DashboardController', () => {
+  let http: TestApp
+  let testUser: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+
+    // Create a test user
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    // Create another user for isolation test
+    const otherUser = await User.create({
+      name: 'Other User',
+      email: 'other@example.com',
+      password: 'password123',
+    })
+
+    // Create some posts for test user (use forceCreate for authorId)
+    await Post.forceCreate({
+      title: 'First Post',
+      excerpt: 'First excerpt',
+      body: 'First body',
+      authorId: testUser.id,
+    })
+    await Post.forceCreate({
+      title: 'Second Post',
+      excerpt: 'Second excerpt',
+      body: 'Second body',
+      authorId: testUser.id,
+    })
+    await Post.forceCreate({
+      title: 'Third Post',
+      excerpt: 'Third excerpt',
+      body: 'Third body',
+      authorId: testUser.id,
+    })
+
+    // Create a post for the other user
+    await Post.forceCreate({
+      title: 'Other User Post',
+      excerpt: 'Other excerpt',
+      body: 'Other body',
+      authorId: otherUser.id,
+    })
+  })
+
+  it('shows post count for authenticated user', async () => {
+    const response = await http.actingAs(testUser).get('/dashboard')
+    response.assertOk()
+
+    const body = await response.text()
+    const props = extractInertiaProps(body)
+
+    expect(props.postCount).toBe(3)
+    expect(props.recentPosts).toHaveLength(3)
+    expect(props.user.id).toBe(testUser.id)
+  })
+
+  it('includes recent posts in the correct order', async () => {
+    const response = await http.actingAs(testUser).get('/dashboard')
+    response.assertOk()
+
+    const body = await response.text()
+    const props = extractInertiaProps(body)
+
+    // The recentPosts should be ordered newest first by createdAt
+    expect(props.recentPosts.length).toBe(3)
+    // All posts should be present
+    const titles = props.recentPosts.map((p: any) => p.title)
+    expect(titles).toContain('First Post')
+    expect(titles).toContain('Second Post')
+    expect(titles).toContain('Third Post')
+  })
+
+  it('only shows posts by the current user', async () => {
+    const response = await http.actingAs(testUser).get('/dashboard')
+    response.assertOk()
+
+    const body = await response.text()
+    const props = extractInertiaProps(body)
+
+    const titles = props.recentPosts.map((p: any) => p.title)
+    expect(titles).toContain('First Post')
+    expect(titles).toContain('Second Post')
+    expect(titles).toContain('Third Post')
+    // Verify other user's post is not included
+    expect(titles).not.toContain('Other User Post')
+  })
+
+  it('shows empty state for user with no posts', async () => {
+    const emptyUser = await User.create({
+      name: 'Empty User',
+      email: 'empty@example.com',
+      password: 'password123',
+    })
+
+    const response = await http.actingAs(emptyUser).get('/dashboard')
+    response.assertOk()
+
+    const body = await response.text()
+    const props = extractInertiaProps(body)
+
+    expect(props.postCount).toBe(0)
+    expect(props.recentPosts).toHaveLength(0)
+  })
+
+  it('limits recent posts to 5', async () => {
+    // Create 3 more posts for a total of 6
+    for (let i = 4; i <= 6; i++) {
+      await Post.forceCreate({
+        title: `Post ${i}`,
+        excerpt: `Excerpt ${i}`,
+        body: `Body ${i}`,
+        authorId: testUser.id,
+      })
+    }
+
+    const response = await http.actingAs(testUser).get('/dashboard')
+    response.assertOk()
+
+    const body = await response.text()
+    const props = extractInertiaProps(body)
+
+    expect(props.postCount).toBe(6)
+    // Only 5 posts should be in the recent posts list
+    expect(props.recentPosts).toHaveLength(5)
+  })
+
+  it('redirects unauthenticated user to login', async () => {
+    await http.get('/dashboard').assertRedirect('/login')
+  })
+})
