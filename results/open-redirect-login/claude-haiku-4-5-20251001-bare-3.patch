diff --git a/app/Http/Utils/RedirectValidator.ts b/app/Http/Utils/RedirectValidator.ts
new file mode 100644
index 0000000..f88c21c
--- /dev/null
+++ b/app/Http/Utils/RedirectValidator.ts
@@ -0,0 +1,27 @@
+export function isSafeRedirect(url: string): boolean {
+  if (!url) {
+    return true
+  }
+
+  // Block absolute URLs with schemes (e.g., https://evil.example)
+  if (/^[a-z][a-z0-9+.-]*:/i.test(url)) {
+    return false
+  }
+
+  // Block protocol-relative URLs (e.g., //evil.example)
+  if (url.startsWith('//')) {
+    return false
+  }
+
+  // Block backslash variants (e.g., /\evil.example)
+  if (url.includes('\\')) {
+    return false
+  }
+
+  // Only allow absolute paths (starting with /)
+  if (!url.startsWith('/')) {
+    return false
+  }
+
+  return true
+}
diff --git a/tests/RedirectValidator.test.ts b/tests/RedirectValidator.test.ts
