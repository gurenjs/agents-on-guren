diff --git a/tests/Mcp.test.ts b/tests/Mcp.test.ts
new file mode 100644
index 0000000..b53ff17
--- /dev/null
+++ b/tests/Mcp.test.ts
@@ -0,0 +1,63 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+
+async function rpc(token: string | null, method: string, params: Record<string, unknown> = {}) {
+  const headers: Record<string, string> = {
+    'content-type': 'application/json',
+    accept: 'application/json, text/event-stream',
+    host: 'localhost:3333',
+  }
+  if (token) headers.authorization = `Bearer ${token}`
+  return app.fetch(
+    new Request('http://localhost:3333/mcp', {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+    }),
+  )
+}
+
+// The endpoint answers as JSON or as a one-event SSE stream.
+async function parse(res: Response) {
+  const text = await res.text()
+  const data = text.split('\n').find((line) => line.startsWith('data:'))
+  return JSON.parse(data ? data.slice(5) : text)
+}
+
+describe('/mcp', () => {
+  let token: string
+
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    const user = await User.forceCreate({
+      name: 'Agent',
+      email: `agent-${crypto.randomUUID()}@example.com`,
+      password: 'secret-password',
+    })
+    const store = app.auth.getApiTokenStore()!
+    token = (await createApiToken(store, { name: 'test', userId: user.id as number, abilities: ['tools:*'] })).plainTextToken
+  })
+
+  it('refuses a call without a credential', async () => {
+    expect((await rpc(null, 'tools/list')).status).toBe(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
