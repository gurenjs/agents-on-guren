-  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+  static override relationTypes: {
+    author: BelongsToRecord<PostAuthorSummary>
+    revisions: HasManyRecord<PostRevisionRecord>
+  } = {
     author: null,
+    revisions: [],
+  }
+
+  /**
+   * Overwrites a post's content and keeps what it replaces as a revision.
+   * One transaction, so a failed save leaves no revision behind, and the
+   * revision holds the content as stored at the moment it was replaced.
+   */
+  static async revise(id: PostRecord['id'], content: PostContent): Promise<void> {
+    await this.transaction(async (trx, scope) => {
+      const current = await scope.findOrFail(id)
+      await PostRevision.inTransaction(trx).create({
+        postId: current.id,
+        title: current.title,
+        excerpt: current.excerpt,
+        body: current.body,
+      })
+      await scope.update({ id: current.id }, content)
+    })
+  }
+
+  /** SQLite enforces the cascade only with foreign keys on, so the history is deleted explicitly. */
+  static async deleteWithRevisions(id: PostRecord['id']): Promise<void> {
+    await this.transaction(async (trx, scope) => {
+      await PostRevision.inTransaction(trx).delete({ postId: id })
+      await scope.delete({ id })
+    })
   }
 }
 
