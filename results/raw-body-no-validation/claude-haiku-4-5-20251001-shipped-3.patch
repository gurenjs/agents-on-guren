diff --git a/tests/ProfileController.test.ts b/tests/ProfileController.test.ts
new file mode 100644
index 0000000..10c9580
--- /dev/null
+++ b/tests/ProfileController.test.ts
@@ -0,0 +1,257 @@
+import { beforeAll, describe, it, expect, afterEach } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+
+describe('ProfileController', () => {
+  let http: TestApp
+  let testUser: any
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  afterEach(async () => {
+    await resetDatabase()
+  })
+
+  it('edit renders profile page for authenticated user', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    await http.actingAs(testUser).get('/profile').assertOk()
+  })
+
+  it('update with valid data succeeds', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'newemail@example.com',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.name).toBe('Updated Name')
+    expect(updated?.email).toBe('newemail@example.com')
+  })
+
+  it('update rejects invalid email', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'not-an-email',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'Enter a valid email address.')
+
+    const unchanged = await User.find(testUser.id)
+    expect(unchanged?.email).toBe('test@example.com')
+  })
+
+  it('update rejects empty name', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: '',
+        email: 'test@example.com',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.name.0', 'Name is required.')
+
+    const unchanged = await User.find(testUser.id)
+    expect(unchanged?.name).toBe('Test User')
+  })
+
+  it('update lowercases email', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'NewEmail@EXAMPLE.COM',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.email).toBe('newemail@example.com')
+  })
+
+  it('update with password changes password', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'test@example.com',
+        password: 'newpassword123',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.name).toBe('Updated Name')
+  })
+
+  it('update rejects password shorter than 8 characters', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'test@example.com',
+        password: 'short',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.password.0', 'Password must be at least 8 characters.')
+
+    const unchanged = await User.find(testUser.id)
+    expect(unchanged?.name).toBe('Test User')
+  })
+
+  it('update ignores extra fields like id', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'newemail@example.com',
+        id: 99999,
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.id).toBe(testUser.id)
+    expect(updated?.name).toBe('Updated Name')
+    expect(updated?.email).toBe('newemail@example.com')
+  })
+
+  it('update ignores extra fields like passwordHash', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const originalHash = testUser.passwordHash
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'Updated Name',
+        email: 'test@example.com',
+        passwordHash: 'fake-hash-value',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.passwordHash).toBe(originalHash)
+    expect(updated?.name).toBe('Updated Name')
+  })
+
+  it('update rejects duplicate email', async () => {
+    const user1 = await User.create({
+      name: 'User One',
+      email: 'user1@example.com',
+      password: 'password123',
+    })
+    const user2 = await User.create({
+      name: 'User Two',
+      email: 'user2@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(user2).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: 'User Two',
+        email: 'user1@example.com',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'Email is already in use.')
+
+    const unchanged = await User.find(user2.id)
+    expect(unchanged?.email).toBe('user2@example.com')
+  })
+
+  it('update trims whitespace from name', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: '  Trimmed Name  ',
+        email: 'test@example.com',
+      })
+      .assertOk()
+
+    const updated = await User.find(testUser.id)
+    expect(updated?.name).toBe('Trimmed Name')
+  })
+
+  it('update rejects name longer than 120 characters', async () => {
+    testUser = await User.create({
+      name: 'Test User',
+      email: 'test@example.com',
+      password: 'password123',
+    })
+
+    const longName = 'a'.repeat(121)
+    const csrf = await http.actingAs(testUser).withCsrf()
+    await csrf
+      .put('/profile', {
+        name: longName,
+        email: 'test@example.com',
+      })
+      .assertUnprocessable()
+      .assertJsonPath('errors.name.0', 'Name must be 120 characters or fewer.')
+
+    const unchanged = await User.find(testUser.id)
+    expect(unchanged?.name).toBe('Test User')
+  })
+})
