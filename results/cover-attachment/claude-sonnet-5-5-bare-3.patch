diff --git a/app/Services/CoverStorage.ts b/app/Services/CoverStorage.ts
new file mode 100644
index 0000000..fc901d9
--- /dev/null
+++ b/app/Services/CoverStorage.ts
@@ -0,0 +1,70 @@
+import { mkdir, rm, unlink } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { join } from 'node:path'
+import { ValidationException } from '@guren/core'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+export const COVER_MAX_BYTES = 2 * 1024 * 1024
+export const COVER_ERROR = 'Cover must be a PNG or JPEG image of at most 2 MB.'
+
+const STORAGE_DIR = fileURLToPath(new URL('../../storage/covers/', import.meta.url))
+
+export interface CoverUpload {
+  file: File
+  bytes: Uint8Array
+  contentType: 'image/png' | 'image/jpeg'
+}
+
+function sniff(bytes: Uint8Array): CoverUpload['contentType'] | null {
+  const png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+  if (png.every((byte, i) => bytes[i] === byte)) return 'image/png'
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  return null
+}
+
+/** Checks the upload's size and actual content. Throws the same 422 an empty title does. */
+export async function readCover(file: File): Promise<CoverUpload> {
+  if (file.size > COVER_MAX_BYTES) throw new ValidationException({ cover: [COVER_ERROR] })
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  const contentType = sniff(bytes)
+  if (bytes.length > COVER_MAX_BYTES || contentType === null) {
+    throw new ValidationException({ cover: [COVER_ERROR] })
+  }
+  return { file, bytes, contentType }
+}
+
+export async function findCover(postId: number): Promise<AttachmentRecord | null> {
+  return Attachment.first({ postId })
+}
+
+export async function storeCover(postId: number, cover: CoverUpload): Promise<AttachmentRecord> {
+  await mkdir(STORAGE_DIR, { recursive: true })
+  const path = `${crypto.randomUUID()}.${cover.contentType === 'image/png' ? 'png' : 'jpg'}`
+  await Bun.write(join(STORAGE_DIR, path), cover.bytes)
+  try {
+    return await Attachment.forceCreate({
+      postId,
+      path,
+      filename: cover.file.name || path,
+      contentType: cover.contentType,
+      size: cover.bytes.length,
+    })
+  } catch (error) {
+    await unlink(join(STORAGE_DIR, path)).catch(() => {})
+    throw error
+  }
+}
+
+/** Deletes the row and the file. */
+export async function removeCover(attachment: AttachmentRecord): Promise<void> {
+  await Attachment.delete({ id: attachment.id })
+  await rm(join(STORAGE_DIR, attachment.path), { force: true })
+}
+
+export function coverFile(attachment: AttachmentRecord): Bun.BunFile {
+  return Bun.file(join(STORAGE_DIR, attachment.path))
+}
+
+export function coverUrl(attachment: AttachmentRecord | null | undefined): string | null {
+  return attachment ? `/attachments/${attachment.id}` : null
+}
