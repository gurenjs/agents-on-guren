@@ -0,0 +1,58 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase, migrateDatabase } from '../config/database.js'
+import { postTags, posts, tags, users } from '../db/schema.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let db: any
+  let user: any
+
+  const tagNames = async () => (await db.select().from(tags)).map((t: any) => t.name).sort()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    await migrateDatabase()
+    db = await getDatabase()
+    await db.delete(postTags)
+    await db.delete(posts)
+    await db.delete(tags)
+    await db.delete(users)
+    ;[user] = await db
+      .insert(users)
+      .values({ name: 'Author', email: 'tags@example.com', passwordHash: 'x' })
+      .returning()
+  })
+
+  const payload = (tagsField?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tagsField === undefined ? {} : { tags: tagsField }) })
+
+  it('creates, edits, filters and validates tags', async () => {
+    const author = await http.actingAs(user).withCsrf()
+    await author.post('/posts', payload(' bun ,bun, webdev,')).assertStatus(303)
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await db.select().from(postTags)).toHaveLength(2)
+    const [post] = await db.select().from(posts)
+
+    await author.put(`/posts/${post.id}`, payload('bun')).assertStatus(303)
+    expect(await db.select().from(postTags)).toHaveLength(1)
+
+    await author.post('/posts', payload()).assertStatus(303)
+    const inertia = author.withHeaders({ 'X-Inertia': 'true' })
+    const list = async (path: string) => (await (inertia.get(path) as any)).json().then((page: any) => page.props)
+    const filtered = await list('/posts?tag=bun')
+    expect(filtered.data).toHaveLength(1)
+    expect(filtered.data[0].tags).toEqual(['bun'])
+    expect((await list('/posts?tag=nope')).data).toHaveLength(0)
+    const all = await list('/posts')
+    expect(all.data.map((p: any) => p.tags).sort()).toEqual([[], ['bun']])
+
+    const before = (await db.select().from(posts)).length
+    await author.post('/posts', payload('a,b,c,d,e,f')).assertStatus(422)
+    await author.post('/posts', payload('x'.repeat(31))).assertStatus(422)
+    await author.post('/posts', payload('x'.repeat(30))).assertStatus(303)
+    expect((await db.select().from(posts)).length).toBe(before + 1)
+
+    await author.delete(`/posts/${post.id}`).assertStatus(303)
+  })
+})
