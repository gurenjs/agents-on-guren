@@ -0,0 +1,27 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+describe('RegisterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('registers a user and queues welcome email', async () => {
+    // Prime CSRF tokens from the register page
+    const csrf = await http.withCsrf('/register')
+
+    const uniqueEmail = `test-${Date.now()}@example.com`
+    const response = await csrf.post('/register', {
+      name: 'Test User',
+      email: uniqueEmail,
+      password: 'password123',
+      passwordConfirmation: 'password123',
+    })
+
+    // Should redirect to dashboard (303 is used for POST redirect)
+    expect(response.status).toBe(303)
+  })
+})
