new file mode 100644
index 0000000..1c25af3
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,29 @@
+import { Job, mail, getMailManager } from '@guren/core'
+import { User } from '../Models/User.js'
+
+interface SendWelcomeEmailPayload {
+  userId: number
+}
+
+export default class SendWelcomeEmailJob extends Job<SendWelcomeEmailPayload> {
+  static jobName = 'SendWelcomeEmailJob'
+  static queue = 'default'
+  static maxAttempts = 3
+
+  async handle(payload: SendWelcomeEmailPayload): Promise<void> {
+    const user = await User.findOrFail(payload.userId)
+    const mailManager = getMailManager()
+
+    if (!mailManager) {
+      throw new Error('Mail manager not configured')
+    }
+
+    const appName = process.env.APP_NAME ?? 'App'
+
+    await mail(mailManager)
+      .to(user.email)
+      .subject(`Welcome to ${appName}, ${user.name}!`)
+      .text(`Hello ${user.name},\n\nWelcome to ${appName}! We're excited to have you on board.`)
+      .send()
+  }
+}
