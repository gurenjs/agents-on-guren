+++ b/modules/newsletter/NewsletterController.ts
@@ -0,0 +1,51 @@
+import { Controller, NotFoundHttpException, ValidationException } from '@guren/core'
+import { NewsletterSubscription } from './NewsletterSubscription.js'
+import { NewsletterEmailSchema, NewsletterTokenParamSchema } from './validators.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+
+    const existing = await NewsletterSubscription.first({ email })
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    const token = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex')
+    await NewsletterSubscription.forceCreate({ email, token })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(NewsletterTokenParamSchema)
+    const subscription = await NewsletterSubscription.first({ token })
+    if (!subscription) {
+      throw new NotFoundHttpException()
+    }
+
+    await NewsletterSubscription.forceUpdate({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(NewsletterEmailSchema)
+    await NewsletterSubscription.delete({ email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  // Only a Referer on this site is followed, so the header cannot be used as an open redirect.
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const target = new URL(referer)
+      if (target.host !== new URL(this.request.url).host) return '/'
+      return `${target.pathname}${target.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
