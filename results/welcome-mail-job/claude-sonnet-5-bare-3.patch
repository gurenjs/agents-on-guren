diff --git a/app/Jobs/SendWelcomeEmailJob.ts b/app/Jobs/SendWelcomeEmailJob.ts
new file mode 100644
index 0000000..1a3a8e7
--- /dev/null
+++ b/app/Jobs/SendWelcomeEmailJob.ts
@@ -0,0 +1,25 @@
+import { Job, getMailManager } from '@guren/core'
+import { WelcomeMail } from '../Mail/WelcomeMail.js'
+
+export interface SendWelcomeEmailPayload {
+  email: string
+  name: string
+}
+
+export class SendWelcomeEmailJob extends Job<SendWelcomeEmailPayload> {
+  static override queue = 'default'
+  static override maxAttempts = 3
+
+  async handle({ email, name }: SendWelcomeEmailPayload): Promise<void> {
+    const manager = getMailManager()
+    if (!manager) {
+      throw new Error('Mail manager not configured. Call setMailManager() first.')
+    }
+
+    await new WelcomeMail(manager, { name }).to(email).send()
+  }
+
+  async failed(payload: SendWelcomeEmailPayload, error: Error): Promise<void> {
+    console.error(`SendWelcomeEmailJob failed for ${payload.email}:`, error.message)
+  }
+}
