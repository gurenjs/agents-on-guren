index 519f090..dda37b5 100644
--- a/tests/PostController.test.ts
+++ b/tests/PostController.test.ts
@@ -20,3 +20,39 @@ describe('posts.search', () => {
     await http.query('/posts/search', { keywords: [] }).assertStatus(422)
   })
 })
+
+describe('posts.archive', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('returns posts by year', async () => {
+    await http.get('/posts/archive/2026').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns posts by month', async () => {
+    await http.get('/posts/archive/2026/08').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns posts by month without leading zero', async () => {
+    await http.get('/posts/archive/2026/8').assertOk().assertJsonStructure(['data'])
+  })
+
+  it('returns empty for year with no posts', async () => {
+    await http.get('/posts/archive/2025').assertOk().assertJsonCount(0, 'data')
+  })
+
+  it('returns empty for month with no posts', async () => {
+    await http.get('/posts/archive/2026/07').assertOk().assertJsonCount(0, 'data')
+  })
+
+  it('rejects invalid month', async () => {
+    await http.get('/posts/archive/2026/13').assertStatus(422)
+  })
+
+  it('rejects month zero', async () => {
+    await http.get('/posts/archive/2026/0').assertStatus(422)
+  })
+})
