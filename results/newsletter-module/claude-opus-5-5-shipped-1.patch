+++ b/modules/newsletter/tests/NewsletterSubscriptionController.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { resetDatabase } from '../../../config/database.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+describe('newsletter subscriptions', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function client(): Promise<TestApp> {
+    return (await http.withCsrf()).json().withHeader('Referer', REFERER)
+  }
+
+  it('stores a pending subscription with a random token and redirects back', async () => {
+    const csrf = await client()
+    await csrf.post('/newsletter/subscribe', { email: 'reader@example.com' }).assertRedirect(REFERER)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.confirmedAt).toBeNull()
+    expect(rows[0]?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('rejects invalid and duplicate addresses without touching the table', async () => {
+    const csrf = await client()
+    await csrf.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    await csrf.post('/newsletter/subscribe', { email: 'not-an-email' }).assertUnprocessable()
+    expect(await NewsletterSubscription.all()).toHaveLength(0)
+
+    await NewsletterSubscription.create({ email: 'reader@example.com', token: 'a'.repeat(64) })
+    await csrf
+      .post('/newsletter/subscribe', { email: 'reader@example.com' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.email.0', 'This email address is already subscribed.')
+    expect(await NewsletterSubscription.all()).toHaveLength(1)
+  })
+
+  it('confirms a subscription by token and 404s on an unknown one', async () => {
+    await NewsletterSubscription.create({ email: 'reader@example.com', token: 'b'.repeat(64) })
+
+    await http.get(`/newsletter/confirm/${'c'.repeat(64)}`).assertNotFound()
+    expect((await NewsletterSubscription.first({ email: 'reader@example.com' }))?.confirmedAt).toBeNull()
+
+    await http.get(`/newsletter/confirm/${'b'.repeat(64)}`).assertRedirect('/')
+    expect((await NewsletterSubscription.first({ email: 'reader@example.com' }))?.confirmedAt).not.toBeNull()
+  })
+
+  it('unsubscribes only the given address', async () => {
+    await NewsletterSubscription.create({ email: 'one@example.com', token: 'd'.repeat(64) })
+    await NewsletterSubscription.create({ email: 'two@example.com', token: 'e'.repeat(64) })
+
+    const csrf = await client()
+    await csrf.post('/newsletter/unsubscribe', { email: 'one@example.com' }).assertRedirect(REFERER)
+
+    const rows = await NewsletterSubscription.all()
+    expect(rows.map((row) => row.email)).toEqual(['two@example.com'])
+  })
+})
