diff --git a/app/Policies/CommentPolicy.ts b/app/Policies/CommentPolicy.ts
new file mode 100644
index 0000000..751f7f4
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,31 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  // The post the comment is on; its author may delete any comment under it.
+  post: { authorId: number } | null
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts.
+ * Anyone signed in may comment and report; deleting is for the comment's
+ * author and the author of the post it is on.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null, _comment: Pick<CommentLike, 'userId'>): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    if (user === null) {
+      return false
+    }
+
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === comment.post?.authorId
+  }
+}
