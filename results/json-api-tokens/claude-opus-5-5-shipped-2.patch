diff --git a/tests/controllers/ApiTokenController.test.ts b/tests/controllers/ApiTokenController.test.ts
new file mode 100644
index 0000000..03afaee
--- /dev/null
+++ b/tests/controllers/ApiTokenController.test.ts
@@ -0,0 +1,138 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { resetDatabase } from '../../config/database.js'
+import { ApiToken } from '../../app/Models/ApiToken.js'
+import { Post } from '../../app/Models/Post.js'
+import { User, type UserRecord } from '../../app/Models/User.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Owner', email: 'owner@example.com', password: 'password123' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'password123' })
+  })
+
+  async function issue(user: UserRecord, name = 'CI'): Promise<CreatedToken> {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<CreatedToken>()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('creates a token shown once and stores only a hash', async () => {
+    const created = await issue(owner, 'old laptop')
+    expect(created.name).toBe('old laptop')
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.all()
+    expect(rows).toHaveLength(1)
+    for (const value of Object.values(rows[0] as Record<string, unknown>)) {
+      expect(String(value)).not.toContain(secret)
+    }
+  })
+
+  it('rejects a missing, empty or over-long name', async () => {
+    const csrf = await http.actingAs(owner).withCsrf()
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('gives a guest no token', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name: 'CI' })
+    expect([302, 401]).toContain(res.status)
+    expect(await ApiToken.all()).toHaveLength(0)
+  })
+
+  it('lists posts newest first for a valid token', async () => {
+    const { token } = await issue(owner)
+    await Post.forceCreate({ title: 'First', excerpt: 'e', body: 'b', authorId: other.id, createdAt: '2026-01-01T00:00:00.000Z' })
+    await Post.forceCreate({ title: 'Second', excerpt: 'e', body: 'b', authorId: owner.id, createdAt: '2026-02-01T00:00:00.000Z' })
+
+    await bearer(token).get('/api/posts')
+      .assertOk()
+      .assertJsonCount(2, 'data')
+      .assertJsonPath('data.0.title', 'Second')
+      .assertJsonPath('data.0.createdAt', '2026-02-01T00:00:00.000Z')
+      .assertJsonPath('data.1.authorId', other.id)
+  })
+
+  it('creates a post owned by the token owner, ignoring authorId', async () => {
+    const { token } = await issue(owner)
+    await bearer(token)
+      .post('/api/posts', { title: 'Release notes', excerpt: 'v1.2', body: 'Changes', authorId: other.id })
+      .assertCreated()
+      .assertJsonPath('data.title', 'Release notes')
+      .assertJsonPath('data.authorId', owner.id)
+  })
+
+  it('rejects invalid post input with 422', async () => {
+    const { token } = await issue(owner)
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x' }).assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const { token } = await issue(owner)
+    const [id, secret] = token.split('|') as [string, string]
+    const tampered = `${id}|${secret.slice(0, -1)}${secret.endsWith('a') ? 'b' : 'a'}`
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    for (const bad of ['garbage', `${'0'.repeat(32)}|${'f'.repeat(64)}`, tampered]) {
+      await bearer(bad).get('/api/posts').assertUnauthorized()
+      await bearer(bad).post('/api/posts', { title: 't', excerpt: 'e', body: 'b' }).assertUnauthorized()
+    }
+    await bearer('garbage').post('/api/posts', {}).assertUnauthorized()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('revokes only the owner\'s token', async () => {
+    const mine = await issue(owner, 'one')
+    const second = await issue(owner, 'two')
+    const theirs = await issue(other)
+
+    const csrf = await http.actingAs(owner).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${theirs.id}`).assertNotFound()
+    await bearer(theirs.token).get('/api/posts').assertOk()
+
+    await csrf.json().delete(`/profile/tokens/${mine.id}`).assertNoContent()
+    await bearer(mine.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const first = await issue(owner, 'first')
+    const second = await issue(owner, 'second')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
