diff --git a/app/Http/Controllers/LocaleController.ts b/app/Http/Controllers/LocaleController.ts
new file mode 100644
index 0000000..25c6c4e
--- /dev/null
+++ b/app/Http/Controllers/LocaleController.ts
@@ -0,0 +1,46 @@
+import { Controller } from '@guren/core'
+import type { Locale } from '../Validators/LocaleValidator.js'
+
+// The cookie the framework's locale detection reads, ahead of Accept-Language.
+const LOCALE_COOKIE = 'locale'
+const ONE_YEAR_IN_SECONDS = 60 * 60 * 24 * 365
+
+export default class LocaleController extends Controller {
+  async update(): Promise<Response> {
+    const { locale } = this.validated('locale.update').body
+
+    return this.redirect(this.previousUrl(), {
+      headers: { 'Set-Cookie': localeCookie(locale) },
+    })
+  }
+
+  // Referer is client-controlled. One on this origin is followed as sent; any
+  // other is cut down to its path, so the redirect never leaves the site.
+  private previousUrl(): string {
+    const referer = this.request.header('Referer')
+    if (!referer) {
+      return '/'
+    }
+
+    let target: URL
+    let current: URL
+    try {
+      current = new URL(this.request.url)
+      target = new URL(referer, current)
+    } catch {
+      return '/'
+    }
+
+    if (target.origin === current.origin) {
+      return referer
+    }
+
+    const path = `${target.pathname}${target.search}`
+    // Browsers read a leading `//` or `/\` as another host.
+    return /^\/(?![/\\])/.test(path) ? path : '/'
+  }
+}
+
+function localeCookie(locale: Locale): string {
+  return `${LOCALE_COOKIE}=${locale}; Path=/; Max-Age=${ONE_YEAR_IN_SECONDS}; HttpOnly; SameSite=Lax`
+}
diff --git a/app/Http/Validators/LocaleValidator.ts b/app/Http/Validators/LocaleValidator.ts
new file mode 100644
index 0000000..a10b55c
--- /dev/null
+++ b/app/Http/Validators/LocaleValidator.ts
@@ -0,0 +1,12 @@
+import { z } from 'zod'
+
+// The first locale is the default: src/app.ts hands this list to the i18n
+// config, which falls back to its first entry.
+export const SUPPORTED_LOCALES = ['en', 'ja'] as const
+
+export const LocalePayloadSchema = z.object({
+  locale: z.enum(SUPPORTED_LOCALES, 'Choose a supported language.'),
+})
+
+export type Locale = (typeof SUPPORTED_LOCALES)[number]
+export type LocalePayload = z.infer<typeof LocalePayloadSchema>
