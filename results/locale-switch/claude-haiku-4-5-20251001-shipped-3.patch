+import { ServiceProvider, detectLocaleMiddleware } from '@guren/core'
+
+export default class LocaleProvider extends ServiceProvider {
+  register(): void {
+    // No-op
+  }
+
+  boot(): void {
+    const app = this.container.make('app')
+    app.hono.use(detectLocaleMiddleware({ supported: ['en', 'ja'] }))
+  }
+}
