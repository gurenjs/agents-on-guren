+async function attachTagsToPost(postId: number, tagNames: string[]): Promise<void> {
+  await PostTag.newQuery().where('postId', postId).delete()
+
+  if (tagNames.length === 0) return
+
+  const existingTags = await Tag.newQuery().whereIn('name', tagNames).get()
+  const existingTagNames = new Set(existingTags.map((t) => t.name))
+
+  const tagsToCreate = tagNames.filter((name) => !existingTagNames.has(name))
+  const createdTags = await Promise.all(
+    tagsToCreate.map((name) => Tag.create({ name }))
+  )
+
+  const allTags = [...existingTags, ...createdTags]
+
+  for (const tag of allTags) {
+    await PostTag.create({ postId, tagId: tag.id })
+  }
+}
+
+async function getTagsForPost(postId: number): Promise<string[]> {
+  const postTags = await PostTag.newQuery()
+    .where('postId', postId)
+    .get()
+
+  const tagIds = postTags.map((pt) => pt.tagId)
+  if (tagIds.length === 0) return []
+
+  const tags = await Tag.newQuery().whereIn('id', tagIds).get()
+  return tags.map((t) => t.name).sort()
+}
+
+async function loadTagsForPosts(posts: any[]): Promise<void> {
+  if (posts.length === 0) return
+
+  const postIds = posts.map((p) => p.id)
+
+  const postTags = await PostTag.newQuery().whereIn('postId', postIds).get()
+
+  const tagIdsByPostId = new Map<number, number[]>()
+  for (const pt of postTags) {
+    if (!tagIdsByPostId.has(pt.postId)) {
+      tagIdsByPostId.set(pt.postId, [])
+    }
+    tagIdsByPostId.get(pt.postId)!.push(pt.tagId)
+  }
+
+  const allTagIds = Array.from(new Set(postTags.map((pt) => pt.tagId)))
+  if (allTagIds.length === 0) {
+    for (const post of posts) {
+      post.tags = []
+    }
+    return
+  }
+
+  const tags = await Tag.newQuery().whereIn('id', allTagIds).get()
+  const tagsById = new Map(tags.map((t) => [t.id, t.name]))
+
+  for (const post of posts) {
+    const tagIds = tagIdsByPostId.get(post.id) ?? []
+    post.tags = tagIds
+      .map((id) => tagsById.get(id))
+      .filter((name): name is string => name !== undefined)
+      .sort()
+  }
+}
