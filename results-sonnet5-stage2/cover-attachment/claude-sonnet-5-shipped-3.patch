diff --git a/app/Support/CoverStorage.ts b/app/Support/CoverStorage.ts
new file mode 100644
index 0000000..b25a477
--- /dev/null
+++ b/app/Support/CoverStorage.ts
@@ -0,0 +1,54 @@
+import { mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Attachment, type AttachmentRecord } from '../Models/Attachment.js'
+
+const STORAGE_DIR = join(process.cwd(), 'storage', 'attachments')
+const MAX_BYTES = 2 * 1024 * 1024
+
+const PNG_MAGIC = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
+const JPEG_MAGIC = [0xff, 0xd8, 0xff]
+
+export interface ValidCover {
+  bytes: Uint8Array
+  mimeType: 'image/png' | 'image/jpeg'
+}
+
+function startsWith(bytes: Uint8Array, magic: number[]): boolean {
+  return magic.every((byte, index) => bytes[index] === byte)
+}
+
+/** Returns an error message, or the validated bytes and sniffed type. */
+export async function inspectCover(file: File): Promise<{ error: string } | ValidCover> {
+  if (file.size > MAX_BYTES) return { error: 'Cover must be 2 MB or smaller.' }
+  const bytes = new Uint8Array(await file.arrayBuffer())
+  if (bytes.length > MAX_BYTES) return { error: 'Cover must be 2 MB or smaller.' }
+  // Sniffed from content: the client-declared type and filename are not trusted.
+  if (startsWith(bytes, PNG_MAGIC)) return { bytes, mimeType: 'image/png' }
+  if (startsWith(bytes, JPEG_MAGIC)) return { bytes, mimeType: 'image/jpeg' }
+  return { error: 'Cover must be a PNG or JPEG image.' }
+}
+
+export function coverUrl(attachment: AttachmentRecord | null | undefined): string | null {
+  return attachment ? `/attachments/${attachment.id}` : null
+}
+
+export async function findCover(postId: number): Promise<AttachmentRecord | null> {
+  return Attachment.first({ postId })
+}
+
+export async function removeCover(postId: number): Promise<void> {
+  const existing = await findCover(postId)
+  if (!existing) return
+  await Attachment.delete({ id: existing.id })
+  await rm(existing.path, { force: true })
+}
+
+export async function replaceCover(postId: number, cover: ValidCover): Promise<void> {
+  const previous = await findCover(postId)
+  await mkdir(STORAGE_DIR, { recursive: true })
+  const path = join(STORAGE_DIR, `${crypto.randomUUID()}.${cover.mimeType === 'image/png' ? 'png' : 'jpg'}`)
+  await Bun.write(path, cover.bytes)
+  if (previous) await Attachment.delete({ id: previous.id })
+  await Attachment.forceCreate({ postId, path, mimeType: cover.mimeType, size: cover.bytes.length })
+  if (previous) await rm(previous.path, { force: true })
+}
