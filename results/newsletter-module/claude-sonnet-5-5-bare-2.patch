new file mode 100644
index 0000000..29e361b
--- /dev/null
+++ b/modules/newsletter/NewsletterController.ts
@@ -0,0 +1,49 @@
+import { Controller, ValidationException } from '@guren/core'
+import { Subscription } from './Subscription.js'
+import { EmailSchema } from './validators.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+
+    const existing = await Subscription.where({ email })
+    if (existing.length > 0) {
+      throw ValidationException.withMessages({ email: 'This email address is already subscribed.' })
+    }
+
+    // 32 random bytes as hex: unguessable, 64 characters.
+    const token = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex')
+    await Subscription.create({ email, token, confirmedAt: null })
+
+    return this.redirect(this.backUrl())
+  }
+
+  async confirm(): Promise<Response> {
+    const token = this.ctx.req.param('token') ?? ''
+    // Throws a 404 for a token we never issued.
+    const subscription = await Subscription.findOrFail(token, 'token')
+    await Subscription.update({ id: subscription.id }, { confirmedAt: new Date().toISOString() })
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(EmailSchema)
+    await Subscription.delete({ email })
+
+    return this.redirect(this.backUrl())
+  }
+
+  /** The page the visitor came from, if it is on this site; otherwise home. */
+  private backUrl(): string {
+    const referer = this.request.header('referer')
+    if (!referer) return '/'
+    try {
+      const from = new URL(referer)
+      if (from.origin !== new URL(this.request.url).origin) return '/'
+      return `${from.pathname}${from.search}`
+    } catch {
+      return '/'
+    }
+  }
+}
