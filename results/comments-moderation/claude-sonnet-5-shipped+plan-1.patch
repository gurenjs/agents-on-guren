diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..626aec6
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,73 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  let owner: any
+  let reader: any
+  let post: any
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Owner', email: 'o@x.test', password: 'secret-pass-1' })
+    reader = await User.create({ name: 'Reader', email: 'r@x.test', password: 'secret-pass-1' })
+    post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: owner.id })
+  })
+
+  it('sends a guest to login and stores nothing', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores a comment and rejects an invalid body', async () => {
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect(`/posts/${post.id}`)
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    const rows = await Comment.all()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.userId).toBe(reader.id)
+  })
+
+  it('lets the author or post author delete, nobody else', async () => {
+    const stranger = await User.create({ name: 'S', email: 's@x.test', password: 'secret-pass-1' })
+    const c = await Comment.forceCreate({ body: 'x', postId: post.id, userId: reader.id })
+    const denied = await http.actingAs(stranger).withCsrf()
+    await denied.delete(`/comments/${c.id}`).assertForbidden()
+    expect(await Comment.all()).toHaveLength(1)
+    const byOwner = await http.actingAs(owner).withCsrf()
+    await byOwner.delete(`/comments/${c.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('hides a comment after three distinct reports, idempotently', async () => {
+    const c = await Comment.forceCreate({ body: 'x', postId: post.id, userId: reader.id })
+    const users = [owner, reader]
+    for (const n of [3, 4]) users.push(await User.create({ name: `U${n}`, email: `u${n}@x.test`, password: 'secret-pass-1' }))
+    for (const u of users.slice(0, 2)) {
+      const csrf = await http.actingAs(u).withCsrf()
+      await csrf.post(`/comments/${c.id}/report`).assertNoContent()
+      await csrf.post(`/comments/${c.id}/report`).assertNoContent()
+    }
+    expect(await CommentReport.all()).toHaveLength(2)
+    const inertia = http.withHeader('X-Inertia', 'true')
+    const before = await (await inertia.get(`/posts/${post.id}`)).json<{ props: { comments: unknown[] } }>()
+    expect(before.props.comments).toHaveLength(1)
+    const csrf = await http.actingAs(users[2]).withCsrf()
+    await csrf.post(`/comments/${c.id}/report`).assertNoContent()
+    const after = await (await inertia.get(`/posts/${post.id}`)).json<{ props: { comments: unknown[] } }>()
+    expect(after.props.comments).toHaveLength(0)
+    expect(await Comment.all()).toHaveLength(1)
+  })
+})
