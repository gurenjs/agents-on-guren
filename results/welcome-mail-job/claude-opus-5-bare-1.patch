diff --git a/tests/RegisterController.test.ts b/tests/RegisterController.test.ts
new file mode 100644
index 0000000..79469e3
--- /dev/null
+++ b/tests/RegisterController.test.ts
@@ -0,0 +1,89 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp, fakeQueue } from '@guren/testing'
+import { MemoryTransport, processJob, setQueueDriver, type MailManager } from '@guren/core'
+import app from '../src/app.js'
+import { SendWelcomeEmailJob } from '../app/Jobs/SendWelcomeEmailJob.js'
+import { User } from '../app/Models/User.js'
+import { DEMO_EMAIL } from '../db/seeders/001_users.js'
+
+const REGISTRATION = {
+  name: 'Ada Lovelace',
+  email: 'ada@example.com',
+  password: 'correct-horse',
+  passwordConfirmation: 'correct-horse',
+}
+
+// Sign-up hands the welcome email to the queue and returns; the message only
+// leaves once the queued job runs. Both halves are checked here with the queue
+// holding what it is given (nothing runs inline) and the mailer recording what
+// it is asked to deliver — which is what QUEUE_CONNECTION=redis plus a real
+// MAIL_MAILER look like from the app's side.
+describe('registration', () => {
+  let http: TestApp
+  let queue: ReturnType<typeof fakeQueue>
+  let mailbox: MemoryTransport
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+
+    queue = fakeQueue()
+    setQueueDriver(queue.getDriver())
+
+    const mail = app.container.make<MailManager>('mail')
+    mailbox = new MemoryTransport()
+    mail.registerTransport(mail.getDefaultTransportName(), () => mailbox)
+  })
+
+  beforeEach(async () => {
+    queue.clear()
+    mailbox.clear()
+    await User.delete({ email: REGISTRATION.email })
+  })
+
+  afterAll(async () => {
+    await User.delete({ email: REGISTRATION.email })
+  })
+
+  it('queues the welcome email rather than sending it during sign-up', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf.post('/register', REGISTRATION).assertRedirect('/dashboard')
+
+    expect(mailbox.count()).toBe(0)
+    expect(queue.all()).toHaveLength(1)
+    queue.assertPushedTimes(SendWelcomeEmailJob, 1)
+  })
+
+  it('sends exactly one welcome email when a worker runs the queued job', async () => {
+    const csrf = await http.withCsrf('/register')
+    await csrf.post('/register', REGISTRATION).assertRedirect('/dashboard')
+
+    expect(await processJob(queue.getDriver())).toBe(true)
+
+    const messages = mailbox.getMessages()
+    expect(messages).toHaveLength(1)
+    expect(messages[0]?.to.map((address) => address.email)).toEqual([REGISTRATION.email])
+    expect(messages[0]?.from).toMatchObject({ email: 'hello@example.com', name: 'Guren' })
+    expect(messages[0]?.subject).toBe('Welcome to Guren, Ada Lovelace!')
+    expect(messages[0]?.text).toContain('Hi Ada Lovelace,')
+  })
+
+  it('queues nothing when the email is already taken', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf.post('/register', { ...REGISTRATION, email: DEMO_EMAIL })
+
+    queue.assertNothingPushed()
+    expect(mailbox.count()).toBe(0)
+  })
+
+  it('queues nothing when the registration fails validation', async () => {
+    const csrf = await http.withCsrf('/register')
+
+    await csrf.post('/register', { ...REGISTRATION, passwordConfirmation: 'something-else' })
+
+    queue.assertNothingPushed()
+    expect(mailbox.count()).toBe(0)
+    expect(await User.where({ email: REGISTRATION.email })).toHaveLength(0)
+  })
+})
