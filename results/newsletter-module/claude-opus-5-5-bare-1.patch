new file mode 100644
index 0000000..8dbe279
--- /dev/null
+++ b/guren.arch.ts
@@ -0,0 +1,19 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Modules under modules/ are self-contained and portable between apps, so the
+// application's own code must never depend on one. The app wires modules in
+// only through src/app.ts (and drizzle.config.ts for their schemas).
+export default defineArchRules({
+  layers: {
+    app: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'app',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'app/ and routes/ must not import the newsletter module; register it in src/app.ts instead.',
+    },
+  ],
+})
