+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+const REFERER = 'http://localhost/posts'
+
+// The SQLite test database persists between runs, so every address is unique
+// to this run and removed again afterwards.
+const runId = Date.now().toString(36)
+const address = (label: string) => `${label}-${runId}@example.com`
+const issued: string[] = []
+
+async function subscribe(http: TestApp, email: string) {
+  const csrf = await http.withCsrf()
+  return csrf.json().withHeader('Referer', REFERER).post('/newsletter/subscribe', { email })
+}
+
+describe('NewsletterController', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  afterAll(async () => {
+    for (const email of issued) await NewsletterSubscription.delete({ email })
+  })
+
+  it('subscribe stores a pending subscription with a token and redirects back', async () => {
+    const email = address('subscribe')
+    issued.push(email)
+
+    const res = await subscribe(http, email)
+    res.assertRedirect(REFERER)
+    expect([302, 303]).toContain(res.status)
+
+    const row = await NewsletterSubscription.first({ email })
+    expect(row).not.toBeNull()
+    expect(row?.confirmedAt).toBeNull()
+    expect(row?.token.length).toBeGreaterThanOrEqual(16)
+  })
+
+  it('subscribe falls back to / without a Referer', async () => {
+    const email = address('no-referer')
+    issued.push(email)
+
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email }).assertRedirect('/')
+  })
+
+  it('subscribe ignores an off-site Referer', async () => {
+    const email = address('offsite')
+    issued.push(email)
+
+    const csrf = await http.withCsrf()
+    await csrf
+      .json()
+      .withHeader('Referer', 'https://evil.example/phish')
+      .post('/newsletter/subscribe', { email })
+      .assertRedirect('/')
+  })
+
+  it('subscribe rejects an invalid email with a 422 under email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+    const res = await csrf.json().post('/newsletter/subscribe', { email: 'not-an-email' })
+    res.assertUnprocessable()
+    const body = await res.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.email?.length).toBeGreaterThan(0)
+    expect(await NewsletterSubscription.first({ email: 'not-an-email' })).toBeNull()
+  })
+
+  it('subscribe rejects an address that is already subscribed', async () => {
+    const email = address('duplicate')
+    issued.push(email)
+
+    await subscribe(http, email)
+    const res = await subscribe(http, email)
+    res.assertUnprocessable()
+    const body = await res.json<{ errors: Record<string, string[]> }>()
+    expect(body.errors.email?.length).toBeGreaterThan(0)
+    expect(await NewsletterSubscription.where({ email }).count()).toBe(1)
+  })
+
+  it('confirm sets confirmed_at and redirects home', async () => {
+    const email = address('confirm')
+    issued.push(email)
+
+    await subscribe(http, email)
+    const row = await NewsletterSubscription.first({ email })
+
+    await http.get(`/newsletter/confirm/${row?.token}`).assertRedirect('/')
+
+    const confirmed = await NewsletterSubscription.first({ email })
+    expect(confirmed?.confirmedAt).not.toBeNull()
+  })
+
+  it('confirm answers 404 for a token that was never issued', async () => {
+    await http.get('/newsletter/confirm/never-issued-token-value').assertNotFound()
+  })
+
+  it('unsubscribe deletes only that row and redirects back', async () => {
+    const leaving = address('leaving')
+    const staying = address('staying')
+    issued.push(leaving, staying)
+
+    await subscribe(http, leaving)
+    await subscribe(http, staying)
+
+    const csrf = await http.withCsrf()
+    const res = await csrf
+      .json()
+      .withHeader('Referer', REFERER)
+      .post('/newsletter/unsubscribe', { email: leaving })
+    res.assertRedirect(REFERER)
+
+    expect(await NewsletterSubscription.first({ email: leaving })).toBeNull()
+    expect(await NewsletterSubscription.first({ email: staying })).not.toBeNull()
+  })
+
+  it('unsubscribe rejects an invalid email', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/newsletter/unsubscribe', { email: 'nope' }).assertUnprocessable()
+  })
+})
