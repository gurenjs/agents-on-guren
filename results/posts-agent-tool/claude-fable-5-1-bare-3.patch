diff --git a/tests/PostAgentTools.test.ts b/tests/PostAgentTools.test.ts
new file mode 100644
index 0000000..403a27d
--- /dev/null
+++ b/tests/PostAgentTools.test.ts
@@ -0,0 +1,259 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The agent tools are the posts.search and posts.store routes, so these tests
+// go through the same two doors an assistant has: the framework's dispatch
+// contract (`http.agent()`), and the production endpoint at /mcp with a bearer
+// credential. Booting the app applies the migrations to the test database.
+
+const MARKER = `agent-tools-${Date.now()}`
+
+interface ToolDescription {
+  name: string
+  annotations?: { readOnlyHint?: boolean }
+}
+
+interface ToolCallResult {
+  content: Array<{ type: string; text: string }>
+  structuredContent?: unknown
+  isError?: boolean
+}
+
+interface RpcReply<T> {
+  result?: T
+  error?: { code: number; message: string }
+}
+
+let http: TestApp
+let author: UserRecord
+let other: UserRecord
+let bearer: string
+
+async function createUser(label: string): Promise<UserRecord> {
+  const user = await User.create({
+    name: `Agent Tools ${label}`,
+    email: `${MARKER}-${label}@example.com`,
+    password: 'secret-password',
+  })
+  if (!user) {
+    throw new Error(`Could not create the ${label} test user.`)
+  }
+  return user
+}
+
+function postCount(): Promise<number> {
+  return Post.newQuery().where('title', 'like', `%${MARKER}%`).count()
+}
+
+/** One JSON-RPC call to /mcp. The endpoint is stateless, so no handshake precedes it. */
+async function rpc<T>(method: string, params: Record<string, unknown>, token: string | null = bearer): Promise<RpcReply<T>> {
+  const response = await mcpRequest(method, params, token)
+  expect(response.status).toBe(200)
+  const text = await response.text()
+  // Streamable HTTP may answer as a single JSON document or as an event stream.
+  const payload = (response.headers.get('Content-Type') ?? '').includes('text/event-stream')
+    ? text.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice('data:'.length).trim()).at(-1) ?? ''
+    : text
+  return JSON.parse(payload) as RpcReply<T>
+}
+
+function mcpRequest(method: string, params: Record<string, unknown>, token: string | null): Promise<Response> {
+  return app.fetch(new Request('http://localhost/mcp', {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      Accept: 'application/json, text/event-stream',
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+    },
+    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
+  }))
+}
+
+async function callTool(name: string, args: Record<string, unknown>): Promise<ToolCallResult> {
+  const reply = await rpc<ToolCallResult>('tools/call', { name, arguments: args })
+  if (!reply.result) {
+    throw new Error(`tools/call ${name} failed: ${JSON.stringify(reply.error)}`)
+  }
+  return reply.result
+}
+
+beforeAll(async () => {
+  http = await TestApp.fromApp(app)
+  author = await createUser('author')
+  other = await createUser('other')
+
+  await Post.forceCreate({
+    title: `${MARKER} searchable`,
+    excerpt: 'A post the search tool should find.',
+    body: 'Body.',
+    authorId: other.id,
+  })
+
+  const store = app.auth.getApiTokenStore()
+  if (!store) {
+    throw new Error('The app configures no API token store.')
+  }
+  const issued = await createApiToken(store, { name: MARKER, userId: author.id, abilities: ['tools:*'] })
+  bearer = issued.plainTextToken
+})
+
+afterAll(async () => {
+  await Post.newQuery().where('title', 'like', `%${MARKER}%`).delete()
+  // The users' tokens go with them: api_tokens.user_id cascades.
+  await app.auth.getApiTokenStore()?.deleteForUser(author.id)
+  await User.newQuery().where('email', 'like', `${MARKER}-%`).delete()
+})
+
+describe('agent tools', () => {
+  it('exposes exactly posts_search and posts_store, and only search as read-only', async () => {
+    const tools = await http.agent().tools()
+
+    expect(tools.map((tool) => [tool.toolName, tool.annotations.readOnlyHint]).sort()).toEqual([
+      ['posts_search', true],
+      ['posts_store', false],
+    ])
+  })
+
+  it('posts_search answers a guest with what QUERY /posts/search answers', async () => {
+    const input = { keywords: [MARKER], limit: 5 }
+
+    const viaTool = await http.agent().call('posts_search', input).assertOk()
+    const viaHttp = await http.query('/posts/search', input).assertOk()
+
+    const found = viaTool.json<{ data: Array<{ title: string }> }>()
+    expect(found).toEqual(await viaHttp.raw.json())
+    expect(found.data.map((post) => post.title)).toEqual([`${MARKER} searchable`])
+  })
+
+  it('posts_search rejects input the search request rejects', async () => {
+    await http.agent().call('posts_search', { keywords: [] }).assertStatus(422)
+  })
+
+  it('posts_store refuses a guest and creates nothing', async () => {
+    const before = await postCount()
+
+    const result = await (await http.withCsrf()).agent().call('posts_store', {
+      title: `${MARKER} by a guest`,
+      excerpt: 'Excerpt.',
+      body: 'Body.',
+    })
+
+    // The 'auth' middleware answers a guest the way it does on the site.
+    if (result.status === 302) {
+      expect(result.response.headers.get('Location')).toBe('/login')
+    } else {
+      result.assertDenied()
+    }
+    expect(await postCount()).toBe(before)
+  })
+
+  it('posts_store creates the post as the calling user, whatever authorId says', async () => {
+    const title = `${MARKER} by the author`
+
+    await (await http.withCsrf()).agent().call('posts_store', {
+      title,
+      excerpt: 'Excerpt.',
+      body: 'Body.',
+      authorId: other.id,
+    }, { as: author }).assertOk()
+
+    const created = await Post.newQuery().where('title', title).get()
+    expect(created.map((post) => post.authorId)).toEqual([author.id])
+  })
+
+  it('posts_store answers 422 to input the form rejects and creates nothing', async () => {
+    const before = await postCount()
+
+    const result = await (await http.withCsrf()).agent().call('posts_store', {
+      title: '',
+      excerpt: `${MARKER} excerpt`,
+      body: 'Body.',
+    }, { as: author }).assertStatus(422)
+
+    expect(result.isError).toBe(true)
+    expect(await postCount()).toBe(before)
+  })
+})
+
+describe('POST /mcp', () => {
+  it('answers 401 without a credential', async () => {
+    const response = await mcpRequest('tools/list', {}, null)
+
+    expect(response.status).toBe(401)
+  })
+
+  it('answers 401 to a credential it never issued', async () => {
+    const response = await mcpRequest('tools/list', {}, 'not-a-token|not-a-secret')
+
+    expect(response.status).toBe(401)
+  })
+
+  it('lists the two tools with their read-only flags', async () => {
+    const reply = await rpc<{ tools: ToolDescription[] }>('tools/list', {})
+
+    const own = (reply.result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+    expect(own.map((tool) => [tool.name, tool.annotations?.readOnlyHint]).sort()).toEqual([
+      ['posts_search', true],
+      ['posts_store', false],
+    ])
+  })
+
+  it('searches posts', async () => {
+    const input = { keywords: [MARKER, 'searchable'], limit: 1 }
+
+    const result = await callTool('posts_search', input)
+    const viaHttp = await http.query('/posts/search', input).assertOk()
+
+    expect(result.isError).not.toBe(true)
+    expect(result.structuredContent ?? JSON.parse(result.content[0]?.text ?? 'null')).toEqual(await viaHttp.raw.json())
+  })
+
+  it('creates a post as the credential\'s user, whatever authorId says', async () => {
+    const title = `${MARKER} over mcp`
+
+    const result = await callTool('posts_store', {
+      title,
+      excerpt: 'Excerpt.',
+      body: 'Body.',
+      authorId: other.id,
+    })
+
+    expect(result.isError).not.toBe(true)
+    const created = await Post.newQuery().where('title', title).get()
+    expect(created.map((post) => post.authorId)).toEqual([author.id])
+  })
+
+  it('answers 422 to input the form rejects and creates nothing', async () => {
+    const before = await postCount()
+
+    const result = await callTool('posts_store', { title: '', excerpt: `${MARKER} excerpt`, body: 'Body.' })
+
+    expect(result.isError).toBe(true)
+    expect(result.content.map((part) => part.text).join('\n')).toContain('Title is required.')
+    expect(await postCount()).toBe(before)
+  })
+
+  it('withholds posts_store from a credential scoped to reading', async () => {
+    const store = app.auth.getApiTokenStore()
+    if (!store) {
+      throw new Error('The app configures no API token store.')
+    }
+    const readOnly = await createApiToken(store, { name: `${MARKER}-read`, userId: author.id, abilities: ['tools:read'] })
+    const before = await postCount()
+
+    const listed = await rpc<{ tools: ToolDescription[] }>('tools/list', {}, readOnly.plainTextToken)
+    const called = await rpc<ToolCallResult>('tools/call', {
+      name: 'posts_store',
+      arguments: { title: `${MARKER} out of scope`, excerpt: 'Excerpt.', body: 'Body.' },
+    }, readOnly.plainTextToken)
+
+    const own = (listed.result?.tools ?? []).filter((tool) => !tool.name.startsWith('guren_'))
+    expect(own.map((tool) => tool.name)).toEqual(['posts_search'])
+    expect(called.result?.isError).toBe(true)
+    expect(await postCount()).toBe(before)
+  })
+})
