new file mode 100644
index 0000000..5fa65ac
--- /dev/null
+++ b/modules/newsletter/http/controller.ts
@@ -0,0 +1,56 @@
+import { Controller, ValidationException, ModelNotFoundException } from '@guren/core'
+import { NewsletterSubscription } from '../db/model.js'
+import { SubscribeEmailSchema, UnsubscribeEmailSchema, ConfirmTokenSchema } from './validators.js'
+import { generateToken } from '../utils.js'
+
+export default class NewsletterController extends Controller {
+  async subscribe(): Promise<Response> {
+    const { email } = await this.validateBody(SubscribeEmailSchema)
+
+    const existing = await NewsletterSubscription.newQuery()
+      .where('email', email)
+      .first()
+
+    if (existing) {
+      throw ValidationException.withMessages({ email: 'This email is already subscribed.' })
+    }
+
+    const token = generateToken()
+    await NewsletterSubscription.create({
+      email,
+      token,
+      confirmedAt: null,
+    })
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+
+  async confirm(): Promise<Response> {
+    const { token } = this.validateParams(ConfirmTokenSchema)
+
+    const subscription = await NewsletterSubscription.newQuery()
+      .where('token', token)
+      .first()
+
+    if (!subscription) {
+      throw new ModelNotFoundException('NewsletterSubscription', token, 'token')
+    }
+
+    await NewsletterSubscription.update(
+      { id: subscription.id },
+      { confirmedAt: new Date().toISOString() }
+    )
+
+    return this.redirect('/')
+  }
+
+  async unsubscribe(): Promise<Response> {
+    const { email } = await this.validateBody(UnsubscribeEmailSchema)
+
+    await NewsletterSubscription.delete({ email })
+
+    const referer = this.request.header('referer') || '/'
+    return this.redirect(referer)
+  }
+}
