+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import { API_TOKEN_RATE_LIMIT } from '../app/Http/Middleware/ThrottleApiTokenMiddleware.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { resetDatabase } from '../config/database.js'
+import app from '../src/app.js'
+
+interface PostJson {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+const payload = { title: 'Release 1.2', excerpt: 'What changed', body: 'Notes.' }
+
+describe('posts API', () => {
+  let http: TestApp
+  let ada: UserRecord
+  let grace: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    ada = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    grace = await User.create({ name: 'Grace', email: 'grace@example.com', password: 'secret-password' })
+  })
+
+  async function issueToken(user: UserRecord, name = 'CI'): Promise<string> {
+    const session = await http.actingAs(user).json().withCsrf()
+    const response = await session.post('/profile/tokens', { name })
+    response.assertCreated()
+    return (await response.json<{ token: string }>()).token
+  }
+
+  // Bearer header only: no session cookie, no CSRF token, like a script.
+  function bearer(token: string): TestApp {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  describe('GET /api/posts', () => {
+    it('lists every post by every author, newest first', async () => {
+      await Post.forceCreate({ ...payload, title: 'Oldest', authorId: ada.id, createdAt: '2026-01-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...payload, title: 'Newest', authorId: grace.id, createdAt: '2026-03-01T00:00:00.000Z' })
+      await Post.forceCreate({ ...payload, title: 'Middle', authorId: ada.id, createdAt: '2026-02-01T00:00:00.000Z' })
+
+      const response = await bearer(await issueToken(ada)).get('/api/posts')
+
+      response.assertOk()
+      const { data } = await response.json<{ data: PostJson[] }>()
+      expect(data.map((post) => post.title)).toEqual(['Newest', 'Middle', 'Oldest'])
+      expect(data[0]).toMatchObject({
+        id: expect.any(Number),
+        title: 'Newest',
+        excerpt: 'What changed',
+        authorId: grace.id,
+        createdAt: '2026-03-01T00:00:00.000Z',
+      })
+    })
+
+    it('answers an empty list when there are no posts', async () => {
+      await bearer(await issueToken(ada)).get('/api/posts').assertOk().assertJson({ data: [] })
+    })
+  })
+
+  describe('POST /api/posts', () => {
+    it("creates the post as the token's owner", async () => {
+      const response = await bearer(await issueToken(ada)).post('/api/posts', payload)
+
+      response.assertCreated()
+      const { data } = await response.json<{ data: PostJson }>()
+      expect(data).toMatchObject({ title: 'Release 1.2', excerpt: 'What changed', authorId: ada.id })
+      expect(new Date(data.createdAt).toISOString()).toBe(data.createdAt)
+      const stored = await Post.findOrFail(data.id)
+      expect(stored.authorId).toBe(ada.id)
+      expect(stored.body).toBe('Notes.')
+    })
+
+    it('ignores an authorId in the body', async () => {
+      const response = await bearer(await issueToken(ada)).post('/api/posts', { ...payload, authorId: grace.id })
+
+      response.assertCreated()
+      const { data } = await response.json<{ data: PostJson }>()
+      expect(data.authorId).toBe(ada.id)
+      expect((await Post.findOrFail(data.id)).authorId).toBe(ada.id)
+    })
+
+    it.each([
+      ['an empty title', { ...payload, title: '' }],
+      ['a blank title', { ...payload, title: '   ' }],
+      ['a title over 255 characters', { ...payload, title: 't'.repeat(256) }],
+      ['no excerpt', { title: payload.title, body: payload.body }],
+      ['no body', { title: payload.title, excerpt: payload.excerpt }],
+      ['an empty object', {}],
+    ])('rejects %s with 422 and creates nothing', async (_label, body) => {
+      await bearer(await issueToken(ada))
+        .post('/api/posts', body)
+        .assertUnprocessable()
+        .assertJsonStructure(['message', 'errors'])
+
+      expect(await Post.all()).toHaveLength(0)
+    })
+  })
+
+  describe('without a valid token', () => {
+    async function credentials(): Promise<Array<[string, Record<string, string>]>> {
+      const token = await issueToken(ada)
+      const [id, secret] = token.split('|')
+      const flipped = secret.startsWith('0') ? `1${secret.slice(1)}` : `0${secret.slice(1)}`
+
+      const revoked = await issueToken(ada, 'revoked')
+      const session = await http.actingAs(ada).json().withCsrf()
+      await session.delete(`/profile/tokens/${revoked.split('|')[0]}`).assertNoContent()
+
+      return [
+        ['no Authorization header', {}],
+        ['an empty bearer', { Authorization: 'Bearer ' }],
+        ['another scheme', { Authorization: `Basic ${token}` }],
+        ['a token without a separator', { Authorization: 'Bearer not-a-token' }],
+        ['only the public id', { Authorization: `Bearer ${id}` }],
+        ['an unknown token', { Authorization: `Bearer ${'a'.repeat(32)}|${'b'.repeat(64)}` }],
+        ['a tampered secret', { Authorization: `Bearer ${id}|${flipped}` }],
+        ['a tampered id', { Authorization: `Bearer ${'a'.repeat(32)}|${secret}` }],
+        ['a revoked token', { Authorization: `Bearer ${revoked}` }],
+      ]
+    }
+
+    it('answers 401 with a JSON body on the list', async () => {
+      for (const [label, headers] of await credentials()) {
+        const response = await http.json().withHeaders(headers).get('/api/posts')
+
+        expect(response.status, label).toBe(401)
+        expect(await response.json<{ message: string }>(), label).toEqual({ message: 'Unauthenticated.' })
+      }
+    })
+
+    it('answers 401 with a JSON body on create, and creates nothing', async () => {
+      for (const [label, headers] of await credentials()) {
+        const response = await http.json().withHeaders(headers).post('/api/posts', payload)
+
+        expect(response.status, label).toBe(401)
+        expect(await response.json<{ message: string }>(), label).toEqual({ message: 'Unauthenticated.' })
+      }
+
+      expect(await Post.all()).toHaveLength(0)
+    })
+
+    it('does not accept a signed-in session in place of a token', async () => {
+      const session = await http.actingAs(ada).json().withCsrf()
+
+      await session.get('/api/posts').assertUnauthorized()
+      await session.post('/api/posts', payload).assertUnauthorized()
+
+      expect(await Post.all()).toHaveLength(0)
+    })
+  })
+
+  describe('a token outside the API', () => {
+    it('does not sign its owner in to the session routes', async () => {
+      const post = await Post.forceCreate({ ...payload, authorId: ada.id })
+      const script = bearer(await issueToken(ada))
+
+      await script.get('/dashboard').assertRedirect('/login')
+      await script.post('/posts', payload).assertRedirect('/login')
+      await script.delete(`/posts/${post.id}`).assertRedirect('/login')
+
+      expect(await Post.all()).toHaveLength(1)
+    })
+  })
+
+  describe('rate limit', () => {
+    it('answers the 61st request in a minute with 429 and Retry-After', async () => {
+      const script = bearer(await issueToken(ada))
+
+      for (let request = 1; request <= API_TOKEN_RATE_LIMIT; request++) {
+        await script.get('/api/posts').assertOk()
+      }
+      const limited = await script.get('/api/posts')
+
+      limited.assertStatus(429)
+      const retryAfter = Number(limited.headers.get('Retry-After'))
+      expect(Number.isInteger(retryAfter)).toBe(true)
+      expect(retryAfter).toBeGreaterThan(0)
+      expect(retryAfter).toBeLessThanOrEqual(60)
+      expect(await limited.json<{ message: string }>()).toMatchObject({ message: expect.any(String) })
+    })
+
+    it('counts reads and writes against the same budget', async () => {
+      const script = bearer(await issueToken(ada))
+
+      for (let request = 1; request <= API_TOKEN_RATE_LIMIT; request++) {
+        await script.get('/api/posts').assertOk()
+      }
+
+      await script.post('/api/posts', payload).assertStatus(429)
+      expect(await Post.all()).toHaveLength(0)
+    })
+
+    it('gives another token of the same user its own budget', async () => {
+      const first = bearer(await issueToken(ada, 'CI'))
+      const second = bearer(await issueToken(ada, 'cron'))
+
+      for (let request = 1; request <= API_TOKEN_RATE_LIMIT; request++) {
+        await first.get('/api/posts').assertOk()
+      }
+
+      await first.get('/api/posts').assertStatus(429)
+      await second.get('/api/posts').assertOk()
+    })
+
+    it('does not count requests that fail authentication', async () => {
+      const token = await issueToken(ada)
+      const [id] = token.split('|')
+
+      for (let request = 1; request <= API_TOKEN_RATE_LIMIT + 1; request++) {
+        await bearer(`${id}|${'0'.repeat(64)}`).get('/api/posts').assertUnauthorized()
+      }
+
+      await bearer(token).get('/api/posts').assertOk()
+    })
+  })
+})
diff --git a/tests/ApiTokenController.test.ts b/tests/ApiTokenController.test.ts
