new file mode 100644
index 0000000..43e6e8c
--- /dev/null
+++ b/modules/newsletter/routes.ts
@@ -0,0 +1,19 @@
+import type { Router } from '@guren/core'
+import SubscriptionController from './app/Http/Controllers/SubscriptionController.js'
+import { SubscriptionEmailSchema } from './app/Http/Validators/SubscriptionValidator.js'
+
+// Mounted under the module's `/newsletter` prefix by src/app.ts. Open to
+// guests: a reader does not need an account to sign up.
+export function registerNewsletterRoutes(router: Router): void {
+  router.post(
+    '/subscribe',
+    { name: 'newsletter.subscribe', body: SubscriptionEmailSchema },
+    [SubscriptionController, 'subscribe'],
+  )
+  router.get('/confirm/:token', [SubscriptionController, 'confirm']).name('newsletter.confirm')
+  router.post(
+    '/unsubscribe',
+    { name: 'newsletter.unsubscribe', body: SubscriptionEmailSchema },
+    [SubscriptionController, 'unsubscribe'],
+  )
+}
