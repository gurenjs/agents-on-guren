index 0000000..335949d
--- /dev/null
+++ b/modules/newsletter/app/Http/Validators/SubscriptionValidator.ts
@@ -0,0 +1,18 @@
+import { z } from 'zod'
+
+// Lowercased so one address cannot subscribe twice under different spellings,
+// and so unsubscribing matches whatever capitalisation the visitor types.
+const email = z
+  .string()
+  .trim()
+  .min(1, 'Email is required.')
+  .max(254, 'Email must be 254 characters or fewer.')
+  .toLowerCase()
+  .pipe(z.email('The email address is badly formatted.'))
+
+export const SubscribeSchema = z.object({ email })
+
+export const UnsubscribeSchema = z.object({ email })
+
+export type SubscribeInput = z.infer<typeof SubscribeSchema>
+export type UnsubscribeInput = z.infer<typeof UnsubscribeSchema>
