@@ -0,0 +1,19 @@
+import { defineArchRules } from '@guren/cli/arch'
+
+// Checked by `bunx guren check` (and `--arch` alone). Modules under modules/
+// are self-contained so they can be lifted into another app; the blog's own
+// code must never depend on one — only src/app.ts wires them in.
+export default defineArchRules({
+  layers: {
+    application: ['app/**', 'routes/**'],
+    newsletter: 'modules/newsletter/**',
+  },
+  rules: [
+    {
+      from: 'application',
+      disallow: 'newsletter',
+      includeTypeImports: true,
+      message: 'app/ and routes/ must not import from modules/newsletter/. Register the module in src/app.ts instead.',
+    },
+  ],
+})
