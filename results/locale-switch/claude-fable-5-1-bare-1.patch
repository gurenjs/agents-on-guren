diff --git a/tests/LocaleController.test.ts b/tests/LocaleController.test.ts
new file mode 100644
index 0000000..9d171e1
--- /dev/null
+++ b/tests/LocaleController.test.ts
@@ -0,0 +1,73 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+
+// Reads `_i18n` off the login page: it renders for guests without touching the
+// database, which keeps these tests green without migrations or fixtures.
+describe('locale.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await (await TestApp.fromApp(app)).withCsrf('/login')
+  })
+
+  async function i18nFor(client: TestApp) {
+    const response = await client.withHeader('X-Inertia', 'true').get('/login').assertOk()
+    const page = (await response.json()) as {
+      props: { _i18n: { locale: string; messages: Record<string, Record<string, Record<string, string>>> } }
+    }
+    return page.props._i18n
+  }
+
+  function localeCookie(response: { headers: Headers }): string | undefined {
+    return response.headers.getSetCookie().find((cookie) => cookie.startsWith('locale='))
+  }
+
+  it('defaults to English', async () => {
+    expect((await i18nFor(http)).locale).toBe('en')
+  })
+
+  it('follows a Japanese browser on a first visit', async () => {
+    const i18n = await i18nFor(http.withHeader('Accept-Language', 'ja-JP,ja;q=0.9,en;q=0.8'))
+
+    expect(i18n.locale).toBe('ja')
+    expect(i18n.messages.ja?.nav?.posts).toBe('記事')
+  })
+
+  it('remembers the choice and redirects back to the referer', async () => {
+    const response = await http
+      .withHeader('Referer', 'http://localhost/posts?page=2')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('http://localhost/posts?page=2')
+
+    const cookie = localeCookie(response)?.split(';')[0]
+    expect(cookie).toBe('locale=ja')
+
+    // The pick outranks the browser's own setting on later requests.
+    const returning = http.withHeader('Cookie', cookie!).withHeader('Accept-Language', 'en')
+    expect((await i18nFor(returning)).locale).toBe('ja')
+  })
+
+  it('redirects home without a referer', async () => {
+    await http.post('/locale', { locale: 'en' }).assertRedirect('/')
+  })
+
+  it('keeps a referer from another origin on this site', async () => {
+    await http
+      .withHeader('Referer', 'https://elsewhere.example/posts')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/posts')
+    await http
+      .withHeader('Referer', 'https://elsewhere.example//evil.example')
+      .post('/locale', { locale: 'ja' })
+      .assertRedirect('/')
+  })
+
+  it('rejects an unsupported locale and leaves the choice alone', async () => {
+    const unsupported = await http.post('/locale', { locale: 'fr' }).assertStatus(422)
+    const missing = await http.post('/locale', {}).assertStatus(422)
+
+    expect(localeCookie(unsupported)).toBeUndefined()
+    expect(localeCookie(missing)).toBeUndefined()
+  })
+})
