new file mode 100644
index 0000000..600bc44
--- /dev/null
+++ b/tests/redirect.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from 'bun:test'
+import { DEFAULT_REDIRECT, safeRedirectPath } from '../app/Support/redirect.js'
+
+// The sign-in page takes a `redirect` target straight from the URL, so this
+// guard is what stops /login?redirect=https://evil.example from handing a
+// freshly authenticated user to a look-alike site.
+describe('safeRedirectPath', () => {
+  it('keeps same-app paths', () => {
+    expect(safeRedirectPath('/posts/3/edit')).toBe('/posts/3/edit')
+    expect(safeRedirectPath('/dashboard?tab=drafts#top')).toBe('/dashboard?tab=drafts#top')
+    expect(safeRedirectPath('/')).toBe('/')
+  })
+
+  it('rejects destinations that leave the app', () => {
+    const offSite = [
+      'https://evil.example',
+      'http://evil.example/path',
+      '//evil.example',
+      '/\\evil.example',
+      '\\\\evil.example',
+      '/\t/evil.example',
+      '/\n//evil.example',
+      'javascript:alert(1)',
+      'posts/3',
+      '',
+    ]
+
+    for (const value of offSite) {
+      expect(safeRedirectPath(value)).toBe(DEFAULT_REDIRECT)
+    }
+  })
+
+  it('falls back when nothing usable was supplied', () => {
+    expect(safeRedirectPath(undefined)).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath(null)).toBe(DEFAULT_REDIRECT)
+    expect(safeRedirectPath(['/posts'])).toBe(DEFAULT_REDIRECT)
+  })
+
+  it('honours a caller-supplied fallback', () => {
+    expect(safeRedirectPath('https://evil.example', '')).toBe('')
+    expect(safeRedirectPath('/posts', '')).toBe('/posts')
+  })
+})
