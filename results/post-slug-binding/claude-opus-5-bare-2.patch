diff --git a/app/Support/slug.ts b/app/Support/slug.ts
new file mode 100644
index 0000000..66d29d8
--- /dev/null
+++ b/app/Support/slug.ts
@@ -0,0 +1,18 @@
+/**
+ * Turns a title into a URL-safe slug: lowercase ASCII letters and digits,
+ * words joined by a single `-`, no leading or trailing separator.
+ *
+ * Accented letters are folded to their ASCII base (`Café` → `cafe`); anything
+ * else that is not a letter or a digit becomes a separator. A title made only
+ * of such characters therefore slugifies to an empty string — callers decide
+ * what to fall back to.
+ */
+export function slugify(value: string): string {
+  return value
+    .normalize('NFKD')
+    // Combining marks left behind by the decomposition above.
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}
