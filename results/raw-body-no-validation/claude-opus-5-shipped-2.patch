@@ -0,0 +1,92 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+
+// profile.update runs the request body through ProfileUpdateSchema, so unknown
+// keys are stripped before the record is written and User.update() applies the
+// fillable allowlist on top of that — `id` and `passwordHash` can never be
+// mass-assigned from the form.
+describe('profile.update', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createUser() {
+    return await User.create({
+      name: 'Ada Lovelace',
+      email: 'ada@example.com',
+      password: 'secret-password',
+    })
+  }
+
+  it('rejects a badly formatted email', async () => {
+    const user = await createUser()
+
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'Ada Lovelace', email: 'not-an-email', password: '' })
+      .assertUnprocessable()
+
+    const unchanged = await User.findOrFail(user.id)
+    expect(unchanged.email).toBe('ada@example.com')
+  })
+
+  it('rejects an empty name', async () => {
+    const user = await createUser()
+
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .json()
+      .put('/profile', { name: '   ', email: 'ada@example.com', password: '' })
+      .assertUnprocessable()
+
+    const unchanged = await User.findOrFail(user.id)
+    expect(unchanged.name).toBe('Ada Lovelace')
+  })
+
+  it('rejects a password shorter than 8 characters', async () => {
+    const user = await createUser()
+
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .json()
+      .put('/profile', { name: 'Ada Lovelace', email: 'ada@example.com', password: 'short' })
+      .assertUnprocessable()
+  })
+
+  it('ignores fields the profile form does not have', async () => {
+    const user = await createUser()
+
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf
+      .json()
+      .put('/profile', {
+        name: 'Ada King',
+        email: 'ADA.KING@example.com',
+        password: '',
+        id: 9999,
+        passwordHash: 'injected',
+      })
+      .assertOk()
+
+    const updated = await User.findOrFail(user.id)
+    expect(updated.name).toBe('Ada King')
+    // Emails are stored lowercased, matching the registration form.
+    expect(updated.email).toBe('ada.king@example.com')
+    expect(updated.passwordHash).not.toBe('injected')
+    expect(await User.find(9999)).toBeNull()
+  })
+})
