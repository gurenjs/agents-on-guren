diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..19055a1
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,42 @@
+import { defineModel } from '@guren/core'
+import { postTags, tags } from '../../db/schema.js'
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {}
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+/** Tag names per post id, sorted alphabetically; posts without tags map to `[]`. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>(postIds.map((id) => [id, []]))
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.where({ postId: postIds }).get()
+  const tagRows = await Tag.where({ id: [...new Set(links.map((link) => link.tagId))] }).get()
+  const nameById = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name !== undefined) names.get(link.postId)?.push(name)
+  }
+  for (const list of names.values()) list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  return names
+}
+
+/** Makes the post carry exactly `names`; unknown names become new tags. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const ids: number[] = []
+  for (const name of names) {
+    const existing = await Tag.first({ name })
+    ids.push((existing ?? (await Tag.create({ name }))).id)
+  }
+  await PostTag.delete({ postId })
+  for (const tagId of ids) await PostTag.create({ postId, tagId })
+}
+
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const names = await tagNamesByPost(posts.map((post) => post.id))
+  return posts.map((post) => Object.assign(post, { tags: names.get(post.id) ?? [] }))
+}
