new file mode 100644
index 0000000..e2a20f4
--- /dev/null
+++ b/modules/newsletter/tests/NewsletterController.test.ts
@@ -0,0 +1,118 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../../src/app.js'
+import { NewsletterSubscription } from '../app/Models/NewsletterSubscription.js'
+
+// The test database persists between runs, so every address is unique per test.
+function uniqueEmail(label: string): string {
+  return `${label}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}@example.com`
+}
+
+describe('newsletter module', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function guest(referer?: string): Promise<TestApp> {
+    const csrf = await http.withCsrf()
+    const client = csrf.json()
+    return referer ? client.withHeader('Referer', referer) : client
+  }
+
+  describe('POST /newsletter/subscribe', () => {
+    it('stores a pending subscription with a token and redirects back to the referer', async () => {
+      const email = uniqueEmail('subscribe')
+      const client = await guest('http://localhost/posts')
+
+      await client.post('/newsletter/subscribe', { email }).assertRedirect('http://localhost/posts')
+
+      const subscription = await NewsletterSubscription.first({ email })
+      expect(subscription).not.toBeNull()
+      expect(subscription?.confirmedAt).toBeNull()
+      expect(subscription?.token.length).toBeGreaterThanOrEqual(16)
+    })
+
+    it('falls back to the home page without a referer', async () => {
+      const client = await guest()
+      await client.post('/newsletter/subscribe', { email: uniqueEmail('noref') }).assertRedirect('/')
+    })
+
+    it('ignores an off-site referer', async () => {
+      const client = await guest('https://evil.example/phish')
+      await client.post('/newsletter/subscribe', { email: uniqueEmail('offsite') }).assertRedirect('/')
+    })
+
+    it('rejects an invalid email address without storing anything', async () => {
+      const before = await NewsletterSubscription.newQuery().count()
+      const client = await guest('http://localhost/')
+
+      await client.post('/newsletter/subscribe', { email: '' }).assertUnprocessable()
+      const res = await client.post('/newsletter/subscribe', { email: 'not-an-email' })
+      res.assertUnprocessable()
+      const body = await res.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email?.length).toBeGreaterThan(0)
+
+      expect(await NewsletterSubscription.newQuery().count()).toBe(before)
+    })
+
+    it('rejects an address that is already subscribed', async () => {
+      const email = uniqueEmail('dupe')
+      const client = await guest('http://localhost/')
+
+      await client.post('/newsletter/subscribe', { email }).assertRedirect()
+      const res = await client.post('/newsletter/subscribe', { email })
+      res.assertUnprocessable()
+      const body = await res.json<{ errors: Record<string, string[]> }>()
+      expect(body.errors.email?.length).toBeGreaterThan(0)
+
+      expect(await NewsletterSubscription.where({ email }).count()).toBe(1)
+    })
+  })
+
+  describe('GET /newsletter/confirm/:token', () => {
+    it('confirms the subscription and redirects home', async () => {
+      const email = uniqueEmail('confirm')
+      const client = await guest('http://localhost/')
+      await client.post('/newsletter/subscribe', { email }).assertRedirect()
+      const pending = await NewsletterSubscription.first({ email })
+
+      await http.get(`/newsletter/confirm/${pending?.token}`).assertRedirect('/')
+
+      const confirmed = await NewsletterSubscription.first({ email })
+      expect(confirmed?.confirmedAt).toBeTruthy()
+    })
+
+    it('answers 404 for a token that was never issued', async () => {
+      const email = uniqueEmail('unknown-token')
+      const client = await guest('http://localhost/')
+      await client.post('/newsletter/subscribe', { email }).assertRedirect()
+
+      await http.get('/newsletter/confirm/never-issued-token-value').assertNotFound()
+
+      const untouched = await NewsletterSubscription.first({ email })
+      expect(untouched?.confirmedAt).toBeNull()
+    })
+  })
+
+  describe('POST /newsletter/unsubscribe', () => {
+    it('deletes only that address and redirects back', async () => {
+      const gone = uniqueEmail('gone')
+      const kept = uniqueEmail('kept')
+      const client = await guest('http://localhost/posts/1')
+      await client.post('/newsletter/subscribe', { email: gone }).assertRedirect()
+      await client.post('/newsletter/subscribe', { email: kept }).assertRedirect()
+
+      await client.post('/newsletter/unsubscribe', { email: gone }).assertRedirect('http://localhost/posts/1')
+
+      expect(await NewsletterSubscription.first({ email: gone })).toBeNull()
+      expect(await NewsletterSubscription.first({ email: kept })).not.toBeNull()
+    })
+
+    it('rejects an invalid email address', async () => {
+      const client = await guest('http://localhost/')
+      await client.post('/newsletter/unsubscribe', { email: 'not-an-email' }).assertUnprocessable()
+    })
+  })
+})
