@@ -101,8 +111,60 @@ export default class PostController extends Controller {
     const post = await Post.findOrFail(id)
     await this.authorize('delete', [Post, post])
 
+    // Delete all revisions for this post
+    await PostRevision.delete({ postId: post.id })
     await Post.delete({ id: post.id })
 
     return this.redirect('/posts')
   }
+
+  async revisions(): Promise<Response> {
+    const { id } = this.validateParams(PostIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('viewRevisions', [Post, post])
+
+    const revisionsList = await PostRevision.newQuery()
+      .where('postId', '=', post.id)
+      .orderBy('id', 'desc')
+      .get()
+
+    return this.inertia(pages.posts.Revisions, {
+      post: new PostResource(post).toJSON(),
+      revisions: revisionsList.map((revision) => ({
+        id: revision.id,
+        title: revision.title,
+        createdAt: new Date(revision.createdAt).toISOString(),
+      })),
+    })
+  }
+
+  async restore(): Promise<Response> {
+    const { id, revisionId } = this.validateParams(PostRevisionIdParamSchema)
+    const post = await Post.findOrFail(id)
+    await this.authorize('restoreRevision', [Post, post])
+
+    const revision = await PostRevision.findOrFail(revisionId)
+
+    // Verify that the revision belongs to this post
+    if (revision.postId !== post.id) {
+      throw new ModelNotFoundException('PostRevision', revisionId)
+    }
+
+    // Save the current version as a revision before restoring
+    await PostRevision.create({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    })
+
+    // Restore the revision
+    await Post.update({ id: post.id }, {
+      title: revision.title,
+      excerpt: revision.excerpt,
+      body: revision.body,
+    })
+
+    return this.redirect(`/posts/${post.id}`)
+  }
 }
