diff --git a/tests/ScheduledPosts.test.ts b/tests/ScheduledPosts.test.ts
new file mode 100644
index 0000000..9968cc4
--- /dev/null
+++ b/tests/ScheduledPosts.test.ts
@@ -0,0 +1,122 @@
+import { afterAll, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse, type TestResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import type { PostResourceData } from '../app/Http/Resources/PostResource.js'
+
+// Feature tests against the test database (NODE_ENV=test, see
+// config/database.ts). Rows are created with unique emails and titles so
+// reruns never collide with earlier ones, and everything is deleted afterwards
+// so no scheduled post outlives the suite (`posts:scheduled` reads this DB).
+const FUTURE = '2999-01-01T09:00:00.000Z'
+const PAST = '2000-01-01T09:00:00.000Z'
+
+async function props<T>(response: TestResponse): Promise<T> {
+  const { payload } = await readInertiaResponse(response.raw)
+  return payload.props as T
+}
+
+async function makeUser(label: string): Promise<UserRecord> {
+  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+  return (await User.create({
+    name: label,
+    email: `${label}-${suffix}@example.com`,
+    password: 'secret-password',
+  })) as UserRecord
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+  let scheduled: { id: number; title: string }
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await makeUser('author')
+    other = await makeUser('other')
+    const title = `Scheduled ${Date.now()}`
+    const post = await Post.forceCreate({
+      title,
+      excerpt: 'coming soon',
+      body: 'body',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })
+    scheduled = { id: post!.id, title }
+  })
+
+  afterAll(async () => {
+    for (const user of [author, other]) {
+      if (!user) continue
+      await Post.delete({ authorId: user.id })
+      await User.delete({ id: user.id })
+    }
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+  })
+
+  it('shows a scheduled post page to its author with publishedAt', async () => {
+    const response = await http.actingAs(author).get(`/posts/${scheduled.id}`).assertOk()
+    const { post } = await props<{ post: PostResourceData }>(response)
+    expect(post.publishedAt).toBe(FUTURE)
+  })
+
+  it('lists a scheduled post only for its author', async () => {
+    const guest = await props<{ data: PostResourceData[] }>(await http.get('/posts'))
+    expect(guest.data.some((post) => post.id === scheduled.id)).toBe(false)
+
+    const mine = await props<{ data: PostResourceData[] }>(await http.actingAs(author).get('/posts'))
+    expect(mine.data.find((post) => post.id === scheduled.id)?.publishedAt).toBe(FUTURE)
+  })
+
+  it('keeps a scheduled post out of search for others', async () => {
+    const response = await http.actingAs(other).query('/posts/search', { keywords: [scheduled.title] }).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+    expect(data.some((post) => post.id === scheduled.id)).toBe(false)
+  })
+
+  it('makes the post public once its time has passed', async () => {
+    const title = `Went live ${Date.now()}`
+    const post = await Post.forceCreate({ title, excerpt: 'e', body: 'b', authorId: author.id, publishedAt: FUTURE })
+    await Post.update({ id: post!.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post!.id}`).assertOk()
+    const response = await http.query('/posts/search', { keywords: [title] }).assertOk()
+    const { data } = await response.json<{ data: PostResourceData[] }>()
+    expect(data.map((hit) => hit.id)).toContain(post!.id)
+  })
+
+  it('stores, changes and clears publishAt through the forms', async () => {
+    const client = await http.actingAs(author).json().withCsrf('/posts')
+    const title = `Form scheduled ${Date.now()}`
+    await client.post('/posts', { title, excerpt: 'e', body: 'b', publishAt: FUTURE }).assertRedirect()
+    const post = await Post.where('title', title).first()
+    expect(post?.publishedAt).toBe(FUTURE)
+
+    await client.put(`/posts/${post!.id}`, { title, excerpt: 'e', body: 'b', publishAt: '2998-06-01T00:00:00.000Z' }).assertRedirect()
+    expect((await Post.find(post!.id))?.publishedAt).toBe('2998-06-01T00:00:00.000Z')
+
+    await client.put(`/posts/${post!.id}`, { title, excerpt: 'e', body: 'b', publishAt: null }).assertRedirect()
+    expect((await Post.find(post!.id))?.publishedAt).toBeNull()
+  })
+
+  it('rejects a publishAt that is not a date and time, like an empty title', async () => {
+    const client = await http.actingAs(author).json().withCsrf('/posts')
+    const title = `Bad date ${Date.now()}`
+    const blankTitle = await client.post('/posts', { title: '', excerpt: 'e', body: 'b' })
+    const badDate = await client.post('/posts', { title, excerpt: 'e', body: 'b', publishAt: 'next tuesday' })
+    expect(badDate.status).toBe(blankTitle.status)
+    expect(await Post.where('title', title).first()).toBeNull()
+  })
+
+  it('lists only future posts, soonest first, in Post.scheduled()', async () => {
+    const rows = await Post.scheduled(new Date('2998-12-31T00:00:00.000Z'))
+    expect(rows.map((row) => row.id)).toContain(scheduled.id)
+    expect(rows.every((row) => row.publishedAt !== null && row.publishedAt > '2998-12-31')).toBe(true)
+  })
+})
