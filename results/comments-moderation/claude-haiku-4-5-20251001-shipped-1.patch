new file mode 100644
index 0000000..7e830a9
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,21 @@
+import { Policy, type AuthUser } from '@guren/core'
+import { Post } from '../Models/Post.js'
+
+interface CommentLike {
+  userId: number
+  postId: number
+}
+
+export class CommentPolicy extends Policy {
+  async delete(user: AuthUser | null, comment: unknown): Promise<boolean> {
+    const c = comment as CommentLike
+
+    if (user === null) return false
+    if (Number(user.id) === c.userId) return true
+
+    const post = await Post.find(c.postId)
+    if (post && Number(user.id) === post.authorId) return true
+
+    return false
+  }
+}
