diff --git a/tests/PostRevisionController.test.ts b/tests/PostRevisionController.test.ts
new file mode 100644
index 0000000..dfdc83a
--- /dev/null
+++ b/tests/PostRevisionController.test.ts
@@ -0,0 +1,133 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp, readInertiaResponse } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+// The test database persists between runs, so every fixture gets a unique
+// email and the assertions only ever look at rows they created themselves.
+const run = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+
+const version = (name: string) => ({
+  title: name,
+  excerpt: `${name} excerpt`,
+  body: `${name} body`,
+})
+
+async function revisionsOf(post: PostRecord) {
+  return PostRevision.newQuery().where('postId', post.id).orderBy('id', 'asc').get()
+}
+
+interface RevisionProps {
+  revisions: Array<{ id: number; title: string; createdAt: string }>
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let asAuthor: TestApp
+  let asStranger: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Author', email: `author-${run}@example.com`, password: 'secret123' })
+    stranger = await User.create({ name: 'Stranger', email: `stranger-${run}@example.com`, password: 'secret123' })
+    asAuthor = await http.actingAs(author).withCsrf('/posts')
+    asStranger = await http.actingAs(stranger).withCsrf('/posts')
+  })
+
+  async function createPost(name: string, owner: UserRecord = author): Promise<PostRecord> {
+    return Post.forceCreate({ ...version(name), authorId: owner.id })
+  }
+
+  it('keeps the previous version on every successful edit, newest first, and restores it', async () => {
+    const post = await createPost('First')
+    expect(await revisionsOf(post)).toHaveLength(0)
+
+    await asAuthor.put(`/posts/${post.id}`, version('Second')).assertRedirect(`/posts/${post.id}`)
+    await asAuthor.put(`/posts/${post.id}`, version('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const kept = await revisionsOf(post)
+    expect(kept.map((revision) => revision.title)).toEqual(['First', 'Second'])
+    expect(kept[0]).toMatchObject({ postId: post.id, ...version('First') })
+    // ISO 8601 text, like the other timestamps.
+    expect(new Date(kept[0]!.createdAt).toISOString()).toBe(kept[0]!.createdAt)
+
+    const page = await asAuthor.get(`/posts/${post.id}/revisions`).assertOk()
+    const { payload } = await readInertiaResponse(page.raw)
+    const props = payload.props as unknown as RevisionProps
+    expect(props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(props.revisions.map((revision) => revision.id)).toEqual([kept[1]!.id, kept[0]!.id])
+    expect(typeof props.revisions[0]!.createdAt).toBe('string')
+
+    const first = kept[0]!
+    await asAuthor.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored).toMatchObject(version('First'))
+
+    // The version replaced by the restore is kept, and the restored one stays.
+    const afterRestore = await revisionsOf(post)
+    expect(afterRestore.map((revision) => revision.title)).toEqual(['First', 'Second', 'Third'])
+
+    const pageAfter = await asAuthor.get(`/posts/${post.id}/revisions`).assertOk()
+    const after = (await readInertiaResponse(pageAfter.raw)).payload.props as unknown as RevisionProps
+    expect(after.revisions.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const post = await createPost('Only')
+
+    await asAuthor.put(`/posts/${post.id}`, { ...version('Broken'), title: '' }).assertStatus(422)
+    await asStranger.put(`/posts/${post.id}`, version('Hijack')).assertForbidden()
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await Post.findOrFail(post.id)).toMatchObject(version('Only'))
+  })
+
+  it('refuses everyone but the author', async () => {
+    const post = await createPost('Private')
+    await asAuthor.put(`/posts/${post.id}`, version('Private 2')).assertRedirect()
+    const [revision] = await revisionsOf(post)
+
+    await asStranger.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await asStranger.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertForbidden()
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    const guest = await http.withCsrf('/posts')
+    await guest.post(`/posts/${post.id}/revisions/${revision!.id}/restore`).assertRedirect('/login')
+
+    expect(await Post.findOrFail(post.id)).toMatchObject(version('Private 2'))
+    expect(await revisionsOf(post)).toHaveLength(1)
+  })
+
+  it('answers 404 for a revision that belongs to a different post', async () => {
+    const post = await createPost('Mine')
+    const other = await createPost('Other')
+    await asAuthor.put(`/posts/${other.id}`, version('Other 2')).assertRedirect()
+    const [otherRevision] = await revisionsOf(other)
+
+    await asAuthor.post(`/posts/${post.id}/revisions/${otherRevision!.id}/restore`).assertNotFound()
+    await asAuthor.post(`/posts/${post.id}/revisions/999999/restore`).assertNotFound()
+
+    expect(await Post.findOrFail(post.id)).toMatchObject(version('Mine'))
+    expect(await Post.findOrFail(other.id)).toMatchObject(version('Other 2'))
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(other)).toHaveLength(1)
+  })
+
+  it('deletes the history with the post and leaves other posts alone', async () => {
+    const post = await createPost('Doomed')
+    const survivor = await createPost('Survivor')
+    await asAuthor.put(`/posts/${post.id}`, version('Doomed 2')).assertRedirect()
+    await asAuthor.put(`/posts/${survivor.id}`, version('Survivor 2')).assertRedirect()
+    expect(await revisionsOf(post)).toHaveLength(1)
+
+    await asAuthor.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionsOf(post)).toHaveLength(0)
+    expect(await revisionsOf(survivor)).toHaveLength(1)
+  })
+})
