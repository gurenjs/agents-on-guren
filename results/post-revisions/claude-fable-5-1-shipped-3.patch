+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import type { PostRevisionResourceData } from '@/app/Http/Resources/PostRevisionResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Props {
+  post: PostResourceData
+  revisions: PostRevisionResourceData[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History of ${post.title}`} />
+      <section className="space-y-6">
+        <header className="space-y-2">
+          <h1 className="flex items-center gap-3 text-3xl font-bold text-g-heading">
+            <span aria-hidden className="h-7 w-[3px] shrink-0 rounded-full bg-[image:var(--g-tick)]" />
+            History
+          </h1>
+          <p className="text-sm text-g-muted">
+            Earlier versions of{' '}
+            <Link href={route('posts.show', { id: post.id })} className="text-g-accent-text transition hover:underline">
+              {post.title}
+            </Link>
+            , newest first. Restoring keeps the current version in this list too.
+          </p>
+        </header>
+
+        {revisions.length === 0 ? (
+          <p className="text-g-text-2">No earlier versions yet. Every saved edit keeps the version it replaced.</p>
+        ) : (
+          <ul className="divide-y divide-g-line rounded-g-ctl border border-g-line bg-g-panel">
+            {revisions.map((revision) => (
+              <li key={revision.id} className="flex items-center justify-between gap-4 px-4 py-3">
+                <div className="min-w-0">
+                  <p className="truncate font-bold text-g-heading">{revision.title}</p>
+                  <p className="truncate text-sm text-g-muted">{revision.excerpt}</p>
+                  <p className="text-xs text-g-muted">
+                    Kept {new Date(revision.createdAt).toLocaleString()}
+                  </p>
+                </div>
+                <Link
+                  href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                  method="post"
+                  as="button"
+                  onBefore={() => window.confirm(`Restore "${revision.title}"?`)}
+                  className="shrink-0 rounded-g-ctl border border-g-line-strong px-3 py-1 text-sm font-bold text-g-text transition hover:border-g-muted"
+                >
+                  Restore
+                </Link>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        <footer className="flex items-center gap-4 border-t border-g-line pt-6 text-sm">
+          <Link href={route('posts.show', { id: post.id })} className="text-g-text-2 transition hover:text-g-heading">
+            ← Back to post
+          </Link>
+          <Link href={route('posts.edit', { id: post.id })} className="text-g-accent-text transition hover:underline">
+            Edit
+          </Link>
+        </footer>
+      </section>
+    </Layout>
+  )
+}
