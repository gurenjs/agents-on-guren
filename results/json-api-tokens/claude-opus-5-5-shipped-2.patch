diff --git a/tests/controllers/ApiTokenController.test.ts b/tests/controllers/ApiTokenController.test.ts
new file mode 100644
index 0000000..8b3e6fd
--- /dev/null
+++ b/tests/controllers/ApiTokenController.test.ts
@@ -0,0 +1,101 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { resetDatabase } from '../../config/database.js'
+import { ApiToken } from '../../app/Models/ApiToken.js'
+import { Post } from '../../app/Models/Post.js'
+import { User, type UserRecord } from '../../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = (await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret-password' })) as UserRecord
+    bob = (await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })) as UserRecord
+  })
+
+  async function issueToken(user: UserRecord, name = 'CI'): Promise<{ id: string; token: string }> {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: string; token: string }>()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('creates a token shown once and stores only its hash', async () => {
+    const { id, token } = await issueToken(alice)
+    const secret = token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    const row = await ApiToken.find(id)
+    const raw = JSON.stringify(await ApiToken.newQuery().get()) + JSON.stringify(row)
+    expect(raw).not.toContain(secret)
+    expect(row?.hashedToken).not.toBe(secret)
+  })
+
+  it('rejects invalid names', async () => {
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await ApiToken.newQuery().count()).toBe(0)
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const { token } = await issueToken(alice)
+    await bearer(token).post('/api/posts', { title: 'Hi', excerpt: 'e', body: 'b', authorId: bob.id })
+      .assertCreated()
+      .assertJsonPath('data.authorId', alice.id)
+
+    await bearer(token).get('/api/posts').assertOk().assertJsonCount(1, 'data')
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'e' }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(1)
+  })
+
+  it('answers 401 for missing, malformed or tampered tokens', async () => {
+    const { token } = await issueToken(alice)
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('nonsense').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).post('/api/posts', { title: 'a', excerpt: 'b', body: 'c' }).assertUnauthorized()
+    expect(await Post.newQuery().count()).toBe(0)
+  })
+
+  it('revokes only the owner\'s token', async () => {
+    const first = await issueToken(alice, 'one')
+    const second = await issueToken(alice, 'two')
+    const bobs = await issueToken(bob)
+
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${bobs.id}`).assertNotFound()
+    await bearer(bobs.token).get('/api/posts').assertOk()
+
+    await csrf.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests per minute', async () => {
+    const first = await issueToken(alice, 'one')
+    const second = await issueToken(alice, 'two')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    limited.assertStatus(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThanOrEqual(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})
