+++ b/resources/js/components/PostTags.tsx
@@ -0,0 +1,29 @@
+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+  className?: string
+}
+
+export default function PostTags({ tags, className }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul className={`flex flex-wrap gap-2 ${className ?? ''}`}>
+      {tags.map((tag) => (
+        <li key={tag}>
+          {/* No `page` in the link, so a tag always opens on its first page. */}
+          <Link
+            href={route('posts.index', { tag })}
+            className="rounded-g-ctl border border-g-line px-2 py-0.5 font-mono text-xs text-g-text-2 transition hover:border-g-line-strong hover:text-g-heading"
+          >
+            #{tag}
+          </Link>
+        </li>
+      ))}
+    </ul>
+  )
+}
