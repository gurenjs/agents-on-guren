+import { defineModel } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export type ApiTokenRecord = typeof apiTokens.$inferSelect
+
+/**
+ * Read side of the `api_tokens` table, for listing and ownership checks.
+ * Tokens are created, verified and revoked through app/Auth/apiTokens.ts.
+ */
+export class ApiToken extends defineModel(apiTokens, {
+  // Nothing is mass-assignable: every column is set by the token store.
+  fillable: [],
+  hidden: ['hashedToken'],
+}) {}
diff --git a/app/Support/DatabaseRateLimitStore.ts b/app/Support/DatabaseRateLimitStore.ts
new file mode 100644
index 0000000..4c99046
--- /dev/null
+++ b/app/Support/DatabaseRateLimitStore.ts
@@ -0,0 +1,60 @@
+import type { RateLimitEntry, RateLimitStore } from '@guren/core'
+import { eq, sql } from 'drizzle-orm'
+import { getDatabase, type AppSeederContext } from '../../config/database.js'
+import { rateLimits } from '../../db/schema.js'
+
+type Database = AppSeederContext['db']
+
+/**
+ * Fixed-window counters in the `rate_limits` table. The framework's default
+ * store counts in memory, which forgets on restart and gives every process
+ * its own budget; this one is shared by whatever serves the site.
+ */
+export class DatabaseRateLimitStore implements RateLimitStore {
+  constructor(private readonly now: () => number = () => Date.now()) {}
+
+  async get(key: string): Promise<RateLimitEntry | null> {
+    const db = await this.database()
+    const [entry] = await db.select().from(rateLimits).where(eq(rateLimits.key, key)).limit(1)
+    if (!entry || this.now() >= entry.resetAt) {
+      return null
+    }
+
+    return { count: entry.count, resetAt: entry.resetAt }
+  }
+
+  // One statement, so two requests arriving together cannot both read the same
+  // count and each write back "one more". An expired window starts over.
+  async increment(key: string, windowMs: number): Promise<RateLimitEntry> {
+    const db = await this.database()
+    const now = this.now()
+    const expired = sql`${rateLimits.resetAt} <= ${now}`
+
+    const [entry] = await db
+      .insert(rateLimits)
+      .values({ key, count: 1, resetAt: now + windowMs })
+      .onConflictDoUpdate({
+        target: rateLimits.key,
+        set: {
+          count: sql`CASE WHEN ${expired} THEN 1 ELSE ${rateLimits.count} + 1 END`,
+          resetAt: sql`CASE WHEN ${expired} THEN ${now + windowMs} ELSE ${rateLimits.resetAt} END`,
+        },
+      })
+      .returning()
+
+    if (!entry) {
+      throw new Error(`Rate limit counter for "${key}" could not be written.`)
+    }
+
+    return { count: entry.count, resetAt: entry.resetAt }
+  }
+
+  async reset(key: string): Promise<void> {
+    const db = await this.database()
+    await db.delete(rateLimits).where(eq(rateLimits.key, key))
+  }
+
+  private async database(): Promise<Database> {
+    return (await getDatabase()) as Database
+  }
+}
