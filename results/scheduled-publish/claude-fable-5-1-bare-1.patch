@@ -0,0 +1,21 @@
+import { Command } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+
+/**
+ * `bun run console posts:scheduled` — the launch calendar from a terminal.
+ * Prints one `<id>\t<title>\t<published_at>` line per scheduled post, soonest
+ * first, and nothing else on stdout, so the output pipes straight into other
+ * tools. Public posts (no date, or one already passed) are left out.
+ */
+export default class PostsScheduledCommand extends Command {
+  static signature = 'posts:scheduled'
+  static description = 'List posts waiting for their publish time, soonest first, as tab-separated id, title and published_at.'
+
+  async handle(): Promise<void> {
+    const posts = await Post.scheduled().select('id', 'title', 'publishedAt').orderBy('publishedAt', 'asc').orderBy('id', 'asc').get()
+
+    for (const post of posts) {
+      this.line(`${post.id}\t${post.title}\t${post.publishedAt}`)
+    }
+  }
+}
